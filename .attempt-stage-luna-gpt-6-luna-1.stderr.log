import 'dart:math';
import 'package:shared_preferences/shared_preferences.dart';

/// Installation identities persisted app-wide, one per role.
///
/// The guest phone identity ([storageKey]) authorizes `joinParty`; the host
/// phone identity ([hostStorageKey]) redeems `joinHost`. The keys are
/// separate so switching roles can never overwrite or promote an existing
/// guest registration: joining as host leaves the guest device doc (and its
/// receipts) untouched, and vice versa. Persistence is required before an
/// id is returned.
final class DeviceIdentityStore {
  DeviceIdentityStore({
    Future<SharedPreferences> Function()? preferences,
    Random? random,
  }) : _preferences = preferences ?? SharedPreferences.getInstance,
       _random = random ?? Random.secure();
  static const String storageKey = 'companion.phone_device_id.v1';

  /// Separate host phone identity for `joinHost` redemption.
  ///
  /// A guest-PIN registration (role guest) can never be upgraded by
  /// re-presenting a host invite for the same device id — the backend
  /// rejects guest docs at redemption — so the host flow mints and persists
  /// its own installation id under this key.
  static const String hostStorageKey = 'companion.host_phone_device_id.v1';

  final Future<SharedPreferences> Function() _preferences;
  final Random _random;
  final Map<String, Future<String>> _pending = <String, Future<String>>{};

  Future<String> getDeviceId() => _pending.putIfAbsent(
    storageKey,
    () => _loadOrCreate(
      storageKey,
    ).then((id) => id).catchError((Object error) {
      _pending.remove(storageKey);
      throw error;
    }),
  );

  Future<String> getHostDeviceId() => _pending.putIfAbsent(
    hostStorageKey,
    () => _loadOrCreate(
      hostStorageKey,
    ).then((id) => id).catchError((Object error) {
      _pending.remove(hostStorageKey);
      throw error;
    }),
  );

  Future<String> _loadOrCreate(String key) async {
    final prefs = await _preferences();
    final stored = prefs.getString(key);
    if (stored != null && RegExp(r'^p-[0-9a-f]{32}$').hasMatch(stored)) {
      return stored;
    }
    final bytes = List<int>.generate(16, (_) => _random.nextInt(256));
    final id = 'p-${bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join()}';
    if (!await prefs.setString(key, id)) {
      throw StateError('Unable to persist phone identity');
    }
    return id;
  }
}
/// Scanner seam for the join QR flow.
///
/// [JoinScreen] talks only to [JoinPayloadScanner]. Widget tests inject
/// fakes; the shipped app injects [CameraJoinPayloadScanner], which asks
/// for camera permission (graceful denial) and pushes [QrScanScreen].
///
/// Navigation always uses the [BuildContext] supplied at scan invocation:
/// that context belongs to [JoinScreen], which lives below the app's
/// [MaterialApp], so [Navigator.of] resolves. A stale ancestor context
/// (for example the root widget's own build context, captured above
/// [MaterialApp]) has no [Navigator] and must never be used for the push.
library;

import 'package:flutter/material.dart';
import 'package:permission_handler/permission_handler.dart';

import 'package:companion_app/src/join/qr_scan_screen.dart';

/// Result of one scan attempt.
sealed class JoinPayloadScanResult {
  const JoinPayloadScanResult();
}

/// A QR payload was captured; the raw text still goes through the same
/// [parseGuestJoinPayload] validation as the type-or-paste path.
final class JoinPayloadText extends JoinPayloadScanResult {
  const JoinPayloadText(this.text);
  final String text;
}

/// No scanner is available on this device, or the user cancelled the scan.
/// The type-or-paste path stays usable.
final class JoinPayloadUnavailable extends JoinPayloadScanResult {
  const JoinPayloadUnavailable();
}

/// Camera permission was denied. When [permanently] is true the OS will no
/// longer show the prompt, so the message must point at Settings.
final class JoinPayloadPermissionDenied extends JoinPayloadScanResult {
  const JoinPayloadPermissionDenied({this.permanently = false});
  final bool permanently;
}

abstract interface class JoinPayloadScanner {
  /// Runs one scan attempt. When [context] — a descendant of the app's
  /// [MaterialApp], supplied by [JoinScreen] at invocation — is provided it
  /// is used for any navigation; otherwise the scanner falls back to its
  /// own context supplier. Never retain the context beyond the future.
  Future<JoinPayloadScanResult> scan([BuildContext? context]);
}

final class UnavailableJoinPayloadScanner implements JoinPayloadScanner {
  const UnavailableJoinPayloadScanner();
  @override
  Future<JoinPayloadScanResult> scan([BuildContext? context]) async =>
      const JoinPayloadUnavailable();
}

/// Camera-permission states, decoupled from `permission_handler` for tests.
enum CameraPermissionState { granted, denied, permanentlyDenied }

/// Permission gateway seam; the shipped implementation delegates to
/// `permission_handler`, tests inject fakes.
abstract interface class CameraPermissionClient {
  Future<CameraPermissionState> check();
  Future<CameraPermissionState> request();
}

final class PermissionHandlerCameraPermissions
    implements CameraPermissionClient {
  const PermissionHandlerCameraPermissions();

  @override
  Future<CameraPermissionState> check() async =>
      _map(await Permission.camera.status);

  @override
  Future<CameraPermissionState> request() async =>
      _map(await Permission.camera.request());

  CameraPermissionState _map(PermissionStatus status) {
    if (status.isGranted || status.isLimited) {
      return CameraPermissionState.granted;
    }
    if (status.isPermanentlyDenied || status.isRestricted) {
      return CameraPermissionState.permanentlyDenied;
    }
    return CameraPermissionState.denied;
  }
}

/// Push outcome: [_Pushed] ran a real route (whose null/empty result is a
/// cancellation), [_NoNavigator] found no [Navigator] above the context.
sealed class _PushOutcome {
  const _PushOutcome();
}

final class _Pushed extends _PushOutcome {
  const _Pushed(this.text);
  final String? text;
}

final class _NoNavigator extends _PushOutcome {
  const _NoNavigator();
}

/// Camera-backed scanner: permission flow with graceful denial, then a
/// full-screen [QrScanScreen] whose captured text reuses the existing
/// first-join registration and error states in [JoinScreen].
final class CameraJoinPayloadScanner implements JoinPayloadScanner {
  CameraJoinPayloadScanner({
    BuildContext Function()? contextOf,
    CameraPermissionClient permissions =
        const PermissionHandlerCameraPermissions(),
  }) : _contextOf = contextOf,
       _permissions = permissions;

  /// Legacy ancestor-context supplier, kept for source compatibility.
  /// The invocation context always wins; this is only a last-resort
  /// fallback when it carries no [Navigator].
  final BuildContext Function()? _contextOf;
  final CameraPermissionClient _permissions;

  @override
  Future<JoinPayloadScanResult> scan([BuildContext? context]) async {
    final CameraPermissionState state = await _resolvePermission();
    switch (state) {
      case CameraPermissionState.granted:
        break;
      case CameraPermissionState.denied:
        return const JoinPayloadPermissionDenied();
      case CameraPermissionState.permanentlyDenied:
        return const JoinPayloadPermissionDenied(permanently: true);
    }
    // Prefer the invocation (descendant-of-MaterialApp) context: the
    // permission prompt may have backgrounded or closed the join screen,
    // so never push onto a dead element.
    final BuildContext? invocation = context;
    if (invocation != null) {
      if (!invocation.mounted) {
        return const JoinPayloadUnavailable();
      }
      final _PushOutcome first = await _pushScanner(invocation);
      switch (first) {
        case _Pushed(:final String? text):
          return _toResult(text);
        case _NoNavigator():
          // The invocation context carried no Navigator (a stale ancestor
          // context): try the legacy supplier once before giving up to
          // the type-or-paste path.
          break;
      }
    }
    final BuildContext? fallback = _legacyContext();
    if (fallback == null || !fallback.mounted) {
      return const JoinPayloadUnavailable();
    }
    final _PushOutcome second = await _pushScanner(fallback);
    if (second is! _Pushed || second.text == null) {
      return const JoinPayloadUnavailable();
    }
    return _toResult(second.text!);
  }

  JoinPayloadScanResult _toResult(String? text) {
    if (text == null || text.trim().isEmpty) {
      return const JoinPayloadUnavailable();
    }
    return JoinPayloadText(text);
  }

  /// Returns the legacy ancestor context when it can still host a route.
  BuildContext? _legacyContext() {
    final BuildContext Function()? supplier = _contextOf;
    if (supplier == null) {
      return null;
    }
    try {
      final BuildContext candidate = supplier();
      return candidate.mounted ? candidate : null;
    } catch (_) {
      // Supplier failures (including FlutterError, an Error, from a torn
      // down element) mean no usable fallback: type-or-paste stays.
      return null;
    }
  }

  Future<CameraPermissionState> _resolvePermission() async {
    try {
      CameraPermissionState state = await _permissions.check();
      if (state == CameraPermissionState.denied) {
        state = await _permissions.request();
      }
      return state;
    } on Exception {
      // The permission plugin itself failed (no platform channel in some
      // test harnesses, unexpected native error): stay on the retryable
      // denial path so type-or-paste keeps working.
      return CameraPermissionState.denied;
    }
/// Lifecycle-safe host administration session.
///
/// Joins ONLY through [HostJoinClient.redeem] (the `joinHost` callable) and
/// administers the seed catalog ONLY through [HostMediaClient]. This file
/// depends on the two callable-boundary ports — never on a concrete
/// connection class and never on Firebase.
///
/// Rules enforced here:
/// - The bound identity is a host payload ([GuestJoinData] with
///   [JoinRole.host]); guest payloads are rejected before any callable.
/// - [join] validates the returned party/channel/device/host scope (via the
///   client) before the session becomes ready; denials surface as
///   [HostSessionStatus.denied] and throw a sanitized [HostJoinException]
///   so the entry screen can fail visibly without entering the panel.
/// - `generateHostVideo` uses a stable idempotency key per seed id: retries
///   of the same seed reuse the queued job (`created: false`) instead of
///   enqueueing another task.
/// - [deleteVideos] reconciles the list only after authoritative success;
///   failures leave local state untouched so they stay retryable.
/// - A generation counter keeps late responses from a superseded
///   join/refresh/poll (party switches, background suspend, leave, dispose)
///   from mutating the new session. Polling stops on [suspend], [leave],
///   and [dispose].
library;

import 'dart:async';
import 'dart:developer' as developer;
import 'dart:math';

import 'package:companion_app/src/data/host_join_client.dart';
import 'package:companion_app/src/data/host_media_client.dart';
import 'package:companion_app/src/data/manifest_failure.dart';
import 'package:companion_app/src/join/guest_join_data.dart';

/// Lifecycle status of [HostSessionState].
enum HostSessionStatus {
  /// No host identity bound; no polling active.
  idle,

  /// Redeeming the host invite / loading the seed catalog.
  loading,

  /// A validated host binding with a current seed catalog.
  ready,

  /// Stale: retained catalog after a transient failure or suspension.
  stale,

  /// Cold start with no catalog and no usable transport.
  unavailable,

  /// The server rejected the binding (`FORBIDDEN`/`UNAUTHENTICATED`).
  denied,

  /// The invite or catalog data was invalid.
  invalidData,
}

/// Immutable snapshot of the host session.
final class HostSessionState {
  const HostSessionState({
    required this.status,
    this.binding,
    this.videos = const <HostSeedVideo>[],
    this.message,
  });

  const HostSessionState.idle() : this(status: HostSessionStatus.idle);

  final HostSessionStatus status;
  final GuestJoinData? binding;
  final List<HostSeedVideo> videos;
  final String? message;

  HostSessionState copyWith({
    HostSessionStatus? status,
    GuestJoinData? binding,
    List<HostSeedVideo>? videos,
    String? message,
  }) => HostSessionState(
    status: status ?? this.status,
    binding: binding ?? this.binding,
    videos: videos ?? this.videos,
    message: message ?? this.message,
  );

  @override
  bool operator ==(Object other) =>
      other is HostSessionState &&
      other.status == status &&
      other.binding == binding &&
      other.message == message &&
      _videoIds(other.videos).join(',') == _videoIds(videos).join(',');

  @override
  int get hashCode => Object.hash(status, binding, message, videos.length);

  @override
  String toString() =>
      'HostSessionState($status, videos: ${videos.length})';

  static List<String> _videoIds(List<HostSeedVideo> videos) =>
      <String>[for (final HostSeedVideo v in videos) '${v.seedId}:${v.status}'];
}

/// Sanitized host-join failure for the entry screen.
///
/// Carries only the fixed user-presentable message (never raw backend
/// detail); [toString] returns the message itself.
final class HostJoinException implements Exception {
  const HostJoinException(this.message);
  final String message;

  @override
  String toString() => message;
}

/// Host administration session bound to one party/device/channel at a time.
final class HostSession {
  HostSession({
    required HostJoinClient joinClient,
    required HostMediaClient mediaClient,
    Duration pollInterval = const Duration(seconds: 15),
    Random? random,
  }) : _joinClient = joinClient,
       _mediaClient = mediaClient,
       _pollInterval = pollInterval,
       _random = random ?? Random.secure();

  final HostJoinClient _joinClient;
  final HostMediaClient _mediaClient;
  final Duration _pollInterval;
  final Random _random;

  final StreamController<HostSessionState> _states =
      StreamController<HostSessionState>.broadcast();

  HostSessionState _state = const HostSessionState.idle();

  /// Current immutable snapshot.
  HostSessionState get state => _state;

  /// Broadcast of state snapshots.
  Stream<HostSessionState> get states => _states.stream;

  /// Bound host identity, or `null` when idle.
  GuestJoinData? get binding => _state.binding;

  /// Current or last-known seed catalog.
  List<HostSeedVideo> get videos => List<HostSeedVideo>.unmodifiable(
    _state.videos,
  );

  int _generation = 0;
  bool _disposed = false;
  bool _busy = false;
  Timer? _pollTimer;

  /// Stable idempotency keys per seed id (retries reuse the queued job).
  final Map<String, String> _idempotencyKeys = <String, String>{};

  void _emit(HostSessionState next) {
    _state = next;
    if (!_states.isClosed) {
      _states.add(next);
    }
  }

  String _mintIdempotencyKey() {
    final List<int> bytes = List<int>.generate(16, (_) => _random.nextInt(256));
    return bytes.map((int b) => b.toRadixString(16).padLeft(2, '0')).join();
  }

  /// Joins as a host [data], replacing any previous session.
  ///
  /// Throws a sanitized [HostJoinException] when the invite cannot be
  /// redeemed (the emitted state carries the same fixed message). Guest
  /// payloads are rejected before any network call.
  Future<void> join(GuestJoinData data) async {
    if (_disposed) return;
    if (data.role != JoinRole.host || data.inviteToken == null) {
      throw const HostJoinException(
        'This host entry needs a host invitation. Join as a guest instead.',
      );
    }
    _generation++;
    final int generation = _generation;
    _stopPolling();
    _busy = false;
    _emit(
      HostSessionState(
        status: HostSessionStatus.loading,
        binding: data,
        message: 'Redeeming host invite for ${data.partyId.value}',
      ),
    );
    try {
      await _joinClient.redeem(
        partyId: data.partyId.value,
        deviceId: data.deviceId.value,
        channelId: data.channelId,
        inviteToken: data.inviteToken!,
      );
    } on Object catch (error) {
      if (generation == _generation && !_disposed) {
        final ManifestFailure failure = error is ManifestFailure
            ? error
            : ManifestFailure.classify(error);
        developer.log(
          'HostSession join failed: $error',
          name: 'companion.host_session',
        );
        final HostSessionStatus status = switch (failure.kind) {
          ManifestFailureKind.forbidden ||
          ManifestFailureKind.unauthenticated => HostSessionStatus.denied,
          ManifestFailureKind.invalidArgument ||
          ManifestFailureKind.malformed ||
          ManifestFailureKind.configuration => HostSessionStatus.invalidData,
          _ => HostSessionStatus.unavailable,
        };
        _emit(
          HostSessionState(
            status: status,
            binding: data,
            message: failure.message,
          ),
        );
        throw HostJoinException(failure.message);
      }
      throw const HostJoinException('Could not reach the backend.');
    }
    if (generation != _generation || _disposed) return;
    await _loadCatalog(data, generation);
    if (generation != _generation || _disposed) return;
    _startPolling();
  }

  Future<void> _loadCatalog(GuestJoinData data, int generation) async {
    try {
      final List<HostSeedVideo> listed = await _mediaClient.listVideos(
        partyId: data.partyId.value,
        deviceId: data.deviceId.value,
        channelId: data.channelId,
      );
      if (generation != _generation || _disposed) return;
      _emit(
        HostSessionState(
          status: HostSessionStatus.ready,
          binding: data,
          videos: listed,
        ),
      );
    } on Object catch (error) {
      if (generation != _generation || _disposed) return;
      developer.log(
        'HostSession catalog load failed: $error',
        name: 'companion.host_session',
      );
      final ManifestFailure failure = ManifestFailure.classify(error);
      if (_state.videos.isNotEmpty) {
        _emit(
          HostSessionState(
            status: HostSessionStatus.stale,
            binding: data,
            videos: _state.videos,
            message: failure.message,
          ),
        );
        return;
      }
      _emit(
        HostSessionState(
          status: HostSessionStatus.unavailable,
          binding: data,
          message: failure.message,
        ),
      );
    }
  }

  /// Refreshes the seed catalog without overlapping in-flight work.
  Future<void> refresh() async {
    if (_disposed || _busy) return;
    final GuestJoinData? bound = _state.binding;
    if (bound == null || _state.status == HostSessionStatus.idle) return;
    _busy = true;
    _generation++;
    final int generation = _generation;
    try {
      await _loadCatalog(bound, generation);
    } finally {
      _busy = false;
    }
  }

  /// Enqueues fixed-preset generation for [seedId].
  ///
  /// The idempotency key is stable per seed id: retries reuse the queued
  /// job (`created: false`) instead of enqueueing another task. Returns the
  /// server result. Failures throw and leave local state untouched.
  Future<Map<String, Object?>> generate(
    String seedId, {
    String presetId = kCheapDemoPresetId,
    String? guestMediaId,
  }) async {
    final GuestJoinData? bound = _state.binding;
    if (bound == null || _disposed) {
      throw StateError('Join as host before generating video');
    }
    final String key = _idempotencyKeys.putIfAbsent(
      seedId,
      _mintIdempotencyKey,
    );
    final Map<String, Object?> result = await _mediaClient.generateVideo(
      partyId: bound.partyId.value,
      deviceId: bound.deviceId.value,
      channelId: bound.channelId,
      seedId: seedId,
      idempotencyKey: key,
      presetId: presetId,
      guestMediaId: guestMediaId,
    );
    await refresh();
    return result;
  }

  /// Obtains a fresh scoped preview capability for [seedId].
  ///
  /// Every view requests a new capability: signed URLs are short-lived and
  /// never persisted.
  Future<HostVideoPreview> preview(String seedId) {
    final GuestJoinData? bound = _state.binding;
    if (bound == null || _disposed) {
      throw StateError('Join as host before previewing video');
    }
    return _mediaClient.getPreview(
      partyId: bound.partyId.value,
      deviceId: bound.deviceId.value,
      channelId: bound.channelId,
      seedId: seedId,
# Halloween TV - Guests — `companion_app`

Guest app (Android, iOS, Web) for Halloween TV. This is the second Flutter
app in the monorepo alongside `apps/tv_app`. The standing owner gate in
`docs/IMPLEMENTATION-TRACKING.md` ("no secondary Flutter app without
Joaquin's explicit approval") was lifted for this run: owner approval for
this companion app was recorded for cycle-6, scoped to a controlled pilot
(see below).

## What it does

Anonymous join + read-only now-playing, nothing else:

- **Join:** the guest enters the organizer-provisioned `partyId`,
  `deviceId`, and `channelId` (typed fields or a pasted JSON object).
  Identifiers are validated locally for shape only — well-formed never
  means registered. There is no login, no Firebase Auth, no registration,
  and no server round-trip at join time.
- **Now playing:** the app invokes exactly one callable,
  `getCurrentManifest`, with exactly `{partyId, deviceId, channelId}`,
  and renders the latest published lineup (four cameras in `cctvSlots`
  wall order, manifest version, server publication time, last-successful-
  check time). The server decides access at manifest-read time
  (`FORBIDDEN`/`UNAUTHENTICATED` render as denial states).

Default boot is unconfigured/offline: with no backend selected the app
shows the join screen with a configuration banner and performs no Firebase
initialization and no network traffic. A cloud target is selected only
through an explicit, validated `BackendConfig` (build-time
`--dart-define` values via `BackendConfig.fromEnvironment()` in
`lib/main.dart`, or the documented `config/firebase.json` copy workflow
below).

## Controlled-pilot assumption

Party/device/channel IDs are provisioned out-of-band by the organizer for
a controlled pilot (known guests, known devices). The app treats join input
as untrusted data: extra JSON keys (URLs, endpoints, backend selectors,
auto-submit flags) are ignored and never acted upon.

## Bearer-capability disclosure

The party/device IDs are bearer capabilities: the same registered IDs
that authorize the read-only `getCurrentManifest` call also authorize
server-side ACK and generation callables. **This app never invokes those**
(the invoker rejects every callable name except `getCurrentManifest` and
every payload except exactly `{partyId, deviceId, channelId}`), but anyone
holding a provisioned ID pair could call them from elsewhere. Therefore:

- Provision **dedicated guest-only device IDs** for companion use.
- **Never reuse the TV's own device identity** for guest joins.
- Treat organizer-distributed join payloads like passwords: share them
  only with the intended guest, and rotate/revoke on the backend if one
  leaks.

## Spend and hardening

- **No live spend from this app:** the only callable it invokes is the
  read-only `getCurrentManifest`. Video-generation testing stays on the
  cheapest preset with explicit owner approval per the standing gates; this
  app cannot trigger generation.
- **Pending owner-gated hardening:** App Check enforcement and an explicit
  organizer pairing/approval step are not implemented in this pass and
  remain owner-gated follow-ups before any wider rollout.

## Backend options file

`config/firebase.example.json` holds `YOUR-` placeholders only. To target
a backend locally, copy it to `config/firebase.json` (git-ignored — never
commit real project IDs, keys, or emulator addresses) and fill in real
values. Placeholder values are rejected as unconfigured (fail closed).

## Release signing status

Release builds currently use the **debug keystore** (Flutter template
default: `signingConfig = signingConfigs.getByName("debug")` in
`android/app/build.gradle.kts`). They are **unsuitable for distribution**.
Before any distribution build, follow `docs/RELEASE-SIGNING.md` (party
keystore, env-gated passwords). No signing changes in this pass.

## Guest photo submission (consent-gated, backend-pending)

Optional flow behind "Submit a guest photo" on the now-playing screen:

- The guest picks a photo, checks an explicit affirmative-consent box, then
  confirms a second "Review and upload" dialog. No capability call exists
  before both gates pass (`GuestMediaSession.submit` requires
  `consent && confirmed`; `GuestMediaClient.requestUpload` refuses
  `affirmativeConsent: false` before any network).
- The client then requests an upload capability (`requestGuestUpload`),
  PUTs the bytes with the caller-chosen content type (`image/jpeg` or
  `image/png`, threaded from the picker), and confirms
  (`completeGuestUpload`). Every call carries
  `{partyId, deviceId, channelId}` plus `submissionId` where applicable —
  the backend rejects a missing `channelId` with `INVALID_ARGUMENT`.
  Withdrawal (`withdrawGuestMedia`) returns the terminal status `withdrawn`.
  Each submission keeps its own persisted receipt and withdrawal control,
  so withdrawing one photo never strands another; a saved receipt is
  re-checked on next launch (`recover`). Denied/failed uploads keep the
  photo local and retryable.
- Privacy copy (shown in-app): the photo is transformed for Halloween, may
  appear on the party TV, is processed by the media provider and temporarily
  retained in cloud storage; a copy already downloaded to the TV may not be
  removable while that TV is offline.

Backend status: the guest-media callables are implemented server-side
(`backend/functions/src/guest_upload.ts`, wired in
`backend/functions/src/index.ts`). `requestGuestUpload` requires
`{partyId, deviceId, channelId, contentType, byteSize,
consent:{accepted:true, textVersion:'v1', purpose:'guest_cameo'}}` (consent
literals pinned in `guest_media_client.dart` against
`backend/functions/src/config.ts`) and mints a per-submission signed PUT
capability bound to a server-assigned object path, returning
`{submissionId, objectPath, uploadUrl, expiresAt, consentRevision}` — the
backend never echoes `contentType`; the PUT uses the caller content type.
`completeGuestUpload`, `getGuestMediaStatus`, and `withdrawGuestMedia`
are scoped by `{partyId, deviceId, channelId, submissionId}`, with
withdrawal terminal at status `withdrawn`. The emulator contract test
(`integration_test/guest_photo_emulator_test.dart`) pins this envelope end
to end; it proceeds through capability issuance and reaches the signed PUT
step, which the Storage emulator refuses with HTTP 501 (no XML-API PUT
route), before any completion.

## Getting Started

- `flutter pub get`
- `flutter analyze`
- `flutter test --concurrency=1`
- Emulator contract (needs local Firebase emulators from `backend/`):
  `STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase --config
  firebase.json emulators:start --only firestore,functions,storage
  --project demo-halloween-tv`, then
  `flutter test --concurrency=1
  integration_test/guest_photo_emulator_test.dart`.
  Skips when the emulators are not reachable.

Display name is `Halloween TV - Guests` (owner decision 2026-10-30) —
deliberately distinct from the TV app (`Halloween TV`).

