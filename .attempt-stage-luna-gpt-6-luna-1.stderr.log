    if (_busySeeds.contains(seedId)) return;
    setState(() {
      _busySeeds.add(seedId);
      _actionError = null;
    });
    try {
      await widget.session.deleteVideos(<String>[seedId]);
    } on Object catch (error) {
      if (mounted) setState(() => _actionError = '$error');
    } finally {
      if (mounted) {
        setState(() => _busySeeds.remove(seedId));
      }
    }
  }

