  void _toggleEffects() {
    final bool value = !_effectsDisabled;
    setState(() {
      _effectsDisabled = value;
      _status = _effectsDisabled ? 'EFFECTS DISABLED' : 'EFFECTS ENABLED';
    });
    final SettingsPort? settings = widget.settings;
    if (settings != null) {
      unawaited(
        settings.setBool(
          partyId: PartyId(widget.partyId),
