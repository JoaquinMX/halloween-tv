+  identity: Identity,
+): Promise<RegisteredContext> {
+  const registered = await assertRegisteredPartyDevice(db, identity);
+  if (registered.device.role !== "tv") {
+    throw new BackendError("FORBIDDEN", "Only a registered TV may mint a host invite.");
+  }
+  return registered;
