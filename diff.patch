+      await tester.sendKeyEvent(LogicalKeyboardKey.escape);
+      await tester.pump();
+      expect(backed, isTrue);
+      expect(closed, isFalse);
+      await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);
+      await tester.pump();
+      expect(closed, isTrue);
+      primary.unfocus();
