diff --git a/apps/companion_app/integration_test/host_admin_emulator_test.dart b/apps/companion_app/integration_test/host_admin_emulator_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..2b6119551e94687b4997d0c3690b8e89fb0a3370
--- /dev/null
+++ b/apps/companion_app/integration_test/host_admin_emulator_test.dart
@@ -0,0 +1,61 @@
+// Emulator-backed host administration smoke test.
+//
+// Run from apps/companion_app after starting the Firebase emulators and
+// supplying HOST_INVITE_PAYLOAD (a fresh Host QR JSON from createHostInvite):
+//
+//   flutter test integration_test/host_admin_emulator_test.dart \
+//     --dart-define=HOST_INVITE_PAYLOAD='{"partyId":"...",...}' \
+//     --dart-define=COMPANION_FIREBASE_API_KEY=... \
+//     --dart-define=COMPANION_FIREBASE_APP_ID=... \
+//     --dart-define=COMPANION_FIREBASE_PROJECT_ID=demo-halloween-tv \
+//     --dart-define=COMPANION_USE_EMULATOR=true
+//
+// The one-use invite is deliberately provisioned out of band (the companion
+// cannot mint host invitations). This drives real parsing, identity binding,
+// joinHost response validation, and the scoped seed-list callable.
+library;
+
+import 'package:companion_app/src/companion_app.dart';
+import 'package:companion_app/src/join/device_identity_store.dart';
+import 'package:companion_app/src/ui/host_entry_screen.dart';
+import 'package:companion_app/src/ui/host_panel_screen.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+const String _hostInvitePayload = String.fromEnvironment('HOST_INVITE_PAYLOAD');
+
+void main() {
+  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets('emulator: Host QR joins and loads scoped administration', (
+    tester,
+  ) async {
+    if (_hostInvitePayload.isEmpty) {
+      // ignore: avoid_print
+      print(
+        'SKIP host admin: supply HOST_INVITE_PAYLOAD (fresh Host QR JSON).',
+      );
+      return;
+    }
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      DeviceIdentityStore.hostStorageKey: 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb',
+    });
+    await tester.pumpWidget(const CompanionApp());
+    for (int i = 0; i < 12; i++) {
+      await tester.pump(const Duration(milliseconds: 250));
+    }
+    expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);
+    await tester.enterText(
+      find.byKey(HostEntryScreen.payloadFieldKey),
+      _hostInvitePayload,
+    );
+    await tester.ensureVisible(find.byKey(HostEntryScreen.submitKey));
+    await tester.tap(find.byKey(HostEntryScreen.submitKey));
+    for (int i = 0; i < 20; i++) {
+      await tester.pump(const Duration(milliseconds: 250));
+    }
+    expect(find.byKey(HostPanelScreen.listKey), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+}
diff --git a/apps/companion_app/lib/src/data/host_join_client.dart b/apps/companion_app/lib/src/data/host_join_client.dart
new file mode 100644
index 0000000000000000000000000000000000000000..72ec58e1e639f4dbaec294096c2d5427041cc2ea
--- /dev/null
+++ b/apps/companion_app/lib/src/data/host_join_client.dart
@@ -0,0 +1,81 @@
+/// Host invite redemption callable used before host administration.
+library;
+
+import 'dart:async';
+
+import 'package:cloud_functions/cloud_functions.dart';
+import 'package:infra_firestore/infra_firestore.dart'
+    show ManifestTransportException;
+
+const String kJoinHostCallable = 'joinHost';
+
+/// Callable boundary kept separate from the guest `joinParty` boundary.
+///
+/// Guest entry must never register a host payload through `joinParty`, and
+/// host entry must never redeem through it either: the two routes use
+/// disjoint callables, disjoint device identities, and server-assigned
+/// roles (see `backend/functions/src/host_join.ts`).
+abstract interface class HostJoinCallableInvoker {
+  Future<Object?> call(String name, Map<String, Object?> payload);
+}
+
+/// Redeems a host invite and validates the server's scoped host response.
+final class HostJoinClient {
+  HostJoinClient({
+    required HostJoinCallableInvoker invoker,
+    this.timeout = const Duration(seconds: 10),
+  }) : _invoker = invoker;
+
+  final HostJoinCallableInvoker _invoker;
+  final Duration timeout;
+
+  Future<void> redeem({
+    required String partyId,
+    required String deviceId,
+    required String channelId,
+    required String inviteToken,
+  }) async {
+    final Map<String, Object?> payload = <String, Object?>{
+      'partyId': partyId,
+      'deviceId': deviceId,
+      'channelId': channelId,
+      'inviteToken': inviteToken,
+    };
+    try {
+      final Object? raw = await _invoker
+          .call(kJoinHostCallable, payload)
+          .timeout(timeout);
+      if (raw is! Map ||
+          raw['partyId'] != partyId ||
+          raw['deviceId'] != deviceId ||
+          raw['channelId'] != channelId ||
+          raw['role'] != 'host' ||
+          raw['status'] != 'active' ||
+          raw['created'] is! bool) {
+        throw const FormatException(
+          'joinHost response did not match the requested host scope',
+        );
+      }
+    } on TimeoutException catch (error) {
+      throw ManifestTransportException('joinHost timed out', error);
+    } on FirebaseFunctionsException catch (error) {
+      throw ManifestTransportException('joinHost callable failed', error);
+    }
+  }
+}
+
+/// SDK-backed joinHost invoker, intentionally unable to make other calls.
+final class CallableHostJoinInvoker implements HostJoinCallableInvoker {
+  CallableHostJoinInvoker({required FirebaseFunctions functions})
+    : _functions = functions;
+  final FirebaseFunctions _functions;
+
+  @override
+  Future<Object?> call(String name, Map<String, Object?> payload) async {
+    if (name != kJoinHostCallable) throw ArgumentError.value(name, 'name');
+    return (await _functions
+            .httpsCallable(kJoinHostCallable)
+            .call<Object?>(payload))
+        .data;
+  }
+}
diff --git a/apps/companion_app/lib/src/data/host_media_client.dart b/apps/companion_app/lib/src/data/host_media_client.dart
new file mode 100644
index 0000000000000000000000000000000000000000..bb6bba5d093f35c377bf6f64bf41ce080bc1249d
--- /dev/null
+++ b/apps/companion_app/lib/src/data/host_media_client.dart
@@ -0,0 +1,364 @@
+/// Scoped host administration callables (seed catalog + previews).
+///
+/// Every operation revalidates the registered host role and party/channel
+/// scope server-side (`assertRegisteredHostDevice`); guests get `FORBIDDEN`.
+/// Payload/response shapes mirror `backend/functions/src/contracts.ts`.
+///
+/// Deletion granularity (pinned): `deleteHostVideo` deletes per selected
+/// seed id — the seed entries and their associated preview + delivery
+/// objects are removed, an affected current manifest whose jobId matches a
+/// deleted seed is revoked, and accounting records (costLogs / usage ledger
+/// rows) are never deleted. The list is reconciled only after authoritative
+/// success; failures leave local state untouched so they stay retryable.
+library;
+
+import 'dart:async';
+
+import 'package:cloud_functions/cloud_functions.dart';
+import 'package:infra_firestore/infra_firestore.dart'
+    show ManifestTransportException;
+
+const String kListHostVideos = 'listHostVideos';
+const String kGenerateHostVideo = 'generateHostVideo';
+const String kGetHostVideoPreview = 'getHostVideoPreview';
+const String kDeleteHostVideo = 'deleteHostVideo';
+
+/// Fixed generation presets supported by host administration.
+///
+/// Pinned to `backend/functions/src/config.ts` (`CHEAP_DEMO_PRESET` /
+/// `CAMEO_DEMO_PRESET`). Generation presets keep producing 4 clips; the
+/// preset value is never caller-tunable beyond this fixed set.
+const String kCheapDemoPresetId = 'cheap_demo';
+const String kCameoDemoPresetId = 'cameo_demo';
+
+/// Callable boundary for host administration, separate from guest callables.
+abstract interface class HostMediaCallableInvoker {
+  Future<Object?> call(String name, Map<String, Object?> payload);
+}
+
+/// One server-backed seed catalog entry.
+final class HostSeedVideo {
+  const HostSeedVideo({
+    required this.seedId,
+    required this.partyId,
+    required this.channelId,
+    required this.status,
+    required this.jobId,
+    required this.createdAt,
+    required this.expiresAt,
+    required this.previewAvailable,
+    required this.cameraIds,
+  });
+
+  final String seedId;
+  final String partyId;
+  final String channelId;
+
+  /// Backend seed status: `queued`, `running`, `ready`, `failed`,
+  /// `deleted` (expiry surfaces through the same status sync).
+  final String status;
+  final String jobId;
+  final String createdAt;
+  final String expiresAt;
+  final bool previewAvailable;
+  final List<String> cameraIds;
+
+  @override
+  bool operator ==(Object other) =>
+      other is HostSeedVideo &&
+      other.seedId == seedId &&
+      other.partyId == partyId &&
+      other.channelId == channelId &&
+      other.status == status &&
+      other.jobId == jobId &&
+      other.previewAvailable == previewAvailable;
+
+  @override
+  int get hashCode =>
+      Object.hash(seedId, partyId, channelId, status, jobId, previewAvailable);
+
+  @override
+  String toString() => 'HostSeedVideo($seedId status=$status)';
+}
+
+/// One signed preview clip reference (signed on demand, never persisted).
+final class HostVideoPreviewClip {
+  const HostVideoPreviewClip({
+    required this.cameraId,
+    required this.sha256,
+    required this.url,
+    required this.expiresAt,
+  });
+
+  final String cameraId;
+  final String sha256;
+  final Uri url;
+  final String expiresAt;
+}
+
+/// Fresh scoped preview capability for one seed video.
+final class HostVideoPreview {
+  const HostVideoPreview({
+    required this.seedId,
+    required this.expiresAt,
+    required this.clips,
+  });
+
+  final String seedId;
+  final String expiresAt;
+  final List<HostVideoPreviewClip> clips;
+}
+
+/// Scoped host media client: list / generate / preview / delete.
+final class HostMediaClient {
+  HostMediaClient({
+    required HostMediaCallableInvoker invoker,
+    this.timeout = const Duration(seconds: 15),
+  }) : _invoker = invoker;
+
+  final HostMediaCallableInvoker _invoker;
+  final Duration timeout;
+
+  Map<String, Object?> _scope(
+    String partyId,
+    String deviceId,
+    String channelId,
+  ) => <String, Object?>{
+    'partyId': partyId,
+    'deviceId': deviceId,
+    'channelId': channelId,
+  };
+
+  Future<Object?> _call(String name, Map<String, Object?> payload) async {
+    try {
+      return await _invoker.call(name, payload).timeout(timeout);
+    } on TimeoutException catch (error) {
+      throw ManifestTransportException('$name timed out', error);
+    }
+  }
+
+  /// Lists the server-backed seed catalog for the registered host scope.
+  Future<List<HostSeedVideo>> listVideos({
+    required String partyId,
+    required String deviceId,
+    required String channelId,
+  }) async {
+    final Object? raw;
+    try {
+      raw = await _call(kListHostVideos, _scope(partyId, deviceId, channelId));
+    } on FirebaseFunctionsException catch (error) {
+      throw ManifestTransportException('listHostVideos callable failed', error);
+    }
+    if (raw is! Map || raw['videos'] is! List) {
+      throw const FormatException('Host video list response is malformed');
+    }
+    final List<HostSeedVideo> videos = <HostSeedVideo>[];
+    for (final Object? entry in raw['videos'] as List) {
+      videos.add(_parseSeed(entry, partyId: partyId, channelId: channelId));
+    }
+    return videos;
+  }
+
+  HostSeedVideo _parseSeed(
+    Object? entry, {
+    required String partyId,
+    required String channelId,
+  }) {
+    if (entry is! Map) {
+      throw const FormatException('Host seed entry is malformed');
+    }
+    String requiredString(String key) {
+      final Object? value = entry[key];
+      if (value is! String || value.isEmpty) {
+        throw FormatException('Host seed entry field "$key" is malformed');
+      }
+      return value;
+    }
+
+    final String seedParty = requiredString('partyId');
+    final String seedChannel = requiredString('channelId');
+    if (seedParty != partyId || seedChannel != channelId) {
+      throw const FormatException(
+        'Host seed entry is outside the registered party and channel',
+      );
+    }
+    final Object? cameras = entry['cameraIds'];
+    if (entry['previewAvailable'] is! bool || cameras is! List) {
+      throw const FormatException('Host seed entry fields are malformed');
+    }
+    return HostSeedVideo(
+      seedId: requiredString('seedId'),
+      partyId: seedParty,
+      channelId: seedChannel,
+      status: requiredString('status'),
+      jobId: requiredString('jobId'),
+      createdAt: requiredString('createdAt'),
+      expiresAt: requiredString('expiresAt'),
+      previewAvailable: entry['previewAvailable'] as bool,
+      cameraIds: <String>[for (final Object? c in cameras) c.toString()],
+    );
+  }
+
+  /// Enqueues fixed-preset generation for [seedId].
+  ///
+  /// [idempotencyKey] must be stable per seed id across retries so a retry
+  /// reuses the queued job (`created: false`) instead of enqueueing another
+  /// task. [presetId] defaults to the supported `cheap_demo` preset.
+  Future<Map<String, Object?>> generateVideo({
+    required String partyId,
+    required String deviceId,
+    required String channelId,
+    required String seedId,
+    required String idempotencyKey,
+    String presetId = kCheapDemoPresetId,
+    String? guestMediaId,
+  }) async {
+    if (presetId != kCheapDemoPresetId && presetId != kCameoDemoPresetId) {
+      throw ArgumentError.value(
+        presetId,
+        'presetId',
+        'Only the fixed generation presets are supported',
+      );
+    }
+    final Object? raw;
+    try {
+      raw = await _call(kGenerateHostVideo, <String, Object?>{
+        ..._scope(partyId, deviceId, channelId),
+        'seedId': seedId,
+        'idempotencyKey': idempotencyKey,
+        'presetId': presetId,
+        if (guestMediaId != null) 'guestMediaId': guestMediaId,
+      });
+    } on FirebaseFunctionsException catch (error) {
+      throw ManifestTransportException(
+        'generateHostVideo callable failed',
+        error,
+      );
+    }
+    if (raw is! Map ||
+        raw['seedId'] != seedId ||
+        raw['jobId'] is! String ||
+        raw['state'] is! String ||
+        raw['created'] is! bool) {
+      throw const FormatException(
+        'generateHostVideo response did not match the requested seed',
+      );
+    }
+    return Map<String, Object?>.from(raw);
+  }
+
+  /// Obtains a fresh scoped preview capability for [seedId].
+  ///
+  /// Callers must request a new capability per view: signed URLs are
+  /// short-lived and never persisted server-side.
+  Future<HostVideoPreview> getPreview({
+    required String partyId,
+    required String deviceId,
+    required String channelId,
+    required String seedId,
+  }) async {
+    final Object? raw;
+    try {
+      raw = await _call(kGetHostVideoPreview, <String, Object?>{
+        ..._scope(partyId, deviceId, channelId),
+        'seedId': seedId,
+      });
+    } on FirebaseFunctionsException catch (error) {
+      throw ManifestTransportException(
+        'getHostVideoPreview callable failed',
+        error,
+      );
+    }
+    if (raw is! Map ||
+        raw['seedId'] != seedId ||
+        raw['expiresAt'] is! String ||
+        raw['clips'] is! List) {
+      throw const FormatException(
+        'getHostVideoPreview response did not match the requested seed',
+      );
+    }
+    final List<HostVideoPreviewClip> clips = <HostVideoPreviewClip>[];
+    for (final Object? entry in raw['clips'] as List) {
+      if (entry is! Map ||
+          entry['cameraId'] is! String ||
+          entry['sha256'] is! String ||
+          entry['url'] is! String ||
+          entry['expiresAt'] is! String) {
+        throw const FormatException('Host preview clip is malformed');
+      }
+      final Uri? uri = Uri.tryParse(entry['url'] as String);
+      if (uri == null ||
+          uri.scheme != 'https' ||
+          uri.host.isEmpty ||
+          uri.userInfo.isNotEmpty) {
+        throw const FormatException('Host preview URL is invalid');
+      }
+      clips.add(
+        HostVideoPreviewClip(
+          cameraId: entry['cameraId'] as String,
+          sha256: entry['sha256'] as String,
+          url: uri,
+          expiresAt: entry['expiresAt'] as String,
+        ),
+      );
+    }
+    return HostVideoPreview(
+      seedId: seedId,
+      expiresAt: raw['expiresAt'] as String,
+      clips: clips,
+    );
+  }
+
+  /// Deletes the selected seed ids.
+  ///
+  /// Deletion is per selected seed id (see the library doc): preview +
+  /// delivery objects for those seeds are removed, an affected current
+  /// manifest is revoked, and accounting records are preserved. Only call
+  /// after the caller reconciles on authoritative success.
+  Future<Map<String, Object?>> deleteVideos({
+    required String partyId,
+    required String deviceId,
+    required String channelId,
+    required List<String> seedIds,
+  }) async {
+    final Object? raw;
+    try {
+      raw = await _call(kDeleteHostVideo, <String, Object?>{
+        ..._scope(partyId, deviceId, channelId),
+        'seedIds': seedIds,
+      });
+    } on FirebaseFunctionsException catch (error) {
+      throw ManifestTransportException(
+        'deleteHostVideo callable failed',
+        error,
+      );
+    }
+    if (raw is! Map ||
+        raw['deletedSeedIds'] is! List ||
+        raw['deletedObjects'] is! List ||
+        raw['revokedManifest'] is! bool) {
+      throw const FormatException('deleteHostVideo response is malformed');
+    }
+    return Map<String, Object?>.from(raw);
+  }
+}
+
+/// SDK-backed host media invoker, scoped to the four host callables.
+final class CallableHostMediaInvoker implements HostMediaCallableInvoker {
+  CallableHostMediaInvoker({required FirebaseFunctions functions})
+    : _functions = functions;
+  final FirebaseFunctions _functions;
+
+  static const Set<String> _allowed = <String>{
+    kListHostVideos,
+    kGenerateHostVideo,
+    kGetHostVideoPreview,
+    kDeleteHostVideo,
+  };
+
+  @override
+  Future<Object?> call(String name, Map<String, Object?> payload) async {
+    if (!_allowed.contains(name)) throw ArgumentError.value(name, 'name');
+    return (await _functions.httpsCallable(name).call<Object?>(payload)).data;
+  }
+}
diff --git a/apps/companion_app/lib/src/session/host_session.dart b/apps/companion_app/lib/src/session/host_session.dart
new file mode 100644
index 0000000000000000000000000000000000000000..f40d4d2e2c8c3a19bb9f72d15c972e44a40dd7b1
--- /dev/null
+++ b/apps/companion_app/lib/src/session/host_session.dart
@@ -0,0 +1,425 @@
+/// Lifecycle-safe host administration session.
+///
+/// Joins ONLY through [HostJoinClient.redeem] (the `joinHost` callable) and
+/// administers the seed catalog ONLY through [HostMediaClient]. This file
+/// depends on the two callable-boundary ports — never on a concrete
+/// connection class and never on Firebase.
+///
+/// Rules enforced here:
+/// - The bound identity is a host payload ([GuestJoinData] with
+///   [JoinRole.host]); guest payloads are rejected before any callable.
+/// - [join] validates the returned party/channel/device/host scope (via the
+///   client) before the session becomes ready; denials surface as
+///   [HostSessionStatus.denied] and throw a sanitized [HostJoinException]
+///   so the entry screen can fail visibly without entering the panel.
+/// - `generateHostVideo` uses a stable idempotency key per seed id: retries
+///   of the same seed reuse the queued job (`created: false`) instead of
+///   enqueueing another task.
+/// - [deleteVideos] reconciles the list only after authoritative success;
+///   failures leave local state untouched so they stay retryable.
+/// - A generation counter keeps late responses from a superseded
+///   join/refresh/poll (party switches, background suspend, leave, dispose)
+///   from mutating the new session. Polling stops on [suspend], [leave],
+///   and [dispose].
+library;
+
+import 'dart:async';
+import 'dart:developer' as developer;
+import 'dart:math';
+
+import 'package:companion_app/src/data/host_join_client.dart';
+import 'package:companion_app/src/data/host_media_client.dart';
+import 'package:companion_app/src/data/manifest_failure.dart';
+import 'package:companion_app/src/join/guest_join_data.dart';
+
+/// Lifecycle status of [HostSessionState].
+enum HostSessionStatus {
+  /// No host identity bound; no polling active.
+  idle,
+
+  /// Redeeming the host invite / loading the seed catalog.
+  loading,
+
+  /// A validated host binding with a current seed catalog.
+  ready,
+
+  /// Stale: retained catalog after a transient failure or suspension.
+  stale,
+
+  /// Cold start with no catalog and no usable transport.
+  unavailable,
+
+  /// The server rejected the binding (`FORBIDDEN`/`UNAUTHENTICATED`).
+  denied,
+
+  /// The invite or catalog data was invalid.
+  invalidData,
+}
+
+/// Immutable snapshot of the host session.
+final class HostSessionState {
+  const HostSessionState({
+    required this.status,
+    this.binding,
+    this.videos = const <HostSeedVideo>[],
+    this.message,
+  });
+
+  const HostSessionState.idle() : this(status: HostSessionStatus.idle);
+
+  final HostSessionStatus status;
+  final GuestJoinData? binding;
+  final List<HostSeedVideo> videos;
+  final String? message;
+
+  HostSessionState copyWith({
+    HostSessionStatus? status,
+    GuestJoinData? binding,
+    List<HostSeedVideo>? videos,
+    String? message,
+  }) => HostSessionState(
+    status: status ?? this.status,
+    binding: binding ?? this.binding,
+    videos: videos ?? this.videos,
+    message: message ?? this.message,
+  );
+
+  @override
+  bool operator ==(Object other) =>
+      other is HostSessionState &&
+      other.status == status &&
+      other.binding == binding &&
+      other.message == message &&
+      _videoIds(other.videos).join(',') == _videoIds(videos).join(',');
+
+  @override
+  int get hashCode => Object.hash(status, binding, message, videos.length);
+
+  @override
+  String toString() => 'HostSessionState($status, videos: ${videos.length})';
+
+  static List<String> _videoIds(List<HostSeedVideo> videos) => <String>[
+    for (final HostSeedVideo v in videos) '${v.seedId}:${v.status}',
+  ];
+}
+
+/// Sanitized host-join failure for the entry screen.
+///
+/// Carries only the fixed user-presentable message (never raw backend
+/// detail); [toString] returns the message itself.
+final class HostJoinException implements Exception {
+  const HostJoinException(this.message);
+  final String message;
+
+  @override
+  String toString() => message;
+}
+
+/// Host administration session bound to one party/device/channel at a time.
+final class HostSession {
+  HostSession({
+    required HostJoinClient joinClient,
+    required HostMediaClient mediaClient,
+    Duration pollInterval = const Duration(seconds: 15),
+    Random? random,
+  }) : _joinClient = joinClient,
+       _mediaClient = mediaClient,
+       _pollInterval = pollInterval,
+       _random = random ?? Random.secure();
+
+  final HostJoinClient _joinClient;
+  final HostMediaClient _mediaClient;
+  final Duration _pollInterval;
+  final Random _random;
+
+  final StreamController<HostSessionState> _states =
+      StreamController<HostSessionState>.broadcast();
+
+  HostSessionState _state = const HostSessionState.idle();
+
+  /// Current immutable snapshot.
+  HostSessionState get state => _state;
+
+  /// Broadcast of state snapshots.
+  Stream<HostSessionState> get states => _states.stream;
+
+  /// Bound host identity, or `null` when idle.
+  GuestJoinData? get binding => _state.binding;
+
+  /// Current or last-known seed catalog.
+  List<HostSeedVideo> get videos =>
+      List<HostSeedVideo>.unmodifiable(_state.videos);
+
+  int _generation = 0;
+  bool _disposed = false;
+  bool _busy = false;
+  Timer? _pollTimer;
+
+  /// Stable idempotency keys per seed id (retries reuse the queued job).
+  final Map<String, String> _idempotencyKeys = <String, String>{};
+
+  void _emit(HostSessionState next) {
+    _state = next;
+    if (!_states.isClosed) {
+      _states.add(next);
+    }
+  }
+
+  String _mintIdempotencyKey() {
+    final List<int> bytes = List<int>.generate(16, (_) => _random.nextInt(256));
+    return bytes.map((int b) => b.toRadixString(16).padLeft(2, '0')).join();
+  }
+
+  /// Joins as a host [data], replacing any previous session.
+  ///
+  /// Throws a sanitized [HostJoinException] when the invite cannot be
+  /// redeemed (the emitted state carries the same fixed message). Guest
+  /// payloads are rejected before any network call.
+  Future<void> join(GuestJoinData data) async {
+    if (_disposed) return;
+    if (data.role != JoinRole.host || data.inviteToken == null) {
+      throw const HostJoinException(
+        'This host entry needs a host invitation. Join as a guest instead.',
+      );
+    }
+    _generation++;
+    final int generation = _generation;
+    _stopPolling();
+    _busy = false;
+    _emit(
+      HostSessionState(
+        status: HostSessionStatus.loading,
+        binding: data,
+        message: 'Redeeming host invite for ${data.partyId.value}',
+      ),
+    );
+    try {
+      await _joinClient.redeem(
+        partyId: data.partyId.value,
+        deviceId: data.deviceId.value,
+        channelId: data.channelId,
+        inviteToken: data.inviteToken!,
+      );
+    } on Object catch (error) {
+      if (generation == _generation && !_disposed) {
+        final ManifestFailure failure = error is ManifestFailure
+            ? error
+            : ManifestFailure.classify(error);
+        developer.log(
+          'HostSession join failed: $error',
+          name: 'companion.host_session',
+        );
+        final HostSessionStatus status = switch (failure.kind) {
+          ManifestFailureKind.forbidden ||
+          ManifestFailureKind.unauthenticated => HostSessionStatus.denied,
+          ManifestFailureKind.invalidArgument ||
+          ManifestFailureKind.malformed ||
+          ManifestFailureKind.configuration => HostSessionStatus.invalidData,
+          _ => HostSessionStatus.unavailable,
+        };
+        _emit(
+          HostSessionState(
+            status: status,
+            binding: data,
+            message: failure.message,
+          ),
+        );
+        throw HostJoinException(failure.message);
+      }
+      throw const HostJoinException('Could not reach the backend.');
+    }
+    if (generation != _generation || _disposed) return;
+    await _loadCatalog(data, generation);
+    if (generation != _generation || _disposed) return;
+    _startPolling();
+  }
+
+  Future<void> _loadCatalog(GuestJoinData data, int generation) async {
+    try {
+      final List<HostSeedVideo> listed = await _mediaClient.listVideos(
+        partyId: data.partyId.value,
+        deviceId: data.deviceId.value,
+        channelId: data.channelId,
+      );
+      if (generation != _generation || _disposed) return;
+      _emit(
+        HostSessionState(
+          status: HostSessionStatus.ready,
+          binding: data,
+          videos: listed,
+        ),
+      );
+    } on Object catch (error) {
+      if (generation != _generation || _disposed) return;
+      developer.log(
+        'HostSession catalog load failed: $error',
+        name: 'companion.host_session',
+      );
+      final ManifestFailure failure = ManifestFailure.classify(error);
+      if (_state.videos.isNotEmpty) {
+        _emit(
+          HostSessionState(
+            status: HostSessionStatus.stale,
+            binding: data,
+            videos: _state.videos,
+            message: failure.message,
+          ),
+        );
+        return;
+      }
+      _emit(
+        HostSessionState(
+          status: HostSessionStatus.unavailable,
+          binding: data,
+          message: failure.message,
+        ),
+      );
+    }
+  }
+
+  /// Refreshes the seed catalog without overlapping in-flight work.
+  Future<void> refresh() async {
+    if (_disposed || _busy) return;
+    final GuestJoinData? bound = _state.binding;
+    if (bound == null || _state.status == HostSessionStatus.idle) return;
+    _busy = true;
+    _generation++;
+    final int generation = _generation;
+    try {
+      await _loadCatalog(bound, generation);
+    } finally {
+      _busy = false;
+    }
+  }
+
+  /// Enqueues fixed-preset generation for [seedId].
+  ///
+  /// The idempotency key is stable per seed id: retries reuse the queued
+  /// job (`created: false`) instead of enqueueing another task. Returns the
+  /// server result. Failures throw and leave local state untouched.
+  Future<Map<String, Object?>> generate(
+    String seedId, {
+    String presetId = kCheapDemoPresetId,
+    String? guestMediaId,
+  }) async {
+    final GuestJoinData? bound = _state.binding;
+    if (bound == null || _disposed) {
+      throw StateError('Join as host before generating video');
+    }
+    final String key = _idempotencyKeys.putIfAbsent(
+      seedId,
+      _mintIdempotencyKey,
+    );
+    final Map<String, Object?> result = await _mediaClient.generateVideo(
+      partyId: bound.partyId.value,
+      deviceId: bound.deviceId.value,
+      channelId: bound.channelId,
+      seedId: seedId,
+      idempotencyKey: key,
+      presetId: presetId,
+      guestMediaId: guestMediaId,
+    );
+    await refresh();
+    return result;
+  }
+
+  /// Obtains a fresh scoped preview capability for [seedId].
+  ///
+  /// Every view requests a new capability: signed URLs are short-lived and
+  /// never persisted.
+  Future<HostVideoPreview> preview(String seedId) {
+    final GuestJoinData? bound = _state.binding;
+    if (bound == null || _disposed) {
+      throw StateError('Join as host before previewing video');
+    }
+    return _mediaClient.getPreview(
+      partyId: bound.partyId.value,
+      deviceId: bound.deviceId.value,
+      channelId: bound.channelId,
+      seedId: seedId,
+    );
+  }
+
+  /// Deletes [seedIds] and reconciles the list after authoritative success.
+  ///
+  /// Failures throw and leave the local list untouched so they stay
+  /// retryable.
+  Future<Map<String, Object?>> deleteVideos(List<String> seedIds) async {
+    final GuestJoinData? bound = _state.binding;
+    if (bound == null || _disposed) {
+      throw StateError('Join as host before deleting video');
+    }
+    final Map<String, Object?> result = await _mediaClient.deleteVideos(
+      partyId: bound.partyId.value,
+      deviceId: bound.deviceId.value,
+      channelId: bound.channelId,
+      seedIds: seedIds,
+    );
+    await refresh();
+    return result;
+  }
+
+  void _startPolling() {
+    _stopPolling();
+    if (_disposed) return;
+    _pollTimer = Timer.periodic(_pollInterval, (_) {
+      unawaited(refresh());
+    });
+  }
+
+  void _stopPolling() {
+    _pollTimer?.cancel();
+    _pollTimer = null;
+  }
+
+  /// Suspends polling for backgrounding; the retained catalog stays
+  /// readable as the current snapshot.
+  Future<void> suspend() async {
+    if (_disposed) return;
+    _generation++;
+    _stopPolling();
+    _busy = false;
+    final GuestJoinData? bound = _state.binding;
+    if (bound == null) return;
+    if (_state.videos.isNotEmpty && _state.status == HostSessionStatus.ready) {
+      _emit(
+        HostSessionState(
+          status: HostSessionStatus.stale,
+          binding: bound,
+          videos: _state.videos,
+          message: 'Suspended; showing last-known catalog',
+        ),
+      );
+    }
+  }
+
+  /// Resumes polling with a fresh catalog read after [suspend].
+  Future<void> resume() async {
+    if (_disposed) return;
+    final GuestJoinData? bound = _state.binding;
+    if (bound == null || _state.status == HostSessionStatus.idle) return;
+    _startPolling();
+    await refresh();
+  }
+
+  /// Leaves the host session: stops polling and clears identity + catalog.
+  Future<void> leave() async {
+    _generation++;
+    _stopPolling();
+    _busy = false;
+    _idempotencyKeys.clear();
+    if (_disposed) return;
+    _emit(const HostSessionState.idle());
+  }
+
+  /// Releases polling and the state broadcast.
+  Future<void> dispose() async {
+    if (_disposed) return;
+    _disposed = true;
+    _generation++;
+    _stopPolling();
+    if (!_states.isClosed) {
+      await _states.close();
+    }
+  }
+}
diff --git a/apps/companion_app/lib/src/ui/host_entry_screen.dart b/apps/companion_app/lib/src/ui/host_entry_screen.dart
new file mode 100644
index 0000000000000000000000000000000000000000..293438797429100cc6be5b360927c77ebca01c10
--- /dev/null
+++ b/apps/companion_app/lib/src/ui/host_entry_screen.dart
@@ -0,0 +1,223 @@
+/// Dedicated host entry screen: Scan Host QR + explicit Join-as-guest route.
+///
+/// Rationale (navigation decision): guest PIN admission is intentionally
+/// broad — anyone who can see the TV screen can self-register as a guest —
+/// so host administration must never be reachable through the guest PIN or a
+/// client-supplied role string. A dedicated entry screen keeps the two
+/// routes visibly distinct and makes the privilege boundary auditable: the
+/// host QR carries a server-minted, short-lived invite capability redeemed
+/// through `joinHost` for a separate phone identity with the server-assigned
+/// host role, while the guest route carries only the display PIN redeemed
+/// through `joinParty`. Scan and paste funnel through the same shared
+/// [parseGuestJoinPayload] validator (parity), and only host-typed payloads
+/// are redeemed here — anything else fails visibly without network traffic.
+library;
+
+import 'package:companion_app/src/join/device_identity_store.dart';
+import 'package:companion_app/src/join/guest_join_data.dart';
+import 'package:companion_app/src/join/join_payload_scanner.dart';
+import 'package:core_foundation/core_foundation.dart';
+import 'package:flutter/material.dart';
+
+final class HostEntryScreen extends StatefulWidget {
+  const HostEntryScreen({
+    super.key,
+    required this.onHostJoin,
+    required this.onJoinAsGuest,
+    this.configurationIssue,
+    this.identityStore,
+    this.scanner = const UnavailableJoinPayloadScanner(),
+  });
+
+  /// Redeems a validated host payload. Throws a sanitized message on
+  /// denial so the failure stays visible on this screen.
+  final Future<void> Function(GuestJoinData data) onHostJoin;
+
+  /// Explicit guest route: shows the anonymous guest join form.
+  final VoidCallback onJoinAsGuest;
+
+  final String? configurationIssue;
+  final DeviceIdentityStore? identityStore;
+  final JoinPayloadScanner scanner;
+
+  static const Key payloadFieldKey = Key('host-entry-payload');
+  static const Key submitKey = Key('host-entry-submit');
+  static const Key errorKey = Key('host-entry-error');
+  static const Key scanKey = Key('host-entry-scan');
+  static const Key joinAsGuestKey = Key('host-entry-join-as-guest');
+
+  @override
+  State<HostEntryScreen> createState() => _HostEntryScreenState();
+}
+
+final class _HostEntryScreenState extends State<HostEntryScreen> {
+  final _payload = TextEditingController();
+  late final DeviceIdentityStore _identityStore =
+      widget.identityStore ?? DeviceIdentityStore();
+  String? _hostDeviceId;
+  String? _error;
+  bool _submitting = false;
+  bool _scanning = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _initialize();
+  }
+
+  Future<void> _initialize() async {
+    try {
+      final id = await _identityStore.getHostDeviceId();
+      if (mounted) setState(() => _hostDeviceId = id);
+    } catch (_) {
+      if (mounted) {
+        setState(
+          () => _error =
+              'Could not save this host device identity. Retry to continue.',
+        );
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _payload.dispose();
+    super.dispose();
+  }
+
+  Future<void> _submit() async {
+    if (_submitting || _hostDeviceId == null) return;
+    final pasted = _payload.text.trim();
+    if (pasted.isEmpty) {
+      setState(() => _error = 'Paste a host invitation or scan a Host QR.');
+      return;
+    }
+    final Result<GuestJoinData> result = parseGuestJoinPayload(
+      pasted,
+      localDeviceId: _hostDeviceId!,
+    );
+    switch (result) {
+      case Ok(:final GuestJoinData value):
+        if (value.role != JoinRole.host) {
+          setState(
+            () => _error =
+                'This is a guest invitation. Use “Join as guest” below '
+                'instead — host entry needs a Host QR.',
+          );
+          return;
+        }
+        setState(() {
+          _error = null;
+          _submitting = true;
+        });
+        try {
+          await widget.onHostJoin(value);
+        } on Object catch (error) {
+          if (mounted) setState(() => _error = '$error');
+        } finally {
+          if (mounted) setState(() => _submitting = false);
+        }
+      case Err(:final String message):
+        setState(() => _error = message);
+    }
+  }
+
+  Future<void> _scan() async {
+    if (_scanning || _submitting || _hostDeviceId == null) return;
+    setState(() => _scanning = true);
+    try {
+      // This State's context lives below the app's MaterialApp, so the
+      // scanner's route push resolves a real Navigator. Never retain the
+      // context beyond the future.
+      final result = await widget.scanner.scan(context);
+      if (!mounted) return;
+      if (result case JoinPayloadText(:final text)) {
+        setState(() => _payload.text = text);
+        await _submit();
+      } else if (result case JoinPayloadPermissionDenied(:final permanently)) {
+        setState(
+          () => _error = permanently
+              ? 'Camera access is off. Allow camera access in Settings to scan Host QR codes, or paste the invitation instead.'
+              : 'Camera permission is needed to scan Host QR codes. Allow access and try again, or paste the invitation instead.',
+        );
+      } else {
+        setState(() => _error = 'Scanner is unavailable on this device.');
+      }
+    } finally {
+      if (mounted) setState(() => _scanning = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar: AppBar(title: const Text('Halloween TV — Host entry')),
+    body: Center(
+      child: SingleChildScrollView(
+        padding: const EdgeInsets.all(24),
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(maxWidth: 560),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            mainAxisSize: MainAxisSize.min,
+            children: <Widget>[
+              const Text(
+                'Scan the Host QR shown on the organizer TV, or paste the '
+                'host invitation. Host access is a separate short-lived '
+                'invite — a guest PIN can never open it.',
+                style: TextStyle(fontSize: 18),
+              ),
+              if (widget.configurationIssue?.isNotEmpty == true)
+                Text('Backend is not configured: ${widget.configurationIssue}'),
+              const SizedBox(height: 16),
+              TextField(
+                key: HostEntryScreen.payloadFieldKey,
+                controller: _payload,
+                decoration: const InputDecoration(
+                  labelText: 'Host invitation (paste or scan)',
+                  hintText:
+                      '{"partyId":"…","channelId":"…","role":"host",'
+                      '"inviteToken":"hi-…"}',
+                  border: OutlineInputBorder(),
+                ),
+                minLines: 1,
+                maxLines: 4,
+                autocorrect: false,
+                enableSuggestions: false,
+              ),
+              TextButton(
+                key: HostEntryScreen.scanKey,
+                onPressed: _hostDeviceId == null || _submitting || _scanning
+                    ? null
+                    : _scan,
+                child: const Text('Scan Host QR'),
+              ),
+              if (_error != null)
+                Text(
+                  _error!,
+                  key: HostEntryScreen.errorKey,
+                  style: TextStyle(color: Theme.of(context).colorScheme.error),
+                ),
+              const SizedBox(height: 16),
+              ElevatedButton(
+                key: HostEntryScreen.submitKey,
+                onPressed: _hostDeviceId == null || _submitting
+                    ? null
+                    : _submit,
+                child: _submitting
+                    ? const CircularProgressIndicator()
+                    : const Text('Join as host'),
+              ),
+              const SizedBox(height: 8),
+              OutlinedButton(
+                key: HostEntryScreen.joinAsGuestKey,
+                onPressed: widget.onJoinAsGuest,
+                child: const Text('Join as guest'),
+              ),
+              if (_hostDeviceId == null) const Text('Preparing this device…'),
+            ],
+          ),
+        ),
+      ),
+    ),
+  );
+}
diff --git a/apps/companion_app/lib/src/ui/host_panel_screen.dart b/apps/companion_app/lib/src/ui/host_panel_screen.dart
