+      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,
+    });
+    assert.equal(joined.role, "host");
+  } finally {
+    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);
