index 0000000000000000000000000000000000000000..b52b7da8b3c42182597d3550321fa5c1b5e3ac19
--- /dev/null
+++ b/apps/companion_app/lib/src/ui/host_panel_screen.dart
@@ -0,0 +1,302 @@
+/// Host administration panel: server-backed seed catalog.
+///
+/// Lists seed entries and camera videos across every backend state (empty,
+/// queued, generating/running, ready, failed, expired, deleted). Generate
+/// enqueues the supported fixed preset with a stable idempotency key per
+/// seed id (retries reuse the queued job). Delete invokes the backend
+/// operation and reconciles the list only after authoritative success —
+/// failures leave the list untouched so they stay retryable. Deletion
+/// granularity is per selected seed id: the seed entries and their
+/// associated preview + delivery objects are removed, an affected current
+/// manifest is revoked, and accounting records are preserved (server-side).
+///
+/// Polling and preview playback suspend on background/leave through the
+/// owning [HostSession] (driven by the app lifecycle observer); stale
+/// responses from another party or role never update this panel because the
+/// session generation counter drops them before [HostSessionState] emits.
+library;
+
+import 'dart:async';
+
+import 'package:companion_app/src/data/host_media_client.dart';
+import 'package:companion_app/src/session/host_session.dart';
+import 'package:flutter/material.dart';
+
+/// Human-readable status labels for the seed lifecycle.
+String hostSeedStatusLabel(String status) => switch (status) {
+  'queued' => 'Queued',
+  'running' => 'Generating',
+  'ready' => 'Ready',
+  'failed' => 'Failed',
+  'deleted' => 'Deleted',
+  'expired' => 'Expired',
+  _ => status,
+};
+
+final class HostPanelScreen extends StatefulWidget {
+  const HostPanelScreen({
+    super.key,
+    required this.session,
+    required this.onLeave,
+    required this.onPreview,
+    this.onPhoto,
+  });
+
+  final HostSession session;
+
+  /// Leaves the host session (stops polling, clears identity + catalog).
+  final Future<void> Function() onLeave;
+
+  /// Opens the preview for [seedId] (fresh scoped capability per view).
+  final void Function(String seedId) onPreview;
+
+  /// Opens the optional source-photo flow, when a photo client is wired.
+  /// Null hides the entry point.
+  final VoidCallback? onPhoto;
+
+  static const Key listKey = Key('host-panel-list');
+  static const Key emptyKey = Key('host-panel-empty');
+  static const Key generateSeedKey = Key('host-panel-generate-seed');
+  static const Key generateKey = Key('host-panel-generate');
+  static const Key retryKey = Key('host-panel-retry');
+  static const Key leaveKey = Key('host-panel-leave');
+  static const Key messageKey = Key('host-panel-message');
+  static Key deleteKey(String seedId) => Key('host-delete-$seedId');
+  static Key viewKey(String seedId) => Key('host-view-$seedId');
+
+  @override
+  State<HostPanelScreen> createState() => _HostPanelScreenState();
+}
+
+final class _HostPanelScreenState extends State<HostPanelScreen> {
+  final TextEditingController _seedId = TextEditingController();
+  StreamSubscription<HostSessionState>? _states;
+  bool _working = false;
+  String? _actionError;
+  final Set<String> _busySeeds = <String>{};
+
+  @override
+  void initState() {
+    super.initState();
+    _states = widget.session.states.listen((_) {
+      if (mounted) setState(() {});
+    });
+  }
+
+  @override
+  void dispose() {
+    _states?.cancel();
+    _seedId.dispose();
+    super.dispose();
+  }
+
+  Future<void> _generate() async {
+    if (_working) return;
+    final String seedId = _seedId.text.trim();
+    if (seedId.isEmpty) {
+      setState(() => _actionError = 'Enter a seed id to generate.');
+      return;
+    }
+    setState(() {
+      _working = true;
+      _actionError = null;
+    });
+    try {
+      await widget.session.generate(seedId);
+    } on Object catch (error) {
+      if (mounted) setState(() => _actionError = '$error');
+    } finally {
+      if (mounted) setState(() => _working = false);
+    }
+  }
+
+  Future<void> _delete(String seedId) async {
+    if (_busySeeds.contains(seedId)) return;
+    setState(() {
+      _busySeeds.add(seedId);
+      _actionError = null;
+    });
+    try {
+      await widget.session.deleteVideos(<String>[seedId]);
+    } on Object catch (error) {
+      if (mounted) setState(() => _actionError = '$error');
+    } finally {
+      if (mounted) {
+        setState(() => _busySeeds.remove(seedId));
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final HostSessionState snapshot = widget.session.state;
+    return Scaffold(
+      appBar: AppBar(title: const Text('Host panel')),
+      body: Center(
+        child: SingleChildScrollView(
+          padding: const EdgeInsets.all(24),
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(maxWidth: 720),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              mainAxisSize: MainAxisSize.min,
+              children: <Widget>[
+                const Text(
+                  'Seed catalog for this party and channel',
+                  style: TextStyle(fontSize: 22, fontWeight: FontWeight.w800),
+                ),
+                if (snapshot.status == HostSessionStatus.stale)
+                  const Text('Connection lost — showing last-known catalog.'),
+                if (_actionError != null)
+                  Text(
+                    _actionError!,
+                    key: HostPanelScreen.messageKey,
+                    style: TextStyle(
+                      color: Theme.of(context).colorScheme.error,
+                    ),
+                  ),
+                const SizedBox(height: 8),
+                _body(snapshot),
+                const SizedBox(height: 20),
+                Wrap(
+                  spacing: 12,
+                  runSpacing: 12,
+                  children: <Widget>[
+                    if (snapshot.status == HostSessionStatus.ready ||
+                        snapshot.status == HostSessionStatus.stale) ...<Widget>[
+                      ElevatedButton(
+                        key: HostPanelScreen.retryKey,
+                        onPressed: () {
+                          widget.session.refresh();
+                        },
+                        child: const Text('Refresh'),
+                      ),
+                      if (widget.onPhoto != null)
+                        OutlinedButton(
+                          onPressed: widget.onPhoto,
+                          child: const Text('Attach source photo'),
+                        ),
+                    ],
+                    OutlinedButton(
+                      key: HostPanelScreen.leaveKey,
+                      onPressed: () {
+                        widget.onLeave();
+                      },
+                      child: const Text('Leave'),
+                    ),
+                  ],
+                ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _body(HostSessionState snapshot) {
+    switch (snapshot.status) {
+      case HostSessionStatus.idle:
+        return const Text('Not joined as host.');
+      case HostSessionStatus.loading:
+        return const Center(child: CircularProgressIndicator());
+      case HostSessionStatus.denied:
+        return Text(
+          snapshot.message ?? 'Access was denied.',
+          key: HostPanelScreen.messageKey,
+        );
+      case HostSessionStatus.unavailable:
+      case HostSessionStatus.invalidData:
+        return Text(
+          snapshot.message ?? 'Could not load the catalog.',
+          key: HostPanelScreen.messageKey,
+        );
+      case HostSessionStatus.ready:
+      case HostSessionStatus.stale:
+        return Column(
+          key: HostPanelScreen.listKey,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          mainAxisSize: MainAxisSize.min,
+          children: <Widget>[
+            _generateRow(),
+            const SizedBox(height: 12),
+            if (snapshot.videos.isEmpty)
+              const Text(
+                'No seed videos yet. Generate the first entry above.',
+                key: HostPanelScreen.emptyKey,
+              )
+            else
+              ...snapshot.videos.map(_seedTile),
+          ],
+        );
+    }
+  }
+
+  Widget _generateRow() => Row(
+    children: <Widget>[
+      Expanded(
+        child: TextField(
+          key: HostPanelScreen.generateSeedKey,
+          controller: _seedId,
+          decoration: const InputDecoration(
+            labelText: 'New seed id',
+            border: OutlineInputBorder(),
+          ),
+          autocorrect: false,
+          enableSuggestions: false,
+        ),
+      ),
+      const SizedBox(width: 12),
+      ElevatedButton(
+        key: HostPanelScreen.generateKey,
+        onPressed: _working ? null : _generate,
+        child: _working
+            ? const SizedBox(
+                width: 20,
+                height: 20,
+                child: CircularProgressIndicator(strokeWidth: 2),
+              )
+            : const Text('Generate'),
+      ),
+    ],
+  );
+
+  Widget _seedTile(HostSeedVideo video) {
+    final bool busy = _busySeeds.contains(video.seedId);
+    final bool deleted = video.status == 'deleted';
+    return Card(
+      key: Key('host-seed-${video.seedId}'),
+      margin: const EdgeInsets.symmetric(vertical: 6),
+      child: ListTile(
+        title: Text(
+          '${video.seedId} · ${hostSeedStatusLabel(video.status)}',
+          style: const TextStyle(fontSize: 20),
+        ),
+        subtitle: Text(
+          deleted
+              ? 'Deleted seed entry (tombstoned; previews will not return)'
+              : 'Job ${video.jobId} · cameras ${video.cameraIds.join(", ")}'
+                    '${video.previewAvailable ? " · preview ready" : ""}',
+          style: const TextStyle(fontSize: 16),
+        ),
+        trailing: deleted || busy
+            ? null
+            : Row(
+                mainAxisSize: MainAxisSize.min,
+                children: <Widget>[
+                  TextButton(
+                    key: HostPanelScreen.viewKey(video.seedId),
+                    onPressed: () => widget.onPreview(video.seedId),
+                    child: const Text('View'),
+                  ),
+                  TextButton(
+                    key: HostPanelScreen.deleteKey(video.seedId),
+                    onPressed: () => _delete(video.seedId),
+                    child: const Text('Delete'),
+                  ),
+                ],
+              ),
+      ),
+    );
+  }
+}
diff --git a/apps/companion_app/lib/src/ui/host_video_preview_screen.dart b/apps/companion_app/lib/src/ui/host_video_preview_screen.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9b3e228d84623e5eea1743d6e9def14620c48ada
--- /dev/null
+++ b/apps/companion_app/lib/src/ui/host_video_preview_screen.dart
@@ -0,0 +1,241 @@
+/// Host video preview: fresh scoped capability per view + playback.
+///
+/// The screen requests a new preview capability on open
+/// ([HostSession.preview] → `getHostVideoPreview`): signed URLs are
+/// short-lived and never persisted, so a cached capability is never reused.
+/// Tapping a camera creates its player; switching cameras or leaving the
+/// screen disposes the previous player. Backgrounding pauses playback
+/// (the app observer additionally suspends catalog polling while the
+/// capability itself simply expires server-side).
+///
+/// The [playerFactory] seam substitutes ONLY the platform player boundary
+/// (the shipped default builds a real [VideoPlayerController]); everything
+/// above it — capability fetch, validation, play/dispose lifecycle — is the
+/// real production path.
+library;
+
+import 'package:companion_app/src/data/host_media_client.dart';
+import 'package:companion_app/src/session/host_session.dart';
+import 'package:flutter/material.dart';
+import 'package:video_player/video_player.dart';
+
+/// Platform player boundary for host previews.
+abstract interface class HostPreviewPlayer {
+  Future<void> initialize();
+  Future<void> play();
+  Future<void> pause();
+  Future<void> dispose();
+  bool get isInitialized;
+  double get aspectRatio;
+  Widget buildView();
+}
+
+final class _VideoPreviewPlayer implements HostPreviewPlayer {
+  _VideoPreviewPlayer(Uri url)
+    : _controller = VideoPlayerController.networkUrl(url);
+
+  final VideoPlayerController _controller;
+
+  @override
+  Future<void> initialize() => _controller.initialize();
+
+  @override
+  Future<void> play() => _controller.play();
+
+  @override
+  Future<void> pause() => _controller.pause();
+
+  @override
+  Future<void> dispose() => _controller.dispose();
+
+  @override
+  bool get isInitialized => _controller.value.isInitialized;
+
+  @override
+  double get aspectRatio => _controller.value.aspectRatio;
+
+  @override
+  Widget buildView() => VideoPlayer(_controller);
+}
+
+final class HostVideoPreviewScreen extends StatefulWidget {
+  const HostVideoPreviewScreen({
+    super.key,
+    required this.session,
+    required this.seedId,
+    this.playerFactory = _VideoPreviewPlayer.new,
+  });
+
+  final HostSession session;
+  final String seedId;
+
+  /// Substitutes only the platform player boundary.
+  final HostPreviewPlayer Function(Uri url) playerFactory;
+
+  static const Key statusKey = Key('host-preview-status');
+  static const Key errorKey = Key('host-preview-error');
+  static const Key videoKey = Key('host-preview-video');
+  static Key playKey(String cameraId) => Key('host-preview-play-$cameraId');
+
+  @override
+  State<HostVideoPreviewScreen> createState() => _HostVideoPreviewScreenState();
+}
+
+final class _HostVideoPreviewScreenState extends State<HostVideoPreviewScreen>
+    with WidgetsBindingObserver {
+  late final Future<HostVideoPreview> _capability;
+  HostPreviewPlayer? _player;
+  String? _activeCamera;
+  String? _playError;
+  bool _initializing = false;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    // Fresh scoped capability per view: never reuse a cached preview.
+    _capability = widget.session.preview(widget.seedId);
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.paused) {
+      _player?.pause();
+    }
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _disposePlayer();
+    super.dispose();
+  }
+
+  void _disposePlayer() {
+    final HostPreviewPlayer? player = _player;
+    _player = null;
+    _activeCamera = null;
+    if (player != null) {
+      player.pause();
+      player.dispose();
+    }
+  }
+
+  Future<void> _play(HostVideoPreviewClip clip) async {
+    if (_initializing || _activeCamera == clip.cameraId) return;
+    setState(() {
+      _initializing = true;
+      _playError = null;
+    });
+    _disposePlayer();
+    final HostPreviewPlayer player = widget.playerFactory(clip.url);
+    try {
+      await player.initialize();
+      if (!mounted) {
+        await player.dispose();
+        return;
+      }
+      setState(() {
+        _player = player;
+        _activeCamera = clip.cameraId;
+      });
+      await player.play();
+    } on Object catch (error) {
+      await player.dispose();
+      if (mounted) {
+        setState(() => _playError = 'Could not play ${clip.cameraId}');
+        // Keep the raw platform detail out of the UI; it stays in debug
+        // logs only.
+        debugPrint('Host preview playback failed: $error');
+      }
+    } finally {
+      if (mounted) setState(() => _initializing = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar: AppBar(title: Text('Preview ${widget.seedId}')),
+    body: Center(
+      child: SingleChildScrollView(
+        padding: const EdgeInsets.all(24),
+        child: ConstrainedBox(
+          constraints: const BoxConstraints(maxWidth: 720),
+          child: FutureBuilder<HostVideoPreview>(
+            future: _capability,
+            builder: (context, snapshot) {
+              if (snapshot.connectionState != ConnectionState.done) {
+                return const Center(
+                  key: HostVideoPreviewScreen.statusKey,
+                  child: CircularProgressIndicator(),
+                );
+              }
+              if (snapshot.hasError) {
+                return Text(
+                  '${snapshot.error}',
+                  key: HostVideoPreviewScreen.errorKey,
+                  style: TextStyle(color: Theme.of(context).colorScheme.error),
+                );
+              }
+              final HostVideoPreview preview = snapshot.data!;
+              return Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                mainAxisSize: MainAxisSize.min,
+                children: <Widget>[
+                  if (_player != null && _player!.isInitialized) ...<Widget>[
+                    AspectRatio(
+                      key: HostVideoPreviewScreen.videoKey,
+                      aspectRatio: _player!.aspectRatio,
+                      child: _player!.buildView(),
+                    ),
+                    const SizedBox(height: 12),
+                  ],
+                  if (_playError != null)
+                    Text(
+                      _playError!,
+                      key: HostVideoPreviewScreen.errorKey,
+                      style: TextStyle(
+                        color: Theme.of(context).colorScheme.error,
+                      ),
+                    ),
+                  ...preview.clips.map(
+                    (clip) => Card(
+                      key: Key('host-preview-clip-${clip.cameraId}'),
+                      margin: const EdgeInsets.symmetric(vertical: 6),
+                      child: ListTile(
+                        title: Text(
+                          clip.cameraId,
+                          style: const TextStyle(fontSize: 20),
+                        ),
+                        subtitle: const Text('Signed preview (short-lived)'),
+                        trailing: _initializing && _activeCamera == null
+                            ? const SizedBox(
+                                width: 20,
+                                height: 20,
+                                child: CircularProgressIndicator(
+                                  strokeWidth: 2,
+                                ),
+                              )
+                            : TextButton(
+                                key: HostVideoPreviewScreen.playKey(
+                                  clip.cameraId,
+                                ),
+                                onPressed: () => _play(clip),
+                                child: Text(
+                                  _activeCamera == clip.cameraId
+                                      ? 'Playing'
+                                      : 'Play',
+                                ),
+                              ),
+                      ),
+                    ),
+                  ),
+                ],
+              );
+            },
+          ),
+        ),
+      ),
+    ),
+  );
+}
diff --git a/apps/companion_app/test/host_flow_test.dart b/apps/companion_app/test/host_flow_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..17eda0bca945ad280a9f1f4fa89caf98e3e591a5
--- /dev/null
+++ b/apps/companion_app/test/host_flow_test.dart
@@ -0,0 +1,1002 @@
+// Host-first navigation, role-aware joining, and video administration.
+//
+// Exercises the REAL parser (guest_join_data role validation), the REAL
+// HostEntryScreen/JoinScreen routing, the REAL HostSession state machine,
+// and REAL response validation (HostJoinClient/HostMediaClient). ONLY the
+// platform/network boundaries are substituted: fake callable invokers
+// (never the clients, never the session) and fake scanners. No Firebase
+// initialization, no network traffic.
+
+import 'dart:async';
+
+import 'package:channel_api/channel_api.dart';
+import 'package:cloud_functions/cloud_functions.dart' as cloud_functions;
+import 'package:companion_app/src/companion_app.dart';
+import 'package:companion_app/src/config/backend_config.dart';
+import 'package:companion_app/src/data/host_join_client.dart';
+import 'package:companion_app/src/data/host_media_client.dart';
+import 'package:companion_app/src/data/party_join_client.dart';
+import 'package:companion_app/src/join/device_identity_store.dart';
+import 'package:companion_app/src/join/guest_join_data.dart';
+import 'package:companion_app/src/join/join_payload_scanner.dart';
+import 'package:companion_app/src/session/host_session.dart';
+import 'package:companion_app/src/ui/host_entry_screen.dart';
+import 'package:companion_app/src/ui/host_panel_screen.dart';
+import 'package:companion_app/src/ui/host_video_preview_screen.dart';
+import 'package:companion_app/src/ui/join_screen.dart';
+import 'package:core_foundation/core_foundation.dart'
+    show Ok, Result, SystemClock;
+import 'package:core_playlist/core_playlist.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:infra_firestore/infra_firestore.dart'
+    show FirebaseManifestCallableInvoker, ManifestTransportException;
+import 'package:shared_preferences/shared_preferences.dart';
+
+const String kGuestDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
+const String kHostDeviceId = 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
+const String kHostToken =
+    'hi-0123456789abcdef0123456789abcdef0123456789abcdef01';
+
+String hostPayload({
+  String party = 'party-1',
+  String channel = 'cctv',
+  String token = kHostToken,
+}) =>
+    '{"partyId":"$party","channelId":"$channel","role":"host",'
+    '"inviteToken":"$token"}';
+
+GuestJoinData hostData({
+  String party = 'party-1',
+  String channel = 'cctv',
+  String device = kHostDeviceId,
+  String token = kHostToken,
+}) {
+  final Result<GuestJoinData> result = parseGuestJoinFields(
+    partyId: party,
+    localDeviceId: device,
+    channelId: channel,
+    role: JoinRole.host,
+    inviteToken: token,
+  );
+  return (result as Ok<GuestJoinData>).value;
+}
+
+/// Fake joinHost boundary: echoes the requested scope into a valid host
+/// registration, or throws [failure] to script denial paths.
+final class FakeHostJoinInvoker implements HostJoinCallableInvoker {
+  int calls = 0;
+  Map<String, Object?>? lastPayload;
+  Object? failure;
+  Object? nextResponse;
+  bool createdFirst = true;
+  bool _created = false;
+
+  @override
+  Future<Object?> call(String name, Map<String, Object?> payload) async {
+    calls++;
+    lastPayload = Map<String, Object?>.of(payload);
+    final Object? error = failure;
+    if (error != null) throw error;
+    if (name != kJoinHostCallable) throw StateError('unexpected $name');
+    final Object? override = nextResponse;
+    if (override != null) {
+      nextResponse = null;
+      return override;
+    }
+    final bool created = createdFirst && !_created;
+    _created = true;
+    return <String, Object?>{
+      'partyId': payload['partyId'],
+      'deviceId': payload['deviceId'],
+      'channelId': payload['channelId'],
+      'role': 'host',
+      'status': 'active',
+      'created': created,
+    };
+  }
+}
+
+/// Fake host-media boundary: backend-faithful seed catalog behavior.
+final class FakeHostMediaInvoker implements HostMediaCallableInvoker {
+  final List<String> names = <String>[];
+  final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];
+  final List<Map<String, Object?>> seeds = <Map<String, Object?>>[];
+  Object? failure;
+  int previews = 0;
+
+  static Map<String, Object?> seedJson(String id, String status) =>
+      <String, Object?>{
+        'seedId': id,
+        'partyId': 'party-1',
+        'channelId': 'cctv',
+        'status': status,
+        'jobId': 'hv-$id',
+        'createdAt': '2026-10-29T14:00:00.000Z',
+        'expiresAt': '2030-01-01T00:00:00.000Z',
+        'previewAvailable': status == 'ready',
+        'cameraIds': const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],
+      };
+
+  @override
+  Future<Object?> call(String name, Map<String, Object?> payload) async {
+    names.add(name);
+    payloads.add(Map<String, Object?>.of(payload));
+    final Object? error = failure;
+    if (error != null) throw error;
+    switch (name) {
+      case kListHostVideos:
+        return <String, Object?>{
+          'videos': <Object?>[
+            for (final s in seeds) Map<String, Object?>.of(s),
+          ],
+        };
+      case kGenerateHostVideo:
+        final String seedId = payload['seedId'] as String;
+        final bool exists = seeds.any((s) => s['seedId'] == seedId);
+        if (!exists) {
+          seeds.add(seedJson(seedId, 'queued'));
+          return <String, Object?>{
+            'seedId': seedId,
+            'jobId': 'hv-$seedId',
+            'state': 'queued',
+            'created': true,
+          };
+        }
+        return <String, Object?>{
+          'seedId': seedId,
+          'jobId': 'hv-$seedId',
+          'state': 'queued',
+          'created': false,
+        };
+      case kGetHostVideoPreview:
+        previews++;
+        final String seedId = payload['seedId'] as String;
+        return <String, Object?>{
+          'seedId': seedId,
+          'expiresAt': '2030-01-01T00:00:00.000Z',
+          'clips': <Object?>[
+            for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])
+              <String, Object?>{
+                'cameraId': camera,
+                'sha256': List.filled(64, 'a').join(),
+                'url': 'https://preview.example/$seedId/$camera.mp4',
+                'expiresAt': '2030-01-01T00:00:00.000Z',
+              },
+          ],
+        };
+      case kDeleteHostVideo:
+        final List<String> ids = <String>[
+          for (final Object? id in payload['seedIds'] as List) id.toString(),
+        ];
+        seeds.removeWhere((s) => ids.contains(s['seedId']));
+        return <String, Object?>{
+          'deletedSeedIds': ids,
+          'deletedObjects': <String>[
+            for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',
+          ],
+          'revokedManifest': true,
+        };
+    }
+    throw StateError('unexpected callable $name');
+  }
+}
+
+final class FakeJoinInvoker implements PartyJoinCallableInvoker {
+  int calls = 0;
+  @override
+  Future<Object?> call(String name, Map<String, Object?> payload) async {
+    calls++;
+    return <String, Object?>{
+      'partyId': payload['partyId'],
+      'deviceId': payload['deviceId'],
+      'channelId': payload['channelId'],
+      'role': 'guest',
+      'status': 'active',
+      'created': true,
+    };
+  }
+}
+
+final class FakeManifestInvoker implements FirebaseManifestCallableInvoker {
+  @override
+  Future<Object?> call(String name, Map<String, Object?> payload) async =>
+      throw UnimplementedError();
+}
+
+final class FakeManifestSource implements ManifestSource<PlaybackManifest> {
+  @override
+  Stream<PlaybackManifest> watchCurrent({
+    required String partyId,
+    required String channelId,
+  }) => const Stream<PlaybackManifest>.empty();
+}
+
+final class FakeScanner implements JoinPayloadScanner {
+  FakeScanner(this.result);
+  final JoinPayloadScanResult result;
+  @override
+  Future<JoinPayloadScanResult> scan([BuildContext? context]) async => result;
+}
+
+Future<void> flush(WidgetTester tester) async {
+  for (int i = 0; i < 6; i++) {
+    await tester.pump(const Duration(milliseconds: 50));
+  }
+}
+
+Future<void> enterVisible(
+  WidgetTester tester,
+  Finder finder,
+  String text,
+) async {
+  await tester.ensureVisible(finder);
+  await tester.pump(const Duration(milliseconds: 50));
+  await tester.enterText(finder, text);
+}
+
+Future<void> tapVisible(WidgetTester tester, Finder finder) async {
+  await tester.ensureVisible(finder);
+  await tester.pump(const Duration(milliseconds: 50));
+  await tester.tap(finder);
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  group('host session (real session, fake invoker boundary)', () {
+    late FakeHostJoinInvoker joinInvoker;
+    late FakeHostMediaInvoker mediaInvoker;
+    final List<HostSession> sessions = <HostSession>[];
+
+    HostSession openSession() {
+      final HostSession session = HostSession(
+        joinClient: HostJoinClient(invoker: joinInvoker),
+        mediaClient: HostMediaClient(invoker: mediaInvoker),
+      );
+      sessions.add(session);
+      return session;
+    }
+
+    setUp(() {
+      joinInvoker = FakeHostJoinInvoker();
+      mediaInvoker = FakeHostMediaInvoker()
+        ..seeds.addAll(<Map<String, Object?>>[
+          FakeHostMediaInvoker.seedJson('catalog-1', 'ready'),
+          FakeHostMediaInvoker.seedJson('catalog-2', 'queued'),
+        ]);
+    });
+
+    tearDown(() async {
+      for (final HostSession session in sessions) {
+        await session.dispose();
+      }
+      sessions.clear();
+    });
+
+    test('join validates scope and loads the catalog', () async {
+      final HostSession session = openSession();
+      await session.join(hostData());
+      expect(session.state.status, HostSessionStatus.ready);
+      expect(session.state.binding?.deviceId.value, kHostDeviceId);
+      expect(session.videos.map((v) => '${v.seedId}:${v.status}'), <String>[
+        'catalog-1:ready',
+        'catalog-2:queued',
+      ]);
+      expect(joinInvoker.lastPayload, <String, Object?>{
+        'partyId': 'party-1',
+        'deviceId': kHostDeviceId,
+        'channelId': 'cctv',
+        'inviteToken': kHostToken,
+      });
+      expect(joinInvoker.lastPayload, isNot(contains('role')));
+    });
+
+    test('guest payloads never reach joinHost', () async {
+      final HostSession session = openSession();
+      final Result<GuestJoinData> parsed = parseGuestJoinPayload(
+        '{"partyId":"party-1","channelId":"cctv"}',
+        localDeviceId: kGuestDeviceId,
+      );
+      final GuestJoinData guest = (parsed as Ok<GuestJoinData>).value;
+      await expectLater(session.join(guest), throwsA(isA<HostJoinException>()));
+      expect(joinInvoker.calls, 0);
+      expect(session.state.status, HostSessionStatus.idle);
+    });
+
