n33: \n34: export interface RetentionResult {\n35:   expiredJobs: number;\n36:   deletedExpiredObjects: number;\n37:   deletedOrphanObjects: number;\n38:   expiredGuestInputs: number;\n39: }\n40: \n41: /** Scheduled TTL transition plus orphan cleanup; object deletion is idempotent. */\n42: export async function sweepExpiredMedia(\n43:   db: Firestore,\n44:   bucket: Bucket,\n45:   now = new Date(),\n46: ): Promise<RetentionResult> {\n47:   const expiredSnapshot = await db.collectionGroup(\"jobs\")\n48:     .where(\"expiresAt\", \"<=\", Timestamp.fromDate(now))\n49:     .get();\n50:   let expiredJobs = 0;\n51:   for (const snapshot of expiredSnapshot.docs) {\n52:     const job = snapshot.data();\n53:     const paths = new Set<string>();\n54:     addPaths(paths, job.deliveryPaths);\n55:     addPaths(paths, job.generatedPaths);\n56:     // Staged camera outputs of a dead job are temporary: purge them here so\n57:     // they do not linger past expiry (live staged outputs are protected by\n58:     // the references set below, never by this block).\n59:     const staged = job.stagedOutputs;\n60:     if (staged && typeof staged === \"object\") {\n61:       for (const clip of Object.values(staged as Record<string, unknown>)) {\n62:         if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\" &&\n63:             ((clip as Record<string, unknown>).objectPath as string).startsWith(\"parties/\")) {\n64:           paths.add((clip as Record<string, unknown>).objectPath as string);\n65:         }\n66:       }\n67:     }\n68:     await db.runTransaction(async (transaction) => {\n69:       const current = await transaction.get(snapshot.ref);\n70:       if (!current.exists) return;\n71:       const data = current.data()!;\n72:       if (data.state !== \"purged\" && data.state !== \"expired\") {\n73:         transaction.update(snapshot.ref, {\n74:           state: \"expired\",\n75:           errorCode: \"CLIP_EXPIRED\",\n76:           expiredAt: FieldValue.serverTimestamp(),\n77:           timestamp: FieldValue.serverTimestamp(),\n78:         });\n79:         expiredJobs += 1;\n80:       }\n81:     });\n82:     await Promise.all([...paths].map((path) => bucket.file(path).delete({ ignoreNotFound: true })));\n83:   }\n84: \n85:   const references = new Set<string>();\n86:   const liveJobPairs = new Set<string>();\n87:   const [manifests, jobs, guestMedia] = await Promise.all([\n88:     db.collectionGroup(\"manifests\").get(),\n89:     db.collectionGroup(\"jobs\").get(),\n90:     db.collectionGroup(\"guestMedia\").get(),\n91:   ]);\n92:   // Guest consent inputs: live (unexpired, not withdrawn) ingest objects are\n93:   // protected from the orphan sweep. Abandoned pending uploads and expired\n94:   // eligible inputs are removed within the capped 24h input TTL below.\n95:   let expiredGuestInputs = 0;\n96:   for (const guestDoc of guestMedia.docs) {\n97:     const guest = guestDoc.data();\n98:     const objectPath = typeof guest.objectPath === \"string\" ? guest.objectPath : undefined;\n99:     const expiry = expiryDate(guest.expiresAt);\n100:     const liveGuest = (guest.status === \"pending_upload\" || guest.status === \"eligible\") &&\n101:       expiry !== undefined && expiry > now;\n102:     if (liveGuest && objectPath && objectPath.startsWith(\"parties/\")) {\n103:       references.add(objectPath);\n104:       continue;\n105:     }\n106:     if ((guest.status === \"pending_upload\" || guest.status === \"eligible\") && objectPath && objectPath.startsWith(\"parties/\")) {\n107:       let deleted = false;\n108:       for (let attempt = 0; attempt < 3 && !deleted; attempt += 1) {\n109:         try {\n110:           await bucket.file(objectPath).delete({ ignoreNotFound: true });\n111:           deleted = true;\n112:         } catch {\n113:           deleted = false;\n114:         }\n115:       }\n116:       if (deleted) expiredGuestInputs += 1;\n117:       // Minimize retained audit metadata once the deadline passes.\n118:       await guestDoc.ref.update({\n119:         status: \"expired\",\n120:         sourceHash: FieldValue.delete(),\n121:         sourceSizeBytes: FieldValue.delete(),\n122:         sourceGeneration: FieldValue.delete(),\n123:         contentType: FieldValue.delete(),\n124:         expiredAt: FieldValue.serverTimestamp(),\n125:         updatedAt: FieldValue.serverTimestamp(),\n126:       }).catch(() => undefined);\n127:     }\n128:   }\n129:   // Withdrawn submissions revoke delivery eligibility: their manifests must\n130:   // never be protected from deletion, and any pending derivative deletions\n131:   // persisted at withdrawal are retried here (not protected).\n132:   const withdrawnSubmissions = new Set<string>();\n133:   const revokedPaths = new Set<string>();\n134:   for (const guestDoc of guestMedia.docs) {\n135:     const guest = guestDoc.data() as Record<string, unknown>;\n136:     if (guest.status === \"withdrawn\" || guest.tombstone === true) {\n137:       if (typeof guest.submissionId === \"string\") withdrawnSubmissions.add(guest.submissionId);\n138:       for (const key of [\"pendingDeletions\", \"revokedManifestPaths\"] as const) {\n139:         const list = guest[key];\n140:         if (Array.isArray(list)) {\n141:           for (const item of list) if (typeof item === \"string\" && item.startsWith(\"parties/\")) revokedPaths.add(item);\n142:         }\n143:       }\n144:       if (typeof guest.objectPath === \"string\" && (guest.objectPath as string).startsWith(\"parties/\")) {\n145:         revokedPaths.add(guest.objectPath as string);\n146:       }\n147:     }\n148:   }\n149:   for (const manifestDoc of manifests.docs) {\n150:     const manifest = manifestDoc.data();\n151:     const expiry = expiryDate(manifest.expiresAt);\n152:     if (expiry && expiry > now && Array.isArray(manifest.cameraClips)) {\n153:       // Revoked manifests (produced from a withdrawn guest submission) are\n154:       // never protected: their clips are retried for deletion below instead\n155:       // of lingering past withdrawal.\n156:       if (typeof manifest.jobId === \"string\" && isRevokedManifest(manifest.jobId, jobs, withdrawnSubmissions)) {\n157:         for (const clip of manifest.cameraClips) {\n158:           if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n159:             revokedPaths.add((clip as Record<string, unknown>).objectPath as string);\n160:           }\n161:         }\n162:         continue;\n163:       }\n164:       for (const clip of manifest.cameraClips) if (typeof clip?.objectPath === \"string\") references.add(clip.objectPath);\n165:     } else if (Array.isArray(manifest.cameraClips) && typeof manifest.jobId === \"string\" &&\n166:         isRevokedManifest(manifest.jobId, jobs, withdrawnSubmissions)) {\n167:       // Even an expired revoked manifest's clips are queued for retry so a\n168:       // withdrawal is never left to the orphan pass alone.\n169:       for (const clip of manifest.cameraClips) {\n170:         if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n171:           revokedPaths.add((clip as Record<string, unknown>).objectPath as string);\n172:         }\n173:       }\n174:     }\n175:   }\n176:   for (const jobDoc of jobs.docs) {\n177:     const job = jobDoc.data();\n178:     const expiry = expiryDate(job.expiresAt);\n179:     if (expiry && expiry > now && ![\"expired\", \"purged\", \"failed\"].includes(String(job.state))) {\n180:       const pairParty = jobDoc.ref.parent.parent?.id ?? \"\";\n181:       if (typeof jobDoc.id === \"string\" && jobDoc.id && pairParty) liveJobPairs.add(`${pairParty}/${jobDoc.id}`);\n182:       addPaths(references, job.deliveryPaths);\n183:       addPaths(references, job.generatedPaths);\n184:       // Staged camera outputs live only in job.stagedOutputs until publish;\n185:       // without this the orphan pass deletes a running job's clips.\n186:       const staged = job.stagedOutputs;\n187:       if (staged && typeof staged === \"object\") {\n188:         for (const clip of Object.values(staged as Record<string, unknown>)) {\n189:           if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n190:             references.add((clip as Record<string, unknown>).objectPath as string);\n191:           }\n192:         }\n193:       }\n194:     }\n195:   }\n196: \n197:   const [files] = await bucket.getFiles({ prefix: \"parties/\" });\n198:   let deletedExpiredObjects = 0;\n199:   let deletedOrphanObjects = 0;\n200:   // Retry revoked-manifest objects (and pending withdrawal deletions) before\n201:   // the orphan pass so they are deleted even if a stale reference rebuild\n202:   // would otherwise protect them. Idempotent: missing objects are ignored.\n203:   for (const path of revokedPaths) {\n204:     if (references.has(path)) references.delete(path);\n205:     try {\n206:       const [exists] = await bucket.file(path).exists();\n207:       if (!exists) continue;\n208:       await bucket.file(path).delete({ ignoreNotFound: true });\n209:       deletedOrphanObjects += 1;\n210:     } catch {\n211:       // Left for the next sweep; never counted as deleted.\n212:     }\n213:   }\n214:   for (const file of files) {\n215:     const path = file.name;\n216:     if (!path || path.endsWith(\"/\")) continue;\n217:     const [metadata] = await file.getMetadata().catch(() => [undefined]);\n218:     const customExpiry = metadata?.metadata?.expiresAt;\n219:     const expires = expiryDate(customExpiry);\n220:     if (expires && expires <= now) {\n221:       await file.delete({ ignoreNotFound: true });\n222:       deletedExpiredObjects += 1;\n223:       continue;\n224:     }\n225:     if (references.has(path)) continue;\n226:     // Backstop for in-flight uploads whose paths are not yet listed on any\n227:     // document (e.g. seed objects between upload and the seeding transaction):\n228:     // a live (partyId, jobId) pair recorded in the object's own metadata\n229:     // keeps it until the owning job leaves the live set.\n230:     const objectJobId = metadata?.metadata?.jobId;\n231:     const objectPartyId = metadata?.metadata?.partyId;\n232:     if (typeof objectJobId === \"string\" && objectJobId && typeof objectPartyId === \"string\" && objectPartyId &&\n233:         liveJobPairs.has(`${objectPartyId}/${objectJobId}`)) continue;\n234:     await file.delete({ ignoreNotFound: true });\n235:     deletedOrphanObjects += 1;\n236:   }\n237:   return { expiredJobs, deletedExpiredObjects, deletedOrphanObjects, expiredGuestInputs };\n238: }\n239: \n240: export function createRetentionService(db: Firestore, bucket: Bucket, clock?: () => Date) {\n241:   return async () => sweepExpiredMedia(db, bucket, clock?.() ?? new Date());\n242: }\n243: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/retention.ts, lines 1-243\n1: import { Bucket } from \"@google-cloud/storage\";\n2: import { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\n3: import { BackendError } from \"./contracts\";\n4: \n5: function expiryDate(value: unknown): Date | undefined {\n6:   if (value instanceof Timestamp) return value.toDate();\n7:   if (value instanceof Date) return value;\n8:   if (typeof value === \"string\") {\n9:     const result = new Date(value);\n10:     return Number.isFinite(result.getTime()) ? result : undefined;\n11:   }\n12:   return undefined;\n13: }\n14: \n15: function addPaths(target: Set<string>, value: unknown): void {\n16:   if (Array.isArray(value)) for (const item of value) if (typeof item === \"string\" && item.startsWith(\"parties/\")) target.add(item);\n17: }\n18: \n19: /** A manifest is revoked when its job is bound to a withdrawn submission. */\n20: function isRevokedManifest(\n21:   jobId: string,\n22:   jobs: FirebaseFirestore.QuerySnapshot<FirebaseFirestore.DocumentData, FirebaseFirestore.DocumentData>,\n23:   withdrawnSubmissions: Set<string>,\n24: ): boolean {\n25:   for (const jobDoc of jobs.docs) {\n26:     if (jobDoc.id !== jobId) continue;\n27:     const job = jobDoc.data() as Record<string, unknown>;\n28:     const guest = job.guestMedia as Record<string, unknown> | undefined;\n29:     return typeof guest?.submissionId === \"string\" && withdrawnSubmissions.has(guest.submissionId);\n30:   }\n31:   return false;\n32: }\n33: \n34: export interface RetentionResult {\n35:   expiredJobs: number;\n36:   deletedExpiredObjects: number;\n37:   deletedOrphanObjects: number;\n38:   expiredGuestInputs: number;\n39: }\n40: \n41: /** Scheduled TTL transition plus orphan cleanup; object deletion is idempotent. */\n42: export async function sweepExpiredMedia(\n43:   db: Firestore,\n44:   bucket: Bucket,\n45:   now = new Date(),\n46: ): Promise<RetentionResult> {\n47:   const expiredSnapshot = await db.collectionGroup(\"jobs\")\n48:     .where(\"expiresAt\", \"<=\", Timestamp.fromDate(now))\n49:     .get();\n50:   let expiredJobs = 0;\n51:   for (const snapshot of expiredSnapshot.docs) {\n52:     const job = snapshot.data();\n53:     const paths = new Set<string>();\n54:     addPaths(paths, job.deliveryPaths);\n55:     addPaths(paths, job.generatedPaths);\n56:     // Staged camera outputs of a dead job are temporary: purge them here so\n57:     // they do not linger past expiry (live staged outputs are protected by\n58:     // the references set below, never by this block).\n59:     const staged = job.stagedOutputs;\n60:     if (staged && typeof staged === \"object\") {\n61:       for (const clip of Object.values(staged as Record<string, unknown>)) {\n62:         if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\" &&\n63:             ((clip as Record<string, unknown>).objectPath as string).startsWith(\"parties/\")) {\n64:           paths.add((clip as Record<string, unknown>).objectPath as string);\n65:         }\n66:       }\n67:     }\n68:     await db.runTransaction(async (transaction) => {\n69:       const current = await transaction.get(snapshot.ref);\n70:       if (!current.exists) return;\n71:       const data = current.data()!;\n72:       if (data.state !== \"purged\" && data.state !== \"expired\") {\n73:         transaction.update(snapshot.ref, {\n74:           state: \"expired\",\n75:           errorCode: \"CLIP_EXPIRED\",\n76:           expiredAt: FieldValue.serverTimestamp(),\n77:           timestamp: FieldValue.serverTimestamp(),\n78:         });\n79:         expiredJobs += 1;\n80:       }\n81:     });\n82:     await Promise.all([...paths].map((path) => bucket.file(path).delete({ ignoreNotFound: true })));\n83:   }\n84: \n85:   const references = new Set<string>();\n86:   const liveJobPairs = new Set<string>();\n87:   const [manifests, jobs, guestMedia] = await Promise.all([\n88:     db.collectionGroup(\"manifests\").get(),\n89:     db.collectionGroup(\"jobs\").get(),\n90:     db.collectionGroup(\"guestMedia\").get(),\n91:   ]);\n92:   // Guest consent inputs: live (unexpired, not withdrawn) ingest objects are\n93:   // protected from the orphan sweep. Abandoned pending uploads and expired\n94:   // eligible inputs are removed within the capped 24h input TTL below.\n95:   let expiredGuestInputs = 0;\n96:   for (const guestDoc of guestMedia.docs) {\n97:     const guest = guestDoc.data();\n98:     const objectPath = typeof guest.objectPath === \"string\" ? guest.objectPath : undefined;\n99:     const expiry = expiryDate(guest.expiresAt);\n100:     const liveGuest = (guest.status === \"pending_upload\" || guest.status === \"eligible\") &&\n101:       expiry !== undefined && expiry > now;\n102:     if (liveGuest && objectPath && objectPath.startsWith(\"parties/\")) {\n103:       references.add(objectPath);\n104:       continue;\n105:     }\n106:     if ((guest.status === \"pending_upload\" || guest.status === \"eligible\") && objectPath && objectPath.startsWith(\"parties/\")) {\n107:       let deleted = false;\n108:       for (let attempt = 0; attempt < 3 && !deleted; attempt += 1) {\n109:         try {\n110:           await bucket.file(objectPath).delete({ ignoreNotFound: true });\n111:           deleted = true;\n112:         } catch {\n113:           deleted = false;\n114:         }\n115:       }\n116:       if (deleted) expiredGuestInputs += 1;\n117:       // Minimize retained audit metadata once the deadline passes.\n118:       await guestDoc.ref.update({\n119:         status: \"expired\",\n120:         sourceHash: FieldValue.delete(),\n121:         sourceSizeBytes: FieldValue.delete(),\n122:         sourceGeneration: FieldValue.delete(),\n123:         contentType: FieldValue.delete(),\n124:         expiredAt: FieldValue.serverTimestamp(),\n125:         updatedAt: FieldValue.serverTimestamp(),\n126:       }).catch(() => undefined);\n127:     }\n128:   }\n129:   // Withdrawn submissions revoke delivery eligibility: their manifests must\n130:   // never be protected from deletion, and any pending derivative deletions\n131:   // persisted at withdrawal are retried here (not protected).\n132:   const withdrawnSubmissions = new Set<string>();\n133:   const revokedPaths = new Set<string>();\n134:   for (const guestDoc of guestMedia.docs) {\n135:     const guest = guestDoc.data() as Record<string, unknown>;\n136:     if (guest.status === \"withdrawn\" || guest.tombstone === true) {\n137:       if (typeof guest.submissionId === \"string\") withdrawnSubmissions.add(guest.submissionId);\n138:       for (const key of [\"pendingDeletions\", \"revokedManifestPaths\"] as const) {\n139:         const list = guest[key];\n140:         if (Array.isArray(list)) {\n141:           for (const item of list) if (typeof item === \"string\" && item.startsWith(\"parties/\")) revokedPaths.add(item);\n142:         }\n143:       }\n144:       if (typeof guest.objectPath === \"string\" && (guest.objectPath as string).startsWith(\"parties/\")) {\n145:         revokedPaths.add(guest.objectPath as string);\n146:       }\n147:     }\n148:   }\n149:   for (const manifestDoc of manifests.docs) {\n150:     const manifest = manifestDoc.data();\n151:     const expiry = expiryDate(manifest.expiresAt);\n152:     if (expiry && expiry > now && Array.isArray(manifest.cameraClips)) {\n153:       // Revoked manifests (produced from a withdrawn guest submission) are\n154:       // never protected: their clips are retried for deletion below instead\n155:       // of lingering past withdrawal.\n156:       if (typeof manifest.jobId === \"string\" && isRevokedManifest(manifest.jobId, jobs, withdrawnSubmissions)) {\n157:         for (const clip of manifest.cameraClips) {\n158:           if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n159:             revokedPaths.add((clip as Record<string, unknown>).objectPath as string);\n160:           }\n161:         }\n162:         continue;\n163:       }\n164:       for (const clip of manifest.cameraClips) if (typeof clip?.objectPath === \"string\") references.add(clip.objectPath);\n165:     } else if (Array.isArray(manifest.cameraClips) && typeof manifest.jobId === \"string\" &&\n166:         isRevokedManifest(manifest.jobId, jobs, withdrawnSubmissions)) {\n167:       // Even an expired revoked manifest's clips are queued for retry so a\n168:       // withdrawal is never left to the orphan pass alone.\n169:       for (const clip of manifest.cameraClips) {\n170:         if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n171:           revokedPaths.add((clip as Record<string, unknown>).objectPath as string);\n172:         }\n173:       }\n174:     }\n175:   }\n176:   for (const jobDoc of jobs.docs) {\n177:     const job = jobDoc.data();\n178:     const expiry = expiryDate(job.expiresAt);\n179:     if (expiry && expiry > now && ![\"expired\", \"purged\", \"failed\"].includes(String(job.state))) {\n180:       const pairParty = jobDoc.ref.parent.parent?.id ?? \"\";\n181:       if (typeof jobDoc.id === \"string\" && jobDoc.id && pairParty) liveJobPairs.add(`${pairParty}/${jobDoc.id}`);\n182:       addPaths(references, job.deliveryPaths);\n183:       addPaths(references, job.generatedPaths);\n184:       // Staged camera outputs live only in job.stagedOutputs until publish;\n185:       // without this the orphan pass deletes a running job's clips.\n186:       const staged = job.stagedOutputs;\n187:       if (staged && typeof staged === \"object\") {\n188:         for (const clip of Object.values(staged as Record<string, unknown>)) {\n189:           if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n190:             references.add((clip as Record<string, unknown>).objectPath as string);\n191:           }\n192:         }\n193:       }\n194:     }\n195:   }\n196: \n197:   const [files] = await bucket.getFiles({ prefix: \"parties/\" });\n198:   let deletedExpiredObjects = 0;\n199:   let deletedOrphanObjects = 0;\n200:   // Retry revoked-manifest objects (and pending withdrawal deletions) before\n201:   // the orphan pass so they are deleted even if a stale reference rebuild\n202:   // would otherwise protect them. Idempotent: missing objects are ignored.\n203:   for (const path of revokedPaths) {\n204:     if (references.has(path)) references.delete(path);\n205:     try {\n206:       const [exists] = await bucket.file(path).exists();\n207:       if (!exists) continue;\n208:       await bucket.file(path).delete({ ignoreNotFound: true });\n209:       deletedOrphanObjects += 1;\n210:     } catch {\n211:       // Left for the next sweep; never counted as deleted.\n212:     }\n213:   }\n214:   for (const file of files) {\n215:     const path = file.name;\n216:     if (!path || path.endsWith(\"/\")) continue;\n217:     const [metadata] = await file.getMetadata().catch(() => [undefined]);\n218:     const customExpiry = metadata?.metadata?.expiresAt;\n219:     const expires = expiryDate(customExpiry);\n220:     if (expires && expires <= now) {\n221:       await file.delete({ ignoreNotFound: true });\n222:       deletedExpiredObjects += 1;\n223:       continue;\n224:     }\n225:     if (references.has(path)) continue;\n226:     // Backstop for in-flight uploads whose paths are not yet listed on any\n227:     // document (e.g. seed objects between upload and the seeding transaction):\n228:     // a live (partyId, jobId) pair recorded in the object's own metadata\n229:     // keeps it until the owning job leaves the live set.\n230:     const objectJobId = metadata?.metadata?.jobId;\n231:     const objectPartyId = metadata?.metadata?.partyId;\n232:     if (typeof objectJobId === \"string\" && objectJobId && typeof objectPartyId === \"string\" && objectPartyId &&\n233:         liveJobPairs.has(`${objectPartyId}/${objectJobId}`)) continue;\n234:     await file.delete({ ignoreNotFound: true });\n235:     deletedOrphanObjects += 1;\n236:   }\n237:   return { expiredJobs, deletedExpiredObjects, deletedOrphanObjects, expiredGuestInputs };\n238: }\n239: \n240: export function createRetentionService(db: Firestore, bucket: Bucket, clock?: () => Date) {\n241:   return async () => sweepExpiredMedia(db, bucket, clock?.() ?? new Date());\n242: }\n243: "}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929afe0573be85e86e3e97c1f24b"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/retention.ts\"}"},"time":{"start":1793460993819,"end":1793460993851}}}}
