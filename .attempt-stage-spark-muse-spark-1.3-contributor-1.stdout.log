le, expiresAt: Date) => Promise<string>;\n51:   deleteDeliveryObject?: (file: File) => Promise<void>;\n52:   now?: () => Date;\n53: }\n54: \n55: export interface DeliveryServices {\n56:   requestGeneration(value: unknown): Promise<{ jobId: string; state: string; created: boolean }>;\n57:   runGeneration(task: GenerationTask): Promise<{ jobId: string; state: string }>;\n58:   normalizeAndStage(jobId: string, clips: GeneratedClipInput[]): Promise<DeliveryManifest>;\n59:   publishManifest(jobId: string, idempotencyKey: string): Promise<DeliveryManifest>;\n60:   getCurrentManifest(value: unknown): Promise<SerializedDeliveryManifest>;\n61:   getDeliveryUrls(value: unknown): Promise<{ manifestVersion: number; manifestHash: string; clips: Array<{ cameraId: string; sha256: string; url: string; expiresAt: string }> }>;\n62:   acknowledgeDelivery(value: unknown): Promise<{ ackId: string; manifestVersion: number; purged: boolean }>;\n63: }\n64: \n65: export interface SerializedDeliveryManifest extends Omit<DeliveryManifest, \"cameraClips\" | \"createdAt\"> {\n66:   cameraClips: Array<Pick<CanonicalClip, \"cameraId\" | \"objectPath\" | \"sha256\" | \"sizeBytes\" | \"durationMs\" | \"expiresAt\">>;\n67:   createdAt: string;\n68: }\n69: \n70: const defaultRunner = async (): Promise<void> => {\n71:   // p4 supplies the billable generation adapter. p1 must never make that call.\n72:   throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation provider is not configured.\");\n73: };\n74: \n75: function manifestRef(db: Firestore, partyId: string, channelId: string) {\n76:   return db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n77: }\n78: \n79: function jobRef(db: Firestore, partyId: string, jobId: string) {\n80:   return db.doc(`parties/${partyId}/jobs/${jobId}`);\n81: }\n82: \n83: function costLogRef(db: Firestore, partyId: string, jobId: string) {\n84:   return db.doc(`parties/${partyId}/costLogs/${jobId}`);\n85: }\n86: \n87: function deliveryObjectPath(partyId: s