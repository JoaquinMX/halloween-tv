{"type":"tool_use","timestamp":1793461707241,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5e0ea0011ZUswNdKT4bmBa","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5d8c3001EMGnrBdwnoc0fd","type":"tool","id":"call_01a192a5de03727fba0450a6cb086023","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/test/host_join.test.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/test/host_join.test.ts, lines 1-154\n1: import assert from \"node:assert/strict\";\n2: import test from \"node:test\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import { Timestamp } from \"firebase-admin/firestore\";\n6: import { BackendError } from \"../src/contracts\";\n7: import { createHostJoinService, hashHostInviteToken } from \"../src/host_join\";\n8: import { createJoinPartyService } from \"../src/join_party\";\n9: import {\n10:   HAS_FIRESTORE_EMULATOR,\n11:   clearParty,\n12:   createEmulatorContext,\n13:   disposeEmulatorContext,\n14:   randomPartyId,\n15:   seedParty,\n16: } from \"./support/emulators\";\n17: \n18: async function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\n19:   await seedParty(db, partyId, deviceId, channelId);\n20:   await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \"tv\" });\n21: }\n22: \n23: test(\"join_roles fixture matches the enforced guest/host role boundary\", async () => {\n24:   const content = await readFile(resolve(__dirname, \"../../../test/fixtures/join_roles_v1.json\"), \"utf8\");\n25:   const roles = JSON.parse(content) as {\n26:     callables: string[];\n27:     guestJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\n28:     hostJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\n29:   };\n30:   assert.deepEqual(roles.callables, [\"createHostInvite\", \"joinHost\", \"listHostVideos\", \"generateHostVideo\", \"getHostVideoPreview\", \"deleteHostVideo\"]);\n31:   // The guest route and the host route produce disjoint server-assigned roles.\n32:   assert.equal(roles.guestJoin.response.role, \"guest\");\n33:   assert.equal(roles.hostJoin.response.role, \"host\");\n34:   assert.notEqual(roles.guestJoin.response.role, roles.hostJoin.response.role);\n35:   // The guest fixture carries a six-digit PIN (redeemed via joinParty); the\n36:   // host fixture carries a server-minted capability (never a PIN shape).\n37:   assert.match(String((roles.guestJoin.request as Record<string, unknown>).joinPin), /^[0-9]{6}$/);\n38:   assert.ok(String((roles.hostJoin.request as Record<string, unknown>).inviteToken).length > 0);\n39:   // A host token is never a bare guest PIN: PIN-shaped strings are rejected\n40:   // as invite tokens by the parser (covered behaviorally above).\n41:   assert.ok(!/^[0-9]{6}$/.test(String((roles.hostJoin.request as Record<string, unknown>).inviteToken)));\n42: });\n43: \n44: test(\"only a registered TV may mint a host invite; invites bind party/channel/expiry\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n45:   const { app, db, bucket } = await createEmulatorContext();\n46:   const partyId = randomPartyId();\n47:   try {\n48:     await seedTv(db, partyId, \"tv-1\", \"main\");\n49:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n50:     const services = createHostJoinService({ db });\n51:     const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n52:     assert.equal(invite.partyId, partyId);\n53:     assert.equal(invite.channelId, \"main\");\n54:     assert.ok(invite.inviteToken.startsWith(\"hi-\"));\n55:     assert.ok(Date.parse(invite.expiresAt) > Date.now());\n56:     // Only the token hash is stored, bound to party/channel/expiry.\n57:     const tokenHash = hashHostInviteToken(invite.inviteToken);\n58:     const stored = (await db.doc(`parties/${partyId}/hostInvites/${tokenHash.slice(0, 32)}`).get()).data()!;\n59:     assert.equal(stored.tokenHash, tokenHash);\n60:     assert.equal(stored.partyId, partyId);\n61:     assert.equal(stored.channelId, \"main\");\n62:     assert.equal(stored.status, \"pending\");\n63:     assert.ok(!(\"inviteToken\" in stored) && !JSON.stringify(stored).includes(invite.inviteToken));\n64:     // Guests, unknown devices, and wrong channels cannot mint invites.\n65:     await assert.rejects(services.createHostInvite({ partyId, deviceId: \"p-guest-1\", channelId: \"main\" }),\n66:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n67:     await assert.rejects(services.createHostInvite({ partyId, deviceId: \"nope\", channelId: \"main\" }),\n68:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n69:     await assert.rejects(services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"other\" }),\n70:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n71:   } finally {\n72:     await clearParty(db, bucket, partyId);\n73:     await disposeEmulatorContext(app);\n74:   }\n75: });\n76: \n77: test(\"host redemption is transactional: idempotent retry, replay/expiry/PIN/role forgery denied\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n78:   const { app, db } = await createEmulatorContext();\n79:   const partyId = randomPartyId();\n80:   try {\n81:     await seedTv(db, partyId, \"tv-1\", \"main\");\n82:     const services = createHostJoinService({ db });\n83:     const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n84: \n85:     const joined = await services.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n86:     assert.deepEqual(joined, { partyId, deviceId: \"p-host-1\", channelId: \"main\", role: \"host\", status: \"active\", created: true });\n87:     const device = (await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()!;\n88:     assert.equal(device.role, \"host\");\n89:     assert.equal(device.status, \"active\");\n90: \n91:     // Same-device redemption retries are idempotent.\n92:     const retried = await services.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n93:     assert.equal(retried.created, false);\n94:     assert.equal(retried.role, \"host\");\n95: \n96:     // Other-device replay of the same token cannot grant host access.\n97:     await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-2\", channelId: \"main\", inviteToken: invite.inviteToken }),\n98:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n99:     assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).exists, false);\n100: \n101:     // Guest PIN reuse cannot grant host access (shape-rejected, never redeemed).\n102:     await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-3\", channelId: \"main\", inviteToken: \"004201\" }),\n103:       (e: unknown) => e instanceof BackendError);\n104:     assert.equal((await db.doc(`parties/${partyId}/devices/p-host-3`).get()).exists, false);\n105: \n106:     // Client-only role changes cannot grant host access: a forged role field\n107:     // is ignored and a guest-PIN registration stays a guest.\n108:     const joinParty = createJoinPartyService({ db });\n109:     const guest = await joinParty.joinParty({ partyId, deviceId: \"p-guest-9\", channelId: \"main\", role: \"host\" } as unknown as Record<string, unknown>);\n110:     assert.equal(guest.role, \"guest\");\n111:     assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-9`).get()).data()?.role, \"guest\");\n112:     await assert.rejects(services.joinHost({ partyId, deviceId: \"p-guest-9\", channelId: \"main\", inviteToken: invite.inviteToken }),\n113:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n114: \n115:     // Expired invites are refused.\n116:     const invite2 = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n117:     const tokenHash2 = hashHostInviteToken(invite2.inviteToken);\n118:     await db.doc(`parties/${partyId}/hostInvites/${tokenHash2.slice(0, 32)}`).update({ expiresAt: Timestamp.fromDate(new Date(Date.now() - 1000)) });\n119:     await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-4\", channelId: \"main\", inviteToken: invite2.inviteToken }),\n120:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n121: \n122:     // Cross-party token reuse is refused.\n123:     const otherParty = randomPartyId();\n124:     await seedTv(db, otherParty, \"tv-9\", \"main\");\n125:     await assert.rejects(services.joinHost({ partyId: otherParty, deviceId: \"p-host-5\", channelId: \"main\", inviteToken: invite.inviteToken }),\n126:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n127:     await db.recursiveDelete(db.doc(`parties/${otherParty}`)).catch(() => undefined);\n128:   } finally {\n129:     await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n130:     await disposeEmulatorContext(app);\n131:   }\n132: });\n133: \n134: test(\"legacy joinParty remains guest-only and never upgrades host devices\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n135:   const { app, db } = await createEmulatorContext();\n136:   const partyId = randomPartyId();\n137:   try {\n138:     await seedTv(db, partyId, \"tv-1\", \"main\");\n139:     const hosts = createHostJoinService({ db });\n140:     const joinParty = createJoinPartyService({ db });\n141:     const invite = await hosts.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n142:     await hosts.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n143:     // A host device rejoining through the legacy path is rejected, not downgraded.\n144:     await assert.rejects(joinParty.joinParty({ partyId, deviceId: \"p-host-1\", channelId: \"main\" }),\n145:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n146:     assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \"host\");\n147:     // Fresh legacy joins are still guests.\n148:     const guest = await joinParty.joinParty({ partyId, deviceId: \"p-new-guest\", channelId: \"main\" });\n149:     assert.equal(guest.role, \"guest\");\n150:   } finally {\n151:     await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n152:     await disposeEmulatorContext(app);\n153:   }\n154: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/test/host_join.test.ts, lines 1-154\n1: import assert from \"node:assert/strict\";\n2: import test from \"node:test\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import { Timestamp } from \"firebase-admin/firestore\";\n6: import { BackendError } from \"../src/contracts\";\n7: import { createHostJoinService, hashHostInviteToken } from \"../src/host_join\";\n8: import { createJoinPartyService } from \"../src/join_party\";\n9: import {\n10:   HAS_FIRESTORE_EMULATOR,\n11:   clearParty,\n12:   createEmulatorContext,\n13:   disposeEmulatorContext,\n14:   randomPartyId,\n15:   seedParty,\n16: } from \"./support/emulators\";\n17: \n18: async function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\n19:   await seedParty(db, partyId, deviceId, channelId);\n20:   await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \"tv\" });\n21: }\n22: \n23: test(\"join_roles fixture matches the enforced guest/host role bo