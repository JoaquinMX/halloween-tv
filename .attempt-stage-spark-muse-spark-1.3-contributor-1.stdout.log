eof guest.consentRevision !== \"string\") return undefined;\n27:   return { submissionId: guest.submissionId, sourceHash: guest.sourceHash, consentRevision: guest.consentRevision };\n28: }\n29: \n30: function assertGuestBinding(\n31:   job: FirebaseFirestore.DocumentData,\n32:   guest: GuestMediaDoc,\n33:   nowMs: number,\n34: ): void {\n35:   const binding = guestMediaOf(job)!;\n36:   // Irreversible withdrawal: a tombstone can never publish again, even if a\n37:   // racing completion wrote eligible around the withdrawal.\n38:   if ((guest as GuestMediaDoc & { tombstone?: unknown }).tombstone === true) {\n39:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn.\");\n40:   }\n41:   if (guest.status !== \"eligible\") throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n42:   if (!guest.consent || guest.consent.accepted !== true ||\n43:       guest.consent.textVersion !== GUEST_CONSENT_TEXT_VERSION ||\n44:       guest.consent.purpose !== GUEST_CONSENT_PURPOSE) {\n45:     throw new BackendError(\"FORBIDDEN\", \"Guest consent is not recorded for publication.\");\n46:   }\n47:   if (guest.sourceHash !== binding.sourceHash || guest.consentRevision !== binding.consentRevision) {\n48:     throw new BackendError(\"FORBIDDEN\", \"Guest media changed while the job was running.\");\n49:   }\n50:   const expiry = guest.expiresAt instanceof Date ? guest.expiresAt.getTime() : Date.parse(String(\n51:     guest.expiresAt && typeof guest.expiresAt === \"object\" && \"toDate\" in guest.expiresAt\n52:       ? (guest.expiresAt as { toDate: () => Date }).toDate().toISOString()\n53:       : guest.expiresAt,\n54:   ));\n55:   if (!Number.isFinite(expiry) || expiry <= nowMs) throw new BackendError(\"FORBIDDEN\", \"Guest consent window has expired.\");\n56: }\n57: \n58: /** Publishes the current manifest in one Firestore transaction after all four objects exist. */\n59: export async function publishManifest(\n60:   store: FirestoreGenerationStore,\n61:   partyId: string,\n62:   jobId: string,\n63:   idempotencyKey: string,\n64: ): Promise<DeliveryManifest> {\n65:   const job = await store.getJob(partyId, jobId);\n66:   if (job.idempotencyKey !== idempotencyKey) throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n67:   // Deletion-race guard: a host-deleted job (deleteHostVideo tombstone) must\n68:   // never publish, even if the worker staged bytes before the deletion. This\n69:   // precedes the idempotent-published fast path so a deletion racing the\n70:   // worker is refused instead of replaying the revoked manifest.\n71:   if ((job as Record<string, unknown>).hostDeleted === true) {\n72:     throw new BackendError(\"FORBIDDEN\", \"Seed video was deleted; publication is refused.\");\n73:   }\n74:   if (typeof job.jobId === \"string\" && job.jobId.startsWith(\"hv-\")) {\n75:     const seedId = job.jobId.slice(\"hv-\".length);\n76:     const seedSnap = await store.db.doc(`parties/${partyId}/seedVideos/${seedId}`).get().catch(() => undefined);\n77:     if (seedSnap?.exists && (seedSnap.data() as Record<string, unknown>).status === \"deleted\") {\n78:       throw new BackendError(\"FORBIDDEN\", \"Seed video was deleted; publication is refused.\");\n79:     }\n80:   }\n81:   if (job.publishedManifest) return job.publishedManifest as DeliveryManifest;\n82:   const guest = guestMediaOf(job);\n83:   if (guest) {\n84:     const snapshot = await store.db.doc(`parties/${partyId}/guestMedia/${guest.submissionId}`).get();\n85:     if (!snapshot.exists) throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n86:     assertGuestBinding(job, snapshot.data() as GuestMediaDoc, Date.now());\n87:   }\n88:   const staged = job.stagedOutputs && typeof job.stagedOutputs === \"object\"\n89:     ? job.stagedOutputs as Record<string, unknown>\n90:     : {};\n91:   const providerTasks = job.providerTasks && typeof job.providerTasks === \"object\"\n92:     ? job.providerTasks as Record<string, { taskId?: unknown }>\n93:     : {};\n94:   const clips: CanonicalClip[] = [];\n95:   for (const cameraId of REQUIRED_CAMERA_IDS) {\n96:     const clip = staged[cameraId];\n97:     if (!isClip(clip) || clip.cameraId !== cameraId) {\n98:       throw new BackendError(\"MANIFEST_MISMATCH\", \"All four normalized camera clips must be staged before publishing.\");\n99:     }\n100:     const expectedPath = store.plannedObjectPath(partyId, String(job.channelId), Number(job.manifestVersion), cameraId);\n101:     if (clip.objectPath !== expectedPath) throw new BackendError(\"MANIFEST_MISMATCH\", \"Staged camera path is outside the delivery prefix.\");\n102:     const [exists] = await store.bucket.file(clip.objectPath).exists();\n103:     if (!exists) throw new BackendError(\"MANIFEST_MISMATCH\", \"A staged camera clip is not present in delivery storage.\");\n104:     const [bytes] = await store.bucket.file(clip.objectPath).download();\n105:     const actualHash = createHash(\"sha256\").update(bytes).digest(\"hex\");\n106:     if (actualHash !== clip.sha256 || bytes.byteLength !== clip.sizeBytes) {\n107:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staged camera content does not match its recorded hash and size.\");\n108:     }\n109:     const taskId = providerTasks[cameraId]?.taskId;\n110:     const isFixtureSlot = guest !== undefined && cameraId !== GUEST_PROVIDER_CAMERA_ID;\n111:     const ledgerInput = {\n112:       partyId,\n113:       deviceId: String(job.deviceId),\n114:       channelId: String(job.channelId),\n115:       manifestVersion: Number(job.manifestVersion),\n116:       idempotencyKey,\n117:       jobId,\n118:       cameraId,\n119:     };\n120:     const ledger = await store.db.doc(usageLedgerPath(ledgerInput)).get();\n121:     if (isFixtureSlot) {\n122:       // Locally prepared fixture slot: truthful provenance, no provider task\n123:       // ID or charge is ever fabricated for these