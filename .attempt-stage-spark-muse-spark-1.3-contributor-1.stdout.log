st Duration(seconds: 2),\n87:           mimeType: 'video/mp4',\n88:         );\n89:         final Uri initialUrl = await signer.signFor(target);\n90:         final Directory cacheRoot = await Directory.systemTemp.createTemp(\n91:           'delivery-cache-',\n92:         );\n93:         try {\n94:           final HttpsMediaDownloader downloader = HttpsMediaDownloader(\n95:             httpClient: httpClient,\n96:             expiredUrlRefresher: (clip, _) => signer.signFor(clip),\n97:           );\n98:           final CachedMedia cached = await downloader.downloadAndCommit(\n99:             clip: target,\n100:             source: initialUrl,\n101:             cacheStore: FileCacheStore(cacheRoot),\n102:           );\n103: \n104:           expect(await File(cached.localRef).readAsBytes(), bytes);\n105:           expect(cached.sha256, hash);\n106:           expect(callable.calls.map((call) => call.$1), [\n107:             'getDeliveryUrls',\n108:             'getDeliveryUrls',\n109:           ]);\n110:           for (final (String name, Map<String, Object?> payload)\n111:               in callable.calls) {\n112:             expect(payload['partyId'], 'pilot');\n113:             expect(payload['deviceId'], 'tv-pilot');\n114:             expect(payload['channelId'], 'main');\n115:             expect(name, 'getDeliveryUrls');\n116:           }\n117: \n118:           await delivery.acknowledge(\n119:             partyId: 'pilot',\n120:             channelId: 'main',\n121:             manifestVersion: 7,\n122:             verifiedClipHashes: <String, String>{\n123:               'CAM-04': 'd' * 64,\n124:               'CAM-02': 'b' * 64,\n125:               'CAM-01': 'a' * 64,\n126:               'CAM-03': 'c' * 64,\n127:             },\n128:           );\n129:           final (String ackName, Map<String, Object?> ackPayload) =\n130:               callable.calls.last;\n131:           expect(ackName, 'acknowledgeDelivery');\n132:           expect(ackPayload['clipHashes'], <