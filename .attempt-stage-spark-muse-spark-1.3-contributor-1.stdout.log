efined);\n281:       return { seedId: input.seedId, jobId, state: request.state, created: request.created };\n282:     } catch (error) {\n283:       await ref.update({ status: \"failed\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n284:       throw error;\n285:     }\n286:   }\n287: \n288:   async function getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult> {\n289:     const input = parseGetHostVideoPreviewInput(value);\n290:     const host = await assertRegisteredHostDevice(db, input);\n291:     const ref = seedRef(db, host.partyId, input.seedId);\n292:     const seedSnap = await ref.get();\n293:     if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n294:     const seed = seedSnap.data()!;\n295:     if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n296:       throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n297:     }\n298:     // A deleted seed never recreates previews.\n299:     if (seed.status === \"deleted\") throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n300:     const jobSnap = await jobRef(db, host.partyId, String(seed.jobId)).get();\n301:     if (!jobSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n302:     if (jobSnap.data()?.hostDeleted === true) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n303:     const clips = await deliveryClipsForJob(host.partyId, host.channelId, String(seed.jobId));\n304:     const previewExpiry = seed.expiresAt instanceof Timestamp\n305:       ? seed.expiresAt.toDate()\n306:       : new Date(Date.parse(String(seed.expiresAt)));\n307:     const previewExpiresAt = Number.isFinite(previewExpiry.getTime())\n308:       ? previewExpiry\n309:       : new Date(now().getTime() + HOST_PREVIEW_TTL_MS);\n310:     const previewPaths = await ensurePreviewCopies(host.partyId, input.seedId, clips, previewExpiresAt);\n311:     await ref.update({ previewPaths, status: \"ready\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n312:     const nowMs = now().getTime();\n313:     // Signed TTL is capped at the preview's own expiry (same pattern as delivery URLs).\n314:     const clipsOut = await Promise.all(\n315:       clips.map(async (clip) => {\n316:         const previewPath = hostPreviewObjectPath(host.partyId, input.seedId, clip.cameraId);\n317:         const expiresAt = new Date(Math.min(nowMs + DELIVERY_URL_TTL_SECONDS * 1000, previewExpiresAt.getTime()));\n318:         return {\n319:           cameraId: clip.cameraId,\n320:           sha256: clip.sha256,\n321:           url: await signPreviewUrl(bucket.file(previewPath), expiresAt),\n322:           expiresAt: expiresAt.toISOString(),\n323:         };\n324:       }),\n325:     );\n326:     return { seedId: input.seedId, expiresAt: previewExpiresAt.toISOString(), clips: clipsOut };\n327:   }\n328: \n329:   async function deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult> {\n330:     const input = parseDeleteHostVideoInput(value);\n331:     const host = await assertRegisteredHostDevice(db, input);\n332:     const deletedSeedIds: string[] = [];\n333:     const doomedObjects = new Set<string>();\n334:     const doomedJobs: string[] = [];\n335:     let revokedManifest = false;\n336:     for (const seedId of input.seedIds) {\n337:       const ref = seedRef(db, host.partyId, seedId);\n338:       const outcome = await db.runTransaction(async (transaction) => {\n339:         const seedSnap = await transaction.get(ref);\n340:         if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", `Seed video ${seedId} does not exist.`);\n341:         const seed = seedSnap.data()!;\n342:         if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n343:           throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n344:         }\n345:         if (seed.status === \"deleted\") return { already: true as const, jobId: String(seed.jobId), previews: seed.previewPaths };\n346:         const jobId = String(seed.jobId);\n347:         const jobSnap = await transaction.get(jobRef(db, host.partyId, jobId));\n348:         const job = jobSnap.exists ? jobSnap.data()! : undefined;\n349:         const staged = ((job?.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown }>) ?? {};\n350:         const previews = Array.isArray(seed.previewPaths) ? (seed.previewPaths as unknown[]) : [];\n351:         transaction.update(ref, {\n352:           status: \"deleted\",\n353:           deletedAt: FieldValue.serverTimestamp(),\n354:           updatedAt: FieldValue.serverTimestamp(),\n355:         });\n356:         if (jobSnap.exists) {\n357:           // Tombstone the job so a deletion/withdrawal racing the worker can\n358:           // never republish it (publish.ts rechecks this flag\n359:           // transactionally) and so no preview is recreated afterwards.\n360:           transaction.update(jobRef(db, host.partyId, jobId), {\n361:             hostDeleted: true,\n362:             deletedSeedId: seedId,\n363:             timestamp: FieldValue.serverTimestamp(),\n364:           });\n365:         }\n366:         // Revoke an affected current manifest whose job matches this seed.\n367:         return { already: false as const, jobId, previews, staged, seed };\n368:       });\n369:       if (outcome.already) {\n370:         deletedSeedIds.push(seedId);\n371:         for (const path of (outcome.previews ?? []) as unknown[]) {\n372:           if (typeof path === \"string\" && path.startsWith(\"parties/\")) doomedObjects.add(path);\n373:         }\n374:         continue;\n375:       }\n376:       deletedSeedIds.push(seedId);\n377:       doomedJobs.push(outcome.jobId);\n378:       for (const preview of (outcome.previews ?? []) as unknown[]) {\n379:         if (typeof preview === \"string\" && preview.starts