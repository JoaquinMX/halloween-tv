lidHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n69:     invalidHashes[\"CAM-01\"] = \"f\".repeat(64);\n70:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes: invalidHashes }),\n71:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n72: \n73:     const clipHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n74:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version - 1, clipHashes }),\n75:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n76:     const ack = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n77:     assert.equal(ack.purged, true);\n78:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.state, \"purged\");\n79:     for (const clip of cameraClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n80:     const repeated = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n81:     assert.equal(repeated.ackId, ack.ackId);\n82:   } finally {\n83:     await clearParty(db, bucket, partyId);\n84:     await disposeEmulatorContext(app);\n85:   }\n86: });\n87: \n88: test(\"expired canonical clip does not receive a signed URL\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n89:   const { app, db, bucket } = await createEmulatorContext();\n90:   const partyId = randomPartyId();\n91:   const deviceId = \"tv-1\";\n92:   const channelId = \"main\";\n93:   const version = 1;\n94:   const jobId = \"job-expired\";\n95:   const expired = new Date(Date.now() - 1000).toISOString();\n96:   const cameraClips = REQUIRED_CAMERA_IDS.map((cameraId) => ({\n97:     cameraId,\n98:     objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`,\n99:     sha256: createHash(\"sha256\").update(cameraId).digest(\"hex\"),\n100:     sizeBytes: 1,\n101:     durationMs: 2000,\n102:     expiresAt: expired,\n103:   }));\n104:   try {\n105:     await seedParty(db, partyId, deviceId, channelId);\n106:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({ partyId, channelId, version, schemaVersion: 1, jobId, expiresAt: expired, cameraClips });\n107:     const services = createDeliveryServices({ db, bucket, signReadUrl: async () => \"https://unused.invalid\" });\n108:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n109:       (error: unknown) => error instanceof BackendError && error.errorCode === \"CLIP_EXPIRED\");\n110:     const clipHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n111:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes }),\n112:       (error: unknown) => error instanceof BackendError && error.errorCode === \"CLIP_EXPIRED\");\n113:   } finally {\n114:     await clearParty(db, bucket, partyId);\n115:     await disposeEmulatorContext(app);\n116:   }\n117: });\n118: \n119: test(\"accepted ACK retries its bounded version after partial purge, expiry, and publication advances\", {\n120:   skip: !HAS_FIRESTORE_EMULATOR,\n121: }, async () => {\n122:   const { app, db, bucket } = await createEmulatorContext();\n123:   const partyId = randomPartyId();\n124:   const deviceId = \"tv-ack-retry\";\n125:   const channelId = \"main\";\n126:   const version = 1;\n127:   const nextVersion = 2;\n128:   const jobId = \"job-ack-retry\";\n129:   const oldExpiry = \"2026-10-29T16:00:00.000Z\";\n130:   const now = { value: Date.parse(\"2026-10-29T15:00:00.000Z\") };\n131:   const clipsFor = (clipVersion: number, expiresAt: string) => REQUIRED_CAMERA_IDS.map((cameraId) => {\n132:     const bytes = Buffer.from(`${clipVersion}-${cameraId}`);\n133:     return {\n134:       cameraId,\n135:       objectPath: `parties/${partyId}/channels/${channelId}/delivery/${clipVersion}/${cameraId}.mp4`,\n136:       sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"),\n137:       sizeBytes: bytes.length,\n138:       durationMs: 2000,\n139:       expiresAt,\n140:       bytes,\n141:     };\n142:   });\n143:   const oldClips = clipsFor(version, oldExpiry);\n144:   const newClips = clipsFor(nextVersion, \"2026-11-29T16:00:00.000Z\");\n145:   let failedOnce = false;\n146:   const failingPath = oldClips[0].objectPath;\n147:   try {\n148:     await seedParty(db, partyId, deviceId, channelId);\n149:     await Promise.all(oldClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n150:     await Promise.all(newClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n151:     const currentRef = db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n152:     await currentRef.set({\n153:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: oldExpiry,\n154:       cameraClips: oldClips.map(({ bytes: _bytes, ...clip }) => clip),\n155:     });\n156:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({ jobId, partyId, deviceId, channelId, state: \"ready\" });\n157:     const services = createDeliveryServices({\n158:       db,\n159:       bucket,\n160:       now: () => new Date(now.value),\n161:       deleteDeliveryObject: async (file) => {\n162:         if (file.name === failingPath && !failedOnce) {\n163:           failedOnce = true;\n164:           throw new Error(\"injected partial purge failure\");\n165:         }\n166:         await file.delete({ ignoreNotFound: true });\n167:       },\n168:     });\n169:     const clipHashes = Object.fromEntries(oldClips.map((clip) => [clip.cameraId, clip.sha256]));\n170:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes }));\n171:     assert.equal((await bucket.file(failingPath).exists())[0], true);\n172:     assert.equal((await bucket.file(oldClips[1].objectPath).exists())[0], false);\n173:     const ackId = (await db.collection(`parties/${partyId}/deliveryAcks`).get()).docs[0]?.id;\n174:     assert.ok(ackId);\n175: \n176:     await currentRef.set({\n177:       partyId, channelId, version: nextVersion, schemaVersion: SCHEMA_VERSION, jobId: \"job-new-version\",\n178:       expiresAt: \"2026-11-29T16:00:00.000Z\",\n179:       cameraClips: newClips.map(({ bytes: _bytes, ...clip }) => clip),\n180:     });\n181:     now.value = Date.parse(\"2026-10-30T17:00:00.000Z\");\n182:     const conflictingHashes = { ...clipHashes, \"CAM-01\": \"f\".repeat(64) };\n183:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes: conflictingHashes }),\n184:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n185: \n186:     const repeated = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n187:     assert.equal(repeated.ackId, ackId);\n188:     for (const clip of oldClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n189:     for (const clip of newClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], true);\n190:   } finally {\n191:     await clearParty(db, bucket, partyId);\n192:     await disposeEmulatorContext(app);\n193:   }\n194: });\n195: \n196: test(\"a manifest bound to withdrawn consent yields no delivery URLs even while it lingers\", {\n197:   skip: !HAS_FIRESTORE_EMULATOR,\n198: }, async () => {\n199:   const { app, db, bucket } = await createEmulatorContext();\n200:   const partyId = randomPartyId();\n201:   const deviceId = \"tv-1\";\n202:   const channelId = \"main\";\n203:   const version = 1;\n204:   const jobId = \"job-revoked-consent\";\n205:   const submissionId = \"gsub-revoked000000000000000001\";\n206:   const expiry = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n207:   const cameraClips = REQUIRED_CAMERA_IDS.map((cameraId) => {\n208:     const bytes = Buffer.from(`revoked-${cameraId}`);\n209:     return { cameraId, objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`, sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"), sizeBytes: bytes.length, durationMs: 2000, expiresAt: expiry, bytes };\n210:   });\n211:   try {\n212:     await seedParty(db, partyId, deviceId, channelId);\n213:     await Promise.all(cameraClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n214:     // Guest-bound job whose consent was withdrawn after publication; the\n215:     // manifest document itself has not been collected yet.\n216:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n217:       jobId, partyId, deviceId, channelId, manifestVersion: version, idempotencyKey: jobId, state: \"failed\",\n218:       guestMedia: { submissionId, objectPath: `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`, sourceHash: \"a\".repeat(64), consentRevision: \"v1:revoked\", deviceId, channelId },\n219:     });\n220:     await db.doc(`parties/${partyId}/guestMedia/${submissionId}`).set({\n221:       submissionId, partyId, deviceId, channelId, status: \"withdrawn\", tombstone: true,\n222:       consentRevision: \"v1:revoked\", objectPath: `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`,\n223:     });\n224:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n225:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: expiry,\n226:       createdAt: FieldValue.serverTimestamp(),\n227:       cameraClips: cameraClips.map(({ bytes: _bytes, ...clip }) => clip),\n228:     });\n229:     const services = createDeliveryServices({ db, bucket, signReadUrl: async () => \"https://unused.invalid\" });\n230:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n231:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n232:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n233:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n234:     // Control: the same manifest shape without a guest binding still serves.\n235:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({ guestMedia: FieldValue.delete() });\n236:     const delivery = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n237:     assert.equal(delivery.manifestVersion, version);\n238:     assert.equal(delivery.clips.length, 4);\n239:   } finally {\n240:     await clearParty(db, bucket, partyId);\n241:     await disposeEmulatorContext(app);\n242:   }\n243: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b13107310a795eeeaa774fc86"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/delivery.test.ts\"}"},"time":{"start":1793460999737,"end":1793460999761}}}}
