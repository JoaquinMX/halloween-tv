xpiresAt: string;\n46: }\n47: \n48: export interface CurrentManifestInput extends Identity {}\n49: \n50: export interface AckInput extends Identity {\n51:   manifestVersion: number;\n52:   clipHashes: Record<string, string>;\n53: }\n54: \n55: const ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;\n56: const HASH_RE = /^[a-f0-9]{64}$/;\n57: const isRecord = (value: unknown): value is Record<string, unknown> =>\n58:   value !== null && typeof value === \"object\" && !Array.isArray(value);\n59: \n60: export function requireIdentity(value: unknown): Identity {\n61:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n62:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n63:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n64:   }\n65:   const partyId = validateId(value.partyId, \"partyId\");\n66:   const deviceId = validateId(value.deviceId, \"deviceId\");\n67:   const channelId = typeof value.channelId === \"string\" && value.channelId\n68:     ? validateId(value.channelId, \"channelId\")\n69:     : \"\";\n70:   return { partyId, deviceId, channelId };\n71: }\n72: \n73: export function parseRequestGeneration(value: unknown): RequestGenerationInput {\n74:   const identity = requireIdentity(value);\n75:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n76:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n77:   const jobId = validateId(value.jobId, \"jobId\");\n78:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n79:   if (value.presetId === CAMEO_DEMO_PRESET.presetId) {\n80:     // STEP 2 cameo batch: separate server lock, guest-bound only. Text-only\n81:     // requests for this preset are rejected; prompts stay fixed server-side.\n82:     for (const [key, expected] of Object.entries(CAMEO_DEMO_PRESET)) {\n83:       if (key in value && value[key] !== expected) {\n84:         throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n85:       }\n86:     }\n87:     if (!(\"guestMediaId\" in value) || typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n88:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n89:     }\n90:     validateId(value.guestMediaId, \"guestMediaId\");\n91:     return { ...identity, jobId, idempotencyKey, presetId: CAMEO_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n92:   }\n93:   if (value.presetId !== CHEAP_DEMO_PRESET.presetId) {\n94:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the cheap_demo preset is supported.\");\n95:   }\n96:   // Model and generation controls are fixed server-side; caller overrides are rejected.\n97:   for (const [key, expected] of Object.entries(CHEAP_DEMO_PRESET)) {\n98:     if (key in value && value[key] !== expected) {\n99:       throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n100:     }\n101:   }\n102:   if (\"guestMediaId\" in value && value.guestMediaId !== undefined) {\n103:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n104:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n105:     }\n106:     validateId(value.guestMediaId, \"guestMediaId\");\n107:     return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n108:   }\n109:   return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId };\n110: }\n111: \n112: export function parseAck(value: unknown): AckInput {\n113:   const identity = requireIdentity(value);\n114:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n115:   if (!isRecord(value) || !Number.isSafeInteger(value.manifestVersion) || Number(value.manifestVersion) < 1) {\n116:     throw new BackendError(\"INVALID_ARGUMENT\", \"A positive manifestVersion is required.\");\n117:   }\n118:   if (!isRecord(value.clipHashes)) throw new BackendError(\"INVALID_ARGUMENT\", \"clipHashes must be an object.\");\n119:   // 1/2/4-camera layouts: the ACK key set must exactly equal the first-N\n120:   // canonical prefix for one supported count. Extra hashes (beyond the\n121:   // manifest's prefix) are rejected here; exact match against the actual\n122:   // manifest (same length + same hashes) is enforced at ACK acceptance.\n123:   const keys = Object.keys(value.clipHashes).sort();\n124:   const supportedKeySets = (SUPPORTED_CAMERA_COUNTS as readonly number[]).map(\n125:     (count) => [...expectedCameraIds(count)].sort().join(\",\"),\n126:   );\n127:   if (!supportedKeySets.includes(keys.join(\",\"))) {\n128:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK must include one hash for each canonical camera clip (1, 2, or 4 clips, first-N prefix).\");\n129:   }\n130:   const clipHashes: Record<string, string> = {};\n131:   for (const cameraId of keys) {\n132:     const hash = (value.clipHashes as Record<string, unknown>)[cameraId];\n133:     if (typeof hash !== \"string\" || !HASH_RE.test(hash)) {\n134:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hashes must be canonical SHA-256 hex values.\");\n135:     }\n136:     clipHashes[cameraId] = hash;\n137:   }\n138:   return { ...identity, manifestVersion: Number(value.manifestVersion), clipHashes };\n139: }\n140: \n141: export function parseCurrentManifestInput(value: unknown): CurrentManifestInput {\n142:   const identity = requireIdentity(value);\n143:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n144:   return identity;\n145: }\n146: \n147: export interface JoinPartyInput extends Identity {\n148:   joinPin?: string;\n149: }\n150: \n151: /** Exactly six ASCII digits; leading zeros are significant. */\n152: export const JOIN_PIN_RE = /^[0-9]{6}$/;\n153: \n154: export function parseJoinPartyInput(value: unknown): JoinPartyInput {\n155:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n156:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n157:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n158:   }\n159:   const partyId = validateId(value.partyId, \"partyId\");\n160:   const deviceId = validateId(value.deviceId, \"deviceId\");\n161:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n162:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n163:   }\n164:   const channelId = validateId(value.channelId, \"channelId\");\n165:   if (value.joinPin === undefined) {\n166:     return { partyId, deviceId, channelId };\n167:   }\n168:   if (typeof value.joinPin !== \"string\" || !JOIN_PIN_RE.test(value.joinPin)) {\n169:     throw new BackendError(\"INVALID_ARGUMENT\", \"joinPin must be six digits.\");\n170:   }\n171:   return { partyId, deviceId, channelId, joinPin: value.joinPin };\n172: }\n173: \n174: export function validateId(value: unknown, label: string): string {\n175:   if (typeof value !== \"string\" || !ID_RE.test(value)) {\n176:     throw new BackendError(\"INVALID_ARGUMENT\", `${label} is invalid.`);\n177:   }\n178:   return value;\n179: }\n180: \n181: export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n182:   if (!Array.isArray(clips) || !(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(clips.length)) {\n183:     throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain 1, 2, or 4 camera clips (four is the default layout).\");\n184:   }\n185:   const expected = new Set<string>([...expectedCameraIds(clips.length)]);\n186:   const byCamera = new Map<string, CanonicalClip>();\n187:   for (const raw of clips) {\n188:     if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n189:         !expected.has(raw.cameraId) ||\n190:         typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n191:         !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n192:         (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n193:         typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n194:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n195:     }\n196:     if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n197:     byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n198:   }\n199:   // Prefix rule: reordered valid clips are accepted, but gaps (e.g.\n200:   // {CAM-01, CAM-03} for count 2) and unknown cameras are rejected.\n201:   if (byCamera.size !== expected.size || [...expected].some((cameraId) => !byCamera.has(cameraId))) {\n202:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set must equal the first-N canonical cameras.\");\n203:   }\n204: }\n205: \n206: export function canonicalManifestHash(manifest: Pick<DeliveryManifest, \"partyId\" | \"channelId\" | \"version\" | \"cameraClips\">): string {\n207:   const canonical = {\n208:     partyId: manifest.partyId,\n209:     channelId: manifest.channelId,\n210:     version: manifest.version,\n211:     cameraClips: [...manifest.cameraClips]\n212:       .sort((a, b) => a.cameraId.localeCompare(b.cameraId))\n213:       .map(({ cameraId, sha256, sizeBytes, durationMs }) => ({ cameraId, sha256, sizeBytes, durationMs })),\n214:   };\n215:   return createHash(\"sha256\").update(JSON.stringify(canonical)).digest(\"hex\");\n216: }\n217: \n218: export function ackIdempotencyKey(deviceId: string, channelId: string, manifestVersion: number): string {\n219:   return createHash(\"sha256\").update(`${deviceId}\\n${channelId}\\n${manifestVersion}`).digest(\"hex\");\n220: }\n221: \n222: export function isErrorCode(value: unknown): value is ErrorCode {\n223:   return typeof value === \"string\" && (ERROR_CODES as readonly string[]).includes(value);\n224: }\n225: \n226: // ---------------------------------------------------------------------------\n227: // Host administration (cycle-12, partition p1).\n228: //\n229: // The companion uses a dedicated host entry screen (HostEntryScreen with\n230: // Scan Host QR + explicit Join-as-guest route; see partition p4/5 + README).\n231: // Rationale: guest PIN admission is intentionally broad (anyone who sees the\n232: // TV can join as a guest with full party-scoped read/generate/ACK power),\n233: // so host administration must never be reachable through the guest PIN or a\n234: // client-supplied role string. Host access is a separate server-minted,\n235: // short-lived invite capability redeemable once, bound to party/channel/\n236: // expiry, with the host role assigned server-side only.\n237: //\n238: // Callable surface (all exported through index.ts + runtime.ts):\n239: //   createHostInvite  (TV-only)  -> { inviteToken, pairingCode, expiresAt }\n240: //   joinHost          (phone)     -> { role: \"host\" } (separate device identity)\n241: //   revokeHostDevice  (TV-only)  -> { status: \"revoked\" } + audit record\n242: //   listHostVideos    (host-only) -> seed catalog entries\n243: //   generateHostVideo (host-only) -> fixed-preset queued generation + seed entry\n244: //   getHostVideoPreview (host-only) -> signed preview URLs (never persisted)\n245: //   deleteHostVideo   (host-only) -> delete seeds + objects, revoke manifests\n246: // ---------------------------------------------------------------------------\n247: \n248: /** Server-assigned device roles. Clients can never self-assign \"host\" or \"tv\". */\n249: export const DEVICE_ROLES = [\"guest\", \"host\", \"tv\"] as const;\n250: export type DeviceRole = (typeof DEVICE_ROLES)[number];\n251: \n252: export interface CreateHostInviteInput extends Identity {}\n253: \n254: export interface CreateHostInviteResult {\n255:   partyId: string;\n256:   channelId: string;\n257:   inviteToken: string;\n258:   /** Server-minted 6-digit pairing code shown next to the HOST QR on the TV. */\n259:   pairingCode: string;\n260:   expiresAt: string;\n261: }\n262: \n263: export interface JoinHostInput extends Identity {\n264:   inviteToken: string;\n265:   /** 6-digit pairing code displayed next to the HOST QR; required. */\n266:   pairingCode: string;\n267: }\n268: \n269: export interface JoinHostResult {\n270:   partyId: string;\n271:   deviceId: string;\n272:   channelId: string;\n273:   role: \"host\";\n274:   status: \"active\";\n275:   created: boolean;\n276: }\n277: \n278: export interface ListHostVideosInput extends Identity {}\n279: \n280: export type HostSeedStatus = \"queued\" | \"running\" | \"ready\" | \"failed\" | \"deleted\";\n281: \n282: export interface HostSeedEntry {\n283:   seedId: string;\n284:   partyId: string;\n285:   channelId: string;\n286:   status: HostSeedStatus;\n287:   jobId: string;\n288:   createdAt: string;\n289:   expiresAt: string;\n290:   previewAvailable: boolean;\n291:   cameraIds: string[];\n292: }\n293: \n294: export interface GenerateHostVideoInput extends Identity {\n295:   seedId: string;\n296:   idempotencyKey: string;\n297:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n298:   guestMediaId?: string;\n299: }\n300: \n301: export interface GenerateHostVideoResult {\n302:   seedId: string;\n303:   jobId: string;\n304:   state: string;\n305:   created: boolean;\n306: }\n307: \n308: export interface GetHostVideoPreviewInput extends Identity {\n309:   seedId: string;\n310: }\n311: \n312: export interface GetHostVideoPreviewResult {\n313:   seedId: string;\n314:   expiresAt: string;\n315:   clips: Array<{ cameraId: string; sha256: string; url: string; expiresAt: string }>;\n316: }\n317: \n318: export interface DeleteHostVideoInput extends Identity {\n319:   seedIds: string[];\n320: }\n321: \n322: export interface DeleteHostVideoResult {\n323:   deletedSeedIds: string[];\n324:   deletedObjects: string[];\n325:   revokedManifest: boolean;\n326: }\n327: \n328: export function parseCreateHostInviteInput(value: unknown): CreateHostInviteInput {\n329:   const identity = requireIdentity(value);\n330:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n331:   return identity;\n332: }\n333: \n334: export function parseJoinHostInput(value: unknown): JoinHostInput {\n335:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n336:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n337:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n338:   }\n339:   const partyId = validateId(value.partyId, \"partyId\");\n340:   const deviceId = validateId(value.deviceId, \"deviceId\");\n341:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n342:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n343:   }\n344:   const channelId = validateId(value.channelId, \"channelId\");\n345:   // The invite token is a server-minted capability, never a guest PIN: PIN\n346:   // shape alone must not redeem host access, and client-supplied role\n347:   // strings are ignored (the server assigns \"host\" transactionally).\n348:   if (typeof value.inviteToken !== \"string\" || value.inviteToken.trim() === \"\" || value.inviteToken.length > 256) {\n349:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken is required.\");\n350:   }\n351:   if (JOIN_PIN_RE.test(value.inviteToken)) {\n352:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken must be a host invite, not a guest PIN.\");\n353:   }\n354:   // The pairing code is required and shape-checked here, but a missing or\n355:   // wrong code is denied with the SAME generic FORBIDDEN message as an\n356:   // unknown invite at redemption time, so callers cannot probe which half\n357:   // of the credential failed (no oracle).\n358:   if (typeof value.pairingCode !== \"string\" || !JOIN_PIN_RE.test(value.pairingCode)) {\n359:     throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n360:   }\n361:   return { partyId, deviceId, channelId, inviteToken: value.inviteToken, pairingCode: value.pairingCode };\n362: }\n363: \n364: export function parseListHostVideosInput(value: unknown): ListHostVideosInput {\n365:   const identity = requireIdentity(value);\n366:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n367:   return identity;\n368: }\n369: \n370: export function parseGenerateHostVideoInput(value: unknown): GenerateHostVideoInput {\n371:   const identity = requireIdentity(value);\n372:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n373:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n374:   const seedId = validateId(value.seedId, \"seedId\");\n375:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n376:   // Fixed-preset queue only: same lock as requestGeneration (cheap_demo or\n377:   // cameo_demo with its consent binding); caller overrides are rejected.\n378:   if (value.presetId !== undefined &&\n379:       value.presetId !== CHEAP_DEMO_PRESET.presetId &&\n380:       value.presetId !== CAMEO_DEMO_PRESET.presetId) {\n381:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the fixed generation presets are supported.\");\n382:   }\n383:   const presetId = (value.presetId ?? CHEAP_DEMO_PRESET.presetId) as GenerateHostVideoInput[\"presetId\"];\n384:   if (presetId === CAMEO_DEMO_PRESET.presetId) {\n385:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n386:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n387:     }\n388:     validateId(value.guestMediaId, \"guestMediaId\");\n389:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n390:   }\n391:   if (value.guestMediaId !== undefined) {\n392:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n393:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n394:     }\n395:     validateId(value.guestMediaId, \"guestMediaId\");\n396:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n397:   }\n398:   return { ...identity, seedId, idempotencyKey, presetId };\n399: }\n400: \n401: export function parseGetHostVideoPreviewInput(value: unknown): GetHostVideoPreviewInput {\n402:   const identity = requireIdentity(value);\n403:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n404:   if (!isRecord(value) || typeof value.seedId !== \"string\" || !value.seedId) {\n405:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedId is required.\");\n406:   }\n407:   return { ...identity, seedId: validateId(value.seedId, \"seedId\") };\n408: }\n409: \n410: export function parseDeleteHostVideoInput(value: unknown): DeleteHostVideoInput {\n411:   const identity = requireIdentity(value);\n412:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n413:   if (!isRecord(value) || !Array.isArray(value.seedIds) || value.seedIds.length === 0 || value.seedIds.length > 32) {\n414:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedIds must be a non-empty list (max 32).\");\n415:   }\n416:   const seen = new Set<string>();\n417:   const seedIds: string[] = [];\n418:   for (const raw of value.seedIds) {\n419:     const seedId = validateId(raw, \"seedId\");\n420:     if (seen.has(seedId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Duplicate seedId.\");\n421:     seen.add(seedId);\n422:     seedIds.push(seedId);\n423:   }\n424:   return { ...identity, seedIds };\n425: }\n426: \n427: // ---------------------------------------------------------------------------\n428: // Host pairing + capacity + revocation (cycle-12 fix-1, backend authoritative).\n429: // ---------------------------------------------------------------------------\n430: \n431: /** Max active host devices per party: further redemption is denied until a host is revoked. */\n432: export const HOST_MAX_DEVICES = 3;\n433: \n434: /** Pairing-code shape: exactly six ASCII digits (leading zeros significant). */\n435: export const PAIRING_CODE_RE = /^[0-9]{6}$/;\n436: \n437: /**\n438:  * Host-originated source consent: distinct textVersion/purpose pair for\n439:  * host-submitted source media, namespaced away from the guest cameo pair\n440:  * (`v1` / `guest_cameo`). Consent records carrying this pair include an\n441:  * attestation copy (see guest_upload.ts) and are enforced in eligibility\n442:  * for host submissions. The guest pair is unchanged.\n443:  */\n444: export const HOST_SOURCE_CONSENT_TEXT_VERSION = \"host_source_v1\";\n445: export const HOST_SOURCE_CONSENT_PURPOSE = \"host_source\";\n446: \n447: /** Returns true for either supported consent pair (guest cameo or host source). */\n448: export function isSupportedConsent(textVersion: unknown, purpose: unknown): boolean {\n449:   return (\n450:     (textVersion === \"v1\" && purpose === \"guest_cameo\") ||\n451:     (textVersion === HOST_SOURCE_CONSENT_TEXT_VERSION && purpose === HOST_SOURCE_CONSENT_PURPOSE)\n452:   );\n453: }\n454: \n455: /** Returns true only for the host-originated source consent pair. */\n456: export function isHostSourceConsent(textVersion: unknown, purpose: unknown): boolean {\n457:   return textVersion === HOST_SOURCE_CONSENT_TEXT_VERSION && purpose === HOST_SOURCE_CONSENT_PURPOSE;\n458: }\n459: \n460: export interface RevokeHostDeviceInput extends Identity {\n461:   targetDeviceId: string;\n462: }\n463: \n464: export interface RevokeHostDeviceResult {\n465:   partyId: string;\n466:   targetDeviceId: string;\n467:   status: \"revoked\";\n468: }\n469: \n470: export function parseRevokeHostDeviceInput(value: unknown): RevokeHostDeviceInput {\n471:   const identity = requireIdentity(value);\n472:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n473:   if (!isRecord(value) || typeof value.targetDeviceId !== \"string\" || !value.targetDeviceId) {\n474:     throw new BackendError(\"INVALID_ARGUMENT\", \"targetDeviceId is required.\");\n475:   }\n476:   return { ...identity, targetDeviceId: validateId(value.targetDeviceId, \"targetDeviceId\") };\n477: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-3/backend/functions/src/contracts.ts, lines 1-477\n1: import { createHash } from \"node:crypto\";\n2: import { CAMEO_DEMO_PRESET, CHEAP_DEMO_PRESET, ERROR_CODES, ErrorCode, REQUIRED_CAMERA_IDS, SUPPORTED_CAMERA_COUNTS, expectedCameraIds } from \"./config\";\n3: \n4: export type { ErrorCode };\n5: \n6: export class BackendError extends Error {\n7:   constructor(readonly errorCode: ErrorCode, message: string) {\n8:     super(message);\n9:     this.name = \"BackendError\";\n10:   }\n11: }\n12: \n13: export interface Identity {\n14:   partyId: string;\n15:   deviceId: string;\n16:   channelId: string;\n17: }\n18: \n19: export interface RequestGenerationInput extends Identity {\n20:   jobId: string;\n21:   idempotencyKey: string;\n22:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n23:   /** Optional consent-bound guest media submission bound at request time. */\n24:   guestMediaId?: string;\n25: }\n26: \n27: export interface CanonicalClip {\n28:   cameraId: (typeof REQUIRED_CAMERA_IDS)[number];\n29:   objectPath: string;\n30:   sha256: string;\n31:   sizeBytes: number;\n32:   durationMs: number;\n33:   expiresAt: string;\n34: }\n35: \n36: export interface DeliveryManifest {\n37:   partyId: string;\n38:   channelId: string;\n39:   version: number;\n40:   schemaVersion: number;\n41:   jobId: string;\n42:   cameraClips: CanonicalClip[];\n43:   /** Firestore timestamp in storage; callable serialization converts it to ISO. */\n44:   createdAt?: unknown;\n45:   expiresAt: string;\n46: }\n47: \n48: export interface CurrentManifestInput extends Identity {}\n49: \n50: export interface AckInput extends Identity {\n51:   manifestVersion: number;\n52:   clipHashes: Record<string, string>;\n53: }\n54: \n55: const ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;\n56: const HASH_RE = /^[a-f0-9]{64}$/;\n57: const isRecord = (value: unknown): value is Record<string, unknown> =>\n58:   value !== null && typeof value === \"object\" && !Array.isArray(value);\n59: \n60: export function requireIdentity(value: unknown): Identity {\n61:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n62:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n63:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n64:   }\n65:   const partyId = validateId(value.partyId, \"partyId\");\n66:   const deviceId = validateId(value.deviceId, \"deviceId\");\n67:   const channelId = typeof value.channelId === \"string\" && value.channelId\n68:     ? validateId(value.channelId, \"channelId\")\n69:     : \"\";\n70:   return { partyId, deviceId, channelId };\n71: }\n72: \n73: export function parseRequestGeneration(value: unknown): RequestGenerationInput {\n74:   const identity = requireIdentity(value);\n75:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n76:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n77:   const jobId = validateId(value.jobId, \"jobId\");\n78:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n79:   if (value.presetId === CAMEO_DEMO_PRESET.presetId) {\n80:     // STEP 2 cameo batch: separate server lock, guest-bound only. Text-only\n81:     // requests for this preset are rejected; prompts stay fixed server-side.\n82:     for (const [key, expected] of Object.entries(CAMEO_DEMO_PRESET)) {\n83:       if (key in value && value[key] !== expected) {\n84:         throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n85:       }\n86:     }\n87:     if (!(\"guestMediaId\" in value) || typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n88:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n89:     }\n90:     validateId(value.guestMediaId, \"guestMediaId\");\n91:     return { ...identity, jobId, idempotencyKey, presetId: CAMEO_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n92:   }\n93:   if (value.presetId !== CHEAP_DEMO_PRESET.presetId) {\n94:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the cheap_demo preset is supported.\");\n95:   }\n96:   // Model and generation controls are fixed server-side; caller overrides are rejected.\n97:   for (const [key, expected] of Object.entries(CHEAP_DEMO_PRESET)) {\n98:     if (key in value && value[key] !== expected) {\n99:       throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n100:     }\n101:   }\n102:   if (\"guestMediaId\" in value && value.guestMediaId !== undefined) {\n103:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n104:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n105:     }\n106:     validateId(value.guestMediaId, \"guestMediaId\");\n107:     return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n108:   }\n109:   return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId };\n110: }\n111: \n112: export function parseAck(value: unknown): AckInput {\n113:   const identity = requireIdentity(value);\n114:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n115:   if (!isRecord(value) || !Number.isSafeInteger(value.manifestVersion) || Number(value.manifestVersion) < 1) {\n116:     throw new BackendError(\"INVALID_ARGUMENT\", \"A positive manifestVersion is required.\");\n117:   }\n118:   if (!isRecord(value.clipHashes)) throw new BackendError(\"INVALID_ARGUMENT\", \"clipHashes must be an object.\");\n119:   // 1/2/4-camera layouts: the ACK key set must exactly equal the first-N\n120:   // canonical prefix for one supported count. Extra hashes (beyond the\n121:   // manifest's prefix) are rejected here; exact match against the actual\n122:   // manifest (same length + same hashes) is enforced at ACK acceptance.\n123:   const keys = Object.keys(value.clipHashes).sort();\n124:   const supportedKeySets = (SUPPORTED_CAMERA_COUNTS as readonly number[]).map(\n125:     (count) => [...expectedCameraIds(count)].sort().join(\",\"),\n126:   );\n127:   if (!supportedKeySets.includes(keys.join(\",\"))) {\n128:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK must include one hash for each canonical camera clip (1, 2, or 4 clips, first-N prefix).\");\n129:   }\n130:   const clipHashes: Record<string, string> = {};\n131:   for (const cameraId of keys) {\n132:     const hash = (value.clipHashes as Record<string, unknown>)[cameraId];\n133:     if (typeof hash !== \"string\" || !HASH_RE.test(hash)) {\n134:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hashes must be canonical SHA-256 hex values.\");\n135:     }\n136:     clipHashes[cameraId] = hash;\n137:   }\n138:   return { ...identity, manifestVersion: Number(value.manifestVersion), clipHashes };\n139: }\n140: \n141: export function parseCurrentManifestInput(value: unknown): CurrentManifestInput {\n142:   const identity = requireIdentity(value);\n143:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n144:   return identity;\n145: }\n146: \n147: export interface JoinPartyInput extends Identity {\n148:   joinPin?: string;\n149: }\n150: \n151: /** Exactly six ASCII digits; leading zeros are significant. */\n152: export const JOIN_PIN_RE = /^[0-9]{6}$/;\n153: \n154: export function parseJoinPartyInput(value: unknown): JoinPartyInput {\n155:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n156:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n157:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n158:   }\n159:   const partyId = validateId(value.partyId, \"partyId\");\n160:   const deviceId = validateId(value.deviceId, \"deviceId\");\n161:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n162:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n163:   }\n164:   const channelId = validateId(value.channelId, \"channelId\");\n165:   if (value.joinPin === undefined) {\n166:     return { partyId, deviceId, channelId };\n167:   }\n168:   if (typeof value.joinPin !== \"string\" || !JOIN_PIN_RE.test(value.joinPin)) {\n169:     throw new BackendError(\"INVALID_ARGUMENT\", \"joinPin must be six digits.\");\n170:   }\n171:   return { partyId, deviceId, channelId, joinPin: value.joinPin };\n172: }\n173: \n174: export function validateId(value: unknown, label: string): string {\n175:   if (typeof value !== \"string\" || !ID_RE.test(value)) {\n176:     throw new BackendError(\"INVALID_ARGUMENT\", `${label} is invalid.`);\n177:   }\n178:   return value;\n179: }\n180: \n181: export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n182:   if (!Array.isArray(clips) || !(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(clips.length)) {\n183:     throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain 1, 2, or 4 camera clips (four is the default layout).\");\n184:   }\n185:   const expected = new Set<string>([...expectedCameraIds(clips.length)]);\n186:   const byCamera = new Map<string, CanonicalClip>();\n187:   for (const raw of clips) {\n188:     if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n189:         !expected.has(raw.cameraId) ||\n190:         typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n191:         !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n192:         (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n193:         typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n194:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n195:     }\n196:     if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n197:     byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n198:   }\n199:   // Prefix rule: reordered valid clips are accepted, but gaps (e.g.\n200:   // {CAM-01, CAM-03} for count 2) and unknown cameras are rejected.\n201:   if (byCamera.size !== expected.size || [...expected].some((cameraId) => !byCamera.has(cameraId))) {\n202:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set must equal the first-N canonical cameras.\");\n203:   }\n204: }\n205: \n206: export function canonicalManifestHash(manifest: Pick<DeliveryManifest, \"partyId\" | \"channelId\" | \"version\" | \"cameraClips\">): string {\n207:   const canonical = {\n208:     partyId: manifest.partyId,\n209:     channelId: manifest.channelId,\n210:     version: manifest.version,\n211:     cameraClips: [...manifest.cameraClips]\n212:       .sort((a, b) => a.cameraId.localeCompare(b.cameraId))\n213:       .map(({ cameraId, sha256, sizeBytes, durationMs }) => ({ cameraId, sha256, sizeBytes, durationMs })),\n214:   };\n215:   return createHash(\"sha256\").update(JSON.stringify(canonical)).digest(\"hex\");\n216: }\n217: \n218: export function ackIdempotencyKey(deviceId: string, channelId: string, manifestVersion: number): string {\n219:   return createHash(\"sha256\").update(`${deviceId}\\n${channelId}\\n${manifestVersion}`).digest(\"hex\");\n220: }\n221: \n222: export function isErrorCode(value: unknown): value is ErrorCode {\n223:   return typeof value === \"string\" && (ERROR_CODES as readonly string[]).includes(value);\n224: }\n225: \n226: // ---------------------------------------------------------------------------\n227: // Host administration (cycle-12, partition p1).\n228: //\n229: // The companion uses a dedicated host entry screen (HostEntryScreen with\n230: // Scan Host QR + explicit Join-as-guest route; see partition p4/5 + README).\n231: // Rationale: guest PIN admission is intentionally broad (anyone who sees the\n232: // TV can join as a guest with full party-scoped read/generate/ACK power),\n233: // so host administration must never be reachable through the guest PIN or a\n234: // client-supplied role string. Host access is a separate server-minted,\n235: // short-lived invite capability redeemable once, bound to party/channel/\n236: // expiry, with the host role assigned server-side only.\n237: //\n238: // Callable surface (all exported through index.ts + runtime.ts):\n239: //   createHostInvite  (TV-only)  -> { inviteToken, pairingCode, expiresAt }\n240: //   joinHost          (phone)     -> { role: \"host\" } (separate device identity)\n241: //   revokeHostDevice  (TV-only)  -> { status: \"revoked\" } + audit record\n242: //   listHostVideos    (host-only) -> seed catalog entries\n243: //   generateHostVideo (host-only) -> fixed-preset queued generation + seed entry\n244: //   getHostVideoPreview (host-only) -> signed preview URLs (never persisted)\n245: //   deleteHostVideo   (host-only) -> delete seeds + objects, revoke manifests\n246: // ---------------------------------------------------------------------------\n247: \n248: /** Server-assigned device roles. Clients can never self-assign \"host\" or \"tv\". */\n249: export const DEVICE_ROLES = [\"guest\", \"host\", \"tv\"] as const;\n250: export type DeviceRole = (typeof DEVICE_ROLES)[number];\n251: \n252: export interface CreateHostInviteInput extends Identity {}\n253: \n254: export interface CreateHostInviteResult {\n255:   partyId: string;\n256:   channelId: string;\n257:   inviteToken: string;\n258:   /** Server-minted 6-digit pairing code shown next to the HOST QR on the TV. */\n259:   pairingCode: string;\n260:   expiresAt: string;\n261: }\n262: \n263: export interface JoinHostInput extends Identity {\n264:   inviteToken: string;\n265:   /** 6-digit pairing code displayed next to the HOST QR; required. */\n266:   pairingCode: string;\n267: }\n268: \n269: export interface JoinHostResult {\n270:   partyId: string;\n271:   deviceId: string;\n272:   channelId: string;\n273:   role: \"host\";\n274:   status: \"active\";\n275:   created: boolean;\n276: }\n277: \n278: export interface ListHostVideosInput extends Identity {}\n279: \n280: export type HostSeedStatus = \"queued\" | \"running\" | \"ready\" | \"failed\" | \"deleted\";\n281: \n282: export interface HostSeedEntry {\n283:   seedId: string;\n284:   partyId: string;\n285:   channelId: string;\n286:   status: HostSeedStatus;\n287:   jobId: string;\n288:   createdAt: string;\n289:   expiresAt: string;\n290:   previewAvailable: boolean;\n291:   cameraIds: string[];\n292: }\n293: \n294: export interface GenerateHostVideoInput extends Identity {\n295:   seedId: string;\n296:   idempotencyKey: string;\n297:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n298:   guestMediaId?: string;\n299: }\n300: \n301: export interface GenerateHostVideoResult {\n302:   seedId: string;\n303:   jobId: string;\n304:   state: string;\n305:   created: boolean;\n306: }\n307: \n308: export interface GetHostVideoPreviewInput extends Identity {\n309:   seedId: string;\n310: }\n311: \n312: export interface GetHostVideoPreviewResult {\n313:   seedId: string;\n314:   expiresAt: string;\n315:   clips: Array<{ cameraId: string; sha256: string; url: string; expiresAt: string }>;\n316: }\n317: \n318: export interface DeleteHostVideoInput extends Identity {\n319:   seedIds: string[];\n320: }\n321: \n322: export interface DeleteHostVideoResult {\n323:   deletedSeedIds: string[];\n324:   deletedObjects: string[];\n325:   revokedManifest: boolean;\n326: }\n327: \n328: export function parseCreateHostInviteInput(value: unknown): CreateHostInviteInput {\n329:   const identity = requireIdentity(value);\n330:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n331:   return identity;\n332: }\n333: \n334: export function parseJoinHostInput(value: unknown): JoinHostInput {\n335:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n336:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n337:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n338:   }\n339:   const partyId = validateId(value.partyId, \"partyId\");\n340:   const deviceId = validateId(value.deviceId, \"deviceId\");\n341:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n342:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n343:   }\n344:   const channelId = validateId(value.channelId, \"channelId\");\n345:   // The invite token is a server-minted capability, never a guest PIN: PIN\n346:   // shape alone must not redeem host access, and client-supplied role\n347:   // strings are ignored (the server assigns \"host\" transactionally).\n348:   if (typeof value.inviteToken !== \"string\" || value.inviteToken.trim() === \"\" || value.inviteToken.length > 256) {\n349:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken is required.\");\n350:   }\n351:   if (JOIN_PIN_RE.test(value.inviteToken)) {\n352:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken must be a host invite, not a guest PIN.\");\n353:   }\n354:   // The pairing code is required and shape-checked here, but a missing or\n355:   // wrong code is denied with the SAME generic FORBIDDEN message as an\n356:   // unknown invite at redemption time, so callers cannot probe which half\n357:   // of the credential failed (no oracle).\n358:   if (typeof value.pairingCode !== \"string\" || !JOIN_PIN_RE.test(value.pairingCode)) {\n359:     throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n360:   }\n361:   return { partyId, deviceId, channelId, inviteToken: value.inviteToken, pairingCode: value.pairingCode };\n362: }\n363: \n364: export function parseListHostVideosInput(value: unknown): ListHostVideosInput {\n365:   const identity = requireIdentity(value);\n366:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n367:   return identity;\n368: }\n369: \n370: export function parseGenerateHostVideoInput(value: unknown): GenerateHostVideoInput {\n371:   const identity = requireIdentity(value);\n372:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n373:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n374:   const seedId = validateId(value.seedId, \"seedId\");\n375:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n376:   // Fixed-preset queue only: same lock as requestGeneration (cheap_demo or\n377:   // cameo_demo with its consent binding); caller overrides are rejected.\n378:   if (value.presetId !== undefined &&\n379:       value.presetId !== CHEAP_DEMO_PRESET.presetId &&\n380:       value.presetId !== CAMEO_DEMO_PRESET.presetId) {\n381:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the fixed generation presets are supported.\");\n382:   }\n383:   const presetId = (value.presetId ?? CHEAP_DEMO_PRESET.presetId) as GenerateHostVideoInput[\"presetId\"];\n384:   if (presetId === CAMEO_DEMO_PRESET.presetId) {\n385:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n386:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n387:     }\n388:     validateId(value.guestMediaId, \"guestMediaId\");\n389:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n390:   }\n391:   if (value.guestMediaId !== undefined) {\n392:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n393:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n394:     }\n395:     validateId(value.guestMediaId, \"guestMediaId\");\n396:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n397:   }\n398:   return { ...identity, seedId, idempotencyKey, presetId };\n399: }\n400: \n401: export function parseGetHostVideoPreviewInput(value: unknown): GetHostVideoPreviewInput {\n402:   const identity = requireIdentity(value);\n403:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n404:   if (!isRecord(value) || typeof value.seedId !== \"string\" || !value.seedId) {\n405:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedId is required.\");\n406:   }\n407:   return { ...identity, seedId: validateId(value.seedId, \"seedId\") };\n408: }\n409: \n410: export function parseDeleteHostVideoInput(value: unknown): DeleteHostVideoInput {\n411:   const identity = requireIdentity(value);\n412:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n413:   if (!isRecord(value) || !Array.isArray(value.seedIds) || value.seedIds.length === 0 || value.seedIds.length > 32) {\n414:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedIds must be a non-empty list (max 32).\");\n415:   }\n416:   const seen = new Set<string>();\n417:   const seedIds: string[] = [];\n418:   for (const raw of value.seedIds) {\n419:     const seedId = validateId(raw, \"seedId\");\n420:     if (seen.has(seedId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Duplicate seedId.\");\n421:     seen.add(seedId);\n422:     seedIds.push(seedId);\n423:   }\n424:   return { ...identity, seedIds };\n425: }\n426: \n427: // ---------------------------------------------------------------------------\n428: // Host pairing + capacity + revocation (cycle-12 fix-1, backend authoritative).\n429: // ---------------------------------------------------------------------------\n430: \n431: /** Max active host devices per party: further redemption is denied until a host is revoked. */\n432: export const HOST_MAX_DEVICES = 3;\n433: \n434: /** Pairing-code shape: exactly six ASCII digits (leading zeros significant). */\n435: export const PAIRING_CODE_RE = /^[0-9]{6}$/;\n436: \n437: /**\n438:  * Host-originated source consent: distinct textVersion/purpose pair for\n439:  * host-submitted source media, namespaced away from the guest cameo pair\n440:  * (`v1` / `guest_cameo`). Consent records carrying this pair include an\n441:  * attestation copy (see guest_upload.ts) and are enforced in eligibility\n442:  * for host submissions. The guest pair is unchanged.\n443:  */\n444: export const HOST_SOURCE_CONSENT_TEXT_VERSION = \"host_source_v1\";\n445: export const HOST_SOURCE_CONSENT_PURPOSE = \"host_source\";\n446: \n447: /** Returns true for either supported consent pair (guest cameo or host source). */\n448: export function isSupportedConsent(textVersion: unknown, purpose: unknown): boolean {\n449:   return (\n450:     (textVersion === \"v1\" && purpose === \"guest_cameo\") ||\n451:     (textVersion === HOST_SOURCE_CONSENT_TEXT_VERSION && purpose === HOST_SOURCE_CONSENT_PURPOSE)\n452:   );\n453: }\n454: \n455: /** Returns true only for the host-originated source consent pair. */\n456: export function isHostSourceConsent(textVersion: unknown, purpose: unknown): boolean {\n457:   return textVersion === HOST_SOURCE_CONSENT_TEXT_VERSION && purpose === HOST_SOURCE_CONSENT_PURPOSE;\n458: }\n459: \n460: export interface RevokeHostDeviceInput extends Identity {\n461:   targetDeviceId: string;\n462: }\n463: \n464: export interface RevokeHostDeviceResult {\n465:   partyId: string;\n466:   targetDeviceId: string;\n467:   status: \"revoked\";\n468: }\n469: \n470: export function parseRevokeHostDeviceInput(value: unknown): RevokeHostDeviceInput {\n471:   const identity = requireIdentity(value);\n472:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n473:   if (!isRecord(value) || typeof value.targetDeviceId !== \"string\" || !value.targetDeviceId) {\n474:     throw new BackendError(\"INVALID_ARGUMENT\", \"targetDeviceId is required.\");\n475:   }\n476:   return { ...identity, targetDeviceId: validateId(value.targetDeviceId, \"targetDeviceId\") };\n477: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192d1dc6e729d856e736b60f20759"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/src/contracts.ts\"}"},"time":{"start":1793464589409,"end":1793464591164}}}}
