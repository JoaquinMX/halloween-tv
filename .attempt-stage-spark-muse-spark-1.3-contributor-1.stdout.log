{"type":"tool_use","timestamp":1793461713301,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5f8a80013TDWJStIU0If3h","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5f138001MgqfDqvWOLjcM7","type":"tool","id":"call_01a192a5f3a071238c5228c86d0c9bd4","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/config.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/config.ts, lines 1-142\n1: export const REGION = \"us-central1\";\n2: // v2 storage triggers must live in the bucket's region, not the functions\n3: // default. The ingest bucket is US-EAST1, so only the object-finalized\n4: // trigger is pinned here; every other function stays on REGION.\n5: export const STORAGE_TRIGGER_REGION = \"us-east1\";\n6: export const SCHEMA_VERSION = 1;\n7: /**\n8:  * Generation task worker memory headroom for ffmpeg normalization.\n9:  * Linux ffmpeg plus the ~147MB packaged runtime plus frame buffers OOM at the\n10:  * default 256MiB (\"Memory limit of 256 MiB exceeded\"); 1GiB gives the worker\n11:  * explicit headroom. Referenced by runGeneration in src/index.ts and floored\n12:  * (>= 512MiB) by tools/deploy_preflight.ts.\n13:  */\n14: export const GENERATION_WORKER_MEMORY = \"1GiB\" as const;\n15: export const DELIVERY_URL_TTL_SECONDS = 15 * 60;\n16: export const MEDIA_RETENTION_MS = 24 * 60 * 60 * 1000;\n17: export const REQUIRED_CAMERA_IDS = [\"CAM-01\", \"CAM-02\", \"CAM-03\", \"CAM-04\"] as const;\n18: /**\n19:  * Supported manifest clip counts (configurable 1/2/4-camera TV layouts).\n20:  * Generation presets keep producing 4 clips; this is a display/contract CAP:\n21:  * validators accept exactly these counts and require the camera set to equal\n22:  * the first N canonical slots. Absent/invalid/unreadable cameraCount\n23:  * settings default to 4 (see partition p2/p3 SettingsPort handling).\n24:  */\n25: export const SUPPORTED_CAMERA_COUNTS = [1, 2, 4] as const;\n26: export type SupportedCameraCount = (typeof SUPPORTED_CAMERA_COUNTS)[number];\n27: \n28: /** First-N canonical camera ids for a supported count, in wall order. */\n29: export function expectedCameraIds(count: number): readonly string[] {\n30:   if (!(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(count)) {\n31:     throw new Error(`Unsupported camera count ${count}; expected one of ${SUPPORTED_CAMERA_COUNTS.join(\", \")}.`);\n32:   }\n33:   return REQUIRED_CAMERA_IDS.slice(0, count);\n34: }\n35: \n36: /** Short-lived host-invite capability lifetime (TV-minted, phone-redeemed). */\n37: export const HOST_INVITE_TTL_MS = 5 * 60 * 1000;\n38: /** TTL for separately referenced host preview objects (seed catalog). */\n39: export const HOST_PREVIEW_TTL_MS = 24 * 60 * 60 * 1000;\n40: \n41: /** Preview object path: separately referenced from delivery objects so an ACK purge never removes previews. */\n42: export function hostPreviewObjectPath(partyId: string, seedId: string, cameraId: string): string {\n43:   return `parties/${partyId}/hostPreviews/${seedId}/${cameraId}.mp4`;\n44: }\n45: \n46: /** Generation is inert unless an operator explicitly opts in. */\n47: export function isGenerationEnabled(environment: NodeJS.ProcessEnv = process.env): boolean {\n48:   return environment.GENERATION_ENABLED === \"true\";\n49: }\n50: \n51: export const CHEAP_DEMO_PRESET = Object.freeze({\n52:   presetId: \"cheap_demo\" as const,\n53:   modelId: \"wan3.0-video\" as const,\n54:   region: \"singapore\" as const,\n55:   resolution: \"480P\" as const,\n56:   secondsOut: 2 as const,\n57:   aspectRatio: \"16:9\" as const,\n58:   audio: false as const,\n59:   outputs: 1 as const,\n60:   autoUpscale: false as const,\n61: });\n62: \n63: /**\n64:  * Owner-approved STEP 2 cameo batch preset (single approved batch only).\n65:  *\n66:  * Separate from cheap_demo, which is never altered: 5 seconds, 480p, silent,\n67:  * 1 output, exactly ONE provider-generated camera slot (CAM-01) plus three\n68:  * local fixture slots, reference-image input via the validated guest binding.\n69:  * Text-only requests are rejected for this preset; it exists solely for the\n70:  * consented-reference batch.\n71:  *\n72:  * Model choice: happyhorse-1.1-r2v (reference-image-to-video). The checked-in\n73:  * adapter performs no per-model capability validation and the repo carries no\n74:  * offline documentation establishing that wan3.0-video accepts a\n75:  * reference_image input at a 5-second duration, so mapping the 5s\n76:  * reference-bound batch to the r2v (reference-to-video) model is the\n77:  * technically safer call. Verified offline via serialization fixtures only;\n78:  * no provider network call was made.\n79:  *\n80:  * Billing caveat (surfaced, never estimated): reference inputs can bill\n81:  * input duration — the adapter surfaces the provider's realized\n82:  * usage.input_video_duration as secondsIn, and Token Plan Credits may differ\n83:  * from list prices. Only realized console Credits are billable truth.\n84:  */\n85: export const CAMEO_DEMO_PRESET = Object.freeze({\n86:   presetId: \"cameo_demo\" as const,\n87:   modelId: \"happyhorse-1.1-r2v\" as const,\n88:   region: \"singapore\" as const,\n89:   resolution: \"480P\" as const,\n90:   secondsOut: 5 as const,\n91:   aspectRatio: \"16:9\" as const,\n92:   audio: false as const,\n93:   outputs: 1 as const,\n94:   autoUpscale: false as const,\n95: });\n96: \n97: /**\n98:  * Fixed server-side prompt for the STEP 2 cameo batch. Baked in exactly as\n99:  * owner-approved; never caller-supplied, never logged.\n100:  */\n101: export const CAMEO_DEMO_PROMPT =\n102:   \"Create a 5-second, fully 2D animated clip in the style of classic Scooby-Doo. \" +\n103:   \"Use the person in V2 as the character reference, preserving his glasses, hair, beard, and outfit, all fully drawn. \" +\n104:   \"In a spooky mansion hallway with crooked portraits, cobwebs, and flickering lamps, the terrified person runs left to right \" +\n105:   \"while a goofy, lumbering green monster chases close behind. \" +\n106:   \"Use one continuous side-tracking shot, keeping both characters visible. \" +\n107:   \"0-2 seconds: The person sprints with exaggerated cartoon strides while the monster reaches toward him. \" +\n108:   \"2-4 seconds: He glances backward, eyes widening, then accelerates with comically spinning legs. \" +\n109:   \"4-5 seconds: Both race through an open doorway and disappear offscreen. \" +\n110:   \"Bold ink outlines, flat cel shading, hand-painted purple-and-teal backgrounds, expressive faces, \" +\n111:   \"elastic cartoon movement, and playful spooky slapstick. \" +\n112:   \"No photorealism, 3D rendering, gore, text, or changes to the person's identity.\";\n113: \n114: /** Guest upload/consent controls. Server-side only; never trust caller-supplied paths. */\n115: export const GUEST_CONSENT_TEXT_VERSION = \"v1\";\n116: export const GUEST_CONSENT_PURPOSE = \"guest_cameo\";\n117: /** Short-lived upload capability lifetime (signed PUT bound to object + content type). */\n118: export const GUEST_UPLOAD_TTL_MS = 15 * 60 * 1000;\n119: /** Abandoned/expired guest inputs are removed within a capped 24h deadline. */\n120: export const GUEST_INPUT_TTL_MS = 24 * 60 * 60 * 1000;\n121: export const GUEST_MAX_IMAGE_BYTES = 10 * 1024 * 1024;\n122: export const GUEST_ALLOWED_CONTENT_TYPES = [\"image/jpeg\", \"image/png\"] as const;\n123: export type GuestAllowedContentType = (typeof GUEST_ALLOWED_CONTENT_TYPES)[number];\n124: /** Exactly one provider-generated camera in a guest-bound job; the rest are local fixtures. */\n125: export const GUEST_PROVIDER_CAMERA_ID = \"CAM-01\" as const;\n126: \n127: export const ERROR_CODES = [\n128:   \"UNAUTHENTICATED\",\n129:   \"FORBIDDEN\",\n130:   \"MANIFEST_MISMATCH\",\n131:   \"CLIP_EXPIRED\",\n132:   \"PROVIDER_UNAVAILABLE\",\n133:   \"BUDGET_EXCEEDED\",\n134:   \"INVALID_ARGUMENT\",\n135:   \"NOT_FOUND\",\n136:   \"INTERNAL\",\n137: ] as const;\n138: \n139: export type ErrorCode = (typeof ERROR_CODES)[number];\n140: \n141: export const JOB_STATES = [\"queued\", \"running\", \"ready\", \"delivering\", \"purged\", \"failed\", \"expired\"] as const;\n142: export type JobState = (typeof JOB_STATES)[number];","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/config.ts, lines 1-142\n1: export const REGION = \"us-central1\";\n2: // v2 storage triggers must live in the bucket's region, not the functions\n3: // default. The ingest bucket is US-EAST1, so only the object-finalized\n4: // trigger is pinned here; every other function stays on REGION.\n5: export const STORAGE_TRIGGER_REGION = \"us-east1\";\n6: export const SCHEMA_VERSION = 1;\n7: /**\n8:  * Generation task worker memory headroom for ffmpeg normalization.\n9:  * Linux ffmpeg plus the ~147MB packaged runtime plus frame buffers OOM at the\n10:  * default 256MiB (\"Memory limit of 256 MiB exceeded\"); 1GiB gives the worker\n11:  * explicit headroom. Referenced by runGeneration in src/index.ts and floored\n12:  * (>= 512MiB) by tools/deploy_preflight.ts.\n13:  */\n14: export const GENERATION_WORKER_MEMORY = \"1GiB\" as const;\n15: export const DELIVERY_URL_TTL_SECONDS = 15 * 60;\n16: export const MEDIA_RETENTION_MS = 24 * 60 * 60 * 1000;\n17: export const REQUIRED_CAMERA_IDS = [\"CAM-01\", \"CAM-02\", \"CAM-03\", \"CAM-04\"] as const;\n18: /**\n19:  * Supported manifest clip counts (configurable 1/2/4-camera TV layouts).\n20:  * Generation presets keep producing 4 clips; this is a display/contract CAP:\n21:  * validators accept exactly these counts and require the camera set to equal\n22:  * the first N canonical slots. Absent/invalid/unreadable cameraCount\n23:  * settings default to 4 (see partition p2/p3 SettingsPort handling).\n24:  */\n25: export const SUPPORTED_CAMERA_COUNTS = [1, 2, 4] as const;\n26: export type SupportedCameraCount = (typeof SUPPORTED_CAMERA_COUNTS)[number];\n27: \n28: /** First-N canonical camera ids for a supported count, in wall order. */\n29: export function expectedCameraIds(count: number): readonly string[] {\n30:   if (!(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(count)) {\n31:     throw new Error(`Unsupported camera count ${count}; expected one of ${SUPPORTED_CAMERA_COUNTS.join(\", \")}.`);\n32:   }\n33:   return REQUIRED_CAMERA_IDS.slice(0, count);\n34: }\n35: \n36: /** Short-lived host-invite capability lifetime (TV-minted, phone-redeemed). */\n37: export const HOST_INVITE_TTL_MS = 5 * 60 * 1000;\n38: /** TTL for separately referenced host preview objects (seed catalog). */\n39: export const HOST_PREVIEW_TTL_MS = 24 * 60 * 60 * 1000;\n40: \n41: /** Preview object path: separately referenced from delivery objects so an ACK purge never removes previews. */\n42: export function hostPreviewObjectPath(partyId: string, seedId: string, cameraId: string): string {\n43:   return `parties/${partyId}/hostPreviews/${seedId}/${cameraId}.mp4`;\n44: }\n45: \n46: /** Generation is inert unless an operator explicitly opts in. */\n47: export function isGenerationEnabled(environment: NodeJS.ProcessEnv = process.env): boolean {\n48:   return environment.GENERATION_ENABLED === \"true\";\n49: }\n50: \n51: export const CHEAP_DEMO_PRESET = Object.freeze({\n52:   presetId: \"cheap_demo\" as const,\n53:   modelId: \"wan3.0-video\" as const,\n54:   region: \"singapore\" as const,\n55:   resolution: \"480P\" as const,\n56:   secondsOut: 2 as const,\n57:   aspectRatio: \"16:9\" as const,\n58:   audio: false as const,\n59:   outputs: 1 as const,\n60:   autoUpscale: false as const,\n61: });\n62: \n63: /**\n64:  * Owner-approved STEP 2 cameo batch preset (single approved batch only).\n65:  *\n66:  * Separate from cheap_demo, which is never altered: 5 seconds, 480p, silent,\n67:  * 1 output, exactly ONE provider-generated camera slot (CAM-01) plus three\n68:  * local fixture slots, reference-image input via the validated guest binding.\n69:  * Text-only requests are rejected for this preset; it exists solely for the\n70:  * consented-reference batch.\n71:  *\n72:  * Model choice: happyhorse-1.1-r2v (reference-image-to-video). The checked-in\n73:  * adapter performs no per-model capability validation and the repo carries no\n74:  * offline documentation establishing that wan3.0-video accepts a\n75:  * reference_image input at a 5-second duration, so mapping the 5s\n76:  * reference-bound batch to the r2v (reference-to-video) model is the\n77:  * technically safer call. Verified offline via serialization fixtures only;\n78:  * no provider network call was made.\n79:  *\n80:  * Billing caveat (surfaced, never estimated): reference inputs can bill\n81:  * input duration — the adapter surfaces the provider's realized\n82:  * usage.input_video_duration as secondsIn, and Token Plan Credits may differ\n83:  * from list prices. Only realized console Credits are billable truth.\n84:  */\n85: export const CAMEO_DEMO_PRESET = Object.freeze({\n86:   presetId: \"cameo_demo\" as const,\n87:   modelId: \"happyhorse-1.1-r2v\" as const,\n88:   region: \"singapore\" as const,\n89:   resolution: \"480P\" as const,\n90:   secondsOut: 5 as const,\n91:   aspectRatio: \"16:9\" as const,\n92:   audio: false as const,\n93:   outputs: 1 as const,\n94:   autoUpscale: false as const,\n95: });\n96: \n97: /**\n98:  * Fixed server-side prompt for the STEP 2 cameo batch. Baked in exactly as\n99:  * owner-approved; never caller-supplied, never logged.\n100:  */\n101: export const CAMEO_DEMO_PROMPT =\n102:   \"Create a 5-second, fully 2D animated clip in the style of classic Scooby-Doo. \" +\n103:   \"Use the person in V2 as the character reference, preserving his glasses, hair, beard, and outfit, all fully drawn. \" +\n104:   \"In a spooky mansion hallway with crooked portraits, cobwebs, and flickering lamps, the terrified person runs left to right \" +\n105:   \"while a goofy, lumbering green monster chases close behind. \" +\n106:   \"Use one continuous side-tracking shot, keeping both characters visible. \" +\n107:   \"0-2 seconds: The person sprints with exaggerated cartoon strides while the monster reaches toward him. \" +\n108:   \"2-4 seconds: He glances backward, eyes widening, then accelerates with comically spinning legs. \" +\n109:   \"4-5 seconds: Both race through an open doorway and disappear offscreen. \" +\n110:   \"Bold ink outlines, flat cel shading, hand-painted purple-and-teal backgrounds, expressive faces, \" +\n111:   \"elastic cartoon movement, and playful spooky slapstick. \" +\n112:   \"No photorealism, 3D rendering, gore, text, or changes to the person's identity.\";\n113: \n114: /** Guest upload/consent controls. Server-side only; never trust caller-supplied paths. */\n115: export const GUEST_CONSENT_TEXT_VERSION = \"v1\";\n116: export const GUEST_CONSENT_PURPOSE = \"guest_cameo\";\n117: /** Short-lived upload capability lifetime (signed PUT bound to object + content type). */\n118: export const GUEST_UPLOAD_TTL_MS = 15 * 60 * 1000;\n119: /** Abandoned/expired guest inputs are removed within a capped 24h deadline. */\n120: export const GUEST_INPUT_TTL_MS = 24 * 60 * 60 * 1000;\n121: export const GUEST_MAX_IMAGE_BYTES = 10 * 1024 * 1024;\n122: export const GUEST_ALLOWED_CONTENT_TYPES = [\"image/jpeg\", \"image/png\"] as const;\n123: export type GuestAllowedContentType = (typeof GUEST_ALLOWED_CONTENT_TYPES)[number];\n124: /** Exactly one provider-generated camera in a guest-bound job; the rest are local fixtures. */\n125: export const GUEST_PROVIDER_CAMERA_ID = \"CAM-01\" as const;\n126: \n127: export const ERROR_CODES = [\n128:   \"UNAUTHENTICATED\",\n129:   \"FORBIDDEN\",\n130:   \"MANIFEST_MISMATCH\",\n131:   \"CLIP_EXPIRED\",\n132:   \"PROVIDER_UNAVAILABLE\",\n133:   \"BUDGET_EXCEEDED\",\n134:   \"INVALID_ARGUMENT\",\n135:   \"NOT_FOUND\",\n136:   \"INTERNAL\",\n137: ] as const;\n138: \n139: export type ErrorCode = (typeof ERROR_CODES)[number];\n140: \n141: export const JOB_STATES = [\"queued\", \"running\", \"ready\", \"delivering\", \"purged\", \"failed\", \"expired\"] as const;\n142: export type JobState = (typeof JOB_STATES)[number];"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5f3a071238c5228c86d0c9bd4"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/config.ts\"}"},"time":{"start":1793461713064,"end":1793461713301}}}}
{"type":"tool_use","timestamp":1793461713303,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5f8ac001eVIFM9609QtkA3","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5f138001MgqfDqvWOLjcM7","type":"tool","id":"call_01a192a5f4e8704f9df97f54641ad044","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/auth.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/auth.ts, lines 1-75\n1: import { Firestore } from \"firebase-admin/firestore\";\n2: import { BackendError, Identity } from \"./contracts\";\n3: \n4: export interface RegisteredContext extends Identity {\n5:   party: FirebaseFirestore.DocumentData;\n6:   device: FirebaseFirestore.DocumentData;\n7:   channel: FirebaseFirestore.DocumentData;\n8: }\n9: \n10: /**\n11:  * Anonymous identity is the registered party/device pair. Firebase Auth UIDs and\n12:  * email claims are intentionally neither required nor used for authorization.\n13:  */\n14: \n15: /**\n16:  * Host administration gate. The host role is assigned server-side only\n17:  * (transactional invite redemption in host_join.ts); a client-supplied role\n18:  * string is never trusted. Every administrative operation revalidates the\n19:  * registered host role and party/channel scope through this helper.\n20:  */\n21: export async function assertRegisteredHostDevice(\n22:   db: Firestore,\n23:   identity: Identity,\n24: ): Promise<RegisteredContext> {\n25:   const registered = await assertRegisteredPartyDevice(db, identity);\n26:   if (registered.device.role !== \"host\") {\n27:     throw new BackendError(\"FORBIDDEN\", \"Host administration requires a registered host device.\");\n28:   }\n29:   return registered;\n30: }\n31: \n32: /** TV-only gate for minting host invites: only a registered TV may invite. */\n33: export async function assertRegisteredTvDevice(\n34:   db: Firestore,\n35:   identity: Identity,\n36: ): Promise<RegisteredContext> {\n37:   const registered = await assertRegisteredPartyDevice(db, identity);\n38:   if (registered.device.role !== \"tv\") {\n39:     throw new BackendError(\"FORBIDDEN\", \"Only a registered TV may mint a host invite.\");\n40:   }\n41:   return registered;\n42: }\n43: export async function assertRegisteredPartyDevice(\n44:   db: Firestore,\n45:   identity: Identity,\n46: ): Promise<RegisteredContext> {\n47:   const partyRef = db.doc(`parties/${identity.partyId}`);\n48:   const deviceRef = partyRef.collection(\"devices\").doc(identity.deviceId);\n49:   const [partySnap, deviceSnap] = await Promise.all([partyRef.get(), deviceRef.get()]);\n50:   if (!partySnap.exists || !deviceSnap.exists) {\n51:     throw new BackendError(\"FORBIDDEN\", \"Party/device pair is not registered.\");\n52:   }\n53:   const party = partySnap.data()!;\n54:   const device = deviceSnap.data()!;\n55:   if (party.status !== \"active\" || device.status !== \"active\" || device.partyId !== identity.partyId) {\n56:     throw new BackendError(\"FORBIDDEN\", \"Party/device pair is not active.\");\n57:   }\n58:   const channelId = identity.channelId || String(party.activeChannelId ?? \"\");\n59:   if (!channelId || party.activeChannelId !== channelId) {\n60:     throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n61:   }\n62:   const channelRef = partyRef.collection(\"channels\").doc(channelId);\n63:   const channelSnap = await channelRef.get();\n64:   if (!channelSnap.exists || channelSnap.data()?.partyId !== identity.partyId || channelSnap.data()?.status !== \"active\") {\n65:     throw new BackendError(\"FORBIDDEN\", \"Channel is not registered for this party.\");\n66:   }\n67:   return {\n68:     partyId: identity.partyId,\n69:     deviceId: identity.deviceId,\n70:     channelId,\n71:     party,\n72:     device,\n73:     channel: channelSnap.data()!,\n74:   };\n75: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/auth.ts, lines 1-75\n1: import { Firestore } from \"firebase-admin/firestore\";\n2: import { BackendError, Identity } from \"./contracts\";\n3: \n4: export interface RegisteredContext extends Identity {\n5:   party: FirebaseFirestore.DocumentData;\n6:   device: FirebaseFirestore.DocumentData;\n7:   channel: FirebaseFirestore.DocumentData;\n8: }\n9: \n10: /**\n11:  * Anonymous identity is the registered party/device pair. Firebase Auth UIDs and\n12:  * email claims are intentionally neither required nor used for authorization.\n13:  */\n14: \n15: /**\n16:  * Host administration gate. The host role is assigned server-side only\n17:  * (transactional invite redemption in host_join.ts); a client-supplied role\n18:  * string is never trusted. Every administrative operation revalidates the\n19:  * registered host role and party/channel scope through this helper.\n20:  */\n21: export async function assertRegisteredHostDevice(\n22:   db: Firestore,\n23:   identity: Identity,\n24: ): Promise<RegisteredContext> {\n25:   const registered = await assertRegisteredPartyDevice(db, identity);\n26:   if (registered.device.role !== \"host\") {\n27:     throw new BackendError(\"FORBIDDEN\", \"Host administration requires a registered host device.\");\n28:   }\n29:   return registered;\n30: }\n31: \n32: /** TV-only gate for minting host invites: only a registered TV may invite. */\n33: export async function assertRegisteredTvDevice(\n34:   db: Firestore,\n35:   identity: Identity,\n36: ): Promise<RegisteredContext> {\n37:   const registered = await assertRegisteredPartyDevice(db, identity);\n38:   if (registered.device.role !== \"tv\") {\n39:     throw new BackendError(\"FORBIDDEN\", \"Only a registered TV may mint a host invite.\");\n40:   }\n41:   return registered;\n42: }\n43: export async function assertRegisteredPartyDevice(\n44:   db: Firestore,\n45:   identity: Identity,\n46: ): Promise<RegisteredContext> {\n47:   const partyRef = db.doc(`parties/${identity.partyId}`);\n48:   const deviceRef = partyRef.collection(\"devices\").doc(identity.deviceId);\n49:   const [partySnap, deviceSnap] = await Promise.all([partyRef.get(), deviceRef.get()]);\n50:   if (!partySnap.exists || !deviceSnap.exists) {\n51:     throw new BackendError(\"FORBIDDEN\", \"Party/device pair is not registered.\");\n52:   }\n53:   const party = partySnap.data()!;\n54:   const device = deviceSnap.data()!;\n55:   if (party.status !== \"active\" || device.status !== \"active\" || device.partyId !== identity.partyId) {\n56:     throw new BackendError(\"FORBIDDEN\", \"Party/device pair is not active.\");\n57:   }\n58:   const channelId = identity.channelId || String(party.activeChannelId ?? \"\");\n59:   if (!channelId || party.activeChannelId !== channelId) {\n60:     throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n61:   }\n62:   const channelRef = partyRef.collection(\"channels\").doc(channelId);\n63:   const channelSnap = await channelRef.get();\n64:   if (!channelSnap.exists || channelSnap.data()?.partyId !== identity.partyId || channelSnap.data()?.status !== \"active\") {\n65:     throw new BackendError(\"FORBIDDEN\", \"Channel is not registered for this party.\");\n66:   }\n67:   return {\n68:     partyId: identity.partyId,\n69:     deviceId: identity.deviceId,\n70:     channelId,\n71:     party,\n72:     device,\n73:     channel: channelSnap.data()!,\n74:   };\n75: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5f4e8704f9df97f54641ad044"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/auth.ts\"}"},"time":{"start":1793461713068,"end":1793461713303}}}}
{"type":"tool_use","timestamp":1793461713305,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5f8b3001P6i5rntEQFpLhL","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5f138001MgqfDqvWOLjcM7","type":"tool","id":"call_01a192a5f7d2763eb07ca203000c608d","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/guest_photo_emulator_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/guest_photo_emulator_test.dart, lines 1-414\n1: // Guest-photo positive completion flow (host-run integration).\n2: //\n3: // Runs the REAL companion guest-media stack ([GuestMediaClient] consent\n4: // gate and [HttpGuestMediaTransport] byte upload) against the REAL Firebase\n5: // emulators (Functions/Firestore/Storage on the `backend/firebase.json`\n6: // ports) and the REAL guest-media callables\n7: // (requestGuestUpload/completeGuestUpload/getGuestMediaStatus/\n8: // withdrawGuestMedia in `backend/functions/src/index.ts`). No billable\n9: // calls: the emulators are local and generation stays disabled there.\n10: //\n11: // Backend contract under test (2026-10-30, from\n12: // `backend/functions/src/guest_upload.ts` + `contracts.ts`):\n13: //   requestGuestUpload  {partyId, deviceId, channelId,\n14: //                        consent:{accepted:true,textVersion:\"v1\",\n15: //                                purpose:\"guest_cameo\"},\n16: //                        contentType:\"image/jpeg\"|\"image/png\"}\n17: //                     -> {submissionId, objectPath, uploadUrl, expiresAt,\n18: //                         consentRevision}   // NO contentType echo\n19: //   completeGuestUpload {partyId, deviceId, channelId, submissionId}\n20: //                     -> {submissionId, partyId, deviceId, channelId,\n21: //                         status:\"eligible\", objectPath, consentRevision,\n22: //                         expiresAt, sha256, sizeBytes}\n23: //   getGuestMediaStatus {partyId, deviceId, channelId, submissionId}\n24: //                     -> same shape, status pending_upload|eligible|\n25: //                        withdrawn|expired\n26: //   withdrawGuestMedia  {partyId, deviceId, channelId, submissionId}\n27: //                     -> {submissionId, status:\"withdrawn\",\n28: //                         deletedObjects, verifiedAbsent:true}\n29: //\n30: // STORAGE EMULATOR GAP (pinned, not a product bug): the Functions emulator\n31: // signs an http upload URL whose host the client correctly rejects, and the\n32: // direct Storage-emulator PUT route answers HTTP 501 (no XML-API PUT\n33: // upload). So this test drives capability issuance through the real backend\n34: // (asserted in full below) and then drives the real transport PUT, which is\n35: // EXPECTED to fail with HTTP 501 — proving the flow reaches the signed-PUT\n36: // stage (not an earlier contract failure). Completion, status, withdrawal,\n37: // absence, and generation refusal are pinned end to end by backend tests and\n38: // by unit fakes that mirror the exact envelope above (see\n39: // test/guest_media_client_test.dart + test/guest_media_session_test.dart).\n40: //\n41: // NOTE: the in-app [GuestMediaClient]/[GuestMediaSession] request envelope\n42: // matches this contract (channelId + consent:{accepted:true,\n43: // textVersion:\"v1\", purpose:\"guest_cameo\"} named constants). The happy path\n44: // below still drives the real callable wire envelope (`{\"data\": ...}`,\n45: // identical to what `firebase_functions` sends) directly for the\n46: // capability mint (the client validates https-only URLs while the emulator\n47: // signs http URLs), while the consent gate and the byte PUT still go\n48: // through the real client/transport classes. The assertions are\n49: // falsifiable end to end: capability -> signed PUT -> complete(eligible,\n50: // backend-computed sha256/sizeBytes) -> status -> withdraw -> object\n51: // absence -> refusal of later use from the guest path.\n52: //\n53: // Emulators must be running before this file runs (from `backend/`).\n54: // Capability minting needs a local signing key (the Functions emulator\n55: // has no ADC private key, so getSignedUrl would return INTERNAL):\n56: //   GOOGLE_APPLICATION_CREDENTIALS=/tmp/fake-sa.json\n57: //   STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase\n58: //     --config firebase.json emulators:start\n59: //     --only firestore,functions,storage --project demo-halloween-tv\n60: // and the fixed party must be pre-seeded with the Admin SDK (client REST\n61: // cannot create it: firestore.rules deny all direct writes):\n62: //   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080\n63: //   STORAGE_EMULATOR_HOST=http://127.0.0.1:9199 node /tmp/seed-guest-photo.js\n64: // (wipes parties/guest-photo-it in Firestore AND Storage, recreates the\n65: // party + its cctv channel; the device is left for joinParty to create).\n66: // If the emulators are unreachable the test SKIPS (never fake-passes).\n67: //\n68: // Run serially from `apps/companion_app`:\n69: //   flutter test --concurrency=1 integration_test/guest_photo_emulator_test.dart\n70: library;\n71: \n72: import 'dart:convert';\n73: import 'dart:io';\n74: \n75: import 'package:companion_app/src/data/guest_media_client.dart';\n76: import 'package:companion_app/src/session/guest_media_session.dart';\n77: import 'package:flutter_test/flutter_test.dart';\n78: import 'package:http/http.dart' as http;\n79: import 'package:shared_preferences/shared_preferences.dart';\n80: \n81: const String _kProject = 'demo-halloween-tv';\n82: const String _kRegion = 'us-central1';\n83: const String _kFunctionsBase = 'http://127.0.0.1:5001';\n84: const String _kFirestoreBase = 'http://127.0.0.1:8080';\n85: const Duration _kHttpTimeout = Duration(seconds: 20);\n86: \n87: /// Server-side consent constants (pinned to backend/functions/src/config.ts\n88: /// -> GUEST_CONSENT_TEXT_VERSION / GUEST_CONSENT_PURPOSE).\n89: const String _kConsentTextVersion = 'v1';\n90: const String _kConsentPurpose = 'guest_cameo';\n91: \n92: /// Synthetic image under test: SOI + APP0(JFIF) + EOI, a real file on disk.\n93: const List<int> _kSyntheticJpeg = <int>[\n94:   0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46, 0x00, 0x01,\n95:   0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0xFF, 0xD9,\n96: ];\n97: \n98: /// Non-2xx callable/REST outcome from an emulator endpoint.\n99: final class _Refusal implements Exception {\n100:   const _Refusal(this.status, this.body);\n101:   final int status;\n102:   final String body;\n103: \n104:   @override\n105:   String toString() => 'emulator refused (HTTP $status): $body';\n106: }\n107: \n108: /// Speaks the real callable wire envelope (`{\"data\": ...}`) to the Functions\n109: /// emulator over HTTP. The `firebase_functions` MethodChannel has no host\n110: /// implementation under `flutter test`, so the emulator is driven through\n111: /// `package:http` with the identical request/response format instead.\n112: Future<Object?> _callFunction(\n113:   String name,\n114:   Map<String, Object?> data,\n115: ) async {\n116:   final Uri uri = Uri.parse('$_kFunctionsBase/$_kProject/$_kRegion/$name');\n117:   final http.Response response = await http\n118:       .post(\n119:         uri,\n120:         headers: <String, String>{'Content-Type': 'application/json'},\n121:         body: jsonEncode(<String, Object?>{'data': data}),\n122:       )\n123:       .timeout(_kHttpTimeout);\n124:   if (response.statusCode != 200) {\n125:     throw _Refusal(response.statusCode, response.body);\n126:   }\n127:   final Object? decoded = jsonDecode(response.body);\n128:   if (decoded is Map<String, Object?> && decoded.containsKey('result')) {\n129:     return decoded['result'];\n130:   }\n131:   return decoded;\n132: }\n133: \n134: /// [GuestMediaCallableInvoker] over the Functions emulator callable envelope.\n135: final class _EmulatorInvoker implements GuestMediaCallableInvoker {\n136:   _EmulatorInvoker(this._call);\n137:   final Future<Object?> Function(\n138:     String name,\n139:     Map<String, Object?> payload,\n140:   ) _call;\n141:   int calls = 0;\n142: \n143:   @override\n144:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n145:     calls++;\n146:     return _call(name, payload);\n147:   }\n148: }\n149: \n150: /// Counts transport use while delegating to the real [HttpGuestMediaTransport].\n151: final class _CountingTransport implements GuestMediaTransport {\n152:   _CountingTransport(this._inner);\n153:   final HttpGuestMediaTransport _inner;\n154:   int puts = 0;\n155: \n156:   @override\n157:   Future<void> put(Uri uri, File file, String contentType) async {\n158:     puts++;\n159:     await _inner.put(uri, file, contentType);\n160:   }\n161: }\n162: \n163: Future<bool> _emulatorsReachable() async {\n164:   try {\n165:     final http.Response response = await http\n166:         .get(\n167:           Uri.parse(\n168:             '$_kFirestoreBase/v1/projects/$_kProject/'\n169:             'databases/(default)/documents/parties/probe-readiness-check',\n170:           ),\n171:         )\n172:         .timeout(const Duration(seconds: 5));\n173:     // 403 (rules-deny on direct reads) or 404 both prove a live emulator.\n174:     return response.statusCode == 403 || response.statusCode == 404;\n175:   } on Object {\n176:     return false;\n177:   }\n178: }\n179: \n180: Future<Map<String, Object?>> _firestoreGet(String documentPath) async {\n181:   final http.Response response = await http\n182:       .get(\n183:         Uri.parse(\n184:           '$_kFirestoreBase/v1/projects/$_kProject/'\n185:           'databases/(default)/documents/$documentPath',\n186:         ),\n187:       )\n188:       .timeout(_kHttpTimeout);\n189:   if (response.statusCode != 200) {\n190:     throw _Refusal(response.statusCode, response.body);\n191:   }\n192:   final Object? decoded = jsonDecode(response.body);\n193:   if (decoded is! Map<String, Object?>) {\n194:     throw const FormatException('Firestore document is not a JSON object');\n195:   }\n196:   return decoded;\n197: }\n198: \n199: String _stringField(Map<String, Object?> fields, String name) {\n200:   final Object? field = fields[name];\n201:   if (field is Map<String, Object?> && field['stringValue'] is String) {\n202:     return field['stringValue'] as String;\n203:   }\n204:   throw FormatException('Firestore field $name is not a string: $field');\n205: }\n206: \n207: void main() {\n208:   test(\n209:     'guest photo positive flow against emulators: consent-gated capability, '\n210:     'signed PUT attempt reaches the Storage stage (501 emulator gap)',\n211:     timeout: const Timeout(Duration(minutes: 4)),\n212:     () async {\n213:       if (!await _emulatorsReachable()) {\n214:         markTestSkipped(\n215:           'Firebase emulators are not reachable on 127.0.0.1 '\n216:           '(firestore :8080). From backend/ run: '\n217:           'GOOGLE_APPLICATION_CREDENTIALS=/tmp/fake-sa.json '\n218:           'STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase '\n219:           '--config firebase.json emulators:start '\n220:           '--only firestore,functions,storage '\n221:           '--project demo-halloween-tv',\n222:         );\n223:       }\n224: \n225:       SharedPreferences.setMockInitialValues(<String, Object>{});\n226:       final SharedPreferences prefs = await SharedPreferences.getInstance();\n227: \n228:       // Fixed party pre-seeded with the Admin SDK (client REST cannot\n229:       // create it: rules deny all direct writes). Pre-seed with:\n230:       //   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080\n231:       //   STORAGE_EMULATOR_HOST=http://127.0.0.1:9199\n232:       //   node /tmp/seed-guest-photo.js\n233:       // (wipes and recreates parties/guest-photo-it + its cctv channel;\n234:       // the device below is left for joinParty to register).\n235:       const String partyId = 'guest-photo-it';\n236:       const String channelId = 'cctv';\n237:       const String deviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n238:       Map<String, Object?> identity() => <String, Object?>{\n239:         'partyId': partyId,\n240:         'deviceId': deviceId,\n241:         'channelId': channelId,\n242:       };\n243: \n244:       final _EmulatorInvoker invoker = _EmulatorInvoker(_callFunction);\n245:       final _CountingTransport transport = _CountingTransport(\n246:         HttpGuestMediaTransport(),\n247:       );\n248:       final GuestMediaClient client = GuestMediaClient(\n249:         invoker: invoker,\n250:         transport: transport,\n251:       );\n252:       final Directory dir = await Directory.systemTemp.createTemp(\n253:         'guest-photo-it-',\n254:       );\n255:       try {\n256:         // Synthetic image: minimal JPEG container bytes, real file on disk.\n257:         final File photo = File('${dir.path}/synthetic.jpg');\n258:         await photo.writeAsBytes(_kSyntheticJpeg);\n259:         final GuestMediaSession session = GuestMediaSession(\n260:           client: client,\n261:           partyId: partyId,\n262:           deviceId: deviceId,\n263:           channelId: channelId,\n264:           preferences: () async => prefs,\n265:           tempDirectory: () async => dir,\n266:         );\n267: \n268:         // 1. Consent gate holds before any network: no capability call.\n269:         await expectLater(\n270:           client.requestUpload(\n271:             partyId: partyId,\n272:             deviceId: deviceId,\n273:             channelId: channelId,\n274:             contentType: 'image/jpeg',\n275:             byteSize: _kSyntheticJpeg.length,\n276:             affirmativeConsent: false,\n277:           ),\n278:           throwsStateError,\n279:         );\n280:         expect(invoker.calls, 0, reason: 'refused before the network');\n281:         await expectLater(\n282:           session.submit(photo, consent: false, confirmed: true),\n283:           throwsStateError,\n284:         );\n285:         expect(invoker.calls, 0, reason: 'refused before the network');\n286: \n287:         // 2. Server-side consent gate: a non-affirmative consent object is\n288:         // refused by the real backend before any capability is minted.\n289:         Object? consentError;\n290:         try {\n291:           await _callFunction('requestGuestUpload', <String, Object?>{\n292:             ...identity(),\n293:             'consent': <String, Object?>{\n294:               'accepted': false,\n295:               'textVersion': _kConsentTextVersion,\n296:               'purpose': _kConsentPurpose,\n297:             },\n298:             'contentType': 'image/jpeg',\n299:           });\n300:         } on _Refusal catch (error) {\n301:           consentError = error;\n302:         }\n303:         expect(\n304:           consentError,\n305:           isA<_Refusal>(),\n306:           reason: 'non-affirmative consent must be refused server-side',\n307:         );\n308:         expect(\n309:           (consentError as _Refusal).body,\n310:           contains('FORBIDDEN'),\n311:           reason: 'refusal carries the backend FORBIDDEN error code',\n312:         );\n313: \n314:         // 3. Real registration path: joinParty creates the guest device doc.\n315:         final Object? joined = await _callFunction('joinParty', identity());\n316:         expect(joined, isA<Map<String, Object?>>());\n317:         final Map<String, Object?> joinedResult =\n318:             joined! as Map<String, Object?>;\n319:         expect(\n320:           joinedResult['created'],\n321:           isTrue,\n322:           reason: 'first join registers the guest device',\n323:         );\n324:         final Map<String, Object?> deviceDoc = await _firestoreGet(\n325:           'parties/$partyId/devices/$deviceId',\n326:         );\n327:         final Map<String, Object?> deviceFields =\n328:             deviceDoc['fields'] as Map<String, Object?>;\n329:         expect(_stringField(deviceFields, 'deviceId'), deviceId);\n330:         expect(_stringField(deviceFields, 'role'), 'guest');\n331:         expect(_stringField(deviceFields, 'status'), 'active');\n332: \n333:         // 4. Consent-gated capability issue: the real backend mints a\n334:         // per-submission signed PUT capability bound to a server-assigned\n335:         // object path.\n336:         final Object? capabilityRaw =\n337:             await _callFunction('requestGuestUpload', <String, Object?>{\n338:               ...identity(),\n339:               'consent': <String, Object?>{\n340:                 'accepted': true,\n341:                 'textVersion': _kConsentTextVersion,\n342:                 'purpose': _kConsentPurpose,\n343:               },\n344:               'contentType': 'image/jpeg',\n345:             });\n346:         expect(capabilityRaw, isA<Map<String, Object?>>());\n347:         final Map<String, Object?> capability =\n348:             capabilityRaw! as Map<String, Object?>;\n349:         final String submissionId = capability['submissionId'] as String;\n350:         expect(\n351:           submissionId,\n352:           matches(RegExp(r'^gsub-[a-f0-9]{32}$')),\n353:           reason: 'server-assigned submission id shape',\n354:         );\n355:         final String objectPath = capability['objectPath'] as String;\n356:         expect(\n357:           objectPath,\n358:           'parties/$partyId/guests/$deviceId/ingest/$submissionId/photo.jpg',\n359:           reason: 'capability is bound to the server-assigned object path',\n360:         );\n361:         final String uploadUrl = capability['uploadUrl'] as String;\n362:         expect(uploadUrl, isNotEmpty);\n363:         expect(\n364:           uploadUrl,\n365:           contains(objectPath),\n366:           reason: 'signed PUT URL is per-submission, never persisted',\n367:         );\n368:         final DateTime expiresAt = DateTime.parse(\n369:           capability['expiresAt'] as String,\n370:         );\n371:         expect(\n372:           expiresAt.isAfter(DateTime.now().toUtc()),\n373:           isTrue,\n374:           reason: 'capability carries a future expiry',\n375:         );\n376:         final String consentRevision =\n377:             capability['consentRevision'] as String;\n378:         expect(\n379:           consentRevision,\n380:           startsWith('$_kConsentTextVersion:'),\n381:           reason: 'capability echoes the server-side consent revision',\n382:         );\n383: \n384:         // 5. Signed PUT of the synthetic image through the real transport.\n385:         // The backend validated these exact bytes before any eligibility;\n386:         // the Storage emulator has no XML-API PUT route and answers 501.\n387:         // Asserting the 501 (not an earlier failure) proves the flow\n388:         // reaches the signed-PUT stage with a well-formed capability.\n389:         Object? putError;\n390:         try {\n391:           await transport.put(Uri.parse(uploadUrl), photo, 'image/jpeg');\n392:         } on StateError catch (error) {\n393:           putError = error;\n394:         }\n395:         expect(transport.puts, 1, reason: 'exactly one PUT to the capability');\n396:         expect(\n397:           putError,\n398:           isNotNull,\n399:           reason: 'Storage emulator has no PUT route (expected HTTP 501)',\n400:         );\n401:         expect(\n402:           '$putError',\n403:           contains('501'),\n404:           reason: 'refusal is the Storage emulator gap, not a contract error',\n405:         );\n406:         // Completion, status, withdrawal, object absence, and generation\n407:         // refusal are pinned by backend tests plus unit fakes mirroring the\n408:         // exact envelope documented at the top of this file.\n409:       } finally {\n410:         await dir.delete(recursive: true);\n411:       }\n412:     },\n413:   );\n414: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/guest_photo_emulator_test.dart, lines 1-414\n1: // Guest-photo positive completion flow (host-run integration).\n2: //\n3: // Runs the REAL companion guest-media stack ([GuestMediaClient] consent\n4: // gate and [HttpGuestMediaTransport] byte upload) against the REAL Firebase\n5: // emulators (Functions/Firestore/Storage on the `backend/firebase.json`\n6: // ports) and the REAL guest-media callables\n7: // (requestGuestUpload/completeGuestUpload/getGuestMediaStatus/\n8: // withdrawGuestMedia in `backend/functions/src/index.ts`). No billable\n9: // calls: the emulators are local and generation stays disabled there.\n10: //\n11: // Backend contract under test (2026-10-30, from\n12: // `backend/functions/src/guest_upload.ts` + `contracts.ts`):\n13: //   requestGuestUpload  {partyId, deviceId, channelId,\n14: //                        consent:{accepted:true,textVersion:\"v1\",\n15: //                                purpose:\"guest_cameo\"},\n16: //                        contentType:\"image/jpeg\"|\"image/png\"}\n17: //                     -> {submissionId, objectPath, uploadUrl, expiresAt,\n18: //                         consentRevision}   // NO contentType echo\n19: //   completeGuestUpload {partyId, deviceId, channelId, submissionId}\n20: //                     -> {submissionId, partyId, deviceId, channelId,\n21: //                         status:\"eligible\", objectPath, consentRevision,\n22: //                         expiresAt, sha256, sizeBytes}\n23: //   getGuestMediaStatus {partyId, deviceId, channelId, submissionId}\n24: //                     -> same shape, status pending_upload|eligible|\n25: //                        withdrawn|expired\n26: //   withdrawGuestMedia  {partyId, deviceId, channelId, submissionId}\n27: //                     -> {submissionId, status:\"withdrawn\",\n28: //                         deletedObjects, verifiedAbsent:true}\n29: //\n30: // STORAGE EMULATOR GAP (pinned, not a product bug): the Functions emulator\n31: // signs an http upload URL whose host the client correctly rejects, and the\n32: // direct Storage-emulator PUT route answers HTTP 501 (no XML-API PUT\n33: // upload). So this test drives capability issuance through the real backend\n34: // (asserted in full below) and then drives the real transport PUT, which is\n35: // EXPECTED to fail with HTTP 501 — proving the flow reaches the signed-PUT\n36: // stage (not an earlier contract failure). Completion, status, withdrawal,\n37: // absence, and generation refusal are pinned end to end by backend tests and\n38: // by unit fakes that mirror the exact envelope above (see\n39: // test/guest_media_client_test.dart + test/guest_media_session_test.dart).\n40: //\n41: // NOTE: the in-app [GuestMediaClient]/[GuestMediaSession] request envelope\n42: // matches this contract (channelId + consent:{accepted:true,\n43: // textVersion:\"v1\", purpose:\"guest_cameo\"} named constants). The happy path\n44: // below still drives the real callable wire envelope (`{\"data\": ...}`,\n45: // identical to what `firebase_functions` sends) directly for the\n46: // capability mint (the client validates https-only URLs while the emulator\n47: // signs http URLs), while the consent gate and the byte PUT still go\n48: // through the real client/transport classes. The assertions are\n49: // falsifiable end to end: capability -> signed PUT -> complete(eligible,\n50: // backend-computed sha256/sizeBytes) -> status -> withdraw -> object\n51: // absence -> refusal of later use from the guest path.\n52: //\n53: // Emulators must be running before this file runs (from `backend/`).\n54: // Capability minting needs a local signing key (the Functions emulator\n55: // has no ADC private key, so getSignedUrl would return INTERNAL):\n56: //   GOOGLE_APPLICATION_CREDENTIALS=/tmp/fake-sa.json\n57: //   STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase\n58: //     --config firebase.json emulators:start\n59: //     --only firestore,functions,storage --project demo-halloween-tv\n60: // and the fixed party must be pre-seeded with the Admin SDK (client REST\n61: // cannot create it: firestore.rules deny all direct writes):\n62: //   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080\n63: //   STORAGE_EMULATOR_HOST=http://127.0.0.1:9199 node /tmp/seed-guest-photo.js\n64: // (wipes parties/guest-photo-it in Firestore AND Storage, recreates the\n65: // party + its cctv channel; the device is left for joinParty to create).\n66: // If the emulators are unreachable the test SKIPS (never fake-passes).\n67: //\n68: // Run serially from `apps/companion_app`:\n69: //   flutter test --concurrency=1 integration_test/guest_photo_emulator_test.dart\n70: library;\n71: \n72: import 'dart:convert';\n73: import 'dart:io';\n74: \n75: import 'package:companion_app/src/data/guest_media_client.dart';\n76: import 'package:companion_app/src/session/guest_media_session.dart';\n77: import 'package:flutter_test/flutter_test.dart';\n78: import 'package:http/http.dart' as http;\n79: import 'package:shared_preferences/shared_preferences.dart';\n80: \n81: const String _kProject = 'demo-halloween-tv';\n82: const String _kRegion = 'us-central1';\n83: const String _kFunctionsBase = 'http://127.0.0.1:5001';\n84: const String _kFirestoreBase = 'http://127.0.0.1:8080';\n85: const Duration _kHttpTimeout = Duration(seconds: 20);\n86: \n87: /// Server-side consent constants (pinned to backend/functions/src/config.ts\n88: /// -> GUEST_CONSENT_TEXT_VERSION / GUEST_CONSENT_PURPOSE).\n89: const String _kConsentTextVersion = 'v1';\n90: const String _kConsentPurpose = 'guest_cameo';\n91: \n92: /// Synthetic image under test: SOI + APP0(JFIF) + EOI, a real file on disk.\n93: const List<int> _kSyntheticJpeg = <int>[\n94:   0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46, 0x00, 0x01,\n95:   0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0xFF, 0xD9,\n96: ];\n97: \n98: /// Non-2xx callable/REST outcome from an emulator endpoint.\n99: final class _Refusal implements Exception {\n100:   const _Refusal(this.status, this.body);\n101:   final int status;\n102:   final String body;\n103: \n104:   @override\n105:   String toString() => 'emulator refused (HTTP $status): $body';\n106: }\n107: \n108: /// Speaks the real callable wire envelope (`{\"data\": ...}`) to the Functions\n109: /// emulator over HTTP. The `firebase_functions` MethodChannel has no host\n110: /// implementation under `flutter test`, so the emulator is driven through\n111: /// `package:http` with the identical request/response format instead.\n112: Future<Object?> _callFunction(\n113:   String name,\n114:   Map<String, Object?> data,\n115: ) async {\n116:   final Uri uri = Uri.parse('$_kFunctionsBase/$_kProject/$_kRegion/$name');\n117:   final http.Response response = await http\n118:       .post(\n119:         uri,\n120:         headers: <String, String>{'Content-Type': 'application/json'},\n121:         body: jsonEncode(<String, Object?>{'data': data}),\n122:       )\n123:       .timeout(_kHttpTimeout);\n124:   if (response.statusCode != 200) {\n125:     throw _Refusal(response.statusCode, response.body);\n126:   }\n127:   final Object? decoded = jsonDecode(response.body);\n128:   if (decoded is Map<String, Object?> && decoded.containsKey('result')) {\n129:     return decoded['result'];\n130:   }\n131:   return decoded;\n132: }\n133: \n134: /// [GuestMediaCallableInvoker] over the Functions emulator callable envelope.\n135: final class _EmulatorInvoker implements GuestMediaCallableInvoker {\n136:   _EmulatorInvoker(this._call);\n137:   final Future<Object?> Function(\n138:     String name,\n139:     Map<String, Object?> payload,\n140:   ) _call;\n141:   int calls = 0;\n142: \n143:   @override\n144:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n145:     calls++;\n146:     return _call(name, payload);\n147:   }\n148: }\n149: \n150: /// Counts transport use while delegating to the real [HttpGuestMediaTransport].\n151: final class _CountingTransport implements GuestMediaTransport {\n152:   _CountingTransport(this._inner);\n153:   final HttpGuestMediaTransport _inner;\n154:   int puts = 0;\n155: \n156:   @override\n157:   Future<void> put(Uri uri, File file, String contentType) async {\n158:     puts++;\n159:     await _inner.put(uri, file, contentType);\n160:   }\n161: }\n162: \n163: Future<bool> _emulatorsReachable() async {\n164:   try {\n165:     final http.Response response = await http\n166:         .get(\n167:           Uri.parse(\n168:             '$_kFirestoreBase/v1/projects/$_kProject/'\n169:             'databases/(default)/documents/parties/probe-readiness-check',\n170:           ),\n171:         )\n172:         .timeout(const Duration(seconds: 5));\n173:     // 403 (rules-deny on direct reads) or 404 both prove a live emulator.\n174:     return response.statusCode == 403 || response.statusCode == 404;\n175:   } on Object {\n176:     return false;\n177:   }\n178: }\n179: \n180: Future<Map<String, Object?>> _firestoreGet(String documentPath) async {\n181:   final http.Response response = await http\n182:       .get(\n183:         Uri.parse(\n184:           '$_kFirestoreBase/v1/projects/$_kProject/'\n185:           'databases/(default)/documents/$documentPath',\n186:         ),\n187:       )\n188:       .timeout(_kHttpTimeout);\n189:   if (response.statusCode != 200) {\n190:     throw _Refusal(response.statusCode, response.body);\n191:   }\n192:   final Object? decoded = jsonDecode(response.body);\n193:   if (decoded is! Map<String, Object?>) {\n194:     throw const FormatException('Firestore document is not a JSON object');\n195:   }\n196:   return decoded;\n197: }\n198: \n199: String _stringField(Map<String, Object?> fields, String name) {\n200:   final Object? field = fields[name];\n201:   if (field is Map<String, Object?> && field['stringValue'] is String) {\n202:     return field['stringValue'] as String;\n203:   }\n204:   throw FormatException('Firestore field $name is not a string: $field');\n205: }\n206: \n207: void main() {\n208:   test(\n209:     'guest photo positive flow against emulators: consent-gated capability, '\n210:     'signed PUT attempt reaches the Storage stage (501 emulator gap)',\n211:     timeout: const Timeout(Duration(minutes: 4)),\n212:     () async {\n213:       if (!await _emulatorsReachable()) {\n214:         markTestSkipped(\n215:           'Firebase emulators are not reachable on 127.0.0.1 '\n216:           '(firestore :8080). From backend/ run: '\n217:           'GOOGLE_APPLICATION_CREDENTIALS=/tmp/fake-sa.json '\n218:           'STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase '\n219:           '--config firebase.json emulators:start '\n220:           '--only firestore,functions,storage '\n221:           '--project demo-halloween-tv',\n222:         );\n223:       }\n224: \n225:       SharedPreferences.setMockInitialValues(<String, Object>{});\n226:       final SharedPreferences prefs = await SharedPreferences.getInstance();\n227: \n228:       // Fixed party pre-seeded with the Admin SDK (client REST cannot\n229:       // create it: rules deny all direct writes). Pre-seed with:\n230:       //   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080\n231:       //   STORAGE_EMULATOR_HOST=http://127.0.0.1:9199\n232:       //   node /tmp/seed-guest-photo.js\n233:       // (wipes and recreates parties/guest-photo-it + its cctv channel;\n234:       // the device below is left for joinParty to register).\n235:       const String partyId = 'guest-photo-it';\n236:       const String channelId = 'cctv';\n237:       const String deviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n238:       Map<String, Object?> identity() => <String, Object?>{\n239:         'partyId': partyId,\n240:         'deviceId': deviceId,\n241:         'channelId': channelId,\n242:       };\n243: \n244:       final _EmulatorInvoker invoker = _EmulatorInvoker(_callFunction);\n245:       final _CountingTransport transport = _CountingTransport(\n246:         HttpGuestMediaTransport(),\n247:       );\n248:       final GuestMediaClient client = GuestMediaClient(\n249:         invoker: invoker,\n250:         transport: transport,\n251:       );\n252:       final Directory dir = await Directory.systemTemp.createTemp(\n253:         'guest-photo-it-',\n254:       );\n255:       try {\n256:         // Synthetic image: minimal JPEG container bytes, real file on disk.\n257:         final File photo = File('${dir.path}/synthetic.jpg');\n258:         await photo.writeAsBytes(_kSyntheticJpeg);\n259:         final GuestMediaSession session = GuestMediaSession(\n260:           client: client,\n261:           partyId: partyId,\n262:           deviceId: deviceId,\n263:           channelId: channelId,\n264:           preferences: () async => prefs,\n265:           tempDirectory: () async => dir,\n266:         );\n267: \n268:         // 1. Consent gate holds before any network: no capability call.\n269:         await expectLater(\n270:           client.requestUpload(\n271:             partyId: partyId,\n272:             deviceId: deviceId,\n273:             channelId: channelId,\n274:             contentType: 'image/jpeg',\n275:             byteSize: _kSyntheticJpeg.length,\n276:             affirmativeConsent: false,\n277:           ),\n278:           throwsStateError,\n279:         );\n280:         expect(invoker.calls, 0, reason: 'refused before the network');\n281:         await expectLater(\n282:           session.submit(photo, consent: false, confirmed: true),\n283:           throwsStateError,\n284:         );\n285:         expect(invoker.calls, 0, reason: 'refused before the network');\n286: \n287:         // 2. Server-side consent gate: a non-affirmative consent object is\n288:         // refused by the real backend before any capability is minted.\n289:         Object? consentError;\n290:         try {\n291:           await _callFunction('requestGuestUpload', <String, Object?>{\n292:             ...identity(),\n293:             'consent': <String, Object?>{\n294:               'accepted': false,\n295:               'textVersion': _kConsentTextVersion,\n296:               'purpose': _kConsentPurpose,\n297:             },\n298:             'contentType': 'image/jpeg',\n299:           });\n300:         } on _Refusal catch (error) {\n301:           consentError = error;\n302:         }\n303:         expect(\n304:           consentError,\n305:           isA<_Refusal>(),\n306:           reason: 'non-affirmative consent must be refused server-side',\n307:         );\n308:         expect(\n309:           (consentError as _Refusal).body,\n310:           contains('FORBIDDEN'),\n311:           reason: 'refusal carries the backend FORBIDDEN error code',\n312:         );\n313: \n314:         // 3. Real registration path: joinParty creates the guest device doc.\n315:         final Object? joined = await _callFunction('joinParty', identity());\n316:         expect(joined, isA<Map<String, Object?>>());\n317:         final Map<String, Object?> joinedResult =\n318:             joined! as Map<String, Object?>;\n319:         expect(\n320:           joinedResult['created'],\n321:           isTrue,\n322:           reason: 'first join registers the guest device',\n323:         );\n324:         final Map<String, Object?> deviceDoc = await _firestoreGet(\n325:           'parties/$partyId/devices/$deviceId',\n326:         );\n327:         final Map<String, Object?> deviceFields =\n328:             deviceDoc['fields'] as Map<String, Object?>;\n329:         expect(_stringField(deviceFields, 'deviceId'), deviceId);\n330:         expect(_stringField(deviceFields, 'role'), 'guest');\n331:         expect(_stringField(deviceFields, 'status'), 'active');\n332: \n333:         // 4. Consent-gated capability issue: the real backend mints a\n334:         // per-submission signed PUT capability bound to a server-assigned\n335:         // object path.\n336:         final Object? capabilityRaw =\n337:             await _callFunction('requestGuestUpload', <String, Object?>{\n338:               ...identity(),\n339:               'consent': <String, Object?>{\n340:                 'accepted': true,\n341:                 'textVersion': _kConsentTextVersion,\n342:                 'purpose': _kConsentPurpose,\n343:               },\n344:               'contentType': 'image/jpeg',\n345:             });\n346:         expect(capabilityRaw, isA<Map<String, Object?>>());\n347:         final Map<String, Object?> capability =\n348:             capabilityRaw! as Map<String, Object?>;\n349:         final String submissionId = capability['submissionId'] as String;\n350:         expect(\n351:           submissionId,\n352:           matches(RegExp(r'^gsub-[a-f0-9]{32}$')),\n353:           reason: 'server-assigned submission id shape',\n354:         );\n355:         final String objectPath = capability['objectPath'] as String;\n356:         expect(\n357:           objectPath,\n358:           'parties/$partyId/guests/$deviceId/ingest/$submissionId/photo.jpg',\n359:           reason: 'capability is bound to the server-assigned object path',\n360:         );\n361:         final String uploadUrl = capability['uploadUrl'] as String;\n362:         expect(uploadUrl, isNotEmpty);\n363:         expect(\n364:           uploadUrl,\n365:           contains(objectPath),\n366:           reason: 'signed PUT URL is per-submission, never persisted',\n367:         );\n368:         final DateTime expiresAt = DateTime.parse(\n369:           capability['expiresAt'] as String,\n370:         );\n371:         expect(\n372:           expiresAt.isAfter(DateTime.now().toUtc()),\n373:           isTrue,\n374:           reason: 'capability carries a future expiry',\n375:         );\n376:         final String consentRevision =\n377:             capability['consentRevision'] as String;\n378:         expect(\n379:           consentRevision,\n380:           startsWith('$_kConsentTextVersion:'),\n381:           reason: 'capability echoes the server-side consent revision',\n382:         );\n383: \n384:         // 5. Signed PUT of the synthetic image through the real transport.\n385:         // The backend validated these exact bytes before any eligibility;\n386:         // the Storage emulator has no XML-API PUT route and answers 501.\n387:         // Asserting the 501 (not an earlier failure) proves the flow\n388:         // reaches the signed-PUT stage with a well-formed capability.\n389:         Object? putError;\n390:         try {\n391:           await transport.put(Uri.parse(uploadUrl), photo, 'image/jpeg');\n392:         } on StateError catch (error) {\n393:           putError = error;\n394:         }\n395:         expect(transport.puts, 1, reason: 'exactly one PUT to the capability');\n396:         expect(\n397:           putError,\n398:           isNotNull,\n399:           reason: 'Storage emulator has no PUT route (expected HTTP 501)',\n400:         );\n401:         expect(\n402:           '$putError',\n403:           contains('501'),\n404:           reason: 'refusal is the Storage emulator gap, not a contract error',\n405:         );\n406:         // Completion, status, withdrawal, object absence, and generation\n407:         // refusal are pinned by backend tests plus unit fakes mirroring the\n408:         // exact envelope documented at the top of this file.\n409:       } finally {\n410:         await dir.delete(recursive: true);\n411:       }\n412:     },\n413:   );\n414: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5f7d2763eb07ca203000c608d"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/guest_photo_emulator_test.dart\"}"},"time":{"start":1793461713075,"end":1793461713305}}}}
{"type":"tool_use","timestamp":1793461713307,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5f8b10012WMd8HwC4b3TDK","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5f138001MgqfDqvWOLjcM7","type":"tool","id":"call_01a192a5f652761e9005d3cad42d3fb8","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session_state.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session_state.dart, lines 1-124\n1: /// Explicit lifecycle states for the anonymous guest session.\n2: ///\n3: /// The session moves through these states only; there is no implicit\n4: /// \"connected\" flag. `stale` doubles as the offline marker: last-known\n5: /// metadata is retained in memory and labeled stale after transient\n6: /// failures or suspension, while a cold offline start (no manifest yet)\n7: /// surfaces as [GuestSessionStatus.unavailable] with no fabricated data.\n8: library;\n9: \n10: import 'package:companion_app/src/join/guest_join_data.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: \n13: /// Lifecycle status of [GuestSessionState].\n14: enum GuestSessionStatus {\n15:   /// No identity bound; no subscription active.\n16:   idle,\n17: \n18:   /// Waiting for the first (or next fresh) scoped manifest response.\n19:   loading,\n20: \n21:   /// A valid scoped manifest is current.\n22:   ready,\n23: \n24:   /// Stale/offline: last-known manifest retained after a transient failure\n25:   /// or suspension; never used for a cold start.\n26:   stale,\n27: \n28:   /// Cold start with no manifest and no usable transport (offline on first\n29:   /// read). Carries no fabricated manifest.\n30:   unavailable,\n31: \n32:   /// Server rejected the binding (`FORBIDDEN`/`UNAUTHENTICATED`).\n33:   /// Inaccessible data has been cleared.\n34:   denied,\n35: \n36:   /// Server reported expiry (`CLIP_EXPIRED`). Never labeled current.\n37:   expired,\n38: \n39:   /// The transport delivered unscoped or malformed data.\n40:   invalidData,\n41: }\n42: \n43: /// Immutable snapshot of the guest session.\n44: final class GuestSessionState {\n45:   /// Current lifecycle status.\n46:   final GuestSessionStatus status;\n47: \n48:   /// Bound anonymous identity, or `null` after [GuestSessionStatus.idle].\n49:   final GuestJoinData? join;\n50: \n51:   /// Last-known manifest. Non-null only in [GuestSessionStatus.ready] and\n52:   /// [GuestSessionStatus.stale]; every other status carries `null`.\n53:   final PlaybackManifest? manifest;\n54: \n55:   /// Human-readable detail for the current status (never executable).\n56:   final String? message;\n57: \n58:   /// Time of the last successful scoped manifest observation, recorded via\n59:   /// the injected [Clock]. Updated even when the observed version is\n60:   /// unchanged. `null` until the first success and after leave.\n61:   final DateTime? lastSuccessfulCheck;\n62: \n63:   const GuestSessionState({\n64:     required this.status,\n65:     this.join,\n66:     this.manifest,\n67:     this.message,\n68:     this.lastSuccessfulCheck,\n69:   });\n70: \n71:   /// Idle snapshot with no identity, metadata, or timestamps.\n72:   const GuestSessionState.idle() : this(status: GuestSessionStatus.idle);\n73: \n74:   /// Returns a copy with the given fields replaced.\n75:   GuestSessionState copyWith({\n76:     GuestSessionStatus? status,\n77:     GuestJoinData? join,\n78:     PlaybackManifest? manifest,\n79:     String? message,\n80:     DateTime? lastSuccessfulCheck,\n81:     bool clearJoin = false,\n82:     bool clearManifest = false,\n83:     bool clearMessage = false,\n84:     bool clearLastSuccessfulCheck = false,\n85:   }) {\n86:     return GuestSessionState(\n87:       status: status ?? this.status,\n88:       join: clearJoin ? null : (join ?? this.join),\n89:       manifest: clearManifest ? null : (manifest ?? this.manifest),\n90:       message: clearMessage ? null : (message ?? this.message),\n91:       lastSuccessfulCheck: clearLastSuccessfulCheck\n92:           ? null\n93:           : (lastSuccessfulCheck ?? this.lastSuccessfulCheck),\n94:     );\n95:   }\n96: \n97:   /// True when a current manifest is available.\n98:   bool get isReady => status == GuestSessionStatus.ready && manifest != null;\n99: \n100:   /// True when showing retained last-known metadata while offline.\n101:   bool get isStale => status == GuestSessionStatus.stale && manifest != null;\n102: \n103:   @override\n104:   bool operator ==(Object other) {\n105:     if (identical(this, other)) {\n106:       return true;\n107:     }\n108:     return other is GuestSessionState &&\n109:         other.status == status &&\n110:         other.join == join &&\n111:         other.manifest == manifest &&\n112:         other.message == message &&\n113:         other.lastSuccessfulCheck == lastSuccessfulCheck;\n114:   }\n115: \n116:   @override\n117:   int get hashCode =>\n118:       Object.hash(status, join, manifest, message, lastSuccessfulCheck);\n119: \n120:   @override\n121:   String toString() =>\n122:       'GuestSessionState($status, manifest: ${manifest?.version}, '\n123:       'checked: $lastSuccessfulCheck)';\n124: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session_state.dart, lines 1-124\n1: /// Explicit lifecycle states for the anonymous guest session.\n2: ///\n3: /// The session moves through these states only; there is no implicit\n4: /// \"connected\" flag. `stale` doubles as the offline marker: last-known\n5: /// metadata is retained in memory and labeled stale after transient\n6: /// failures or suspension, while a cold offline start (no manifest yet)\n7: /// surfaces as [GuestSessionStatus.unavailable] with no fabricated data.\n8: library;\n9: \n10: import 'package:companion_app/src/join/guest_join_data.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: \n13: /// Lifecycle status of [GuestSessionState].\n14: enum GuestSessionStatus {\n15:   /// No identity bound; no subscription active.\n16:   idle,\n17: \n18:   /// Waiting for the first (or next fresh) scoped manifest response.\n19:   loading,\n20: \n21:   /// A valid scoped manifest is current.\n22:   ready,\n23: \n24:   /// Stale/offline: last-known manifest retained after a transient failure\n25:   /// or suspension; never used for a cold start.\n26:   stale,\n27: \n28:   /// Cold start with no manifest and no usable transport (offline on first\n29:   /// read). Carries no fabricated manifest.\n30:   unavailable,\n31: \n32:   /// Server rejected the binding (`FORBIDDEN`/`UNAUTHENTICATED`).\n33:   /// Inaccessible data has been cleared.\n34:   denied,\n35: \n36:   /// Server reported expiry (`CLIP_EXPIRED`). Never labeled current.\n37:   expired,\n38: \n39:   /// The transport delivered unscoped or malformed data.\n40:   invalidData,\n41: }\n42: \n43: /// Immutable snapshot of the guest session.\n44: final class GuestSessionState {\n45:   /// Current lifecycle status.\n46:   final GuestSessionStatus status;\n47: \n48:   /// Bound anonymous identity, or `null` after [GuestSessionStatus.idle].\n49:   final GuestJoinData? join;\n50: \n51:   /// Last-known manifest. Non-null only in [GuestSessionStatus.ready] and\n52:   /// [GuestSessionStatus.stale]; every other status carries `null`.\n53:   final PlaybackManifest? manifest;\n54: \n55:   /// Human-readable detail for the current status (never executable).\n56:   final String? message;\n57: \n58:   /// Time of the last successful scoped manifest observation, recorded via\n59:   /// the injected [Clock]. Updated even when the observed version is\n60:   /// unchanged. `null` until the first success and after leave.\n61:   final DateTime? lastSuccessfulCheck;\n62: \n63:   const GuestSessionState({\n64:     required this.status,\n65:     this.join,\n66:     this.manifest,\n67:     this.message,\n68:     this.lastSuccessfulCheck,\n69:   });\n70: \n71:   /// Idle snapshot with no identity, metadata, or timestamps.\n72:   const GuestSessionState.idle() : this(status: GuestSessionStatus.idle);\n73: \n74:   /// Returns a copy with the given fields replaced.\n75:   GuestSessionState copyWith({\n76:     GuestSessionStatus? status,\n77:     GuestJoinData? join,\n78:     PlaybackManifest? manifest,\n79:     String? message,\n80:     DateTime? lastSuccessfulCheck,\n81:     bool clearJoin = false,\n82:     bool clearManifest = false,\n83:     bool clearMessage = false,\n84:     bool clearLastSuccessfulCheck = false,\n85:   }) {\n86:     return GuestSessionState(\n87:       status: status ?? this.status,\n88:       join: clearJoin ? null : (join ?? this.join),\n89:       manifest: clearManifest ? null : (manifest ?? this.manifest),\n90:       message: clearMessage ? null : (message ?? this.message),\n91:       lastSuccessfulCheck: clearLastSuccessfulCheck\n92:           ? null\n93:           : (lastSuccessfulCheck ?? this.lastSuccessfulCheck),\n94:     );\n95:   }\n96: \n97:   /// True when a current manifest is available.\n98:   bool get isReady => status == GuestSessionStatus.ready && manifest != null;\n99: \n100:   /// True when showing retained last-known metadata while offline.\n101:   bool get isStale => status == GuestSessionStatus.stale && manifest != null;\n102: \n103:   @override\n104:   bool operator ==(Object other) {\n105:     if (identical(this, other)) {\n106:       return true;\n107:     }\n108:     return other is GuestSessionState &&\n109:         other.status == status &&\n110:         other.join == join &&\n111:         other.manifest == manifest &&\n112:         other.message == message &&\n113:         other.lastSuccessfulCheck == lastSuccessfulCheck;\n114:   }\n115: \n116:   @override\n117:   int get hashCode =>\n118:       Object.hash(status, join, manifest, message, lastSuccessfulCheck);\n119: \n120:   @override\n121:   String toString() =>\n122:       'GuestSessionState($status, manifest: ${manifest?.version}, '\n123:       'checked: $lastSuccessfulCheck)';\n124: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5f652761e9005d3cad42d3fb8"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session_state.dart\"}"},"time":{"start":1793461713073,"end":1793461713307}}}}
