atch (error, stackTrace) {\n133:         if (failures >= maxTransportResubscriptions) {\n134:           Error.throwWithStackTrace(\n135:             ManifestTransportException('manifest stream failed', error),\n136:             stackTrace,\n137:           );\n138:         }\n139:         failures++;\n140:         await Future<void>.delayed(transportRetryDelay * failures);\n141:       }\n142:     }\n143:   }\n144: \n145:   Stream<Map<String, Object?>?> _documentsFor(\n146:     String partyId,\n147:     String channelId,\n148:     String documentPath,\n149:   ) {\n150:     final FirebaseManifestDocumentStream? fakeStream = _watchDocumentData;\n151:     if (fakeStream != null) {\n152:       return fakeStream(documentPath);\n153:     }\n154:     final DocumentReference<Map<String, dynamic>> current =\n155:         (_firestore ?? FirebaseFirestore.instance)\n156:             .collection('parties')\n157:             .doc(partyId)\n158:             .collection('manifests')\n159:             .doc('current_$channelId');\n160:     return current.snapshots().map(\n161:       (DocumentSnapshot<Map<String, dynamic>> snapshot) => snapshot.data(),\n162:     );\n163:   }\n164: \n165:   Map<String, Object?> _normalizeMap(Map<String, dynamic> raw) =>\n166:       <String, Object?>{\n167:         for (final MapEntry<String, dynamic> entry in raw.entries)\n168:           entry.key: _normalizeValue(entry.value),\n169:       };\n170: \n171:   Object? _normalizeValue(Object? value) {\n172:     if (value is Timestamp) {\n173:       return value.toDate().toUtc();\n174:     }\n175:     if (value is DateTime) {\n176:       return value.toUtc();\n177:     }\n178:     if (value is Map) {\n179:       return <String, Object?>{\n180:         for (final MapEntry<Object?, Object?> entry in value.entries)\n181:           if (entry.key is String)\n182:             entry.key! as String: _normalizeValue(entry.value),\n183:       };\n184:     }\n185:     if (value is Iterable) {\n186:       return value.map(_normalizeValue).toList(growable: false);\n187:     }\n188:     return value;\n189:   }\n190: \n191:   void _validatePathId(String value, String field) {\n192:     if (value.trim().isEmpty || value.contains('/')) {\n193:       throw ArgumentError.value(value, field, 'must be a single path segment');\n194:     }\n195:   }\n196: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b2e0c71e6a25aa50f3fae624e"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/packages/infra_firestore/lib/src/firebase_manifest_source.dart\"}"},"time":{"start":1793461006292,"end":1793461006314}}}}
