{"type":"tool_use","timestamp":1793461699095,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a5bcbb001A4GH67gAg15sOE","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a5b6e3001EFgOpbTefjbW41","type":"tool","id":"call_01a192a5ba2972f18bf5b2629ef4f173","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_boot_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_boot_test.dart, lines 1-610\n1: /// Boot sequence tests: registry -> channel -> manifest (no UI).\n2: ///\n3: /// All hash assertions run through the real prod paths: manifests carry\n4: /// `sha256Hex(realBytes)` digests computed by `core_cache`, and every boot\n5: /// goes through the real `WallBoot.boot()` including byte verification.\n6: library;\n7: \n8: import 'dart:convert';\n9: import 'dart:io';\n10: \n11: import 'package:channel_cctv/channel_cctv.dart';\n12: import 'package:core_cache/core_cache.dart';\n13: import 'package:core_playlist/core_playlist.dart';\n14: import 'package:flutter/widgets.dart';\n15: import 'package:flutter_test/flutter_test.dart';\n16: import 'package:infra_settings/infra_settings.dart' show InMemorySettings;\n17: import 'package:kernel_app/kernel_app.dart';\n18: import 'package:tv_app/src/wall/wall_boot.dart';\n19: \n20: import 'support/fakes.dart';\n21: \n22: const List<String> _cameras = <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'];\n23: \n24: /// Deterministic stand-in for bundled clip bytes (per-camera, distinct).\n25: List<int> _bytesFor(String cameraId) =>\n26:     utf8.encode('halloween-tv-offline-bytes@$cameraId#' * 8);\n27: \n28: /// Real manifest whose digests match [bytesByAsset] byte-for-byte.\n29: PlaybackManifest _manifestFor(\n30:   Map<String, List<int>> bytesByAsset, {\n31:   String partyId = 'local-party',\n32:   String channelId = hauntedSurveillanceChannelId,\n33:   int version = 1,\n34: }) {\n35:   return PlaybackManifest(\n36:     partyId: partyId,\n37:     channelId: channelId,\n38:     version: version,\n39:     clips: <ClipDescriptor>[\n40:       for (var i = 0; i < _cameras.length; i++)\n41:         ClipDescriptor(\n42:           id: _cameras[i],\n43:           cameraId: _cameras[i],\n44:           storageObjectId: 'assets/cam0${i + 1}.mp4',\n45:           sha256: sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n46:           sizeBytes: bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n47:           duration: const Duration(seconds: 2),\n48:           mimeType: 'video/mp4',\n49:         ),\n50:     ],\n51:     publishedAt: DateTime.utc(2026, 10, 31, 20),\n52:   );\n53: }\n54: \n55: Map<String, List<int>> _realBytes() => <String, List<int>>{\n56:   'assets/cam01.mp4': _bytesFor('CAM-01'),\n57:   'assets/cam02.mp4': _bytesFor('CAM-02'),\n58:   'assets/cam03.mp4': _bytesFor('CAM-03'),\n59:   'assets/cam04.mp4': _bytesFor('CAM-04'),\n60: };\n61: \n62: WallAssetBytesLoader _bytesLoader(Map<String, List<int>> bytesByAsset) =>\n63:     (String path) async {\n64:       final bytes = bytesByAsset[path];\n65:       if (bytes == null) {\n66:         throw StateError('no bundled bytes for $path');\n67:       }\n68:       return bytes;\n69:     };\n70: \n71: WallBoot _bootWith({\n72:   required Map<String, List<int>> bytesByAsset,\n73:   required PlaybackManifest fixtureManifest,\n74:   InMemoryManifestStore? store,\n75:   String partyId = 'local-party',\n76:   WallBundleLoader? bundleLoader,\n77: }) {\n78:   return WallBoot(\n79:     store: store ?? InMemoryManifestStore(),\n80:     partyId: partyId,\n81:     fixtureLoader: ({required String partyId, required String channelId}) async =>\n82:         fixtureManifest,\n83:     assetBytesLoader: _bytesLoader(bytesByAsset),\n84:     bundleLoader: bundleLoader ?? ((String key) async => throw StateError('no bundle in unit tests')),\n85:   );\n86: }\n87: \n88: void main() {\n89:   TestWidgetsFlutterBinding.ensureInitialized();\n90: \n91:   group('WallBoot', () {\n92:     test('restores effects-disabled setting from the party-scoped port', () async {\n93:       final Map<String, List<int>> bytesByAsset = _realBytes();\n94:       final InMemorySettings settings = InMemorySettings();\n95:       await settings.setBool(\n96:         partyId: PartyId('local-party'),\n97:         key: CctvWallSettingsKeys.effectsDisabled,\n98:         value: true,\n99:       );\n100:       final WallBoot boot = WallBoot(\n101:         store: InMemoryManifestStore(),\n102:         settings: settings,\n103:         fixture: ({required String partyId, required String channelId}) =>\n104:             _manifestFor(bytesByAsset, partyId: partyId, channelId: channelId),\n105:         assetBytesLoader: _bytesLoader(bytesByAsset),\n106:         bundleLoader: (_) async => throw StateError('fixture override is used'),\n107:       );\n108: \n109:       final result = await boot.boot();\n110: \n111:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n112:       expect(result.initialEffectsDisabled, isTrue);\n113:       expect(\n114:         await settings.getBool(\n115:           partyId: PartyId('someone-else'),\n116:           key: CctvWallSettingsKeys.effectsDisabled,\n117:         ),\n118:         isNull,\n119:       );\n120:     });\n121: \n122:     test('boots from the bundled fixture when bytes verify', () async {\n123:       final bytesByAsset = _realBytes();\n124:       final fixture = _manifestFor(bytesByAsset);\n125:       final store = InMemoryManifestStore();\n126:       final boot = _bootWith(\n127:         bytesByAsset: bytesByAsset,\n128:         fixtureManifest: fixture,\n129:         store: store,\n130:       );\n131: \n132:       final result = await boot.boot();\n133: \n134:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n135:       final ChannelRegistry registry = result.registry!;\n136:       expect(registry.allIds, contains(hauntedSurveillanceChannelId));\n137:       // Retro stub is registered (visible to the kernel) but never resolved\n138:       // or built, so the wall stays the CCTV wall.\n139:       expect(registry.allIds, hasLength(2));\n140: \n141:       final ChannelPlugin plugin = result.plugin!;\n142:       expect(plugin.descriptor.id, hauntedSurveillanceChannelId);\n143:       expect(plugin.descriptor.capabilities.videoPlayback, isTrue);\n144:       expect(plugin.descriptor.capabilities.effects, isTrue);\n145: \n146:       final PlaybackManifest manifest = result.manifest!;\n147:       expect(result.usedCachedManifest, isFalse);\n148:       expect(\n149:         validateCctvManifest(manifest).isOk,\n150:         isTrue,\n151:         reason: 'boot must hand the wall a valid manifest',\n152:       );\n153:       expect(\n154:         manifest.clips.map((ClipDescriptor c) => c.cameraId),\n155:         <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n156:       );\n157:       // The fixture is persisted so the next cold start restores a wall.\n158:       expect(store.writes, 1);\n159:       expect(store.stored!.version, manifest.version);\n160:     });\n161: \n162:     test('parses the gen_fixtures.sh offline shape end to end', () async {\n163:       final bytesByAsset = _realBytes();\n164:       final shape = <String, Object?>{\n165:         'clips': <Object?>[\n166:           for (var i = 0; i < _cameras.length; i++)\n167:             <String, Object?>{\n168:               'cameraId': _cameras[i],\n169:               'sha256': sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n170:               'sizeBytes': bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n171:               'durationMs': 2000,\n172:               'asset': 'assets/cam0${i + 1}.mp4',\n173:             },\n174:         ],\n175:       };\n176:       final parsed = parseFixtureManifestJson(\n177:         shape,\n178:         partyId: 'local-party',\n179:         channelId: hauntedSurveillanceChannelId,\n180:       );\n181:       expect(validateCctvManifest(parsed).isOk, isTrue);\n182:       expect(\n183:         parsed.clips.map((c) => c.id),\n184:         <String>['clip-01', 'clip-02', 'clip-03', 'clip-04'],\n185:       );\n186: \n187:       final store = InMemoryManifestStore();\n188:       final boot = _bootWith(\n189:         bytesByAsset: bytesByAsset,\n190:         fixtureManifest: parsed,\n191:         store: store,\n192:       );\n193:       final result = await boot.boot();\n194:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n195:       expect(result.manifest!.clips.map((c) => c.cameraId),\n196:           <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04']);\n197:     });\n198: \n199:     test('restores the last cached manifest instead of the fixture', () async {\n200:       final bytesByAsset = _realBytes();\n201:       final cached = _manifestFor(bytesByAsset, version: 7);\n202:       final fixture = _manifestFor(bytesByAsset, version: 1);\n203:       final store = InMemoryManifestStore(cached);\n204: \n205:       final result = await _bootWith(\n206:         bytesByAsset: bytesByAsset,\n207:         fixtureManifest: fixture,\n208:         store: store,\n209:       ).boot();\n210: \n211:       expect(result.isReady, isTrue);\n212:       expect(result.usedCachedManifest, isTrue);\n213:       expect(result.manifest!.version, 7);\n214:       expect(store.writes, 0, reason: 'a cached wall must not be rewritten');\n215:     });\n216: \n217:     test('rejects a cached manifest for another party', () async {\n218:       final bytesByAsset = _realBytes();\n219:       final cached = _manifestFor(bytesByAsset,\n220:           partyId: 'someone-elses-party', version: 7);\n221:       final fixture = _manifestFor(bytesByAsset, version: 3);\n222:       final store = InMemoryManifestStore(cached);\n223: \n224:       final result = await _bootWith(\n225:         bytesByAsset: bytesByAsset,\n226:         fixtureManifest: fixture,\n227:         store: store,\n228:       ).boot();\n229: \n230:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n231:       expect(result.usedCachedManifest, isFalse);\n232:       expect(result.manifest!.version, 3);\n233:       expect(result.manifest!.partyId, 'local-party');\n234:     });\n235: \n236:     test('rejects a cached manifest for another channel', () async {\n237:       final bytesByAsset = _realBytes();\n238:       final cached = _manifestFor(bytesByAsset,\n239:           channelId: 'retro_horror_test', version: 7);\n240:       final fixture = _manifestFor(bytesByAsset, version: 3);\n241:       final store = InMemoryManifestStore(cached);\n242: \n243:       final result = await _bootWith(\n244:         bytesByAsset: bytesByAsset,\n245:         fixtureManifest: fixture,\n246:         store: store,\n247:       ).boot();\n248: \n249:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n250:       expect(result.usedCachedManifest, isFalse);\n251:       expect(result.manifest!.channelId, hauntedSurveillanceChannelId);\n252:     });\n253: \n254:     test('fails closed on a tampered bundled sha256', () async {\n255:       final bytesByAsset = _realBytes();\n256:       final good = _manifestFor(bytesByAsset);\n257:       final tamperedCam02 = List<int>.of(bytesByAsset['assets/cam02.mp4']!);\n258:       tamperedCam02[0] ^= 0xff;\n259:       final tamperedBytes = Map<String, List<int>>.of(bytesByAsset)\n260:         ..['assets/cam02.mp4'] = tamperedCam02;\n261:       final store = InMemoryManifestStore();\n262: \n263:       final result = await _bootWith(\n264:         bytesByAsset: tamperedBytes,\n265:         fixtureManifest: good,\n266:         store: store,\n267:       ).boot();\n268: \n269:       expect(result.isReady, isFalse);\n270:       expect(result.unavailableReason, contains('hash mismatch'));\n271:       expect(result.manifest, isNull);\n272:       expect(store.writes, 0, reason: 'tampered bytes must not be cached');\n273:     });\n274: \n275:     test('fails closed when verified bytes differ from played bytes', () async {\n276:       // Swapped-asset manifest: CAM-01 names cam04's file and carries\n277:       // cam04's digest/size, so the named file verifies byte-for-byte —\n278:       // but tiles play assetPathForCamera (cam01), not the manifest's\n279:       // storage reference. Boot must reject (unavailable), not play\n280:       // unverified bytes.\n281:       final bytesByAsset = _realBytes();\n282:       final rest = _manifestFor(bytesByAsset).clips.skip(1);\n283:       final swapped = PlaybackManifest(\n284:         partyId: 'local-party',\n285:         channelId: hauntedSurveillanceChannelId,\n286:         version: 1,\n287:         clips: <ClipDescriptor>[\n288:           ClipDescriptor(\n289:             id: 'CAM-01',\n290:             cameraId: 'CAM-01',\n291:             storageObjectId: 'assets/cam04.mp4',\n292:             sha256: sha256Hex(bytesByAsset['assets/cam04.mp4']!),\n293:             sizeBytes: bytesByAsset['assets/cam04.mp4']!.length,\n294:             duration: const Duration(seconds: 2),\n295:             mimeType: 'video/mp4',\n296:           ),\n297:           ...rest,\n298:         ],\n299:         publishedAt: DateTime.utc(2026, 10, 31, 20),\n300:       );\n301:       // Sanity: the swapped manifest is contract-valid, so only the\n302:       // verified/played-byte identity check can reject it.\n303:       expect(validateCctvManifest(swapped).isOk, isTrue);\n304:       final store = InMemoryManifestStore();\n305: \n306:       final result = await _bootWith(\n307:         bytesByAsset: bytesByAsset,\n308:         fixtureManifest: swapped,\n309:         store: store,\n310:       ).boot();\n311: \n312:       expect(result.isReady, isFalse);\n313:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n314:       expect(result.manifest, isNull);\n315:       expect(store.writes, 0, reason: 'swapped bytes must not be cached');\n316:     });\n317: \n318:     test('fails closed on a tampered bundled size', () async {\n319:       final bytesByAsset = _realBytes();\n320:       final good = _manifestFor(bytesByAsset);\n321:       final wrongSize = PlaybackManifest(\n322:         partyId: good.partyId,\n323:         channelId: good.channelId,\n324:         version: good.version,\n325:         clips: <ClipDescriptor>[\n326:           for (final c in good.clips)\n327:             c.cameraId == 'CAM-03'\n328:                 ? ClipDescriptor(\n329:                     id: c.id,\n330:                     cameraId: c.cameraId,\n331:                     storageObjectId: c.storageObjectId,\n332:                     sha256: c.sha256,\n333:                     sizeBytes: c.sizeBytes + 1,\n334:                     duration: c.duration,\n335:                     mimeType: c.mimeType,\n336:                   )\n337:                 : c,\n338:         ],\n339:         publishedAt: good.publishedAt,\n340:       );\n341:       final store = InMemoryManifestStore();\n342: \n343:       final result = await _bootWith(\n344:         bytesByAsset: bytesByAsset,\n345:         fixtureManifest: wrongSize,\n346:         store: store,\n347:       ).boot();\n348: \n349:       expect(result.isReady, isFalse);\n350:       expect(result.unavailableReason, contains('hash mismatch'));\n351:       expect(store.writes, 0);\n352:     });\n353: \n354:     test('fails closed when the cached bytes no longer verify', () async {\n355:       final bytesByAsset = _realBytes();\n356:       final cached = _manifestFor(bytesByAsset, version: 7);\n357:       // Cached manifest was valid when written, but the bundled bytes changed\n358:       // (or were corrupted): the wall must fall back, not play stale hashes.\n359:       final rotated = Map<String, List<int>>.of(bytesByAsset)\n360:         ..['assets/cam01.mp4'] = utf8.encode('rotated-clip-bytes' * 16);\n361:       final store = InMemoryManifestStore(cached);\n362: \n363:       final result = await _bootWith(\n364:         bytesByAsset: rotated,\n365:         fixtureManifest: _manifestFor(rotated, version: 1),\n366:         store: store,\n367:       ).boot();\n368: \n369:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n370:       expect(result.usedCachedManifest, isFalse);\n371:       expect(result.manifest!.version, 1);\n372:     });\n373: \n374:     test('a corrupt cached manifest falls back to the fixture', () async {\n375:       final bytesByAsset = _realBytes();\n376:       final good = _manifestFor(bytesByAsset);\n377:       final threeClips = PlaybackManifest(\n378:         partyId: good.partyId,\n379:         channelId: good.channelId,\n380:         version: 2,\n381:         clips: good.clips.take(3).toList(),\n382:         publishedAt: good.publishedAt,\n383:       );\n384:       final store = InMemoryManifestStore(threeClips);\n385: \n386:       final result = await _bootWith(\n387:         bytesByAsset: bytesByAsset,\n388:         fixtureManifest: good,\n389:         store: store,\n390:       ).boot();\n391: \n392:       expect(result.isReady, isTrue);\n393:       expect(result.usedCachedManifest, isFalse);\n394:       expect(result.manifest!.clips, hasLength(4));\n395:       expect(store.writes, 1, reason: 'the repaired wall is re-cached');\n396:     });\n397: \n398:     test('reports unavailable when the bundle file is missing', () async {\n399:       final store = InMemoryManifestStore();\n400:       final boot = WallBoot(\n401:         store: store,\n402:         assetBytesLoader: _bytesLoader(_realBytes()),\n403:         bundleLoader: (String key) async =>\n404:             throw StateError('bundle asset missing: $key'),\n405:       );\n406: \n407:       final result = await boot.boot();\n408: \n409:       expect(result.isReady, isFalse);\n410:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n411:       expect(store.writes, 0);\n412:     });\n413: \n414:     test('reports no wall when the channel is not registered', () async {\n415:       final bytesByAsset = _realBytes();\n416:       final boot = WallBoot(\n417:         store: InMemoryManifestStore(),\n418:         registryFactory: _retroOnlyRegistry,\n419:         fixtureLoader: ({required String partyId, required String channelId}) async =>\n420:             _manifestFor(bytesByAsset),\n421:         assetBytesLoader: _bytesLoader(bytesByAsset),\n422:       );\n423: \n424:       final result = await boot.boot();\n425: \n426:       expect(result.isReady, isFalse);\n427:       expect(result.unavailableReason, contains('NO WALL'));\n428:       expect(result.unavailableReason, contains(hauntedSurveillanceChannelId));\n429:       expect(result.manifest, isNull);\n430:     });\n431: \n432:     test('reports no wall when even the fixture violates the CCTV contract',\n433:         () async {\n434:       final boot = WallBoot(\n435:         store: InMemoryManifestStore(),\n436:         fixture: ({required String partyId, required String channelId}) =>\n437:             PlaybackManifest(\n438:           partyId: partyId,\n439:           channelId: channelId,\n440:           version: 1,\n441:           clips: const <ClipDescriptor>[],\n442:           publishedAt: DateTime.utc(2026, 10, 31),\n443:         ),\n444:         assetBytesLoader: _bytesLoader(_realBytes()),\n445:       );\n446: \n447:       final result = await boot.boot();\n448: \n449:       expect(result.isReady, isFalse);\n450:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n451:     });\n452: \n453:     test('survives a broken manifest store', () async {\n454:       final bytesByAsset = _realBytes();\n455:       final store = InMemoryManifestStore()..failReads = true;\n456: \n457:       final result = await _bootWith(\n458:         bytesByAsset: bytesByAsset,\n459:         fixtureManifest: _manifestFor(bytesByAsset),\n460:         store: store,\n461:       ).boot();\n462: \n463:       expect(result.isReady, isTrue);\n464:       expect(result.usedCachedManifest, isFalse);\n465:     });\n466: \n467:     test('readCached ignores invalid cached manifests', () async {\n468:       final bytesByAsset = _realBytes();\n469:       final good = _manifestFor(bytesByAsset);\n470:       final store = InMemoryManifestStore(\n471:         PlaybackManifest(\n472:           partyId: good.partyId,\n473:           channelId: good.channelId,\n474:           version: 1,\n475:           clips: good.clips.take(2).toList(),\n476:           publishedAt: good.publishedAt,\n477:         ),\n478:       );\n479:       final boot = _bootWith(\n480:         bytesByAsset: bytesByAsset,\n481:         fixtureManifest: good,\n482:         store: store,\n483:       );\n484: \n485:       expect(await boot.readCached(), isNull);\n486: \n487:       store.stored = _manifestFor(bytesByAsset, version: 4);\n488:       expect((await boot.readCached())!.version, 4);\n489:     });\n490: \n491:     test('readCached rejects other-party manifests', () async {\n492:       final bytesByAsset = _realBytes();\n493:       final store = InMemoryManifestStore(\n494:         _manifestFor(bytesByAsset, partyId: 'intruder-party', version: 4),\n495:       );\n496:       final boot = _bootWith(\n497:         bytesByAsset: bytesByAsset,\n498:         fixtureManifest: _manifestFor(bytesByAsset),\n499:         store: store,\n500:       );\n501: \n502:       expect(await boot.readCached(), isNull);\n503:     });\n504: \n505:     test('sha256Hex matches the real committed cam01 bytes', () async {\n506:       final manifestFile = File('assets/fixture_manifest.json');\n507:       expect(await manifestFile.exists(), isTrue,\n508:           reason: 'run from the tv_app package directory');\n509:       final manifestJson = jsonDecode(await manifestFile.readAsString())\n510:           as Map<String, Object?>;\n511:       final clips = (manifestJson['clips'] as List).cast<Map<String, Object?>>();\n512:       final cam01 = clips.singleWhere(\n513:         (c) => c['cameraId'] == 'CAM-01',\n514:         orElse: () => throw StateError('CAM-01 missing from fixture_manifest.json'),\n515:       );\n516:       final expectedSize = cam01['sizeBytes'] as int;\n517:       final expectedSha = cam01['sha256'] as String;\n518:       final file = File('assets/cam01.mp4');\n519:       expect(await file.exists(), isTrue,\n520:           reason: 'run from the tv_app package directory');\n521:       final bytes = await file.readAsBytes();\n522:       expect(bytes.length, expectedSize,\n523:           reason:\n524:               'on-disk cam01 bytes must match the committed fixture_manifest.json');\n525:       expect(\n526:         sha256Hex(bytes),\n527:         expectedSha,\n528:         reason:\n529:             'on-disk cam01 bytes must match the committed fixture_manifest.json',\n530:       );\n531:       // Negative control: the comparison above is not a tautology — tampered\n532:       // bytes must disagree with the committed manifest entry.\n533:       final tampered = List<int>.of(bytes);\n534:       tampered[0] ^= 0xff;\n535:       expect(sha256Hex(tampered), isNot(equals(expectedSha)),\n536:           reason: 'tampered bytes must mismatch the manifest sha256');\n537:       expect(tampered.length + 1, isNot(equals(expectedSize)),\n538:           reason: 'a wrong size must mismatch the manifest sizeBytes');\n539:     });\n540: \n541:     test('boots the real committed fixture manifest end to end', () async {\n542:       // Real-artifact path: the committed assets/fixture_manifest.json flows\n543:       // through the prod loaders (loadBundledFixtureManifest /\n544:       // parseFixtureManifestJson), validates, and verifies all four clips\n545:       // against file-backed asset bytes through the real WallBoot.boot.\n546:       final manifestFile = File('assets/fixture_manifest.json');\n547:       expect(await manifestFile.exists(), isTrue,\n548:           reason: 'run from the tv_app package directory');\n549:       final String raw = await manifestFile.readAsString();\n550:       final PlaybackManifest parsed = await loadBundledFixtureManifest(\n551:         partyId: 'local-party',\n552:         channelId: hauntedSurveillanceChannelId,\n553:         loader: (String key) async {\n554:           expect(key, kBundledFixtureManifestKey);\n555:           return raw;\n556:         },\n557:       );\n558:       expect(validateCctvManifest(parsed).isOk, isTrue,\n559:           reason: 'committed fixture must satisfy the CCTV contract');\n560:       expect(\n561:         parsed.clips.map((ClipDescriptor c) => c.cameraId),\n562:         <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n563:       );\n564: \n565:       Future<List<int>> fileBytes(String assetPath) =>\n566:           File(assetPath).readAsBytes();\n567:       final store = InMemoryManifestStore();\n568:       final boot = WallBoot(\n569:         store: store,\n570:         fixtureLoader: ({required String partyId, required String channelId}) async =>\n571:             parsed,\n572:         assetBytesLoader: fileBytes,\n573:       );\n574:       final result = await boot.boot();\n575:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n576:       expect(result.manifest!.clips, hasLength(4));\n577:       // Every committed clip file exists and matches its manifest entry.\n578:       for (final ClipDescriptor clip in result.manifest!.clips) {\n579:         final List<int> bytes = await File(clip.storageObjectId).readAsBytes();\n580:         expect(bytes.length, clip.sizeBytes,\n581:             reason: '${clip.cameraId} on-disk size must match the manifest');\n582:         expect(sha256Hex(bytes), clip.sha256,\n583:             reason: '${clip.cameraId} on-disk sha must match the manifest');\n584:       }\n585:       // The bundle key boot loads by default is the pubspec asset entry.\n586:       final String pubspec = await File('pubspec.yaml').readAsString();\n587:       expect(pubspec, contains(kBundledFixtureManifestKey));\n588:     });\n589:   });\n590: }\n591: \n592: ChannelRegistry _retroOnlyRegistry() {\n593:   final ChannelRegistry registry = ChannelRegistry();\n594:   // Only the inactive retro stub: resolving the CCTV channel must fail.\n595:   registry.register(_ChannelPluginStub());\n596:   return registry;\n597: }\n598: \n599: /// Minimal plugin used to build a registry without the CCTV channel.\n600: final class _ChannelPluginStub implements ChannelPlugin {\n601:   @override\n602:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n603:         id: 'retro_horror_test',\n604:         title: 'Retro',\n605:         version: 1,\n606:       );\n607: \n608:   @override\n609:   Widget build(ChannelContext context) => const SizedBox.shrink();\n610: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_boot_test.dart, lines 1-610\n1: /// Boot sequence tests: registry -> channel -> manifest (no UI).\n2: ///\n3: /// All hash assertions run through the real prod paths: manifests carry\n4: /// `sha256Hex(realBytes)` digests computed by `core_cache`, and every boot\n5: /// goes through the real `WallBoot.boot()` including byte verification.\n6: library;\n7: \n8: import 'dart:convert';\n9: import 'dart:io';\n10: \n11: import 'package:channel_cctv/channel_cctv.dart';\n12: import 'package:core_cache/core_cache.dart';\n13: import 'package:core_playlist/core_playlist.dart';\n14: import 'package:flutter/widgets.dart';\n15: import 'package:flutter_test/flutter_test.dart';\n16: import 'package:infra_settings/infra_settings.dart' show InMemorySettings;\n17: import 'package:kernel_app/kernel_app.dart';\n18: import 'package:tv_app/src/wall/wall_boot.dart';\n19: \n20: import 'support/fakes.dart';\n21: \n22: const List<String> _cameras = <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'];\n23: \n24: /// Deterministic stand-in for bundled clip bytes (per-camera, distinct).\n25: List<int> _bytesFor(String cameraId) =>\n26:     utf8.encode('halloween-tv-offline-bytes@$cameraId#' * 8);\n27: \n28: /// Real manifest whose digests match [bytesByAsset] byte-for-byte.\n29: PlaybackManifest _manifestFor(\n30:   Map<String, List<int>> bytesByAsset, {\n31:   String partyId = 'local-party',\n32:   String channelId = hauntedSurveillanceChannelId,\n33:   int version = 1,\n34: }) {\n35:   return PlaybackManifest(\n36:     partyId: partyId,\n37:     channelId: channelId,\n38:     version: version,\n39:     clips: <ClipDescriptor>[\n40:       for (var i = 0; i < _cameras.length; i++)\n41:         ClipDescriptor(\n42:           id: _cameras[i],\n43:           cameraId: _cameras[i],\n44:           storageObjectId: 'assets/cam0${i + 1}.mp4',\n45:           sha256: sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n46:           sizeBytes: bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n47:           duration: const Duration(seconds: 2),\n48:           mimeType: 'video/mp4',\n49:         ),\n50:     ],\n51:     publishedAt: DateTime.utc(2026, 10, 31, 20),\n52:   );\n53: }\n54: \n55: Map<String, List<int>> _realBytes() => <String, List<int>>{\n56:   'assets/cam01.mp4': _bytesFor('CAM-01'),\n57:   'assets/cam02.mp4': _bytesFor('CAM-02'),\n58:   'assets/cam03.mp4': _bytesFor('CAM-03'),\n59:   'assets/cam04.mp4': _bytesFor('CAM-04'),\n60: };\n61: \n62: WallAssetBytesLoader _bytesLoader(Map<String, List<int>> bytesByAsset) =>\n63:     (String path) async {\n64:       final bytes = bytesByAsset[path];\n65:       if (bytes == null) {\n66:         throw StateError('no bundled bytes for $path');\n67:       }\n68:       return bytes;\n69:     };\n70: \n71: WallBoot _bootWith({\n72:   required Map<String, List<int>> bytesByAsset,\n73:   required PlaybackManifest fixtureManifest,\n74:   InMemoryManifestStore? store,\n75:   String partyId = 'local-party',\n76:   WallBundleLoader? bundleLoader,\n77: }) {\n78:   return WallBoot(\n79:     store: store ?? InMemoryManifestStore(),\n80:     partyId: partyId,\n81:     fixtureLoader: ({required String partyId, required String channelId}) async =>\n82:         fixtureManifest,\n83:     assetBytesLoader: _bytesLoader(bytesByAsset),\n84:     bundleLoader: bundleLoader ?? ((String key) async => throw StateError('no bundle in unit tests')),\n85:   );\n86: }\n87: \n88: void main() {\n89:   TestWidgetsFlutterBinding.ensureInitialized();\n90: \n91:   group('WallBoot', () {\n92:     test('restores effects-disabled setting from the party-scoped port', () async {\n93:       final Map<String, List<int>> bytesByAsset = _realBytes();\n94:       final InMemorySettings settings = InMemorySettings();\n95:       await settings.setBool(\n96:         partyId: PartyId('local-party'),\n97:         key: CctvWallSettingsKeys.effectsDisabled,\n98:         value: true,\n99:       );\n100:       final WallBoot boot = WallBoot(\n101:         store: InMemoryManifestStore(),\n102:         settings: settings,\n103:         fixture: ({required String partyId, required String channelId}) =>\n104:             _manifestFor(bytesByAsset, partyId: partyId, channelId: channelId),\n105:         assetBytesLoader: _bytesLoader(bytesByAsset),\n106:         bundleLoader: (_) async => throw StateError('fixture override is used'),\n107:       );\n108: \n109:       final result = await boot.boot();\n110: \n111:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n112:       expect(result.initialEffectsDisabled, isTrue);\n113:       expect(\n114:         await settings.getBool(\n115:           partyId: PartyId('someone-else'),\n116:           key: CctvWallSettingsKeys.effectsDisabled,\n117:         ),\n118:         isNull,\n119:       );\n120:     });\n121: \n122:     test('boots from the bundled fixture when bytes verify', () async {\n123:       final bytesByAsset = _realBytes();\n124:       final fixture = _manifestFor(bytesByAsset);\n125:       final store = InMemoryManifestStore();\n126:       final boot = _bootWith(\n127:         bytesByAsset: bytesByAsset,\n128:         fixtureManifest: fixture,\n129:         store: store,\n130:       );\n131: \n132:       final result = await boot.boot();\n133: \n134:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n135:       final ChannelRegistry registry = result.registry!;\n136:       expect(registry.allIds, contains(hauntedSurveillanceChannelId));\n137:       // Retro stub is registered (visible to the kernel) but never resolved\n138:       // or built, so the wall stays the CCTV wall.\n139:       expect(registry.allIds, hasLength(2));\n140: \n141:       final ChannelPlugin plugin = result.plugin!;\n142:       expect(plugin.descriptor.id, hauntedSurveillanceChannelId);\n143:       expect(plugin.descriptor.capabilities.videoPlayback, isTrue);\n144:       expect(plugin.descriptor.capabilities.effects, isTrue);\n145: \n146:       final PlaybackManifest manifest = result.manifest!;\n147:       expect(result.usedCachedManifest, isFalse);\n148:       expect(\n149:         validateCctvManifest(manifest).isOk,\n150:         isTrue,\n151:         reason: 'boot must hand the wall a valid manifest',\n152:       );\n153:       expect(\n154:         manifest.clips.map((ClipDescriptor c) => c.cameraId),\n155:         <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n156:       );\n157:       // The fixture is persisted so the next cold start restores a wall.\n158:       expect(store.writes, 1);\n159:       expect(store.stored!.version, manifest.version);\n160:     });\n161: \n162:     test('parses the gen_fixtures.sh offline shape end to end', () async {\n163:       final bytesByAsset = _realBytes();\n164:       final shape = <String, Object?>{\n165:         'clips': <Object?>[\n166:           for (var i = 0; i < _cameras.length; i++)\n167:             <String, Object?>{\n168:               'cameraId': _cameras[i],\n169:               'sha256': sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n170:               'sizeBytes': bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n171:               'durationMs': 2000,\n172:               'asset': 'assets/cam0${i + 1}.mp4',\n173:             },\n174:         ],\n175:       };\n176:       final parsed = parseFixtureManifestJson(\n177:         shape,\n178:         partyId: 'local-party',\n179:         channelId: hauntedSurveillanceChannelId,\n180:       );\n181:       expect(validateCctvManifest(parsed).isOk, isTrue);\n182:       expect(\n183:         parsed.clips.map((c) => c.id),\n184:         <String>['clip-01', 'clip-02', 'clip-03', 'clip-04'],\n185:       );\n186: \n187:       final store = InMemoryManifestStore();\n188:       final boot = _bootWith(\n189:         bytesByAsset: bytesByAsset,\n190:         fixtureManifest: parsed,\n191:         store: store,\n192:       );\n193:       final result = await boot.boot();\n194:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n195:       expect(result.manifest!.clips.map((c) => c.cameraId),\n196:           <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04']);\n197:     });\n198: \n199:     test('restores the last cached manifest instead of the fixture', () async {\n200:       final bytesByAsset = _realBytes();\n201:       final cached = _manifestFor(bytesByAsset, version: 7);\n202:       final fixture = _manifestFor(bytesByAsset, version: 1);\n203:       final store = InMemoryManifestStore(cached);\n204: \n205:       final result = await _bootWith(\n206:         bytesByAsset: bytesByAsset,\n207:         fixtureManifest: fixture,\n208:         store: store,\n209:       ).boot();\n210: \n211:       expect(result.isReady, isTrue);\n212:       expect(result.usedCachedManifest, isTrue);\n213:       expect(result.manifest!.version, 7);\n214:       expect(store.writes, 0, reason: 'a cached wall must not be rewritten');\n215:     });\n216: \n217:     test('rejects a cached manifest for another party', () async {\n218:       final bytesByAsset = _realBytes();\n219:       final cached = _manifestFor(bytesByAsset,\n220:           partyId: 'someone-elses-party', version: 7);\n221:       final fixture = _manifestFor(bytesByAsset, version: 3);\n222:       final store = InMemoryManifestStore(cached);\n223: \n224:       final result = await _bootWith(\n225:         bytesByAsset: bytesByAsset,\n226:         fixtureManifest: fixture,\n227:         store: store,\n228:       ).boot();\n229: \n230:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n231:       expect(result.usedCachedManifest, isFalse);\n232:       expect(result.manifest!.version, 3);\n233:       expect(result.manifest!.partyId, 'local-party');\n234:     });\n235: \n236:     test('rejects a cached manifest for another channel', () async {\n237:       final bytesByAsset = _realBytes();\n238:       final cached = _manifestFor(bytesByAsset,\n239:           channelId: 'retro_horror_test', version: 7);\n240:       final fixture = _manifestFor(bytesByAsset, version: 3);\n241:       final store = InMemoryManifestStore(cached);\n242: \n243:       final result = await _bootWith(\n244:         bytesByAsset: bytesByAsset,\n245:         fixtureManifest: fixture,\n246:         store: store,\n247:       ).boot();\n248: \n249:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n250:       expect(result.usedCachedManifest, isFalse);\n251:       expect(result.manifest!.channelId, hauntedSurveillanceChannelId);\n252:     });\n253: \n254:     test('fails closed on a tampered bundled sha256', () async {\n255:       final bytesByAsset = _realBytes();\n256:       final good = _manifestFor(bytesByAsset);\n257:       final tamperedCam02 = List<int>.of(bytesByAsset['assets/cam02.mp4']!);\n258:       tamperedCam02[0] ^= 0xff;\n259:       final tamperedBytes = Map<String, List<int>>.of(bytesByAsset)\n260:         ..['assets/cam02.mp4'] = tamperedCam02;\n261:       final store = InMemoryManifestStore();\n262: \n263:       final result = await _bootWith(\n264:         bytesByAsset: tamperedBytes,\n265:         fixtureManifest: good,\n266:         store: store,\n267:       ).boot();\n268: \n269:       expect(result.isReady, isFalse);\n270:       expect(result.unavailableReason, contains('hash mismatch'));\n271:       expect(result.manifest, isNull);\n272:       expect(store.writes, 0, reason: 'tampered bytes must not be cached');\n273:     });\n274: \n275:     test('fails closed when verified bytes differ from played bytes', () async {\n276:       // Swapped-asset manifest: CAM-01 names cam04's file and carries\n277:       // cam04's digest/size, so the named file verifies byte-for-byte —\n278:       // but tiles play assetPathForCamera (cam01), not the manifest's\n279:       // storage reference. Boot must reject (unavailable), not play\n280:       // unverified bytes.\n281:       final bytesByAsset = _realBytes();\n282:       final rest = _manifestFor(bytesByAsset).clips.skip(1);\n283:       final swapped = PlaybackManifest(\n284:         partyId: 'local-party',\n285:         channelId: hauntedSurveillanceChannelId,\n286:         version: 1,\n287:         clips: <ClipDescriptor>[\n288:           ClipDescriptor(\n289:             id: 'CAM-01',\n290:             cameraId: 'CAM-01',\n291:             storageObjectId: 'assets/cam04.mp4',\n292:             sha256: sha256Hex(bytesByAsset['assets/cam04.mp4']!),\n293:             sizeBytes: bytesByAsset['assets/cam04.mp4']!.length,\n294:             duration: const Duration(seconds: 2),\n295:             mimeType: 'video/mp4',\n296:           ),\n297:           ...rest,\n298:         ],\n299:         publishedAt: DateTime.utc(2026, 10, 31, 20),\n300:       );\n301:       // Sanity: the swapped manifest is contract-valid, so only the\n302:       // verified/played-byte identity check can reject it.\n303:       expect(validateCctvManifest(swapped).isOk, isTrue);\n304:       final store = InMemoryManifestStore();\n305: \n306:       final result = await _bootWith(\n307:         bytesByAsset: bytesByAsset,\n308:         fixtureManifest: swapped,\n309:         store: store,\n310:       ).boot();\n311: \n312:       expect(result.isReady, isFalse);\n313:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n314:       expect(result.manifest, isNull);\n315:       expect(store.writes, 0, reason: 'swapped bytes must not be cached');\n316:     });\n317: \n318:     test('fails closed on a tampered bundled size', () async {\n319:       final bytesByAsset = _realBytes();\n320:       final good = _manifestFor(bytesByAsset);\n321:       final wrongSize = PlaybackManifest(\n322:         partyId: good.partyId,\n323:         channelId: good.channelId,\n324:         version: good.version,\n325:         clips: <ClipDescriptor>[\n326:           for (final c in good.clips)\n327:             c.cameraId == 'CAM-03'\n328:                 ? ClipDescriptor(\n329:                     id: c.id,\n330:                     cameraId: c.cameraId,\n331:                     storageObjectId: c.storageObjectId,\n332:                     sha256: c.sha256,\n333:                     sizeBytes: c.sizeBytes + 1,\n334:                     duration: c.duration,\n335:                     mimeType: c.mimeType,\n336:                   )\n337:                 : c,\n338:         ],\n339:         publishedAt: good.publishedAt,\n340:       );\n341:       final store = InMemoryManifestStore();\n342: \n343:       final result = await _bootWith(\n344:         bytesByAsset: bytesByAsset,\n345:         fixtureManifest: wrongSize,\n346:         store: store,\n347:       ).boot();\n348: \n349:       expect(result.isReady, isFalse);\n350:       expect(result.unavailableReason, contains('hash mismatch'));\n351:       expect(store.writes, 0);\n352:     });\n353: \n354:     test('fails closed when the cached bytes no longer verify', () async {\n355:       final bytesByAsset = _realBytes();\n356:       final cached = _manifestFor(bytesByAsset, version: 7);\n357:       // Cached manifest was valid when written, but the bundled bytes changed\n358:       // (or were corrupted): the wall must fall back, not play stale hashes.\n359:       final rotated = Map<String, List<int>>.of(bytesByAsset)\n360:         ..['assets/cam01.mp4'] = utf8.encode('rotated-clip-bytes' * 16);\n361:       final store = InMemoryManifestStore(cached);\n362: \n363:       final result = await _bootWith(\n364:         bytesByAsset: rotated,\n365:         fixtureManifest: _manifestFor(rotated, version: 1),\n366:         store: store,\n367:       ).boot();\n368: \n369:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n370:       expect(result.usedCachedManifest, isFalse);\n371:       expect(result.manifest!.version, 1);\n372:     });\n373: \n374:     test('a corrupt cached manifest falls back to the fixture', () async {\n375:       final bytesByAsset = _realBytes();\n376:       final good = _manifestFor(bytesByAsset);\n377:       final threeClips = PlaybackManifest(\n378:         partyId: good.partyId,\n379:         channelId: good.channelId,\n380:         version: 2,\n381:         clips: good.clips.take(3).toList(),\n382:         publishedAt: good.publishedAt,\n383:       );\n384:       final store = InMemoryManifestStore(threeClips);\n385: \n386:       final result = await _bootWith(\n387:         bytesByAsset: bytesByAsset,\n388:         fixtureManifest: good,\n389:         store: store,\n390:       ).boot();\n391: \n392:       expect(result.isReady, isTrue);\n393:       expect(result.usedCachedManifest, isFalse);\n394:       expect(result.manifest!.clips, hasLength(4));\n395:       expect(store.writes, 1, reason: 'the repaired wall is re-cached');\n396:     });\n397: \n398:     test('reports unavailable when the bundle file is missing', () async {\n399:       final store = InMemoryManifestStore();\n400:       final boot = WallBoot(\n401:         store: store,\n402:         assetBytesLoader: _bytesLoader(_realBytes()),\n403:         bundleLoader: (String key) async =>\n404:             throw StateError('bundle asset missing: $key'),\n405:       );\n406: \n407:       final result = await boot.boot();\n408: \n409:       expect(result.isReady, isFalse);\n410:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n411:       expect(store.writes, 0);\n412:     });\n413: \n414:     test('reports no wall when the channel is not registered', () async {\n415:       final bytesByAsset = _realBytes();\n416:       final boot = WallBoot(\n417:         store: InMemoryManifestStore(),\n418:         registryFactory: _retroOnlyRegistry,\n419:         fixtureLoader: ({required String partyId, required String channelId}) async =>\n420:             _manifestFor(bytesByAsset),\n421:         assetBytesLoader: _bytesLoader(bytesByAsset),\n422:       );\n423: \n424:       final result = await boot.boot();\n425: \n426:       expect(result.isReady, isFalse);\n427:       expect(result.unavailableReason, contains('NO WALL'));\n428:       expect(result.unavailableReason, contains(hauntedSurveillanceChannelId));\n429:       expect(result.manifest, isNull);\n430:     });\n431: \n432:     test('reports no wall when even the fixture violates the CCTV contract',\n433:         () async {\n434:       final boot = WallBoot(\n435:         store: InMemoryManifestStore(),\n436:         fixture: ({required String partyId, required String channelId}) =>\n437:             PlaybackManifest(\n438:           partyId: partyId,\n439:           channelId: channelId,\n440:           version: 1,\n441:           clips: const <ClipDescriptor>[],\n442:           publishedAt: DateTime.utc(2026, 10, 31),\n443:         ),\n444:         assetBytesLoader: _bytesLoader(_realBytes()),\n445:       );\n446: \n447:       final result = await boot.boot();\n448: \n449:       expect(result.isReady, isFalse);\n450:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n451:     });\n452: \n453:     test('survives a broken manifest store', () async {\n454:       final bytesByAsset = _realBytes();\n455:       final store = InMemoryManifestStore()..failReads = true;\n456: \n457:       final result = await _bootWith(\n458:         bytesByAsset: bytesByAsset,\n459:         fixtureManifest: _manifestFor(bytesByAsset),\n460:         store: store,\n461:       ).boot();\n462: \n463:       expect(result.isReady, isTrue);\n464:       expect(result.usedCachedManifest, isFalse);\n465:     });\n466: \n467:     test('readCached ignores invalid cached manifests', () async {\n468:       final bytesByAsset = _realBytes();\n469:       final good = _manifestFor(bytesByAsset);\n470:       final store = InMemoryManifestStore(\n471:         PlaybackManifest(\n472:           partyId: good.partyId,\n473:           channelId: good.channelId,\n474:           version: 1,\n475:           clips: good.clips.take(2).toList(),\n476:           publishedAt: good.publishedAt,\n477:         ),\n478:       );\n479:       final boot = _bootWith(\n480:         bytesByAsset: bytesByAsset,\n481:         fixtureManifest: good,\n482:         store: store,\n483:       );\n484: \n485:       expect(await boot.readCached(), isNull);\n486: \n487:       store.stored = _manifestFor(bytesByAsset, version: 4);\n488:       expect((await boot.readCached())!.version, 4);\n489:     });\n490: \n491:     test('readCached rejects other-party manifests', () async {\n492:       final bytesByAsset = _realBytes();\n493:       final store = InMemoryManifestStore(\n494:         _manifestFor(bytesByAsset, partyId: 'intruder-party', version: 4),\n495:       );\n496:       final boot = _bootWith(\n497:         bytesByAsset: bytesByAsset,\n498:         fixtureManifest: _manifestFor(bytesByAsset),\n499:         store: store,\n500:       );\n501: \n502:       expect(await boot.readCached(), isNull);\n503:     });\n504: \n505:     test('sha256Hex matches the real committed cam01 bytes', () async {\n506:       final manifestFile = File('assets/fixture_manifest.json');\n507:       expect(await manifestFile.exists(), isTrue,\n508:           reason: 'run from the tv_app package directory');\n509:       final manifestJson = jsonDecode(await manifestFile.readAsString())\n510:           as Map<String, Object?>;\n511:       final clips = (manifestJson['clips'] as List).cast<Map<String, Object?>>();\n512:       final cam01 = clips.singleWhere(\n513:         (c) => c['cameraId'] == 'CAM-01',\n514:         orElse: () => throw StateError('CAM-01 missing from fixture_manifest.json'),\n515:       );\n516:       final expectedSize = cam01['sizeBytes'] as int;\n517:       final expectedSha = cam01['sha256'] as String;\n518:       final file = File('assets/cam01.mp4');\n519:       expect(await file.exists(), isTrue,\n520:           reason: 'run from the tv_app package directory');\n521:       final bytes = await file.readAsBytes();\n522:       expect(bytes.length, expectedSize,\n523:           reason:\n524:               'on-disk cam01 bytes must match the committed fixture_manifest.json');\n525:       expect(\n526:         sha256Hex(bytes),\n527:         expectedSha,\n528:         reason:\n529:             'on-disk cam01 bytes must match the committed fixture_manifest.json',\n530:       );\n531:       // Negative control: the comparison above is not a tautology — tampered\n532:       // bytes must disagree with the committed manifest entry.\n533:       final tampered = List<int>.of(bytes);\n534:       tampered[0] ^= 0xff;\n535:       expect(sha256Hex(tampered), isNot(equals(expectedSha)),\n536:           reason: 'tampered bytes must mismatch the manifest sha256');\n537:       expect(tampered.length + 1, isNot(equals(expectedSize)),\n538:           reason: 'a wrong size must mismatch the manifest sizeBytes');\n539:     });\n540: \n541:     test('boots the real committed fixture manifest end to end', () async {\n542:       // Real-artifact path: the committed assets/fixture_manifest.json flows\n543:       // through the prod loaders (loadBundledFixtureManifest /\n544:       // parseFixtureManifestJson), validates, and verifies all four clips\n545:       // against file-backed asset bytes through the real WallBoot.boot.\n546:       final manifestFile = File('assets/fixture_manifest.json');\n547:       expect(await manifestFile.exists(), isTrue,\n548:           reason: 'run from the tv_app package directory');\n549:       final String raw = await manifestFile.readAsString();\n550:       final PlaybackManifest parsed = await loadBundledFixtureManifest(\n551:         partyId: 'local-party',\n552:         channelId: hauntedSurveillanceChannelId,\n553:         loader: (String key) async {\n554:           expect(key, kBundledFixtureManifestKey);\n555:           return raw;\n556:         },\n557:       );\n558:       expect(validateCctvManifest(parsed).isOk, isTrue,\n559:           reason: 'committed fixture must satisfy the CCTV contract');\n560:       expect(\n561:         parsed.clips.map((ClipDescriptor c) => c.cameraId),\n562:         <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n563:       );\n564: \n565:       Future<List<int>> fileBytes(String assetPath) =>\n566:           File(assetPath).readAsBytes();\n567:       final store = InMemoryManifestStore();\n568:       final boot = WallBoot(\n569:         store: store,\n570:         fixtureLoader: ({required String partyId, required String channelId}) async =>\n571:             parsed,\n572:         assetBytesLoader: fileBytes,\n573:       );\n574:       final result = await boot.boot();\n575:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n576:       expect(result.manifest!.clips, hasLength(4));\n577:       // Every committed clip file exists and matches its manifest entry.\n578:       for (final ClipDescriptor clip in result.manifest!.clips) {\n579:         final List<int> bytes = await File(clip.storageObjectId).readAsBytes();\n580:         expect(bytes.length, clip.sizeBytes,\n581:             reason: '${clip.cameraId} on-disk size must match the manifest');\n582:         expect(sha256Hex(bytes), clip.sha256,\n583:             reason: '${clip.cameraId} on-disk sha must match the manifest');\n584:       }\n585:       // The bundle key boot loads by default is the pubspec asset entry.\n586:       final String pubspec = await File('pubspec.yaml').readAsString();\n587:       expect(pubspec, contains(kBundledFixtureManifestKey));\n588:     });\n589:   });\n590: }\n591: \n592: ChannelRegistry _retroOnlyRegistry() {\n593:   final ChannelRegistry registry = ChannelRegistry();\n594:   // Only the inactive retro stub: resolving the CCTV channel must fail.\n595:   registry.register(_ChannelPluginStub());\n596:   return registry;\n597: }\n598: \n599: /// Minimal plugin used to build a registry without the CCTV channel.\n600: final class _ChannelPluginStub implements ChannelPlugin {\n601:   @override\n602:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n603:         id: 'retro_horror_test',\n604:         title: 'Retro',\n605:         version: 1,\n606:       );\n607: \n608:   @override\n609:   Widget build(ChannelContext context) => const SizedBox.shrink();\n610: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5ba2972f18bf5b2629ef4f173"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_boot_test.dart\"}"},"time":{"start":1793461697723,"end":1793461699095}}}}
{"type":"tool_use","timestamp":1793461699097,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a5bcbc001I09SdlSCRhY0oK","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a5b6e3001EFgOpbTefjbW41","type":"tool","id":"call_01a192a5bba6767bb64773123c9b831d","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_test.dart, lines 1-804\n1: /// Wall widget tests: real channel chrome + app-owned decoders.\n2: library;\n3: \n4: import 'dart:io';\n5: \n6: import 'package:channel_api/channel_api.dart';\n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_cache/core_cache.dart';\n9: import 'package:core_effects/core_effects.dart';\n10: import 'package:core_playlist/core_playlist.dart';\n11: import 'package:core_ui/core_ui.dart';\n12: import 'package:flutter/material.dart';\n13: import 'package:flutter/services.dart';\n14: import 'package:flutter_test/flutter_test.dart';\n15: import 'package:infra_settings/infra_settings.dart' show SharedPreferencesSettings;\n16: import 'package:shared_preferences/shared_preferences.dart';\n17: import 'package:testing_toolkit/testing_toolkit.dart';\n18: import 'package:tv_app/src/playback/camera_tile.dart';\n19: import 'package:tv_app/src/playback/tile_video_controller.dart';\n20: import 'package:tv_app/src/wall/guest_codes.dart';\n21: import 'package:tv_app/src/wall/wall_screen.dart';\n22: \n23: import 'support/fakes.dart';\n24: \n25: Widget wallHarness({\n26:   required PlaybackManifest manifest,\n27:   required TileVideoControllerFactory factory,\n28:   required FakeClock clock,\n29:   Future<PlaybackManifest?> Function()? onRetryCached,\n30:   Map<String, CachedMedia> mediaByClipId = const <String, CachedMedia>{},\n31:   Future<bool> Function(String path)? fileExists,\n32:   SettingsPort? settings,\n33:   bool initialEffectsDisabled = false,\n34:   bool recoveryEnabled = true,\n35:   GuestCodeClient? guestCodeClient,\n36:   String partyId = 'local-party',\n37:   String tvDeviceId = '',\n38: }) {\n39:   return MaterialApp(\n40:     theme: CctvTheme.dark(),\n41:     home: WallScreen(\n42:       plugin: const HauntedSurveillancePlugin(),\n43:       manifest: manifest,\n44:       mediaByClipId: mediaByClipId,\n45:       settings: settings,\n46:       initialEffectsDisabled: initialEffectsDisabled,\n47:       clock: clock,\n48:       profile: cctvProfile(),\n49:       tileControllerFactory: factory,\n50:       onRetryCached: onRetryCached,\n51:       fileExists: fileExists,\n52:       recoveryEnabled: recoveryEnabled,\n53:       guestCodeClient: guestCodeClient,\n54:       partyId: partyId,\n55:       tvDeviceId: tvDeviceId,\n56:     ),\n57:   );\n58: }\n59: \n60: /// Pumps through CctvWall.prepare() + the four tile initialisation futures.\n61: Future<void> pumpWall(WidgetTester tester) async {\n62:   await tester.pump();\n63:   await tester.pump(const Duration(milliseconds: 16));\n64:   await tester.pump();\n65: }\n66: \n67: /// Tears the tree down so periodic HUD/glitch timers are cancelled.\n68: Future<void> teardownWall(WidgetTester tester) async {\n69:   await tester.pumpWidget(const SizedBox.shrink());\n70:   await tester.pump();\n71: }\n72: \n73: PlaybackManifest wallManifest({int version = 1}) => manifestFixture(\n74:       partyId: 'local-party',\n75:       channelId: hauntedSurveillanceChannelId,\n76:       version: version,\n77:     );\n78: \n79: /// Real on-disk bytes for the verified-local-file test.\n80: ///\n81: /// Created once in setUpAll (real async zone): testWidgets bodies run in a\n82: /// FakeAsync zone where real dart:io never completes, so file setup cannot\n83: /// live in the test body.\n84: /// Late-initialized in setUpAll; torn down in tearDownAll.\n85: late Directory wallFilesRoot;\n86: \n87: void main() {\n88:   final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n89: \n90:   setUpAll(() async {\n91:     wallFilesRoot = await Directory.systemTemp.createTemp('tv-wall-files-');\n92:     for (var index = 1; index <= 4; index++) {\n93:       final File file = File('${wallFilesRoot.path}/local-clip-$index.media');\n94:       await file.writeAsBytes(<int>[1, 2, 3, index], flush: true);\n95:     }\n96:   });\n97: \n98:   tearDownAll(() async {\n99:     if (await wallFilesRoot.exists()) {\n100:       await wallFilesRoot.delete(recursive: true);\n101:     }\n102:   });\n103: \n104:   testWidgets('committed clip IDs resolve to their verified local file sources',\n105:       (WidgetTester tester) async {\n106:     final List<ClipDescriptor> clips = <ClipDescriptor>[\n107:       for (var index = 1; index <= 4; index++)\n108:         ClipDescriptor(\n109:           id: 'local-clip-$index',\n110:           cameraId: 'CAM-0$index',\n111:           storageObjectId: 'assets/cam0$index.mp4',\n112:           sha256: sha256Hex(<int>[1, 2, 3, index]),\n113:           sizeBytes: 4,\n114:           duration: const Duration(seconds: 2),\n115:           mimeType: 'video/mp4',\n116:         ),\n117:     ];\n118:     final PlaybackManifest manifest = PlaybackManifest(\n119:       partyId: 'local-party',\n120:       channelId: hauntedSurveillanceChannelId,\n121:       version: 1,\n122:       clips: clips,\n123:       publishedAt: DateTime.utc(2026, 10, 31),\n124:     );\n125:     final Map<String, CachedMedia> media = <String, CachedMedia>{};\n126:     for (var index = 0; index < manifest.clips.length; index++) {\n127:       final ClipDescriptor clip = manifest.clips[index];\n128:       final File file = File('${wallFilesRoot.path}/${clip.id}.media');\n129:       media[clip.id] = CachedMedia(\n130:         clipId: clip.id,\n131:         localRef: file.absolute.path,\n132:         sha256: clip.sha256,\n133:       );\n134:     }\n135:     final Map<String, FakeTileVideoController> sink =\n136:         <String, FakeTileVideoController>{};\n137: \n138:     final Set<String> committedPaths = <String>{\n139:       for (final CachedMedia entry in media.values) entry.localRef,\n140:     };\n141:     await tester.pumpWidget(wallHarness(\n142:       manifest: manifest,\n143:       clock: clock,\n144:       factory: fakeControllerFactory(sink: sink),\n145:       mediaByClipId: media,\n146:       fileExists: (String path) async => committedPaths.contains(path),\n147:     ));\n148:     await pumpWall(tester);\n149: \n150:     for (final ClipDescriptor clip in manifest.clips) {\n151:       expect(sink[clip.cameraId]!.source, isA<LocalFileSource>());\n152:       expect((sink[clip.cameraId]!.source as LocalFileSource).path,\n153:           media[clip.id]!.localRef);\n154:     }\n155:     await teardownWall(tester);\n156:   });\n157: \n158:   testWidgets('effects preference persists by party and restores on the next wall',\n159:       (WidgetTester tester) async {\n160:     SharedPreferences.setMockInitialValues(<String, Object>{});\n161:     final SharedPreferencesSettings settings = SharedPreferencesSettings();\n162:     await tester.pumpWidget(wallHarness(\n163:       manifest: wallManifest(),\n164:       clock: clock,\n165:       factory: fakeControllerFactory(),\n166:       settings: settings,\n167:     ));\n168:     await pumpWall(tester);\n169:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n170:     await tester.pump();\n171:     await tester.tap(find.byKey(const ValueKey<String>('recovery-toggle-effects')));\n172:     await tester.pump();\n173:     expect(await settings.getBool(\n174:       partyId: PartyId('local-party'),\n175:       key: CctvWallSettingsKeys.effectsDisabled,\n176:     ), isTrue);\n177:     expect(await settings.getBool(\n178:       partyId: PartyId('other-party'),\n179:       key: CctvWallSettingsKeys.effectsDisabled,\n180:     ), isNull);\n181:     await teardownWall(tester);\n182: \n183:     await tester.pumpWidget(wallHarness(\n184:       manifest: wallManifest(),\n185:       clock: clock,\n186:       factory: fakeControllerFactory(),\n187:       settings: settings,\n188:       initialEffectsDisabled: await settings.getBool(\n189:         partyId: PartyId('local-party'),\n190:         key: CctvWallSettingsKeys.effectsDisabled,\n191:       ) ?? false,\n192:     ));\n193:     await pumpWall(tester);\n194:     expect(find.byWidgetPredicate(\n195:       (Widget widget) => widget is CctvTile && widget.disableEffects,\n196:     ), findsNWidgets(4));\n197:     await teardownWall(tester);\n198:   });\n199: \n200:   testWidgets('renders four camera tiles with a ticking HUD per tile',\n201:       (WidgetTester tester) async {\n202:     final Map<String, FakeTileVideoController> sink =\n203:         <String, FakeTileVideoController>{};\n204: \n205:     await tester.pumpWidget(\n206:       wallHarness(\n207:         manifest: wallManifest(),\n208:         clock: clock,\n209:         factory: fakeControllerFactory(sink: sink),\n210:       ),\n211:     );\n212:     await pumpWall(tester);\n213: \n214:     expect(find.text('20:00:00'), findsNWidgets(4));\n215:     expect(find.text('REC'), findsNWidgets(4));\n216:     // Labels resolve through core_playlist: manifest clip labels when\n217:     // present, else the canonical slot defaults (owner Q3).\n218:     expect(find.text(cctvSlots[0].defaultLabel), findsOneWidget);\n219:     expect(find.text(cctvSlots[3].defaultLabel), findsOneWidget);\n220:     // The wall sizes itself from the viewport (no scrollable overflow).\n221:     expect(find.byType(Scrollable), findsNothing);\n222: \n223:     for (final String cameraId in <String>[\n224:       'CAM-01',\n225:       'CAM-02',\n226:       'CAM-03',\n227:       'CAM-04',\n228:     ]) {\n229:       expect(\n230:         find.byKey(ValueKey<String>('video-surface-$cameraId')),\n231:         findsOneWidget,\n232:       );\n233:       final FakeTileVideoController controller = sink[cameraId]!;\n234:       expect(controller.calls.first, 'initialize');\n235:       expect(controller.looping, isTrue, reason: 'clips must loop');\n236:       expect(controller.volume, 0, reason: 'the wall is muted');\n237:       expect(controller.playing, isTrue, reason: 'autoplay after init');\n238:     }\n239: \n240:     // The HUD timestamp is a live wall clock, not a frozen string.\n241:     clock.advance(const Duration(hours: 1, minutes: 2, seconds: 3));\n242:     await tester.pump(const Duration(seconds: 1));\n243:     expect(find.text('21:02:03'), findsNWidgets(4));\n244: \n245:     await teardownWall(tester);\n246:     expect(sink['CAM-01']!.disposed, isTrue);\n247:   });\n248: \n249:   testWidgets('D-pad arrows move focus between the four tiles',\n250:       (WidgetTester tester) async {\n251:     await tester.pumpWidget(\n252:       wallHarness(\n253:         manifest: wallManifest(),\n254:         clock: clock,\n255:         factory: fakeControllerFactory(),\n256:       ),\n257:     );\n258:     await pumpWall(tester);\n259: \n260:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n261:         findsOneWidget);\n262: \n263:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);\n264:     await tester.pump();\n265:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n266:         findsOneWidget);\n267:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n268:         findsNothing);\n269: \n270:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowDown);\n271:     await tester.pump();\n272:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-3')),\n273:         findsOneWidget);\n274: \n275:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowUp);\n276:     await tester.pump();\n277:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n278:         findsOneWidget);\n279: \n280:     // Left edge: focus stays put instead of wrapping.\n281:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowLeft);\n282:     await tester.pump();\n283:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowLeft);\n284:     await tester.pump();\n285:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n286:         findsOneWidget);\n287: \n288:     await teardownWall(tester);\n289:   });\n290: \n291:   testWidgets('a decoder that fails to initialize shows SIGNAL LOST only for '\n292:       'that tile', (WidgetTester tester) async {\n293:     await tester.pumpWidget(\n294:       wallHarness(\n295:         manifest: wallManifest(),\n296:         clock: clock,\n297:         factory: fakeControllerFactory(failing: <String>{'CAM-02'}),\n298:       ),\n299:     );\n300:     await pumpWall(tester);\n301: \n302:     expect(find.text('SIGNAL LOST'), findsOneWidget);\n303:     // Wall survives: the other three feeds keep playing...\n304:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n305:         findsOneWidget);\n306:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-03')),\n307:         findsOneWidget);\n308:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-04')),\n309:         findsOneWidget);\n310:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-02')),\n311:         findsNothing);\n312:     // ...and the failed tile keeps its HUD identity.\n313:     expect(find.text(cctvSlots[1].defaultLabel), findsOneWidget);\n314: \n315:     await teardownWall(tester);\n316:   });\n317: \n318:   testWidgets('a late decoder error flips a live tile to SIGNAL LOST',\n319:       (WidgetTester tester) async {\n320:     final Map<String, FakeTileVideoController> sink =\n321:         <String, FakeTileVideoController>{};\n322:     await tester.pumpWidget(\n323:       wallHarness(\n324:         manifest: wallManifest(),\n325:         clock: clock,\n326:         factory: fakeControllerFactory(sink: sink),\n327:       ),\n328:     );\n329:     await pumpWall(tester);\n330:     expect(find.text('SIGNAL LOST'), findsNothing);\n331: \n332:     sink['CAM-03']!.emitError();\n333:     await tester.pump();\n334: \n335:     expect(find.text('SIGNAL LOST'), findsOneWidget);\n336:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n337:         findsOneWidget);\n338: \n339:     await teardownWall(tester);\n340:   });\n341: \n342:   testWidgets('recovery panel is hidden until OK long-press or MENU',\n343:       (WidgetTester tester) async {\n344:     await tester.pumpWidget(\n345:       wallHarness(\n346:         manifest: wallManifest(),\n347:         clock: clock,\n348:         factory: fakeControllerFactory(),\n349:       ),\n350:     );\n351:     await pumpWall(tester);\n352: \n353:     expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n354: \n355:     // MENU key reveals the panel.\n356:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n357:     await tester.pump();\n358:     await tester.pump();\n359:     expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n360:     expect(find.text('RETRY CACHED WALL'), findsOneWidget);\n361:     expect(find.text('DISABLE EFFECTS'), findsOneWidget);\n362: \n363:     // Focus is trapped inside the panel: the first action owns it and D-pad\n364:     // input no longer moves wall tiles behind the overlay.\n365:     final OutlinedButton retryButton = tester.widget<OutlinedButton>(\n366:       find.byKey(const ValueKey<String>('recovery-retry')),\n367:     );\n368:     expect(retryButton.focusNode!.hasFocus, isTrue);\n369:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowDown);\n370:     await tester.pump();\n371:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n372:         findsNothing);\n373: \n374:     // MENU closes it again.\n375:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n376:     await tester.pump();\n377:     expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n378:     // ...and focus returns to the wall (post-frame restore + tile rebuild).\n379:     await tester.pump();\n380:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n381:         findsOneWidget);\n382: \n383:     // OK long-press also reveals it.\n384:     await tester.sendKeyDownEvent(LogicalKeyboardKey.select);\n385:     await tester.pump(const Duration(milliseconds: 700));\n386:     expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n387:     await tester.sendKeyUpEvent(LogicalKeyboardKey.select);\n388:     await tester.pump();\n389: \n390:     await teardownWall(tester);\n391:   });\n392: \n393:   testWidgets('recovery panel can disable effect overlays',\n394:       (WidgetTester tester) async {\n395:     await tester.pumpWidget(\n396:       wallHarness(\n397:         manifest: wallManifest(),\n398:         clock: clock,\n399:         factory: fakeControllerFactory(),\n400:       ),\n401:     );\n402:     await pumpWall(tester);\n403: \n404:     expect(\n405:       find.byWidgetPredicate(\n406:         (Widget widget) => widget is CustomPaint &&\n407:             widget.painter is ScanlinesPainter,\n408:       ),\n409:       findsWidgets,\n410:       reason: 'cctv profile draws scanlines over every tile',\n411:     );\n412: \n413:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n414:     await tester.pump();\n415:     await tester.tap(\n416:       find.byKey(const ValueKey<String>('recovery-toggle-effects')),\n417:     );\n418:     await tester.pump();\n419:     await tester.pump();\n420: \n421:     expect(\n422:       find.byWidgetPredicate(\n423:         (Widget widget) => widget is CustomPaint &&\n424:             widget.painter is ScanlinesPainter,\n425:       ),\n426:       findsNothing,\n427:     );\n428:     expect(\n429:       find.byWidgetPredicate(\n430:         (Widget widget) => widget is CctvTile && widget.disableEffects,\n431:       ),\n432:       findsNWidgets(4),\n433:     );\n434:     // Video keeps playing while effects are off.\n435:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n436:         findsOneWidget);\n437: \n438:     await teardownWall(tester);\n439:   });\n440: \n441:   testWidgets('retry cached wall reuses decoders within a budget of 4',\n442:       (WidgetTester tester) async {\n443:     final List<String> events = <String>[];\n444:     int live = 0;\n445:     int maxLive = 0;\n446:     final Map<String, FakeTileVideoController> sink =\n447:         <String, FakeTileVideoController>{};\n448:     TileVideoController trackingFactory({\n449:       required String cameraId,\n450:       required TileMediaSource source,\n451:     }) {\n452:       final FakeTileVideoController inner = FakeTileVideoController(\n453:         cameraId: cameraId,\n454:         source: source,\n455:       );\n456:       sink[cameraId] = inner;\n457:       return _LiveBudgetController(\n458:         inner: inner,\n459:         onInitialize: () {\n460:           live++;\n461:           if (live > maxLive) {\n462:             maxLive = live;\n463:           }\n464:           events.add('init $cameraId');\n465:         },\n466:         onDispose: () {\n467:           events.add('dispose $cameraId');\n468:           live--;\n469:         },\n470:       );\n471:     }\n472: \n473:     final PlaybackManifest cached = wallManifest(version: 9);\n474: \n475:     await tester.pumpWidget(\n476:       wallHarness(\n477:         manifest: wallManifest(),\n478:         clock: clock,\n479:         factory: trackingFactory,\n480:         onRetryCached: () async => cached,\n481:       ),\n482:     );\n483:     await pumpWall(tester);\n484:     expect(sink, hasLength(4));\n485:     expect(maxLive, 4);\n486: \n487:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n488:     await tester.pump();\n489:     await tester.tap(find.byKey(const ValueKey<String>('recovery-retry')));\n490:     await tester.pump();\n491:     await tester.pump();\n492:     await tester.pump(const Duration(milliseconds: 16));\n493: \n494:     expect(find.text('WALL RESTORED · v9'), findsOneWidget);\n495:     expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n496:     // Same camera set: stable cameraId tile keys reuse the four decoders\n497:     // instead of transiently doubling to 8 (dispose-before-create budget).\n498:     expect(maxLive, lessThanOrEqualTo(4));\n499:     expect(events.where((String e) => e.startsWith('init')), hasLength(4));\n500:     expect(events.where((String e) => e.startsWith('dispose')), isEmpty);\n501:     expect(live, 4);\n502:     for (final String cameraId in <String>[\n503:       'CAM-01',\n504:       'CAM-02',\n505:       'CAM-03',\n506:       'CAM-04',\n507:     ]) {\n508:       expect(\n509:         find.byKey(ValueKey<String>('video-surface-$cameraId')),\n510:         findsOneWidget,\n511:       );\n512:       expect(sink[cameraId]!.disposed, isFalse);\n513:     }\n514: \n515:     await teardownWall(tester);\n516:     expect(live, 0);\n517:   });\n518: \n519:   testWidgets('retry without a cached wall keeps the current feed',\n520:       (WidgetTester tester) async {\n521:     await tester.pumpWidget(\n522:       wallHarness(\n523:         manifest: wallManifest(),\n524:         clock: clock,\n525:         factory: fakeControllerFactory(),\n526:         onRetryCached: () async => null,\n527:       ),\n528:     );\n529:     await pumpWall(tester);\n530: \n531:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n532:     await tester.pump();\n533:     await tester.tap(find.byKey(const ValueKey<String>('recovery-retry')));\n534:     await tester.pump();\n535:     await tester.pump();\n536: \n537:     expect(find.text('NO CACHED WALL · KEEPING CURRENT FEED'),\n538:         findsOneWidget);\n539:     expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n540:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n541:         findsOneWidget);\n542: \n543:     await teardownWall(tester);\n544:   });\n545: \n546:   testWidgets('wall fits the viewport at 960x540 and 1280x720',\n547:       (WidgetTester tester) async {\n548:     addTearDown(tester.view.resetPhysicalSize);\n549:     addTearDown(tester.view.resetDevicePixelRatio);\n550:     for (final Size size in <Size>[\n551:       const Size(960, 540),\n552:       const Size(1280, 720),\n553:     ]) {\n554:       tester.view.physicalSize = size;\n555:       tester.view.devicePixelRatio = 1.0;\n556:       await tester.pumpWidget(\n557:         wallHarness(\n558:           manifest: wallManifest(),\n559:           clock: clock,\n560:           factory: fakeControllerFactory(),\n561:         ),\n562:       );\n563:       await pumpWall(tester);\n564: \n565:       final Rect viewport = Offset.zero & size;\n566:       for (final String cameraId in <String>[\n567:         'CAM-01',\n568:         'CAM-02',\n569:         'CAM-03',\n570:         'CAM-04',\n571:       ]) {\n572:         final Finder surface =\n573:             find.byKey(ValueKey<String>('video-surface-$cameraId'));\n574:         expect(surface, findsOneWidget);\n575:         final Rect rect = tester.getRect(surface);\n576:         expect(rect.width, greaterThan(0));\n577:         expect(rect.height, greaterThan(0));\n578:         expect(\n579:           viewport.contains(rect.topLeft) &&\n580:               viewport.contains(rect.bottomRight),\n581:           isTrue,\n582:           reason: '$cameraId rect $rect must sit fully on-screen at $size',\n583:         );\n584:         // The tile (surface + HUD + focus chrome) is what the D-pad\n585:         // drives: it must be fully on-screen and hit-testable. (The raw\n586:         // surface sits under tile chrome, so hit-testing targets the tile.)\n587:         final Finder tile =\n588:             find.byKey(ValueKey<String>('camera-tile-$cameraId'));\n589:         expect(tile, findsOneWidget);\n590:         final Rect tileRect = tester.getRect(tile);\n591:         expect(\n592:           viewport.contains(tileRect.topLeft) &&\n593:               viewport.contains(tileRect.bottomRight),\n594:           isTrue,\n595:           reason:\n596:               '$cameraId tile $tileRect must sit fully on-screen at $size',\n597:         );\n598:         expect(\n599:           tile.hitTestable(),\n600:           findsOneWidget,\n601:           reason: '$cameraId must be hit-testable at $size',\n602:         );\n603:       }\n604:       // No scrollable: the whole wall is laid out from viewport constraints.\n605:       expect(find.byType(Scrollable), findsNothing);\n606:       expect(tester.takeException(), isNull);\n607: \n608:       await teardownWall(tester);\n609:     }\n610:   });\n611: \n612:   testWidgets('CameraTile swaps feeds dispose-before-create',\n613:       (WidgetTester tester) async {\n614:     final List<String> events = <String>[];\n615:     final Map<String, FakeTileVideoController> innerSink =\n616:         <String, FakeTileVideoController>{};\n617:     TileVideoController trackingFactory({\n618:       required String cameraId,\n619:       required TileMediaSource source,\n620:     }) {\n621:       final FakeTileVideoController inner = FakeTileVideoController(\n622:         cameraId: cameraId,\n623:         source: source,\n624:       );\n625:       innerSink['$cameraId#${inner.hashCode}'] = inner;\n626:       return _LiveBudgetController(\n627:         inner: inner,\n628:         onInitialize: () => events.add('init $cameraId'),\n629:         onDispose: () => events.add('dispose $cameraId'),\n630:       );\n631:     }\n632: \n633:     final FocusNode focusNode = FocusNode(debugLabel: 'swap-tile');\n634:     addTearDown(focusNode.dispose);\n635:     Widget harness(String cameraId) => MaterialApp(\n636:           home: Scaffold(\n637:             body: CameraTile(\n638:               key: const ValueKey<String>('slot-0'),\n639:               index: 0,\n640:               cameraId: cameraId,\n641:               source: BundledAssetSource('assets/${cameraId.toLowerCase()}.mp4'),\n642:               focusNode: focusNode,\n643:               controllerFactory: trackingFactory,\n644:             ),\n645:           ),\n646:         );\n647: \n648:     await tester.pumpWidget(harness('CAM-01'));\n649:     await tester.pump();\n650:     await tester.pump();\n651:     expect(\n652:       find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n653:       findsOneWidget,\n654:     );\n655: \n656:     await tester.pumpWidget(harness('CAM-02'));\n657:     await tester.pump();\n658:     await tester.pump();\n659:     await tester.pump();\n660:     expect(\n661:       find.byKey(const ValueKey<String>('video-surface-CAM-02')),\n662:       findsOneWidget,\n663:     );\n664:     expect(\n665:       find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n666:       findsNothing,\n667:     );\n668:     // The old decoder was released before the replacement initialized.\n669:     expect(events, <String>['init CAM-01', 'dispose CAM-01', 'init CAM-02']);\n670:     expect(tester.takeException(), isNull);\n671: \n672:     await tester.pumpWidget(const SizedBox.shrink());\n673:     await tester.pump();\n674:   });\n675: \n676:   testWidgets('failed local decoder restores the previous bundled source',\n677:       (WidgetTester tester) async {\n678:     final List<FakeTileVideoController> controllers =\n679:         <FakeTileVideoController>[];\n680:     int liveDecoders = 0;\n681:     int maximumLiveDecoders = 0;\n682:     bool? settled;\n683:     TileVideoController rollbackFactory({\n684:       required String cameraId,\n685:       required TileMediaSource source,\n686:     }) {\n687:       final FakeTileVideoController inner = FakeTileVideoController(\n688:         cameraId: cameraId,\n689:         source: source,\n690:         failOnInitialize: source is LocalFileSource,\n691:       );\n692:       controllers.add(inner);\n693:       return _LiveBudgetController(\n694:         inner: inner,\n695:         onInitialize: () {\n696:           liveDecoders++;\n697:           if (liveDecoders > maximumLiveDecoders) {\n698:             maximumLiveDecoders = liveDecoders;\n699:           }\n700:         },\n701:         onDispose: () {\n702:           if (inner.isInitialized) liveDecoders--;\n703:         },\n704:       );\n705:     }\n706: \n707:     final FocusNode focusNode = FocusNode(debugLabel: 'rollback-tile');\n708:     addTearDown(focusNode.dispose);\n709:     Widget tile(TileMediaSource source) => MaterialApp(\n710:           home: Scaffold(\n711:             body: CameraTile(\n712:               key: const ValueKey<String>('rollback-slot'),\n713:               index: 0,\n714:               cameraId: 'CAM-01',\n715:               source: source,\n716:               focusNode: focusNode,\n717:               controllerFactory: rollbackFactory,\n718:               onSourceSettled: (bool success) => settled = success,\n719:             ),\n720:           ),\n721:         );\n722: \n723:     const BundledAssetSource previous = BundledAssetSource('assets/cam01.mp4');\n724:     await tester.pumpWidget(tile(previous));\n725:     await tester.pump();\n726:     await tester.pump();\n727:     expect(find.text('LIVE CAM-01'), findsOneWidget);\n728: \n729:     await tester.pumpWidget(tile(const LocalFileSource('/cache/rejected.mp4')));\n730:     for (var frame = 0; frame < 8; frame++) {\n731:       await tester.pump(const Duration(milliseconds: 1));\n732:     }\n733: \n734:     expect(settled, isFalse);\n735:     expect(find.text('LIVE CAM-01'), findsOneWidget);\n736:     expect(find.text('SIGNAL LOST'), findsNothing);\n737:     expect(controllers, hasLength(3));\n738:     expect(controllers[0].disposed, isTrue);\n739:     expect(controllers[1].disposed, isTrue);\n740:     expect(controllers[2].source, previous);\n741:     expect(controllers[2].playing, isTrue);\n742:     expect(maximumLiveDecoders, 1);\n743: \n744:     await tester.pumpWidget(const SizedBox.shrink());\n745:     await tester.pump();\n746:     expect(liveDecoders, 0);\n747:   });\n748: }\n749: \n750: /// [TileVideoController] decorator tracking decoder-budget events.\n751: ///\n752: /// Delegates everything to [inner] while reporting lifecycle transitions,\n753: /// so tests can assert the wall never exceeds its live-decoder budget.\n754: final class _LiveBudgetController implements TileVideoController {\n755:   _LiveBudgetController({\n756:     required this.inner,\n757:     required this.onInitialize,\n758:     required this.onDispose,\n759:   });\n760: \n761:   final FakeTileVideoController inner;\n762:   final void Function() onInitialize;\n763:   final void Function() onDispose;\n764: \n765:   @override\n766:   Future<void> initialize() async {\n767:     await inner.initialize();\n768:     onInitialize();\n769:   }\n770: \n771:   @override\n772:   bool get isInitialized => inner.isInitialized;\n773: \n774:   @override\n775:   bool get hasError => inner.hasError;\n776: \n777:   @override\n778:   String? get errorDescription => inner.errorDescription;\n779: \n780:   @override\n781:   Widget buildSurface(BuildContext context) => inner.buildSurface(context);\n782: \n783:   @override\n784:   Future<void> setLooping(bool looping) => inner.setLooping(looping);\n785: \n786:   @override\n787:   Future<void> setVolume(double volume) => inner.setVolume(volume);\n788: \n789:   @override\n790:   Future<void> play() => inner.play();\n791: \n792:   @override\n793:   void addListener(VoidCallback listener) => inner.addListener(listener);\n794: \n795:   @override\n796:   void removeListener(VoidCallback listener) =>\n797:       inner.removeListener(listener);\n798: \n799:   @override\n800:   Future<void> dispose() async {\n801:     await inner.dispose();\n802:     onDispose();\n803:   }\n804: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_test.dart, lines 1-804\n1: /// Wall widget tests: real channel chrome + app-owned decoders.\n2: library;\n3: \n4: import 'dart:io';\n5: \n6: import 'package:channel_api/channel_api.dart';\n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_cache/core_cache.dart';\n9: import 'package:core_effects/core_effects.dart';\n10: import 'package:core_playlist/core_playlist.dart';\n11: import 'package:core_ui/core_ui.dart';\n12: import 'package:flutter/material.dart';\n13: import 'package:flutter/services.dart';\n14: import 'package:flutter_test/flutter_test.dart';\n15: import 'package:infra_settings/infra_settings.dart' show SharedPreferencesSettings;\n16: import 'package:shared_preferences/shared_preferences.dart';\n17: import 'package:testing_toolkit/testing_toolkit.dart';\n18: import 'package:tv_app/src/playback/camera_tile.dart';\n19: import 'package:tv_app/src/playback/tile_video_controller.dart';\n20: import 'package:tv_app/src/wall/guest_codes.dart';\n21: import 'package:tv_app/src/wall/wall_screen.dart';\n22: \n23: import 'support/fakes.dart';\n24: \n25: Widget wallHarness({\n26:   required PlaybackManifest manifest,\n27:   required TileVideoControllerFactory factory,\n28:   required FakeClock clock,\n29:   Future<PlaybackManifest?> Function()? onRetryCached,\n30:   Map<String, CachedMedia> mediaByClipId = const <String, CachedMedia>{},\n31:   Future<bool> Function(String path)? fileExists,\n32:   SettingsPort? settings,\n33:   bool initialEffectsDisabled = false,\n34:   bool recoveryEnabled = true,\n35:   GuestCodeClient? guestCodeClient,\n36:   String partyId = 'local-party',\n37:   String tvDeviceId = '',\n38: }) {\n39:   return MaterialApp(\n40:     theme: CctvTheme.dark(),\n41:     home: WallScreen(\n42:       plugin: const HauntedSurveillancePlugin(),\n43:       manifest: manifest,\n44:       mediaByClipId: mediaByClipId,\n45:       settings: settings,\n46:       initialEffectsDisabled: initialEffectsDisabled,\n47:       clock: clock,\n48:       profile: cctvProfile(),\n49:       tileControllerFactory: factory,\n50:       onRetryCached: onRetryCached,\n51:       fileExists: fileExists,\n52:       recoveryEnabled: recoveryEnabled,\n53:       guestCodeClient: guestCodeClient,\n54:       partyId: partyId,\n55:       tvDeviceId: tvDeviceId,\n56:     ),\n57:   );\n58: }\n59: \n60: /// Pumps through CctvWall.prepare() + the four tile initialisation futures.\n61: Future<void> pumpWall(WidgetTester tester) async {\n62:   await tester.pump();\n63:   await tester.pump(const Duration(milliseconds: 16));\n64:   await tester.pump();\n65: }\n66: \n67: /// Tears the tree down so periodic HUD/glitch timers are cancelled.\n68: Future<void> teardownWall(WidgetTester tester) async {\n69:   await tester.pumpWidget(const SizedBox.shrink());\n70:   await tester.pump();\n71: }\n72: \n73: PlaybackManifest wallManifest({int version = 1}) => manifestFixture(\n74:       partyId: 'local-party',\n75:       channelId: hauntedSurveillanceChannelId,\n76:       version: version,\n77:     );\n78: \n79: /// Real on-disk bytes for the verified-local-file test.\n80: ///\n81: /// Created once in setUpAll (real async zone): testWidgets bodies run in a\n82: /// FakeAsync zone where real dart:io never completes, so file setup cannot\n83: /// live in the test body.\n84: /// Late-initialized in setUpAll; torn down in tearDownAll.\n85: late Directory wallFilesRoot;\n86: \n87: void main() {\n88:   final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n89: \n90:   setUpAll(() async {\n91:     wallFilesRoot = await Directory.systemTemp.createTemp('tv-wall-files-');\n92:     for (var index = 1; index <= 4; index++) {\n93:       final File file = File('${wallFilesRoot.path}/local-clip-$index.media');\n94:       await file.writeAsBytes(<int>[1, 2, 3, index], flush: true);\n95:     }\n96:   });\n97: \n98:   tearDownAll(() async {\n99:     if (await wallFilesRoot.exists()) {\n100:       await wallFilesRoot.delete(recursive: true);\n101:     }\n102:   });\n103: \n104:   testWidgets('committed clip IDs resolve to their verified local file sources',\n105:       (WidgetTester tester) async {\n106:     final List<ClipDescriptor> clips = <ClipDescriptor>[\n107:       for (var index = 1; index <= 4; index++)\n108:         ClipDescriptor(\n109:           id: 'local-clip-$index',\n110:           cameraId: 'CAM-0$index',\n111:           storageObjectId: 'assets/cam0$index.mp4',\n112:           sha256: sha256Hex(<int>[1, 2, 3, index]),\n113:           sizeBytes: 4,\n114:           duration: const Duration(seconds: 2),\n115:           mimeType: 'video/mp4',\n116:         ),\n117:     ];\n118:     final PlaybackManifest manifest = PlaybackManifest(\n119:       partyId: 'local-party',\n120:       channelId: hauntedSurveillanceChannelId,\n121:       version: 1,\n122:       clips: clips,\n123:       publishedAt: DateTime.utc(2026, 10, 31),\n124:     );\n125:     final Map<String, CachedMedia> media = <String, CachedMedia>{};\n126:     for (var index = 0; index < manifest.clips.length; index++) {\n127:       final ClipDescriptor clip = manifest.clips[index];\n128:       final File file = File('${wallFilesRoot.path}/${clip.id}.media');\n129:       media[clip.id] = CachedMedia(\n130:         clipId: clip.id,\n131:         localRef: file.absolute.path,\n132:         sha256: clip.sha256,\n133:       );\n134:     }\n135:     final Map<String, FakeTileVideoController> sink =\n136:         <String, FakeTileVideoController>{};\n137: \n138:     final Set<String> committedPaths = <String>{\n139:       for (final CachedMedia entry in media.values) entry.localRef,\n140:     };\n141:     await tester.pumpWidget(wallHarness(\n142:       manifest: manifest,\n143:       clock: clock,\n144:       factory: fakeControllerFactory(sink: sink),\n145:       mediaByClipId: media,\n146:       fileExists: (String path) async => committedPaths.contains(path),\n147:     ));\n148:     await pumpWall(tester);\n149: \n150:     for (final ClipDescriptor clip in manifest.clips) {\n151:       expect(sink[clip.cameraId]!.source, isA<LocalFileSource>());\n152:       expect((sink[clip.cameraId]!.source as LocalFileSource).path,\n153:           media[clip.id]!.localRef);\n154:     }\n155:     await teardownWall(tester);\n156:   });\n157: \n158:   testWidgets('effects preference persists by party and restores on the next wall',\n159:       (WidgetTester tester) async {\n160:     SharedPreferences.setMockInitialValues(<String, Object>{});\n161:     final SharedPreferencesSettings settings = SharedPreferencesSettings();\n162:     await tester.pumpWidget(wallHarness(\n163:       manifest: wallManifest(),\n164:       clock: clock,\n165:       factory: fakeControllerFactory(),\n166:       settings: settings,\n167:     ));\n168:     await pumpWall(tester);\n169:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n170:     await tester.pump();\n171:     await tester.tap(find.byKey(const ValueKey<String>('recovery-toggle-effects')));\n172:     await tester.pump();\n173:     expect(await settings.getBool(\n174:       partyId: PartyId('local-party'),\n175:       key: CctvWallSettingsKeys.effectsDisabled,\n176:     ), isTrue);\n177:     expect(await settings.getBool(\n178:       partyId: PartyId('other-party'),\n179:       key: CctvWallSettingsKeys.effectsDisabled,\n180:     ), isNull);\n181:     await teardownWall(tester);\n182: \n183:     await tester.pumpWidget(wallHarness(\n184:       manifest: wallManifest(),\n185:       clock: clock,\n186:       factory: fakeControllerFactory(),\n187:       settings: settings,\n188:       initialEffectsDisabled: await settings.getBool(\n189:         partyId: PartyId('local-party'),\n190:         key: CctvWallSettingsKeys.effectsDisabled,\n191:       ) ?? false,\n192:     ));\n193:     await pumpWall(tester);\n194:     expect(find.byWidgetPredicate(\n195:       (Widget widget) => widget is CctvTile && widget.disableEffects,\n196:     ), findsNWidgets(4));\n197:     await teardownWall(tester);\n198:   });\n199: \n200:   testWidgets('renders four camera tiles with a ticking HUD per tile',\n201:       (WidgetTester tester) async {\n202:     final Map<String, FakeTileVideoController> sink =\n203:         <String, FakeTileVideoController>{};\n204: \n205:     await tester.pumpWidget(\n206:       wallHarness(\n207:         manifest: wallManifest(),\n208:         clock: clock,\n209:         factory: fakeControllerFactory(sink: sink),\n210:       ),\n211:     );\n212:     await pumpWall(tester);\n213: \n214:     expect(find.text('20:00:00'), findsNWidgets(4));\n215:     expect(find.text('REC'), findsNWidgets(4));\n216:     // Labels resolve through core_playlist: manifest clip labels when\n217:     // present, else the canonical slot defaults (owner Q3).\n218:     expect(find.text(cctvSlots[0].defaultLabel), findsOneWidget);\n219:     expect(find.text(cctvSlots[3].defaultLabel), findsOneWidget);\n220:     // The wall sizes itself from the viewport (no scrollable overflow).\n221:     expect(find.byType(Scrollable), findsNothing);\n222: \n223:     for (final String cameraId in <String>[\n224:       'CAM-01',\n225:       'CAM-02',\n226:       'CAM-03',\n227:       'CAM-04',\n228:     ]) {\n229:       expect(\n230:         find.byKey(ValueKey<String>('video-surface-$cameraId')),\n231:         findsOneWidget,\n232:       );\n233:       final FakeTileVideoController controller = sink[cameraId]!;\n234:       expect(controller.calls.first, 'initialize');\n235:       expect(controller.looping, isTrue, reason: 'clips must loop');\n236:       expect(controller.volume, 0, reason: 'the wall is muted');\n237:       expect(controller.playing, isTrue, reason: 'autoplay after init');\n238:     }\n239: \n240:     // The HUD timestamp is a live wall clock, not a frozen string.\n241:     clock.advance(const Duration(hours: 1, minutes: 2, seconds: 3));\n242:     await tester.pump(const Duration(seconds: 1));\n243:     expect(find.text('21:02:03'), findsNWidgets(4));\n244: \n245:     await teardownWall(tester);\n246:     expect(sink['CAM-01']!.disposed, isTrue);\n247:   });\n248: \n249:   testWidgets('D-pad arrows move focus between the four tiles',\n250:       (WidgetTester tester) async {\n251:     await tester.pumpWidget(\n252:       wallHarness(\n253:         manifest: wallManifest(),\n254:         clock: clock,\n255:         factory: fakeControllerFactory(),\n256:       ),\n257:     );\n258:     await pumpWall(tester);\n259: \n260:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n261:         findsOneWidget);\n262: \n263:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);\n264:     await tester.pump();\n265:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n266:         findsOneWidget);\n267:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n268:         findsNothing);\n269: \n270:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowDown);\n271:     await tester.pump();\n272:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-3')),\n273:         findsOneWidget);\n274: \n275:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowUp);\n276:     await tester.pump();\n277:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n278:         findsOneWidget);\n279: \n280:     // Left edge: focus stays put instead of wrapping.\n281:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowLeft);\n282:     await tester.pump();\n283:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowLeft);\n284:     await tester.pump();\n285:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n286:         findsOneWidget);\n287: \n288:     await teardownWall(tester);\n289:   });\n290: \n291:   testWidgets('a decoder that fails to initialize shows SIGNAL LOST only for '\n292:       'that tile', (WidgetTester tester) async {\n293:     await tester.pumpWidget(\n294:       wallHarness(\n295:         manifest: wallManifest(),\n296:         clock: clock,\n297:         factory: fakeControllerFactory(failing: <String>{'CAM-02'}),\n298:       ),\n299:     );\n300:     await pumpWall(tester);\n301: \n302:     expect(find.text('SIGNAL LOST'), findsOneWidget);\n303:     // Wall survives: the other three feeds keep playing...\n304:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n305:         findsOneWidget);\n306:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-03')),\n307:         findsOneWidget);\n308:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-04')),\n309:         findsOneWidget);\n310:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-02')),\n311:         findsNothing);\n312:     // ...and the failed tile keeps its HUD identity.\n313:     expect(find.text(cctvSlots[1].defaultLabel), findsOneWidget);\n314: \n315:     await teardownWall(tester);\n316:   });\n317: \n318:   testWidgets('a late decoder error flips a live tile to SIGNAL LOST',\n319:       (WidgetTester tester) async {\n320:     final Map<String, FakeTileVideoController> sink =\n321:         <String, FakeTileVideoController>{};\n322:     await tester.pumpWidget(\n323:       wallHarness(\n324:         manifest: wallManifest(),\n325:         clock: clock,\n326:         factory: fakeControllerFactory(sink: sink),\n327:       ),\n328:     );\n329:     await pumpWall(tester);\n330:     expect(find.text('SIGNAL LOST'), findsNothing);\n331: \n332:     sink['CAM-03']!.emitError();\n333:     await tester.pump();\n334: \n335:     expect(find.text('SIGNAL LOST'), findsOneWidget);\n336:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n337:         findsOneWidget);\n338: \n339:     await teardownWall(tester);\n340:   });\n341: \n342:   testWidgets('recovery panel is hidden until OK long-press or MENU',\n343:       (WidgetTester tester) async {\n344:     await tester.pumpWidget(\n345:       wallHarness(\n346:         manifest: wallManifest(),\n347:         clock: clock,\n348:         factory: fakeControllerFactory(),\n349:       ),\n350:     );\n351:     await pumpWall(tester);\n352: \n353:     expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n354: \n355:     // MENU key reveals the panel.\n356:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n357:     await tester.pump();\n358:     await tester.pump();\n359:     expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n360:     expect(find.text('RETRY CACHED WALL'), findsOneWidget);\n361:     expect(find.text('DISABLE EFFECTS'), findsOneWidget);\n362: \n363:     // Focus is trapped inside the panel: the first action owns it and D-pad\n364:     // input no longer moves wall tiles behind the overlay.\n365:     final OutlinedButton retryButton = tester.widget<OutlinedButton>(\n366:       find.byKey(const ValueKey<String>('recovery-retry')),\n367:     );\n368:     expect(retryButton.focusNode!.hasFocus, isTrue);\n369:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowDown);\n370:     await tester.pump();\n371:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n372:         findsNothing);\n373: \n374:     // MENU closes it again.\n375:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n376:     await tester.pump();\n377:     expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n378:     // ...and focus returns to the wall (post-frame restore + tile rebuild).\n379:     await tester.pump();\n380:     expect(find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n381:         findsOneWidget);\n382: \n383:     // OK long-press also reveals it.\n384:     await tester.sendKeyDownEvent(LogicalKeyboardKey.select);\n385:     await tester.pump(const Duration(milliseconds: 700));\n386:     expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n387:     await tester.sendKeyUpEvent(LogicalKeyboardKey.select);\n388:     await tester.pump();\n389: \n390:     await teardownWall(tester);\n391:   });\n392: \n393:   testWidgets('recovery panel can disable effect overlays',\n394:       (WidgetTester tester) async {\n395:     await tester.pumpWidget(\n396:       wallHarness(\n397:         manifest: wallManifest(),\n398:         clock: clock,\n399:         factory: fakeControllerFactory(),\n400:       ),\n401:     );\n402:     await pumpWall(tester);\n403: \n404:     expect(\n405:       find.byWidgetPredicate(\n406:         (Widget widget) => widget is CustomPaint &&\n407:             widget.painter is ScanlinesPainter,\n408:       ),\n409:       findsWidgets,\n410:       reason: 'cctv profile draws scanlines over every tile',\n411:     );\n412: \n413:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n414:     await tester.pump();\n415:     await tester.tap(\n416:       find.byKey(const ValueKey<String>('recovery-toggle-effects')),\n417:     );\n418:     await tester.pump();\n419:     await tester.pump();\n420: \n421:     expect(\n422:       find.byWidgetPredicate(\n423:         (Widget widget) => widget is CustomPaint &&\n424:             widget.painter is ScanlinesPainter,\n425:       ),\n426:       findsNothing,\n427:     );\n428:     expect(\n429:       find.byWidgetPredicate(\n430:         (Widget widget) => widget is CctvTile && widget.disableEffects,\n431:       ),\n432:       findsNWidgets(4),\n433:     );\n434:     // Video keeps playing while effects are off.\n435:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n436:         findsOneWidget);\n437: \n438:     await teardownWall(tester);\n439:   });\n440: \n441:   testWidgets('retry cached wall reuses decoders within a budget of 4',\n442:       (WidgetTester tester) async {\n443:     final List<String> events = <String>[];\n444:     int live = 0;\n445:     int maxLive = 0;\n446:     final Map<String, FakeTileVideoController> sink =\n447:         <String, FakeTileVideoController>{};\n448:     TileVideoController trackingFactory({\n449:       required String cameraId,\n450:       required TileMediaSource source,\n451:     }) {\n452:       final FakeTileVideoController inner = FakeTileVideoController(\n453:         cameraId: cameraId,\n454:         source: source,\n455:       );\n456:       sink[cameraId] = inner;\n457:       return _LiveBudgetController(\n458:         inner: inner,\n459:         onInitialize: () {\n460:           live++;\n461:           if (live > maxLive) {\n462:             maxLive = live;\n463:           }\n464:           events.add('init $cameraId');\n465:         },\n466:         onDispose: () {\n467:           events.add('dispose $cameraId');\n468:           live--;\n469:         },\n470:       );\n471:     }\n472: \n473:     final PlaybackManifest cached = wallManifest(version: 9);\n474: \n475:     await tester.pumpWidget(\n476:       wallHarness(\n477:         manifest: wallManifest(),\n478:         clock: clock,\n479:         factory: trackingFactory,\n480:         onRetryCached: () async => cached,\n481:       ),\n482:     );\n483:     await pumpWall(tester);\n484:     expect(sink, hasLength(4));\n485:     expect(maxLive, 4);\n486: \n487:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n488:     await tester.pump();\n489:     await tester.tap(find.byKey(const ValueKey<String>('recovery-retry')));\n490:     await tester.pump();\n491:     await tester.pump();\n492:     await tester.pump(const Duration(milliseconds: 16));\n493: \n494:     expect(find.text('WALL RESTORED · v9'), findsOneWidget);\n495:     expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n496:     // Same camera set: stable cameraId tile keys reuse the four decoders\n497:     // instead of transiently doubling to 8 (dispose-before-create budget).\n498:     expect(maxLive, lessThanOrEqualTo(4));\n499:     expect(events.where((String e) => e.startsWith('init')), hasLength(4));\n500:     expect(events.where((String e) => e.startsWith('dispose')), isEmpty);\n501:     expect(live, 4);\n502:     for (final String cameraId in <String>[\n503:       'CAM-01',\n504:       'CAM-02',\n505:       'CAM-03',\n506:       'CAM-04',\n507:     ]) {\n508:       expect(\n509:         find.byKey(ValueKey<String>('video-surface-$cameraId')),\n510:         findsOneWidget,\n511:       );\n512:       expect(sink[cameraId]!.disposed, isFalse);\n513:     }\n514: \n515:     await teardownWall(tester);\n516:     expect(live, 0);\n517:   });\n518: \n519:   testWidgets('retry without a cached wall keeps the current feed',\n520:       (WidgetTester tester) async {\n521:     await tester.pumpWidget(\n522:       wallHarness(\n523:         manifest: wallManifest(),\n524:         clock: clock,\n525:         factory: fakeControllerFactory(),\n526:         onRetryCached: () async => null,\n527:       ),\n528:     );\n529:     await pumpWall(tester);\n530: \n531:     await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n532:     await tester.pump();\n533:     await tester.tap(find.byKey(const ValueKey<String>('recovery-retry')));\n534:     await tester.pump();\n535:     await tester.pump();\n536: \n537:     expect(find.text('NO CACHED WALL · KEEPING CURRENT FEED'),\n538:         findsOneWidget);\n539:     expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n540:     expect(find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n541:         findsOneWidget);\n542: \n543:     await teardownWall(tester);\n544:   });\n545: \n546:   testWidgets('wall fits the viewport at 960x540 and 1280x720',\n547:       (WidgetTester tester) async {\n548:     addTearDown(tester.view.resetPhysicalSize);\n549:     addTearDown(tester.view.resetDevicePixelRatio);\n550:     for (final Size size in <Size>[\n551:       const Size(960, 540),\n552:       const Size(1280, 720),\n553:     ]) {\n554:       tester.view.physicalSize = size;\n555:       tester.view.devicePixelRatio = 1.0;\n556:       await tester.pumpWidget(\n557:         wallHarness(\n558:           manifest: wallManifest(),\n559:           clock: clock,\n560:           factory: fakeControllerFactory(),\n561:         ),\n562:       );\n563:       await pumpWall(tester);\n564: \n565:       final Rect viewport = Offset.zero & size;\n566:       for (final String cameraId in <String>[\n567:         'CAM-01',\n568:         'CAM-02',\n569:         'CAM-03',\n570:         'CAM-04',\n571:       ]) {\n572:         final Finder surface =\n573:             find.byKey(ValueKey<String>('video-surface-$cameraId'));\n574:         expect(surface, findsOneWidget);\n575:         final Rect rect = tester.getRect(surface);\n576:         expect(rect.width, greaterThan(0));\n577:         expect(rect.height, greaterThan(0));\n578:         expect(\n579:           viewport.contains(rect.topLeft) &&\n580:               viewport.contains(rect.bottomRight),\n581:           isTrue,\n582:           reason: '$cameraId rect $rect must sit fully on-screen at $size',\n583:         );\n584:         // The tile (surface + HUD + focus chrome) is what the D-pad\n585:         // drives: it must be fully on-screen and hit-testable. (The raw\n586:         // surface sits under tile chrome, so hit-testing targets the tile.)\n587:         final Finder tile =\n588:             find.byKey(ValueKey<String>('camera-tile-$cameraId'));\n589:         expect(tile, findsOneWidget);\n590:         final Rect tileRect = tester.getRect(tile);\n591:         expect(\n592:           viewport.contains(tileRect.topLeft) &&\n593:               viewport.contains(tileRect.bottomRight),\n594:           isTrue,\n595:           reason:\n596:               '$cameraId tile $tileRect must sit fully on-screen at $size',\n597:         );\n598:         expect(\n599:           tile.hitTestable(),\n600:           findsOneWidget,\n601:           reason: '$cameraId must be hit-testable at $size',\n602:         );\n603:       }\n604:       // No scrollable: the whole wall is laid out from viewport constraints.\n605:       expect(find.byType(Scrollable), findsNothing);\n606:       expect(tester.takeException(), isNull);\n607: \n608:       await teardownWall(tester);\n609:     }\n610:   });\n611: \n612:   testWidgets('CameraTile swaps feeds dispose-before-create',\n613:       (WidgetTester tester) async {\n614:     final List<String> events = <String>[];\n615:     final Map<String, FakeTileVideoController> innerSink =\n616:         <String, FakeTileVideoController>{};\n617:     TileVideoController trackingFactory({\n618:       required String cameraId,\n619:       required TileMediaSource source,\n620:     }) {\n621:       final FakeTileVideoController inner = FakeTileVideoController(\n622:         cameraId: cameraId,\n623:         source: source,\n624:       );\n625:       innerSink['$cameraId#${inner.hashCode}'] = inner;\n626:       return _LiveBudgetController(\n627:         inner: inner,\n628:         onInitialize: () => events.add('init $cameraId'),\n629:         onDispose: () => events.add('dispose $cameraId'),\n630:       );\n631:     }\n632: \n633:     final FocusNode focusNode = FocusNode(debugLabel: 'swap-tile');\n634:     addTearDown(focusNode.dispose);\n635:     Widget harness(String cameraId) => MaterialApp(\n636:           home: Scaffold(\n637:             body: CameraTile(\n638:               key: const ValueKey<String>('slot-0'),\n639:               index: 0,\n640:               cameraId: cameraId,\n641:               source: BundledAssetSource('assets/${cameraId.toLowerCase()}.mp4'),\n642:               focusNode: focusNode,\n643:               controllerFactory: trackingFactory,\n644:             ),\n645:           ),\n646:         );\n647: \n648:     await tester.pumpWidget(harness('CAM-01'));\n649:     await tester.pump();\n650:     await tester.pump();\n651:     expect(\n652:       find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n653:       findsOneWidget,\n654:     );\n655: \n656:     await tester.pumpWidget(harness('CAM-02'));\n657:     await tester.pump();\n658:     await tester.pump();\n659:     await tester.pump();\n660:     expect(\n661:       find.byKey(const ValueKey<String>('video-surface-CAM-02')),\n662:       findsOneWidget,\n663:     );\n664:     expect(\n665:       find.byKey(const ValueKey<String>('video-surface-CAM-01')),\n666:       findsNothing,\n667:     );\n668:     // The old decoder was released before the replacement initialized.\n669:     expect(events, <String>['init CAM-01', 'dispose CAM-01', 'init CAM-02']);\n670:     expect(tester.takeException(), isNull);\n671: \n672:     await tester.pumpWidget(const SizedBox.shrink());\n673:     await tester.pump();\n674:   });\n675: \n676:   testWidgets('failed local decoder restores the previous bundled source',\n677:       (WidgetTester tester) async {\n678:     final List<FakeTileVideoController> controllers =\n679:         <FakeTileVideoController>[];\n680:     int liveDecoders = 0;\n681:     int maximumLiveDecoders = 0;\n682:     bool? settled;\n683:     TileVideoController rollbackFactory({\n684:       required String cameraId,\n685:       required TileMediaSource source,\n686:     }) {\n687:       final FakeTileVideoController inner = FakeTileVideoController(\n688:         cameraId: cameraId,\n689:         source: source,\n690:         failOnInitialize: source is LocalFileSource,\n691:       );\n692:       controllers.add(inner);\n693:       return _LiveBudgetController(\n694:         inner: inner,\n695:         onInitialize: () {\n696:           liveDecoders++;\n697:           if (liveDecoders > maximumLiveDecoders) {\n698:             maximumLiveDecoders = liveDecoders;\n699:           }\n700:         },\n701:         onDispose: () {\n702:           if (inner.isInitialized) liveDecoders--;\n703:         },\n704:       );\n705:     }\n706: \n707:     final FocusNode focusNode = FocusNode(debugLabel: 'rollback-tile');\n708:     addTearDown(focusNode.dispose);\n709:     Widget tile(TileMediaSource source) => MaterialApp(\n710:           home: Scaffold(\n711:             body: CameraTile(\n712:               key: const ValueKey<String>('rollback-slot'),\n713:               index: 0,\n714:               cameraId: 'CAM-01',\n715:               source: source,\n716:               focusNode: focusNode,\n717:               controllerFactory: rollbackFactory,\n718:               onSourceSettled: (bool success) => settled = success,\n719:             ),\n720:           ),\n721:         );\n722: \n723:     const BundledAssetSource previous = BundledAssetSource('assets/cam01.mp4');\n724:     await tester.pumpWidget(tile(previous));\n725:     await tester.pump();\n726:     await tester.pump();\n727:     expect(find.text('LIVE CAM-01'), findsOneWidget);\n728: \n729:     await tester.pumpWidget(tile(const LocalFileSource('/cache/rejected.mp4')));\n730:     for (var frame = 0; frame < 8; frame++) {\n731:       await tester.pump(const Duration(milliseconds: 1));\n732:     }\n733: \n734:     expect(settled, isFalse);\n735:     expect(find.text('LIVE CAM-01'), findsOneWidget);\n736:     expect(find.text('SIGNAL LOST'), findsNothing);\n737:     expect(controllers, hasLength(3));\n738:     expect(controllers[0].disposed, isTrue);\n739:     expect(controllers[1].disposed, isTrue);\n740:     expect(controllers[2].source, previous);\n741:     expect(controllers[2].playing, isTrue);\n742:     expect(maximumLiveDecoders, 1);\n743: \n744:     await tester.pumpWidget(const SizedBox.shrink());\n745:     await tester.pump();\n746:     expect(liveDecoders, 0);\n747:   });\n748: }\n749: \n750: /// [TileVideoController] decorator tracking decoder-budget events.\n751: ///\n752: /// Delegates everything to [inner] while reporting lifecycle transitions,\n753: /// so tests can assert the wall never exceeds its live-decoder budget.\n754: final class _LiveBudgetController implements TileVideoController {\n755:   _LiveBudgetController({\n756:     required this.inner,\n757:     required this.onInitialize,\n758:     required this.onDispose,\n759:   });\n760: \n761:   final FakeTileVideoController inner;\n762:   final void Function() onInitialize;\n763:   final void Function() onDispose;\n764: \n765:   @override\n766:   Future<void> initialize() async {\n767:     await inner.initialize();\n768:     onInitialize();\n769:   }\n770: \n771:   @ove