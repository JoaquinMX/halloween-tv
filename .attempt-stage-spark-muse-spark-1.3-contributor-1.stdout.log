troller.isClosed) {\n725:           await controller.close();\n726:         }\n727:       }\n728:     });\n729: \n730:     Future<void> pumpShippedApp(WidgetTester tester) async {\n731:       SharedPreferences.setMockInitialValues(<String, Object>{\n732:         DeviceIdentityStore.storageKey: _kDeviceId,\n733:       });\n734:       await tester.pumpWidget(\n735:         CompanionApp(manifestSource: source, clock: const SystemClock()),\n736:       );\n737:       await _flush(tester);\n738:     }\n739: \n740:     testWidgets(\n741:       'denied-to-granted permission starts the camera from the shipped tree',\n742:       (tester) async {\n743:         // First check: denied. Request: granted. Only the permission\n744:         // boundary is mocked; the scanner, screen, and camera controller\n745:         // are the shipped production objects.\n746:         mockPermission(check: 0, request: 1);\n747:         await pumpShippedApp(tester);\n748:         expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n749: \n750:         await _tapScan(tester);\n751:         await tester.pumpAndSettle();\n752: \n753:         // Pre-fix this push threw (ancestor context has no Navigator) and\n754:         // the camera never started. Now the real screen is up and running.\n755:         expect(find.byType(QrScanScreen), findsOneWidget);\n756:         expect(camera.startCalls, 1);\n757:         expect(find.byKey(const Key('fake-camera-view')), findsOneWidget);\n758:         expect(tester.takeException(), isNull);\n759:       },\n760:     );\n761: \n762:     testWidgets('shipped scan reaches the joined lineup', (tester) async {\n763:       mockPermission(check: 1);\n764:       await pumpShippedApp(tester);\n765: \n766:       await _tapScan(tester);\n767:       await tester.pumpAndSettle();\n768:       expect(find.byType(QrScanScreen), findsOneWidget);\n769: \n770:       camera.emit('{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}');\n771:       await _flush(tester);\n772:       expe