ostMediaService>[\"deleteHostVideo\"];\n52:   requestGuestUpload: ReturnType<typeof createGuestUploadService>[\"requestGuestUpload\"];\n53:   completeGuestUpload: ReturnType<typeof createGuestUploadService>[\"completeGuestUpload\"];\n54:   getGuestMediaStatus: ReturnType<typeof createGuestUploadService>[\"getGuestMediaStatus\"];\n55:   withdrawGuestMedia: ReturnType<typeof createGuestUploadService>[\"withdrawGuestMedia\"];\n56:   handleGuestIngestFinalized: ReturnType<typeof createGuestUploadService>[\"handleIngestFinalized\"];\n57: }\n58: \n59: /**\n60:  * One composition for exported handlers and emulator tests. Delivery URLs/ACKs\n61:  * use the delivery service, while request and worker paths use the newer\n62:  * generation store and provider pipeline exclusively.\n63:  */\n64: export function createRuntimeServices(options: RuntimeServiceOptions): RuntimeServices {\n65:   // Provider selection is explicit and lazy: a packaged fixture directory never\n66:   // silently forces fake mode over another configured provider. When the\n67:   // configured provider is fake, the packaged directory (or the repository\n68:   // default) backs it; otherwise the provider resolves lazily so module\n69:   // discovery and local tests never require provider credentials.\n70:   const configuredProvider = (process.env.VIDEO_GENERATION_PROVIDER ?? \"fake\").trim().toLowerCase();\n71:   const provider = options.provider ??\n72:     (configuredProvider === \"fake\"\n73:       ? createVideoGenerationProviderFromEnvironment(\n74:           options.fixtureDirectory == null || options.fixtureDirectory.trim() === \"\"\n75:             ? undefined\n76:             : options.fixtureDirectory,\n77:         )\n78:       : undefined);\n79:   const generation = options.generationEnabled === true\n80:     ? createGenerationServices({\n81:       db: options.db,\n82:       bucket: options.bucket,\n83:       provider,\n84:       now: options.now,\n85:       sleep: options.sleep,\n86:       pollIntervalMs: options.pollIntervalMs,\n87:       providerTimeoutMs: options.providerTimeoutMs,\n88:       normalization: options.normalization,\n89:       fixtureDirectory: options.fixtureDirectory,\n90:     })\n91:     : undefined;\n92:   const guestList = createGuestListService({ db: options.db });\n93:   const joinPartyService = createJoinPartyService({ db: options.db });\n94:   const hostJoin = createHostJoinService({ db: options.db, ...(options.now ? { now: options.now } : {}) });\n95:   const hostMedia = createHostMediaService({\n96:     db: options.db,\n97:     bucket: options.bucket,\n98:     ...(options.now ? { now: options.now } : {}),\n99:     ...(options.signReadUrl ? { signPreviewUrl: options.signReadUrl } : {}),\n100:     ...(options.deleteDeliveryObject ? { deleteObject: options.deleteDeliveryObject } : {}),\n101:   });\n102:   const guestUpload = createGuestUploadService({\n103:     db: options.db,\n104:     bucket: options.bucket,\n105:     now: options.now,\n106:     ...(options.signGuestUploadUrl ? { signUploadUrl: options.signGuestUploadUrl } : {}),\n107:     ...(options.deleteGuestObject ? { deleteObject: options.deleteGuestObject } : {}),\n108:   });\n109:   const delivery = createDeliveryServices({\n110:     db: options.db,\n111:     bucket: options.bucket,\n112:     now: options.now,\n113:     signReadUrl: options.signReadUrl,\n114:     deleteDeliveryObject: options.deleteDeliveryObject,\n115:   });\n116:   const enqueue = options.enqueueGeneration ?? (async () => {\n117:     throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation task queue is not configured.\");\n118:   });\n119: \n120:   async function requestGeneration(value: unknown) {\n121:     if (!generation) throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation is not enabled.\");\n122:     const request = await generation.requestGeneration(value);\n123:     if (request.created) {\n124:       const task: GenerationTask = {\n125:         partyId: request.partyId,\n126:       