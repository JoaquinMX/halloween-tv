kId?: unknown } | undefined;\n358:           if (typeof providerTask?.taskId !== \"string\") {\n359:             throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Staged camera output has no durable provider task ID.\");\n360:           }\n361:           const cameraResult = (job.cameraResults ?? {})[cameraId] as {\n362:             secondsOut?: number; secondsIn?: number; creditsCharged?: number | null; providerState?: string;\n363:           } | undefined;\n364:           if (!cameraResult || cameraResult.providerState !== \"SUCCEEDED\") {\n365:             let result;\n366:             try {\n367:               result = await (activeProvider ?? getProvider()).getResult(providerTask.taskId);\n368:             } catch (error) {\n369:               if (error instanceof BackendError) throw error;\n370:               throw new BackendError(\"PROVIDER_UNAVAILABLE\", `Provider result is unavailable; task ID ${String(providerTask.taskId)} retained for reconciliation.`);\n371:             }\n372:             await store.recordCameraResult(validTask.partyId, validTask.jobId, cameraId, result, { state: \"SUCCEEDED\" }, stagedOutput);\n373:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n374:               success: true,\n375:               secondsOut: result.secondsOut,\n376:               secondsIn: result.secondsIn,\n377:               creditsCharged: result.creditsCharged,\n378:               providerTaskId: providerTask.taskId,\n379:             });\n380:           } else {\n381:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n382:               success: true,\n383:               secondsOut: cameraResult.secondsOut,\n384:               secondsIn: cameraResult.secondsIn,\n385:               creditsCharged: cameraResult.creditsCharged,\n386:               providerTaskId: providerTask.taskId,\n387:             });\n388:           }\n389:           continue;\n390:         }\n391:         let providerTask = (job.providerTasks ?? {})[cameraId] as { taskId?: unknown } | undefined;\n392:         if (isGuestJob && cameraId !== GUEST_PROVIDER_CAMERA_ID) {\n393:           const staged = await stageFixtureSlot(validTask.partyId, validTask.jobId, cameraId);\n394:           await store.recordFixtureResult(validTask.partyId, validTask.jobId, cameraId, staged, expectedSecondsOut);\n395:           await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n396:             success: true,\n397:             secondsOut: expectedSecondsOut,\n398:             secondsIn: 0,\n399:             creditsCharged: null,\n400:             providerTaskId: null,\n401:             fixture: true,\n402:           });\n403:           continue;\n404:         }\n405:         if (isGuestJob) {\n406:           // Worker-submission consent gate: a withdrawal that lands while the\n407:           // job runs discards the job and cleans staged bytes instead of\n408:           // submitting a billable request against revoked consent.\n409:           guestReference = await recheckGuestConsent(\n410:             validTask.partyId, validTask.jobId, validTask.deviceId, validTask.channelId,\n411:             String(guestBinding?.submissionId), String(guestBinding?.sourceHash),\n412:           );\n413:         }\n414:         if (!providerTask || typeof providerTask.taskId !== \"string\") {\n415:           try {\n416:             const shouldSubmit = await store.beginSubmission(validTask.partyId, validTask.jobId, cameraId);\n417:             if (!shouldSubmit) {\n418:               job = await store.getJob(validTask.partyId, validTask.jobId);\n419:               providerTask = (job.providerTasks ?? {})[cameraId] as { taskId?: unknown } | undefined;\n420:             } else {\n421:               const request = jobPresetId === CAMEO_DEMO_PRESET.presetId\n422:                 ? buildCameoDemoRequest(validTask.jobId, validTask.idempotencyKey, cameraId, guestReference)\n423:                 : buildCheapDemoRequest(validTask.jobId, validTask.idempotencyKey, cameraId, guestReference);\n424:               const submitted = await (activeProvider ?? getProvider()).submit(request);\n425:               await store.recordSubmission(validTask.partyId, validTask.jobId, cameraId, submitted.taskId);\n426:               providerTask = { taskId: submitted.taskId };\n427:             }\n428:           } catch (error) {\n429:             const certainty = error instanceof AlibabaSubmissionError ? error.certainty : \"unknown\";\n430:             const errorCode = \"PROVIDER_UNAVAILABLE\";\n431:             await store.recordSubmissionFailure({ ...validTask, presetId: jobPresetId }, cameraId, errorCode, certainty);\n432:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n433:               success: false,\n434:               providerTaskId: null,\n435:               creditsCharged: null,\n436:               errorCode,\n437:             });\n438:             throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider submission did not complete safely.\");\n439:           }\n440:         }\n441:         if (typeof providerTask?.taskId !== \"string\") {\n442:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"No durable provider task ID is available; resubmission is disabled.\");\n443:         }\n444:         await store.heartbeat(validTask.partyId, validTask.jobId);\n445:         let status: ProviderTaskStatus;\n446:         try {\n447:           status = await pollUntilComplete(providerTask.taskId, activeProvider, jobDeadline);\n448:         } catch (error) {\n449:           await store.releaseWorker(validTask.partyId, validTask.jobId);\n450:           throw error;\n451:         }\n452:         if (status.state === \"FAILED\") {\n453:           // Surface the provider's failure reason in the worker error and on\n454:           // the job doc (truncated, sanitized — no credentials/URLs) so the\n455:           // next diagnosis does not need a manual API query. Empty reasons\n456:           // keep the legacy generic mapping.\n457:           const rawCode = typeof status.errorCode === \"string\" ? status.errorCode : \"\";\n458:           const rawMessage = typeof status.errorMessage === \"string\" ? status.errorMessage : \"\";\n459:           const sanitizedMessage = rawMessage\n460:             .replace(/https?:\\/\\/\\S+/gi, \"[url]\")\n461:             .replace(/wss?:\\/\\/\\S+/gi, \"[url]\")\n462:             .replace(/gs:\\/\\/\\S+/gi, \"[url]\")\n463:             .replace(/Bearer\\s+[A-Za-z0-9._~+/_=-]+/gi, \"Bearer [redacted]\")\n464:             .replace(/sk-[A-Za-z0-9_-]+/g, \"[redacted]\")\n465:             .replace(/[\\u0000-\\u001f\\u007f]+/g, \" \")\n466:             .replace(/\\s+/g, \" \")\n467:             .trim()\n468:             .slice(0, 280);\n469:           const detail = [rawCode, sanitizedMessage].map((part) => part.trim()).filter(Boolean).join(\": \");\n470:           const persistable = detail ? detail.slice(0, 280) : \"PROVIDER_FAILED\";\n471:           await store.recordProviderFailure({ ...validTask, presetId: jobPresetId }, cameraId, persistable);\n472:           await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n473:             success: false,\n474:             providerTaskId: providerTask.taskId,\n475:             creditsCharged: null,\n476:             errorCode: \"PROVIDER_UNAVAILABLE\",\n477:           });\n478:           if (detail) {\n479:             throw new BackendError(\"PROVIDER_UNAVAILABLE\", `Provider task failed (${detail.slice(0, 280)}).`);\n480:           }\n481:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider task failed.\");\n482:         }\n483:         let result: ProviderResult;\n484:         try {\n485:           result = await (activeProvider ?? getProvider()).getResult(providerTask.taskId);\n486:         } catch (error) {\n487:           if (error instanceof BackendError) throw error;\n488:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", `Provider result is unavailable; task ID ${String(providerTask.taskId)} retained for reconciliation.`);\n489:         }\n490:         const staged = await normalizeAndStage(validTask.partyId, validTask.jobId, cameraId, result);\n491:         await store.recordCameraResult(validTask.partyId, validTask.jobId, cameraId, result, status, staged);\n492:         await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n493:           success: true,\n494:           secondsOut: result.secondsOut,\n495:           secondsIn: result.secondsIn,\n496:           creditsCharged: result.creditsCharged,\n497:           providerTaskId: providerTask.taskId,\n498:         });\n499:       }\n500:       const job = await store.getJob(validTask.partyId, validTask.jobId);\n501:       await publish(validTask.partyId, validTask.jobId, validTask.idempotencyKey);\n502:       return { jobId: validTask.jobId, state: \"ready\", manifestVersion: Number(job.manifestVersion) };\n503:     } catch (error) {\n504:       // A withdrawal racing the worker discards the already-running result and\n505:       // cleans staged bytes instead of publishing a revoked cameo.\n506:       if (isGuestJob && error instanceof BackendError && error.errorCode === \"FORBIDDEN\") {\n507:         const guestNow = await store.getJob(validTask.partyId, validTask.jobId).catch(() => undefined);\n508:         if (guestNow && ![\"failed\", \"ready\"].includes(String(guestNow.state))) {\n509:           await failForWithdrawnConsent(validTask.partyId, validTask.jobId).catch(() => undefined);\n510:         }\n511:       } else {\n512:         const latest = await store.getJob(validTask.partyId, validTask.jobId).catch(() => undefined);\n513:         if (latest && ![\"failed\", \"ready\"].includes(String(latest.state))) {\n514:           await store.releaseWorker(validTask.partyId, validTask.jobId).catch(() => undefined);\n515:         }\n516:       }\n517:       throw error;\n518:     }\n519:   }\n520: \n521:   return {\n522:     requestGeneration: (value) => store.requestGeneration(value),\n523:     getGenerationStatus: (value) => store.getGenerationStatus(value),\n524:     failEnqueue: (task) => store.failEnqueue(task),\n525:     runGeneration,\n526:     normalizeAndStage,\n527:     publishManifest: publish,\n528:   };\n529: }\n530: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-3/backend/functions/src/generation.ts, lines 1-530\n1: import { Bucket } from \"@google-cloud/storage\";\n2: import { createHash } from \"node:crypto\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import { FieldValue } from \"firebase-admin/firestore\";\n6: import { assertRegisteredPartyDevice } from \"./auth\";\n7: import { BackendError, parseRequestGeneration, RequestGenerationInput, validateId } from \"./contracts\";\n8: import { CAMEO_DEMO_PRESET, GUEST_PROVIDER_CAMERA_ID, MEDIA_RETENTION_MS, REQUIRED_CAMERA_IDS } from \"./config\";\n9: import { FirestoreGenerationStore, GenerationTask } from \"./generation_store\";\n10: import { assertGuestEligible } from \"./guest_media\";\n11: import { normalizeProviderVideo, NormalizationOptions, removeNormalizedVideo } from \"./normalize\";\n12: import { publishManifest as commitManifest } from \"./publish\";\n13: import { AlibabaSubmissionError } from \"./providers/alibaba\";\n14: import { recordUsageOutcome, UsageLedgerInput } from \"./usage\";\n15: import { createVideoGenerationProviderFromEnvironment, FakeVideoGenerationPort } from \"./providers/fake\";\n16: import {\n17:   buildCameoDemoRequest,\n18:   buildCheapDemoRequest,\n19:   CameraId,\n20:   GuestImageReference,\n21:   ProviderResult,\n22:   ProviderTaskStatus,\n23:   VideoGenerationPort,\n24: } from \"./video_generation_port\";\n25: \n26: export interface GenerationServiceOptions {\n27:   db: FirebaseFirestore.Firestore;\n28:   bucket: Bucket;\n29:   provider?: VideoGenerationPort;\n30:   now?: () => Date;\n31:   sleep?: (milliseconds: number) => Promise<void>;\n32:   pollIntervalMs?: number;\n33:   providerTimeoutMs?: number;\n34:   normalization?: NormalizationOptions;\n35:   /** Local fixture directory for consent-bound guest jobs (three fixture slots). */\n36:   fixtureDirectory?: string;\n37:   /**\n38:    * Offline-test override for reference URL signing. Production defaults to\n39:    * the bucket's v4 signed read URL (same machinery as delivery signReadUrl,\n40:    * 15-min TTL). Injected signers must return an https URL and must never\n41:    * persist it; the URL is used in-flight only.\n42:    */\n43:   signReferenceUrl?: (objectPath: string) => Promise<string>;\n44: }\n45: \n46: /** Short-lived reference read capability: 15-min TTL is plenty for submit. */\n47: export const REFERENCE_READ_URL_TTL_MS = 15 * 60 * 1000;\n48: \n49: export interface GenerationServices {\n50:   requestGeneration(value: unknown): ReturnType<FirestoreGenerationStore[\"requestGeneration\"]>;\n51:   getGenerationStatus(value: unknown): ReturnType<FirestoreGenerationStore[\"getGenerationStatus\"]>;\n52:   failEnqueue(task: GenerationTask): Promise<void>;\n53:   runGeneration(task: GenerationTask): Promise<{ jobId: string; state: string; manifestVersion?: number }>;\n54:   normalizeAndStage(partyId: string, jobId: string, cameraId: CameraId, result: ProviderResult): Promise<Record<string, unknown>>;\n55:   publishManifest(partyId: string, jobId: string, idempotencyKey: string): Promise<import(\"./contracts\").DeliveryManifest>;\n56: }\n57: \n58: function ledgerInput(job: FirebaseFirestore.DocumentData, cameraId: CameraId): UsageLedgerInput {\n59:   return {\n60:     partyId: String(job.partyId),\n61:     deviceId: String(job.deviceId),\n62:     channelId: String(job.channelId),\n63:     manifestVersion: Number(job.manifestVersion),\n64:     idempotencyKey: String(job.idempotencyKey),\n65:     jobId: String(job.jobId),\n66:     cameraId,\n67:   };\n68: }\n69: \n70: /**\n71:  * Signs a short-lived provider-fetchable read URL for a consented guest\n72:  * photo. Same machinery as the delivery signReadUrl default (GCS v4 read\n73:  * signature); the caller keeps the URL in memory for the submit call only.\n74:  */\n75: export async function signReferenceReadUrl(\n76:   bucket: Bucket,\n77:   objectPath: string,\n78:   now: () => Date = () => new Date(),\n79: ): Promise<string> {\n80:   const [url] = await bucket.file(objectPath).getSignedUrl({\n81:     action: \"read\",\n82:     version: \"v4\",\n83:     expires: new Date(now().getTime() + REFERENCE_READ_URL_TTL_MS),\n84:   });\n85:   return url;\n86: }\n87: \n88: export function createGenerationServices(options: GenerationServiceOptions): GenerationServices {\n89:   let provider = options.provider;\n90:   const fixtureDirectory = options.fixtureDirectory;\n91:   const getProvider = () => provider ??= createVideoGenerationProviderFromEnvironment(\n92:     typeof fixtureDirectory === \"string\" && fixtureDirectory.trim() !== \"\" ? fixtureDirectory : undefined,\n93:   );\n94:   let rehearsalProvider: FakeVideoGenerationPort | undefined;\n95:   const getRehearsalProvider = () => (rehearsalProvider ??= new FakeVideoGenerationPort(\n96:     options.fixtureDirectory == null || options.fixtureDirectory.trim() === \"\" ? undefined : options.fixtureDirectory,\n97:   ));\n98:   /**\n99:    * Fake-only rehearsal binding: a job carrying the server-persisted\n100:    * `rehearsalOnly` marker resolves ONLY the offline fake provider,\n101:    * regardless of the deployed/injected provider configuration, and fails\n102:    * closed before any submit when the resolution is not the fake provider.\n103:    * Jobs without the marker resolve lazily through the unchanged default\n104:    * path (so unknown-provider failures keep their exact fail-closed shape).\n105:    */\n106:   const resolveRehearsalProvider = (job: FirebaseFirestore.DocumentData): VideoGenerationPort | undefined => {\n107:     if ((job as Record<string, unknown>).rehearsalOnly !== true) return undefined;\n108:     const fake = getRehearsalProvider();\n109:     if (!(fake instanceof FakeVideoGenerationPort)) {\n110:       throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Rehearsal jobs resolve only the fake provider; refusing a live submission.\");\n111:     }\n112:     return fake;\n113:   };\n114:   const store = new FirestoreGenerationStore({ db: options.db, bucket: options.bucket, now: options.now });\n115:   const sleep = options.sleep ?? ((milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds)));\n116:   const now = options.now ?? (() => new Date());\n117:   const pollIntervalMs = options.pollIntervalMs ?? 15_000;\n118:   const providerTimeoutMs = options.providerTimeoutMs ?? 12 * 60 * 1000;\n119: \n120:   async function normalizeAndStage(partyId: string, jobId: string, cameraId: CameraId, result: ProviderResult): Promise<Record<string, unknown>> {\n121:     validateId(partyId, \"partyId\");\n122:     validateId(jobId, \"jobId\");\n123:     if (!REQUIRED_CAMERA_IDS.includes(cameraId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Camera ID is invalid.\");\n124:     const job = await store.getJob(partyId, jobId);\n125:     if (job.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running generation job can stage media.\");\n126:     const old = (job.stagedOutputs ?? {})[cameraId];\n127:     if (old && typeof old === \"object\") return old as Record<string, unknown>;\n128:     const expectedSecondsOut = job.presetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.secondsOut : 2;\n129:     const normalized = await normalizeProviderVideo(result, { ...options.normalization, expectedSecondsOut });\n130:     const expiresAt = new Date(now().getTime() + MEDIA_RETENTION_MS).toISOString();\n131:     const objectPath = store.plannedObjectPath(job.partyId, job.channelId, Number(job.manifestVersion), cameraId);\n132:     try {\n133:       const bytes = await readFile(normalized.path);\n134:       await options.bucket.file(objectPath).save(bytes, {\n135:         resumable: false,\n136:         metadata: {\n137:           contentType: \"video/mp4\",\n138:           customTime: expiresAt,\n139:           metadata: {\n140:             expiresAt,\n141:             jobId,\n142:             partyId: job.partyId,\n143:             channelId: job.channelId,\n144:             cameraId,\n145:             purpose: \"delivery\",\n146:             sha256: normalized.sha256,\n147:           },\n148:         },\n149:       });\n150:       const clip = {\n151:         cameraId,\n152:         objectPath,\n153:         sha256: normalized.sha256,\n154:         sizeBytes: normalized.sizeBytes,\n155:         durationMs: normalized.durationMs,\n156:         expiresAt,\n157:       };\n158:       await store.recordStagedOutput(job.partyId, jobId, cameraId, clip);\n159:       return clip;\n160:     } finally {\n161:       await removeNormalizedVideo(normalized);\n162:     }\n163:   }\n164: \n165:   function fixturePathFor(cameraId: CameraId): string {\n166:     const directory = options.fixtureDirectory ?? resolve(process.cwd(), \"../../apps/tv_app/assets\");\n167:     const index = REQUIRED_CAMERA_IDS.indexOf(cameraId);\n168:     return resolve(directory, `cam${String(index + 1).padStart(2, \"0\")}.mp4`);\n169:   }\n170: \n171:   /**\n172:    * Locally prepared fixture slot for consent-bound guest jobs. No provider\n173:    * submission, no provider task ID, no provider charge: usage is recorded\n174:    * with explicit fixture provenance and a null task ID.\n175:    */\n176:   async function stageFixtureSlot(partyId: string, jobId: string, cameraId: CameraId): Promise<Record<string, unknown>> {\n177:     validateId(partyId, \"partyId\");\n178:     validateId(jobId, \"jobId\");\n179:     const job = await store.getJob(partyId, jobId);\n180:     if (job.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running generation job can stage media.\");\n181:     const old = (job.stagedOutputs ?? {})[cameraId];\n182:     if (old && typeof old === \"object\") return old as Record<string, unknown>;\n183:     const expectedSecondsOut = job.presetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.secondsOut : 2;\n184:     const normalized = await normalizeProviderVideo(\n185:       { video: { kind: \"file\", value: fixturePathFor(cameraId) }, secondsOut: expectedSecondsOut, secondsIn: 0, creditsCharged: null },\n186:       { ...options.normalization, expectedSecondsOut },\n187:     );\n188:     const expiresAt = new Date(now().getTime() + MEDIA_RETENTION_MS).toISOString();\n189:     const objectPath = store.plannedObjectPath(job.partyId, job.channelId, Number(job.manifestVersion), cameraId);\n190:     try {\n191:       const bytes = await readFile(normalized.path);\n192:       await options.bucket.file(objectPath).save(bytes, {\n193:         resumable: false,\n194:         metadata: {\n195:           contentType: \"video/mp4\",\n196:           customTime: expiresAt,\n197:           metadata: {\n198:             expiresAt,\n199:             jobId,\n200:             partyId: job.partyId,\n201:             channelId: job.channelId,\n202:             cameraId,\n203:             purpose: \"delivery\",\n204:             fixture: \"true\",\n205:             sha256: normalized.sha256,\n206:           },\n207:         },\n208:       });\n209:       const clip = {\n210:         cameraId,\n211:         objectPath,\n212:         sha256: normalized.sha256,\n213:         sizeBytes: normalized.sizeBytes,\n214:         durationMs: normalized.durationMs,\n215:         expiresAt,\n216:         fixture: true,\n217:       };\n218:       await store.recordStagedOutput(job.partyId, jobId, cameraId, clip);\n219:       return clip;\n220:     } finally {\n221:       await removeNormalizedVideo(normalized);\n222:     }\n223:   }\n224: \n225:   /** Fails a consent-bound job closed after withdrawal and cleans staged bytes. */\n226:   async function failForWithdrawnConsent(partyId: string, jobId: string): Promise<never> {\n227:     const job = await store.getJob(partyId, jobId).catch(() => undefined);\n228:     if (job) {\n229:       const staged = ((job.stagedOutputs ?? {}) as Record<string, Record<string, unknown>>) ?? {};\n230:       for (const cameraId of REQUIRED_CAMERA_IDS) {\n231:         const clip = staged[cameraId];\n232:         if (clip && typeof clip.objectPath === \"string\" && clip.objectPath.startsWith(\"parties/\")) {\n233:           await options.bucket.file(clip.objectPath).delete({ ignoreNotFound: true }).catch(() => undefined);\n234:         }\n235:       }\n236:     }\n237:     await store.failForWithdrawnConsent(partyId, jobId).catch(() => undefined);\n238:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn; the bound generation job is discarded.\");\n239:   }\n240: \n241:   async function recheckGuestConsent(\n242:     partyId: string,\n243:     jobId: string,\n244:     deviceId: string,\n245:     channelId: string,\n246:     submissionId: string,\n247:     expectedHash: string,\n248:   ): Promise<GuestImageReference> {\n249:     let eligible: Awaited<ReturnType<typeof assertGuestEligible>>;\n250:     try {\n251:       eligible = await assertGuestEligible(options.db, { partyId, deviceId, channelId }, submissionId, now().getTime());\n252:     } catch {\n253:       await failForWithdrawnConsent(partyId, jobId);\n254:       throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn; the bound generation job is discarded.\");\n255:     }\n256:     if (eligible.sourceHash !== expectedHash) {\n257:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Guest media source changed while the job was running.\");\n258:     }\n259:     const [bytes] = await options.bucket.file(eligible.objectPath).download().catch(() => [undefined] as unknown as [Buffer | undefined]);\n260:     if (!bytes || bytes.byteLength <= 0) {\n261:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Guest media bytes are not available for generation.\");\n262:     }\n263:     if (createHash(\"sha256\").update(bytes).digest(\"hex\") !== eligible.sourceHash) {\n264:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Guest media bytes do not match the consented source hash.\");\n265:     }\n266:     // Resolve the consented photo to a short-lived signed https read URL for\n267:     // provider submission: same v4 read-signature machinery as delivery\n268:     // signReadUrl, 15-min TTL. The URL lives only in this in-memory\n269:     // reference; it is never written to manifests, logs, or Firestore docs.\n270:     let url: string;\n271:     try {\n272:       url = options.signReferenceUrl\n273:         ? await options.signReferenceUrl(eligible.objectPath)\n274:         : await signReferenceReadUrl(options.bucket, eligible.objectPath, now);\n275:     } catch (error) {\n276:       if (error instanceof BackendError) throw error;\n277:       throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Guest reference URL could not be signed for submission.\");\n278:     }\n279:     if (typeof url !== \"string\" || !/^https:\\/\\//.test(url)) {\n280:       throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Guest reference URL signing did not return a fetchable https URL.\");\n281:     }\n282:     return { objectPath: eligible.objectPath, sha256: eligible.sourceHash, consentRevision: eligible.consentRevision, url };\n283:   }\n284: \n285:   async function publish(partyId: string, jobId: string, idempotencyKey: string) {\n286:     return commitManifest(store, partyId, jobId, idempotencyKey);\n287:   }\n288: \n289:   async function pollUntilComplete(\n290:     taskId: string,\n291:     activeProvider: VideoGenerationPort | undefined,\n292:     deadline = now().getTime() + providerTimeoutMs,\n293:   ): Promise<ProviderTaskStatus> {\n294:     // Default-path resolution stays lazy (exactly as before) so unknown or\n295:     // misconfigured providers fail at the same point with the same shape.\n296:     const active = activeProvider ?? getProvider();\n297:     while (true) {\n298:       const status = await active.getStatus(taskId);\n299:       if (status.state === \"SUCCEEDED\" || status.state === \"FAILED\") return status;\n300:       if (now().getTime() >= deadline) throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider task polling timed out; task ID is retained for reconciliation.\");\n301:       await sleep(pollIntervalMs);\n302:     }\n303:   }\n304: \n305:   async function runGeneration(task: GenerationTask) {\n306:     const validTask: GenerationTask = {\n307:       partyId: validateId(task.partyId, \"partyId\"),\n308:       deviceId: validateId(task.deviceId, \"deviceId\"),\n309:       channelId: validateId(task.channelId, \"channelId\"),\n310:       jobId: validateId(task.jobId, \"jobId\"),\n311:       idempotencyKey: validateId(task.idempotencyKey, \"idempotencyKey\"),\n312:     };\n313:     await assertRegisteredPartyDevice(options.db, validTask);\n314:     const claim = await store.claimWorker(validTask);\n315:     if (!claim.claimed) return { jobId: validTask.jobId, state: String(claim.job.state), manifestVersion: Number(claim.job.manifestVersion) };\n316:     // Rehearsal-marked jobs bind to the fake provider before any submit;\n317:     // unmarked jobs keep `undefined` so every default-path call site resolves\n318:     // lazily through getProvider() exactly as before.\n319:     const activeProvider = resolveRehearsalProvider(claim.job);\n320:     // 5s on every slot (one provider camera + three padded fixture slots).\n321:     const jobPresetId = claim.job.presetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.presetId : \"cheap_demo\";\n322:     const expectedSecondsOut = jobPresetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.secondsOut : 2;\n323:     // Consent-bound guest execution plan: exactly ONE provider-generated camera\n324:     // slot (CAM-01, bound to the validated guest photo) plus three locally\n325:     // prepared fixture slots. Text-only jobs keep four provider cameras.\n326:     const guestBinding = (claim.job.guestMedia ?? undefined) as {\n327:       submissionId?: unknown; sourceHash?: unknown;\n328:     } | undefined;\n329:     const isGuestJob = typeof guestBinding?.submissionId === \"string\" && typeof guestBinding?.sourceHash === \"string\";\n330:     let guestReference: GuestImageReference | undefined;\n331:     if (isGuestJob) {\n332:       guestReference = await recheckGuestConsent(\n333:         validTask.partyId, validTask.jobId, validTask.deviceId, validTask.channelId,\n334:         String(guestBinding?.submissionId), String(guestBinding?.sourceHash),\n335:       );\n336:     }\n337:     // One provider deadline shared by all four sequential camera polls: worst\n338:     // case stays near providerTimeoutMs (plus normalization headroom checked\n339:     // by preflight) instead of multiplying per camera against the task timeout.\n340:     const jobDeadline = now().getTime() + providerTimeoutMs;\n341:     try {\n342:       for (const cameraId of REQUIRED_CAMERA_IDS) {\n343:         let job = await store.getJob(validTask.partyId, validTask.jobId);\n344:         const stagedOutput = (job.stagedOutputs ?? {})[cameraId] as Record<string, unknown> | undefined;\n345:         if (stagedOutput) {\n346:           if (isGuestJob && cameraId !== GUEST_PROVIDER_CAMERA_ID) {\n347:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n348:               success: true,\n349:               secondsOut: expectedSecondsOut,\n350:               secondsIn: 0,\n351:               creditsCharged: null,\n352:               providerTaskId: null,\n353:               fixture: true,\n354:             });\n355:             continue;\n356:           }\n357:           const providerTask = (job.providerTasks ?? {})[cameraId] as { taskId?: unknown } | undefined;\n358:           if (typeof providerTask?.taskId !== \"string\") {\n359:             throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Staged camera output has no durable provider task ID.\");\n360:           }\n361:           const cameraResult = (job.cameraResults ?? {})[cameraId] as {\n362:             secondsOut?: number; secondsIn?: number; creditsCharged?: number | null; providerState?: string;\n363:           } | undefined;\n364:           if (!cameraResult || cameraResult.providerState !== \"SUCCEEDED\") {\n365:             let result;\n366:             try {\n367:               result = await (activeProvider ?? getProvider()).getResult(providerTask.taskId);\n368:             } catch (error) {\n369:               if (error instanceof BackendError) throw error;\n370:               throw new BackendError(\"PROVIDER_UNAVAILABLE\", `Provider result is unavailable; task ID ${String(providerTask.taskId)} retained for reconciliation.`);\n371:             }\n372:             await store.recordCameraResult(validTask.partyId, validTask.jobId, cameraId, result, { state: \"SUCCEEDED\" }, stagedOutput);\n373:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n374:               success: true,\n375:               secondsOut: result.secondsOut,\n376:               secondsIn: result.secondsIn,\n377:               creditsCharged: result.creditsCharged,\n378:               providerTaskId: providerTask.taskId,\n379:             });\n380:           } else {\n381:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n382:               success: true,\n383:               secondsOut: cameraResult.secondsOut,\n384:               secondsIn: cameraResult.secondsIn,\n385:               creditsCharged: cameraResult.creditsCharged,\n386:               providerTaskId: providerTask.taskId,\n387:             });\n388:           }\n389:           continue;\n390:         }\n391:         let providerTask = (job.providerTasks ?? {})[cameraId] as { taskId?: unknown } | undefined;\n392:         if (isGuestJob && cameraId !== GUEST_PROVIDER_CAMERA_ID) {\n393:           const staged = await stageFixtureSlot(validTask.partyId, validTask.jobId, cameraId);\n394:           await store.recordFixtureResult(validTask.partyId, validTask.jobId, cameraId, staged, expectedSecondsOut);\n395:           await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n396:             success: true,\n397:             secondsOut: expectedSecondsOut,\n398:             secondsIn: 0,\n399:             creditsCharged: null,\n400:             providerTaskId: null,\n401:             fixture: true,\n402:           });\n403:           continue;\n404:         }\n405:         if (isGuestJob) {\n406:           // Worker-submission consent gate: a withdrawal that lands while the\n407:           // job runs discards the job and cleans staged bytes instead of\n408:           // submitting a billable request against revoked consent.\n409:           guestReference = await recheckGuestConsent(\n410:             validTask.partyId, validTask.jobId, validTask.deviceId, validTask.channelId,\n411:             String(guestBinding?.submissionId), String(guestBinding?.sourceHash),\n412:           );\n413:         }\n414:         if (!providerTask || typeof providerTask.taskId !== \"string\") {\n415:           try {\n416:             const shouldSubmit = await store.beginSubmission(validTask.partyId, validTask.jobId, cameraId);\n417:             if (!shouldSubmit) {\n418:               job = await store.getJob(validTask.partyId, validTask.jobId);\n419:               providerTask = (job.providerTasks ?? {})[cameraId] as { taskId?: unknown } | undefined;\n420:             } else {\n421:               const request = jobPresetId === CAMEO_DEMO_PRESET.presetId\n422:                 ? buildCameoDemoRequest(validTask.jobId, validTask.idempotencyKey, cameraId, guestReference)\n423:                 : buildCheapDemoRequest(validTask.jobId, validTask.idempotencyKey, cameraId, guestReference);\n424:               const submitted = await (activeProvider ?? getProvider()).submit(request);\n425:               await store.recordSubmission(validTask.partyId, validTask.jobId, cameraId, submitted.taskId);\n426:               providerTask = { taskId: submitted.taskId };\n427:             }\n428:           } catch (error) {\n429:             const certainty = error instanceof AlibabaSubmissionError ? error.certainty : \"unknown\";\n430:             const errorCode = \"PROVIDER_UNAVAILABLE\";\n431:             await store.recordSubmissionFailure({ ...validTask, presetId: jobPresetId }, cameraId, errorCode, certainty);\n432:             await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n433:               success: false,\n434:               providerTaskId: null,\n435:               creditsCharged: null,\n436:               errorCode,\n437:             });\n438:             throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider submission did not complete safely.\");\n439:           }\n440:         }\n441:         if (typeof providerTask?.taskId !== \"string\") {\n442:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"No durable provider task ID is available; resubmission is disabled.\");\n443:         }\n444:         await store.heartbeat(validTask.partyId, validTask.jobId);\n445:         let status: ProviderTaskStatus;\n446:         try {\n447:           status = await pollUntilComplete(providerTask.taskId, activeProvider, jobDeadline);\n448:         } catch (error) {\n449:           await store.releaseWorker(validTask.partyId, validTask.jobId);\n450:           throw error;\n451:         }\n452:         if (status.state === \"FAILED\") {\n453:           // Surface the provider's failure reason in the worker error and on\n454:           // the job doc (truncated, sanitized — no credentials/URLs) so the\n455:           // next diagnosis does not need a manual API query. Empty reasons\n456:           // keep the legacy generic mapping.\n457:           const rawCode = typeof status.errorCode === \"string\" ? status.errorCode : \"\";\n458:           const rawMessage = typeof status.errorMessage === \"string\" ? status.errorMessage : \"\";\n459:           const sanitizedMessage = rawMessage\n460:             .replace(/https?:\\/\\/\\S+/gi, \"[url]\")\n461:             .replace(/wss?:\\/\\/\\S+/gi, \"[url]\")\n462:             .replace(/gs:\\/\\/\\S+/gi, \"[url]\")\n463:             .replace(/Bearer\\s+[A-Za-z0-9._~+/_=-]+/gi, \"Bearer [redacted]\")\n464:             .replace(/sk-[A-Za-z0-9_-]+/g, \"[redacted]\")\n465:             .replace(/[\\u0000-\\u001f\\u007f]+/g, \" \")\n466:             .replace(/\\s+/g, \" \")\n467:             .trim()\n468:             .slice(0, 280);\n469:           const detail = [rawCode, sanitizedMessage].map((part) => part.trim()).filter(Boolean).join(\": \");\n470:           const persistable = detail ? detail.slice(0, 280) : \"PROVIDER_FAILED\";\n471:           await store.recordProviderFailure({ ...validTask, presetId: jobPresetId }, cameraId, persistable);\n472:           await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n473:             success: false,\n474:             providerTaskId: providerTask.taskId,\n475:             creditsCharged: null,\n476:             errorCode: \"PROVIDER_UNAVAILABLE\",\n477:           });\n478:           if (detail) {\n479:             throw new BackendError(\"PROVIDER_UNAVAILABLE\", `Provider task failed (${detail.slice(0, 280)}).`);\n480:           }\n481:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider task failed.\");\n482:         }\n483:         let result: ProviderResult;\n484:         try {\n485:           result = await (activeProvider ?? getProvider()).getResult(providerTask.taskId);\n486:         } catch (error) {\n487:           if (error instanceof BackendError) throw error;\n488:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", `Provider result is unavailable; task ID ${String(providerTask.taskId)} retained for reconciliation.`);\n489:         }\n490:         const staged = await normalizeAndStage(validTask.partyId, validTask.jobId, cameraId, result);\n491:         await store.recordCameraResult(validTask.partyId, validTask.jobId, cameraId, result, status, staged);\n492:         await recordUsageOutcome(options.db, ledgerInput(job, cameraId), {\n493:           success: true,\n494:           secondsOut: result.secondsOut,\n495:           secondsIn: result.secondsIn,\n496:           creditsCharged: result.creditsCharged,\n497:           providerTaskId: providerTask.taskId,\n498:         });\n499:       }\n500:       const job = await store.getJob(validTask.partyId, validTask.jobId);\n501:       await publish(validTask.partyId, validTask.jobId, validTask.idempotencyKey);\n502:       return { jobId: validTask.jobId, state: \"ready\", manifestVersion: Number(job.manifestVersion) };\n503:     } catch (error) {\n504:       // A withdrawal racing the worker discards the already-running result and\n505:       // cleans staged bytes instead of publishing a revoked cameo.\n506:       if (isGuestJob && error instanceof BackendError && error.errorCode === \"FORBIDDEN\") {\n507:         const guestNow = await store.getJob(validTask.partyId, validTask.jobId).catch(() => undefined);\n508:         if (guestNow && ![\"failed\", \"ready\"].includes(String(guestNow.state))) {\n509:           await failForWithdrawnConsent(validTask.partyId, validTask.jobId).catch(() => undefined);\n510:         }\n511:       } else {\n512:         const latest = await store.getJob(validTask.partyId, validTask.jobId).catch(() => undefined);\n513:         if (latest && ![\"failed\", \"ready\"].includes(String(latest.state))) {\n514:           await store.releaseWorker(validTask.partyId, validTask.jobId).catch(() => undefined);\n515:         }\n516:       }\n517:       throw error;\n518:     }\n519:   }\n520: \n521:   return {\n522:     requestGeneration: (value) => store.requestGeneration(value),\n523:     getGenerationStatus: (value) => store.getGenerationStatus(value),\n524:     failEnqueue: (task) => store.failEnqueue(task),\n525:     runGeneration,\n526:     normalizeAndStage,\n527:     publishManifest: publish,\n528:   };\n529: }\n530: "}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192d1e063717d96664fa0913da2bf"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/src/generation.ts\"}"},"time":{"start":1793464590422,"end":1793464591169}}}}
