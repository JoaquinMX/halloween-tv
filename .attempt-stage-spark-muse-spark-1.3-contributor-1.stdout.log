<String>[second]);\n173:       expect(session.statuses[first], isNull);\n174:       expect(session.submissionId, second);\n175: \n176:       // The surviving submission still resolves: status reads back through\n177:       // the real session path with its channelId.\n178:       await session.recover();\n179:       expect(session.submissionIds, <String>[second]);\n180:       expect(session.statuses[second], 'eligible');\n181: \n182:       // And the second withdrawal resolves too.\n183:       await session.withdraw();\n184:       expect(calls.withdrawals, 2);\n185:       expect(session.submissionIds, isEmpty);\n186:       expect(session.status, 'withdrawn');\n187:       await dir.delete(recursive: true);\n188:     },\n189:   );\n190: \n191:   test('recover drops verified withdrawals and keeps the rest', () async {\n192:     SharedPreferences.setMockInitialValues({});\n193:     final dir = await Directory.systemTemp.createTemp();\n194:     final photo = File('${dir.path}/source.jpg')..writeAsBytesSync([1, 2, 3]);\n195:     final calls = Calls();\n196:     final session = GuestMediaSession(\n197:       client: GuestMediaClient(invoker: calls, transport: Put()),\n198:       partyId: 'party',\n199:       deviceId: 'device',\n200:       channelId: 'cctv',\n201:       tempDirectory: () async => dir,\n202:     );\n203:     await session.submit(photo, consent: true, confirmed: true);\n204:     await session.submit(photo, consent: true, confirmed: true);\n205:     final String first = session.submissionIds.first;\n206:     final String second = session.submissionIds.last;\n207:     // External withdrawal (another launch): the next recover observes the\n208:     // backend terminal state and clears only that receipt.\n209:     calls.states[first] = 'withdrawn';\n210:     await session.recover();\n211:     expect(session.submissionIds, <String>[second]);\n212:     expect(session.statuses[second], 'eligible');\n213:     await dir.delete(recursive: true);\n214:   });\n215: }","t