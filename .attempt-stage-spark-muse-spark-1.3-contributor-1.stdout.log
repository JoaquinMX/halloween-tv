tResponse;\n39:     if (override != null) {\n40:       nextResponse = null;\n41:       return override;\n42:     }\n43:     switch (name) {\n44:       case kListHostVideos:\n45:         return <String, Object?>{\n46:           'videos': <Object?>[for (final s in seeds) seedJson(s)],\n47:         };\n48:       case kGenerateHostVideo:\n49:         generates++;\n50:         return <String, Object?>{\n51:           'seedId': payload['seedId'],\n52:           'jobId': 'hv-${payload['seedId']}',\n53:           'state': 'queued',\n54:           'created': generates == 1,\n55:         };\n56:       case kGetHostVideoPreview:\n57:         final String seedId = payload['seedId'] as String;\n58:         return <String, Object?>{\n59:           'seedId': seedId,\n60:           'expiresAt': '2030-01-01T00:00:00.000Z',\n61:           'clips': <Object?>[\n62:             for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\n63:               <String, Object?>{\n64:                 'cameraId': camera,\n65:                 'sha256': List.filled(64, 'a').join(),\n66:                 'url': 'https://preview.example/$seedId/$camera.mp4',\n67:                 'expiresAt': '2030-01-01T00:00:00.000Z',\n68:               },\n69:           ],\n70:         };\n71:       case kDeleteHostVideo:\n72:         final List<String> ids = <String>[\n73:           for (final Object? id in payload['seedIds'] as List) id.toString(),\n74:         ];\n75:         seeds.removeWhere((s) => ids.contains(s.seedId));\n76:         return <String, Object?>{\n77:           'deletedSeedIds': ids,\n78:           'deletedObjects': <String>[\n79:             for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\n80:           ],\n81:           'revokedManifest': true,\n82:         };\n83:     }\n84:     throw StateError('unexpected callable $name');\n85:   }\n86: }\n87: \n88: HostSeedVideo seed(String id, String status) => HostSeedVideo(\n89:   seedId: id,\n90:   partyId: 'party-1',\n91:   channelId: 'cctv',\n92:   status: status,\n93:   jobId: 'hv-$id',\n94:   createdAt: '2026-10-29T14:00:00.000Z',\n95:   expiresAt: '2030-01-01T00:00:00.000Z',\n96:   previewAvailable: status == 'ready',\n97:   cameraIds: const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n98: );\n99: \n100: void main() {\n101:   test('list returns scoped seed entries across lifecycle states', () async {\n102:     final invoker = FakeHostMediaInvoker()\n103:       ..seeds.addAll(<HostSeedVideo>[\n104:         seed('a', 'queued'),\n105:         seed('b', 'running'),\n106:         seed('c', 'ready'),\n107:         seed('d', 'failed'),\n108:         seed('e', 'deleted'),\n109:       ]);\n110:     final videos = await HostMediaClient(invoker: invoker).listVideos(\n111:       partyId: 'party-1',\n112:       deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n113:       channelId: 'cctv',\n114:     );\n115:     expect(invoker.names, <String>[kListHostVideos]);\n116:     expect(invoker.payloads.single, containsPair('channelId', 'cctv'));\n117:     expect(videos.map((v) => '${v.seedId}:${v.status}'), <String>[\n118:       'a:queued',\n119:       'b:running',\n120:       'c:ready',\n121:       'd:failed',\n122:       'e:deleted',\n123:     ]);\n124:     expect(videos[2].previewAvailable, isTrue);\n125:   });\n126: \n127:   test(\n128:     'generate enqueues the fixed preset and rejects other presets',\n129:     () async {\n130:       final invoker = FakeHostMediaInvoker();\n131:       final client = HostMediaClient(invoker: invoker);\n132:       final result = await client.generateVideo(\n133:         partyId: 'party-1',\n134:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n135:         channelId: 'cctv',\n136:         seedId: 'catalog-1',\n137:         idempotencyKey: 'idem-1',\n138:       );\n139:       expect(result['seedId'], 'catalog-1');\n140:       expect(result['jobId'], 'hv-catalog-1');\n141:       expect(invoker.payloads.single['presetId'], kCheapDemoPresetId);\n142:       await expectLater(\n143:         client.generateVideo(\n144:           partyId: 'party-1',\n145:           deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n146:           channelId: 'cctv',\n147:           seedId: 'catalog-2',\n148:           idempotencyKey: 'idem-2',\n149:           presetId: 'ultra_cinema',\n150:         ),\n151:         throwsArgumentError,\n152:       );\n153:       expect(invoker.generates, 1);\n154:     },\n155:   );\n156: \n157:   test('preview returns fresh signed clips with https URLs', () async {\n158:     final invoker = FakeHostMediaInvoker();\n159:     final preview = await HostMediaClient(invoker: invoker).getPreview(\n160:       partyId: 'party-1',\n161:       deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n162:       channelId: 'cctv',\n163:       seedId: 'catalog-1',\n164:     );\n165:     expect(preview.seedId, 'catalog-1');\n166:     expect(preview.clips, hasLength(4));\n167:     expect(preview.clips.map((c) => c.cameraId), <String>[\n168:       'CAM-01',\n169:       'CAM-02',\n170:       'CAM-03',\n171:       'CAM-04',\n172:     ]);\n173:     for (final clip in preview.clips) {\n174:       expect(clip.url.scheme, 'https');\n175:     }\n176:   });\n177: \n178:   test('delete reconciles per selected seed id', () async {\n179:     final invoker = FakeHostMediaInvoker()\n180:       ..seeds.addAll(<HostSeedVideo>[seed('a', 'ready'), seed('b', 'ready')]);\n181:     final client = HostMediaClient(invoker: invoker);\n182:     final result = await client.deleteVideos(\n183:       partyId: 'party-1',\n184:       deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n185:       channelId: 'cctv',\n186:       seedIds: const <String>['a'],\n187:     );\n188:     expect(result['deletedSeedIds'], <String>['a']);\n189:     expect(result['revokedManifest'], isTrue);\n190:     expect(\n191:       (await client.listVideos(\n192:         partyId: 'party-1',\n193:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n194:         channelId: 'cctv',\n195:       )).map((v) => v.seedId),\n196:       <String>['b'],\n197:     );\n198:   });\n199: \n200:   test('rejects cross-party entries and malformed shapes', () async {\n201:     final invoker = FakeHostMediaInvoker();\n202:     final client = HostMediaClient(invoker: invoker);\n203:     invoker.seeds.add(\n204:       const HostSeedVideo(\n205:         seedId: 'x',\n206:         partyId: 'other-party',\n207:         channelId: 'cctv',\n208:         status: 'ready',\n209:         jobId: 'hv-x',\n210:         createdAt: '2026-10-29T14:00:00.000Z',\n211:         expiresAt: '2030-01-01T00:00:00.000Z',\n212:         previewAvailable: true,\n213:         cameraIds: <String>['CAM-01'],\n214:       ),\n215:     );\n216:     await expectLater(\n217:       client.listVideos(\n218:         partyId: 'party-1',\n219:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n220:         channelId: 'cctv',\n221:       ),\n222:       throwsFormatException,\n223:     );\n224:     invoker.seeds.clear();\n225:     invoker.nextResponse = <String, Object?>{'unexpected': 'shape'};\n226:     await expectLater(\n227:       client.listVideos(\n228:         partyId: 'party-1',\n229:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n230:         channelId: 'cctv',\n231:       ),\n232:       throwsFormatException,\n233:     );\n234:   });\n235: \n236:   test('bounds a callable that never completes', () async {\n237:     final client = HostMediaClient(\n238:       invoker: _PendingInvoker(),\n239:       timeout: const Duration(milliseconds: 5),\n240:     );\n241:     await expectLater(\n242:       client.listVideos(\n243:         partyId: 'party-1',\n244:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n245:         channelId: 'cctv',\n246:       ),\n247:       throwsA(isA<ManifestTransportException>()),\n248:     );\n249:   });\n250: }\n251: \n252: final class _PendingInvoker implements HostMediaCallableInvoker {\n253:   @override\n254:   Future<Object?> call(String name, Map<String, Object?> payload) =>\n255:       Completer<Object?>().future;\n256: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c366e0707793f957a659714b28"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/test/host_media_client_test.dart\"}"},"time":{"start":1793463641925,"end":1793463642618}}}}
{"type":"tool_use","timestamp":1793463642619,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c36428001ZqwrGFSltxrW5w","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c3523e001pqao4OVUt0Gpa2","type":"tool","id":"call_01a192c363fe7190ab89073d85c69567","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/join/guest_join_data.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/join/guest_join_data.dart, lines 1-254\n1: /// Anonymous join payload parsing with a validated host/guest role.\n2: ///\n3: /// The TV renders two distinct QR capabilities, and the companion boots to a\n4: /// dedicated host entry screen ([HostEntryScreen]) precisely so the two can\n5: /// never be confused:\n6: ///\n7: /// - Guest route (legacy-compatible): `{partyId, channelId, joinPin?}` with\n8: ///   NO `role` key. An absent role means **guest** so every payload printed\n9: ///   before roles existed keeps working.\n10: /// - Host route: `{partyId, channelId, role: \"host\", inviteToken: \"hi-…\"}`\n11: ///   carrying the server-minted invite capability. The token is never a\n12: ///   six-digit guest PIN (PIN-shaped tokens are rejected, mirroring the\n13: ///   backend `parseJoinHostInput` gate) and a host payload never carries a\n14: ///   `joinPin`.\n15: ///\n16: /// Any other `role` value (or a non-string role) fails visibly instead of\n17: /// guessing, and malformed host capabilities (host without a valid invite\n18: /// token, guest carrying an invite token) fail visibly too. Guest entry\n19: /// must never register a host payload through `joinParty`: the join screens\n20: /// route on [JoinRole] before any callable is invoked.\n21: library;\n22: \n23: import 'dart:convert';\n24: import 'package:core_foundation/core_foundation.dart';\n25: \n26: const int kMaxBindingIdLength = 128;\n27: final RegExp kBindingIdPattern = RegExp(r'^[A-Za-z0-9][A-Za-z0-9._-]*$');\n28: final RegExp _phoneId = RegExp(r'^p-[0-9a-f]{32}$');\n29: final RegExp _pin = RegExp(r'^[0-9]{6}$');\n30: \n31: /// Server-assigned device role carried by a join payload.\n32: ///\n33: /// Clients can never self-assign privilege: this only selects which\n34: /// redemption callable (`joinParty` vs `joinHost`) the payload is routed to,\n35: /// and the backend assigns the actual role server-side.\n36: enum JoinRole { guest, host }\n37: \n38: final class GuestJoinData {\n39:   final PartyId partyId;\n40:   final DeviceId deviceId;\n41:   final String channelId;\n42:   final String? joinPin;\n43:   final JoinRole role;\n44:   final String? inviteToken;\n45:   const GuestJoinData({\n46:     required this.partyId,\n47:     required this.deviceId,\n48:     required this.channelId,\n49:     this.joinPin,\n50:     this.role = JoinRole.guest,\n51:     this.inviteToken,\n52:   });\n53:   @override\n54:   bool operator ==(Object other) =>\n55:       other is GuestJoinData &&\n56:       other.partyId == partyId &&\n57:       other.deviceId == deviceId &&\n58:       other.channelId == channelId &&\n59:       other.joinPin == joinPin &&\n60:       other.role == role &&\n61:       other.inviteToken == inviteToken;\n62:   @override\n63:   int get hashCode =>\n64:       Object.hash(partyId, deviceId, channelId, joinPin, role, inviteToken);\n65:   @override\n66:   String toString() =>\n67:       'GuestJoinData($partyId/$channelId@$deviceId role=$role)';\n68: }\n69: \n70: Result<String> _validate(String field, String raw) {\n71:   final String value = raw.trim();\n72:   if (value.isEmpty) return Err<String>('$field must be non-empty');\n73:   if (value.length > kMaxBindingIdLength ||\n74:       !kBindingIdPattern.hasMatch(value)) {\n75:     return Err<String>('$field is malformed');\n76:   }\n77:   return Ok<String>(value);\n78: }\n79: \n80: /// Validates a host invite capability (never a guest PIN).\n81: ///\n82: /// Mirrors the backend `parseJoinHostInput` gate: the token is a\n83: /// server-minted capability, so a six-digit PIN shape is rejected here\n84: /// instead of consuming a host redemption attempt.\n85: Result<String> _validateInviteToken(String? raw) {\n86:   if (raw == null || raw.trim().isEmpty) {\n87:     return const Err<String>('host inviteToken is required');\n88:   }\n89:   final String value = raw.trim();\n90:   if (value.length > 256) {\n91:     return const Err<String>('host inviteToken is invalid');\n92:   }\n93:   if (_pin.hasMatch(value)) {\n94:     return const Err<String>(\n95:       'inviteToken must be a host invite, not a guest PIN',\n96:     );\n97:   }\n98:   return Ok<String>(value);\n99: }\n100: \n101: Result<GuestJoinData> parseGuestJoinFields({\n102:   required String partyId,\n103:   required String localDeviceId,\n104:   required String channelId,\n105:   String? joinPin,\n106:   JoinRole role = JoinRole.guest,\n107:   String? inviteToken,\n108: }) {\n109:   if (!_phoneId.hasMatch(localDeviceId)) {\n110:     return const Err<GuestJoinData>('local device identity is malformed');\n111:   }\n112:   final party = _validate('partyId', partyId);\n113:   if (party is Err<String>) return Err<GuestJoinData>(party.message);\n114:   final channel = _validate('channelId', channelId);\n115:   if (channel is Err<String>) return Err<GuestJoinData>(channel.message);\n116:   if (role == JoinRole.host) {\n117:     if (joinPin != null && joinPin.trim().isNotEmpty) {\n118:       return const Err<GuestJoinData>(\n119:         'host join must carry an inviteToken, not a joinPin',\n120:       );\n121:     }\n122:     final token = _validateInviteToken(inviteToken);\n123:     if (token is Err<String>) return Err<GuestJoinData>(token.message);\n124:     return Ok<GuestJoinData>(\n125:       GuestJoinData(\n126:         partyId: PartyId((party as Ok<String>).value),\n127:         deviceId: DeviceId(localDeviceId),\n128:         channelId: (channel as Ok<String>).value,\n129:         role: JoinRole.host,\n130:         inviteToken: (token as Ok<String>).value,\n131:       ),\n132:     );\n133:   }\n134:   if (inviteToken != null && inviteToken.trim().isNotEmpty) {\n135:     return const Err<GuestJoinData>(\n136:       'guest join must not carry a host inviteToken',\n137:     );\n138:   }\n139:   final String? normalizedPin = joinPin?.trim().isEmpty ?? true\n140:       ? null\n141:       : joinPin!.trim();\n142:   if (normalizedPin != null && !_pin.hasMatch(normalizedPin)) {\n143:     return const Err<GuestJoinData>('joinPin must contain exactly six digits');\n144:   }\n145:   return Ok<GuestJoinData>(\n146:     GuestJoinData(\n147:       partyId: PartyId((party as Ok<String>).value),\n148:       deviceId: DeviceId(localDeviceId),\n149:       channelId: (channel as Ok<String>).value,\n150:       joinPin: normalizedPin,\n151:     ),\n152:   );\n153: }\n154: \n155: /// Convenience for the host entry form: a host-typed field set.\n156: Result<GuestJoinData> parseHostJoinFields({\n157:   required String partyId,\n158:   required String localDeviceId,\n159:   required String channelId,\n160:   required String inviteToken,\n161: }) => parseGuestJoinFields(\n162:   partyId: partyId,\n163:   localDeviceId: localDeviceId,\n164:   channelId: channelId,\n165:   role: JoinRole.host,\n166:   inviteToken: inviteToken,\n167: );\n168: \n169: /// Parses a scanned or pasted join payload through the shared validator.\n170: ///\n171: /// Scan and paste stay in parity: both funnel here. An absent `role` means\n172: /// guest (legacy payloads); `role: \"guest\"` is explicit guest;\n173: /// `role: \"host\"` requires a valid `inviteToken`. Unknown roles, non-string\n174: /// roles, and malformed host capabilities fail visibly.\n175: Result<GuestJoinData> parseGuestJoinPayload(\n176:   String raw, {\n177:   required String localDeviceId,\n178: }) {\n179:   final String trimmed = raw.trim();\n180:   if (trimmed.isEmpty ||\n181:       RegExp(\n182:         r'^(https?|javascript|data):',\n183:         caseSensitive: false,\n184:       ).hasMatch(trimmed)) {\n185:     return const Err<GuestJoinData>(\n186:       'join payload must be identifier data, not a URL',\n187:     );\n188:   }\n189:   late final Object? decoded;\n190:   try {\n191:     decoded = jsonDecode(trimmed);\n192:   } on FormatException {\n193:     return const Err<GuestJoinData>('join payload is not valid JSON');\n194:   }\n195:   if (decoded is! Map) {\n196:     return const Err<GuestJoinData>('join payload must be a JSON object');\n197:   }\n198:   final Map<String, Object?> json = Map<String, Object?>.from(\n199:     decoded.map((Object? k, Object? v) => MapEntry(k.toString(), v)),\n200:   );\n201:   String? field(String key, String snake) {\n202:     final value = json[key] ?? json[snake];\n203:     return value is String ? value : null;\n204:   }\n205: \n206:   JoinRole role = JoinRole.guest;\n207:   if (json.containsKey('role')) {\n208:     final Object? rawRole = json['role'];\n209:     if (rawRole is! String) {\n210:       return const Err<GuestJoinData>(\n211:         'join payload role must be \"guest\" or \"host\"',\n212:       );\n213:     }\n214:     switch (rawRole.trim()) {\n215:       case 'guest':\n216:         role = JoinRole.guest;\n217:       case 'host':\n218:         role = JoinRole.host;\n219:       default:\n220:         return Err<GuestJoinData>(\n221:           'join payload has unknown role \"${rawRole.trim()}\"',\n222:         );\n223:     }\n224:   }\n225: \n226:   final party = field('partyId', 'party_id');\n227:   final channel = field('channelId', 'channel_id');\n228:   final pinValue = json['joinPin'] ?? json['join_pin'];\n229:   // A present-but-non-string PIN is a PIN error, not an identifier error.\n230:   if (pinValue != null && pinValue is! String) {\n231:     return const Err<GuestJoinData>('joinPin must contain exactly six digits');\n232:   }\n233:   if (party == null || channel == null) {\n234:     return const Err<GuestJoinData>(\n235:       'join payload must contain string partyId and channelId',\n236:     );\n237:   }\n238:   String? inviteToken;\n239:   if (json.containsKey('inviteToken') || json.containsKey('invite_token')) {\n240:     final Object? rawToken = json['inviteToken'] ?? json['invite_token'];\n241:     if (rawToken is! String) {\n242:       return const Err<GuestJoinData>('host inviteToken must be a string');\n243:     }\n244:     inviteToken = rawToken;\n245:   }\n246:   return parseGuestJoinFields(\n247:     partyId: party,\n248:     localDeviceId: localDeviceId,\n249:     channelId: channel,\n250:     joinPin: pinValue as String?,\n251:     role: role,\n252:     inviteToken: inviteToken,\n253:   );\n254: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/join/guest_join_data.dart, lines 1-254\n1: /// Anonymous join payload parsing with a validated host/guest role.\n2: ///\n3: /// The TV renders two distinct QR capabilities, and the companion boots to a\n4: /// dedicated host entry screen ([HostEntryScreen]) precisely so the two can\n5: /// never be confused:\n6: ///\n7: /// - Guest route (legacy-compatible): `{partyId, channelId, joinPin?}` with\n8: ///   NO `role` key. An absent role means **guest** so every payload printed\n9: ///   before roles existed keeps working.\n10: /// - Host route: `{partyId, channelId, role: \"host\", inviteToken: \"hi-…\"}`\n11: ///   carrying the server-minted invite capability. The token is never a\n12: ///   six-digit guest PIN (PIN-shaped tokens are rejected, mirroring the\n13: ///   backend `parseJoinHostInput` gate) and a host payload never carries a\n14: ///   `joinPin`.\n15: ///\n16: /// Any other `role` value (or a non-string role) fails visibly instead of\n17: /// guessing, and malformed host capabilities (host without a valid invite\n18: /// token, guest carrying an invite token) fail visibly too. Guest entry\n19: /// must never register a host payload through `joinParty`: the join screens\n20: /// route on [JoinRole] before any callable is invoked.\n21: library;\n22: \n23: import 'dart:convert';\n24: import 'package:core_foundation/core_foundation.dart';\n25: \n26: const int kMaxBindingIdLength = 128;\n27: final RegExp kBindingIdPattern = RegExp(r'^[A-Za-z0-9][A-Za-z0-9._-]*$');\n28: final RegExp _phoneId = RegExp(r'^p-[0-9a-f]{32}$');\n29: final RegExp _pin = RegExp(r'^[0-9]{6}$');\n30: \n31: /// Server-assigned device role carried by a join payload.\n32: ///\n33: /// Clients can never self-assign privilege: this only selects which\n34: /// redemption callable (`joinParty` vs `joinHost`) the payload is routed to,\n35: /// and the backend assigns the actual role server-side.\n36: enum JoinRole { guest, host }\n37: \n38: final class GuestJoinData {\n39:   final PartyId partyId;\n40:   final DeviceId deviceId;\n41:   final String channelId;\n42:   final String? joinPin;\n43:   final JoinRole role;\n44:   final String? inviteToken;\n45:   const GuestJoinData({\n46:     required this.partyId,\n47:     required this.deviceId,\n48:     required this.channelId,\n49:     this.joinPin,\n50:     this.role = JoinRole.guest,\n51:     this.inviteToken,\n52:   });\n53:   @override\n54:   bool operator ==(Object other) =>\n55:       other is GuestJoinData &&\n56:       other.partyId == partyId &&\n57:       other.deviceId == deviceId &&\n58:       other.channelId == channelId &&\n59:       other.joinPin == joinPin &&\n60:       other.role == role &&\n61:       other.inviteToken == inviteToken;\n62:   @override\n63:   int get hashCode =>\n64:       Object.hash(partyId, deviceId, channelId, joinPin, role, inviteToken);\n65:   @override\n66:   String toString() =>\n67:       'GuestJoinData($partyId/$channelId@$deviceId role=$role)';\n68: }\n69: \n70: Result<String> _validate(String field, String raw) {\n71:   final String value = raw.trim();\n72:   if (value.isEmpty) return Err<String>('$field must be non-empty');\n73:   if (value.length > kMaxBindingIdLength ||\n74:       !kBindingIdPattern.hasMatch(value)) {\n75:     return Err<String>('$field is malformed');\n76:   }\n77:   return Ok<String>(value);\n78: }\n79: \n80: /// Validates a host invite capability (never a guest PIN).\n81: ///\n82: /// Mirrors the backend `parseJoinHostInput` gate: the token is a\n83: /// server-minted capability, so a six-digit PIN shape is rejected here\n84: /// instead of consuming a host redemption attempt.\n85: Result<String> _validateInviteToken(String? raw) {\n86:   if (raw == null || raw.trim().isEmpty) {\n87:     return const Err<String>('host inviteToken is required');\n88:   }\n89:   final String value = raw.trim();\n90:   if (value.length > 256) {\n91:     return const Err<String>('host inviteToken is invalid');\n92:   }\n93:   if (_pin.hasMatch(value)) {\n94:     return const Err<String>(\n95:       'inviteToken must be a host invite, not a guest PIN',\n96:     );\n97:   }\n98:   return Ok<String>(value);\n99: }\n100: \n101: Result<GuestJoinData> parseGuestJoinFields({\n102:   required String partyId,\n103:   required String localDeviceId,\n104:   required String channelId,\n105:   String? joinPin,\n106:   JoinRole role = JoinRole.guest,\n107:   String? inviteToken,\n108: }) {\n109:   if (!_phoneId.hasMatch(localDeviceId)) {\n110:     return const Err<GuestJoinData>('local device identity is malformed');\n111:   }\n112:   final party = _validate('partyId', partyId);\n113:   if (party is Err<String>) return Err<GuestJoinData>(party.message);\n114:   final channel = _validate('channelId', channelId);\n115:   if (channel is Err<String>) return Err<GuestJoinData>(channel.message);\n116:   if (role == JoinRole.host) {\n117:     if (joinPin != null && joinPin.trim().isNotEmpty) {\n118:       return const Err<GuestJoinData>(\n119:         'host join must carry an inviteToken, not a joinPin',\n120:       );\n121:     }\n122:     final token = _validateInviteToken(inviteToken);\n123:     if (token is Err<String>) return Err<GuestJoinData>(token.message);\n124:     return Ok<GuestJoinData>(\n125:       GuestJoinData(\n126:         partyId: PartyId((party as Ok<String>).value),\n127:         deviceId: DeviceId(localDeviceId),\n128:         channelId: (channel as Ok<String>).value,\n129:         role: JoinRole.host,\n130:         inviteToken: (token as Ok<String>).value,\n131:       ),\n132:     );\n133:   }\n134:   if (inviteToken != null && inviteToken.trim().isNotEmpty) {\n135:     return const Err<GuestJoinData>(\n136:       'guest join must not carry a host inviteToken',\n137:     );\n138:   }\n139:   final String? normalizedPin = joinPin?.trim().isEmpty ?? true\n140:       ? null\n141:       : joinPin!.trim();\n142:   if (normalizedPin != null && !_pin.hasMatch(normalizedPin)) {\n143:     return const Err<GuestJoinData>('joinPin must contain exactly six digits');\n144:   }\n145:   return Ok<GuestJoinData>(\n146:     GuestJoinData(\n147:       partyId: PartyId((party as Ok<String>).value),\n148:       deviceId: DeviceId(localDeviceId),\n149:       channelId: (channel as Ok<String>).value,\n150:       joinPin: normalizedPin,\n151:     ),\n152:   );\n153: }\n154: \n155: /// Convenience for the host entry form: a host-typed field set.\n156: Result<GuestJoinData> parseHostJoinFields({\n157:   required String partyId,\n158:   required String localDeviceId,\n159:   required String channelId,\n160:   required String inviteToken,\n161: }) => parseGuestJoinFields(\n162:   partyId: partyId,\n163:   localDeviceId: localDeviceId,\n164:   channelId: channelId,\n165:   role: JoinRole.host,\n166:   inviteToken: inviteToken,\n167: );\n168: \n169: /// Parses a scanned or pasted join payload through the shared validator.\n170: ///\n171: /// Scan and paste stay in parity: both funnel here. An absent `role` means\n172: /// guest (legacy payloads); `role: \"guest\"` is explicit guest;\n173: /// `role: \"host\"` requires a valid `inviteToken`. Unknown roles, non-string\n174: /// roles, and malformed host capabilities fail visibly.\n175: Result<GuestJoinData> parseGuestJoinPayload(\n176:   String raw, {\n177:   required String localDeviceId,\n178: }) {\n179:   final String trimmed = raw.trim();\n180:   if (trimmed.isEmpty ||\n181:       RegExp(\n182:         r'^(https?|javascript|data):',\n183:         caseSensitive: false,\n184:       ).hasMatch(trimmed)) {\n185:     return const Err<GuestJoinData>(\n186:       'join payload must be identifier data, not a URL',\n187:     );\n188:   }\n189:   late final Object? decoded;\n190:   try {\n191:     decoded = jsonDecode(trimmed);\n192:   } on FormatException {\n193:     return const Err<GuestJoinData>('join payload is not valid JSON');\n194:   }\n195:   if (decoded is! Map) {\n196:     return const Err<GuestJoinData>('join payload must be a JSON object');\n197:   }\n198:   final Map<String, Object?> json = Map<String, Object?>.from(\n199:     decoded.map((Object? k, Object? v) => MapEntry(k.toString(), v)),\n200:   );\n201:   String? field(String key, String snake) {\n202:     final value = json[key] ?? json[snake];\n203:     return value is String ? value : null;\n204:   }\n205: \n206:   JoinRole role = JoinRole.guest;\n207:   if (json.containsKey('role')) {\n208:     final Object? rawRole = json['role'];\n209:     if (rawRole is! String) {\n210:       return const Err<GuestJoinData>(\n211:         'join payload role must be \"guest\" or \"host\"',\n212:       );\n213:     }\n214:     switch (rawRole.trim()) {\n215:       case 'guest':\n216:         role = JoinRole.guest;\n217:       case 'host':\n218:         role = JoinRole.host;\n219:       default:\n220:         return Err<GuestJoinData>(\n221:           'join payload has unknown role \"${rawRole.trim()}\"',\n222:         );\n223:     }\n224:   }\n225: \n226:   final party = field('partyId', 'party_id');\n227:   final channel = field('channelId', 'channel_id');\n228:   final pinValue = json['joinPin'] ?? json['join_pin'];\n229:   // A present-but-non-string PIN is a PIN error, not an identifier error.\n230:   if (pinValue != null && pinValue is! String) {\n231:     return const Err<GuestJoinData>('joinPin must contain exactly six digits');\n232:   }\n233:   if (party == null || channel == null) {\n234:     return const Err<GuestJoinData>(\n235:       'join payload must contain string partyId and channelId',\n236:     );\n237:   }\n238:   String? inviteToken;\n239:   if (json.containsKey('inviteToken') || json.containsKey('invite_token')) {\n240:     final Object? rawToken = json['inviteToken'] ?? json['invite_token'];\n241:     if (rawToken is! String) {\n242:       return const Err<GuestJoinData>('host inviteToken must be a string');\n243:     }\n244:     inviteToken = rawToken;\n245:   }\n246:   return parseGuestJoinFields(\n247:     partyId: party,\n248:     localDeviceId: localDeviceId,\n249:     channelId: channel,\n250:     joinPin: pinValue as String?,\n251:     role: role,\n252:     inviteToken: inviteToken,\n253:   );\n254: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c363fe7190ab89073d85c69567"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/join/guest_join_data.dart\"}"},"time":{"start":1793463641128,"end":1793463642619}}}}
