"2026-10-29T14:00:00.000Z\",\n148:     \"expiresAt\": \"2026-11-29T15:00:00.000Z\"\n149:   },\n150:   \"getCurrentManifest\": {\n151:     \"request\": {\n152:       \"partyId\": \"pilot\",\n153:       \"deviceId\": \"tv-pilot\",\n154:       \"channelId\": \"main\"\n155:     },\n156:     \"response\": {\n157:       \"partyId\": \"pilot\",\n158:       \"channelId\": \"main\",\n159:       \"version\": 1,\n160:       \"schemaVersion\": 1,\n161:       \"jobId\": \"job-1\",\n162:       \"cameraClips\": [\n163:         {\n164:           \"cameraId\": \"CAM-01\",\n165:           \"durationMs\": 2000,\n166:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n167:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-01.mp4\",\n168:           \"sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n169:           \"sizeBytes\": 12345\n170:         },\n171:         {\n172:           \"cameraId\": \"CAM-02\",\n173:           \"durationMs\": 2000,\n174:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n175:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-02.mp4\",\n176:           \"sha256\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n177:           \"sizeBytes\": 12346\n178:         },\n179:         {\n180:           \"cameraId\": \"CAM-03\",\n181:           \"durationMs\": 2000,\n182:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n183:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-03.mp4\",\n184:           \"sha256\": \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\n185:           \"sizeBytes\": 12347\n186:         },\n187:         {\n188:           \"cameraId\": \"CAM-04\",\n189:           \"durationMs\": 2000,\n190:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n191:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-04.mp4\",\n192:           \"sha256\": \"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\n193:           \"sizeBytes\": 12348\n194:         }\n195:       ],\n196:       \"createdAt\": \"2026-10-29T14:00:00.000Z\",\n197:       \"expiresAt\": \"2026-11-29T15:00:00.000Z\"\n198:     }\n199:   },\n200:   \"requestGeneration\": {\n201:     \"request\": {\n202:       \"partyId\": \"pilot\",\n203:       \"deviceId\": \"tv-pilot\",\n204:       \"channelId\": \"main\",\n205:       \"jobId\": \"job-1\",\n206:       \"idempotencyKey\": \"job-1\",\n207:       \"presetId\": \"cheap_demo\"\n208:     },\n209:     \"response\": {\n210:       \"jobId\": \"job-1\",\n211:       \"state\": \"queued\",\n212:       \"created\": true\n213:     }\n214:   },\n215:   \"services\": [\n216:     \"requestGeneration\",\n217:     \"runGeneration\",\n218:     \"normalizeAndStage\",\n219:     \"publishManifest\",\n220:     \"getCurrentManifest\",\n221:     \"getDeliveryUrls\",\n222:     \"acknowledgeDelivery\",\n223:     \"sweepExpiredMedia\",\n224:     \"requestGuestUpload\",\n225:     \"completeGuestUpload\",\n226:     \"getGuestMediaStatus\",\n227:     \"withdrawGuestMedia\"\n228:   ],\n229:   \"guestConsent\": {\n230:     \"textVersion\": \"v1\",\n231:     \"purpose\": \"guest_cameo\",\n232:     \"uploadTtlMs\": 900000,\n233:     \"inputTtlMs\": 86400000,\n234:     \"maxImageBytes\": 10485760,\n235:     \"contentTypes\": [\"image/jpeg\", \"image/png\"],\n236:     \"objectPrefix\": \"parties/{partyId}/guests/{deviceId}/ingest/{submissionId}/photo.jpg\",\n237:     \"providerCamera\": \"CAM-01\",\n238:     \"fixtureCameras\": [\"CAM-02\", \"CAM-03\", \"CAM-04\"]\n239:   }\n240: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/test/fixtures/backend_contract_v1.json, lines 1-240\n1: {\n2:   \"schemaVersion\": 1,\n3:   \"canonicalManifestHash\": \"c3114a6601be504d1be045749e00512bc249aa70ca365b804e26695d94265692\",\n4:   \"acknowledgeDelivery\": {\n5:     \"request\": {\n6:       \"partyId\": \"pilot\",\n7:       \"deviceId\": \"tv-pilot\",\n8:       \"channelId\": \"main\",\n9:       \"manifestVersion\": 1,\n10:       \"clipHashes\": {\n11:         \"CAM-01\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n12:         \"CAM-02\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n13:         \"CAM-03\": \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\n14:         \"CAM-04\": \"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\"\n15:       }\n16:     },\n17:     \"response\": {\n18:       \"ackId\": \"47aa92e83cf6a4e3cf5ad02a1421357fc29f4fb236f415553e3f6bc8594b1541\",\n19:       \"manifestVersion\": 1,\n20:       \"purged\": true\n21:     }\n22:   },\n23:   \"cheapDemoPreset\": {\n24:     \"aspectRatio\": \"16:9\",\n25:     \"audio\": false,\n26:     \"autoUpscale\": false,\n27:     \"modelId\": \"wan3.0-video\",\n28:     \"outputs\": 1,\n29:     \"presetId\": \"cheap_demo\",\n30:     \"region\": \"singapore\",\n31:     \"resolution\": \"480P\",\n32:     \"secondsOut\": 2\n33:   },\n34:   \"costLogFields\": [\n35:     \"model_id\",\n36:     \"preset_id\",\n37:     \"seconds_out\",\n38:     \"seconds_in\",\n39:     \"credits_charged\",\n40:     \"provider_task_id\",\n41:     \"created_at\",\n42:     \"success\",\n43:     \"partyId\",\n44:     \"deviceId\",\n45:     \"channelId\",\n46:     \"manifestVersion\",\n47:     \"timestamp\",\n48:     \"idempotencyKey\"\n49:   ],\n50:   \"deliveryUrls\": {\n51:     \"request\": {\n52:       \"partyId\": \"pilot\",\n53:       \"deviceId\": \"tv-pilot\",\n54:       \"channelId\": \"main\"\n55:     },\n56:     \"response\": {\n57:       \"manifestHash\": \"c3114a6601be504d1be045749e00512bc249aa70ca365b804e26695d94265692\",\n58:       \"manifestVersion\": 1,\n59:       \"clips\": [\n60:         {\n61:           \"cameraId\": \"CAM-01\",\n62:           \"sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa