yInput(value);\n37:       return db.runTransaction(async (transaction) => {\n38:         const partyRef = db.doc(`parties/${input.partyId}`);\n39:         const channelRef = partyRef.collection(\"channels\").doc(input.channelId);\n40:         const deviceRef = partyRef.collection(\"devices\").doc(input.deviceId);\n41:         const [partySnap, channelSnap, deviceSnap] = await Promise.all([\n42:           transaction.get(partyRef),\n43:           transaction.get(channelRef),\n44:           transaction.get(deviceRef),\n45:         ]);\n46:         if (!partySnap.exists) {\n47:           console.warn(`joinParty rejected: unknown party ${input.partyId}`);\n48:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n49:         }\n50:         const party = partySnap.data()!;\n51:         if (party.status !== \"active\") {\n52:           console.warn(`joinParty rejected: inactive party ${input.partyId}`);\n53:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n54:         }\n55:         if (party.activeChannelId !== input.channelId) {\n56:           console.warn(\n57:             `joinParty rejected: channel ${input.channelId} is not active for party ${input.partyId}`,\n58:           );\n59:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n60:         }\n61:         if (!channelSnap.exists) {\n62:           console.warn(\n63:             `joinParty rejected: channel ${input.channelId} is not registered for party ${input.partyId}`,\n64:           );\n65:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n66:         }\n67:         const channel = channelSnap.data()!;\n68:         if (channel.partyId !== input.partyId || channel.status !== \"active\") {\n69:           console.warn(\n70:             `joinParty rejected: channel doc ${input.channelId} is inactive or mismatched for party ${input.partyId}`,\n71:           );\n72:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n73:         }\n74:         // Fail closed: ANY present-but-invalid stored PIN (number/boolean/\n75:         // malformed string written via console) counts as configured and\n76:         // rejects every attempt. Only a missing field or an empty string\n77:         // means \"no PIN configured\".\n78:         const storedPin: unknown = party.joinPin;\n79:         const pinUnset = storedPin === undefined || storedPin === \"\";\n80:         if (!pinUnset) {\n81:           if (typeof storedPin !== \"string\" || !JOIN_PIN_RE.test(storedPin)) {\n82:             console.warn(\n83:               `joinParty rejected: party ${input.partyId} has a misconfigured joinPin; re-provision it with seed_join`,\n84:             );\n85:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n86:           }\n87:           if (input.joinPin !== storedPin) {\n88:             console.warn(\n89:               `joinParty rejected: wrong or missing join PIN for party ${input.partyId}`,\n90:             );\n91:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n92:           }\n93:         }\n94:         if (deviceSnap.exists) {\n95:           const device = deviceSnap.data()!;\n96:           if (\n97:             device.partyId !== input.partyId ||\n98:             device.role !== \"guest\" ||\n99:             device.status !== \"active\" ||\n100:             (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n101:           ) {\n102:             console.warn(\n103:               `joinParty rejected: device ${input.deviceId} is not a valid guest registration for party ${input.partyId}`,\n104:             );\n105:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n106:           }\n107:           return {\n108:             partyId: input.partyId,\n109:             deviceId: input.deviceId,\n110:             channelId: input.channelId,\n111:             role: \"guest\" as const,\n112:             status: \"active\" as const,\n113:             created: false,\n114:           };\n115:         }\n116:         transaction.set(deviceRef, {\n117:           partyId: input.partyId,\n118:           deviceId: input.deviceId,\n119:           role: \"guest\",\n120:           status: \"active\",\n121:           registeredAt: FieldValue.serverTimestamp(),\n122:         });\n123:         return {\n124:           partyId: input.partyId,\n125:           deviceId: input.deviceId,\n126:           channelId: input.channelId,\n127:           role: \"guest\" as const,\n128:           status: \"active\" as const,\n129:           created: true,\n130:         };\n131:       });\n132:     },\n133:   };\n134: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/join_party.ts, lines 1-134\n1: import { FieldValue, Firestore } from \"firebase-admin/firestore\";\n2: import { BackendError, JOIN_PIN_RE, parseJoinPartyInput } from \"./contracts\";\n3: \n4: /** Single rejection message shared by every join gate (see above). */\n5: const JOIN_REJECTED_MESSAGE = \"Join request was rejected.\";\n6: \n7: export interface JoinPartyResult {\n8:   partyId: string;\n9:   deviceId: string;\n10:   channelId: string;\n11:   role: \"guest\";\n12:   status: \"active\";\n13:   created: boolean;\n14: }\n15: \n16: export interface JoinPartyServiceOptions {\n17:   db: Firestore;\n18: }\n19: \n20: /**\n21:  * Anonymous phone registration. Each call revalidates party, channel, and\n22:  * PIN inside a single Firestore transaction before creating (or reusing)\n23:  * the guest device doc. The PIN is never echoed in the response.\n24:  *\n25:  * Every rejection below shares ONE identical message: distinct texts would\n26:  * let callers probe which gate (party/channel/PIN/device) failed. The\n27:  * specific reason is only server-logged. All rejections keep errorCode\n28:  * FORBIDDEN so the callable `details.errorCode` mapping is unchanged.\n29:  */\n30: export function createJoinPartyService(options: JoinPartyServiceOptions): {\n31:   joinParty(value: unknown): Promise<JoinPartyResult>;\n32: } {\n33:   const { db } = options;\n34:   return {\n35:     async joinParty(value: unknown): Promise<JoinPartyResult> {\n36:       const input = parseJoinPartyInput(value);\n37:       return db.runTransaction(async (transaction) => {\n38:         const partyRef = db.doc(`parties/${input.partyId}`);\n39:         const channelRef = partyRef.collection(\"channels\").doc(input.channelId);\n40:         const deviceRef = partyRef.collection(\"devices\").doc(input.deviceId);\n41:         const [partySnap, channelSnap, deviceSnap] = await Promise.all([\n42:           transaction.get(partyRef),\n43:           transaction.get(channelRef),\n44:           transaction.get(deviceRef),\n45:         ]);\n46:         if (!partySnap.exists) {\n47:           console.warn(`joinParty rejected: unknown party ${input.partyId}`);\n48:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n49:         }\n50:         const party = partySnap.data()!;\n51:         if (party.status !== \"active\") {\n52:           console.warn(`joinParty rejected: inactive party ${input.partyId}`);\n53:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n54:         }\n55:         if (party.activeChannelId !== input.channelId) {\n56:           console.warn(\n57:             `joinParty rejected: channel ${input.channelId} is not active for party ${input.partyId}`,\n58:           );\n59:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n60:         }\n61:         if (!channelSnap.exists) {\n62:           console.warn(\n63:             `joinParty rejected: channel ${input.channelId} is not registered for party ${input.partyId}`,\n64:           );\n65:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n66:         }\n67:         const channel = channelSnap.data()!;\n68:         if (channel.partyId !== input.partyId || channel.status !== \"active\") {\n69:           console.warn(\n70:             `joinParty rejected: channel doc ${input.channelId} is inactive or mismatched for party ${input.partyId}`,\n71:           );\n72:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n73:         }\n74:         // Fail closed: ANY present-but-invalid stored PIN (number/boolean/\n75:         // malformed string written via console) counts as configured and\n76:         // rejects every attempt. Only a missing field or an empty string\n77:         // means \"no PIN configured\".\n78:         const storedPin: unknown = party.joinPin;\n79:         const pinUnset = storedPin === undefined || storedPin === \"\";\n80:         if (!pinUnset) {\n81:           if (typeof storedPin !== \"string\" || !JOIN_PIN_RE.test(storedPin)) {\n82:             console.warn(\n83:               `joinParty rejected: party ${input.partyId} has a misconfigured joinPin; re-provision it with seed_join`,\n84:             );\n85:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n86:           }\n87:           if (input.joinPin !== storedPin) {\n88:             console.warn(\n89:               `joinParty rejected: wrong or missing join PIN for party ${input.partyId}`,\n90:             );\n91:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n92:           }\n93:         }\n94:         if (deviceSnap.exists) {\n95:           const device = deviceSnap.data()!;\n96:           if (\n97:             device.partyId !== input.partyId ||\n98:             device.role !== \"guest\" ||\n99:             device.status !== \"active\" ||\n100:             (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n101:           ) {\n102:             console.warn(\n103:               `joinParty rejected: device ${input.deviceId} is not a valid guest registration for