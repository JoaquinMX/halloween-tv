const tv = \"tv-host-1\";\n37:   const host = \"p-host-1\";\n38:   await seedParty(db, partyId, tv, channelId);\n39:   await db.doc(`parties/${partyId}/devices/${tv}`).update({ role: \"tv\" });\n40:   const hosts = createHostJoinService({ db });\n41:   const invite = await hosts.createHostInvite({ partyId, deviceId: tv, channelId });\n42:   await hosts.joinHost({ partyId, deviceId: host, channelId, inviteToken: invite.inviteToken });\n43:   return { tv, host };\n44: }\n45: \n46: test(\"host seed catalog: empty list, guest denial, and fixed-preset queue with idempotency\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n47:   const { app, db, bucket } = await createEmulatorContext();\n48:   const partyId = randomPartyId();\n49:   try {\n50:     const { host } = await seedHostParty(db, partyId);\n51:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n52:     const services = servicesFor(db, bucket);\n53:     const empty = await services.listHostVideos({ partyId, deviceId: host, channelId: \"main\" });\n54:     assert.deepEqual(empty.videos, []);\n55:     // Guests (and unregistered devices) are denied on every admin operation.\n56:     for (const call of [\n57:       () => services.listHostVideos({ partyId, deviceId: \"p-guest-1\", channelId: \"main\" }),\n58:       () => services.generateHostVideo({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", seedId: \"seed-1\", idempotencyKey: \"idem-1\" }),\n59:       () => services.getHostVideoPreview({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", seedId: \"seed-1\" }),\n60:       () => services.deleteHostVideo({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", seedIds: [\"seed-1\"] }),\n61:       () => services.listHostVideos({ partyId, deviceId: \"nobody\", channelId: \"main\" }),\n62:     ]) {\n63:       await assert.rejects(call(), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n64:     }\n65:     // Generate uses the fixed-preset queue: same idempotency/budget shape as requestGeneration.\n66:     const created = await services.generateHostVideo({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\", idempotencyKey: \"idem-1\" });\n67:     assert.equal(created.seedId, \"seed-1\");\n68:     assert.equal(created.state, \"queued\");\n69:     assert.equal(created.created, true);\n70:     assert.ok(created.jobId.startsWith(\"hv-\"));\n71:     const listed = await services.listHostVideos({ partyId, deviceId: host, channelId: \"main\" });\n72:     assert.equal(listed.videos.length, 1);\n73:     assert.equal(listed.videos[0].seedId, \"seed-1\");\n74:     assert.equal(listed.videos[0].status, \"queued\");\n75:     // Queue deduplication: the same request is idempotent, a second seed is budget-blocked.\n76:     const duplicate = await services.generateHostVideo({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\", idempotencyKey: \"idem-1\" });\n77:     assert.equal(duplicate.created, false);\n78:     assert.equal(duplicate.jobId, created.jobId);\n79:     await assert.rejects(\n80:       services.generateHostVideo({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-2\", idempotencyKey: \"idem-2\" }),\n81:       (e: unknown) => e instanceof BackendError && e.errorCode === \"BUDGET_EXCEEDED\",\n82:     );\n83:     // Rebinding a seed id to a different request is refused.\n84:     await assert.rejects(\n85:       services.generateHostVideo({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\", idempotencyKey: \"idem-other\" }),\n86:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\",\n87:     );\n88:     // Preview is not ready before the worker runs.\n89:     await assert.rejects(services.getHostVideoPreview({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\" }),\n90:       (e: unknown) => e instanceof BackendError && e.errorCode === \"NOT_FOUND\");\n91:     // Cross-party hosts cannot touch this party's catalog.\n92:     const otherParty = randomPartyId();\n93:     const other = await seedHostParty(db, otherParty);\n94:     await assert.rejects(services.getHostVideoPreview({ partyId, deviceId: other.host, channelId: \"main\", seedId: \"seed-1\" }),\n95:       (e: unknown) => e instanceof BackendError && (e.errorCode === \"FORBIDDEN\" || e.errorCode === \"NOT_FOUND\"));\n96:     await db.recursiveDelete(db.doc(`parties/${otherParty}`)).catch(() => undefined);\n97:   } finally {\n98:     await clearParty(db, bucket, partyId);\n99:     await disposeEmulatorContext(app);\n100:   }\n101: });\n102: \n103: test(\"host previews are separately referenced, TTL-limited, signed on demand, and survive ACK purge\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n104:   const { app, db, bucket } = await createEmulatorContext();\n105:   const partyId = randomPartyId();\n106:   try {\n107:     const { host } = await seedHostParty(db, partyId);\n108:     const services = servicesFor(db, bucket);\n109:     const created = await services.generateHostVideo({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\", idempotencyKey: \"idem-1\" });\n110:     const run = await services.runGeneration({ partyId, deviceId: host, channelId: \"main\", jobId: created.jobId, idempotencyKey: \"idem-1\" });\n111:     assert.equal(run.state, \"ready\");\n112:     const preview = await services.getHostVideoPreview({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\" });\n113:     assert.equal(preview.seedId, \"seed-1\");\n114:     assert.equal(preview.clips.length, 4);\n115:     assert.deepEqual(preview.clips.map((clip) => clip.cameraId).sort(), [\"CAM-01\", \"CAM-02\", \"CAM-03\", \"CAM-04\"]);\n116:     assert.ok(preview.clips.every((clip) => clip.url.startsWith(\"https://signed.invalid/\")));\n117:     assert.ok(preview.clips.every((clip) => clip.url.includes(\"hostPreviews\")));\n118:     // Preview objects are separately referenced from delivery objects.\n119:     const seed = (await db.doc(`parties/${partyId}/seedVideos/seed-1`).get()).data()!;\n120:     assert.equal(seed.status, \"ready\");\n121:     assert.ok((seed.previewPaths as string[]).every((path) => path.includes(\"/hostPreviews/seed-1/\")));\n122:     assert.ok(!JSON.stringify(seed).includes(\"signed.invalid\"), \"signed preview URLs are never persisted\");\n123:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_main`).get()).data()!;\n124:     const deliveryPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n125:     assert.ok(deliveryPaths.every((path) => !path.includes(\"hostPreviews\")));\n126:     for (const path of seed.previewPaths as string[]) {\n127:       assert.equal((await bucket.file(path).exists())[0], true);\n128:       const [previewBytes] = await bucket.file(path).download();\n129:       assert.ok(previewBytes.byteLength > 0);\n130:     }\n131:     // Delivery ACK purges delivery objects but preview bytes survive.\n132:     const clipHashes = Object.fromEntries(\n133:       (manifest.cameraClips as Array<{ cameraId: string; sha256: string }>).map((clip) => [clip.cameraId, clip.sha256]),\n134:     );\n135:     const ack = await services.acknowledgeDelivery({ partyId, deviceId: host, channelId: \"main\", manifestVersion: manifest.version, clipHashes });\n136:     assert.equal(ack.purged, true);\n137:     for (const path of deliveryPaths) assert.equal((await bucket.file(path).exists())[0], false);\n138:     for (const path of seed.previewPaths as string[]) assert.equal((await bucket.file(path).exists())[0], true);\n139:     const previewAfterAck = await services.getHostVideoPreview({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\" });\n140:     assert.equal(previewAfterAck.clips.length, 4);\n141:   } finally {\n142:     await clearParty(db, bucket, partyId);\n143:     await disposeEmulatorContext(app);\n144:   }\n145: });\n146: \n147: test(\"host deletion removes seeds and objects, revokes manifests, preserves accounting, and blocks races\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n148:   const { app, db, bucket } = await createEmulatorContext();\n149:   const partyId = randomPartyId();\n150:   try {\n151:     const { host } = await seedHostParty(db, partyId);\n152:     const services = servicesFor(db, bucket);\n153:     const created = await services.generateHostVideo({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\", idempotencyKey: \"idem-1\" });\n154:     await services.runGeneration({ partyId, deviceId: host, channelId: \"main\", jobId: created.jobId, idempotencyKey: \"idem-1\" });\n155:     await services.getHostVideoPreview({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\" });\n156:     const seedBefore = (await db.doc(`parties/${partyId}/seedVideos/seed-1`).get()).data()!;\n157:     const previewPaths = [...(seedBefore.previewPaths as string[])];\n158:     const manifestBefore = (await db.doc(`parties/${partyId}/manifests/current_main`).get()).data()!;\n159:     const deliveryPaths = (manifestBefore.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n160: \n161:     const deleted = await services.deleteHostVideo({ partyId, deviceId: host, channelId: \"main\", seedIds: [\"seed-1\"] });\n162:     assert.deepEqual(deleted.deletedSeedIds, [\"seed-1\"]);\n163:     assert.equal(deleted.revokedManifest, true);\n164:     for (const path of [...previewPaths, ...deliveryPaths]) assert.ok(deleted.deletedObjects.includes(path), `${path} must be reported deleted`);\n165:     assert.equal((await db.doc(`parties/${partyId}/seedVideos/seed-1`).get()).data()?.status, \"deleted\");\n166:     assert.equal((await db.doc(`parties/${partyId}/manifests/current_main`).get()).exists, false);\n167:     for (const path of [...previewPaths, ...deliveryPaths]) assert.equal((await bucket.file(path).exists())[0], false);\n168:     // Accounting records are preserved.\n169:     assert.ok((await db.collection(`parties/${partyId}/costLogs`).get()).docs.length >= 4, \"cost logs must survive seed deletion\");\n170:     // A deleted seed never recreates previews and its job never republishes.\n171:     await assert.rejects(services.getHostVideoPreview({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\" }),\n172:       (e: unknown) => e instanceof BackendError && e.errorCode === \"NOT_FOUND\");\n173:     await assert.rejects(services.runGeneration({ partyId, deviceId: host, channelId: \"main\", jobId: created.jobId, idempotencyKey: \"idem-1\" }).then(async (run) => {\n174:       if (run.state === \"ready\") {\n175:         const { publishManifest } = await import(\"../src/publish\");\n176:         const { FirestoreGenerationStore } = await import(\"../src/generation_store\");\n177:         await publishManifest(new FirestoreGenerationStore({ db, bucket }), partyId, created.jobId, \"idem-1\");\n178:       }\n179:       return run;\n180:     }), (e: unknown) => e instanceof BackendError);\n181:     // Deleting an unknown seed is NOT_FOUND; cross-party deletion is refused.\n182:     await assert.rejects(services.deleteHostVideo({ partyId, deviceId: host, channelId: \"main\", seedIds: [\"nope\"] }),\n183:       (e: unknown) => e instanceof BackendError && e.errorCode === \"NOT_FOUND\");\n184:   } finally {\n185:     await clearParty(db, bucket, partyId);\n186:     await disposeEmulatorContext(app);\n187:   }\n188: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/host_media.test.ts, lines 1-188\n1: import assert from \"node:assert/strict\";\n2: import { resolve } from \"node:path\";\n3: import test from \"node:test\";\n4: import type { Bucket } from \"@google-cloud/storage\";\n5: import type { Firestore } from \"firebase-admin/firestore\";\n6: import