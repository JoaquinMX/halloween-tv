{"type":"step_start","timestamp":1793461907929,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"id":"prt_192a8f1d900139jR6IsIE2qPdy","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a8e962001LPFr9IsPo8wAAk","type":"step-start","snapshot":"96e690a01d979b81323bd264809e7cfdad2ecb48"}}
{"type":"tool_use","timestamp":1793461929667,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a8f1e6001b34M8Regqc2wED","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a8e962001LPFr9IsPo8wAAk","type":"tool","id":"call_01a192a8eff277769b1e8f4580c66cfa","tool":"write","state":{"status":"completed","input":{"content":"/// Lifecycle-safe host administration session.\n///\n/// Joins ONLY through [HostJoinClient.redeem] (the `joinHost` callable) and\n/// administers the seed catalog ONLY through [HostMediaClient]. This file\n/// depends on the two callable-boundary ports — never on a concrete\n/// connection class and never on Firebase.\n///\n/// Rules enforced here:\n/// - The bound identity is a host payload ([GuestJoinData] with\n///   [JoinRole.host]); guest payloads are rejected before any callable.\n/// - [join] validates the returned party/channel/device/host scope (via the\n///   client) before the session becomes ready; denials surface as\n///   [HostSessionStatus.denied] and throw a sanitized [HostJoinException]\n///   so the entry screen can fail visibly without entering the panel.\n/// - `generateHostVideo` uses a stable idempotency key per seed id: retries\n///   of the same seed reuse the queued job (`created: false`) instead of\n///   enqueueing another task.\n/// - [deleteVideos] reconciles the list only after authoritative success;\n///   failures leave local state untouched so they stay retryable.\n/// - A generation counter keeps late responses from a superseded\n///   join/refresh/poll (party switches, background suspend, leave, dispose)\n///   from mutating the new session. Polling stops on [suspend], [leave],\n///   and [dispose].\nlibrary;\n\nimport 'dart:async';\nimport 'dart:developer' as developer;\nimport 'dart:math';\n\nimport 'package:companion_app/src/data/host_join_client.dart';\nimport 'package:companion_app/src/data/host_media_client.dart';\nimport 'package:companion_app/src/data/manifest_failure.dart';\nimport 'package:companion_app/src/join/guest_join_data.dart';\n\n/// Lifecycle status of [HostSessionState].\nenum HostSessionStatus {\n  /// No host identity bound; no polling active.\n  idle,\n\n  /// Redeeming the host invite / loading the seed catalog.\n  loading,\n\n  /// A validated host binding with a current seed catalog.\n  ready,\n\n  /// Stale: retained catalog after a transient failure or suspension.\n  stale,\n\n  /// Cold start with no catalog and no usable transport.\n  unavailable,\n\n  /// The server rejected the binding (`FORBIDDEN`/`UNAUTHENTICATED`).\n  denied,\n\n  /// The invite or catalog data was invalid.\n  invalidData,\n}\n\n/// Immutable snapshot of the host session.\nfinal class HostSessionState {\n  const HostSessionState({\n    required this.status,\n    this.binding,\n    this.videos = const <HostSeedVideo>[],\n    this.message,\n  });\n\n  const HostSessionState.idle() : this(status: HostSessionStatus.idle);\n\n  final HostSessionStatus status;\n  final GuestJoinData? binding;\n  final List<HostSeedVideo> videos;\n  final String? message;\n\n  HostSessionState copyWith({\n    HostSessionStatus? status,\n    GuestJoinData? binding,\n    List<HostSeedVideo>? videos,\n    String? message,\n  }) => HostSessionState(\n    status: status ?? this.status,\n    binding: binding ?? this.binding,\n    videos: videos ?? this.videos,\n    message: message ?? this.message,\n  );\n\n  @override\n  bool operator ==(Object other) =>\n      other is HostSessionState &&\n      other.status == status &&\n      other.binding == binding &&\n      other.message == message &&\n      _videoIds(other.videos).join(',') == _videoIds(videos).join(',');\n\n  @override\n  int get hashCode => Object.hash(status, binding, message, videos.length);\n\n  @override\n  String toString() =>\n      'HostSessionState($status, videos: ${videos.length})';\n\n  static List<String> _videoIds(List<HostSeedVideo> videos) =>\n      <String>[for (final HostSeedVideo v in videos) '${v.seedId}:${v.status}'];\n}\n\n/// Sanitized host-join failure for the entry screen.\n///\n/// Carries only the fixed user-presentable message (never raw backend\n/// detail); [toString] returns the message itself.\nfinal class HostJoinException implements Exception {\n  const HostJoinException(this.message);\n  final String message;\n\n  @override\n  String toString() => message;\n}\n\n/// Host administration session bound to one party/device/channel at a time.\nfinal class HostSession {\n  HostSession({\n    required HostJoinClient joinClient,\n    required HostMediaClient mediaClient,\n    Duration pollInterval = const Duration(seconds: 15),\n    Random? random,\n  }) : _joinClient = joinClient,\n       _mediaClient = mediaClient,\n       _pollInterval = pollInterval,\n       _random = random ?? Random.secure();\n\n  final HostJoinClient _joinClient;\n  final HostMediaClient _mediaClient;\n  final Duration _pollInterval;\n  final Random _random;\n\n  final StreamController<HostSessionState> _states =\n      StreamController<HostSessionState>.broadcast();\n\n  HostSessionState _state = const HostSessionState.idle();\n\n  /// Current immutable snapshot.\n  HostSessionState get state => _state;\n\n  /// Broadcast of state snapshots.\n  Stream<HostSessionState> get states => _states.stream;\n\n  /// Bound host identity, or `null` when idle.\n  GuestJoinData? get binding => _state.binding;\n\n  /// Current or last-known seed catalog.\n  List<HostSeedVideo> get videos => List<HostSeedVideo>.unmodifiable(\n    _state.videos,\n  );\n\n  int _generation = 0;\n  bool _disposed = false;\n  bool _busy = false;\n  Timer? _pollTimer;\n\n  /// Stable idempotency keys per seed id (retries reuse the queued job).\n  final Map<String, String> _idempotencyKeys = <String, String>{};\n\n  void _emit(HostSessionState next) {\n    _state = next;\n    if (!_states.isClosed) {\n      _states.add(next);\n    }\n  }\n\n  String _mintIdempotencyKey() {\n    final List<int> bytes = List<int>.generate(16, (_) => _random.nextInt(256));\n    return bytes.map((int b) => b.toRadixString(16).padLeft(2, '0')).join();\n  }\n\n  /// Joins as a host [data], replacing any previous session.\n  ///\n  /// Throws a sanitized [HostJoinException] when the invite cannot be\n  /// redeemed (the emitted state carries the same fixed message). Guest\n  /// payloads are rejected before any network call.\n  Future<void> join(GuestJoinData data) async {\n    if (_disposed) return;\n    if (data.role != JoinRole.host || data.inviteToken == null) {\n      throw const HostJoinException(\n        'This host entry needs a host invitation. Join as a guest instead.',\n      );\n    }\n    _generation++;\n    final int generation = _generation;\n    _stopPolling();\n    _busy = false;\n    _emit(\n      HostSessionState(\n        status: HostSessionStatus.loading,\n        binding: data,\n        message: 'Redeeming host invite for ${data.partyId.value}',\n      ),\n    );\n    try {\n      await _joinClient.redeem(\n        partyId: data.partyId.value,\n        deviceId: data.deviceId.value,\n        channelId: data.channelId,\n        inviteToken: data.inviteToken!,\n      );\n    } on Object catch (error) {\n      if (generation == _generation && !_disposed) {\n        final ManifestFailure failure = error is ManifestFailure\n            ? error\n            : ManifestFailure.classify(error);\n        developer.log(\n          'HostSession join failed: $error',\n          name: 'companion.host_session',\n        );\n        final HostSessionStatus status = switch (failure.kind) {\n          ManifestFailureKind.forbidden ||\n          ManifestFailureKind.unauthenticated => HostSessionStatus.denied,\n          ManifestFailureKind.invalidArgument ||\n          ManifestFailureKind.malformed ||\n          ManifestFailureKind.configuration => HostSessionStatus.invalidData,\n          _ => HostSessionStatus.unavailable,\n        };\n        _emit(\n          HostSessionState(\n            status: status,\n            binding: data,\n            message: failure.message,\n          ),\n        );\n        throw HostJoinException(failure.message);\n      }\n      throw const HostJoinException('Could not reach the backend.');\n    }\n    if (generation != _generation || _disposed) return;\n    await _loadCatalog(data, generation);\n    if (generation != _generation || _disposed) return;\n    _startPolling();\n  }\n\n  Future<void> _loadCatalog(GuestJoinData data, int generation) async {\n    try {\n      final List<HostSeedVideo> listed = await _mediaClient.listVideos(\n        partyId: data.partyId.value,\n        deviceId: data.deviceId.value,\n        channelId: data.channelId,\n      );\n      if (generation != _generation || _disposed) return;\n      _emit(\n        HostSessionState(\n          status: HostSessionStatus.ready,\n          binding: data,\n          videos: listed,\n        ),\n      );\n    } on Object catch (error) {\n      if (generation != _generation || _disposed) return;\n      developer.log(\n        'HostSession catalog load failed: $error',\n        name: 'companion.host_session',\n      );\n      final ManifestFailure failure = ManifestFailure.classify(error);\n      if (_state.videos.isNotEmpty) {\n        _emit(\n          HostSessionState(\n            status: HostSessionStatus.stale,\n            binding: data,\n            videos: _state.videos,\n            message: failure.message,\n          ),\n        );\n        return;\n      }\n      _emit(\n        HostSessionState(\n          status: HostSessionStatus.unavailable,\n          binding: data,\n          message: failure.message,\n        ),\n      );\n    }\n  }\n\n  /// Refreshes the seed catalog without overlapping in-flight work.\n  Future<void> refresh() async {\n    if (_disposed || _busy) return;\n    final GuestJoinData? bound = _state.binding;\n    if (bound == null || _state.status == HostSessionStatus.idle) return;\n    _busy = true;\n    _generation++;\n    final int generation = _generation;\n    try {\n      await _loadCatalog(bound, generation);\n    } finally {\n      _busy = false;\n    }\n  }\n\n  /// Enqueues fixed-preset generation for [seedId].\n  ///\n  /// The idempotency key is stable per seed id: retries reuse the queued\n  /// job (`created: false`) instead of enqueueing another task. Returns the\n  /// server result. Failures throw and leave local state untouched.\n  Future<Map<String, Object?>> generate(\n    String seedId, {\n    String presetId = kCheapDemoPresetId,\n    String? guestMediaId,\n  }) async {\n    final GuestJoinData? bound = _state.binding;\n    if (bound == null || _disposed) {\n      throw StateError('Join as host before generating video');\n    }\n    final String key = _idempotencyKeys.putIfAbsent(\n      seedId,\n      _mintIdempotencyKey,\n    );\n    final Map<String, Object?> result = await _mediaClient.generateVideo(\n      partyId: bound.partyId.value,\n      deviceId: bound.deviceId.value,\n      channelId: bound.channelId,\n      seedId: seedId,\n      idempotencyKey: key,\n      presetId: presetId,\n      guestMediaId: guestMediaId,\n    );\n    await refresh();\n    return result;\n  }\n\n  /// Obtains a fresh scoped preview capability for [seedId].\n  ///\n  /// Every view requests a new capability: signed URLs are short-lived and\n  /// never persisted.\n  Future<HostVideoPreview> preview(String seedId) {\n    final GuestJoinData? bound = _state.binding;\n    if (bound == null || _disposed) {\n      throw StateError('Join as host before previewing video');\n    }\n    return _mediaClient.getPreview(\n      partyId: bound.partyId.value,\n      deviceId: bound.deviceId.value,\n      channelId: bound.channelId,\n      seedId: seedId,\n    );\n  }\n\n  /// Deletes [seedIds] and reconciles the list after authoritative success.\n  ///\n  /// Failures throw and leave the local list untouched so they stay\n  /// retryable.\n  Future<Map<String, Object?>> deleteVideos(List<String> seedIds) async {\n    final GuestJoinData? bound = _state.binding;\n    if (bound == null || _disposed) {\n      throw StateError('Join as host before deleting video');\n    }\n    final Map<String, Object?> result = await _mediaClient.deleteVideos(\n      partyId: bound.partyId.value,\n      deviceId: bound.deviceId.value,\n      channelId: bound.channelId,\n      seedIds: seedIds,\n    );\n    await refresh();\n    return result;\n  }\n\n  void _startPolling() {\n    _stopPolling();\n    if (_disposed) return;\n    _pollTimer = Timer.periodic(_pollInterval, (_) {\n      unawaited(refresh());\n    });\n  }\n\n  void _stopPolling() {\n    _pollTimer?.cancel();\n    _pollTimer = null;\n  }\n\n  /// Suspends polling for backgrounding; the retained catalog stays\n  /// readable as the current snapshot.\n  Future<void> suspend() async {\n    if (_disposed) return;\n    _generation++;\n    _stopPolling();\n    _busy = false;\n    final GuestJoinData? bound = _state.binding;\n    if (bound == null) return;\n    if (_state.videos.isNotEmpty &&\n        _state.status == HostSessionStatus.ready) {\n      _emit(\n        HostSessionState(\n          status: HostSessionStatus.stale,\n          binding: bound,\n          videos: _state.videos,\n          message: 'Suspended; showing last-known catalog',\n        ),\n      );\n    }\n  }\n\n  /// Resumes polling with a fresh catalog read after [suspend].\n  Future<void> resume() async {\n    if (_disposed) return;\n    final GuestJoinData? bound = _state.binding;\n    if (bound == null || _state.status == HostSessionStatus.idle) return;\n    _startPolling();\n    await refresh();\n  }\n\n  /// Leaves the host session: stops polling and clears identity + catalog.\n  Future<void> leave() async {\n    _generation++;\n    _stopPolling();\n    _busy = false;\n    _idempotencyKeys.clear();\n    if (_disposed) return;\n    _emit(const HostSessionState.idle());\n  }\n\n  /// Releases polling and the state broadcast.\n  Future<void> dispose() async {\n    if (_disposed) return;\n    _disposed = true;\n    _generation++;\n    _stopPolling();\n    if (!_states.isClosed) {\n      await _states.close();\n    }\n  }\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/host_session.dart"},"output":"Created file successfully: apps/companion_app/lib/src/session/host_session.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/companion_app/lib/src/session/host_session.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a8eff277769b1e8f4580c66cfa"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Lifecycle-safe host administration session.\\n///\\n/// Joins ONLY through [HostJoinClient.redeem] (the `joinHost` callable) and\\n/// administers the seed catalog ONLY through [HostMediaClient]. This file\\n/// depends on the two callable-boundary ports — never on a concrete\\n/// connection class and never on Firebase.\\n///\\n/// Rules enforced here:\\n/// - The bound identity is a host payload ([GuestJoinData] with\\n///   [JoinRole.host]); guest payloads are rejected before any callable.\\n/// - [join] validates the returned party/channel/device/host scope (via the\\n///   client) before the session becomes ready; denials surface as\\n///   [HostSessionStatus.denied] and throw a sanitized [HostJoinException]\\n///   so the entry screen can fail visibly without entering the panel.\\n/// - `generateHostVideo` uses a stable idempotency key per seed id: retries\\n///   of the same seed reuse the queued job (`created: false`) instead of\\n///   enqueueing another task.\\n/// - [deleteVideos] reconciles the list only after authoritative success;\\n///   failures leave local state untouched so they stay retryable.\\n/// - A generation counter keeps late responses from a superseded\\n///   join/refresh/poll (party switches, background suspend, leave, dispose)\\n///   from mutating the new session. Polling stops on [suspend], [leave],\\n///   and [dispose].\\nlibrary;\\n\\nimport 'dart:async';\\nimport 'dart:developer' as developer;\\nimport 'dart:math';\\n\\nimport 'package:companion_app/src/data/host_join_client.dart';\\nimport 'package:companion_app/src/data/host_media_client.dart';\\nimport 'package:companion_app/src/data/manifest_failure.dart';\\nimport 'package:companion_app/src/join/guest_join_data.dart';\\n\\n/// Lifecycle status of [HostSessionState].\\nenum HostSessionStatus {\\n  /// No host identity bound; no polling active.\\n  idle,\\n\\n  /// Redeeming the host invite / loading the seed catalog.\\n  loading,\\n\\n  /// A validated host binding with a current seed catalog.\\n  ready,\\n\\n  /// Stale: retained catalog after a transient failure or suspension.\\n  stale,\\n\\n  /// Cold start with no catalog and no usable transport.\\n  unavailable,\\n\\n  /// The server rejected the binding (`FORBIDDEN`/`UNAUTHENTICATED`).\\n  denied,\\n\\n  /// The invite or catalog data was invalid.\\n  invalidData,\\n}\\n\\n/// Immutable snapshot of the host session.\\nfinal class HostSessionState {\\n  const HostSessionState({\\n    required this.status,\\n    this.binding,\\n    this.videos = const <HostSeedVideo>[],\\n    this.message,\\n  });\\n\\n  const HostSessionState.idle() : this(status: HostSessionStatus.idle);\\n\\n  final HostSessionStatus status;\\n  final GuestJoinData? binding;\\n  final List<HostSeedVideo> videos;\\n  final String? message;\\n\\n  HostSessionState copyWith({\\n    HostSessionStatus? status,\\n    GuestJoinData? binding,\\n    List<HostSeedVideo>? videos,\\n    String? message,\\n  }) => HostSessionState(\\n    status: status ?? this.status,\\n    binding: binding ?? this.binding,\\n    videos: videos ?? this.videos,\\n    message: message ?? this.message,\\n  );\\n\\n  @override\\n  bool operator ==(Object other) =>\\n      other is HostSessionState &&\\n      other.status == status &&\\n      other.binding == binding &&\\n      other.message == message &&\\n      _videoIds(other.videos).join(',') == _videoIds(videos).join(',');\\n\\n  @override\\n  int get hashCode => Object.hash(status, binding, message, videos.length);\\n\\n  @override\\n  String toString() =>\\n      'HostSessionState($status, videos: ${videos.length})';\\n\\n  static List<String> _videoIds(List<HostSeedVideo> videos) =>\\n      <String>[for (final HostSeedVideo v in videos) '${v.seedId}:${v.status}'];\\n}\\n\\n/// Sanitized host-join failure for the entry screen.\\n///\\n/// Carries only the fixed user-presentable message (never raw backend\\n/// detail); [toString] returns the message itself.\\nfinal class HostJoinException implements Exception {\\n  const HostJoinException(this.message);\\n  final String message;\\n\\n  @override\\n  String toString() => message;\\n}\\n\\n/// Host administration session bound to one party/device/channel at a time.\\nfinal class HostSession {\\n  HostSession({\\n    required HostJoinClient joinClient,\\n    required HostMediaClient mediaClient,\\n    Duration pollInterval = const Duration(seconds: 15),\\n    Random? random,\\n  }) : _joinClient = joinClient,\\n       _mediaClient = mediaClient,\\n       _pollInterval = pollInterval,\\n       _random = random ?? Random.secure();\\n\\n  final HostJoinClient _joinClient;\\n  final HostMediaClient _mediaClient;\\n  final Duration _pollInterval;\\n  final Random _random;\\n\\n  final StreamController<HostSessionState> _states =\\n      StreamController<HostSessionState>.broadcast();\\n\\n  HostSessionState _state = const HostSessionState.idle();\\n\\n  /// Current immutable snapshot.\\n  HostSessionState get state => _state;\\n\\n  /// Broadcast of state snapshots.\\n  Stream<HostSessionState> get states => _states.stream;\\n\\n  /// Bound host identity, or `null` when idle.\\n  GuestJoinData? get binding => _state.binding;\\n\\n  /// Current or last-known seed catalog.\\n  List<HostSeedVideo> get videos => List<HostSeedVideo>.unmodifiable(\\n    _state.videos,\\n  );\\n\\n  int _generation = 0;\\n  bool _disposed = false;\\n  bool _busy = false;\\n  Timer? _pollTimer;\\n\\n  /// Stable idempotency keys per seed id (retries reuse the queued job).\\n  final Map<String, String> _idempotencyKeys = <String, String>{};\\n\\n  void _emit(HostSessionState next) {\\n    _state = next;\\n    if (!_states.isClosed) {\\n      _states.add(next);\\n    }\\n  }\\n\\n  String _mintIdempotencyKey() {\\n    final List<int> bytes = List<int>.generate(16, (_) => _random.nextInt(256));\\n    return bytes.map((int b) => b.toRadixString(16).padLeft(2, '0')).join();\\n  }\\n\\n  /// Joins as a host [data], replacing any previous session.\\n  ///\\n  /// Throws a sanitized [HostJoinException] when the invite cannot be\\n  /// redeemed (the emitted state carries the same fixed message). Guest\\n  /// payloads are rejected before any network call.\\n  Future<void> join(GuestJoinData data) async {\\n    if (_disposed) return;\\n    if (data.role != JoinRole.host || data.inviteToken == null) {\\n      throw const HostJoinException(\\n        'This host entry needs a host invitation. Join as a guest instead.',\\n      );\\n    }\\n    _generation++;\\n    final int generation = _generation;\\n    _stopPolling();\\n    _busy = false;\\n    _emit(\\n      HostSessionState(\\n        status: HostSessionStatus.loading,\\n        binding: data,\\n        message: 'Redeeming host invite for ${data.partyId.value}',\\n      ),\\n    );\\n    try {\\n      await _joinClient.redeem(\\n        partyId: data.partyId.value,\\n        deviceId: data.deviceId.value,\\n        channelId: data.channelId,\\n        inviteToken: data.inviteToken!,\\n      );\\n    } on Object catch (error) {\\n      if (generation == _generation && !_disposed) {\\n        final ManifestFailure failure = error is ManifestFailure\\n            ? error\\n            : ManifestFailure.classify(error);\\n        developer.log(\\n          'HostSession join failed: $error',\\n          name: 'companion.host_session',\\n        );\\n        final HostSessionStatus status = switch (failure.kind) {\\n          ManifestFailureKind.forbidden ||\\n          ManifestFailureKind.unauthenticated => HostSessionStatus.denied,\\n          ManifestFailureKind.invalidArgument ||\\n          ManifestFailureKind.malformed ||\\n          ManifestFailureKind.configuration => HostSessionStatus.invalidData,\\n          _ => HostSessionStatus.unavailable,\\n        };\\n        _emit(\\n          HostSessionState(\\n            status: status,\\n            binding: data,\\n            message: failure.message,\\n          ),\\n        );\\n        throw HostJoinException(failure.message);\\n      }\\n      throw const HostJoinException('Could not reach the backend.');\\n    }\\n    if (generation != _generation || _disposed) return;\\n    await _loadCatalog(data, generation);\\n    if (generation != _generation || _disposed) return;\\n    _startPolling();\\n  }\\n\\n  Future<void> _loadCatalog(GuestJoinData data, int generation) async {\\n    try {\\n      final List<HostSeedVideo> listed = await _mediaClient.listVideos(\\n        partyId: data.partyId.value,\\n        deviceId: data.deviceId.value,\\n        channelId: data.channelId,\\n      );\\n      if (generation != _generation || _disposed) return;\\n      _emit(\\n        HostSessionState(\\n          status: HostSessionStatus.ready,\\n          binding: data,\\n          videos: listed,\\n        ),\\n      );\\n    } on Object catch (error) {\\n      if (generation != _generation || _disposed) return;\\n      developer.log(\\n        'HostSession catalog load failed: $error',\\n        name: 'companion.host_session',\\n      );\\n      final ManifestFailure failure = ManifestFailure.classify(error);\\n      if (_state.videos.isNotEmpty) {\\n        _emit(\\n          HostSessionState(\\n            status: HostSessionStatus.stale,\\n            binding: data,\\n            videos: _state.videos,\\n            message: failure.message,\\n          ),\\n        );\\n        return;\\n      }\\n      _emit(\\n        HostSessionState(\\n          status: HostSessionStatus.unavailable,\\n          binding: data,\\n          message: failure.message,\\n        ),\\n      );\\n    }\\n  }\\n\\n  /// Refreshes the seed catalog without overlapping in-flight work.\\n  Future<void> refresh() async {\\n    if (_disposed || _busy) return;\\n    final GuestJoinData? bound = _state.binding;\\n    if (bound == null || _state.status == HostSessionStatus.idle) return;\\n    _busy = true;\\n    _generation++;\\n    final int generation = _generation;\\n    try {\\n      await _loadCatalog(bound, generation);\\n    } finally {\\n      _busy = false;\\n    }\\n  }\\n\\n  /// Enqueues fixed-preset generation for [seedId].\\n  ///\\n  /// The idempotency key is stable per seed id: retries reuse the queued\\n  /// job (`created: false`) instead of enqueueing another task. Returns the\\n  /// server result. Failures throw and leave local state untouched.\\n  Future<Map<String, Object?>> generate(\\n    String seedId, {\\n    String presetId = kCheapDemoPresetId,\\n    String? guestMediaId,\\n  }) async {\\n    final GuestJoinData? bound = _state.binding;\\n    if (bound == null || _disposed) {\\n      throw StateError('Join as host before generating video');\\n    }\\n    final String key = _idempotencyKeys.putIfAbsent(\\n      seedId,\\n      _mintIdempotencyKey,\\n    );\\n    final Map<String, Object?> result = await _mediaClient.generateVideo(\\n      partyId: bound.partyId.value,\\n      deviceId: bound.deviceId.value,\\n      channelId: bound.channelId,\\n      seedId: seedId,\\n      idempotencyKey: key,\\n      presetId: presetId,\\n      guestMediaId: guestMediaId,\\n    );\\n    await refresh();\\n    return result;\\n  }\\n\\n  /// Obtains a fresh scoped preview capability for [seedId].\\n  ///\\n  /// Every view requests a new capability: signed URLs are short-lived and\\n  /// never persisted.\\n  Future<HostVideoPreview> preview(String seedId) {\\n    final GuestJoinData? bound = _state.binding;\\n    if (bound == null || _disposed) {\\n      throw StateError('Join as host before previewing video');\\n    }\\n    return _mediaClient.getPreview(\\n      partyId: bound.partyId.value,\\n      deviceId: bound.deviceId.value,\\n      channelId: bound.channelId,\\n      seedId: seedId,\\n    );\\n  }\\n\\n  /// Deletes [seedIds] and reconciles the list after authoritative success.\\n  ///\\n  /// Failures throw and leave the local list untouched so they stay\\n  /// retryable.\\n  Future<Map<String, Object?>> deleteVideos(List<String> seedIds) async {\\n    final GuestJoinData? bound = _state.binding;\\n    if (bound == null || _disposed) {\\n      throw StateError('Join as host before deleting video');\\n    }\\n    final Map<String, Object?> result = await _mediaClient.deleteVideos(\\n      partyId: bound.partyId.value,\\n      deviceId: bound.deviceId.value,\\n      channelId: bound.channelId,\\n      seedIds: seedIds,\\n    );\\n    await refresh();\\n    return result;\\n  }\\n\\n  void _startPolling() {\\n    _stopPolling();\\n    if (_disposed) return;\\n    _pollTimer = Timer.periodic(_pollInterval, (_) {\\n      unawaited(refresh());\\n    });\\n  }\\n\\n  void _stopPolling() {\\n    _pollTimer?.cancel();\\n    _pollTimer = null;\\n  }\\n\\n  /// Suspends polling for backgrounding; the retained catalog stays\\n  /// readable as the current snapshot.\\n  Future<void> suspend() async {\\n    if (_disposed) return;\\n    _generation++;\\n    _stopPolling();\\n    _busy = false;\\n    final GuestJoinData? bound = _state.binding;\\n    if (bound == null) return;\\n    if (_state.videos.isNotEmpty &&\\n        _state.status == HostSessionStatus.ready) {\\n      _emit(\\n        HostSessionState(\\n          status: HostSessionStatus.stale,\\n          binding: bound,\\n          videos: _state.videos,\\n          message: 'Suspended; showing last-known catalog',\\n        ),\\n      );\\n    }\\n  }\\n\\n  /// Resumes polling with a fresh catalog read after [suspend].\\n  Future<void> resume() async {\\n    if (_disposed) return;\\n    final GuestJoinData? bound = _state.binding;\\n    if (bound == null || _state.status == HostSessionStatus.idle) return;\\n    _startPolling();\\n    await refresh();\\n  }\\n\\n  /// Leaves the host session: stops polling and clears identity + catalog.\\n  Future<void> leave() async {\\n    _generation++;\\n    _stopPolling();\\n    _busy = false;\\n    _idempotencyKeys.clear();\\n    if (_disposed) return;\\n    _emit(const HostSessionState.idle());\\n  }\\n\\n  /// Releases polling and the state broadcast.\\n  Future<void> dispose() async {\\n    if (_disposed) return;\\n    _disposed = true;\\n    _generation++;\\n    _stopPolling();\\n    if (!_states.isClosed) {\\n      await _states.close();\\n    }\\n  }\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/host_session.dart\"}"},"time":{"start":1793461907942,"end":1793461929667}}}}
