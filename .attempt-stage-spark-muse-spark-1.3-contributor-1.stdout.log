{"type":"tool_use","timestamp":1793461887671,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a85eae001BS15F66jj5Da1X","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a8589b001CG35onAO1XRG8b","type":"tool","id":"call_01a192a85c077390a167fb2c7c840aba","tool":"write","state":{"status":"completed","input":{"content":"/// Scoped host administration callables (seed catalog + previews).\n///\n/// Every operation revalidates the registered host role and party/channel\n/// scope server-side (`assertRegisteredHostDevice`); guests get `FORBIDDEN`.\n/// Payload/response shapes mirror `backend/functions/src/contracts.ts`.\n///\n/// Deletion granularity (pinned): `deleteHostVideo` deletes per selected\n/// seed id — the seed entries and their associated preview + delivery\n/// objects are removed, an affected current manifest whose jobId matches a\n/// deleted seed is revoked, and accounting records (costLogs / usage ledger\n/// rows) are never deleted. The list is reconciled only after authoritative\n/// success; failures leave local state untouched so they stay retryable.\nlibrary;\n\nimport 'dart:async';\n\nimport 'package:cloud_functions/cloud_functions.dart';\nimport 'package:infra_firestore/infra_firestore.dart'\n    show ManifestTransportException;\n\nconst String kListHostVideos = 'listHostVideos';\nconst String kGenerateHostVideo = 'generateHostVideo';\nconst String kGetHostVideoPreview = 'getHostVideoPreview';\nconst String kDeleteHostVideo = 'deleteHostVideo';\n\n/// Fixed generation presets supported by host administration.\n///\n/// Pinned to `backend/functions/src/config.ts` (`CHEAP_DEMO_PRESET` /\n/// `CAMEO_DEMO_PRESET`). Generation presets keep producing 4 clips; the\n/// preset value is never caller-tunable beyond this fixed set.\nconst String kCheapDemoPresetId = 'cheap_demo';\nconst String kCameoDemoPresetId = 'cameo_demo';\n\n/// Callable boundary for host administration, separate from guest callables.\nabstract interface class HostMediaCallableInvoker {\n  Future<Object?> call(String name, Map<String, Object?> payload);\n}\n\n/// One server-backed seed catalog entry.\nfinal class HostSeedVideo {\n  const HostSeedVideo({\n    required this.seedId,\n    required this.partyId,\n    required this.channelId,\n    required this.status,\n    required this.jobId,\n    required this.createdAt,\n    required this.expiresAt,\n    required this.previewAvailable,\n    required this.cameraIds,\n  });\n\n  final String seedId;\n  final String partyId;\n  final String channelId;\n\n  /// Backend seed status: `queued`, `running`, `ready`, `failed`,\n  /// `deleted` (expiry surfaces through the same status sync).\n  final String status;\n  final String jobId;\n  final String createdAt;\n  final String expiresAt;\n  final bool previewAvailable;\n  final List<String> cameraIds;\n\n  @override\n  bool operator ==(Object other) =>\n      other is HostSeedVideo &&\n      other.seedId == seedId &&\n      other.partyId == partyId &&\n      other.channelId == channelId &&\n      other.status == status &&\n      other.jobId == jobId &&\n      other.previewAvailable == previewAvailable;\n\n  @override\n  int get hashCode =>\n      Object.hash(seedId, partyId, channelId, status, jobId, previewAvailable);\n\n  @override\n  String toString() => 'HostSeedVideo($seedId status=$status)';\n}\n\n/// One signed preview clip reference (signed on demand, never persisted).\nfinal class HostVideoPreviewClip {\n  const HostVideoPreviewClip({\n    required this.cameraId,\n    required this.sha256,\n    required this.url,\n    required this.expiresAt,\n  });\n\n  final String cameraId;\n  final String sha256;\n  final Uri url;\n  final String expiresAt;\n}\n\n/// Fresh scoped preview capability for one seed video.\nfinal class HostVideoPreview {\n  const HostVideoPreview({\n    required this.seedId,\n    required this.expiresAt,\n    required this.clips,\n  });\n\n  final String seedId;\n  final String expiresAt;\n  final List<HostVideoPreviewClip> clips;\n}\n\n/// Scoped host media client: list / generate / preview / delete.\nfinal class HostMediaClient {\n  HostMediaClient({\n    required HostMediaCallableInvoker invoker,\n    this.timeout = const Duration(seconds: 15),\n  }) : _invoker = invoker;\n\n  final HostMediaCallableInvoker _invoker;\n  final Duration timeout;\n\n  Map<String, Object?> _scope(\n    String partyId,\n    String deviceId,\n    String channelId,\n  ) => <String, Object?>{\n    'partyId': partyId,\n    'deviceId': deviceId,\n    'channelId': channelId,\n  };\n\n  Future<Object?> _call(String name, Map<String, Object?> payload) {\n    try {\n      return _invoker.call(name, payload).timeout(timeout);\n    } on TimeoutException catch (error) {\n      throw ManifestTransportException('$name timed out', error);\n    }\n  }\n\n  /// Lists the server-backed seed catalog for the registered host scope.\n  Future<List<HostSeedVideo>> listVideos({\n    required String partyId,\n    required String deviceId,\n    required String channelId,\n  }) async {\n    final Object? raw;\n    try {\n      raw = await _call(\n        kListHostVideos,\n        _scope(partyId, deviceId, channelId),\n      );\n    } on FirebaseFunctionsException catch (error) {\n      throw ManifestTransportException(\n        'listHostVideos callable failed',\n        error,\n      );\n    }\n    if (raw is! Map || raw['videos'] is! List) {\n      throw const FormatException('Host video list response is malformed');\n    }\n    final List<HostSeedVideo> videos = <HostSeedVideo>[];\n    for (final Object? entry in raw['videos'] as List) {\n      videos.add(_parseSeed(entry, partyId: partyId, channelId: channelId));\n    }\n    return videos;\n  }\n\n  HostSeedVideo _parseSeed(\n    Object? entry, {\n    required String partyId,\n    required String channelId,\n  }) {\n    if (entry is! Map) {\n      throw const FormatException('Host seed entry is malformed');\n    }\n    String requiredString(String key) {\n      final Object? value = entry[key];\n      if (value is! String || value.isEmpty) {\n        throw FormatException('Host seed entry field \"$key\" is malformed');\n      }\n      return value;\n    }\n\n    final String seedParty = requiredString('partyId');\n    final String seedChannel = requiredString('channelId');\n    if (seedParty != partyId || seedChannel != channelId) {\n      throw const FormatException(\n        'Host seed entry is outside the registered party and channel',\n      );\n    }\n    final Object? cameras = entry['cameraIds'];\n    if (entry['previewAvailable'] is! bool || cameras is! List) {\n      throw const FormatException('Host seed entry fields are malformed');\n    }\n    return HostSeedVideo(\n      seedId: requiredString('seedId'),\n      partyId: seedParty,\n      channelId: seedChannel,\n      status: requiredString('status'),\n      jobId: requiredString('jobId'),\n      createdAt: requiredString('createdAt'),\n      expiresAt: requiredString('expiresAt'),\n      previewAvailable: entry['previewAvailable'] as bool,\n      cameraIds: <String>[for (final Object? c in cameras) c.toString()],\n    );\n  }\n\n  /// Enqueues fixed-preset generation for [seedId].\n  ///\n  /// [idempotencyKey] must be stable per seed id across retries so a retry\n  /// reuses the queued job (`created: false`) instead of enqueueing another\n  /// task. [presetId] defaults to the supported `cheap_demo` preset.\n  Future<Map<String, Object?>> generateVideo({\n    required String partyId,\n    required String deviceId,\n    required String channelId,\n    required String seedId,\n    required String idempotencyKey,\n    String presetId = kCheapDemoPresetId,\n    String? guestMediaId,\n  }) async {\n    if (presetId != kCheapDemoPresetId && presetId != kCameoDemoPresetId) {\n      throw ArgumentError.value(\n        presetId,\n        'presetId',\n        'Only the fixed generation presets are supported',\n      );\n    }\n    final Object? raw;\n    try {\n      raw = await _call(kGenerateHostVideo, <String, Object?>{\n        ..._scope(partyId, deviceId, channelId),\n        'seedId': seedId,\n        'idempotencyKey': idempotencyKey,\n        'presetId': presetId,\n        if (guestMediaId != null) 'guestMediaId': guestMediaId,\n      });\n    } on FirebaseFunctionsException catch (error) {\n      throw ManifestTransportException(\n        'generateHostVideo callable failed',\n        error,\n      );\n    }\n    if (raw is! Map ||\n        raw['seedId'] != seedId ||\n        raw['jobId'] is! String ||\n        raw['state'] is! String ||\n        raw['created'] is! bool) {\n      throw const FormatException(\n        'generateHostVideo response did not match the requested seed',\n      );\n    }\n    return Map<String, Object?>.from(raw);\n  }\n\n  /// Obtains a fresh scoped preview capability for [seedId].\n  ///\n  /// Callers must request a new capability per view: signed URLs are\n  /// short-lived and never persisted server-side.\n  Future<HostVideoPreview> getPreview({\n    required String partyId,\n    required String deviceId,\n    required String channelId,\n    required String seedId,\n  }) async {\n    final Object? raw;\n    try {\n      raw = await _call(kGetHostVideoPreview, <String, Object?>{\n        ..._scope(partyId, deviceId, channelId),\n        'seedId': seedId,\n      });\n    } on FirebaseFunctionsException catch (error) {\n      throw ManifestTransportException(\n        'getHostVideoPreview callable failed',\n        error,\n      );\n    }\n    if (raw is! Map ||\n        raw['seedId'] != seedId ||\n        raw['expiresAt'] is! String ||\n        raw['clips'] is! List) {\n      throw const FormatException(\n        'getHostVideoPreview response did not match the requested seed',\n      );\n    }\n    final List<HostVideoPreviewClip> clips = <HostVideoPreviewClip>[];\n    for (final Object? entry in raw['clips'] as List) {\n      if (entry is! Map ||\n          entry['cameraId'] is! String ||\n          entry['sha256'] is! String ||\n          entry['url'] is! String ||\n          entry['expiresAt'] is! String) {\n        throw const FormatException('Host preview clip is malformed');\n      }\n      final Uri? uri = Uri.tryParse(entry['url'] as String);\n      if (uri == null ||\n          uri.scheme != 'https' ||\n          uri.host.isEmpty ||\n          uri.userInfo.isNotEmpty) {\n        throw const FormatException('Host preview URL is invalid');\n      }\n      clips.add(\n        HostVideoPreviewClip(\n          cameraId: entry['cameraId'] as String,\n          sha256: entry['sha256'] as String,\n          url: uri,\n          expiresAt: entry['expiresAt'] as String,\n        ),\n      );\n    }\n    return HostVideoPreview(\n      seedId: seedId,\n      expiresAt: raw['expiresAt'] as String,\n      clips: clips,\n    );\n  }\n\n  /// Deletes the selected seed ids.\n  ///\n  /// Deletion is per selected seed id (see the library doc): preview +\n  /// delivery objects for those seeds are removed, an affected current\n  /// manifest is revoked, and accounting records are preserved. Only call\n  /// after the caller reconciles on authoritative success.\n  Future<Map<String, Object?>> deleteVideos({\n    required String partyId,\n    required String deviceId,\n    required String channelId,\n    required List<String> seedIds,\n  }) async {\n    final Object? raw;\n    try {\n      raw = await _call(kDeleteHostVideo, <String, Object?>{\n        ..._scope(partyId, deviceId, channelId),\n        'seedIds': seedIds,\n      });\n    } on FirebaseFunctionsException catch (error) {\n      throw ManifestTransportException(\n        'deleteHostVideo callable failed',\n        error,\n      );\n    }\n    if (raw is! Map ||\n        raw['deletedSeedIds'] is! List ||\n        raw['deletedObjects'] is! List ||\n        raw['revokedManifest'] is! bool) {\n      throw const FormatException('deleteHostVideo response is malformed');\n    }\n    return Map<String, Object?>.from(raw);\n  }\n}\n\n/// SDK-backed host media invoker, scoped to the four host callables.\nfinal class CallableHostMediaInvoker implements HostMediaCallableInvoker {\n  CallableHostMediaInvoker({required FirebaseFunctions functions})\n    : _functions = functions;\n  final FirebaseFunctions _functions;\n\n  static const Set<String> _allowed = <String>{\n    kListHostVideos,\n    kGenerateHostVideo,\n    kGetHostVideoPreview,\n    kDeleteHostVideo,\n  };\n\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\n    if (!_allowed.contains(name)) throw ArgumentError.value(name, 'name');\n    return (await _functions.httpsCallable(name).call<Object?>(payload)).data;\n  }\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/data/host_media_client.dart"},"output":"Created file successfully: apps/companion_app/lib/src/data/host_media_client.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/companion_app/lib/src/data/host_media_client.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a85c077390a167fb2c7c840aba"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Scoped host administration callables (seed catalog + previews).\\n///\\n/// Every operation revalidates the registered host role and party/channel\\n/// scope server-side (`assertRegisteredHostDevice`); guests get `FORBIDDEN`.\\n/// Payload/response shapes mirror `backend/functions/src/contracts.ts`.\\n///\\n/// Deletion granularity (pinned): `deleteHostVideo` deletes per selected\\n/// seed id — the seed entries and their associated preview + delivery\\n/// objects are removed, an affected current manifest whose jobId matches a\\n/// deleted seed is revoked, and accounting records (costLogs / usage ledger\\n/// rows) are never deleted. The list is reconciled only after authoritative\\n/// success; failures leave local state untouched so they stay retryable.\\nlibrary;\\n\\nimport 'dart:async';\\n\\nimport 'package:cloud_functions/cloud_functions.dart';\\nimport 'package:infra_firestore/infra_firestore.dart'\\n    show ManifestTransportException;\\n\\nconst String kListHostVideos = 'listHostVideos';\\nconst String kGenerateHostVideo = 'generateHostVideo';\\nconst String kGetHostVideoPreview = 'getHostVideoPreview';\\nconst String kDeleteHostVideo = 'deleteHostVideo';\\n\\n/// Fixed generation presets supported by host administration.\\n///\\n/// Pinned to `backend/functions/src/config.ts` (`CHEAP_DEMO_PRESET` /\\n/// `CAMEO_DEMO_PRESET`). Generation presets keep producing 4 clips; the\\n/// preset value is never caller-tunable beyond this fixed set.\\nconst String kCheapDemoPresetId = 'cheap_demo';\\nconst String kCameoDemoPresetId = 'cameo_demo';\\n\\n/// Callable boundary for host administration, separate from guest callables.\\nabstract interface class HostMediaCallableInvoker {\\n  Future<Object?> call(String name, Map<String, Object?> payload);\\n}\\n\\n/// One server-backed seed catalog entry.\\nfinal class HostSeedVideo {\\n  const HostSeedVideo({\\n    required this.seedId,\\n    required this.partyId,\\n    required this.channelId,\\n    required this.status,\\n    required this.jobId,\\n    required this.createdAt,\\n    required this.expiresAt,\\n    required this.previewAvailable,\\n    required this.cameraIds,\\n  });\\n\\n  final String seedId;\\n  final String partyId;\\n  final String channelId;\\n\\n  /// Backend seed status: `queued`, `running`, `ready`, `failed`,\\n  /// `deleted` (expiry surfaces through the same status sync).\\n  final String status;\\n  final String jobId;\\n  final String createdAt;\\n  final String expiresAt;\\n  final bool previewAvailable;\\n  final List<String> cameraIds;\\n\\n  @override\\n  bool operator ==(Object other) =>\\n      other is HostSeedVideo &&\\n      other.seedId == seedId &&\\n      other.partyId == partyId &&\\n      other.channelId == channelId &&\\n      other.status == status &&\\n      other.jobId == jobId &&\\n      other.previewAvailable == previewAvailable;\\n\\n  @override\\n  int get hashCode =>\\n      Object.hash(seedId, partyId, channelId, status, jobId, previewAvailable);\\n\\n  @override\\n  String toString() => 'HostSeedVideo($seedId status=$status)';\\n}\\n\\n/// One signed preview clip reference (signed on demand, never persisted).\\nfinal class HostVideoPreviewClip {\\n  const HostVideoPreviewClip({\\n    required this.cameraId,\\n    required this.sha256,\\n    required this.url,\\n    required this.expiresAt,\\n  });\\n\\n  final String cameraId;\\n  final String sha256;\\n  final Uri url;\\n  final String expiresAt;\\n}\\n\\n/// Fresh scoped preview capability for one seed video.\\nfinal class HostVideoPreview {\\n  const HostVideoPreview({\\n    required this.seedId,\\n    required this.expiresAt,\\n    required this.clips,\\n  });\\n\\n  final String seedId;\\n  final String expiresAt;\\n  final List<HostVideoPreviewClip> clips;\\n}\\n\\n/// Scoped host media client: list / generate / preview / delete.\\nfinal class HostMediaClient {\\n  HostMediaClient({\\n    required HostMediaCallableInvoker invoker,\\n    this.timeout = const Duration(seconds: 15),\\n  }) : _invoker = invoker;\\n\\n  final HostMediaCallableInvoker _invoker;\\n  final Duration timeout;\\n\\n  Map<String, Object?> _scope(\\n    String partyId,\\n    String deviceId,\\n    String channelId,\\n  ) => <String, Object?>{\\n    'partyId': partyId,\\n    'deviceId': deviceId,\\n    'channelId': channelId,\\n  };\\n\\n  Future<Object?> _call(String name, Map<String, Object?> payload) {\\n    try {\\n      return _invoker.call(name, payload).timeout(timeout);\\n    } on TimeoutException catch (error) {\\n      throw ManifestTransportException('$name timed out', error);\\n    }\\n  }\\n\\n  /// Lists the server-backed seed catalog for the registered host scope.\\n  Future<List<HostSeedVideo>> listVideos({\\n    required String partyId,\\n    required String deviceId,\\n    required String channelId,\\n  }) async {\\n    final Object? raw;\\n    try {\\n      raw = await _call(\\n        kListHostVideos,\\n        _scope(partyId, deviceId, channelId),\\n      );\\n    } on FirebaseFunctionsException catch (error) {\\n      throw ManifestTransportException(\\n        'listHostVideos callable failed',\\n        error,\\n      );\\n    }\\n    if (raw is! Map || raw['videos'] is! List) {\\n      throw const FormatException('Host video list response is malformed');\\n    }\\n    final List<HostSeedVideo> videos = <HostSeedVideo>[];\\n    for (final Object? entry in raw['videos'] as List) {\\n      videos.add(_parseSeed(entry, partyId: partyId, channelId: channelId));\\n    }\\n    return videos;\\n  }\\n\\n  HostSeedVideo _parseSeed(\\n    Object? entry, {\\n    required String partyId,\\n    required String channelId,\\n  }) {\\n    if (entry is! Map) {\\n      throw const FormatException('Host seed entry is malformed');\\n    }\\n    String requiredString(String key) {\\n      final Object? value = entry[key];\\n      if (value is! String || value.isEmpty) {\\n        throw FormatException('Host seed entry field \\\"$key\\\" is malformed');\\n      }\\n      return value;\\n    }\\n\\n    final String seedParty = requiredString('partyId');\\n    final String seedChannel = requiredString('channelId');\\n    if (seedParty != partyId || seedChannel != channelId) {\\n      throw const FormatException(\\n        'Host seed entry is outside the registered party and channel',\\n      );\\n    }\\n    final Object? cameras = entry['cameraIds'];\\n    if (entry['previewAvailable'] is! bool || cameras is! List) {\\n      throw const FormatException('Host seed entry fields are malformed');\\n    }\\n    return HostSeedVideo(\\n      seedId: requiredString('seedId'),\\n      partyId: seedParty,\\n      channelId: seedChannel,\\n      status: requiredString('status'),\\n      jobId: requiredString('jobId'),\\n      createdAt: requiredString('createdAt'),\\n      expiresAt: requiredString('expiresAt'),\\n      previewAvailable: entry['previewAvailable'] as bool,\\n      cameraIds: <String>[for (final Object? c in cameras) c.toString()],\\n    );\\n  }\\n\\n  /// Enqueues fixed-preset generation for [seedId].\\n  ///\\n  /// [idempotencyKey] must be stable per seed id across retries so a retry\\n  /// reuses the queued job (`created: false`) instead of enqueueing another\\n  /// task. [presetId] defaults to the supported `cheap_demo` preset.\\n  Future<Map<String, Object?>> generateVideo({\\n    required String partyId,\\n    required String deviceId,\\n    required String channelId,\\n    required String seedId,\\n    required String idempotencyKey,\\n    String presetId = kCheapDemoPresetId,\\n    String? guestMediaId,\\n  }) async {\\n    if (presetId != kCheapDemoPresetId && presetId != kCameoDemoPresetId) {\\n      throw ArgumentError.value(\\n        presetId,\\n        'presetId',\\n        'Only the fixed generation presets are supported',\\n      );\\n    }\\n    final Object? raw;\\n    try {\\n      raw = await _call(kGenerateHostVideo, <String, Object?>{\\n        ..._scope(partyId, deviceId, channelId),\\n        'seedId': seedId,\\n        'idempotencyKey': idempotencyKey,\\n        'presetId': presetId,\\n        if (guestMediaId != null) 'guestMediaId': guestMediaId,\\n      });\\n    } on FirebaseFunctionsException catch (error) {\\n      throw ManifestTransportException(\\n        'generateHostVideo callable failed',\\n        error,\\n      );\\n    }\\n    if (raw is! Map ||\\n        raw['seedId'] != seedId ||\\n        raw['jobId'] is! String ||\\n        raw['state'] is! String ||\\n        raw['created'] is! bool) {\\n      throw const FormatException(\\n        'generateHostVideo response did not match the requested seed',\\n      );\\n    }\\n    return Map<String, Object?>.from(raw);\\n  }\\n\\n  /// Obtains a fresh scoped preview capability for [seedId].\\n  ///\\n  /// Callers must request a new capability per view: signed URLs are\\n  /// short-lived and never persisted server-side.\\n  Future<HostVideoPreview> getPreview({\\n    required String partyId,\\n    required String deviceId,\\n    required String channelId,\\n    required String seedId,\\n  }) async {\\n    final Object? raw;\\n    try {\\n      raw = await _call(kGetHostVideoPreview, <String, Object?>{\\n        ..._scope(partyId, deviceId, channelId),\\n        'seedId': seedId,\\n      });\\n    } on FirebaseFunctionsException catch (error) {\\n      throw ManifestTransportException(\\n        'getHostVideoPreview callable failed',\\n        error,\\n      );\\n    }\\n    if (raw is! Map ||\\n        raw['seedId'] != seedId ||\\n        raw['expiresAt'] is! String ||\\n        raw['clips'] is! List) {\\n      throw const FormatException(\\n        'getHostVideoPreview response did not match the requested seed',\\n      );\\n    }\\n    final List<HostVideoPreviewClip> clips = <HostVideoPreviewClip>[];\\n    for (final Object? entry in raw['clips'] as List) {\\n      if (entry is! Map ||\\n          entry['cameraId'] is! String ||\\n          entry['sha256'] is! String ||\\n          entry['url'] is! String ||\\n          entry['expiresAt'] is! String) {\\n        throw const FormatException('Host preview clip is malformed');\\n      }\\n      final Uri? uri = Uri.tryParse(entry['url'] as String);\\n      if (uri == null ||\\n          uri.scheme != 'https' ||\\n          uri.host.isEmpty ||\\n          uri.userInfo.isNotEmpty) {\\n        throw const FormatException('Host preview URL is invalid');\\n      }\\n      clips.add(\\n        HostVideoPreviewClip(\\n          cameraId: entry['cameraId'] as String,\\n          sha256: entry['sha256'] as String,\\n          url: uri,\\n          expiresAt: entry['expiresAt'] as String,\\n        ),\\n      );\\n    }\\n    return HostVideoPreview(\\n      seedId: seedId,\\n      expiresAt: raw['expiresAt'] as String,\\n      clips: clips,\\n    );\\n  }\\n\\n  /// Deletes the selected seed ids.\\n  ///\\n  /// Deletion is per selected seed id (see the library doc): preview +\\n  /// delivery objects for those seeds are removed, an affected current\\n  /// manifest is revoked, and accounting records are preserved. Only call\\n  /// after the caller reconciles on authoritative success.\\n  Future<Map<String, Object?>> deleteVideos({\\n    required String partyId,\\n    required String deviceId,\\n    required String channelId,\\n    required List<String> seedIds,\\n  }) async {\\n    final Object? raw;\\n    try {\\n      raw = await _call(kDeleteHostVideo, <String, Object?>{\\n        ..._scope(partyId, deviceId, channelId),\\n        'seedIds': seedIds,\\n      });\\n    } on FirebaseFunctionsException catch (error) {\\n      throw ManifestTransportException(\\n        'deleteHostVideo callable failed',\\n        error,\\n      );\\n    }\\n    if (raw is! Map ||\\n        raw['deletedSeedIds'] is! List ||\\n        raw['deletedObjects'] is! List ||\\n        raw['revokedManifest'] is! bool) {\\n      throw const FormatException('deleteHostVideo response is malformed');\\n    }\\n    return Map<String, Object?>.from(raw);\\n  }\\n}\\n\\n/// SDK-backed host media invoker, scoped to the four host callables.\\nfinal class CallableHostMediaInvoker implements HostMediaCallableInvoker {\\n  CallableHostMediaInvoker({required FirebaseFunctions functions})\\n    : _functions = functions;\\n  final FirebaseFunctions _functions;\\n\\n  static const Set<String> _allowed = <String>{\\n    kListHostVideos,\\n    kGenerateHostVideo,\\n    kGetHostVideoPreview,\\n    kDeleteHostVideo,\\n  };\\n\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\\n    if (!_allowed.contains(name)) throw ArgumentError.value(name, 'name');\\n    return (await _functions.httpsCallable(name).call<Object?>(payload)).data;\\n  }\