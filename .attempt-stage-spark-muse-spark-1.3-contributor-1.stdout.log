{"type":"tool_use","timestamp":1793461042260,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929bbc48001CBjXtb2b4H1Ns3","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929bb50b001V3d9h9uWT84m0E","type":"tool","id":"call_01a1929bb76577749b8f8a5bb9284374","tool":"edit","state":{"status":"completed","input":{"newString":"export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n  if (!Array.isArray(clips) || !(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(clips.length)) {\n    throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain 1, 2, or 4 camera clips (four is the default layout).\");\n  }\n  const expected = new Set<string>([...expectedCameraIds(clips.length)]);\n  const byCamera = new Map<string, CanonicalClip>();\n  for (const raw of clips) {\n    if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n        !expected.has(raw.cameraId) ||\n        typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n        !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n        (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n        typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n      throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n    }\n    if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n    byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n  }\n  // Prefix rule: reordered valid clips are accepted, but gaps (e.g.\n  // {CAM-01, CAM-03} for count 2) and unknown cameras are rejected.\n  if (byCamera.size !== expected.size || [...expected].some((cameraId) => !byCamera.has(cameraId))) {\n    throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set must equal the first-N canonical cameras.\");\n  }\n}","oldString":"export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n  if (!Array.isArray(clips) || clips.length !== REQUIRED_CAMERA_IDS.length) {\n    throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain exactly four camera clips.\");\n  }\n  const byCamera = new Map<string, CanonicalClip>();\n  for (const raw of clips) {\n    if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n        !REQUIRED_CAMERA_IDS.includes(raw.cameraId as (typeof REQUIRED_CAMERA_IDS)[number]) ||\n        typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n        !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n        (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n        typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n      throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n    }\n    if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n    byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n  }\n  if (REQUIRED_CAMERA_IDS.some((cameraId) => !byCamera.has(cameraId))) {\n    throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set is incomplete.\");\n  }\n}","path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/contracts.ts"},"output":"Edited backend/functions/src/contracts.ts (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":"backend/functions/src/contracts.ts","patch":"Index: backend/functions/src/contracts.ts\n===================================================================\n--- backend/functions/src/contracts.ts\n+++ backend/functions/src/contracts.ts\n@@ -178,15 +178,16 @@\n   return value;\n }\n \n export function validateCanonicalClips(clips: unknown): asserts clip