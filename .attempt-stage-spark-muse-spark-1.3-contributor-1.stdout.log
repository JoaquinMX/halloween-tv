s(clipAt(1)));\n306:     });\n307: \n308:     test('manifest clips are unmodifiable', () {\n309:       final m = validManifest();\n310:       expect(() => m.clips.add(clipAt(1)), throwsUnsupportedError);\n311:     });\n312: \n313:     test('isValidSha256Hex accepts hex and rejects junk', () {\n314:       expect(isValidSha256Hex(sha('x')), isTrue);\n315:       expect(isValidSha256Hex('A' * 64), isTrue);\n316:       expect(isValidSha256Hex('a' * 63), isFalse);\n317:       expect(isValidSha256Hex(''), isFalse);\n318:       expect(isValidSha256Hex('g' * 64), isFalse);\n319:     });\n320: \n321:     test('overlong clip ids are rejected', () {\n322:       ClipDescriptor longId(String id) => ClipDescriptor(\n323:         id: id,\n324:         cameraId: 'CAM-01',\n325:         storageObjectId: 'obj-01',\n326:         sha256: sha('clip-01'),\n327:         sizeBytes: 10,\n328:         duration: const Duration(seconds: 5),\n329:         mimeType: 'video/mp4',\n330:       );\n331:       final ok = manifest(\n332:         clips: <ClipDescriptor>[\n333:           longId('c' * kMaxClipIdLength),\n334:           clipAt(2),\n335:           clipAt(3),\n336:           clipAt(4),\n337:         ],\n338:       );\n339:       expect(validateCctvManifest(ok).isOk, isTrue);\n340:       final bad = manifest(\n341:         clips: <ClipDescriptor>[\n342:           longId('c' * (kMaxClipIdLength + 1)),\n343:           clipAt(2),\n344:           clipAt(3),\n345:           clipAt(4),\n346:         ],\n347:       );\n348:       final r = validateCctvManifest(bad);\n349:       expect(r.isErr, isTrue);\n350:       expect((r as Err<PlaybackManifest>).message, contains('exceeds'));\n351:     });\n352:   });\n353: \n354:   group('cctvSlots (single source of truth)', () {\n355:     test('canonical order, ids, indices, and default rooms', () {\n356:       expect(\n357:         cctvSlots.map((s) => s.id).toList(),\n358:         <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n359:       );\n360:       expect(cctvSlots.map((s) => s.index).toList(), <int>[0, 1, 2, 3]);\n361:       expect(\n362:         cctvSlots.map((s) => s.room).toList(),\n363:         <String>['hallway', 'kitchen', 'staircase', 'storage room'],\n364:       );\n365:       expect(\n366:         cctvSlots.map((s) => s.defaultLabel).toList(),\n367:         <String>[\n368:           'CAM-01 · hallway',\n369:           'CAM-02 · kitchen',\n370:           'CAM-03 · staircase',\n371:           'CAM-04 · storage room',\n372:         ],\n373:       );\n374:     });\n375: \n376:     test('kCctvCameraIds matches the slot ids', () {\n377:       expect(kCctvCameraIds, cctvSlots.map((s) => s.id).toSet());\n378:     });\n379: \n380:     test('slotForCameraId resolves known cameras and nulls unknown ones', () {\n381:       expect(slotForCameraId('CAM-01')!.index, 0);\n382:       expect(slotForCameraId('CAM-04')!.room, 'storage room');\n383:       expect(slotForCameraId('CAM-05'), isNull);\n384:       expect(slotForCameraId(''), isNull);\n385:     });\n386:   });\n387: \n388:   group('clip labels (config-driven, owner Q3)', () {\n389:     ClipDescriptor labeled(int i, String? label) => ClipDescriptor(\n390:       id: 'clip-0$i',\n391:       cameraId: 'CAM-0$i',\n392:       storageObjectId: 'obj-0$i',\n393:       sha256: sha('clip-0$i'),\n394:       sizeBytes: 1000 + i,\n395:       duration: const Duration(seconds: 10),\n396:       mimeType: 'video/mp4',\n397:       label: label,\n398:     );\n399: \n400:     test('label round-trips through json and equality', () {\n401:       final clip = labeled(1, 'Front Door');\n402:       final back = ClipDescriptor.fromJson(clip.toJson());\n403:       expect(back, equals(clip));\n404:       expect(back.hashCode, clip.hashCode);\n405:       expect(back.label, 'Front Door');\n406:       expect(clip.toJson()['label'], 'Front Door');\n407:     });\n408: \n409:     test('absent label stays null and keeps the old wire shape', () {\n410:       final clip = labeled(2, null);\n411:       expect(clip.label, isNull);\n412:       expect(clip.toJson().containsKey('label'), isFalse);\n413:       expect(ClipDescriptor.fromJson(clip.toJson()), equals(clip));\n414:     });\n415: \n416:     test('resolveCctvLabel prefers custom labels, else slot defaults', () {\n417:       expect(resolveCctvLabel(labeled(1, 'Front Door')), 'Front Door');\n418:       expect(resolveCctvLabel(labeled(2, null)), 'CAM-02 · kitchen');\n419:       expect(resolveCctvLabel(labeled(3, '   ')), 'CAM-03 · staircase');\n420:     });\n421: \n422:     test('custom-label manifest drives wall slot labels end-to-end', () {\n423:       // Manifest -> validate -> JSON round-trip -> per-clip label\n424:       // resolution, all on prod code. The channel-level counterpart lives in\n425:       // channel_cctv (tileForClip + wall widget test), so this covers the\n426:       // domain half of the path with wall-slot ordering preserved.\n427:       final m = manifest(\n428:         clips: <ClipDescriptor>[\n429:           labeled(1, 'Front Door'),\n430:           labeled(2, null),\n431:           labeled(3, 'Basement'),\n432:           labeled(4, 'Attic'),\n433:         ],\n434:       );\n435:       expect(validateCctvManifest(m).isOk, isTrue);\n436:       final reparsed = parseManifest(m.toJson());\n437:       expect(validateCctvManifest(reparsed).isOk, isTrue);\n438:       final labels = <String>[\n439:         for (var i = 0; i < 4; i++)\n440:           resolveCctvLabel(reparsed.clips[i]),\n441:       ];\n442:       expect(labels, <String>[\n443:         'Front Door',\n444:         'CAM-02 · kitchen',\n445:         'Basement',\n446:         'Attic',\n447:       ]);\n448:       // Slot placement still follows camera identity, not clip order.\n449:       expect(\n450:         reparsed.clips.map((c) => slotForCameraId(c.cameraId)!.index).toList(),\n451:         <int>[0, 1, 2, 3],\n452:       );\n453:     });\n454:   });\n455: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b04b