ueIso, jobId } } });\n25:     await bucket.file(orphanPath).save(Buffer.from(\"orphan\"));\n26:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n27:       partyId, channelId, version: 1, jobId, expiresAt: dueIso,\n28:       cameraClips: [{ cameraId: \"CAM-01\", objectPath, sha256: createHash(\"sha256\").update(\"expired\").digest(\"hex\"), sizeBytes: 7, durationMs: 2000, expiresAt: dueIso }],\n29:     });\n30:     const result = await sweepExpiredMedia(db, bucket, new Date());\n31:     assert.ok(result.expiredJobs >= 1, `expected at least this party's due job to expire (got ${result.expiredJobs}); suite shares one emulator across files`);\n32:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.state, \"expired\");\n33:     assert.equal((await bucket.file(objectPath).exists())[0], false);\n34:     assert.equal((await bucket.file(orphanPath).exists())[0], false);\n35:     assert.ok(result.deletedOrphanObjects >= 1);\n36:   } finally {\n37:     await clearParty(db, bucket, partyId);\n38:     await disposeEmulatorContext(app);\n39:   }\n40: });\n41: \n42: test(\"revoked-manifest objects are retried for deletion, never protected\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n43:   const { app, db, bucket } = await createEmulatorContext();\n44:   const partyId = randomPartyId();\n45:   const deviceId = \"tv-1\";\n46:   const channelId = \"main\";\n47:   const jobId = \"job-revoked\";\n48:   const submissionId = \"gsub-revoked000000000000000002\";\n49:   const liveExpiry = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n50:   const clipPath = `parties/${partyId}/channels/${channelId}/delivery/1/CAM-01.mp4`;\n51:   const sourcePath = `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`;\n52:   try {\n53:     await seedParty(db, partyId, deviceId, channelId);\n54:     // Withdrawn tombstone whose manifest was published before withdrawal and\n55:     // whose source object survived the withdrawal delete (pending retry).\n56:     await db.doc(`parties/${partyId}/guestMedia/${submissionId}`).set({\n57:       submissionId, partyId, deviceId, channelId, status: \"withdrawn\", tombstone: true,\n58:       consentRevision: \"v1:revoked\", objectPath: sourcePath,\n59:       pendingDeletions: [sourcePath], revokedManifestPaths: [clipPath],\n60:       withdrawnAt: new Date().toISOString(),\n61:     });\n62:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n63:       jobId, partyId, deviceId, channelId, state: \"failed\", errorCode: \"FORBIDDEN\",\n64:       manifestVersion: 1, expiresAt: Timestamp.fromDate(new Date(Date.now() + 60 * 60 * 1000)),\n65:       guestMedia: { submissionId },\n66:     });\n67:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n68:       partyId, channelId, version: 1, schemaVersion: 1, jobId, expiresAt: liveExpiry,\n69:       cameraClips: [{ cameraId: \"CAM-01\", objectPath: clipPath, sha256: createHash(\"sha256\").update(\"revoked\").digest(\"hex\"), sizeBytes: 7, durationMs: 2000, expiresAt: liveExpiry }],\n70:     });\n71:     await bucket.file(clipPath).save(Buffer.from(\"revoked\"));\n72:     await bucket.file(sourcePath).save(Buffer.from(\"leftover-source\"));\n73:     assert.equal((await bucket.file(clipPath).exists())[0], true);\n74:     const result = await sweepExpiredMedia(db, bucket, new Date());\n75:     assert.equal((await bucket.file(clipPath).exists())[0], false, \"revoked manifest clip must be deleted, not protected\");\n76:     assert.equal((await bucket.file(sourcePath).exists())[0], false, \"pending withdrawal deletions must be retried\");\n77:     assert.ok(result.deletedOrphanObjects >= 2, `expected revoked objects to be retried (got ${JSON.stringify(result)})`);\n78:   } finally {\n79:     await clearParty(db, bucket, partyId);\n80:     await disposeEmulatorContext(app);\n81:   }\n82: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text",