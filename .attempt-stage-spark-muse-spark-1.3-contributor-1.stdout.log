{"type":"tool_use","timestamp":1793461691144,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a59ea80010NRC185FtqFAlp","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a594c2001AZEQpUWfLaOmMw","type":"tool","id":"call_01a192a59ad97007908d081c7fba0dfa","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_codes.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_codes.dart, lines 1-332\n1: /// Host-visible guest code data (TV settings panel).\n2: ///\n3: /// The TV panel shows the TV's own party/device code as large text plus a QR\n4: /// encoding the anonymous session join payload, and lists the joined guest\n5: /// devices. Identifiers are opaque binding values only — never URLs,\n6: /// endpoints, or secrets. Registration is always decided server-side at\n7: /// callable time; nothing here implies a code is valid.\n8: ///\n9: /// Session QR JSON (TV display, companion parse) contains exactly\n10: /// `partyId` + `channelId` plus optional six-digit `joinPin`. It never\n11: /// carries a deviceId, URL, or secret.\n12: library;\n13: \n14: import 'dart:convert';\n15: \n16: import 'package:cloud_functions/cloud_functions.dart';\n17: \n18: /// Validates the optional six-digit session PIN (leading zeros significant).\n19: bool isValidJoinPin(String value) =>\n20:     RegExp(r'^[0-9]{6}$').hasMatch(value);\n21: \n22: /// One per-guest device visible to the host.\n23: ///\n24: /// Self-registered guests may have no `label` (absent or empty on the wire);\n25: /// readers must fall back to a neutral device-based display, never duplicate\n26: /// the id as label+value, and never prompt for names.\n27: final class GuestCodeEntry {\n28:   /// Creates a guest code row.\n29:   const GuestCodeEntry({\n30:     required this.deviceId,\n31:     this.label,\n32:     this.role,\n33:     this.status,\n34:   });\n35: \n36:   /// Guest device id (opaque value shown once as the row value).\n37:   final String deviceId;\n38: \n39:   /// Host label when the backend supplied a non-empty one; null otherwise.\n40:   final String? label;\n41: \n42:   /// Device role as reported by the listing (e.g. \"guest\"); null when absent.\n43:   final String? role;\n44: \n45:   /// Device status as reported by the listing; null when absent.\n46:   final String? status;\n47: \n48:   /// True when the backend supplied a non-blank label.\n49:   bool get hasCustomLabel => label != null && label!.trim().isNotEmpty;\n50: \n51:   /// Neutral display label: the custom label when present, else a generic\n52:   /// fallback that never echoes the device id.\n53:   String get displayLabel =>\n54:       hasCustomLabel ? label!.trim() : 'Guest device';\n55: \n56:   @override\n57:   bool operator ==(Object other) =>\n58:       identical(this, other) ||\n59:       (other is GuestCodeEntry &&\n60:           other.deviceId == deviceId &&\n61:           other.label == label &&\n62:           other.role == role &&\n63:           other.status == status);\n64: \n65:   @override\n66:   int get hashCode => Object.hash(deviceId, label, role, status);\n67: \n68:   @override\n69:   String toString() => 'GuestCodeEntry($displayLabel: $deviceId)';\n70: }\n71: \n72: /// Builds the anonymous session QR/join payload as a JSON object.\n73: ///\n74: /// Contains exactly `partyId` + `channelId` plus the optional six-digit\n75: /// `joinPin` (omitted when null). Never includes a deviceId, URL, or secret.\n76: /// Throws [ArgumentError] when [joinPin] is non-null but malformed.\n77: String buildJoinPayload({\n78:   required String partyId,\n79:   required String channelId,\n80:   String? joinPin,\n81: }) {\n82:   if (joinPin != null && !isValidJoinPin(joinPin)) {\n83:     throw ArgumentError.value(joinPin, 'joinPin', 'must be six ASCII digits');\n84:   }\n85:   final Map<String, String> payload = <String, String>{\n86:     'partyId': partyId,\n87:     'channelId': channelId,\n88:   };\n89:   if (joinPin != null) {\n90:     payload['joinPin'] = joinPin;\n91:   }\n92:   return jsonEncode(payload);\n93: }\n94: \n95: /// Failure reading the host guest-code listing.\n96: final class GuestCodeException implements Exception {\n97:   /// Creates a guest-code read failure.\n98:   const GuestCodeException(this.message);\n99: \n100:   /// Human-readable reason shown on the TV panel.\n101:   final String message;\n102: \n103:   @override\n104:   String toString() => 'GuestCodeException: $message';\n105: }\n106: \n107: /// Callable invoker seam: calls the named callable with the payload and\n108: /// returns the decoded response data. Production passes Cloud Functions;\n109: /// tests pass a fake.\n110: typedef CallableInvoker =\n111:     Future<Map<String, Object?>> Function(\n112:       String name,\n113:       Map<String, Object?> payload,\n114:     );\n115: \n116: /// Validated host-only session listing from `listPartyDevices`.\n117: ///\n118: /// Carries the authoritative session scope (`partyId`/`channelId`/\n119: /// `tvDeviceId`), the optional `joinPin` (string when configured, absent\n120: /// otherwise), and the guest device entries. PIN state always comes from\n121: /// this response, never from build-time config.\n122: final class GuestCodeListing {\n123:   /// Creates a validated listing.\n124:   const GuestCodeListing({\n125:     required this.partyId,\n126:     required this.channelId,\n127:     required this.tvDeviceId,\n128:     required this.devices,\n129:     this.joinPin,\n130:   });\n131: \n132:   /// Party the TV belongs to (must match the requesting client).\n133:   final String partyId;\n134: \n135:   /// Active channel (must match the requesting client).\n136:   final String channelId;\n137: \n138:   /// TV's own device id (must match the requesting client).\n139:   final String tvDeviceId;\n140: \n141:   /// Session PIN when configured; null means no PIN is required.\n142:   final String? joinPin;\n143: \n144:   /// Guest device entries (TV's own device excluded server-side).\n145:   final List<GuestCodeEntry> devices;\n146: \n147:   /// Validates a raw callable response against the requesting client's\n148:   /// scope. Throws [GuestCodeException] on any malformed field.\n149:   factory GuestCodeListing.fromResponse(\n150:     Map<String, Object?> data, {\n151:     required String expectedPartyId,\n152:     required String expectedChannelId,\n153:     required String expectedTvDeviceId,\n154:   }) {\n155:     final Object? partyId = data['partyId'];\n156:     final Object? channelId = data['channelId'];\n157:     final Object? tvDeviceId = data['tvDeviceId'] ?? data['deviceId'];\n158:     if (partyId is! String || partyId.isEmpty) {\n159:       throw const GuestCodeException('Guest list response has no party.');\n160:     }\n161:     if (channelId is! String || channelId.isEmpty) {\n162:       throw const GuestCodeException('Guest list response has no channel.');\n163:     }\n164:     if (tvDeviceId is! String || tvDeviceId.isEmpty) {\n165:       throw const GuestCodeException('Guest list response has no TV device.');\n166:     }\n167:     if (partyId != expectedPartyId) {\n168:       throw const GuestCodeException('Guest list party mismatch.');\n169:     }\n170:     if (channelId != expectedChannelId) {\n171:       throw const GuestCodeException('Guest list channel mismatch.');\n172:     }\n173:     if (tvDeviceId != expectedTvDeviceId) {\n174:       throw const GuestCodeException('Guest list TV device mismatch.');\n175:     }\n176:     String? joinPin;\n177:     if (data.containsKey('joinPin')) {\n178:       final Object? rawPin = data['joinPin'];\n179:       if (rawPin == null) {\n180:         joinPin = null;\n181:       } else if (rawPin is String && isValidJoinPin(rawPin)) {\n182:         joinPin = rawPin;\n183:       } else {\n184:         throw const GuestCodeException('Guest list PIN is malformed.');\n185:       }\n186:     }\n187:     final Object? devices = data['devices'];\n188:     if (devices is! List) {\n189:       throw const GuestCodeException('Guest list response has no device list.');\n190:     }\n191:     final List<GuestCodeEntry> entries = <GuestCodeEntry>[];\n192:     for (final Object? item in devices) {\n193:       if (item is! Map) {\n194:         throw const GuestCodeException('Guest list entry was not an object.');\n195:       }\n196:       final Map<String, Object?> row = Map<String, Object?>.from(item);\n197:       final Object? deviceId = row['deviceId'];\n198:       if (deviceId is! String || deviceId.isEmpty) {\n199:         throw const GuestCodeException('Guest list entry is missing fields.');\n200:       }\n201:       String? label;\n202:       if (row.containsKey('label')) {\n203:         final Object? rawLabel = row['label'];\n204:         if (rawLabel == null) {\n205:           label = null;\n206:         } else if (rawLabel is String) {\n207:           label = rawLabel.trim().isEmpty ? null : rawLabel.trim();\n208:         } else {\n209:           throw const GuestCodeException(\n210:             'Guest list entry is missing fields.',\n211:           );\n212:         }\n213:       }\n214:       String? role;\n215:       if (row.containsKey('role')) {\n216:         final Object? rawRole = row['role'];\n217:         if (rawRole == null) {\n218:           role = null;\n219:         } else if (rawRole is String && rawRole.isNotEmpty) {\n220:           role = rawRole;\n221:         } else {\n222:           throw const GuestCodeException(\n223:             'Guest list entry is missing fields.',\n224:           );\n225:         }\n226:       }\n227:       String? status;\n228:       if (row.containsKey('status')) {\n229:         final Object? rawStatus = row['status'];\n230:         if (rawStatus == null) {\n231:           status = null;\n232:         } else if (rawStatus is String && rawStatus.isNotEmpty) {\n233:           status = rawStatus;\n234:         } else {\n235:           throw const GuestCodeException(\n236:             'Guest list entry is missing fields.',\n237:           );\n238:         }\n239:       }\n240:       entries.add(\n241:         GuestCodeEntry(\n242:           deviceId: deviceId,\n243:           label: label,\n244:           role: role,\n245:           status: status,\n246:         ),\n247:       );\n248:     }\n249:     return GuestCodeListing(\n250:       partyId: partyId,\n251:       channelId: channelId,\n252:       tvDeviceId: tvDeviceId,\n253:       joinPin: joinPin,\n254:       devices: List<GuestCodeEntry>.unmodifiable(entries),\n255:     );\n256:   }\n257: }\n258: \n259: /// Reads the host-only `listPartyDevices` callable (TV device only).\n260: final class GuestCodeClient {\n261:   /// Creates a client over an invoker seam.\n262:   const GuestCodeClient({\n263:     required this.invoker,\n264:     required this.partyId,\n265:     required this.deviceId,\n266:     required this.channelId,\n267:   });\n268: \n269:   /// Builds a client over real Cloud Functions.\n270:   factory GuestCodeClient.cloudFunctions({\n271:     required FirebaseFunctions functions,\n272:     required String partyId,\n273:     required String deviceId,\n274:     required String channelId,\n275:   }) => GuestCodeClient(\n276:     invoker: (String name, Map<String, Object?> payload) async {\n277:       final HttpsCallableResult<Object?> result = await functions\n278:           .httpsCallable(name)\n279:           .call(payload);\n280:       final Object? data = result.data;\n281:       if (data is! Map) {\n282:         throw const GuestCodeException('Guest list response was not an object.');\n283:       }\n284:       return Map<String, Object?>.from(data);\n285:     },\n286:     partyId: partyId,\n287:     deviceId: deviceId,\n288:     channelId: channelId,\n289:   );\n290: \n291:   /// Invoker seam (Cloud Functions in production, fake in tests).\n292:   final CallableInvoker invoker;\n293: \n294:   /// Party the TV belongs to.\n295:   final String partyId;\n296: \n297:   /// TV's own device code (the authorized host caller).\n298:   final String deviceId;\n299: \n300:   /// Active channel.\n301:   final String channelId;\n302: \n303:   /// Fetches the validated host listing (scope + optional PIN + devices).\n304:   ///\n305:   /// Authorization still travels in the request as the TV's own `deviceId`;\n306:   /// the session QR never carries it. Throws [GuestCodeException] when the\n307:   /// response is malformed. Authorization failures surface as the caller's\n308:   /// error.\n309:   Future<GuestCodeListing> fetchListing() async {\n310:     final Map<String, Object?> data = await invoker('listPartyDevices', <\n311:       String,\n312:       Object?\n313:     >{\n314:       'partyId': partyId,\n315:       'deviceId': deviceId,\n316:       'channelId': channelId,\n317:     });\n318:     return GuestCodeListing.fromResponse(\n319:       data,\n320:       expectedPartyId: partyId,\n321:       expectedChannelId: channelId,\n322:       expectedTvDeviceId: deviceId,\n323:     );\n324:   }\n325: \n326:   /// Fetches guest codes; throws [GuestCodeException] when the response is\n327:   /// malformed. Authorization failures surface as the caller's error.\n328:   Future<List<GuestCodeEntry>> fetchGuestCodes() async {\n329:     final GuestCodeListing listing = await fetchListing();\n330:     return listing.devices;\n331:   }\n332: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_codes.dart, lines 1-332\n1: /// Host-visible guest code data (TV settings panel).\n2: ///\n3: /// The TV panel shows the TV's own party/device code as large text plus a QR\n4: /// encoding the anonymous session join payload, and lists the joined guest\n5: /// devices. Identifiers are opaque binding values only — never URLs,\n6: /// endpoints, or secrets. Registration is always decided server-side at\n7: /// callable time; nothing here implies a code is valid.\n8: ///\n9: /// Session QR JSON (TV display, companion parse) contains exactly\n10: /// `partyId` + `channelId` plus optional six-digit `joinPin`. It never\n11: /// carries a deviceId, URL, or secret.\n12: library;\n13: \n14: import 'dart:convert';\n15: \n16: import 'package:cloud_functions/cloud_functions.dart';\n17: \n18: /// Validates the optional six-digit session PIN (leading zeros significant).\n19: bool isValidJoinPin(String value) =>\n20:     RegExp(r'^[0-9]{6}$').hasMatch(value);\n21: \n22: /// One per-guest device visible to the host.\n23: ///\n24: /// Self-registered guests may have no `label` (absent or empty on the wire);\n25: /// readers must fall back to a neutral device-based display, never duplicate\n26: /// the id as label+value, and never prompt for names.\n27: final class GuestCodeEntry {\n28:   /// Creates a guest code row.\n29:   const GuestCodeEntry({\n30:     required this.deviceId,\n31:     this.label,\n32:     this.role,\n33:     this.status,\n34:   });\n35: \n36:   /// Guest device id (opaque value shown once as the row value).\n37:   final String deviceId;\n38: \n39:   /// Host label when the backend supplied a non-empty one; null otherwise.\n40:   final String? label;\n41: \n42:   /// Device role as reported by the listing (e.g. \"guest\"); null when absent.\n43:   final String? role;\n44: \n45:   /// Device status as reported by the listing; null when absent.\n46:   final String? status;\n47: \n48:   /// True when the backend supplied a non-blank label.\n49:   bool get hasCustomLabel => label != null && label!.trim().isNotEmpty;\n50: \n51:   /// Neutral display label: the custom label when present, else a generic\n52:   /// fallback that never echoes the device id.\n53:   String get displayLabel =>\n54:       hasCustomLabel ? label!.trim() : 'Guest device';\n55: \n56:   @override\n57:   bool operator ==(Object other) =>\n58:       identical(this, other) ||\n59:       (other is GuestCodeEntry &&\n60:           other.deviceId == deviceId &&\n61:           other.label == label &&\n62:           other.role == role &&\n63:           other.status == status);\n64: \n65:   @override\n66:   int get hashCode => Object.hash(deviceId, label, role, status);\n67: \n68:   @override\n69:   String toString() => 'GuestCodeEntry($displayLabel: $deviceId)';\n70: }\n71: \n72: /// Builds the anonymous session QR/join payload as a JSON object.\n73: ///\n74: /// Contains exactly `partyId` + `channelId` plus the optional six-digit\n75: /// `joinPin` (omitted when null). Never includes a deviceId, URL, or secret.\n76: /// Throws [ArgumentError] when [joinPin] is non-null but malformed.\n77: String buildJoinPayload({\n78:   required String partyId,\n79:   required String channelId,\n80:   String? joinPin,\n81: }) {\n82:   if (joinPin != null && !isValidJoinPin(joinPin)) {\n83:     throw ArgumentError.value(joinPin, 'joinPin', 'must be six ASCII digits');\n84:   }\n85:   final Map<String, String> payload = <String, String>{\n86:     'partyId': partyId,\n87:     'channelId': channelId,\n88:   };\n89:   if (joinPin != null) {\n90:     payload['joinPin'] = joinPin;\n91:   }\n92:   return jsonEncode(payload);\n93: }\n94: \n95: /// Failure reading the host guest-code listing.\n96: final class GuestCodeException implements Exception {\n97:   /// Creates a guest-code read failure.\n98:   const GuestCodeException(this.message);\n99: \n100:   /// Human-readable reason shown on the TV panel.\n101:   final String message;\n102: \n103:   @override\n104:   String toString() => 'GuestCodeException: $message';\n105: }\n106: \n107: /// Callable invoker seam: calls the named callable with the payload and\n108: /// returns the decoded response data. Production passes Cloud Functions;\n109: /// tests pass a fake.\n110: typedef CallableInvoker =\n111:     Future<Map<String, Object?>> Function(\n112:       String name,\n113:       Map<String, Object?> payload,\n114:     );\n115: \n116: /// Validated host-only session listing from `listPartyDevices`.\n117: ///\n118: /// Carries the authoritative session scope (`partyId`/`channelId`/\n119: /// `tvDeviceId`), the optional `joinPin` (string when configured, absent\n120: /// otherwise), and the guest device entries. PIN state always comes from\n121: /// this response, never from build-time config.\n122: final class GuestCodeListing {\n123:   /// Creates a validated listing.\n124:   const GuestCodeListing({\n125:     required this.partyId,\n126:     required this.channelId,\n127:     required this.tvDeviceId,\n128:     required this.devices,\n129:     this.joinPin,\n130:   });\n131: \n132:   /// Party the TV belongs to (must match the requesting client).\n133:   final String partyId;\n134: \n135:   /// Active channel (must match the requesting client).\n136:   final String channelId;\n137: \n138:   /// TV's own device id (must match the requesting client).\n139:   final String tvDeviceId;\n140: \n141:   /// Session PIN when configured; null means no PIN is required.\n142:   final String? joinPin;\n143: \n144:   /// Guest device entries (TV's own device excluded server-side).\n145:   final List<GuestCodeEntry> devices;\n146: \n147:   /// Validates a raw callable response against the requesting client's\n148:   /// scope. Throws [GuestCodeException] on any malformed field.\n149:   factory GuestCodeListing.fromResponse(\n150:     Map<String, Object?> data, {\n151:     required String expectedPartyId,\n152:     required String expectedChannelId,\n153:     required String expectedTvDeviceId,\n154:   }) {\n155:     final Object? partyId = data['partyId'];\n156:     final Object? channelId = data['channelId'];\n157:     final Object? tvDeviceId = data['tvDeviceId'] ?? data['deviceId'];\n158:     if (partyId is! String || partyId.isEmpty) {\n159:       throw const GuestCodeException('Guest list response has no party.');\n160:     }\n161:     if (channelId is! String || channelId.isEmpty) {\n162:       throw const GuestCodeException('Guest list response has no channel.');\n163:     }\n164:     if (tvDeviceId is! String || tvDeviceId.isEmpty) {\n165:       throw const GuestCodeException('Guest list response has no TV device.');\n166:     }\n167:     if (partyId != expectedPartyId) {\n168:       throw const GuestCodeException('Guest list party mismatch.');\n169:     }\n170:     if (channelId != expectedChannelId) {\n171:       throw const GuestCodeException('Guest list channel mismatch.');\n172:     }\n173:     if (tvDeviceId != expectedTvDeviceId) {\n174:       throw const GuestCodeException('Guest list TV device mismatch.');\n175:     }\n176:     String? joinPin;\n177:     if (data.containsKey('joinPin')) {\n178:       final Object? rawPin = data['joinPin'];\n179:       if (rawPin == null) {\n180:         joinPin = null;\n181:       } else if (rawPin is String && isValidJoinPin(rawPin)) {\n182:         joinPin = rawPin;\n183:       } else {\n184:         throw const GuestCodeException('Guest list PIN is malformed.');\n185:       }\n186:     }\n187:     final Object? devices = data['devices'];\n188:     if (devices is! List) {\n189:       throw const GuestCodeException('Guest list response has no device list.');\n190:     }\n191:     final List<GuestCodeEntry> entries = <GuestCodeEntry>[];\n192:     for (final Object? item in devices) {\n193:       if (item is! Map) {\n194:         throw const GuestCodeException('Guest list entry was not an object.');\n195:       }\n196:       final Map<String, Object?> row = Map<String, Object?>.from(item);\n197:       final Object? deviceId = row['deviceId'];\n198:       if (deviceId is! String || deviceId.isEmpty) {\n199:         throw const GuestCodeException('Guest list entry is missing fields.');\n200:       }\n201:       String? label;\n202:       if (row.containsKey('label')) {\n203:         final Object? rawLabel = row['label'];\n204:         if (rawLabel == null) {\n205:           label = null;\n206:         } else if (rawLabel is String) {\n207:           label = rawLabel.trim().isEmpty ? null : rawLabel.trim();\n208:         } else {\n209:           throw const GuestCodeException(\n210:             'Guest list entry is missing fields.',\n211:           );\n212:         }\n213:       }\n214:       String? role;\n215:       if (row.containsKey('role')) {\n216:         final Object? rawRole = row['role'];\n217:         if (rawRole == null) {\n218:           role = null;\n219:         } else if (rawRole is String && rawRole.isNotEmpty) {\n220:           role = rawRole;\n221:         } else {\n222:           throw const GuestCodeException(\n223:             'Guest list entry is missing fields.',\n224:           );\n225:         }\n226:       }\n227:       String? status;\n228:       if (row.containsKey('status')) {\n229:         final Object? rawStatus = row['status'];\n230:         if (rawStatus == null) {\n231:           status = null;\n232:         } else if (rawStatus is String && rawStatus.isNotEmpty) {\n233:           status = rawStatus;\n234:         } else {\n235:           throw const GuestCodeException(\n236:             'Guest list entry is missing fields.',\n237:           );\n238:         }\n239:       }\n240:       entries.add(\n241:         GuestCodeEntry(\n242:           deviceId: deviceId,\n243:           label: label,\n244:           role: role,\n245:           status: status,\n246:         ),\n247:       );\n248:     }\n249:     return GuestCodeListing(\n250:       partyId: partyId,\n251:       channelId: channelId,\n252:       tvDeviceId: tvDeviceId,\n253:       joinPin: joinPin,\n254:       devices: List<GuestCodeEntry>.unmodifiable(entries),\n255:     );\n256:   }\n257: }\n258: \n259: /// Reads the host-only `listPartyDevices` callable (TV device only).\n260: final class GuestCodeClient {\n261:   /// Creates a client over an invoker seam.\n262:   const GuestCodeClient({\n263:     required this.invoker,\n264:     required this.partyId,\n265:     required this.deviceId,\n266:     required this.channelId,\n267:   });\n268: \n269:   /// Builds a client over real Cloud Functions.\n270:   factory GuestCodeClient.cloudFunctions({\n271:     required FirebaseFunctions functions,\n272:     required String partyId,\n273:     required String deviceId,\n274:     required String channelId,\n275:   }) => GuestCodeClient(\n276:     invoker: (String name, Map<String, Object?> payload) async {\n277:       final HttpsCallableResult<Object?> result = await functions\n278:           .httpsCallable(name)\n279:           .call(payload);\n280:       final Object? data = result.data;\n281:       if (data is! Map) {\n282:         throw const GuestCodeException('Guest list response was not an object.');\n283:       }\n284:       return Map<String, Object?>.from(data);\n285:     },\n286:     partyId: partyId,\n287:     deviceId: deviceId,\n288:     channelId: channelId,\n289:   );\n290: \n291:   /// Invoker seam (Cloud Functions in production, fake in tests).\n292:   final CallableInvoker invoker;\n293: \n294:   /// Party the TV belongs to.\n295:   final String partyId;\n296: \n297:   /// TV's own device code (the authorized host caller).\n298:   final String deviceId;\n299: \n300:   /// Active channel.\n301:   final String channelId;\n302: \n303:   /// Fetches the validated host listing (scope + optional PIN + devices).\n304:   ///\n305:   /// Authorization still travels in the request as the TV's own `deviceId`;\n306:   /// the session QR never carries it. Throws [GuestCodeException] when the\n307:   /// response is malformed. Authorization failures surface as the caller's\n308:   /// error.\n309:   Future<GuestCodeListing> fetchListing() async {\n310:     final Map<String, Object?> data = await invoker('listPartyDevices', <\n311:       String,\n312:       Object?\n313:     >{\n314:       'partyId': partyId,\n315:       'deviceId': deviceId,\n316:       'channelId': channelId,\n317:     });\n318:     return GuestCodeListing.fromResponse(\n319:       data,\n320:       expectedPartyId: partyId,\n321:       expectedChannelId: channelId,\n322:       expectedTvDeviceId: deviceId,\n323:     );\n324:   }\n325: \n326:   /// Fetches guest codes; throws [GuestCodeException] when the response is\n327:   /// malformed. Authorization failures surface as the caller's error.\n328:   Future<List<GuestCodeEntry>> fetchGuestCodes() async {\n329:     final GuestCodeListing listing = await fetchListing();\n330:     return listing.devices;\n331:   }\n332: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a59ad97007908d081c7fba0dfa"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_codes.dart\"}"},"time":{"start":1793461690024,"end":1793461691144}}}}
