  /** Fails a consent-bound job closed after withdrawal and cleans staged bytes. */\n226:   async function failForWithdrawnConsent(partyId: string, jobId: string): Promise<never> {\n227:     const job = await store.getJob(partyId, jobId).catch(() => undefined);\n228:     if (job) {\n229:       const staged = ((job.stagedOutputs ?? {}) as Record<string, Record<string, unknown>>) ?? {};\n230:       for (const cameraId of REQUIRED_CAMERA_IDS) {\n231:         const clip = staged[cameraId];\n232:         if (clip && typeof clip.objectPath === \"string\" && clip.objectPath.startsWith(\"parties/\")) {\n233:           await options.bucket.file(clip.objectPath).delete({ ignoreNotFound: true }).catch(() => undefined);\n234:         }\n235:       }\n236:     }\n237:     await store.failForWithdrawnConsent(partyId, jobId).catch(() => undefined);\n238:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn; the bound generation job is discarded.\");\n239:   }\n240: \n241:   async function recheckGuestConsent(\n242:     partyId: string,\n243:     jobId: string,\n244:     deviceId: string,\n245:     channelId: string,\n246:     submissionId: string,\n247:     expectedHash: string,\n248:   ): Promise<GuestImageReference> {\n249:     let eligible: Awaited<ReturnType<typeof assertGuestEligible>>;\n250:     try {\n251:       eligible = await assertGuestEligible(options.db, { partyId, deviceId, channelId }, submissionId, now().getTime());\n252:     } catch {\n253:       await failForWithdrawnConsent(partyId, jobId);\n254:       throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn; the bound generation job is discarded.\");\n255:     }\n256:     if (eligible.sourceHash !== expectedHash) {\n257:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Guest media source changed while the job was running.\");\n258:     }\n259:     const [bytes] = await options.bucket.file(eligible.objectPath).download().catch(() => [undefined] as unknown as [Buffer | undefined