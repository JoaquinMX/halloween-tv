{"type":"tool_use","timestamp":1793463634469,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c34846001IWIpW1MtG4g8x3","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c33c97001bTMrQpDln0nIdJ","type":"tool","id":"call_01a192c3481d73a2867c0fdf65a41176","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/ui/host_video_preview_screen.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/ui/host_video_preview_screen.dart, lines 1-241\n1: /// Host video preview: fresh scoped capability per view + playback.\n2: ///\n3: /// The screen requests a new preview capability on open\n4: /// ([HostSession.preview] → `getHostVideoPreview`): signed URLs are\n5: /// short-lived and never persisted, so a cached capability is never reused.\n6: /// Tapping a camera creates its player; switching cameras or leaving the\n7: /// screen disposes the previous player. Backgrounding pauses playback\n8: /// (the app observer additionally suspends catalog polling while the\n9: /// capability itself simply expires server-side).\n10: ///\n11: /// The [playerFactory] seam substitutes ONLY the platform player boundary\n12: /// (the shipped default builds a real [VideoPlayerController]); everything\n13: /// above it — capability fetch, validation, play/dispose lifecycle — is the\n14: /// real production path.\n15: library;\n16: \n17: import 'package:companion_app/src/data/host_media_client.dart';\n18: import 'package:companion_app/src/session/host_session.dart';\n19: import 'package:flutter/material.dart';\n20: import 'package:video_player/video_player.dart';\n21: \n22: /// Platform player boundary for host previews.\n23: abstract interface class HostPreviewPlayer {\n24:   Future<void> initialize();\n25:   Future<void> play();\n26:   Future<void> pause();\n27:   Future<void> dispose();\n28:   bool get isInitialized;\n29:   double get aspectRatio;\n30:   Widget buildView();\n31: }\n32: \n33: final class _VideoPreviewPlayer implements HostPreviewPlayer {\n34:   _VideoPreviewPlayer(Uri url)\n35:     : _controller = VideoPlayerController.networkUrl(url);\n36: \n37:   final VideoPlayerController _controller;\n38: \n39:   @override\n40:   Future<void> initialize() => _controller.initialize();\n41: \n42:   @override\n43:   Future<void> play() => _controller.play();\n44: \n45:   @override\n46:   Future<void> pause() => _controller.pause();\n47: \n48:   @override\n49:   Future<void> dispose() => _controller.dispose();\n50: \n51:   @override\n52:   bool get isInitialized => _controller.value.isInitialized;\n53: \n54:   @override\n55:   double get aspectRatio => _controller.value.aspectRatio;\n56: \n57:   @override\n58:   Widget buildView() => VideoPlayer(_controller);\n59: }\n60: \n61: final class HostVideoPreviewScreen extends StatefulWidget {\n62:   const HostVideoPreviewScreen({\n63:     super.key,\n64:     required this.session,\n65:     required this.seedId,\n66:     this.playerFactory = _VideoPreviewPlayer.new,\n67:   });\n68: \n69:   final HostSession session;\n70:   final String seedId;\n71: \n72:   /// Substitutes only the platform player boundary.\n73:   final HostPreviewPlayer Function(Uri url) playerFactory;\n74: \n75:   static const Key statusKey = Key('host-preview-status');\n76:   static const Key errorKey = Key('host-preview-error');\n77:   static const Key videoKey = Key('host-preview-video');\n78:   static Key playKey(String cameraId) => Key('host-preview-play-$cameraId');\n79: \n80:   @override\n81:   State<HostVideoPreviewScreen> createState() => _HostVideoPreviewScreenState();\n82: }\n83: \n84: final class _HostVideoPreviewScreenState extends State<HostVideoPreviewScreen>\n85:     with WidgetsBindingObserver {\n86:   late final Future<HostVideoPreview> _capability;\n87:   HostPreviewPlayer? _player;\n88:   String? _activeCamera;\n89:   String? _playError;\n90:   bool _initializing = false;\n91: \n92:   @override\n93:   void initState() {\n94:     super.initState();\n95:     WidgetsBinding.instance.addObserver(this);\n96:     // Fresh scoped capability per view: never reuse a cached preview.\n97:     _capability = widget.session.preview(widget.seedId);\n98:   }\n99: \n100:   @override\n101:   void didChangeAppLifecycleState(AppLifecycleState state) {\n102:     if (state == AppLifecycleState.paused) {\n103:       _player?.pause();\n104:     }\n105:   }\n106: \n107:   @override\n108:   void dispose() {\n109:     WidgetsBinding.instance.removeObserver(this);\n110:     _disposePlayer();\n111:     super.dispose();\n112:   }\n113: \n114:   void _disposePlayer() {\n115:     final HostPreviewPlayer? player = _player;\n116:     _player = null;\n117:     _activeCamera = null;\n118:     if (player != null) {\n119:       player.pause();\n120:       player.dispose();\n121:     }\n122:   }\n123: \n124:   Future<void> _play(HostVideoPreviewClip clip) async {\n125:     if (_initializing || _activeCamera == clip.cameraId) return;\n126:     setState(() {\n127:       _initializing = true;\n128:       _playError = null;\n129:     });\n130:     _disposePlayer();\n131:     final HostPreviewPlayer player = widget.playerFactory(clip.url);\n132:     try {\n133:       await player.initialize();\n134:       if (!mounted) {\n135:         await player.dispose();\n136:         return;\n137:       }\n138:       setState(() {\n139:         _player = player;\n140:         _activeCamera = clip.cameraId;\n141:       });\n142:       await player.play();\n143:     } on Object catch (error) {\n144:       await player.dispose();\n145:       if (mounted) {\n146:         setState(() => _playError = 'Could not play ${clip.cameraId}');\n147:         // Keep the raw platform detail out of the UI; it stays in debug\n148:         // logs only.\n149:         debugPrint('Host preview playback failed: $error');\n150:       }\n151:     } finally {\n152:       if (mounted) setState(() => _initializing = false);