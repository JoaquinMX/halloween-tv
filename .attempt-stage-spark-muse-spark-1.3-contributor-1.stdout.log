a guest PIN: PIN\n341:   // shape alone must not redeem host access, and client-supplied role\n342:   // strings are ignored (the server assigns \"host\" transactionally).\n343:   if (typeof value.inviteToken !== \"string\" || value.inviteToken.trim() === \"\" || value.inviteToken.length > 256) {\n344:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken is required.\");\n345:   }\n346:   if (JOIN_PIN_RE.test(value.inviteToken)) {\n347:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken must be a host invite, not a guest PIN.\");\n348:   }\n349:   return { partyId, deviceId, channelId, inviteToken: value.inviteToken };\n350: }\n351: \n352: export function parseListHostVideosInput(value: unknown): ListHostVideosInput {\n353:   const identity = requireIdentity(value);\n354:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n355:   return identity;\n356: }\n357: \n358: export function parseGenerateHostVideoInput(value: unknown): GenerateHostVideoInput {\n359:   const identity = requireIdentity(value);\n360:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n361:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n362:   const seedId = validateId(value.seedId, \"seedId\");\n363:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n364:   // Fixed-preset queue only: same lock as requestGeneration (cheap_demo or\n365:   // cameo_demo with its consent binding); caller overrides are rejected.\n366:   if (value.presetId !== undefined &&\n367:       value.presetId !== CHEAP_DEMO_PRESET.presetId &&\n368:       value.presetId !== CAMEO_DEMO_PRESET.presetId) {\n369:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the fixed generation presets are supported.\");\n370:   }\n371:   const presetId = (value.presetId ?? CHEAP_DEMO_PRESET.presetId) as GenerateHostVideoInput[\"presetId\"];\n372:   if (presetId === CAMEO_DEMO_PRESET.presetId) {\n373:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n374:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n375:     }\n376:     validateId(value.guestMediaId, \"guestMediaId\");\n377:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n378:   }\n379:   if (value.guestMediaId !== undefined) {\n380:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n381:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n382:     }\n383:     validateId(value.guestMediaId, \"guestMediaId\");\n384:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n385:   }\n386:   return { ...identity, seedId, idempotencyKey, presetId };\n387: }\n388: \n389: export function parseGetHostVideoPreviewInput(value: unknown): GetHostVideoPreviewInput {\n390:   const identity = requireIdentity(value);\n391:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n392:   if (!isRecord(value) || typeof value.seedId !== \"string\" || !value.seedId) {\n393:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedId is required.\");\n394:   }\n395:   return { ...identity, seedId: validateId(value.seedId, \"seedId\") };\n396: }\n397: \n398: export function parseDeleteHostVideoInput(value: unknown): DeleteHostVideoInput {\n399:   const identity = requireIdentity(value);\n400:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n401:   if (!isRecord(value) || !Array.isArray(value.seedIds) || value.seedIds.length === 0 || value.seedIds.length > 32) {\n402:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedIds must be a non-empty list (max 32).\");\n403:   }\n404:   const seen = new Set<string>();\n405:   const seedIds: string[] = [];\n406:   for (const raw of value.seedIds) {\n407:     const seedId = validateId(raw, \"seedId\");\n408:     if (seen.has(seedId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Duplicate seedId.\");\n409:     seen.add(seedId);\n410:     seedIds.push(seedId);\n411:   }\n412:   return { ...identity, seedIds };\n413: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3275a7729811760b3548d9fa2"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/contracts.ts\"}"},"time":{"start":1793463625518,"end":1793463626463}}}}
