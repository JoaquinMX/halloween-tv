e is always written server-side).\n37:  */\n38: export function createHostJoinService(options: HostJoinServiceOptions): {\n39:   createHostInvite(value: unknown): Promise<CreateHostInviteResult>;\n40:   joinHost(value: unknown): Promise<JoinHostResult>;\n41: } {\n42:   const { db } = options;\n43:   const now = options.now ?? (() => new Date());\n44: \n45:   async function createHostInvite(value: unknown): Promise<CreateHostInviteResult> {\n46:     const input = parseCreateHostInviteInput(value);\n47:     const tv = await assertRegisteredTvDevice(db, input);\n48:     const token = `hi-${randomBytes(24).toString(\"hex\")}`;\n49:     const tokenHash = inviteTokenHash(token);\n50:     const inviteId = tokenHash.slice(0, 32);\n51:     const createdAt = now();\n52:     const expiresAt = new Date(createdAt.getTime() + HOST_INVITE_TTL_MS);\n53:     await inviteRef(db, tv.partyId, inviteId).create({\n54:       inviteId,\n55:       tokenHash,\n56:       partyId: tv.partyId,\n57:       channelId: tv.channelId,\n58:       status: \"pending\",\n59:       createdByDevice: tv.deviceId,\n60:       usedByDevice: null,\n61:       createdAt: FieldValue.serverTimestamp(),\n62:       expiresAt: Timestamp.fromDate(expiresAt),\n63:     });\n64:     return {\n65:       partyId: tv.partyId,\n66:       channelId: tv.channelId,\n67:       inviteToken: token,\n68:       expiresAt: expiresAt.toISOString(),\n69:     };\n70:   }\n71: \n72:   async function joinHost(value: unknown): Promise<JoinHostResult> {\n73:     const input = parseJoinHostInput(value);\n74:     const tokenHash = inviteTokenHash(input.inviteToken);\n75:     const inviteId = tokenHash.slice(0, 32);\n76:     return db.runTransaction(async (transaction) => {\n77:       const inviteSnap = await transaction.get(inviteRef(db, input.partyId, inviteId));\n78:       if (!inviteSnap.exists) {\n79:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n80:       }\n81:       const invite = inviteSnap.data()!;\n82:       if (\n83:         invite.tokenHash !== tokenHash ||\n84:         invite.partyId !== input.partyId ||\n85:         invite.channelId !== input.channelId\n86:       ) {\n87:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n88:       }\n89:       const expiresMs =\n90:         invite.expiresAt instanceof Timestamp\n91:           ? invite.expiresAt.toDate().getTime()\n92:           : Date.parse(String(invite.expiresAt));\n93:       if (!Number.isFinite(expiresMs) || expiresMs <= now().getTime()) {\n94:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n95:       }\n96:       // Cross-party / wrong-channel tokens never redeem: the invite doc lives\n97:       // under the party path and binds the channel explicitly.\n98:       const partyRef = db.doc(`parties/${input.partyId}`);\n99:       const channelRef = partyRef.collection(\"channels\").doc(input.channelId);\n100:       const deviceRef = partyRef.collection(\"devices\").doc(input.deviceId);\n101:       const [partySnap, channelSnap, deviceSnap] = await Promise.all([\n102:         transaction.get(partyRef),\n103:         transaction.get(channelRef),\n104:         transaction.get(deviceRef),\n105:       ]);\n106:       if (!partySnap.exists || partySnap.data()?.status !== \"active\") {\n107:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n108:       }\n109:       if (\n110:         !channelSnap.exists ||\n111:         channelSnap.data()?.partyId !== input.partyId ||\n112:         channelSnap.data()?.status !== \"active\" ||\n113:         partySnap.data()?.activeChannelId !== input.channelId\n114:       ) {\n115:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n116:       }\n117:       // Other-device replay: an invite redeemed by one phone cannot admit\n118:       // another phone, even with the same token.\n119:       if (\n120:         typeof invite.usedByDevice === \"string\" &&\n121:         invite.usedByDevice !== input.deviceId\n122:       ) {\n123:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n124:       }\n125:       if (deviceSnap.exists) {\n126:         const device = deviceSnap.data()!;\n127:         if (\n128:           device.partyId !== input.partyId ||\n129:           device.status !== \"active\" ||\n130:           (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n131:         ) {\n132:           throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n133:         }\n134:         // A guest-PIN registration (role guest) or any non-host doc can never\n135:         // be upgraded by re-presenting the invite for a different device, and\n136:         // a client-supplied role string is ignored: the role below is always\n137:         // written server-side.\n138:         if (device.role === \"host\") {\n139:           if (invite.status !== \"redeemed\" || invite.usedByDevice !== input.deviceId) {\n140:             transaction.update(inviteRef(db, input.partyId, inviteId), {\n141:               status: \"redeemed\",\n142:               usedByDevice: input.deviceId,\n143:               redeemedAt: FieldValue.serverTimestamp(),\n144:             });\n145:           }\n146:           return {\n147:             partyId: input.partyId,\n148:             deviceId: input.deviceId,\n149:             channelId: input.channelId,\n150:             role: \"host\" as const,\n151:             status: \"active\" as const,\n152:             created: false,\n153:           };\n154:         }\n155:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n156:       }\n157:       transaction.set(deviceRef, {\n158:         partyId: input.partyId,\n159:         deviceId: input.deviceId,\n160:         role: \"host\",\n161:         status: \"active\",\n162:         registeredAt: FieldValue.serverTimest