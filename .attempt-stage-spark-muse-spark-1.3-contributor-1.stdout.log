{"type":"tool_use","timestamp":1793461698189,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5b64d001m85GaCq4aSznja","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5af9f001jnBwbMYOUOyDQS","type":"tool","id":"call_01a192a5b5ff7411967f0ab5fdffc6ee","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session.dart, lines 1-479\n1: /// Lifecycle-safe anonymous guest session.\n2: ///\n3: /// Joins ONLY on a valid scoped manifest response from the\n4: /// [ManifestSource]<[PlaybackManifest]> port (contracts layer,\n5: /// `package:channel_api`). This file depends on the port — never on a\n6: /// concrete connection class and never on Firebase.\n7: ///\n8: /// Rules enforced here:\n9: /// - Last-known metadata lives in memory only and is labeled\n10: ///   [GuestSessionStatus.stale] after transient failures or suspension; a\n11: ///   cold offline start surfaces [GuestSessionStatus.unavailable] with no\n12: ///   fabricated manifest.\n13: /// - [leave] (and change-party via [join]) clears identity, metadata, and\n14: ///   timestamps. `FORBIDDEN`/`UNAUTHENTICATED` clears inaccessible data;\n15: ///   `CLIP_EXPIRED` is never labeled current.\n16: /// - Subscriptions are cancelled on leave/dispose/background; [resume]\n17: ///   performs a fresh read. Concurrent [refresh] calls never overlap, and\n18: ///   late responses from superseded sessions (party-switch races) are\n19: ///   ignored via a generation counter.\n20: library;\n21: \n22: import 'dart:async';\n23: import 'dart:developer' as developer;\n24: \n25: import 'package:channel_api/channel_api.dart';\n26: import 'package:companion_app/src/data/manifest_failure.dart';\n27: import 'package:companion_app/src/data/party_join_client.dart';\n28: import 'package:companion_app/src/join/guest_join_data.dart';\n29: import 'package:companion_app/src/session/guest_session_state.dart';\n30: import 'package:core_foundation/core_foundation.dart';\n31: import 'package:core_playlist/core_playlist.dart';\n32: \n33: /// Anonymous guest session bound to one party/device/channel at a time.\n34: final class GuestSession {\n35:   /// Creates a session reading manifests from [source].\n36:   ///\n37:   /// [clock] supplies [GuestSessionState.lastSuccessfulCheck] timestamps so\n38:   /// tests can observe unchanged-version reads deterministically.\n39:   GuestSession({\n40:     required ManifestSource<PlaybackManifest> source,\n41:     required Clock clock,\n42:     PartyJoinClient? joinClient,\n43:   }) : _source = source,\n44:        _clock = clock,\n45:        _joinClient = joinClient;\n46: \n47:   final ManifestSource<PlaybackManifest> _source;\n48:   final Clock _clock;\n49:   final PartyJoinClient? _joinClient;\n50: \n51:   final StreamController<GuestSessionState> _states =\n52:       StreamController<GuestSessionState>.broadcast();\n53: \n54:   GuestSessionState _state = const GuestSessionState.idle();\n55: \n56:   /// Current immutable snapshot.\n57:   GuestSessionState get state => _state;\n58: \n59:   /// Broadcast of state snapshots.\n60:   Stream<GuestSessionState> get states => _states.stream;\n61: \n62:   /// Bound identity, or `null` when idle.\n63:   GuestJoinData? get joinData => _state.join;\n64: \n65:   /// Current or last-known manifest, or `null` when none is retained.\n66:   PlaybackManifest? get manifest => _state.manifest;\n67: \n68:   StreamSubscription<PlaybackManifest>? _subscription;\n69: \n70:   /// Generation counter: incremented on every [join], [leave], [suspend],\n71:   /// [resume], and [dispose] so late events from a superseded subscription\n72:   /// can never mutate the new session.\n73:   int _generation = 0;\n74: \n75:   /// Guards [refresh] (and [resume] reads) against overlap.\n76:   bool _refreshing = false;\n77:   bool _registered = false;\n78:   bool _disposed = false;\n79: \n80:   void _emit(GuestSessionState next) {\n81:     _state = next;\n82:     if (!_states.isClosed) {\n83:       _states.add(next);\n84:     }\n85:   }\n86: \n87:   Future<void> _cancelSubscription() async {\n88:     final StreamSubscription<PlaybackManifest>? sub = _subscription;\n89:     _subscription = null;\n90:     if (sub != null) {\n91:       await sub.cancel();\n92:     }\n93:   }\n94: \n95:   /// Joins as [data], replacing any previous session.\n96:   ///\n97:   /// A previous identity (change-party) is fully cleared before the new\n98:   /// loading state is emitted, so a party switch never leaks the old\n99:   /// party's metadata. Late responses from the superseded subscription are\n100:   /// ignored. The join completes (as ready/denied/expired/unavailable/\n101:   /// invalid-data) only when the [ManifestSource] port responds.\n102:   Future<void> join(GuestJoinData data) async {\n103:     if (_disposed) {\n104:       return;\n105:     }\n106:     _generation++;\n107:     final int generation = _generation;\n108:     await _cancelSubscription();\n109:     if (generation != _generation || _disposed) {\n110:       return;\n111:     }\n112:     _refreshing = false;\n113:     _registered = false;\n114:     _emit(\n115:       GuestSessionState(\n116:         status: GuestSessionStatus.loading,\n117:         join: data,\n118:         message: 'Joining ${data.partyId.value}/${data.channelId}',\n119:       ),\n120:     );\n121:     final PartyJoinClient? client = _joinClient;\n122:     if (client != null) {\n123:       try {\n124:         await client.register(\n125:           partyId: data.partyId.value,\n126:           deviceId: data.deviceId.value,\n127:           channelId: data.channelId,\n128:           joinPin: data.joinPin,\n129:         );\n130:       } on Object catch (error) {\n131:         if (generation == _generation && !_disposed) {\n132:           _handleError(error, generation);\n133:         }\n134:         return;\n135:       }\n136:       if (generation != _generation || _disposed) return;\n137:       _registered = true;\n138:     }\n139:     _subscribe(data, generation);\n140:   }\n141: \n142:   void _subscribe(GuestJoinData data, int generation) {\n143:     late final Stream<PlaybackManifest> stream;\n144:     try {\n145:       stream = _source.watchCurrent(\n146:         partyId: data.partyId.value,\n147:         channelId: data.channelId,\n148:       );\n149:     } on Object catch (error) {\n150:       if (generation == _generation) {\n151:         _handleError(error, generation);\n152:       }\n153:       return;\n154:     }\n155:     _subscription = stream.listen(\n156:       (PlaybackManifest manifest) {\n157:         if (generation == _generation) {\n158:           _handleManifest(manifest, generation);\n159:         }\n160:       },\n161:       onError: (Object error) {\n162:         if (generation == _generation) {\n163:           _handleError(error, generation);\n164:         }\n165:       },\n166:       onDone: () {\n167:         if (generation != _generation) {\n168:           return;\n169:         }\n170:         // An ended stream without data is only terminal when nothing is\n171:         // retained; otherwise keep showing last-known metadata as stale.\n172:         if (_state.manifest == null &&\n173:             _state.status == GuestSessionStatus.loading) {\n174:           _emit(\n175:             _state.copyWith(\n176:               status: GuestSessionStatus.unavailable,\n177:               message: 'Manifest stream ended without data',\n178:             ),\n179:           );\n180:         }\n181:       },\n182:       cancelOnError: false,\n183:     );\n184:   }\n185: \n186:   void _handleManifest(PlaybackManifest manifest, int generation) {\n187:     if (generation != _generation || _disposed) {\n188:       return;\n189:     }\n190:     final GuestJoinData? bound = _state.join;\n191:     if (bound == null) {\n192:       return;\n193:     }\n194:     // Scope check: the response must belong to the requested party/channel.\n195:     if (manifest.partyId != bound.partyId.value ||\n196:         manifest.channelId != bound.channelId) {\n197:       _emit(\n198:         GuestSessionState(\n199:           status: GuestSessionStatus.invalidData,\n200:           join: bound,\n201:           message:\n202:               'Manifest scope mismatch: requested '\n203:               '${bound.partyId.value}/${bound.channelId} but received '\n204:               '${manifest.partyId}/${manifest.channelId}',\n205:         ),\n206:       );\n207:       return;\n208:     }\n209:     final Result<PlaybackManifest> validated = validateCctvManifest(manifest);\n210:     if (validated is Err<PlaybackManifest>) {\n211:       // Validator detail is app-generated diagnostics, not UI text: the raw\n212:       // reason stays in logs and the UI only gets the fixed message.\n213:       developer.log(\n214:         'GuestSession manifest validation failed: ${validated.message}',\n215:         name: 'companion.guest_session',\n216:       );\n217:       _emit(\n218:         GuestSessionState(\n219:           status: GuestSessionStatus.invalidData,\n220:           join: bound,\n221:           message: 'The manifest data was invalid.',\n222:         ),\n223:       );\n224:       return;\n225:     }\n226:     // Valid scoped manifest — current, even when the version is unchanged.\n227:     // Re-observations of the same version refresh the check timestamp.\n228:     _emit(\n229:       GuestSessionState(\n230:         status: GuestSessionStatus.ready,\n231:         join: bound,\n232:         manifest: manifest,\n233:         lastSuccessfulCheck: _clock.now(),\n234:       ),\n235:     );\n236:   }\n237: \n238:   /// Classifies stream errors structurally and maps them to statuses.\n239:   ///\n240:   /// Classification is structural only: [ManifestFailure.classify] unwraps\n241:   /// transport cause chains and reads the backend `details.errorCode`\n242:   /// contract codes (plus SDK codes and typed schema/scope/format errors).\n243:   /// There is deliberately NO substring matching on `error.toString()`:\n244:   /// raw SDK/backend text never reaches [GuestSessionState.message] — it\n245:   /// stays in logs only, and the UI renders fixed [ManifestFailure] text.\n246:   ///\n247:   /// Kind mapping: `FORBIDDEN`/`UNAUTHENTICATED` clear inaccessible data as\n248:   /// [GuestSessionStatus.denied]; `CLIP_EXPIRED` is never labeled current\n249:   /// ([GuestSessionStatus.expired]); `MANIFEST_MISMATCH` and other malformed\n250:   /// payloads surface as [GuestSessionStatus.invalidData] (retryable false);\n251:   /// `NOT_FOUND` surfaces the no-manifest state (cold: unavailable,\n252:   /// retained: stale); transport/unavailable/timeout failures retain\n253:   /// last-known metadata as stale, or report unavailable on a cold start.\n254:   void _handleError(Object error, int generation) {\n255:     if (generation != _generation || _disposed) {\n256:       return;\n257:     }\n258:     final GuestJoinData? bound = _state.join;\n259:     if (bound == null) {\n260:       return;\n261:     }\n262:     developer.log(\n263:       'GuestSession stream error: $error',\n264:       name: 'companion.guest_session',\n265:     );\n266:     final ManifestFailure failure = ManifestFailure.classify(error);\n267:     switch (failure.kind) {\n268:       case ManifestFailureKind.forbidden:\n269:       case ManifestFailureKind.unauthenticated:\n270:         // Inaccessible data is cleared; the binding is kept so the UI can\n271:         // explain which party was rejected.\n272:         _emit(\n273:           GuestSessionState(\n274:             status: GuestSessionStatus.denied,\n275:             join: bound,\n276:             message: failure.message,\n277:           ),\n278:         );\n279:         return;\n280:       case ManifestFailureKind.expired:\n281:         // Expiry is never labeled current: drop any retained metadata.\n282:         _emit(\n283:           GuestSessionState(\n284:             status: GuestSessionStatus.expired,\n285:             join: bound,\n286:             message: failure.message,\n287:           ),\n288:         );\n289:         return;\n290:       case ManifestFailureKind.malformed:\n291:       case ManifestFailureKind.invalidArgument:\n292:       case ManifestFailureKind.configuration:\n293:         _emit(\n294:           GuestSessionState(\n295:             status: GuestSessionStatus.invalidData,\n296:             join: bound,\n297:             message: failure.message,\n298:           ),\n299:         );\n300:         return;\n301:       case ManifestFailureKind.notFound:\n302:       case ManifestFailureKind.unavailable:\n303:       case ManifestFailureKind.transport:\n304:       case ManifestFailureKind.timeout:\n305:         break;\n306:     }\n307:     // No-manifest and transient failures: retain last-known metadata as\n308:     // stale, or report unavailable on a cold start with nothing retained.\n309:     final PlaybackManifest? retained = _state.manifest;\n310:     if (retained != null) {\n311:       _emit(\n312:         GuestSessionState(\n313:           status: GuestSessionStatus.stale,\n314:           join: bound,\n315:           manifest: retained,\n316:           message: failure.message,\n317:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n318:         ),\n319:       );\n320:       return;\n321:     }\n322:     _emit(\n323:       GuestSessionState(\n324:         status: GuestSessionStatus.unavailable,\n325:         join: bound,\n326:         message: failure.message,\n327:       ),\n328:     );\n329:   }\n330: \n331:   /// Re-reads the current manifest without overlapping in-flight refreshes.\n332:   ///\n333:   /// Concurrent calls while a refresh is already running are ignored.\n334:   Future<void> refresh() async {\n335:     if (_disposed || _refreshing) {\n336:       return;\n337:     }\n338:     final GuestJoinData? bound = _state.join;\n339:     if (bound == null) {\n340:       return;\n341:     }\n342:     if (_joinClient != null && !_registered) {\n343:       await join(bound);\n344:       return;\n345:     }\n346:     _refreshing = true;\n347:     _generation++;\n348:     final int generation = _generation;\n349:     try {\n350:       await _cancelSubscription();\n351:       if (generation != _generation || _disposed) {\n352:         return;\n353:       }\n354:       final PlaybackManifest? retained = _state.manifest;\n355:       _emit(\n356:         GuestSessionState(\n357:           status: GuestSessionStatus.loading,\n358:           join: bound,\n359:           manifest: retained,\n360:           message: 'Refreshing ${bound.partyId.value}/${bound.channelId}',\n361:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n362:         ),\n363:       );\n364:       _subscribe(bound, generation);\n365:     } finally {\n366:       _refreshing = false;\n367:     }\n368:   }\n369: \n370:   /// Suspends the session for backgrounding: cancels the subscription and\n371:   /// labels retained metadata stale. A session with no retained manifest\n372:   /// keeps its join binding (including while still loading, so a\n373:   /// backgrounded cold start re-subscribes on resume instead of resetting\n374:   /// to idle and discarding the typed identifiers).\n375:   Future<void> suspend() async {\n376:     if (_disposed) {\n377:       return;\n378:     }\n379:     _generation++;\n380:     await _cancelSubscription();\n381:     _refreshing = false;\n382:     final GuestJoinData? bound = _state.join;\n383:     if (bound == null) {\n384:       return;\n385:     }\n386:     final PlaybackManifest? retained = _state.manifest;\n387:     if (retained != null) {\n388:       _emit(\n389:         GuestSessionState(\n390:           status: GuestSessionStatus.stale,\n391:           join: bound,\n392:           manifest: retained,\n393:           message: 'Suspended; showing last-known data',\n394:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n395:         ),\n396:       );\n397:       return;\n398:     }\n399:     if (_state.status == GuestSessionStatus.loading) {\n400:       _emit(\n401:         GuestSessionState(\n402:           status: GuestSessionStatus.loading,\n403:           join: bound,\n404:           message: 'Suspended before first manifest; will retry on resume',\n405:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n406:         ),\n407:       );\n408:     }\n409:     // Settled non-loading states without retained metadata (denied,\n410:     // expired, invalid-data, unavailable) keep their binding and message;\n411:     // the subscription is already cancelled above.\n412:   }\n413: \n414:   /// Resumes the session with a fresh read after [suspend].\n415:   ///\n416:   /// No-op when no identity is bound.\n417:   Future<void> resume() async {\n418:     if (_disposed || _refreshing) {\n419:       return;\n420:     }\n421:     final GuestJoinData? bound = _state.join;\n422:     if (bound == null) {\n423:       return;\n424:     }\n425:     if (_joinClient != null && !_registered) {\n426:       await join(bound);\n427:       return;\n428:     }\n429:     // A fresh generation both ignores late events from the suspended\n430:     // subscription and guards against overlapping resume/refresh calls.\n431:     _refreshing = true;\n432:     _generation++;\n433:     final int generation = _generation;\n434:     try {\n435:       await _cancelSubscription();\n436:       if (generation != _generation || _disposed) {\n437:         return;\n438:       }\n439:       _emit(\n440:         GuestSessionState(\n441:           status: GuestSessionStatus.loading,\n442:           join: bound,\n443:           manifest: _state.manifest,\n444:           message: 'Resuming ${bound.partyId.value}/${bound.channelId}',\n445:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n446:         ),\n447:       );\n448:       _subscribe(bound, generation);\n449:     } finally {\n450:       _refreshing = false;\n451:     }\n452:   }\n453: \n454:   /// Leaves the party: cancels the subscription and clears identity,\n455:   /// metadata, and timestamps.\n456:   Future<void> leave() async {\n457:     _generation++;\n458:     await _cancelSubscription();\n459:     _refreshing = false;\n460:     _registered = false;\n461:     if (_disposed) {\n462:       return;\n463:     }\n464:     _emit(const GuestSessionState.idle());\n465:   }\n466: \n467:   /// Releases the subscription and the state broadcast.\n468:   Future<void> dispose() async {\n469:     if (_disposed) {\n470:       return;\n471:     }\n472:     _disposed = true;\n473:     _generation++;\n474:     await _cancelSubscription();\n475:     if (!_states.isClosed) {\n476:       await _states.close();\n477:     }\n478:   }\n479: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session.dart, lines 1-479\n1: /// Lifecycle-safe anonymous guest session.\n2: ///\n3: /// Joins ONLY on a valid scoped manifest response from the\n4: /// [ManifestSource]<[PlaybackManifest]> port (contracts layer,\n5: /// `package:channel_api`). This file depends on the port — never on a\n6: /// concrete connection class and never on Firebase.\n7: ///\n8: /// Rules enforced here:\n9: /// - Last-known metadata lives in memory only and is labeled\n10: ///   [GuestSessionStatus.stale] after transient failures or suspension; a\n11: ///   cold offline start surfaces [GuestSessionStatus.unavailable] with no\n12: ///   fabricated manifest.\n13: /// - [leave] (and change-party via [join]) clears identity, metadata, and\n14: ///   timestamps. `FORBIDDEN`/`UNAUTHENTICATED` clears inaccessible data;\n15: ///   `CLIP_EXPIRED` is never labeled current.\n16: /// - Subscriptions are cancelled on leave/dispose/background; [resume]\n17: ///   performs a fresh read. Concurrent [refresh] calls never overlap, and\n18: ///   late responses from superseded sessions (party-switch races) are\n19: ///   ignored via a generation counter.\n20: library;\n21: \n22: import 'dart:async';\n23: import 'dart:developer' as developer;\n24: \n25: import 'package:channel_api/channel_api.dart';\n26: import 'package:companion_app/src/data/manifest_failure.dart';\n27: import 'package:companion_app/src/data/party_join_client.dart';\n28: import 'package:companion_app/src/join/guest_join_data.dart';\n29: import 'package:companion_app/src/session/guest_session_state.dart';\n30: import 'package:core_foundation/core_foundation.dart';\n31: import 'package:core_playlist/core_playlist.dart';\n32: \n33: /// Anonymous guest session bound to one party/device/channel at a time.\n34: final class GuestSession {\n35:   /// Creates a session reading manifests from [source].\n36:   ///\n37:   /// [clock] supplies [GuestSessionState.lastSuccessfulCheck] timestamps so\n38:   /// tests can observe unchanged-version reads deterministically.\n39:   GuestSession({\n40:     required ManifestSource<PlaybackManifest> source,\n41:     required Clock clock,\n42:     PartyJoinClient? joinClient,\n43:   }) : _source = source,\n44:        _clock = clock,\n45:        _joinClient = joinClient;\n46: \n47:   final ManifestSource<PlaybackManifest> _source;\n48:   final Clock _clock;\n49:   final PartyJoinClient? _joinClient;\n50: \n51:   final StreamController<GuestSessionState> _states =\n52:       StreamController<GuestSessionState>.broadcast();\n53: \n54:   GuestSessionState _state = const GuestSessionState.idle();\n55: \n56:   /// Current immutable snapshot.\n57:   GuestSessionState get state => _state;\n58: \n59:   /// Broadcast of state snapshots.\n60:   Stream<GuestSessionState> get states => _states.stream;\n61: \n62:   /// Bound identity, or `null` when idle.\n63:   GuestJoinData? get joinData => _state.join;\n64: \n65:   /// Current or last-known manifest, or `null` when none is retained.\n66:   PlaybackManifest? get manifest => _state.manifest;\n67: \n68:   StreamSubscription<PlaybackManifest>? _subscription;\n69: \n70:   /// Generation counter: incremented on every [join], [leave], [suspend],\n71:   /// [resume], and [dispose] so late events from a superseded subscription\n72:   /// can never mutate the new session.\n73:   int _generation = 0;\n74: \n75:   /// Guards [refresh] (and [resume] reads) against overlap.\n76:   bool _refreshing = false;\n77:   bool _registered = false;\n78:   bool _disposed = false;\n79: \n80:   void _emit(GuestSessionState next) {\n81:     _state = next;\n82:     if (!_states.isClosed) {\n83:       _states.add(next);\n84:     }\n85:   }\n86: \n87:   Future<void> _cancelSubscription() async {\n88:     final StreamSubscription<PlaybackManifest>? sub = _subscription;\n89:     _subscription = null;\n90:     if (sub != null) {\n91:       await sub.cancel();\n92:     }\n93:   }\n94: \n95:   /// Joins as [data], replacing any previous session.\n96:   ///\n97:   /// A previous identity (change-party) is fully cleared before the new\n98:   /// loading state is emitted, so a party switch never leaks the old\n99:   /// party's metadata. Late responses from the superseded subscription are\n100:   /// ignored. The join completes (as ready/denied/expired/unavailable/\n101:   /// invalid-data) only when the [ManifestSource] port responds.\n102:   Future<void> join(GuestJoinData data) async {\n103:     if (_disposed) {\n104:       return;\n105:     }\n106:     _generation++;\n107:     final int generation = _generation;\n108:     await _cancelSubscription();\n109:     if (generation != _generation || _disposed) {\n110:       return;\n111:     }\n112:     _refreshing = false;\n113:     _registered = false;\n114:     _emit(\n115:       GuestSessionState(\n116:         status: GuestSessionStatus.loading,\n117:         join: data,\n118:         message: 'Joining ${data.partyId.value}/${data.channelId}',\n119:       ),\n120:     );\n121:     final PartyJoinClient? client = _joinClient;\n122:     if (client != null) {\n123:       try {\n124:         await client.register(\n125:           partyId: data.partyId.value,\n126:           deviceId: data.deviceId.value,\n127:           channelId: data.channelId,\n128:           joinPin: data.joinPin,\n129:         );\n130:       } on Object catch (error) {\n131:         if (generation == _generation && !_disposed) {\n132:           _handleError(error, generation);\n133:         }\n134:         return;\n135:       }\n136:       if (generation != _generation || _disposed) return;\n137:       _registered = true;\n138:     }\n139:     _subscribe(data, generation);\n140:   }\n141: \n142:   void _subscribe(GuestJoinData data, int generation) {\n143:     late final Stream<PlaybackManifest> stream;\n144:     try {\n145:       stream = _source.watchCurrent(\n146:         partyId: data.partyId.value,\n147:         channelId: data.channelId,\n148:       );\n149:     } on Object catch (error) {\n150:       if (generation == _generation) {\n151:         _handleError(error, generation);\n152:       }\n153:       return;\n154:     }\n155:     _subscription = stream.listen(\n156:       (PlaybackManifest manifest) {\n157:         if (generation == _generation) {\n158:           _handleManifest(manifest, generation);\n159:         }\n160:       },\n161:       onError: (Object error) {\n162:         if (generation == _generation) {\n163:           _handleError(error, generation);\n164:         }\n165:       },\n166:       onDone: () {\n167:         if (generation != _generation) {\n168:           return;\n169:         }\n170:         // An ended stream without data is only terminal when nothing is\n171:         // retained; otherwise keep showing last-known metadata as stale.\n172:         if (_state.manifest == null &&\n173:             _state.status == GuestSessionStatus.loading) {\n174:           _emit(\n175:             _state.copyWith(\n176:               status: GuestSessionStatus.unavailable,\n177:               message: 'Manifest stream ended without data',\n178:             ),\n179:           );\n180:         }\n181:       },\n182:       cancelOnError: false,\n183:     );\n184:   }\n185: \n186:   void _handleManifest(PlaybackManifest manifest, int generation) {\n187:     if (generation != _generation || _disposed) {\n188:       return;\n189:     }\n190:     final GuestJoinData? bound = _state.join;\n191:     if (bound == null) {\n192:       return;\n193:     }\n194:     // Scope check: the response must belong to the requested party/channel.\n195:     if (manifest.partyId != bound.partyId.value ||\n196:         manifest.channelId != bound.channelId) {\n197:       _emit(\n198:         GuestSessionState(\n199:           status: GuestSessionStatus.invalidData,\n200:           join: bound,\n201:           message:\n202:               'Manifest scope mismatch: requested '\n203:               '${bound.partyId.value}/${bound.channelId} but received '\n204:               '${manifest.partyId}/${manifest.channelId}',\n205:         ),\n206:       );\n207:       return;\n208:     }\n209:     final Result<PlaybackManifest> validated = validateCctvManifest(manifest);\n210:     if (validated is Err<PlaybackManifest>) {\n211:       // Validator detail is app-generated diagnostics, not UI text: the raw\n212:       // reason stays in logs and the UI only gets the fixed message.\n213:       developer.log(\n214:         'GuestSession manifest validation failed: ${validated.message}',\n215:         name: 'companion.guest_session',\n216:       );\n217:       _emit(\n218:         GuestSessionState(\n219:           status: GuestSessionStatus.invalidData,\n220:           join: bound,\n221:           message: 'The manifest data was invalid.',\n222:         ),\n223:       );\n224:       return;\n225:     }\n226:     // Valid scoped manifest — current, even when the version is unchanged.\n227:     // Re-observations of the same version refresh the check timestamp.\n228:     _emit(\n229:       GuestSessionState(\n230:         status: GuestSessionStatus.ready,\n231:         join: bound,\n232:         manifest: manifest,\n233:         lastSuccessfulCheck: _clock.now(),\n234:       ),\n235:     );\n236:   }\n237: \n238:   /// Classifies stream errors structurally and maps them to statuses.\n239:   ///\n240:   /// Classification is structural only: [ManifestFailure.classify] unwraps\n241:   /// transport cause chains and reads the backend `details.errorCode`\n242:   /// contract codes (plus SDK codes and typed schema/scope/format errors).\n243:   /// There is deliberately NO substring matching on `error.toString()`:\n244:   /// raw SDK/backend text never reaches [GuestSessionState.message] — it\n245:   /// stays in logs only, and the UI renders fixed [ManifestFailure] text.\n246:   ///\n247:   /// Kind mapping: `FORBIDDEN`/`UNAUTHENTICATED` clear inaccessible data as\n248:   /// [GuestSessionStatus.denied]; `CLIP_EXPIRED` is never labeled current\n249:   /// ([GuestSessionStatus.expired]); `MANIFEST_MISMATCH` and other malformed\n250:   /// payloads surface as [GuestSessionStatus.invalidData] (retryable false);\n251:   /// `NOT_FOUND` surfaces the no-manifest state (cold: unavailable,\n252:   /// retained: stale); transport/unavailable/timeout failures retain\n253:   /// last-known metadata as stale, or report unavailable on a cold start.\n254:   void _handleError(Object error, int generation) {\n255:     if (generation != _generation || _disposed) {\n256:       return;\n257:     }\n258:     final GuestJoinData? bound = _state.join;\n259:     if (bound == null) {\n260:       return;\n261:     }\n262:     developer.log(\n263:       'GuestSession stream error: $error',\n264:       name: 'companion.guest_session',\n265:     );\n266:     final ManifestFailure failure = ManifestFailure.classify(error);\n267:     switch (failure.kind) {\n268:       case ManifestFailureKind.forbidden:\n269:       case ManifestFailureKind.unauthenticated:\n270:         // Inaccessible data is cleared; the binding is kept so the UI can\n271:         // explain which party was rejected.\n272:         _emit(\n273:           GuestSessionState(\n274:             status: GuestSessionStatus.denied,\n275:             join: bound,\n276:             message: failure.message,\n277:           ),\n278:         );\n279:         return;\n280:       case ManifestFailureKind.expired:\n281:         // Expiry is never labeled current: drop any retained metadata.\n282:         _emit(\n283:           GuestSessionState(\n284:             status: GuestSessionStatus.expired,\n285:             join: bound,\n286:             message: failure.message,\n287:           ),\n288:         );\n289:         return;\n290:       case ManifestFailureKind.malformed:\n291:       case ManifestFailureKind.invalidArgument:\n292:       case ManifestFailureKind.configuration:\n293:         _emit(\n294:           GuestSessionState(\n295:             status: GuestSessionStatus.invalidData,\n296:             join: bound,\n297:             message: failure.message,\n298:           ),\n299:         );\n300:         return;\n301:       case ManifestFailureKind.notFound:\n302:       case ManifestFailureKind.unavailable:\n303:       case ManifestFailureKind.transport:\n304:       case ManifestFailureKind.timeout:\n305:         break;\n306:     }\n307:     // No-manifest and transient failures: retain last-known metadata as\n308:     // stale, or report unavailable on a cold start with nothing retained.\n309:     final PlaybackManifest? retained = _state.manifest;\n310:     if (retained != null) {\n311:       _emit(\n312:         GuestSessionState(\n313:           status: GuestSessionStatus.stale,\n314:           join: bound,\n315:           manifest: retained,\n316:           message: failure.message,\n317:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n318:         ),\n319:       );\n320:       return;\n321:     }\n322:     _emit(\n323:       GuestSessionState(\n324:         status: GuestSessionStatus.unavailable,\n325:         join: bound,\n326:         message: failure.message,\n327:       ),\n328:     );\n329:   }\n330: \n331:   /// Re-reads the current manifest without overlapping in-flight refreshes.\n332:   ///\n333:   /// Concurrent calls while a refresh is already running are ignored.\n334:   Future<void> refresh() async {\n335:     if (_disposed || _refreshing) {\n336:       return;\n337:     }\n338:     final GuestJoinData? bound = _state.join;\n339:     if (bound == null) {\n340:       return;\n341:     }\n342:     if (_joinClient != null && !_registered) {\n343:       await join(bound);\n344:       return;\n345:     }\n346:     _refreshing = true;\n347:     _generation++;\n348:     final int generation = _generation;\n349:     try {\n350:       await _cancelSubscription();\n351:       if (generation != _generation || _disposed) {\n352:         return;\n353:       }\n354:       final PlaybackManifest? retained = _state.manifest;\n355:       _emit(\n356:         GuestSessionState(\n357:           status: GuestSessionStatus.loading,\n358:           join: bound,\n359:           manifest: retained,\n360:           message: 'Refreshing ${bound.partyId.value}/${bound.channelId}',\n361:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n362:         ),\n363:       );\n364:       _subscribe(bound, generation);\n365:     } finally {\n366:       _refreshing = false;\n367:     }\n368:   }\n369: \n370:   /// Suspends the session for backgrounding: cancels the subscription and\n371:   /// labels retained metadata stale. A session with no retained manifest\n372:   /// keeps its join binding (including while still loading, so a\n373:   /// backgrounded cold start re-subscribes on resume instead of resetting\n374:   /// to idle and discarding the typed identifiers).\n375:   Future<void> suspend() async {\n376:     if (_disposed) {\n377:       return;\n378:     }\n379:     _generation++;\n380:     await _cancelSubscription();\n381:     _refreshing = false;\n382:     final GuestJoinData? bound = _state.join;\n383:     if (bound == null) {\n384:       return;\n385:     }\n386:     final PlaybackManifest? retained = _state.manifest;\n387:     if (retained != null) {\n388:       _emit(\n389:         GuestSessionState(\n390:           status: GuestSessionStatus.stale,\n391:           join: bound,\n392:           manifest: retained,\n393:           message: 'Suspended; showing last-known data',\n394:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n395:         ),\n396:       );\n397:       return;\n398:     }\n399:     if (_state.status == GuestSessionStatus.loading) {\n400:       _emit(\n401:         GuestSessionState(\n402:           status: GuestSessionStatus.loading,\n403:           join: bound,\n404:           message: 'Suspended before first manifest; will retry on resume',\n405:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n406:         ),\n407:       );\n408:     }\n409:     // Settled non-loading states without retained metadata (denied,\n410:     // expired, invalid-data, unavailable) keep their binding and message;\n411:     // the subscription is already cancelled above.\n412:   }\n413: \n414:   /// Resumes the session with a fresh read after [suspend].\n415:   ///\n416:   /// No-op when no identity is bound.\n417:   Future<void> resume() async {\n418:     if (_disposed || _refreshing) {\n419:       return;\n420:     }\n421:     final GuestJoinData? bound = _state.join;\n422:     if (bound == null) {\n423:       return;\n424:     }\n425:     if (_joinClient != null && !_registered) {\n426:       await join(bound);\n427:       return;\n428:     }\n429:     // A fresh generation both ignores late events from the suspended\n430:     // subscription and guards against overlapping resume/refresh calls.\n431:     _refreshing = true;\n432:     _generation++;\n433:     final int generation = _generation;\n434:     try {\n435:       await _cancelSubscription();\n436:       if (generation != _generation || _disposed) {\n437:         return;\n438:       }\n439:       _emit(\n440:         GuestSessionState(\n441:           status: GuestSessionStatus.loading,\n442:           join: bound,\n443:           manifest: _state.manifest,\n444:           message: 'Resuming ${bound.partyId.value}/${bound.channelId}',\n445:           lastSuccessfulCheck: _state.lastSuccessfulCheck,\n446:         ),\n447:       );\n448:       _subscribe(bound, generation);\n449:     } finally {\n450:       _refreshing = false;\n451:     }\n452:   }\n453: \n454:   /// Leaves the party: cancels the subscription and clears identity,\n455:   /// metadata, and timestamps.\n456:   Future<void> leave() async {\n457:     _generation++;\n458:     await _cancelSubscription();\n459:     _refreshing = false;\n460:     _registered = false;\n461:     if (_disposed) {\n462:       return;\n463:     }\n464:     _emit(const GuestSessionState.idle());\n465:   }\n466: \n467:   /// Releases the subscription and the state broadcast.\n468:   Future<void> dispose() async {\n469:     if (_disposed) {\n470:       return;\n471:     }\n472:     _disposed = true;\n473:     _generation++;\n474:     await _cancelSubscription();\n475:     if (!_states.isClosed) {\n476:       await _states.close();\n477:     }\n478:   }\n479: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5b5ff7411967f0ab5fdffc6ee"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_session.dart\"}"},"time":{"start":1793461696077,"end":1793461698189}}}}
