{"type":"tool_use","timestamp":1793461868639,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a84bea001HJkeYviPO6JfEa","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a84118001uLfk7xPvzAzCXu","type":"tool","id":"call_01a192a847ed70afbcffe6f4cc0dd12d","tool":"write","state":{"status":"completed","input":{"content":"/// Host invite redemption callable used before host administration.\nlibrary;\n\nimport 'dart:async';\n\nimport 'package:cloud_functions/cloud_functions.dart';\nimport 'package:infra_firestore/infra_firestore.dart'\n    show ManifestTransportException;\n\nconst String kJoinHostCallable = 'joinHost';\n\n/// Callable boundary kept separate from the guest `joinParty` boundary.\n///\n/// Guest entry must never register a host payload through `joinParty`, and\n/// host entry must never redeem through it either: the two routes use\n/// disjoint callables, disjoint device identities, and server-assigned\n/// roles (see `backend/functions/src/host_join.ts`).\nabstract interface class HostJoinCallableInvoker {\n  Future<Object?> call(String name, Map<String, Object?> payload);\n}\n\n/// Redeems a host invite and validates the server's scoped host response.\nfinal class HostJoinClient {\n  HostJoinClient({\n    required HostJoinCallableInvoker invoker,\n    this.timeout = const Duration(seconds: 10),\n  }) : _invoker = invoker;\n\n  final HostJoinCallableInvoker _invoker;\n  final Duration timeout;\n\n  Future<void> redeem({\n    required String partyId,\n    required String deviceId,\n    required String channelId,\n    required String inviteToken,\n  }) async {\n    final Map<String, Object?> payload = <String, Object?>{\n      'partyId': partyId,\n      'deviceId': deviceId,\n      'channelId': channelId,\n      'inviteToken': inviteToken,\n    };\n    try {\n      final Object? raw = await _invoker\n          .call(kJoinHostCallable, payload)\n          .timeout(timeout);\n      if (raw is! Map ||\n          raw['partyId'] != partyId ||\n          raw['deviceId'] != deviceId ||\n          raw['channelId'] != channelId ||\n          raw['role'] != 'host' ||\n          raw['status'] != 'active' ||\n          raw['created'] is! bool) {\n        throw const FormatException(\n          'joinHost response did not match the requested host scope',\n        );\n      }\n    } on TimeoutException catch (error) {\n      throw ManifestTransportException('joinHost timed out', error);\n    } on FirebaseFunctionsException catch (error) {\n      throw ManifestTransportException('joinHost callable failed', error);\n    }\n  }\n}\n\n/// SDK-backed joinHost invoker, intentionally unable to make other calls.\nfinal class CallableHostJoinInvoker implements HostJoinCallableInvoker {\n  CallableHostJoinInvoker({required FirebaseFunctions functions})\n    : _functions = functions;\n  final FirebaseFunctions _functions;\n\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\n    if (name != kJoinHostCallable) throw ArgumentError.value(name, 'name');\n    return (await _functions\n            .httpsCallable(kJoinHostCallable)\n            .call<Object?>(payload))\n        .data;\n  }\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/data/host_join_client.dart"},"output":"Created file successfully: apps/companion_app/lib/src/data/host_join_client.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/companion_app/lib/src/data/host_join_client.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a847ed70afbcffe6f4cc0dd12d"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Host invite redemption callable used before host administration.\\nlibrary;\\n\\nimport 'dart:async';\\n\\nimport 'package:cloud_functions/cloud_functions.dart';\\nimport 'package:infra_firestore/infra_firestore.dart'\\n    show ManifestTransportException;\\n\\nconst String kJoinHostCallable = 'joinHost';\\n\\n/// Callable boundary kept separate from the guest `joinParty` boundary.\\n///\\n/// Guest entry must never register a host payload through `joinParty`, and\\n/// host entry must never redeem through it either: the two routes use\\n/// disjoint callables, disjoint device identities, and server-assigned\\n/// roles (see `backend/functions/src/host_join.ts`).\\nabstract interface class HostJoinCallableInvoker {\\n  Future<Object?> call(String name, Map<String, Object?> payload);\\n}\\n\\n/// Redeems a host invite and validates the server's scoped host response.\\nfinal class HostJoinClient {\\n  HostJoinClient({\\n    required HostJoinCallableInvoker invoker,\\n    this.timeout = const Duration(seconds: 10),\\n  }) : _invoker = invoker;\\n\\n  final HostJoinCallableInvoker _invoker;\\n  final Duration timeout;\\n\\n  Future<void> redeem({\\n    required String partyId,\\n    required String deviceId,\\n    required String channelId,\\n    required String inviteToken,\\n  }) async {\\n    final Map<String, Object?> payload = <String, Object?>{\\n      'partyId': partyId,\\n      'deviceId': deviceId,\\n      'channelId': channelId,\\n      'inviteToken': inviteToken,\\n    };\\n    try {\\n      final Object? raw = await _invoker\\n          .call(kJoinHostCallable, payload)\\n          .timeout(timeout);\\n      if (raw is! Map ||\\n          raw['partyId'] != partyId ||\\n          raw['deviceId'] != deviceId ||\\n          raw['channelId'] != channelId ||\\n          raw['role'] != 'host' ||\\n          raw['status'] != 'active' ||\\n          raw['created'] is! bool) {\\n        throw const FormatException(\\n          'joinHost response did not match the requested host scope',\\n        );\\n      }\\n    } on TimeoutException catch (error) {\\n      throw ManifestTransportException('joinHost timed out', error);\\n    } on FirebaseFunctionsException catch (error) {\\n      throw ManifestTransportException('joinHost callable failed', error);\\n    }\\n  }\\n}\\n\\n/// SDK-backed joinHost invoker, intentionally unable to make other calls.\\nfinal class CallableHostJoinInvoker implements HostJoinCallableInvoker {\\n  CallableHostJoinInvoker({required FirebaseFunctions functions})\\n    : _functions = functions;\\n  final FirebaseFunctions _functions;\\n\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\\n    if (name != kJoinHostCallable) throw ArgumentError.value(name, 'name');\\n    return (await _functions\\n            .httpsCallable(kJoinHostCallable)\\n            .call<Object?>(payload))\\n        .data;\\n  }\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/data/host_join_client.dart\"}"},"time":{"start":1793461865450,"end":1793461868639}}}}
