{"type":"tool_use","timestamp":1793461694330,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5adb3001MvNC1fcDDkr3pM","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5a668001DepsxbM5C5evgl","type":"tool","id":"call_01a192a5ad607246b8031f87b91f3ae6","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/companion_flow_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/companion_flow_test.dart, lines 1-649\n1: // Companion join -> now-playing widget flow.\n2: //\n3: // Exercises the REAL parser (p3 guest_join_data), session (p3\n4: // GuestSession), and manifest-mapping path (core_playlist cctvSlots /\n5: // resolveCctvLabel / publishedAt). ONLY the callable boundary is\n6: // substituted: a fake of the `ManifestSource<PlaybackManifest>` port\n7: // (never the concrete connection, never Firebase).\n8: //\n9: // No Firebase initialization, no network traffic.\n10: \n11: import 'dart:async';\n12: \n13: import 'package:channel_api/channel_api.dart';\n14: import 'package:cloud_functions/cloud_functions.dart';\n15: import 'package:companion_app/src/companion_app.dart';\n16: import 'package:companion_app/src/config/backend_config.dart';\n17: import 'package:companion_app/src/data/party_join_client.dart';\n18: import 'package:companion_app/src/join/device_identity_store.dart';\n19: import 'package:companion_app/src/ui/connection_status.dart';\n20: import 'package:companion_app/src/ui/join_screen.dart';\n21: import 'package:companion_app/src/ui/now_playing_screen.dart';\n22: import 'package:core_foundation/core_foundation.dart';\n23: import 'package:core_playlist/core_playlist.dart';\n24: import 'package:flutter/material.dart';\n25: import 'package:flutter/services.dart';\n26: import 'package:flutter_test/flutter_test.dart';\n27: import 'package:infra_firestore/infra_firestore.dart'\n28:     show FirebaseManifestCallableInvoker;\n29: import 'package:shared_preferences/shared_preferences.dart';\n30: \n31: /// Port-level fake: substitutes only the callable-boundary source.\n32: final class FakeManifestSource implements ManifestSource<PlaybackManifest> {\n33:   FakeManifestSource();\n34: \n35:   int watchCalls = 0;\n36:   final List<StreamController<PlaybackManifest>> controllers =\n37:       <StreamController<PlaybackManifest>>[];\n38: \n39:   @override\n40:   Stream<PlaybackManifest> watchCurrent({\n41:     required String partyId,\n42:     required String channelId,\n43:   }) {\n44:     watchCalls++;\n45:     final StreamController<PlaybackManifest> controller =\n46:         StreamController<PlaybackManifest>();\n47:     controllers.add(controller);\n48:     return controller.stream;\n49:   }\n50: }\n51: \n52: /// Records live-boot callable traffic in [events] (`register` before\n53: /// `manifest` proves the registration-before-subscription wiring).\n54: ///\n55: /// When [failAfterFirst] is set, the first call serves [document] and later\n56: /// calls throw: the transport treats the first failure as terminal\n57: /// (`maxConsecutiveFailures: 0`), closes its stream, and the whole\n58: /// subscription chain ends on its own — so no poll timer is left pending at\n59: /// teardown (cancelling a chain parked in `await for` never completes).\n60: final class RecordingManifestInvoker\n61:     implements FirebaseManifestCallableInvoker {\n62:   RecordingManifestInvoker(this.events, this.document);\n63: \n64:   final List<String> events;\n65:   final Map<String, Object?> document;\n66:   int calls = 0;\n67:   bool failAfterFirst = false;\n68: \n69:   @override\n70:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n71:     calls++;\n72:     events.add('manifest');\n73:     if (failAfterFirst && calls > 1) {\n74:       throw Exception('scripted post-first callable failure');\n75:     }\n76:     return Map<String, Object?>.of(document);\n77:   }\n78: }\n79: \n80: /// Fake joinParty boundary: echoes the requested scope into a valid guest\n81: /// registration, or throws [failure] to script denial paths.\n82: final class RecordingJoinInvoker implements PartyJoinCallableInvoker {\n83:   RecordingJoinInvoker(this.events);\n84: \n85:   final List<String> events;\n86:   Object? failure;\n87:   int calls = 0;\n88:   Map<String, Object?>? lastPayload;\n89: \n90:   @override\n91:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n92:     calls++;\n93:     events.add('register');\n94:     lastPayload = Map<String, Object?>.of(payload);\n95:     final Object? error = failure;\n96:     if (error != null) {\n97:       throw error;\n98:     }\n99:     return <String, Object?>{\n100:       'partyId': payload['partyId'],\n101:       'deviceId': payload['deviceId'],\n102:       'channelId': payload['channelId'],\n103:       'role': 'guest',\n104:       'status': 'active',\n105:       'created': true,\n106:     };\n107:   }\n108: }\n109: \n110: /// Controllable clock for last-successful-check timestamps.\n111: final class FakeClock implements Clock {\n112:   FakeClock(this.current);\n113: \n114:   DateTime current;\n115: \n116:   @override\n117:   DateTime now() => current;\n118: }\n119: \n120: PlaybackManifest makeManifest({int version = 1, String partyId = 'party-1'}) {\n121:   String sha(String seed) => List.filled(64, seed).join();\n122:   return PlaybackManifest(\n123:     partyId: partyId,\n124:     channelId: 'cctv',\n125:     version: version,\n126:     clips: <ClipDescriptor>[\n127:       for (int i = 1; i <= 4; i++)\n128:         ClipDescriptor(\n129:           id: 'clip-$i',\n130:           cameraId: 'CAM-0$i',\n131:           storageObjectId: 'cctv/cam-0$i.mp4',\n132:           sha256: sha('$i'),\n133:           sizeBytes: 1024,\n134:           duration: const Duration(seconds: 8),\n135:           mimeType: 'video/mp4',\n136:         ),\n137:     ],\n138:     publishedAt: DateTime.utc(2026, 10, 29, 14),\n139:   );\n140: }\n141: \n142: /// Flushes async stream delivery + StreamBuilder rebuilds without\n143: /// pumpAndSettle (spinners schedule endless frames, so fixed pumps only).\n144: Future<void> flush(WidgetTester tester) async {\n145:   for (int i = 0; i < 6; i++) {\n146:     await tester.pump(const Duration(milliseconds: 50));\n147:   }\n148: }\n149: \n150: /// Fixed phone-shaped local identity used by the join form in every flow\n151: /// test (the form persists/generates this through [DeviceIdentityStore]).\n152: const String kFixedDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n153: \n154: Future<void> pumpApp(\n155:   WidgetTester tester,\n156:   FakeManifestSource source,\n157:   FakeClock clock,\n158: ) async {\n159:   SharedPreferences.setMockInitialValues(<String, Object>{\n160:     DeviceIdentityStore.storageKey: kFixedDeviceId,\n161:   });\n162:   await tester.pumpWidget(CompanionApp(manifestSource: source, clock: clock));\n163:   await flush(tester);\n164: }\n165: \n166: /// Scrolls [finder] into view, then enters [text] (the join form scrolls\n167: /// inside the 800x600 test viewport).\n168: Future<void> enterVisible(\n169:   WidgetTester tester,\n170:   Finder finder,\n171:   String text,\n172: ) async {\n173:   await tester.ensureVisible(finder);\n174:   await tester.pump(const Duration(milliseconds: 50));\n175:   await tester.enterText(finder, text);\n176: }\n177: \n178: /// Scrolls [finder] into view, then taps it.\n179: ///\n180: /// [ensureVisible] alone can park a bottom-edge target exactly on the\n181: /// viewport boundary (where hit-testing misses), so a nudge follows — via\n182: /// [ScrollPosition.jumpTo], which never flings and never involves the\n183: /// gesture arena (a test [drag] carries unrealistic velocity whose\n184: /// ballistic flight would swallow the tap instead of pressing the button).\n185: Future<void> tapVisible(WidgetTester tester, Finder finder) async {\n186:   await tester.ensureVisible(finder);\n187:   await tester.pump(const Duration(milliseconds: 50));\n188:   final ScrollableState scrollable = tester.state<ScrollableState>(\n189:     find.byType(Scrollable).first,\n190:   );\n191:   final Rect rect = tester.getRect(finder);\n192:   final double viewHeight =\n193:       tester.view.physicalSize.height / tester.view.devicePixelRatio;\n194:   final double pixels = scrollable.position.pixels;\n195:   final double max = scrollable.position.maxScrollExtent;\n196:   if (rect.bottom > viewHeight - 4.0) {\n197:     final double delta = rect.bottom - viewHeight + 80.0;\n198:     scrollable.position.jumpTo((pixels + delta).clamp(0.0, max).toDouble());\n199:     await tester.pump(const Duration(milliseconds: 50));\n200:   } else if (rect.top < 0.0) {\n201:     scrollable.position.jumpTo(\n202:       (pixels + rect.top - 80.0).clamp(0.0, max).toDouble(),\n203:     );\n204:     await tester.pump(const Duration(milliseconds: 50));\n205:   }\n206:   await tester.tap(finder);\n207: }\n208: \n209: /// True when the current keyboard focus sits inside the widget with [key].\n210: ///\n211: /// Walks up from [FocusManager.primaryFocus]: the [Focus] node owned by a\n212: /// [TextField] or button lives below the keyed widget, so [Focus.of] on the\n213: /// keyed element itself cannot see it.\n214: bool focusIsOn(Key key) {\n215:   final BuildContext? context = FocusManager.instance.primaryFocus?.context;\n216:   if (context == null) {\n217:     return false;\n218:   }\n219:   bool found = false;\n220:   (context as Element).visitAncestorElements((Element ancestor) {\n221:     if (ancestor.widget.key == key) {\n222:       found = true;\n223:       return false;\n224:     }\n225:     return true;\n226:   });\n227:   return found;\n228: }\n229: \n230: Future<void> joinAs(\n231:   WidgetTester tester,\n232:   FakeManifestSource source, {\n233:   String party = 'party-1',\n234:   String channel = 'cctv',\n235:   String pin = '',\n236: }) async {\n237:   await enterVisible(tester, find.byKey(JoinScreen.partyFieldKey), party);\n238:   await enterVisible(tester, find.byKey(JoinScreen.channelFieldKey), channel);\n239:   await enterVisible(tester, find.byKey(JoinScreen.pinFieldKey), pin);\n240:   await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n241:   await flush(tester);\n242:   expect(source.watchCalls, 1);\n243: }\n244: \n245: void main() {\n246:   late FakeManifestSource source;\n247:   late FakeClock clock;\n248: \n249:   setUp(() {\n250:     source = FakeManifestSource();\n251:     clock = FakeClock(DateTime.utc(2026, 10, 29, 12));\n252:   });\n253: \n254:   tearDown(() async {\n255:     for (final StreamController<PlaybackManifest> controller\n256:         in source.controllers) {\n257:       if (!controller.isClosed) {\n258:         await controller.close();\n259:       }\n260:     }\n261:   });\n262: \n263:   group('Companion flow', () {\n264:     testWidgets('join renders the published four-camera lineup in wall order', (\n265:       WidgetTester tester,\n266:     ) async {\n267:       await pumpApp(tester, source, clock);\n268:       await joinAs(tester, source);\n269: \n270:       source.controllers.single.add(makeManifest(version: 7));\n271:       await flush(tester);\n272: \n273:       expect(find.text(\"The party's latest published lineup\"), findsOneWidget);\n274:       expect(find.textContaining('Manifest version 7'), findsOneWidget);\n275:       expect(find.textContaining('2026-10-29'), findsWidgets);\n276:       expect(find.textContaining('(UTC)'), findsWidgets);\n277:       expect(find.textContaining('Last successful check'), findsOneWidget);\n278:       expect(find.textContaining('Server publication time'), findsOneWidget);\n279:       // No claim of TV playback sync anywhere on the lineup screen.\n280:       expect(find.textContaining('playback sync'), findsNothing);\n281: \n282:       const List<String> expected = <String>[\n283:         'CAM-01 · hallway',\n284:         'CAM-02 · kitchen',\n285:         'CAM-03 · staircase',\n286:         'CAM-04 · storage room',\n287:       ];\n288:       for (final String label in expected) {\n289:         expect(find.text(label), findsOneWidget);\n290:       }\n291:       final List<double> tops = <double>[\n292:         for (final String label in expected)\n293:           tester.getTopLeft(find.text(label)).dy,\n294:       ];\n295:       for (int i = 0; i + 1 < tops.length; i++) {\n296:         expect(tops[i] < tops[i + 1], isTrue);\n297:       }\n298:       expect(tester.takeException(), isNull);\n299:     });\n300: \n301:     testWidgets('invalid identifiers show inline errors and never join', (\n302:       WidgetTester tester,\n303:     ) async {\n304:       await pumpApp(tester, source, clock);\n305: \n306:       await enterVisible(\n307:         tester,\n308:         find.byKey(JoinScreen.partyFieldKey),\n309:         'party/1',\n310:       );\n311:       await enterVisible(\n312:         tester,\n313:         find.byKey(JoinScreen.channelFieldKey),\n314:         'cctv',\n315:       );\n316:       await enterVisible(tester, find.byKey(JoinScreen.pinFieldKey), '');\n317:       await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n318:       await flush(tester);\n319: \n320:       expect(find.byKey(JoinScreen.errorKey), findsOneWidget);\n321:       expect(source.watchCalls, 0);\n322:       expect(find.byKey(JoinScreen.submitKey), findsOneWidget);\n323:       expect(tester.takeException(), isNull);\n324:     });\n325: \n326:     testWidgets('a pasted join payload joins through the real payload parser', (\n327:       WidgetTester tester,\n328:     ) async {\n329:       await pumpApp(tester, source, clock);\n330: \n331:       await enterVisible(\n332:         tester,\n333:         find.byKey(JoinScreen.payloadFieldKey),\n334:         '{\"partyId\": \"party-1\", \"channelId\": \"cctv\", \"joinPin\": \"004201\", '\n335:         '\"deviceId\": \"evil-device\", \"backend\": \"https://evil.example\", '\n336:         '\"autoSubmit\": true}',\n337:       );\n338:       await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n339:       await flush(tester);\n340: \n341:       expect(source.watchCalls, 1);\n342:       source.controllers.single.add(makeManifest(version: 2));\n343:       await flush(tester);\n344: \n345:       expect(find.textContaining('Manifest version 2'), findsOneWidget);\n346:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n347:       expect(tester.takeException(), isNull);\n348:     });\n349: \n350:     testWidgets('server denial renders the denied state with no lineup', (\n351:       WidgetTester tester,\n352:     ) async {\n353:       await pumpApp(tester, source, clock);\n354:       await joinAs(tester, source);\n355: \n356:       source.controllers.single.addError(\n357:         FirebaseFunctionsException(\n358:           code: 'permission-denied',\n359:           message: 'unregistered party/device secret-party-9',\n360:           details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n361:         ),\n362:       );\n363:       await flush(tester);\n364: \n365:       expect(find.text('Access was denied.'), findsOneWidget);\n366:       expect(find.text('CAM-01 · hallway'), findsNothing);\n367:       expect(find.textContaining('Manifest version'), findsNothing);\n368:       // Raw backend detail never reaches a rendered banner.\n369:       expect(find.textContaining('secret-party-9'), findsNothing);\n370:       expect(tester.takeException(), isNull);\n371:     });\n372: \n373:     testWidgets('malformed data renders the invalid-data state', (\n374:       WidgetTester tester,\n375:     ) async {\n376:       await pumpApp(tester, source, clock);\n377:       await joinAs(tester, source);\n378: \n379:       source.controllers.single.addError(\n380:         const FormatException('bad manifest envelope'),\n381:       );\n382:       await flush(tester);\n383: \n384:       expect(find.text('The lineup data was invalid.'), findsOneWidget);\n385:       expect(find.text('CAM-01 · hallway'), findsNothing);\n386:       expect(tester.takeException(), isNull);\n387:     });\n388: \n389:     testWidgets('stale lineup stays visible and retry recovers', (\n390:       WidgetTester tester,\n391:     ) async {\n392:       await pumpApp(tester, source, clock);\n393:       await joinAs(tester, source);\n394: \n395:       source.controllers.single.add(makeManifest(version: 3));\n396:       await flush(tester);\n397:       expect(find.textContaining('Manifest version 3'), findsOneWidget);\n398: \n399:       source.controllers.single.addError(Exception('socket closed'));\n400:       await flush(tester);\n401: \n402:       // Stale: last-known lineup retained with an explicit stale banner.\n403:       expect(find.textContaining('Manifest version 3'), findsOneWidget);\n404:       expect(\n405:         find.text('Connection lost — showing last-known lineup.'),\n406:         findsOneWidget,\n407:       );\n408: \n409:       final int callsBeforeRetry = source.watchCalls;\n410:       await tapVisible(tester, find.byKey(NowPlayingScreen.retryKey));\n411:       // The session's cancel + re-subscribe needs real event-loop turns\n412:       // here, which fixed pumps alone stall; drain them, then rebuild.\n413:       await tester.runAsync(\n414:         () => Future<void>.delayed(const Duration(milliseconds: 300)),\n415:       );\n416:       await flush(tester);\n417:       expect(source.watchCalls, callsBeforeRetry + 1);\n418:       expect(find.text('Refreshing lineup…'), findsOneWidget);\n419: \n420:       await tester.runAsync(() async {\n421:         source.controllers.last.add(makeManifest(version: 4));\n422:         await Future<void>.delayed(const Duration(milliseconds: 300));\n423:       });\n424:       await flush(tester);\n425:       expect(source.watchCalls, callsBeforeRetry + 1);\n426:       expect(find.textContaining('Manifest version 4'), findsOneWidget);\n427:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n428:       expect(tester.takeException(), isNull);\n429:     });\n430: \n431:     testWidgets('leave resets the flow to the join screen', (\n432:       WidgetTester tester,\n433:     ) async {\n434:       await pumpApp(tester, source, clock);\n435:       await joinAs(tester, source);\n436: \n437:       source.controllers.single.add(makeManifest());\n438:       await flush(tester);\n439:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n440: \n441:       await tapVisible(tester, find.byKey(NowPlayingScreen.leaveKey));\n442:       await tester.runAsync(\n443:         () => Future<void>.delayed(const Duration(milliseconds: 300)),\n444:       );\n445:       await flush(tester);\n446: \n447:       expect(find.byKey(JoinScreen.submitKey), findsOneWidget);\n448:       expect(find.textContaining('organizer'), findsWidgets);\n449:       expect(find.text('CAM-01 · hallway'), findsNothing);\n450:       expect(tester.takeException(), isNull);\n451:     });\n452: \n453:     testWidgets('narrow phone with enlarged text keeps the flow usable and '\n454:         'keyboard-traversable', (WidgetTester tester) async {\n455:       tester.view.physicalSize = const Size(1080, 1920);\n456:       tester.view.devicePixelRatio = 3.0;\n457:       tester.platformDispatcher.textScaleFactorTestValue = 1.4;\n458:       addTearDown(() {\n459:         tester.view.resetPhysicalSize();\n460:         tester.view.resetDevicePixelRatio();\n461:         tester.platformDispatcher.clearAllTestValues();\n462:       });\n463: \n464:       await pumpApp(tester, source, clock);\n465: \n466:       // Keyboard traversal: touch-focus the first field, then Tab moves\n467:       // focus through the manual fields in order, proving keyboard-only\n468:       // guests can reach every input and the Join button.\n469:       await tapVisible(tester, find.byKey(JoinScreen.partyFieldKey));\n470:       await flush(tester);\n471:       expect(focusIsOn(JoinScreen.partyFieldKey), isTrue);\n472:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n473:       await flush(tester);\n474:       expect(focusIsOn(JoinScreen.channelFieldKey), isTrue);\n475:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n476:       await flush(tester);\n477:       expect(focusIsOn(JoinScreen.pinFieldKey), isTrue);\n478:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n479:       await flush(tester);\n480:       expect(focusIsOn(JoinScreen.payloadFieldKey), isTrue);\n481:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n482:       await flush(tester);\n483:       expect(focusIsOn(JoinScreen.scanKey), isTrue);\n484:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n485:       await flush(tester);\n486:       expect(focusIsOn(JoinScreen.submitKey), isTrue);\n487: \n488:       await joinAs(tester, source);\n489:       source.controllers.single.add(makeManifest(version: 5));\n490:       await flush(tester);\n491: \n492:       expect(find.textContaining('Manifest version 5'), findsOneWidget);\n493:       expect(find.byKey(NowPlayingScreen.refreshKey), findsOneWidget);\n494:       expect(find.byKey(NowPlayingScreen.leaveKey), findsOneWidget);\n495:       expect(tester.takeException(), isNull);\n496:     });\n497: \n498:     testWidgets('desktop width renders the full lineup without overflow', (\n499:       WidgetTester tester,\n500:     ) async {\n501:       tester.view.physicalSize = const Size(1280, 800);\n502:       tester.view.devicePixelRatio = 1.0;\n503:       addTearDown(() {\n504:         tester.view.resetPhysicalSize();\n505:         tester.view.resetDevicePixelRatio();\n506:       });\n507: \n508:       await pumpApp(tester, source, clock);\n509:       await joinAs(tester, source);\n510:       source.controllers.single.add(makeManifest(version: 6));\n511:       await flush(tester);\n512: \n513:       expect(find.textContaining('Manifest version 6'), findsOneWidget);\n514:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n515:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n516:       expect(find.text('CAM-03 · staircase'), findsOneWidget);\n517:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n518:       expect(find.byKey(const Key('camera-CAM-01')), findsOneWidget);\n519:       expect(find.byKey(ConnectionStatus.retryKey), findsNothing);\n520:       expect(tester.takeException(), isNull);\n521:     });\n522:   });\n523: \n524:   group('Companion live-boot flow (config + invoker overrides)', () {\n525:     late FakeClock liveClock;\n526:     late List<String> events;\n527:     late RecordingManifestInvoker manifestInvoker;\n528:     late RecordingJoinInvoker joinInvoker;\n529: \n530:     Map<String, Object?> liveManifestDoc() {\n531:       String sha(String seed) => List.filled(64, seed).join();\n532:       return <String, Object?>{\n533:         'partyId': 'party-1',\n534:         'channelId': 'cctv',\n535:         'version': 1,\n536:         'schemaVersion': 1,\n537:         'jobId': 'job-1',\n538:         'cameraClips': <Object?>[\n539:           for (int i = 1; i <= 4; i++)\n540:             <String, Object?>{\n541:               'cameraId': 'CAM-0$i',\n542:               'durationMs': 2000,\n543:               'expiresAt': '2030-01-01T00:00:00.000Z',\n544:               'objectPath':\n545:                   'parties/party-1/channels/cctv/delivery/1/CAM-0$i.mp4',\n546:               'sha256': sha('$i'),\n547:               'sizeBytes': 1024 + i,\n548:             },\n549:         ],\n550:         'createdAt': '2026-10-29T14:00:00.000Z',\n551:         'expiresAt': '2030-01-01T00:00:00.000Z',\n552:       };\n553:     }\n554: \n555:     Future<void> pumpLiveApp(WidgetTester tester) async {\n556:       SharedPreferences.setMockInitialValues(<String, Object>{\n557:         DeviceIdentityStore.storageKey: kFixedDeviceId,\n558:       });\n559:       await tester.pumpWidget(\n560:         CompanionApp(\n561:           config: BackendConfig.parse(<String, Object?>{\n562:             'apiKey': 'test-api-key',\n563:             'appId': '1:123:android:abc',\n564:             'projectId': 'test-project',\n565:           }),\n566:           firebaseBootstrap: (_) async {},\n567:           invokerOverride: manifestInvoker,\n568:           partyJoinInvokerOverride: joinInvoker,\n569:           clock: liveClock,\n570:         ),\n571:       );\n572:       await flush(tester);\n573:     }\n574: \n575:     Future<void> joinLive(WidgetTester tester) async {\n576:       await enterVisible(\n577:         tester,\n578:         find.byKey(JoinScreen.partyFieldKey),\n579:         'party-1',\n580:       );\n581:       await enterVisible(\n582:         tester,\n583:         find.byKey(JoinScreen.channelFieldKey),\n584:         'cctv',\n585:       );\n586:       await enterVisible(tester, find.byKey(JoinScreen.pinFieldKey), '');\n587:       await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n588:       await flush(tester);\n589:     }\n590: \n591:     setUp(() {\n592:       liveClock = FakeClock(DateTime.utc(2026, 10, 29, 12));\n593:       events = <String>[];\n594:       manifestInvoker = RecordingManifestInvoker(events, liveManifestDoc());\n595:       joinInvoker = RecordingJoinInvoker(events);\n596:     });\n597: \n598:     testWidgets('registration precedes the manifest subscription', (\n599:       WidgetTester tester,\n600:     ) async {\n601:       manifestInvoker.failAfterFirst = true;\n602:       await pumpLiveApp(tester);\n603:       await joinLive(tester);\n604: \n605:       expect(joinInvoker.calls, 1);\n606:       expect(joinInvoker.lastPayload, <String, Object?>{\n607:         'partyId': 'party-1',\n608:         'deviceId': kFixedDeviceId,\n609:         'channelId': 'cctv',\n610:       });\n611:       expect(manifestInvoker.calls, 1);\n612:       // Registration is wired before the first manifest read.\n613:       expect(events, <String>['register', 'manifest']);\n614: \n615:       await flush(tester);\n616:       expect(find.textContaining('Manifest version 1'), findsOneWidget);\n617:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n618: \n619:       // Let the next poll fail: the transport closes its stream on the\n620:       // first failure, so the subscription ends on its own with the\n621:       // last-known lineup retained and no poll timer pending at teardown.\n622:       await tester.pump(const Duration(seconds: 31));\n623:       await flush(tester);\n624:       expect(manifestInvoker.calls, 2);\n625:       expect(find.textContaining('Manifest version 1'), findsOneWidget);\n626:       expect(tester.takeException(), isNull);\n627:     });\n628: \n629:     testWidgets('a FORBIDDEN registration surfaces the denied state', (\n630:       WidgetTester tester,\n631:     ) async {\n632:       joinInvoker.failure = FirebaseFunctionsException(\n633:         code: 'permission-denied',\n634:         message: 'unregistered party/device secret-party-9',\n635:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n636:       );\n637:       await pumpLiveApp(tester);\n638:       await joinLive(tester);\n639: \n640:       expect(joinInvoker.calls, 1);\n641:       expect(manifestInvoker.calls, 0);\n642:       expect(find.text('Access was denied.'), findsOneWidget);\n643:       expect(find.text('CAM-01 · hallway'), findsNothing);\n644:       // Raw backend detail never reaches a rendered banner.\n645:       expect(find.textContaining('secret-party-9'), findsNothing);\n646:       expect(tester.takeException(), isNull);\n647:     });\n648:   });\n649: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/companion_flow_test.dart, lines 1-649\n1: // Companion join -> now-playing widget flow.\n2: //\n3: // Exercises the REAL parser (p3 guest_join_data), session (p3\n4: // GuestSession), and manifest-mapping path (core_playlist cctvSlots /\n5: // resolveCctvLabel / publishedAt). ONLY the callable boundary is\n6: // substituted: a fake of the `ManifestSource<PlaybackManifest>` port\n7: // (never the concrete connection, never Firebase).\n8: //\n9: // No Firebase initialization, no network traffic.\n10: \n11: import 'dart:async';\n12: \n13: import 'package:channel_api/channel_api.dart';\n14: import 'package:cloud_functions/cloud_functions.dart';\n15: import 'package:companion_app/src/companion_app.dart';\n16: import 'package:companion_app/src/config/backend_config.dart';\n17: import 'package:companion_app/src/data/party_join_client.dart';\n18: import 'package:companion_app/src/join/device_identity_store.dart';\n19: import 'package:companion_app/src/ui/connection_status.dart';\n20: import 'package:companion_app/src/ui/join_screen.dart';\n21: import 'package:companion_app/src/ui/now_playing_screen.dart';\n22: import 'package:core_foundation/core_foundation.dart';\n23: import 'package:core_playlist/core_playlist.dart';\n24: import 'package:flutter/material.dart';\n25: import 'package:flutter/services.dart';\n26: import 'package:flutter_test/flutter_test.dart';\n27: import 'package:infra_firestore/infra_firestore.dart'\n28:     show FirebaseManifestCallableInvoker;\n29: import 'package:shared_preferences/shared_preferences.dart';\n30: \n31: /// Port-level fake: substitutes only the callable-boundary source.\n32: final class FakeManifestSource implements ManifestSource<PlaybackManifest> {\n33:   FakeManifestSource();\n34: \n35:   int watchCalls = 0;\n36:   final List<StreamController<PlaybackManifest>> controllers =\n37:       <StreamController<PlaybackManifest>>[];\n38: \n39:   @override\n40:   Stream<PlaybackManifest> watchCurrent({\n41:     required String partyId,\n42:     required String channelId,\n43:   }) {\n44:     watchCalls++;\n45:     final StreamController<PlaybackManifest> controller =\n46:         StreamController<PlaybackManifest>();\n47:     controllers.add(controller);\n48:     return controller.stream;\n49:   }\n50: }\n51: \n52: /// Records live-boot callable traffic in [events] (`register` before\n53: /// `manifest` proves the registration-before-subscription wiring).\n54: ///\n55: /// When [failAfterFirst] is set, the first call serves [document] and later\n56: /// calls throw: the transport treats the first failure as terminal\n57: /// (`maxConsecutiveFailures: 0`), closes its stream, and the whole\n58: /// subscription chain ends on its own — so no poll timer is left pending at\n59: /// teardown (cancelling a chain parked in `await for` never completes).\n60: final class RecordingManifestInvoker\n61:     implements FirebaseManifestCallableInvoker {\n62:   RecordingManifestInvoker(this.events, this.document);\n63: \n64:   final List<String> events;\n65:   final Map<String, Object?> document;\n66:   int calls = 0;\n67:   bool failAfterFirst = false;\n68: \n69:   @override\n70:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n71:     calls++;\n72:     events.add('manifest');\n73:     if (failAfterFirst && calls > 1) {\n74:       throw Exception('scripted post-first callable failure');\n75:     }\n76:     return Map<String, Object?>.of(document);\n77:   }\n78: }\n79: \n80: /// Fake joinParty boundary: echoes the requested scope into a valid guest\n81: /// registration, or throws [failure] to script denial paths.\n82: final class RecordingJoinInvoker implements PartyJoinCallableInvoker {\n83:   RecordingJoinInvoker(this.events);\n84: \n85:   final List<String> events;\n86:   Object? failure;\n87:   int calls = 0;\n88:   Map<String, Object?>? lastPayload;\n89: \n90:   @override\n91:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n92:     calls++;\n93:     events.add('register');\n94:     lastPayload = Map<String, Object?>.of(payload);\n95:     final Object? error = failure;\n96:     if (error != null) {\n97:       throw error;\n98:     }\n99:     return <String, Object?>{\n100:       'partyId': payload['partyId'],\n101:       'deviceId': payload['deviceId'],\n102:       'channelId': payload['channelId'],\n103:       'role': 'guest',\n104:       'status': 'active',\n105:       'created': true,\n106:     };\n107:   }\n108: }\n109: \n110: /// Controllable clock for last-successful-check timestamps.\n111: final class FakeClock implements Clock {\n112:   FakeClock(this.current);\n113: \n114:   DateTime current;\n115: \n116:   @override\n117:   DateTime now() => current;\n118: }\n119: \n120: PlaybackManifest makeManifest({int version = 1, String partyId = 'party-1'}) {\n121:   String sha(String seed) => List.filled(64, seed).join();\n122:   return PlaybackManifest(\n123:     partyId: partyId,\n124:     channelId: 'cctv',\n125:     version: version,\n126:     clips: <ClipDescriptor>[\n127:       for (int i = 1; i <= 4; i++)\n128:         ClipDescriptor(\n129:           id: 'clip-$i',\n130:           cameraId: 'CAM-0$i',\n131:           storageObjectId: 'cctv/cam-0$i.mp4',\n132:           sha256: sha('$i'),\n133:           sizeBytes: 1024,\n134:           duration: const Duration(seconds: 8),\n135:           mimeType: 'video/mp4',\n136:         ),\n137:     ],\n138:     publishedAt: DateTime.utc(2026, 10, 29, 14),\n139:   );\n140: }\n141: \n142: /// Flushes async stream delivery + StreamBuilder rebuilds without\n143: /// pumpAndSettle (spinners schedule endless frames, so fixed pumps only).\n144: Future<void> flush(WidgetTester tester) async {\n145:   for (int i = 0; i < 6; i++) {\n146:     await tester.pump(const Duration(milliseconds: 50));\n147:   }\n148: }\n149: \n150: /// Fixed phone-shaped local identity used by the join form in every flow\n151: /// test (the form persists/generates this through [DeviceIdentityStore]).\n152: const String kFixedDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n153: \n154: Future<void> pumpApp(\n155:   WidgetTester tester,\n156:   FakeManifestSource source,\n157:   FakeClock clock,\n158: ) async {\n159:   SharedPreferences.setMockInitialValues(<String, Object>{\n160:     DeviceIdentityStore.storageKey: kFixedDeviceId,\n161:   });\n162:   await tester.pumpWidget(CompanionApp(manifestSource: source, clock: clock));\n163:   await flush(tester);\n164: }\n165: \n166: /// Scrolls [finder] into view, then enters [text] (the join form scrolls\n167: /// inside the 800x600 test viewport).\n168: Future<void> enterVisible(\n169:   WidgetTester tester,\n170:   Finder finder,\n171:   String text,\n172: ) async {\n173:   await tester.ensureVisible(finder);\n174:   await tester.pump(const Duration(milliseconds: 50));\n175:   await tester.enterText(finder, text);\n176: }\n177: \n178: /// Scrolls [finder] into view, then taps it.\n179: ///\n180: /// [ensureVisible] alone can park a bottom-edge target exactly on the\n181: /// viewport boundary (where hit-testing misses), so a nudge follows — via\n182: /// [ScrollPosition.jumpTo], which never flings and never involves the\n183: /// gesture arena (a test [drag] carries unrealistic velocity whose\n184: /// ballistic flight would swallow the tap instead of pressing the button).\n185: Future<void> tapVisible(WidgetTester tester, Finder finder) async {\n186:   await tester.ensureVisible(finder);\n187:   await tester.pump(const Duration(milliseconds: 50));\n188:   final ScrollableState scrollable = tester.state<ScrollableState>(\n189:     find.byType(Scrollable).first,\n190:   );\n191:   final Rect rect = tester.getRect(finder);\n192:   final double viewHeight =\n193:       tester.view.physicalSize.height / tester.view.devicePixelRatio;\n194:   final double pixels = scrollable.position.pixels;\n195:   final double max = scrollable.position.maxScrollExtent;\n196:   if (rect.bottom > viewHeight - 4.0) {\n197:     final double delta = rect.bottom - viewHeight + 80.0;\n198:     scrollable.position.jumpTo((pixels + delta).clamp(0.0, max).toDouble());\n199:     await tester.pump(const Duration(milliseconds: 50));\n200:   } else if (rect.top < 0.0) {\n201:     scrollable.position.jumpTo(\n202:       (pixels + rect.top - 80.0).clamp(0.0, max).toDouble(),\n203:     );\n204:     await tester.pump(const Duration(milliseconds: 50));\n205:   }\n206:   await tester.tap(finder);\n207: }\n208: \n209: /// True when the current keyboard focus sits inside the widget with [key].\n210: ///\n211: /// Walks up from [FocusManager.primaryFocus]: the [Focus] node owned by a\n212: /// [TextField] or button lives below the keyed widget, so [Focus.of] on the\n213: /// keyed element itself cannot see it.\n214: bool focusIsOn(Key key) {\n215:   final BuildContext? context = FocusManager.instance.primaryFocus?.context;\n216:   if (context == null) {\n217:     return false;\n218:   }\n219:   bool found = false;\n220:   (context as Element).visitAncestorElements((Element ancestor) {\n221:     if (ancestor.widget.key == key) {\n222:       found = true;\n223:       return false;\n224:     }\n225:     return true;\n226:   });\n227:   return found;\n228: }\n229: \n230: Future<void> joinAs(\n231:   WidgetTester tester,\n232:   FakeManifestSource source, {\n233:   String party = 'party-1',\n234:   String channel = 'cctv',\n235:   String pin = '',\n236: }) async {\n237:   await enterVisible(tester, find.byKey(JoinScreen.partyFieldKey), party);\n238:   await enterVisible(tester, find.byKey(JoinScreen.channelFieldKey), channel);\n239:   await enterVisible(tester, find.byKey(JoinScreen.pinFieldKey), pin);\n240:   await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n241:   await flush(tester);\n242:   expect(source.watchCalls, 1);\n243: }\n244: \n245: void main() {\n246:   late FakeManifestSource source;\n247:   late FakeClock clock;\n248: \n249:   setUp(() {\n250:     source = FakeManifestSource();\n251:     clock = FakeClock(DateTime.utc(2026, 10, 29, 12));\n252:   });\n253: \n254:   tearDown(() async {\n255:     for (final StreamController<PlaybackManifest> controller\n256:         in source.controllers) {\n257:       if (!controller.isClosed) {\n258:         await controller.close();\n259:       }\n260:     }\n261:   });\n262: \n263:   group('Companion flow', () {\n264:     testWidgets('join renders the published four-camera lineup in wall order', (\n265:       WidgetTester tester,\n266:     ) async {\n267:       await pumpApp(tester, source, clock);\n268:       await joinAs(tester, source);\n269: \n270:       source.controllers.single.add(makeManifest(version: 7));\n271:       await flush(tester);\n272: \n273:       expect(find.text(\"The party's latest published lineup\"), findsOneWidget);\n274:       expect(find.textContaining('Manifest version 7'), findsOneWidget);\n275:       expect(find.textContaining('2026-10-29'), findsWidgets);\n276:       expect(find.textContaining('(UTC)'), findsWidgets);\n277:       expect(find.textContaining('Last successful check'), findsOneWidget);\n278:       expect(find.textContaining('Server publication time'), findsOneWidget);\n279:       // No claim of TV playback sync anywhere on the lineup screen.\n280:       expect(find.textContaining('playback sync'), findsNothing);\n281: \n282:       const List<String> expected = <String>[\n283:         'CAM-01 · hallway',\n284:         'CAM-02 · kitchen',\n285:         'CAM-03 · staircase',\n286:         'CAM-04 · storage room',\n287:       ];\n288:       for (final String label in expected) {\n289:         expect(find.text(label), findsOneWidget);\n290:       }\n291:       final List<double> tops = <double>[\n292:         for (final String label in expected)\n293:           tester.getTopLeft(find.text(label)).dy,\n294:       ];\n295:       for (int i = 0; i + 1 < tops.length; i++) {\n296:         expect(tops[i] < tops[i + 1], isTrue);\n297:       }\n298:       expect(tester.takeException(), isNull);\n299:     });\n300: \n301:     testWidgets('invalid identifiers show inline errors and never join', (\n302:       WidgetTester tester,\n303:     ) async {\n304:       await pumpApp(tester, source, clock);\n305: \n306:       await enterVisible(\n307:         tester,\n308:         find.byKey(JoinScreen.partyFieldKey),\n309:         'party/1',\n310:       );\n311:       await enterVisible(\n312:         tester,\n313:         find.byKey(JoinScreen.channelFieldKey),\n314:         'cctv',\n315:       );\n316:       await enterVisible(tester, find.byKey(JoinScreen.pinFieldKey), '');\n317:       await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n318:       await flush(tester);\n319: \n320:       expect(find.byKey(JoinScreen.errorKey), findsOneWidget);\n321:       expect(source.watchCalls, 0);\n322:       expect(find.byKey(JoinScreen.submitKey), findsOneWidget);\n323:       expect(tester.takeException(), isNull);\n324:     });\n325: \n326:     testWidgets('a pasted join payload joins through the real payload parser', (\n327:       WidgetTester tester,\n328:     ) async {\n329:       await pumpApp(tester, source, clock);\n330: \n331:       await enterVisible(\n332:         tester,\n333:         find.byKey(JoinScreen.payloadFieldKey),\n334:         '{\"partyId\": \"party-1\", \"channelId\": \"cctv\", \"joinPin\": \"004201\", '\n335:         '\"deviceId\": \"evil-device\", \"backend\": \"https://evil.example\", '\n336:         '\"autoSubmit\": true}',\n337:       );\n338:       await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n339:       await flush(tester);\n340: \n341:       expect(source.watchCalls, 1);\n342:       source.controllers.single.add(makeManifest(version: 2));\n343:       await flush(tester);\n344: \n345:       expect(find.textContaining('Manifest version 2'), findsOneWidget);\n346:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n347:       expect(tester.takeException(), isNull);\n348:     });\n349: \n350:     testWidgets('server denial renders the denied state with no lineup', (\n351:       WidgetTester tester,\n352:     ) async {\n353:       await pumpApp(tester, source, clock);\n354:       await joinAs(tester, source);\n355: \n356:       source.controllers.single.addError(\n357:         FirebaseFunctionsException(\n358:           code: 'permission-denied',\n359:           message: 'unregistered party/device secret-party-9',\n360:           details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n361:         ),\n362:       );\n363:       await flush(tester);\n364: \n365:       expect(find.text('Access was denied.'), findsOneWidget);\n366:       expect(find.text('CAM-01 · hallway'), findsNothing);\n367:       expect(find.textContaining('Manifest version'), findsNothing);\n368:       // Raw backend detail never reaches a rendered banner.\n369:       expect(find.textContaining('secret-party-9'), findsNothing);\n370:       expect(tester.takeException(), isNull);\n371:     });\n372: \n373:     testWidgets('malformed data renders the invalid-data state', (\n374:       WidgetTester tester,\n375:     ) async {\n376:       await pumpApp(tester, source, clock);\n377:       await joinAs(tester, source);\n378: \n379:       source.controllers.single.addError(\n380:         const FormatException('bad manifest envelope'),\n381:       );\n382:       await flush(tester);\n383: \n384:       expect(find.text('The lineup data was invalid.'), findsOneWidget);\n385:       expect(find.text('CAM-01 · hallway'), findsNothing);\n386:       expect(tester.takeException(), isNull);\n387:     });\n388: \n389:     testWidgets('stale lineup stays visible and retry recovers', (\n390:       WidgetTester tester,\n391:     ) async {\n392:       await pumpApp(tester, source, clock);\n393:       await joinAs(tester, source);\n394: \n395:       source.controllers.single.add(makeManifest(version: 3));\n396:       await flush(tester);\n397:       expect(find.textContaining('Manifest version 3'), findsOneWidget);\n398: \n399:       source.controllers.single.addError(Exception('socket closed'));\n400:       await flush(tester);\n401: \n402:       // Stale: last-known lineup retained with an explicit stale banner.\n403:       expect(find.textContaining('Manifest version 3'), findsOneWidget);\n404:       expect(\n405:         find.text('Connection lost — showing last-known lineup.'),\n406:         findsOneWidget,\n407:       );\n408: \n409:       final int callsBeforeRetry = source.watchCalls;\n410:       await tapVisible(tester, find.byKey(NowPlayingScreen.retryKey));\n411:       // The session's cancel + re-subscribe needs real event-loop turns\n412:       // here, which fixed pumps alone stall; drain them, then rebuild.\n413:       await tester.runAsync(\n414:         () => Future<void>.delayed(const Duration(milliseconds: 300)),\n415:       );\n416:       await flush(tester);\n417:       expect(source.watchCalls, callsBeforeRetry + 1);\n418:       expect(find.text('Refreshing lineup…'), findsOneWidget);\n419: \n420:       await tester.runAsync(() async {\n421:         source.controllers.last.add(makeManifest(version: 4));\n422:         await Future<void>.delayed(const Duration(milliseconds: 300));\n423:       });\n424:       await flush(tester);\n425:       expect(source.watchCalls, callsBeforeRetry + 1);\n426:       expect(find.textContaining('Manifest version 4'), findsOneWidget);\n427:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n428:       expect(tester.takeException(), isNull);\n429:     });\n430: \n431:     testWidgets('leave resets the flow to the join screen', (\n432:       WidgetTester tester,\n433:     ) async {\n434:       await pumpApp(tester, source, clock);\n435:       await joinAs(tester, source);\n436: \n437:       source.controllers.single.add(makeManifest());\n438:       await flush(tester);\n439:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n440: \n441:       await tapVisible(tester, find.byKey(NowPlayingScreen.leaveKey));\n442:       await tester.runAsync(\n443:         () => Future<void>.delayed(const Duration(milliseconds: 300)),\n444:       );\n445:       await flush(tester);\n446: \n447:       expect(find.byKey(JoinScreen.submitKey), findsOneWidget);\n448:       expect(find.textContaining('organizer'), findsWidgets);\n449:       expect(find.text('CAM-01 · hallway'), findsNothing);\n450:       expect(tester.takeException(), isNull);\n451:     });\n452: \n453:     testWidgets('narrow phone with enlarged text keeps the flow usable and '\n454:         'keyboard-traversable', (WidgetTester tester) async {\n455:       tester.view.physicalSize = const Size(1080, 1920);\n456:       tester.view.devicePixelRatio = 3.0;\n457:       tester.platformDispatcher.textScaleFactorTestValue = 1.4;\n458:       addTearDown(() {\n459:         tester.view.resetPhysicalSize();\n460:         tester.view.resetDevicePixelRatio();\n461:         tester.platformDispatcher.clearAllTestValues();\n462:       });\n463: \n464:       await pumpApp(tester, source, clock);\n465: \n466:       // Keyboard traversal: touch-focus the first field, then Tab moves\n467:       // focus through the manual fields in order, proving keyboard-only\n468:       // guests can reach every input and the Join button.\n469:       await tapVisible(tester, find.byKey(JoinScreen.partyFieldKey));\n470:       await flush(tester);\n471:       expect(focusIsOn(JoinScreen.partyFieldKey), isTrue);\n472:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n473:       await flush(tester);\n474:       expect(focusIsOn(JoinScreen.channelFieldKey), isTrue);\n475:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n476:       await flush(tester);\n477:       expect(focusIsOn(JoinScreen.pinFieldKey), isTrue);\n478:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n479:       await flush(tester);\n480:       expect(focusIsOn(JoinScreen.payloadFieldKey), isTrue);\n481:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n482:       await flush(tester);\n483:       expect(focusIsOn(JoinScreen.scanKey), isTrue);\n484:       await tester.sendKeyEvent(LogicalKeyboardKey.tab);\n485:       await flush(tester);\n486:       expect(focusIsOn(JoinScreen.submitKey), isTrue);\n487: \n488:       await joinAs(tester, source);\n489:       source.controllers.single.add(makeManifest(version: 5));\n490:       await flush(tester);\n491: \n492:       expect(find.textContaining('Manifest version 5'), findsOneWidget);\n493:       expect(find.byKey(NowPlayingScreen.refreshKey), findsOneWidget);\n494:       expect(find.byKey(NowPlayingScreen.leaveKey), findsOneWidget);\n495:       expect(tester.takeException(), isNull);\n496:     });\n497: \n498:     testWidgets('desktop width renders the full lineup without overflow', (\n499:       WidgetTester tester,\n500:     ) async {\n501:       tester.view.physicalSize = const Size(1280, 800);\n502:       tester.view.devicePixelRatio = 1.0;\n503:       addTearDown(() {\n504:         tester.view.resetPhysicalSize();\n505:         tester.view.resetDevicePixelRatio();\n506:       });\n507: \n508:       await pumpApp(tester, source, clock);\n509:       await joinAs(tester, source);\n510:       source.controllers.single.add(makeManifest(version: 6));\n511:       await flush(tester);\n512: \n513:       expect(find.textContaining('Manifest version 6'), findsOneWidget);\n514:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n515:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n516:       expect(find.text('CAM-03 · staircase'), findsOneWidget);\n517:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n518:       expect(find.byKey(const Key('camera-CAM-01')), findsOneWidget);\n519:       expect(find.byKey(ConnectionStatus.retryKey), findsNothing);\n520:       expect(tester.takeException(), isNull);\n521:     });\n522:   });\n523: \n524:   group('Companion live-boot flow (config + invoker overrides)', () {\n525:     late FakeClock liveClock;\n526:     late List<String> events;\n527:     late RecordingManifestInvoker manifestInvoker;\n528:     late RecordingJoinInvoker joinInvoker;\n529: \n530:     Map<String, Object?> liveManifestDoc() {\n531:       String sha(String seed) => List.filled(64, seed).join();\n532:       return <String, Object?>{\n533:         'partyId': 'party-1',\n534:         'channelId': 'cctv',\n535:         'version': 1,\n536:         'schemaVersion': 1,\n537:         'jobId': 'job-1',\n538:         'cameraClips': <Object?>[\n539:           for (int i = 1; i <= 4; i++)\n540:             <String, Object?>{\n541:               'cameraId': 'CAM-0$i',\n542:               'durationMs': 2000,\n543:               'expiresAt': '2030-01-01T00:00:00.000Z',\n544:               'objectPath':\n545:                   'parties/party-1/channels/cctv/delivery/1/CAM-0$i.mp4',\n546:               'sha256': sha('$i'),\n547:               'sizeBytes': 1024 + i,\n548:             },\n549:         ],\n550:         'createdAt': '2026-10-29T14:00:00.000Z',\n551:         'expiresAt': '2030-01-01T00:00:00.000Z',\n552:       };\n553:     }\n554: \n555:     Future<void> pumpLiveApp(WidgetTester tester) async {\n556:       SharedPreferences.setMockInitialValues(<String, Object>{\n557:         DeviceIdentityStore.storageKey: kFixedDeviceId,\n558:       });\n559:       await tester.pumpWidget(\n560:         CompanionApp(\n561:           config: BackendConfig.parse(<String, Object?>{\n562:             'apiKey': 'test-api-key',\n563:             'appId': '1:123:android:abc',\n564:             'projectId': 'test-project',\n565:           }),\n566:           firebaseBootstrap: (_) async {},\n567:           invokerOverride: manifestInvoker,\n568:           partyJoinInvokerOverride: joinInvoker,\n569:           clock: liveClock,\n570:         ),\n571:       );\n572:       await flush(tester);\n573:     }\n574: \n575:     Future<void> joinLive(WidgetTester tester) async {\n576:       await enterVisible(\n577:         tester,\n578:         find.byKey(JoinScreen.partyFieldKey),\n579:         'party-1',\n580:       );\n581:       await enterVisible(\n582:         tester,\n583:         find.byKey(JoinScreen.channelFieldKey),\n584:         'cctv',\n585:       );\n586:       await enterVisible(tester, find.byKey(JoinScreen.pinFieldKey), '');\n587:       await tapVisible(tester, find.byKey(JoinScreen.submitKey));\n588:       await flush(tester);\n589:     }\n590: \n591:     setUp(() {\n592:       liveClock = FakeClock(DateTime.utc(2026, 10, 29, 12));\n593:       events = <String>[];\n594:       manifestInvoker = RecordingManifestInvoker(events, liveManifestDoc());\n595:       joinInvoker = RecordingJoinInvoker(events);\n596:     });\n597: \n598:     testWidgets('registration precedes the manifest subscription', (\n599:       WidgetTester tester,\n600:     ) async {\n601:       manifestInvoker.failAfterFirst = true;\n602:       await pumpLiveApp(tester);\n603:       await joinLive(tester);\n604: \n605:       expect(joinInvoker.calls, 1);\n606:       expect(joinInvoker.lastPayload, <String, Object?>{\n607:         'partyId': 'party-1',\n608:         'deviceId': kFixedDeviceId,\n609:         'channelId': 'cctv',\n610:       });\n611:       expect(manifestInvoker.calls, 1);\n612:       // Registration is wired before the first manifest read.\n613:       expect(events, <String>['register', 'manifest']);\n614: \n615:       await flush(tester);\n616:       expect(find.textContaining('Manifest version 1'), findsOneWidget);\n617:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n618: \n619:       // Let the next poll fail: the transport closes its stream on the\n620:       // first failure, so the subscription ends on its own with the\n621:       // last-known lineup retained and no poll timer pending at teardown.\n622:       await tester.pump(const Duration(seconds: 31));\n623:       await flush(tester);\n624:       expect(manifestInvoker.calls, 2);\n625:       expect(find.textContaining('Manifest version 1'), findsOneWidget);\n626:       expect(tester.takeException(), isNull);\n627:     });\n628: \n629:     testWidgets('a FORBIDDEN registration surfaces the denied state', (\n630:       WidgetTester tester,\n631:     ) async {\n632:       joinInvoker.failure = FirebaseFunctionsException(\n633:         code: 'permission-denied',\n634:         message: 'unregistered party/device secret-party-9',\n635:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n636:       );\n637:       await pumpLiveApp(tester);\n638:       await joinLive(tester);\n639: \n640:       expect(joinInvoker.calls, 1);\n641:       expect(manifestInvoker.calls, 0);\n642:       expect(find.text('Access was denied.'), findsOneWidget);\n643:       expect(find.text('CAM-01 · hallway'), findsNothing);\n644:       // Raw backend detail never reaches a rendered banner.\n645:       expect(find.textContaining('secret-party-9'), findsNothing);\n646:       expect(tester.takeException(), isNull);\n647:     });\n648:   });\n649: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5ad607246b8031f87b91f3ae6"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/companion_flow_test.dart\"}"},"time":{"start":1793461693875,"end":1793461694330}}}}
