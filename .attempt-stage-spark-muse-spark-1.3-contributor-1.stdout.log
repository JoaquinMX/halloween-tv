 = [];\n335:     let revokedManifest = false;\n336:     for (const seedId of input.seedIds) {\n337:       const ref = seedRef(db, host.partyId, seedId);\n338:       const outcome = await db.runTransaction(async (transaction) => {\n339:         const seedSnap = await transaction.get(ref);\n340:         if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", `Seed video ${seedId} does not exist.`);\n341:         const seed = seedSnap.data()!;\n342:         if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n343:           throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n344:         }\n345:         if (seed.status === \"deleted\") return { already: true as const, jobId: String(seed.jobId), previews: seed.previewPaths };\n346:         const jobId = String(seed.jobId);\n347:         const jobSnap = await transaction.get(jobRef(db, host.partyId, jobId));\n348:         const job = jobSnap.exists ? jobSnap.data()! : undefined;\n349:         const staged = ((job?.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown }>) ?? {};\n350:         const previews = Array.isArray(seed.previewPaths) ? (seed.previewPaths as unknown[]) : [];\n351:         transaction.update(ref, {\n352:           status: \"deleted\",\n353:           deletedAt: FieldValue.serverTimestamp(),\n354:           updatedAt: FieldValue.serverTimestamp(),\n355:         });\n356:         if (jobSnap.exists) {\n357:           // Tombstone the job so a deletion/withdrawal racing the worker can\n358:           // never republish it (publish.ts rechecks this flag\n359:           // transactionally) and so no preview is recreated afterwards.\n360:           transaction.update(jobRef(db, host.partyId, jobId), {\n361:             hostDeleted: true,\n362:             deletedSeedId: seedId,\n363:             timestamp: FieldValue.serverTimestamp(),\n364:           });\n365:         }\n366:         // Revoke an affected current manifest whose job matches this seed.\n367:         return { already: false as const, jobId, previews, staged, seed };\n368:       });\n369:       if (outcome.already) {\n370:         deletedSeedIds.push(seedId);\n371:         for (const path of (outcome.previews ?? []) as unknown[]) {\n372:           if (typeof path === \"string\" && path.startsWith(\"parties/\")) doomedObjects.add(path);\n373:         }\n374:         continue;\n375:       }\n376:       deletedSeedIds.push(seedId);\n377:       doomedJobs.push(outcome.jobId);\n378:       for (const preview of (outcome.previews ?? []) as unknown[]) {\n379:         if (typeof preview === \"string\" && preview.startsWith(\"parties/\")) doomedObjects.add(preview);\n380:       }\n381:       for (const clip of Object.values((outcome as { staged: Record<string, { objectPath?: unknown }> }).staged ?? {})) {\n382:         if (clip && typeof clip.objectPath === \"string\" && clip.objectPath.startsWith(\"parties/\")) {\n383:           doomedObjects.add(clip.objectPath);\n384:         }\n385:       }\n386:       const jobSnap = await jobRef(db, host.partyId, outcome.jobId).get().catch(() => undefined);\n387:       const job = jobSnap?.exists ? jobSnap.data()! : undefined;\n388:       for (const key of [\"deliveryPaths\", \"generatedPaths\"] as const) {\n389:         const list = job?.[key];\n390:         if (Array.isArray(list)) {\n391:           for (const item of list) if (typeof item === \"string\" && item.startsWith(\"parties/\")) doomedObjects.add(item);\n392:         }\n393:       }\n394:     }\n395:     // Revoke affected manifests after the tombstones are durable.\n396:     if (doomedJobs.length > 0) {\n397:       const currentRef = db.doc(`parties/${host.partyId}/manifests/current_${host.channelId}`);\n398:       const current = await currentRef.get().catch(() => undefined);\n399:       if (current?.exists) {\n400:         const manifest = current.data() as Record<string, unknown>;\n401:         if (typeof manifest.jobId === \"