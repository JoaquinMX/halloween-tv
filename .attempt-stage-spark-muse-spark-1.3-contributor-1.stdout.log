{"type":"tool_use","timestamp":1793461702492,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5c654001Kekf8Xy51YultH","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5beac001Yjj6d1ywROSQNW","type":"tool","id":"call_01a192a5c605753c86a9703de96b0ed7","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/camera_join_scan_device_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/camera_join_scan_device_test.dart, lines 1-92\n1: // On-device camera join regression (physical Pixel, manual run).\n2: //\n3: // Run (from apps/companion_app, release + live defines, permission\n4: // pre-granted so no OS dialog blocks the run):\n5: //\n6: //   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n7: //   flutter test integration_test/camera_join_scan_device_test.dart \\\n8: //     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n9: //     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n10: //     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\n11: //     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\n12: //\n13: // What it proves on hardware: the shipped join screen pushes the real\n14: // QrScanScreen and the native camera preview initializes (no black stall\n15: // after the permission grant), cancellation returns to a usable join form,\n16: // and the type-or-paste path still joins. Aiming the camera at a real\n17: // party QR and reaching the lineup is covered by the manual written\n18: // procedure in docs/COMPANION-CAMERA-PROOF.md (human aims the camera;\n19: // automation cannot point the lens).\n20: //\n21: // Live paste-join runs only when DEVICE_PARTY_ID/DEVICE_CHANNEL_ID are\n22: // supplied; otherwise it reports the skip. It registers one guest device\n23: // against the seeded rehearsal party (same cost class as the typed manual\n24: // join in rehearsal NOTES — no generation, no spend).\n25: library;\n26: \n27: import 'package:companion_app/src/companion_app.dart';\n28: import 'package:companion_app/src/join/qr_scan_screen.dart';\n29: import 'package:companion_app/src/ui/join_screen.dart';\n30: import 'package:flutter_test/flutter_test.dart';\n31: import 'package:integration_test/integration_test.dart';\n32: import 'package:shared_preferences/shared_preferences.dart';\n33: \n34: const String _devicePartyId = String.fromEnvironment('DEVICE_PARTY_ID');\n35: const String _deviceChannelId = String.fromEnvironment('DEVICE_CHANNEL_ID');\n36: \n37: Future<void> _settle(WidgetTester tester) async {\n38:   for (int i = 0; i < 12; i++) {\n39:     await tester.pump(const Duration(milliseconds: 250));\n40:   }\n41: }\n42: \n43: void main() {\n44:   IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n45: \n46:   testWidgets('device: granted camera opens the live scanner', (tester) async {\n47:     SharedPreferences.setMockInitialValues(<String, Object>{});\n48:     await tester.pumpWidget(const CompanionApp());\n49:     await _settle(tester);\n50:     expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n51: \n52:     await tester.ensureVisible(find.byKey(JoinScreen.scanKey));\n53:     await tester.pump(const Duration(milliseconds: 250));\n54:     await tester.tap(find.byKey(JoinScreen.scanKey));\n55:     await _settle(tester);\n56: \n57:     // The real scan screen is up (camera preview initializes on device;\n58:     // a post-grant stall would leave the join screen showing instead).\n59:     expect(find.byType(QrScanScreen), findsOneWidget);\n60:     expect(find.byKey(QrScanScreen.scannerKey), findsOneWidget);\n61: \n62:     await tester.tap(find.byKey(QrScanScreen.closeKey));\n63:     await _settle(tester);\n64:     expect(find.byType(QrScanScreen), findsNothing);\n65:     expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n66:   });\n67: \n68:   testWidgets('device: pasted join data joins the seeded party', (tester) async {\n69:     if (_devicePartyId.isEmpty || _deviceChannelId.isEmpty) {\n70:       // ignore: avoid_print\n71:       print(\n72:         'SKIP live join: pass --dart-define=DEVICE_PARTY_ID=... '\n73:         'DEVICE_CHANNEL_ID=... (see docs/COMPANION-CAMERA-PROOF.md).',\n74:       );\n75:       return;\n76:     }\n77:     SharedPreferences.setMockInitialValues(<String, Object>{});\n78:     await tester.pumpWidget(const CompanionApp());\n79:     await _settle(tester);\n80: \n81:     await tester.enterText(\n82:       find.byKey(JoinScreen.payloadFieldKey),\n83:       '{\"partyId\":\"$_devicePartyId\",\"channelId\":\"$_deviceChannelId\"}',\n84:     );\n85:     await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n86:     await tester.pump(const Duration(milliseconds: 250));\n87:     await tester.tap(find.byKey(JoinScreen.submitKey));\n88:     await _settle(tester);\n89: \n90:     expect(find.textContaining('Manifest version'), findsOneWidget);\n91:   });\n92: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/integration_test/camera_join_scan_device_test.dart, lines 1-92\n1: // On-device camera join regression (physical Pixel, manual run).\n2: //\n3: // Run (from apps/companion_app, release + live defines, permission\n4: // pre-granted so no OS dialog blocks the run):\n5: //\n6: //   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n7: //   flutter test integration_test/camera_join_scan_device_test.dart \\\n8: //     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n9: //     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n10: //     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\n11: //     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\n12: //\n13: // What it proves on hardware: the shipped join screen pushes the real\n14: // QrScanScreen and the native camera preview initializes (no black st