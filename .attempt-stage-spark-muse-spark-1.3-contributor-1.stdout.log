ions).\n32: const Key kGuestCodeBackKey = ValueKey<String>('guest-code-back');\n33: \n34: /// Key of the single session QR (present only after authoritative data).\n35: const Key kGuestCodeQrKey = ValueKey<String>('guest-code-qr');\n36: \n37: /// Key of the session scope/PIN line.\n38: const Key kGuestCodeSessionKey = ValueKey<String>('guest-code-session');\n39: \n40: /// Key of the guest list body.\n41: const Key kGuestCodeListKey = ValueKey<String>('guest-code-list');\n42: \n43: /// Key of the loading indicator text.\n44: const Key kGuestCodeLoadingKey = ValueKey<String>('guest-code-loading');\n45: \n46: /// Key of the error text.\n47: const Key kGuestCodeErrorKey = ValueKey<String>('guest-code-error');\n48: \n49: /// Key of the empty-list text.\n50: const Key kGuestCodeEmptyKey = ValueKey<String>('guest-code-empty');\n51: \n52: /// Default bounded refresh interval while the panel is visible.\n53: const Duration kGuestCodeRefreshInterval = Duration(seconds: 10);\n54: \n55: /// Bounds a single listing fetch: without this, a hung callable would hold\n56: /// `_fetching` true forever and wedge the panel (no retries, stale rows).\n57: const Duration kGuestCodeFetchTimeout = Duration(seconds: 10);\n58: \n59: /// Host panel: TV code (large text + session QR) and the guest list.\n60: ///\n61: /// Owns its listing refresh: fetches immediately on open and re-fetches on\n62: /// [refreshInterval] while mounted. Pass a fake [GuestCodeClient.invoker] in\n63: /// widget tests; production passes the real Cloud Functions client.\n64: class GuestCodePanel extends StatefulWidget {\n65:   /// Creates the host code panel.\n66:   const GuestCodePanel({\n67:     super.key,\n68:     required this.client,\n69:     required this.tvDeviceId,\n70:     required this.onClose,\n71:     this.onBack,\n72:     this.primaryFocusNode,\n73:     this.refreshInterval = kGuestCodeRefreshInterval,\n74:   });\n75: \n76:   /// Host-only listing reader (authorization carries the TV's device id).\n77:   final GuestCodeClient client;\n78: \n79:   /// TV's own device code, shown as large text.\n80:   final String tvDeviceId;\n81: \n82:   /// Closes the whole overlay.\n83:   final VoidCallback onClose;\n84: \n85:   /// Returns to the recovery actions; null hides the back button.\n86:   final VoidCallback? onBack;\n87: \n88:   /// Focus node for the first action, so the D-pad lands inside the panel.\n89:   final FocusNode? primaryFocusNode;\n90: \n91:   /// Bounded periodic refresh interval while visible.\n92:   final Duration refreshInterval;\n93: \n94:   @override\n95:   State<GuestCodePanel> createState() => _GuestCodePanelState();\n96: }\n97: \n98: class _GuestCodePanelState extends State<GuestCodePanel> {\n99:   GuestCodeListing? _listing;\n100:   String? _error;\n101:   bool _firstFetchDone = false;\n102:   bool _fetching = false;\n103:   int _generation = 0;\n104:   Timer? _timer;\n105: \n106:   @override\n107:   void initState() {\n108:     super.initState();\n109:     unawaited(_refresh());\n110:     _timer = Timer.periodic(widget.refreshInterval, (_) {\n111:       unawaited(_refresh());\n112:     });\n113:   }\n114: \n115:   @override\n116:   void dispose() {\n117:     _generation++;\n118:     _timer?.cancel();\n119:     _timer = null;\n120:     super.dispose();\n121:   }\n122: \n123:   Future<void> _refresh() async {\n124:     if (_fetching || !mounted) {\n125:       return;\n126:     }\n127:     _fetching = true;\n128:     final int generation = _generation;\n129:     try {\n130:       final GuestCodeListing listing = await widget.client\n131:           .fetchListing()\n132:           .timeout(kGuestCodeFetchTimeout);\n133:       if (!mounted || generation != _generation) {\n134:         return;\n135:       }\n136:       setState(() {\n137:         _listing = listing;\n138:         _error = null;\n139:         _firstFetchDone = true;\n140:       });\n141:     } on TimeoutException {\n142:       // A hung fetch releases the in-flight guard so the next tick retries;\n143:       // the last valid session (if any) is retained behind an inline error.\n144:       if (!mounted || generation != _generation) {\n145:         return;\n146:       }\n147:       setState(() {\n148:         _error = 'guest list refresh timed out';\n149:         _firstFetchDone = true;\n150:       });\n151:     } on Object catch (error) {\n152:       if (!mounted || generation != _generation) {\n153:         return;\n154:       }\n155:       setState(() {\n156:         _error = error is GuestCodeException\n157:             ? error.message\n158:             : 'unexpected guest list failure';\n159:         _firstFetchDone = true;\n160:       });\n161:     } finally {\n162:       _fetching = false;\n163:     }\n164:   }\n165: \n166:   KeyEventResult _onKey(FocusNode node, KeyEvent event) {\n167:     if (event is KeyDownEvent) {\n168:       if (event.logicalKey == LogicalKeyboardKey.contextMenu) {\n169:         widget.onClose();\n170:         return KeyEventResult.handled;\n171:       }\n172:       if (event.logicalKey == LogicalKeyboardKey.goBack ||\n173:           event.logicalKey == LogicalKeyboardKey.escape) {\n174:         (widget.onBack ?? widget.onClose)();\n175:         return KeyEventResult.handled;\n176:       }\n177:     }\n178:     return KeyEventResult.ignored;\n179:   }\n180: \n181:   @override\n182:   Widget build(BuildContext context) {\n183:     return Focus(\n184:       canRequestFocus: false,\n185:       skipTraversal: true,\n186:       onKeyEvent: _onKey,\n187:       child: ColoredBox(\n188:         color: const Color(0xE6000000),\n189:         child: Center(\n190:           child: ConstrainedBox(\n191:             constraints: const BoxConstraints(maxWidth: 720),\n192:             child: Container(\n193:               key: kGuestCodePanelKey,\n194:               padding: const EdgeInsets.all(28),\n195:               decoration: BoxDecoration(\n196:                 color: const Color(0xFF101410),\n197:                 border: Border.all(color: CctvTheme.frameEdge, width: 2),\n198:               ),\n199:               child: SingleChildScrollView(\n200:                 child: Column(\n201:                   mainAxisSize: MainAxisSize.min,\n202:                   crossAxisAlignment: CrossAxisAlignment.start,\n203:                   children: <Widget>[\n204:                     const Text('GUEST CODES', style: CctvTheme.labelStyle),\n205:                     const SizedBox(height: 8),\n206:                     const Text(\n207:                       'On the companion app, type or paste the party code '\n208:                       'and PIN shown below. Camera QR scanning is not '\n209:                       'available in this build.',\n210:                       style: TextStyle(color: Colors.white70, fontSize: 18),\n211:                     ),\n212:                     const SizedBox(height: 20),\n213:                     Row(\n214:                       crossAxisAlignment: CrossAxisAlignment.start,\n215:                       children: <Widget>[\n216:                         Expanded(\n217:                           child: Column(\n218:                             crossAxisAlignment: CrossAxisAlignment.start,\n219:                             children: <Widget>[\n220:                               const Text(\n221:                                 'TV CODE',\n222:                                 style: TextStyle(\n223:                                   color: Color(0xFFFFC107),\n224:                                   fontSize: 20,\n225:                                 ),\n226:                               ),\n227:                               const SizedBox(height: 4),\n228:                               Text(\n229:                                 widget.tvDeviceId,\n230:                                 style: const TextStyle(\n231:                                   color: Colors.white,\n232:                                   fontSize: 44,\n233:                                   fontWeight: FontWeight.bold,\n234:                                 ),\n235:                               ),\n236:                               const SizedBox(height: 8),\n237:                               _sessionLine(),\n238:                             ],\n239:                           ),\n240:                         ),\n241:                         _qrBox(),\n242:                       ],\n243:                     ),\n244:                     const SizedBox(height: 20),\n245:                     const Text('GUEST LIST', style: CctvTheme.labelStyle),\n246:                     const SizedBox(height: 8),\n247:                     _guestListBody(),\n248:                     const SizedBox(height: 20),\n249:                     FocusTraversalGroup(\n250:                       child: Column(\n251:                         mainAxisSize: MainAxisSize.min,\n252:                         crossAxisAlignment: CrossAxisAlignment.stretch,\n253:                         children: <Widget>[\n254:                           if (widget.onBack != null)\n255:                             _PanelButton(\n256:                               actionKey: kGuestCodeBackKey,\n257:                               label: 'BACK',\n258:                               focusNode: widget.primaryFocusNode,\n259:                               onPressed: widget.onBack!,\n260:                             ),\n261:                           if (widget.onBack != null) const SizedBox(height: 10),\n262:                           _PanelButton(\n263:                             actionKey: kGuestCodeCloseKey,\n264:                             label: 'CLOSE',\n265:                             focusNode: widget.onBack == null\n266:                                 ? widget.primaryFocusNode\n267:                                 : null,\n268:                             onPressed: widget.onClose,\n269:                           ),\n270:                         ],\n271:                       ),\n272:                     ),\n273:                   ],\n274:                 ),\n275:               ),\n276:             ),\n277:           ),\n278:         ),\n279:       ),\n280:     );\n281:   }\n282: \n283:   Widget _sessionLine() {\n284:     final GuestCodeListing? listing = _listing;\n285:     if (listing == null) {\n286:       return Text(\n287:         'party ${widget.client.partyId} · ${widget.client.channelId}',\n288:         key: kGuestCodeSessionKey,\n289:         style: const TextStyle(color: Colors.white70, fontSize: 18),\n290:       );\n291:     }\n292:     final String pinText = listing.joinPin == null\n293:         ? 'no PIN required'\n294:         : 'PIN ${listing.joinPin}';\n295:     return Text(\n296:       'party ${listing.partyId} · ${listing.channelId} · $pinText',\n297:       key: kGuestCodeSessionKey,\n298:       style: const TextStyle(color: Colors.white70, fontSize: 18),\n299:     );\n300:   }\n301: \n302:   /// Exactly one QR once authoritative session data exists; no fabricated\n303:   /// PIN-free QR before the first successful fetch.\n304:   Widget _qrBox() {\n305:     final GuestCodeListing? listing = _listing;\n306:     if (listing == null) {\n307:       return Container(\n308:         width: 204,\n309:         height: 204,\n310:         alignment: Alignment.center,\n311:         decoration: BoxDecoration(\n312:           border: Border.all(color: CctvTheme.frameEdge),\n313:         ),\n314:         child: const Text(\n315:           'Waiting for session…',\n316:           textAlign: TextAlign.center,\n317:           style: TextStyle(color: Colors.white70, fontSize: 16),\n318:         ),\n319:       );\n320:     }\n321:     final String payload = buildJoinPayload(\n322:       partyId: listing.partyId,\n323:       channelId: listing.channelId,\n324:       joinPin: listing.joinPin,\n325:     );\n326:     return Container(\n327:       padding: const EdgeInsets.all(12),\n328:       color: Colors.white,\n329:       child: QrImageView(\n330:         key: kGuestCodeQrKey,\n331:         data: payload,\n332:         semanticsLabel: payload,\n333:         size: 180,\n334:         backgroundColor: Colors.white,\n335:       ),\n336:     );\n337:   }\n338: \n339:   Widget _guestListBody() {\n340:     final GuestCodeListing? listing = _listing;\n341:     if (!_firstFetchDone && listing == null && _error == null) {\n342:       return const Text(\n343:         'Loading guest codes…',\n344:         key: kGuestCodeLoadingKey,\n345:         style: TextStyle(color: Colors.white70, fontSize: 22),\n346:       );\n347:     }\n348:     // First fetch failed with nothing valid to show: error, no QR, no rows.\n349:     if (listing == null && _error != null) {\n350:       return Text(\n351:         'Guest list unavailable: $_error',\n352:         key: kGuestCodeErrorKey,\n353:         style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n354:       );\n355:     }\n356:     final List<GuestCodeEntry> rows = listing?.devices ?? <GuestCodeEntry>[];\n357:     if (rows.isEmpty) {\n358:       return Column(\n359:         crossAxisAlignment: CrossAxisAlignment.start,\n360:         mainAxisSize: MainAxisSize.min,\n361:         children: <Widget>[\n362:           const Text(\n363:             'No guests yet — new joins appear here automatically.',\n364:             key: kGuestCodeEmptyKey,\n365:             style: TextStyle(color: Colors.white70, fontSize: 22),\n366:           ),\n367:           if (_error != null)\n368:             Padding(\n369:               padding: const EdgeInsets.only(top: 8),\n370:               child: Text(\n371:                 'Refresh failed: $_error — showing last session.',\n372:                 key: kGuestCodeErrorKey,\n373:                 style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n374:               ),\n375:             ),\n376:         ],\n377:       );\n378:     }\n379:     return Column(\n380:       key: kGuestCodeListKey,\n381:       crossAxisAlignment: CrossAxisAlignment.start,\n382:       mainAxisSize: MainAxisSize.min,\n383:       children: <Widget>[\n384:         for (final GuestCodeEntry entry in rows)\n385:           Padding(\n386:             padding: const EdgeInsets.symmetric(vertical: 4),\n387:             child: Text(\n388:               '${entry.displayLabel}: ${entry.deviceId}',\n389:               style: const TextStyle(color: Colors.white, fontSize: 26),\n390:             ),\n391:           ),\n392:         if (_error != null)\n393:           Padding(\n394:             padding: const EdgeInsets.only(top: 8),\n395:             child: Text(\n396:               'Refresh failed: $_error — showing last session.',\n397:               key: kGuestCodeErrorKey,\n398:               style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n399:             ),\n400:           ),\n401:       ],\n402:     );\n403:   }\n404: }\n405: \n406: /// Large, TV-focusable panel action.\n407: class _PanelButton extends StatelessWidget {\n408:   const _PanelButton({\n409:     required this.actionKey,\n410:     required this.label,\n411:     required this.onPressed,\n412:     this.focusNode,\n413:   });\n414: \n415:   final Key actionKey;\n416:   final String label;\n417:   final VoidCallback onPressed;\n418:   final FocusNode? focusNode;\n419: \n420:   @override\n421:   Widget build(BuildContext context) {\n422:     return OutlinedButton(\n423:       key: actionKey,\n424:       focusNode: focusNode,\n425:       onPressed: onPressed,\n426:       style: OutlinedButton.styleFrom(\n427:         foregroundColor: Colors.white,\n428:         side: const BorderSide(color: CctvTheme.frameEdge, width: 2),\n429:         padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16),\n430:         textStyle: CctvTheme.badgeStyle,\n431:       ),\n432:       child: Align(alignment: Alignment.centerLeft, child: Text(label)),\n433:     );\n434:   }\n435: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestr