es.every((entry) => entry.role === \"guest\" && entry.status === \"active\"));\n71:     assert.ok(!listing.devices.some((entry) => entry.deviceId === tvDevice));\n72: \n73:     await db.doc(`parties/${partyId}`).update({ joinPin: \"\" });\n74:     const unpinned = await runtime.listPartyDevices({ partyId, deviceId: tvDevice, channelId });\n75:     assert.ok(!(\"joinPin\" in unpinned));\n76:   } finally {\n77:     await db.recursiveDelete(db.doc(`parties/${partyId}`));\n78:     await disposeEmulatorContext(app);\n79:   }\n80: });\n81: \n82: test(\"host listing fails closed on a malformed stored PIN\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n83:   const { app, db } = await createEmulatorContext();\n84:   const partyId = randomPartyId();\n85:   const tvDevice = \"tv-host\";\n86:   const channelId = \"main\";\n87:   try {\n88:     await db.doc(`parties/${partyId}`).set({ ownerUid: null, status: \"active\", activeChannelId: channelId });\n89:     await db.doc(`parties/${partyId}/channels/${channelId}`).set({ partyId, channelId, status: \"active\" });\n90:     await db.doc(`parties/${partyId}/devices/${tvDevice}`).set({ partyId, deviceId: tvDevice, label: \"TV\", role: \"tv\", status: \"active\" });\n91:     const services = createGuestListService({ db });\n92: \n93:     // A missing PIN field means \"no PIN required\" and omits joinPin.\n94:     const unpinned = await services.listPartyDevices({ partyId, deviceId: tvDevice, channelId });\n95:     assert.ok(!(\"joinPin\" in unpinned));\n96: \n97:     // Present-but-invalid stored PINs (console-written number/boolean/null/\n98:     // malformed strings) surface a callable INTERNAL error: the TV panel\n99:     // shows an error state instead of a PIN-free session.\n100:     for (const badPin of [420100, true, null, \"not-a-pin\", \"12 456\"] as const) {\n101:       await db.doc(`parties/${partyId}`).update({ joinPin: badPin });\n102:       const error = await services.listPartyDevices({ partyId, deviceId: tvDevice, channelId }).then(\n103:         () => null,\n104:         (error: unknown) => error,\n105:       );\n106:       assert.ok(error instanceof BackendError, `stored PIN ${String(badPin)} must fail closed`);\n107:       assert.equal(error.errorCode, \"INTERNAL\");\n108:       assert.match(error.message, /misconfigured/);\n109:     }\n110: \n111:     // Empty string stays unpinned.\n112:     await db.doc(`parties/${partyId}`).update({ joinPin: \"\" });\n113:     const reopened = await services.listPartyDevices({ partyId, deviceId: tvDevice, channelId });\n114:     assert.ok(!(\"joinPin\" in reopened));\n115:   } finally {\n116:     await db.recursiveDelete(db.doc(`parties/${partyId}`));\n117:     await disposeEmulatorContext(app);\n118:   }\n119: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c45032779e82fd1f84ac716018"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/guest_list.test.ts\"}"},"time":{"start":1793463701536,"end":1793463702349}}}}
