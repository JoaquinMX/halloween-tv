           pendingDeletions.push(path);\n549:         }\n550:       }\n551:     }\n552:     // Order the source first for stable assertions, without duplicating it.\n553:     const orderedDeleted = [\n554:       ...(deletedObjects.includes(objectPath) ? [objectPath] : []),\n555:       ...deletedObjects.filter((p) => p !== objectPath),\n556:     ];\n557:     await ref.update({\n558:       pendingDeletions,\n559:       revokedManifestPaths,\n560:       updatedAt: FieldValue.serverTimestamp(),\n561:     }).catch(() => undefined);\n562:     return { submissionId, status: \"withdrawn\", deletedObjects: orderedDeleted, verifiedAbsent };\n563:   }\n564: \n565:   /**\n566:    * Object-finalization cleanup: a PUT after withdrawal must not restore\n567:    * eligibility and is deleted. Pending uploads are left alone; explicit\n568:    * completion validates bytes before any eligibility change.\n569:    */\n570:   async function handleIngestFinalized(objectPath: string): Promise<{ handled: boolean; deleted: boolean }> {\n571:     const parsed = parseGuestObjectPath(objectPath);\n572:     if (!parsed) return { handled: false, deleted: false };\n573:     const snapshot = await guestMediaRef(db, parsed.partyId, parsed.submissionId).get();\n574:     if (!snapshot.exists) {\n575:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n576:       return { handled: true, deleted: true };\n577:     }\n578:     const doc = snapshot.data() as GuestMediaDoc;\n579:     if (doc.deviceId !== parsed.deviceId || doc.partyId !== parsed.partyId) {\n580:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n581:       return { handled: true, deleted: true };\n582:     }\n583:     if (doc.status === \"withdrawn\" || doc.status === \"expired\") {\n584:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n585:       const [stillExists] = await bucket.file(objectPath).exists();\n586:       if (stillExists) throw new BackendError(\"INTERNAL\", \"Withdrawn guest object could not be removed.\");\n587:       return { handled: true, deleted: true };\n588:     }\n589:     return { handled: true, deleted: false };\n590:   }\n591: \n592:   return { requestGuestUpload, completeGuestUpload, getGuestMediaStatus, withdrawGuestMedia, handleIngestFinalized };\n593: }\n594: \n595: export type GuestUploadServices = ReturnType<typeof createGuestUploadService>;"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c335a375d8ae3318fb651d0ae3"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/guest_upload.ts\"}"},"time":{"start":1793463629923,"end":1793463630477}}}}
