\n37:   return db.doc(`parties/${partyId}/jobs/${jobId}`);\n38: }\n39: \n40: function currentManifestRef(db: Firestore, partyId: string, channelId: string) {\n41:   return db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n42: }\n43: \n44: function budgetRef(db: Firestore, partyId: string) {\n45:   return db.doc(`parties/${partyId}/generationBudget/active`);\n46: }\n47: \n48: function deliveryObjectPath(partyId: string, channelId: string, version: number, cameraId: CameraId): string {\n49:   return `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`;\n50: }\n51: \n52: /**\n53:  * Persistence guard: signed reference URLs are in-flight only and must never\n54:  * reach Firestore job docs. The guest binding stores server-side state\n55:  * (objectPath + sourceHash + consentRevision) exclusively.\n56:  */\n57: function assertNoSignedReferenceUrl(value: unknown): void {\n58:   const serialized = JSON.stringify(value ?? null);\n59:   if (/https?:\\/\\//.test(serialized) && /signed/.test(serialized)) {\n60:     throw new BackendError(\"INTERNAL\", \"Signed reference URLs must never be persisted.\");\n61:   }\n62: }\n63: \n64: function exposedTimestamp(value: unknown): unknown {\n65:   if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n66:     return ((value as { toDate: () => Date }).toDate()).toISOString();\n67:   }\n68:   if (value instanceof Date) return value.toISOString();\n69:   return value;\n70: }\n71: \n72: /**\n73:  * Fake-only rehearsal marker. The operator rehearsal tool always sends\n74:  * `rehearsalOnly: true`; the marker is persisted on the job document and the\n75:  * worker resolves ONLY the offline fake provider for marked jobs, regardless\n76:  * of the deployed provider configuration. Requests without the marker take\n77:  * the unchanged default path. Any other marker value is rejected fail-closed\n78:  * so the flag can never be weakened into a live-looking request.\n79:  */\n80: function extractRehearsalOnly(value: unknown): boolean {\n81:   if (value && typeof value === \"object\" && !Array.isArray(value) && \"rehearsalOnly\" in value) {\n82:     if ((value as Record<string, unknown>).rehearsalOnly !== true) {\n83:       throw new BackendError(\"INVALID_ARGUMENT\", \"rehearsalOnly must be true when present.\");\n84:     }\n85:     return true;\n86:   }\n87:   return false;\n88: }\n89: \n90: /**\n91:  * Strips the rehearsal marker before shared cheap_demo control validation and\n92:  * request parsing, which only accept the fixed preset fields. The marker is\n93:  * handled (validated, bound, persisted) by the store itself.\n94:  */\n95: function stripRehearsalOnly(value: unknown): unknown {\n96:   if (value && typeof value === \"object\" && !Array.isArray(value) && \"rehearsalOnly\" in value) {\n97:     const { rehearsalOnly: _ignored, ...rest } = value as Record<string, unknown>;\n98:     return rest;\n99:   }\n100:   return value;\n101: }\n102: \n103: export class FirestoreGenerationStore {\n104:   readonly db: Firestore;\n105:   readonly bucket: Bucket;\n106:   private readonly now: () => Date;\n107: \n108:   constructor(options: GenerationStoreOptions) {\n109:     this.db = options.db;\n110:     this.bucket = options.bucket;\n111:     this.now = options.now ?? (() => new Date());\n112:   }\n113: \n114:   async requestGeneration(value: unknown): Promise<RequestGenerationResult> {\n115:     const rehearsalOnly = extractRehearsalOnly(value);\n116:     const sanitized = stripRehearsalOnly(value);\n117:     validatePresetControls(sanitized);\n118:     if (sanitized && typeof sanitized === \"object\" && !Array.isArray(sanitized) && \"prompt\" in sanitized) {\n119:       const presetId = (sanitized as Record<string, unknown>).presetId === CAMEO_DEMO_PRESET.presetId ? \"cameo_demo\" : \"cheap_demo\";\n120:       throw new BackendError(\"INVALID_ARGUMENT\", `Generation prompts are fixed server-s