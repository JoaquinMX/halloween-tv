{"type":"tool_use","timestamp":1793463676755,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c3ea9b001k5uxnor2DLKrGU","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c3a16c0013OO8hWzzdE5xMW","type":"tool","id":"call_01a192c3ea77731496ce57ae98a762e9","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_focus.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_focus.dart, lines 1-160\n1: /// Minimal D-pad focus traversal for the adaptive wall (no touch assumption).\n2: ///\n3: /// The wall shows 1, 2, or 4 cameras (always the first-N canonical slots in\n4: /// wall order); traversal geometry follows the active layout and stale focus\n5: /// is clamped when the count shrinks. Four pre-created nodes keep camera\n6: /// element identity stable across count changes.\n7: library;\n8: \n9: import 'package:flutter/services.dart';\n10: import 'package:flutter/widgets.dart';\n11: \n12: /// Direction of a D-pad move.\n13: enum WallMove { left, right, up, down }\n14: \n15: /// Owns one [FocusNode] per wall slot and moves between them on arrows.\n16: ///\n17: /// Movement is grid-shaped: left/right stay inside a row, up/down move two\n18: /// slots, and moves that would leave the grid are ignored (TV remotes should\n19: /// not wrap and lose the user).\n20: final class WallFocusController {\n21:   /// Creates a controller for a [columns] x [tiles ~/ columns] grid.\n22:   WallFocusController({this.columns = 2, this.tiles = 4})\n23:     : assert(columns > 0),\n24:       assert(tiles > 0),\n25:       _nodes = List<FocusNode>.generate(\n26:         tiles,\n27:         (int index) => FocusNode(debugLabel: 'wall-tile-$index'),\n28:         growable: false,\n29:       );\n30: \n31:   /// Grid width.\n32:   final int columns;\n33: \n34:   /// Number of tiles.\n35:   final int tiles;\n36: \n37:   final List<FocusNode> _nodes;\n38:   int _focusedIndex = -1;\n39: \n40:   /// Tiles (and columns) of the currently active layout.\n41:   ///\n42:   /// Defaults to the full 2x2 grid; [setActiveLayout] narrows them when the\n43:   /// wall shows fewer cameras. Nodes are pre-created for all four slots so\n44:   /// camera element identity survives count changes.\n45:   int _activeTiles = 4;\n46:   int _activeColumns = 2;\n47: \n48:   /// Active tile count of the current layout (1, 2, or 4).\n49:   int get activeTiles => _activeTiles;\n50: \n51:   /// Active grid width of the current layout.\n52:   int get activeColumns => _activeColumns;\n53: \n54:   /// Focus node for wall slot [index].\n55:   FocusNode nodeAt(int index) => _nodes[index];\n56: \n57:   /// All focus nodes, in slot order.\n58:   List<FocusNode> get nodes => List<FocusNode>.unmodifiable(_nodes);\n59: \n60:   /// Slot currently holding focus, or `-1` when none.\n61:   int get focusedIndex => _focusedIndex;\n62: \n63:   /// Records that slot [index] gained focus.\n64:   void markFocused(int index) {\n65:     _focusedIndex = index;\n66:   }\n67: \n68:   /// Focuses slot [index]; out-of-range and inactive values are ignored.\n69:   void focusTile(int index) {\n70:     if (index < 0 || index >= _activeTiles) {\n71:       return;\n72:     }\n73:     _nodes[index].requestFocus();\n74:   }\n75: \n76:   /// Narrows (or restores) traversal to an active 1/2/4 layout.\n77:   ///\n78:   /// Counts outside 1..4 fall back to the full grid so the wall never loses\n79:   /// traversal. When the focused slot leaves the active set, focus is\n80:   /// clamped to the last remaining tile.\n81:   void setActiveLayout({required int tiles, required int columns}) {\n82:     final int saneTiles = tiles == 1 || tiles == 2 || tiles == 4 ? tiles : 4;\n83:     final int saneColumns = columns > 0 ? columns : 2;\n84:     _activeTiles = saneTiles;\n85:     _activeColumns = saneColumns;\n86:     if (_focusedIndex >= _activeTiles) {\n87:       _focusedIndex = _activeTiles - 1;\n88:       focusTile(_focusedIndex);\n89:     }\n90:   }\n91: \n92:   /// Index a [move] from [from] would land on, or `-1` when blocked.\n93:   static int targetFor(\n94:     int from,\n95:     WallMove move, {\n96:     int columns = 2,\n97:     int tiles = 4,\n98:   }) {\n99:     if (from < 0 || from >= tiles) {\n100:       return -1;\n101:     }\n102:     final int column = from % columns;\n103:     switch (move) {\n104:       case WallMove.left:\n105:         return column == 0 ? -1 : from - 1;\n106:       case WallMove.right:\n107:         return column == columns - 1 ? -1 : from + 1;\n108:       case WallMove.up:\n109:         return from - columns >= 0 ? from - columns : -1;\n110:       case WallMove.down:\n111:         return from + columns < tiles ? from + columns : -1;\n112:     }\n113:   }\n114: \n115:   /// Applies [move] from the current slot; returns the new index or `-1`.\n116:   int moveFrom(int from, WallMove move) {\n117:     final int target = targetFor(\n118:       from,\n119:       move,\n120:       columns: _activeColumns,\n121:       tiles: _activeTiles,\n122:     );\n123:     if (target < 0) {\n124:       return -1;\n125:     }\n126:     focusTile(target);\n127:     return target;\n128:   }\n129: \n130:   /// Translates an arrow key press into a wall move.\n131:   ///\n132:   /// Returns true when the event was consumed (an arrow key), false\n133:   /// otherwise so other keys can keep bubbling.\n134:   bool handleArrow(LogicalKeyboardKey key) {\n135:     final WallMove? move = switch (key) {\n136:       LogicalKeyboardKey.arrowLeft => WallMove.left,\n137:       LogicalKeyboardKey.arrowRight => WallMove.right,\n138:       LogicalKeyboardKey.arrowUp => WallMove.up,\n139:       LogicalKeyboardKey.arrowDown => WallMove.down,\n140:       _ => null,\n141:     };\n142:     if (move == null) {\n143:       return false;\n144:     }\n145:     final int from = _focusedIndex;\n146:     if (from < 0) {\n147:       focusTile(0);\n148:       return true;\n149:     }\n150:     moveFrom(from, move);\n151:     return true;\n152:   }\n153: \n154:   /// Releases every focus node.\n155:   void dispose() {\n156:     for (final FocusNode node in _nodes) {\n157:       node.dispose();\n158:     }\n159:   }\n160: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_focus.dart, lines 1-160\n1: /// Minimal D-pad focus traversal for the adaptive wall (no touch assumption).\n2: ///\n3: /// The wall shows 1, 2, or 4 cameras (always the first-N canonical slots in\n4: /// wall order); traversal geometry follows the active layout and stale focus\n5: /// is clamped when the count shrinks. Four pre-created nodes keep camera\n6: /// element identity stable across count changes.\n7: library;\n8: \n9: import 'package:flutter/services.dart';\n10: import 'package:flutter/widgets.dart';\n11: \n12: /// Direction of a D-pad move.\n13: enum WallMove { left, right, up, down }\n14: \n15: /// Owns one [FocusNode] per wall slot and moves between them on arrows.\n16: ///\n17: /// Movement is grid-shaped: left/right stay inside a row, up/down move two\n18: /// slots, and moves that would leave the grid are ignored (TV remotes should\n19: /// not wrap and lose the user).\n20: final class WallFocusController {\n21:   /// Creates a controller for a [columns] x [tiles ~/ columns] grid.\n22:   WallFocusController({this.columns = 2, this.tiles = 4})\n23:     : assert(columns > 0),\n24:       assert(tiles > 0),\n25:       _nodes = List<FocusNode>.generate(\n26:         tiles,\n27:         (int index) => FocusNode(debugLabel: 'wall-tile-$index'),\n28:         growable: false,\n29:       );\n30: \n31:   /// Grid width.\n32:   final int columns;\n33: \n34:   /// Number of tiles.\n35:   final int tiles;\n36: \n37:   final List<FocusNode> _nodes;\n38:   int _focusedIndex = -1;\n39: \n40:   /// Tiles (and columns) of the currently active layout.\n41:   ///\n42:   /// Defaults to the full 2x2 grid; [setActiveLayout] narrows them when the\n43:   /// wall shows fewer cameras. Nodes are pre-created for all four slots so\n44:   /// camera element identity survives count changes.\n45:   int _activeTiles = 4;\n46:   int _activeColumns = 2;\n47: \n48:   /// Active tile count of the current layout (1, 2, or 4).\n49:   int get activeTiles => _activeTiles;\n50: \n51:   /// Active grid width of the current layout.\n52:   int get activeColumns => _activeColumns;\n53: \n54:   /// Focus node for wall slot [index].\n55:   FocusNode nodeAt(int index) => _nodes[index];\n56: \n57:   /// All focus nodes, in slot order.\n58:   List<FocusNode> get nodes => List<FocusNode>.unmodifiable(_nodes);\n59: \n60:   /// Slot currently holding focus, or `-1` when none.\n61:   int get focusedIndex => _focusedIndex;\n62: \n63:   /// Records that slot [index] gained focus.\n64:   void markFocused(int index) {\n65:     _focusedIndex = index;\n66:   }\n67: \n68:   /// Focuses slot [index]; out-of-range and inactive values are ignored.\n69:   void focusTile(int index) {\n70:     if (index < 0 || index >= _activeTiles) {\n71:       return;\n72:     }\n73:     _nodes[index].requestFocus();\n74:   }\n75: \n76:   /// Narrows (or restores) traversal to an active 1/2/4 layout.\n77:   ///\n78:   /// Counts outside 1..4 fall back to the full grid so the wall never loses\n79:   /// traversal. When the focused slot leaves the active set, focus is\n80:   /// clamped to the last remaining tile.\n81:   void setActiveLayout({required int tiles, required int columns}) {\n82:     final int saneTiles = tiles == 1 || tiles == 2 || tiles == 4 ? tiles : 4;\n83:     final int saneColumns = columns > 0 ? columns : 2;\n84:     _activeTiles = saneTiles;\n85:     _activeColumns = saneColumns;\n86:     if (_focusedIndex >= _activeTiles) {\n87:       _focusedIndex = _activeTiles - 1;\n88:       focusTile(_focusedIndex);\n89:     }\n90:   }\n91: \n92:   /// Index a [move] from [from] would land on, or `-1` when blocked.\n93:   static int targetFor(\n94:     int from,\n95:     WallMove move, {\n96:     int columns = 2,\n97:     int tiles = 4,\n98:   }) {\n99:     if (from < 0 || from >= tiles) {\n100:       return -1;\n101:     }\n102:     final int column = from % columns;\n103:     switch (move) {\n104:       case WallMove.left:\n105:         return column == 0 ? -1 : from - 1;\n106:       case WallMove.right:\n107:         return column == columns - 1 ? -1 : from + 1;\n108:       case WallMove.up:\n109:         return from - columns >= 0 ? from - columns : -1;\n110:       case WallMove.down:\n111:         return from + columns < tiles ? from + columns : -1;\n112:     }\n113:   }\n114: \n115:   /// Applies [move] from the current slot; returns the new index or `-1`.\n116:   int moveFrom(int from, WallMove move) {\n117:     final int target = targetFor(\n118:       from,\n119:       move,\n120:       columns: _activeColumns,\n121:       tiles: _activeTiles,\n122:     );\n123:     if (target < 0) {\n124:       return -1;\n125:     }\n126:     focusTile(target);\n127:     return target;\n128:   }\n129: \n130:   /// Translates an arrow key press into a wall move.\n131:   ///\n132:   /// Returns true when the event was consumed (an arrow key), false\n133:   /// otherwise so other keys can keep bubbling.\n134:   bool handleArrow(LogicalKeyboardKey key) {\n135:     final WallMove? move = switch (key) {\n136:       LogicalKeyboardKey.arrowLeft => WallMove.left,\n137:       LogicalKeyboardKey.arrowRight => WallMove.right,\n138:       LogicalKeyboardKey.arrowUp => WallMove.up,\n139:       LogicalKeyboardKey.arrowDown => WallMove.down,\n140:       _ => null,\n141:     };\n142:     if (move == null) {\n143:       return false;\n144:     }\n145:     final int from = _focusedIndex;\n146:     if (from < 0) {\n147:       focusTile(0);\n148:       return true;\n149:     }\n150:     moveFrom(from, move);\n151:     return true;\n152:   }\n153: \n154:   /// Releases every focus node.\n155:   void dispose() {\n156:     for (final FocusNode node in _nodes) {\n157:       node.dispose();\n158:     }\n159:   }\n160: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3ea77731496ce57ae98a762e9"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_focus.dart\"}"},"time":{"start":1793463675547,"end":1793463676755}}}}
{"type":"tool_use","timestamp":1793463676756,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c3ed72001kx1qJcTVi7IJFs","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c3a16c0013OO8hWzzdE5xMW","type":"tool","id":"call_01a192c3ed4b70828149c83e0dbf7079","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/wall_boot_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/wall_boot_test.dart, lines 1-673\n1: /// Boot sequence tests: registry -> channel -> manifest (no UI).\n2: ///\n3: /// All hash assertions run through the real prod paths: manifests carry\n4: /// `sha256Hex(realBytes)` digests computed by `core_cache`, and every boot\n5: /// goes through the real `WallBoot.boot()` including byte verification.\n6: library;\n7: \n8: import 'dart:convert';\n9: import 'dart:io';\n10: \n11: import 'package:channel_cctv/channel_cctv.dart';\n12: import 'package:core_cache/core_cache.dart';\n13: import 'package:core_playlist/core_playlist.dart';\n14: import 'package:flutter/widgets.dart';\n15: import 'package:flutter_test/flutter_test.dart';\n16: import 'package:infra_settings/infra_settings.dart' show InMemorySettings;\n17: import 'package:kernel_app/kernel_app.dart';\n18: import 'package:tv_app/src/wall/wall_boot.dart';\n19: \n20: import 'support/fakes.dart';\n21: \n22: const List<String> _cameras = <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'];\n23: \n24: /// Deterministic stand-in for bundled clip bytes (per-camera, distinct).\n25: List<int> _bytesFor(String cameraId) =>\n26:     utf8.encode('halloween-tv-offline-bytes@$cameraId#' * 8);\n27: \n28: /// Real manifest whose digests match [bytesByAsset] byte-for-byte.\n29: PlaybackManifest _manifestFor(\n30:   Map<String, List<int>> bytesByAsset, {\n31:   String partyId = 'local-party',\n32:   String channelId = hauntedSurveillanceChannelId,\n33:   int version = 1,\n34: }) {\n35:   return PlaybackManifest(\n36:     partyId: partyId,\n37:     channelId: channelId,\n38:     version: version,\n39:     clips: <ClipDescriptor>[\n40:       for (var i = 0; i < _cameras.length; i++)\n41:         ClipDescriptor(\n42:           id: _cameras[i],\n43:           cameraId: _cameras[i],\n44:           storageObjectId: 'assets/cam0${i + 1}.mp4',\n45:           sha256: sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n46:           sizeBytes: bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n47:           duration: const Duration(seconds: 2),\n48:           mimeType: 'video/mp4',\n49:         ),\n50:     ],\n51:     publishedAt: DateTime.utc(2026, 10, 31, 20),\n52:   );\n53: }\n54: \n55: Map<String, List<int>> _realBytes() => <String, List<int>>{\n56:   'assets/cam01.mp4': _bytesFor('CAM-01'),\n57:   'assets/cam02.mp4': _bytesFor('CAM-02'),\n58:   'assets/cam03.mp4': _bytesFor('CAM-03'),\n59:   'assets/cam04.mp4': _bytesFor('CAM-04'),\n60: };\n61: \n62: WallAssetBytesLoader _bytesLoader(Map<String, List<int>> bytesByAsset) =>\n63:     (String path) async {\n64:       final bytes = bytesByAsset[path];\n65:       if (bytes == null) {\n66:         throw StateError('no bundled bytes for $path');\n67:       }\n68:       return bytes;\n69:     };\n70: \n71: WallBoot _bootWith({\n72:   required Map<String, List<int>> bytesByAsset,\n73:   required PlaybackManifest fixtureManifest,\n74:   InMemoryManifestStore? store,\n75:   String partyId = 'local-party',\n76:   WallBundleLoader? bundleLoader,\n77: }) {\n78:   return WallBoot(\n79:     store: store ?? InMemoryManifestStore(),\n80:     partyId: partyId,\n81:     fixtureLoader:\n82:         ({required String partyId, required String channelId}) async =>\n83:             fixtureManifest,\n84:     assetBytesLoader: _bytesLoader(bytesByAsset),\n85:     bundleLoader:\n86:         bundleLoader ??\n87:         ((String key) async => throw StateError('no bundle in unit tests')),\n88:   );\n89: }\n90: \n91: void main() {\n92:   TestWidgetsFlutterBinding.ensureInitialized();\n93: \n94:   group('WallBoot', () {\n95:     test(\n96:       'restores effects-disabled setting from the party-scoped port',\n97:       () async {\n98:         final Map<String, List<int>> bytesByAsset = _realBytes();\n99:         final InMemorySettings settings = InMemorySettings();\n100:         await settings.setBool(\n101:           partyId: PartyId('local-party'),\n102:           key: CctvWallSettingsKeys.effectsDisabled,\n103:           value: true,\n104:         );\n105:         final WallBoot boot = WallBoot(\n106:           store: InMemoryManifestStore(),\n107:           settings: settings,\n108:           fixture: ({required String partyId, required String channelId}) =>\n109:               _manifestFor(\n110:                 bytesByAsset,\n111:                 partyId: partyId,\n112:                 channelId: channelId,\n113:               ),\n114:           assetBytesLoader: _bytesLoader(bytesByAsset),\n115:           bundleLoader: (_) async =>\n116:               throw StateError('fixture override is used'),\n117:         );\n118: \n119:         final result = await boot.boot();\n120: \n121:         expect(result.isReady, isTrue, reason: result.unavailableReason);\n122:         expect(result.initialEffectsDisabled, isTrue);\n123:         expect(\n124:           await settings.getBool(\n125:             partyId: PartyId('someone-else'),\n126:             key: CctvWallSettingsKeys.effectsDisabled,\n127:           ),\n128:           isNull,\n129:         );\n130:       },\n131:     );\n132: \n133:     test('boots from the bundled fixture when bytes verify', () async {\n134:       final bytesByAsset = _realBytes();\n135:       final fixture = _manifestFor(bytesByAsset);\n136:       final store = InMemoryManifestStore();\n137:       final boot = _bootWith(\n138:         bytesByAsset: bytesByAsset,\n139:         fixtureManifest: fixture,\n140:         store: store,\n141:       );\n142: \n143:       final result = await boot.boot();\n144: \n145:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n146:       final ChannelRegistry registry = result.registry!;\n147:       expect(registry.allIds, contains(hauntedSurveillanceChannelId));\n148:       // Retro stub is registered (visible to the kernel) but never resolved\n149:       // or built, so the wall stays the CCTV wall.\n150:       expect(registry.allIds, hasLength(2));\n151: \n152:       final ChannelPlugin plugin = result.plugin!;\n153:       expect(plugin.descriptor.id, hauntedSurveillanceChannelId);\n154:       expect(plugin.descriptor.capabilities.videoPlayback, isTrue);\n155:       expect(plugin.descriptor.capabilities.effects, isTrue);\n156: \n157:       final PlaybackManifest manifest = result.manifest!;\n158:       expect(result.usedCachedManifest, isFalse);\n159:       expect(\n160:         validateCctvManifest(manifest).isOk,\n161:         isTrue,\n162:         reason: 'boot must hand the wall a valid manifest',\n163:       );\n164:       expect(manifest.clips.map((ClipDescriptor c) => c.cameraId), <String>[\n165:         'CAM-01',\n166:         'CAM-02',\n167:         'CAM-03',\n168:         'CAM-04',\n169:       ]);\n170:       // The fixture is persisted so the next cold start restores a wall.\n171:       expect(store.writes, 1);\n172:       expect(store.stored!.version, manifest.version);\n173:     });\n174: \n175:     test('parses the gen_fixtures.sh offline shape end to end', () async {\n176:       final bytesByAsset = _realBytes();\n177:       final shape = <String, Object?>{\n178:         'clips': <Object?>[\n179:           for (var i = 0; i < _cameras.length; i++)\n180:             <String, Object?>{\n181:               'cameraId': _cameras[i],\n182:               'sha256': sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n183:               'sizeBytes': bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n184:               'durationMs': 2000,\n185:               'asset': 'assets/cam0${i + 1}.mp4',\n186:             },\n187:         ],\n188:       };\n189:       final parsed = parseFixtureManifestJson(\n190:         shape,\n191:         partyId: 'local-party',\n192:         channelId: hauntedSurveillanceChannelId,\n193:       );\n194:       expect(validateCctvManifest(parsed).isOk, isTrue);\n195:       expect(parsed.clips.map((c) => c.id), <String>[\n196:         'clip-01',\n197:         'clip-02',\n198:         'clip-03',\n199:         'clip-04',\n200:       ]);\n201: \n202:       final store = InMemoryManifestStore();\n203:       final boot = _bootWith(\n204:         bytesByAsset: bytesByAsset,\n205:         fixtureManifest: parsed,\n206:         store: store,\n207:       );\n208:       final result = await boot.boot();\n209:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n210:       expect(result.manifest!.clips.map((c) => c.cameraId), <String>[\n211:         'CAM-01',\n212:         'CAM-02',\n213:         'CAM-03',\n214:         'CAM-04',\n215:       ]);\n216:     });\n217: \n218:     test('restores the last cached manifest instead of the fixture', () async {\n219:       final bytesByAsset = _realBytes();\n220:       final cached = _manifestFor(bytesByAsset, version: 7);\n221:       final fixture = _manifestFor(bytesByAsset, version: 1);\n222:       final store = InMemoryManifestStore(cached);\n223: \n224:       final result = await _bootWith(\n225:         bytesByAsset: bytesByAsset,\n226:         fixtureManifest: fixture,\n227:         store: store,\n228:       ).boot();\n229: \n230:       expect(result.isReady, isTrue);\n231:       expect(result.usedCachedManifest, isTrue);\n232:       expect(result.manifest!.version, 7);\n233:       expect(store.writes, 0, reason: 'a cached wall must not be rewritten');\n234:     });\n235: \n236:     test('rejects a cached manifest for another party', () async {\n237:       final bytesByAsset = _realBytes();\n238:       final cached = _manifestFor(\n239:         bytesByAsset,\n240:         partyId: 'someone-elses-party',\n241:         version: 7,\n242:       );\n243:       final fixture = _manifestFor(bytesByAsset, version: 3);\n244:       final store = InMemoryManifestStore(cached);\n245: \n246:       final result = await _bootWith(\n247:         bytesByAsset: bytesByAsset,\n248:         fixtureManifest: fixture,\n249:         store: store,\n250:       ).boot();\n251: \n252:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n253:       expect(result.usedCachedManifest, isFalse);\n254:       expect(result.manifest!.version, 3);\n255:       expect(result.manifest!.partyId, 'local-party');\n256:     });\n257: \n258:     test('rejects a cached manifest for another channel', () async {\n259:       final bytesByAsset = _realBytes();\n260:       final cached = _manifestFor(\n261:         bytesByAsset,\n262:         channelId: 'retro_horror_test',\n263:         version: 7,\n264:       );\n265:       final fixture = _manifestFor(bytesByAsset, version: 3);\n266:       final store = InMemoryManifestStore(cached);\n267: \n268:       final result = await _bootWith(\n269:         bytesByAsset: bytesByAsset,\n270:         fixtureManifest: fixture,\n271:         store: store,\n272:       ).boot();\n273: \n274:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n275:       expect(result.usedCachedManifest, isFalse);\n276:       expect(result.manifest!.channelId, hauntedSurveillanceChannelId);\n277:     });\n278: \n279:     test('fails closed on a tampered bundled sha256', () async {\n280:       final bytesByAsset = _realBytes();\n281:       final good = _manifestFor(bytesByAsset);\n282:       final tamperedCam02 = List<int>.of(bytesByAsset['assets/cam02.mp4']!);\n283:       tamperedCam02[0] ^= 0xff;\n284:       final tamperedBytes = Map<String, List<int>>.of(bytesByAsset)\n285:         ..['assets/cam02.mp4'] = tamperedCam02;\n286:       final store = InMemoryManifestStore();\n287: \n288:       final result = await _bootWith(\n289:         bytesByAsset: tamperedBytes,\n290:         fixtureManifest: good,\n291:         store: store,\n292:       ).boot();\n293: \n294:       expect(result.isReady, isFalse);\n295:       expect(result.unavailableReason, contains('hash mismatch'));\n296:       expect(result.manifest, isNull);\n297:       expect(store.writes, 0, reason: 'tampered bytes must not be cached');\n298:     });\n299: \n300:     test('fails closed when verified bytes differ from played bytes', () async {\n301:       // Swapped-asset manifest: CAM-01 names cam04's file and carries\n302:       // cam04's digest/size, so the named file verifies byte-for-byte —\n303:       // but tiles play assetPathForCamera (cam01), not the manifest's\n304:       // storage reference. Boot must reject (unavailable), not play\n305:       // unverified bytes.\n306:       final bytesByAsset = _realBytes();\n307:       final rest = _manifestFor(bytesByAsset).clips.skip(1);\n308:       final swapped = PlaybackManifest(\n309:         partyId: 'local-party',\n310:         channelId: hauntedSurveillanceChannelId,\n311:         version: 1,\n312:         clips: <ClipDescriptor>[\n313:           ClipDescriptor(\n314:             id: 'CAM-01',\n315:             cameraId: 'CAM-01',\n316:             storageObjectId: 'assets/cam04.mp4',\n317:             sha256: sha256Hex(bytesByAsset['assets/cam04.mp4']!),\n318:             sizeBytes: bytesByAsset['assets/cam04.mp4']!.length,\n319:             duration: const Duration(seconds: 2),\n320:             mimeType: 'video/mp4',\n321:           ),\n322:           ...rest,\n323:         ],\n324:         publishedAt: DateTime.utc(2026, 10, 31, 20),\n325:       );\n326:       // Sanity: the swapped manifest is contract-valid, so only the\n327:       // verified/played-byte identity check can reject it.\n328:       expect(validateCctvManifest(swapped).isOk, isTrue);\n329:       final store = InMemoryManifestStore();\n330: \n331:       final result = await _bootWith(\n332:         bytesByAsset: bytesByAsset,\n333:         fixtureManifest: swapped,\n334:         store: store,\n335:       ).boot();\n336: \n337:       expect(result.isReady, isFalse);\n338:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n339:       expect(result.manifest, isNull);\n340:       expect(store.writes, 0, reason: 'swapped bytes must not be cached');\n341:     });\n342: \n343:     test('fails closed on a tampered bundled size', () async {\n344:       final bytesByAsset = _realBytes();\n345:       final good = _manifestFor(bytesByAsset);\n346:       final wrongSize = PlaybackManifest(\n347:         partyId: good.partyId,\n348:         channelId: good.channelId,\n349:         version: good.version,\n350:         clips: <ClipDescriptor>[\n351:           for (final c in good.clips)\n352:             c.cameraId == 'CAM-03'\n353:                 ? ClipDescriptor(\n354:                     id: c.id,\n355:                     cameraId: c.cameraId,\n356:                     storageObjectId: c.storageObjectId,\n357:                     sha256: c.sha256,\n358:                     sizeBytes: c.sizeBytes + 1,\n359:                     duration: c.duration,\n360:                     mimeType: c.mimeType,\n361:                   )\n362:                 : c,\n363:         ],\n364:         publishedAt: good.publishedAt,\n365:       );\n366:       final store = InMemoryManifestStore();\n367: \n368:       final result = await _bootWith(\n369:         bytesByAsset: bytesByAsset,\n370:         fixtureManifest: wrongSize,\n371:         store: store,\n372:       ).boot();\n373: \n374:       expect(result.isReady, isFalse);\n375:       expect(result.unavailableReason, contains('hash mismatch'));\n376:       expect(store.writes, 0);\n377:     });\n378: \n379:     test('fails closed when the cached bytes no longer verify', () async {\n380:       final bytesByAsset = _realBytes();\n381:       final cached = _manifestFor(bytesByAsset, version: 7);\n382:       // Cached manifest was valid when written, but the bundled bytes changed\n383:       // (or were corrupted): the wall must fall back, not play stale hashes.\n384:       final rotated = Map<String, List<int>>.of(bytesByAsset)\n385:         ..['assets/cam01.mp4'] = utf8.encode('rotated-clip-bytes' * 16);\n386:       final store = InMemoryManifestStore(cached);\n387: \n388:       final result = await _bootWith(\n389:         bytesByAsset: rotated,\n390:         fixtureManifest: _manifestFor(rotated, version: 1),\n391:         store: store,\n392:       ).boot();\n393: \n394:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n395:       expect(result.usedCachedManifest, isFalse);\n396:       expect(result.manifest!.version, 1);\n397:     });\n398: \n399:     test('a corrupt cached manifest falls back to the fixture', () async {\n400:       final bytesByAsset = _realBytes();\n401:       final good = _manifestFor(bytesByAsset);\n402:       final threeClips = PlaybackManifest(\n403:         partyId: good.partyId,\n404:         channelId: good.channelId,\n405:         version: 2,\n406:         clips: good.clips.take(3).toList(),\n407:         publishedAt: good.publishedAt,\n408:       );\n409:       final store = InMemoryManifestStore(threeClips);\n410: \n411:       final result = await _bootWith(\n412:         bytesByAsset: bytesByAsset,\n413:         fixtureManifest: good,\n414:         store: store,\n415:       ).boot();\n416: \n417:       expect(result.isReady, isTrue);\n418:       expect(result.usedCachedManifest, isFalse);\n419:       expect(result.manifest!.clips, hasLength(4));\n420:       expect(store.writes, 1, reason: 'the repaired wall is re-cached');\n421:     });\n422: \n423:     test('reports unavailable when the bundle file is missing', () async {\n424:       final store = InMemoryManifestStore();\n425:       final boot = WallBoot(\n426:         store: store,\n427:         assetBytesLoader: _bytesLoader(_realBytes()),\n428:         bundleLoader: (String key) async =>\n429:             throw StateError('bundle asset missing: $key'),\n430:       );\n431: \n432:       final result = await boot.boot();\n433: \n434:       expect(result.isReady, isFalse);\n435:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n436:       expect(store.writes, 0);\n437:     });\n438: \n439:     test('reports no wall when the channel is not registered', () async {\n440:       final bytesByAsset = _realBytes();\n441:       final boot = WallBoot(\n442:         store: InMemoryManifestStore(),\n443:         registryFactory: _retroOnlyRegistry,\n444:         fixtureLoader:\n445:             ({required String partyId, required String channelId}) async =>\n446:                 _manifestFor(bytesByAsset),\n447:         assetBytesLoader: _bytesLoader(bytesByAsset),\n448:       );\n449: \n450:       final result = await boot.boot();\n451: \n452:       expect(result.isReady, isFalse);\n453:       expect(result.unavailableReason, contains('NO WALL'));\n454:       expect(result.unavailableReason, contains(hauntedSurveillanceChannelId));\n455:       expect(result.manifest, isNull);\n456:     });\n457: \n458:     test(\n459:       'reports no wall when even the fixture violates the CCTV contract',\n460:       () async {\n461:         final boot = WallBoot(\n462:           store: InMemoryManifestStore(),\n463:           fixture: ({required String partyId, required String channelId}) =>\n464:               PlaybackManifest(\n465:                 partyId: partyId,\n466:                 channelId: channelId,\n467:                 version: 1,\n468:                 clips: const <ClipDescriptor>[],\n469:                 publishedAt: DateTime.utc(2026, 10, 31),\n470:               ),\n471:           assetBytesLoader: _bytesLoader(_realBytes()),\n472:         );\n473: \n474:         final result = await boot.boot();\n475: \n476:         expect(result.isReady, isFalse);\n477:         expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n478:       },\n479:     );\n480: \n481:     test('survives a broken manifest store', () async {\n482:       final bytesByAsset = _realBytes();\n483:       final store = InMemoryManifestStore()..failReads = true;\n484: \n485:       final result = await _bootWith(\n486:         bytesByAsset: bytesByAsset,\n487:         fixtureManifest: _manifestFor(bytesByAsset),\n488:         store: store,\n489:       ).boot();\n490: \n491:       expect(result.isReady, isTrue);\n492:       expect(result.usedCachedManifest, isFalse);\n493:     });\n494: \n495:     test('readCached ignores invalid cached manifests', () async {\n496:       final bytesByAsset = _realBytes();\n497:       final good = _manifestFor(bytesByAsset);\n498:       final store = InMemoryManifestStore(\n499:         // Three clips is not a supported layout (1, 2, or 4): a two-clip\n500:         // prefix manifest WOULD be valid here, so the invalid shape must\n501:         // use an unsupported count.\n502:         PlaybackManifest(\n503:           partyId: good.partyId,\n504:           channelId: good.channelId,\n505:           version: 1,\n506:           clips: good.clips.take(3).toList(),\n507:           publishedAt: good.publishedAt,\n508:         ),\n509:       );\n510:       final boot = _bootWith(\n511:         bytesByAsset: bytesByAsset,\n512:         fixtureManifest: good,\n513:         store: store,\n514:       );\n515: \n516:       expect(await boot.readCached(), isNull);\n517: \n518:       store.stored = _manifestFor(bytesByAsset, version: 4);\n519:       expect((await boot.readCached())!.version, 4);\n520:     });\n521: \n522:     test('readCached rejects other-party manifests', () async {\n523:       final bytesByAsset = _realBytes();\n524:       final store = InMemoryManifestStore(\n525:         _manifestFor(bytesByAsset, partyId: 'intruder-party', version: 4),\n526:       );\n527:       final boot = _bootWith(\n528:         bytesByAsset: bytesByAsset,\n529:         fixtureManifest: _manifestFor(bytesByAsset),\n530:         store: store,\n531:       );\n532: \n533:       expect(await boot.readCached(), isNull);\n534:     });\n535: \n536:     test('sha256Hex matches the real committed cam01 bytes', () async {\n537:       final manifestFile = File('assets/fixture_manifest.json');\n538:       expect(\n539:         await manifestFile.exists(),\n540:         isTrue,\n541:         reason: 'run from the tv_app package directory',\n542:       );\n543:       final manifestJson =\n544:           jsonDecode(await manifestFile.readAsString()) as Map<String, Object?>;\n545:       final clips = (manifestJson['clips'] as List)\n546:           .cast<Map<String, Object?>>();\n547:       final cam01 = clips.singleWhere(\n548:         (c) => c['cameraId'] == 'CAM-01',\n549:         orElse: () =>\n550:             throw StateError('CAM-01 missing from fixture_manifest.json'),\n551:       );\n552:       final expectedSize = cam01['sizeBytes'] as int;\n553:       final expectedSha = cam01['sha256'] as String;\n554:       final file = File('assets/cam01.mp4');\n555:       expect(\n556:         await file.exists(),\n557:         isTrue,\n558:         reason: 'run from the tv_app package directory',\n559:       );\n560:       final bytes = await file.readAsBytes();\n561:       expect(\n562:         bytes.length,\n563:         expectedSize,\n564:         reason:\n565:             'on-disk cam01 bytes must match the committed fixture_manifest.json',\n566:       );\n567:       expect(\n568:         sha256Hex(bytes),\n569:         expectedSha,\n570:         reason:\n571:             'on-disk cam01 bytes must match the committed fixture_manifest.json',\n572:       );\n573:       // Negative control: the comparison above is not a tautology — tampered\n574:       // bytes must disagree with the committed manifest entry.\n575:       final tampered = List<int>.of(bytes);\n576:       tampered[0] ^= 0xff;\n577:       expect(\n578:         sha256Hex(tampered),\n579:         isNot(equals(expectedSha)),\n580:         reason: 'tampered bytes must mismatch the manifest sha256',\n581:       );\n582:       expect(\n583:         tampered.length + 1,\n584:         isNot(equals(expectedSize)),\n585:         reason: 'a wrong size must mismatch the manifest sizeBytes',\n586:       );\n587:     });\n588: \n589:     test('boots the real committed fixture manifest end to end', () async {\n590:       // Real-artifact path: the committed assets/fixture_manifest.json flows\n591:       // through the prod loaders (loadBundledFixtureManifest /\n592:       // parseFixtureManifestJson), validates, and verifies all four clips\n593:       // against file-backed asset bytes through the real WallBoot.boot.\n594:       final manifestFile = File('assets/fixture_manifest.json');\n595:       expect(\n596:         await manifestFile.exists(),\n597:         isTrue,\n598:         reason: 'run from the tv_app package directory',\n599:       );\n600:       final String raw = await manifestFile.readAsString();\n601:       final PlaybackManifest parsed = await loadBundledFixtureManifest(\n602:         partyId: 'local-party',\n603:         channelId: hauntedSurveillanceChannelId,\n604:         loader: (String key) async {\n605:           expect(key, kBundledFixtureManifestKey);\n606:           return raw;\n607:         },\n608:       );\n609:       expect(\n610:         validateCctvManifest(parsed).isOk,\n611:         isTrue,\n612:         reason: 'committed fixture must satisfy the CCTV contract',\n613:       );\n614:       expect(parsed.clips.map((ClipDescriptor c) => c.cameraId), <String>[\n615:         'CAM-01',\n616:         'CAM-02',\n617:         'CAM-03',\n618:         'CAM-04',\n619:       ]);\n620: \n621:       Future<List<int>> fileBytes(String assetPath) =>\n622:           File(assetPath).readAsBytes();\n623:       final store = InMemoryManifestStore();\n624:       final boot = WallBoot(\n625:         store: store,\n626:         fixtureLoader:\n627:             ({required String partyId, required String channelId}) async =>\n628:                 parsed,\n629:         assetBytesLoader: fileBytes,\n630:       );\n631:       final result = await boot.boot();\n632:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n633:       expect(result.manifest!.clips, hasLength(4));\n634:       // Every committed clip file exists and matches its manifest entry.\n635:       for (final ClipDescriptor clip in result.manifest!.clips) {\n636:         final List<int> bytes = await File(clip.storageObjectId).readAsBytes();\n637:         expect(\n638:           bytes.length,\n639:           clip.sizeBytes,\n640:           reason: '${clip.cameraId} on-disk size must match the manifest',\n641:         );\n642:         expect(\n643:           sha256Hex(bytes),\n644:           clip.sha256,\n645:           reason: '${clip.cameraId} on-disk sha must match the manifest',\n646:         );\n647:       }\n648:       // The bundle key boot loads by default is the pubspec asset entry.\n649:       final String pubspec = await File('pubspec.yaml').readAsString();\n650:       expect(pubspec, contains(kBundledFixtureManifestKey));\n651:     });\n652:   });\n653: }\n654: \n655: ChannelRegistry _retroOnlyRegistry() {\n656:   final ChannelRegistry registry = ChannelRegistry();\n657:   // Only the inactive retro stub: resolving the CCTV channel must fail.\n658:   registry.register(_ChannelPluginStub());\n659:   return registry;\n660: }\n661: \n662: /// Minimal plugin used to build a registry without the CCTV channel.\n663: final class _ChannelPluginStub implements ChannelPlugin {\n664:   @override\n665:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n666:     id: 'retro_horror_test',\n667:     title: 'Retro',\n668:     version: 1,\n669:   );\n670: \n671:   @override\n672:   Widget build(ChannelContext context) => const SizedBox.shrink();\n673: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/wall_boot_test.dart, lines 1-673\n1: /// Boot sequence tests: registry -> channel -> manifest (no UI).\n2: ///\n3: /// All hash assertions run through the real prod paths: manifests carry\n4: /// `sha256Hex(realBytes)` digests computed by `core_cache`, and every boot\n5: /// goes through the real `WallBoot.boot()` including byte verification.\n6: library;\n7: \n8: import 'dart:convert';\n9: import 'dart:io';\n10: \n11: import 'package:channel_cctv/channel_cctv.dart';\n12: import 'package:core_cache/core_cache.dart';\n13: import 'package:core_playlist/core_playlist.dart';\n14: import 'package:flutter/widgets.dart';\n15: import 'package:flutter_test/flutter_test.dart';\n16: import 'package:infra_settings/infra_settings.dart' show InMemorySettings;\n17: import 'package:kernel_app/kernel_app.dart';\n18: import 'package:tv_app/src/wall/wall_boot.dart';\n19: \n20: import 'support/fakes.dart';\n21: \n22: const List<String> _cameras = <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'];\n23: \n24: /// Deterministic stand-in for bundled clip bytes (per-camera, distinct).\n25: List<int> _bytesFor(String cameraId) =>\n26:     utf8.encode('halloween-tv-offline-bytes@$cameraId#' * 8);\n27: \n28: /// Real manifest whose digests match [bytesByAsset] byte-for-byte.\n29: PlaybackManifest _manifestFor(\n30:   Map<String, List<int>> bytesByAsset, {\n31:   String partyId = 'local-party',\n32:   String channelId = hauntedSurveillanceChannelId,\n33:   int version = 1,\n34: }) {\n35:   return PlaybackManifest(\n36:     partyId: partyId,\n37:     channelId: channelId,\n38:     version: version,\n39:     clips: <ClipDescriptor>[\n40:       for (var i = 0; i < _cameras.length; i++)\n41:         ClipDescriptor(\n42:           id: _cameras[i],\n43:           cameraId: _cameras[i],\n44:           storageObjectId: 'assets/cam0${i + 1}.mp4',\n45:           sha256: sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n46:           sizeBytes: bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n47:           duration: const Duration(seconds: 2),\n48:           mimeType: 'video/mp4',\n49:         ),\n50:     ],\n51:     publishedAt: DateTime.utc(2026, 10, 31, 20),\n52:   );\n53: }\n54: \n55: Map<String, List<int>> _realBytes() => <String, List<int>>{\n56:   'assets/cam01.mp4': _bytesFor('CAM-01'),\n57:   'assets/cam02.mp4': _bytesFor('CAM-02'),\n58:   'assets/cam03.mp4': _bytesFor('CAM-03'),\n59:   'assets/cam04.mp4': _bytesFor('CAM-04'),\n60: };\n61: \n62: WallAssetBytesLoader _bytesLoader(Map<String, List<int>> bytesByAsset) =>\n63:     (String path) async {\n64:       final bytes = bytesByAsset[path];\n65:       if (bytes == null) {\n66:         throw StateError('no bundled bytes for $path');\n67:       }\n68:       return bytes;\n69:     };\n70: \n71: WallBoot _bootWith({\n72:   required Map<String, List<int>> bytesByAsset,\n73:   required PlaybackManifest fixtureManifest,\n74:   InMemoryManifestStore? store,\n75:   String partyId = 'local-party',\n76:   WallBundleLoader? bundleLoader,\n77: }) {\n78:   return WallBoot(\n79:     store: store ?? InMemoryManifestStore(),\n80:     partyId: partyId,\n81:     fixtureLoader:\n82:         ({required String partyId, required String channelId}) async =>\n83:             fixtureManifest,\n84:     assetBytesLoader: _bytesLoader(bytesByAsset),\n85:     bundleLoader:\n86:         bundleLoader ??\n87:         ((String key) async => throw StateError('no bundle in unit tests')),\n88:   );\n89: }\n90: \n91: void main() {\n92:   TestWidgetsFlutterBinding.ensureInitialized();\n93: \n94:   group('WallBoot', () {\n95:     test(\n96:       'restores effects-disabled setting from the party-scoped port',\n97:       () async {\n98:         final Map<String, List<int>> bytesByAsset = _realBytes();\n99:         final InMemorySettings settings = InMemorySettings();\n100:         await settings.setBool(\n101:           partyId: PartyId('local-party'),\n102:           key: CctvWallSettingsKeys.effectsDisabled,\n103:           value: true,\n104:         );\n105:         final WallBoot boot = WallBoot(\n106:           store: InMemoryManifestStore(),\n107:           settings: settings,\n108:           fixture: ({required String partyId, required String channelId}) =>\n109:               _manifestFor(\n110:                 bytesByAsset,\n111:                 partyId: partyId,\n112:                 channelId: channelId,\n113:               ),\n114:           assetBytesLoader: _bytesLoader(bytesByAsset),\n115:           bundleLoader: (_) async =>\n116:               throw StateError('fixture override is used'),\n117:         );\n118: \n119:         final result = await boot.boot();\n120: \n121:         expect(result.isReady, isTrue, reason: result.unavailableReason);\n122:         expect(result.initialEffectsDisabled, isTrue);\n123:         expect(\n124:           await settings.getBool(\n125:             partyId: PartyId('someone-else'),\n126:             key: CctvWallSettingsKeys.effectsDisabled,\n127:           ),\n128:           isNull,\n129:         );\n130:       },\n131:     );\n132: \n133:     test('boots from the bundled fixture when bytes verify', () async {\n134:       final bytesByAsset = _realBytes();\n135:       final fixture = _manifestFor(bytesByAsset);\n136:       final store = InMemoryManifestStore();\n137:       final boot = _bootWith(\n138:         bytesByAsset: bytesByAsset,\n139:         fixtureManifest: fixture,\n140:         store: store,\n141:       );\n142: \n143:       final result = await boot.boot();\n144: \n145:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n146:       final ChannelRegistry registry = result.registry!;\n147:       expect(registry.allIds, contains(hauntedSurveillanceChannelId));\n148:       // Retro stub is registered (visible to the kernel) but never resolved\n149:       // or built, so the wall stays the CCTV wall.\n150:       expect(registry.allIds, hasLength(2));\n151: \n152:       final ChannelPlugin plugin = result.plugin!;\n153:       expect(plugin.descriptor.id, hauntedSurveillanceChannelId);\n154:       expect(plugin.descriptor.capabilities.videoPlayback, isTrue);\n155:       expect(plugin.descriptor.capabilities.effects, isTrue);\n156: \n157:       final PlaybackManifest manifest = result.manifest!;\n158:       expect(result.usedCachedManifest, isFalse);\n159:       expect(\n160:         validateCctvManifest(manifest).isOk,\n161:         isTrue,\n162:         reason: 'boot must hand the wall a valid manifest',\n163:       );\n164:       expect(manifest.clips.map((ClipDescriptor c) => c.cameraId), <String>[\n165:         'CAM-01',\n166:         'CAM-02',\n167:         'CAM-03',\n168:         'CAM-04',\n169:       ]);\n170:       // The fixture is persisted so the next cold start restores a wall.\n171:       expect(store.writes, 1);\n172:       expect(store.stored!.version, manifest.version);\n173:     });\n174: \n175:     test('parses the gen_fixtures.sh offline shape end to end', () async {\n176:       final bytesByAsset = _realBytes();\n177:       final shape = <String, Object?>{\n178:         'clips': <Object?>[\n179:           for (var i = 0; i < _cameras.length; i++)\n180:             <String, Object?>{\n181:               'cameraId': _cameras[i],\n182:               'sha256': sha256Hex(bytesByAsset['assets/cam0${i + 1}.mp4']!),\n183:               'sizeBytes': bytesByAsset['assets/cam0${i + 1}.mp4']!.length,\n184:               'durationMs': 2000,\n185:               'asset': 'assets/cam0${i + 1}.mp4',\n186:             },\n187:         ],\n188:       };\n189:       final parsed = parseFixtureManifestJson(\n190:         shape,\n191:         partyId: 'local-party',\n192:         channelId: hauntedSurveillanceChannelId,\n193:       );\n194:       expect(validateCctvManifest(parsed).isOk, isTrue);\n195:       expect(parsed.clips.map((c) => c.id), <String>[\n196:         'clip-01',\n197:         'clip-02',\n198:         'clip-03',\n199:         'clip-04',\n200:       ]);\n201: \n202:       final store = InMemoryManifestStore();\n203:       final boot = _bootWith(\n204:         bytesByAsset: bytesByAsset,\n205:         fixtureManifest: parsed,\n206:         store: store,\n207:       );\n208:       final result = await boot.boot();\n209:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n210:       expect(result.manifest!.clips.map((c) => c.cameraId), <String>[\n211:         'CAM-01',\n212:         'CAM-02',\n213:         'CAM-03',\n214:         'CAM-04',\n215:       ]);\n216:     });\n217: \n218:     test('restores the last cached manifest instead of the fixture', () async {\n219:       final bytesByAsset = _realBytes();\n220:       final cached = _manifestFor(bytesByAsset, version: 7);\n221:       final fixture = _manifestFor(bytesByAsset, version: 1);\n222:       final store = InMemoryManifestStore(cached);\n223: \n224:       final result = await _bootWith(\n225:         bytesByAsset: bytesByAsset,\n226:         fixtureManifest: fixture,\n227:         store: store,\n228:       ).boot();\n229: \n230:       expect(result.isReady, isTrue);\n231:       expect(result.usedCachedManifest, isTrue);\n232:       expect(result.manifest!.version, 7);\n233:       expect(store.writes, 0, reason: 'a cached wall must not be rewritten');\n234:     });\n235: \n236:     test('rejects a cached manifest for another party', () async {\n237:       final bytesByAsset = _realBytes();\n238:       final cached = _manifestFor(\n239:         bytesByAsset,\n240:         partyId: 'someone-elses-party',\n241:         version: 7,\n242:       );\n243:       final fixture = _manifestFor(bytesByAsset, version: 3);\n244:       final store = InMemoryManifestStore(cached);\n245: \n246:       final result = await _bootWith(\n247:         bytesByAsset: bytesByAsset,\n248:         fixtureManifest: fixture,\n249:         store: store,\n250:       ).boot();\n251: \n252:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n253:       expect(result.usedCachedManifest, isFalse);\n254:       expect(result.manifest!.version, 3);\n255:       expect(result.manifest!.partyId, 'local-party');\n256:     });\n257: \n258:     test('rejects a cached manifest for another channel', () async {\n259:       final bytesByAsset = _realBytes();\n260:       final cached = _manifestFor(\n261:         bytesByAsset,\n262:         channelId: 'retro_horror_test',\n263:         version: 7,\n264:       );\n265:       final fixture = _manifestFor(bytesByAsset, version: 3);\n266:       final store = InMemoryManifestStore(cached);\n267: \n268:       final result = await _bootWith(\n269:         bytesByAsset: bytesByAsset,\n270:         fixtureManifest: fixture,\n271:         store: store,\n272:       ).boot();\n273: \n274:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n275:       expect(result.usedCachedManifest, isFalse);\n276:       expect(result.manifest!.channelId, hauntedSurveillanceChannelId);\n277:     });\n278: \n279:     test('fails closed on a tampered bundled sha256', () async {\n280:       final bytesByAsset = _realBytes();\n281:       final good = _manifestFor(bytesByAsset);\n282:       final tamperedCam02 = List<int>.of(bytesByAsset['assets/cam02.mp4']!);\n283:       tamperedCam02[0] ^= 0xff;\n284:       final tamperedBytes = Map<String, List<int>>.of(bytesByAsset)\n285:         ..['assets/cam02.mp4'] = tamperedCam02;\n286:       final store = InMemoryManifestStore();\n287: \n288:       final result = await _bootWith(\n289:         bytesByAsset: tamperedBytes,\n290:         fixtureManifest: good,\n291:         store: store,\n292:       ).boot();\n293: \n294:       expect(result.isReady, isFalse);\n295:       expect(result.unavailableReason, contains('hash mismatch'));\n296:       expect(result.manifest, isNull);\n297:       expect(store.writes, 0, reason: 'tampered bytes must not be cached');\n298:     });\n299: \n300:     test('fails closed when verified bytes differ from played bytes', () async {\n301:       // Swapped-asset manifest: CAM-01 names cam04's file and carries\n302:       // cam04's digest/size, so the named file verifies byte-for-byte —\n303:       // but tiles play assetPathForCamera (cam01), not the manifest's\n304:       // storage reference. Boot must reject (unavailable), not play\n305:       // unverified bytes.\n306:       final bytesByAsset = _realBytes();\n307:       final rest = _manifestFor(bytesByAsset).clips.skip(1);\n308:       final swapped = PlaybackManifest(\n309:         partyId: 'local-party',\n310:         channelId: hauntedSurveillanceChannelId,\n311:         version: 1,\n312:         clips: <ClipDescriptor>[\n313:           ClipDescriptor(\n314:             id: 'CAM-01',\n315:             cameraId: 'CAM-01',\n316:             storageObjectId: 'assets/cam04.mp4',\n317:             sha256: sha256Hex(bytesByAsset['assets/cam04.mp4']!),\n318:             sizeBytes: bytesByAsset['assets/cam04.mp4']!.length,\n319:             duration: const Duration(seconds: 2),\n320:             mimeType: 'video/mp4',\n321:           ),\n322:           ...rest,\n323:         ],\n324:         publishedAt: DateTime.utc(2026, 10, 31, 20),\n325:       );\n326:       // Sanity: the swapped manifest is contract-valid, so only the\n327:       // verified/played-byte identity check can reject it.\n328:       expect(validateCctvManifest(swapped).isOk, isTrue);\n329:       final store = InMemoryManifestStore();\n330: \n331:       final result = await _bootWith(\n332:         bytesByAsset: bytesByAsset,\n333:         fixtureManifest: swapped,\n334:         store: store,\n335:       ).boot();\n336: \n337:       expect(result.isReady, isFalse);\n338:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n339:       expect(result.manifest, isNull);\n340:       expect(store.writes, 0, reason: 'swapped bytes must not be cached');\n341:     });\n342: \n343:     test('fails closed on a tampered bundled size', () async {\n344:       final bytesByAsset = _realBytes();\n345:       final good = _manifestFor(bytesByAsset);\n346:       final wrongSize = PlaybackManifest(\n347:         partyId: good.partyId,\n348:         channelId: good.channelId,\n349:         version: good.version,\n350:         clips: <ClipDescriptor>[\n351:           for (final c in good.clips)\n352:             c.cameraId == 'CAM-03'\n353:                 ? ClipDescriptor(\n354:                     id: c.id,\n355:                     cameraId: c.cameraId,\n356:                     storageObjectId: c.storageObjectId,\n357:                     sha256: c.sha256,\n358:                     sizeBytes: c.sizeBytes + 1,\n359:                     duration: c.duration,\n360:                     mimeType: c.mimeType,\n361:                   )\n362:                 : c,\n363:         ],\n364:         publishedAt: good.publishedAt,\n365:       );\n366:       final store = InMemoryManifestStore();\n367: \n368:       final result = await _bootWith(\n369:         bytesByAsset: bytesByAsset,\n370:         fixtureManifest: wrongSize,\n371:         store: store,\n372:       ).boot();\n373: \n374:       expect(result.isReady, isFalse);\n375:       expect(result.unavailableReason, contains('hash mismatch'));\n376:       expect(store.writes, 0);\n377:     });\n378: \n379:     test('fails closed when the cached bytes no longer verify', () async {\n380:       final bytesByAsset = _realBytes();\n381:       final cached = _manifestFor(bytesByAsset, version: 7);\n382:       // Cached manifest was valid when written, but the bundled bytes changed\n383:       // (or were corrupted): the wall must fall back, not play stale hashes.\n384:       final rotated = Map<String, List<int>>.of(bytesByAsset)\n385:         ..['assets/cam01.mp4'] = utf8.encode('rotated-clip-bytes' * 16);\n386:       final store = InMemoryManifestStore(cached);\n387: \n388:       final result = await _bootWith(\n389:         bytesByAsset: rotated,\n390:         fixtureManifest: _manifestFor(rotated, version: 1),\n391:         store: store,\n392:       ).boot();\n393: \n394:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n395:       expect(result.usedCachedManifest, isFalse);\n396:       expect(result.manifest!.version, 1);\n397:     });\n398: \n399:     test('a corrupt cached manifest falls back to the fixture', () async {\n400:       final bytesByAsset = _realBytes();\n401:       final good = _manifestFor(bytesByAsset);\n402:       final threeClips = PlaybackManifest(\n403:         partyId: good.partyId,\n404:         channelId: good.channelId,\n405:         version: 2,\n406:         clips: good.clips.take(3).toList(),\n407:         publishedAt: good.publishedAt,\n408:       );\n409:       final store = InMemoryManifestStore(threeClips);\n410: \n411:       final result = await _bootWith(\n412:         bytesByAsset: bytesByAsset,\n413:         fixtureManifest: good,\n414:         store: store,\n415:       ).boot();\n416: \n417:       expect(result.isReady, isTrue);\n418:       expect(result.usedCachedManifest, isFalse);\n419:       expect(result.manifest!.clips, hasLength(4));\n420:       expect(store.writes, 1, reason: 'the repaired wall is re-cached');\n421:     });\n422: \n423:     test('reports unavailable when the bundle file is missing', () async {\n424:       final store = InMemoryManifestStore();\n425:       final boot = WallBoot(\n426:         store: store,\n427:         assetBytesLoader: _bytesLoader(_realBytes()),\n428:         bundleLoader: (String key) async =>\n429:             throw StateError('bundle asset missing: $key'),\n430:       );\n431: \n432:       final result = await boot.boot();\n433: \n434:       expect(result.isReady, isFalse);\n435:       expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n436:       expect(store.writes, 0);\n437:     });\n438: \n439:     test('reports no wall when the channel is not registered', () async {\n440:       final bytesByAsset = _realBytes();\n441:       final boot = WallBoot(\n442:         store: InMemoryManifestStore(),\n443:         registryFactory: _retroOnlyRegistry,\n444:         fixtureLoader:\n445:             ({required String partyId, required String channelId}) async =>\n446:                 _manifestFor(bytesByAsset),\n447:         assetBytesLoader: _bytesLoader(bytesByAsset),\n448:       );\n449: \n450:       final result = await boot.boot();\n451: \n452:       expect(result.isReady, isFalse);\n453:       expect(result.unavailableReason, contains('NO WALL'));\n454:       expect(result.unavailableReason, contains(hauntedSurveillanceChannelId));\n455:       expect(result.manifest, isNull);\n456:     });\n457: \n458:     test(\n459:       'reports no wall when even the fixture violates the CCTV contract',\n460:       () async {\n461:         final boot = WallBoot(\n462:           store: InMemoryManifestStore(),\n463:           fixture: ({required String partyId, required String channelId}) =>\n464:               PlaybackManifest(\n465:                 partyId: partyId,\n466:                 channelId: channelId,\n467:                 version: 1,\n468:                 clips: const <ClipDescriptor>[],\n469:                 publishedAt: DateTime.utc(2026, 10, 31),\n470:               ),\n471:           assetBytesLoader: _bytesLoader(_realBytes()),\n472:         );\n473: \n474:         final result = await boot.boot();\n475: \n476:         expect(result.isReady, isFalse);\n477:         expect(result.unavailableReason, contains('WALL UNAVAILABLE'));\n478:       },\n479:     );\n480: \n481:     test('survives a broken manifest store', () async {\n482:       final bytesByAsset = _realBytes();\n483:       final store = InMemoryManifestStore()..failReads = true;\n484: \n485:       final result = await _bootWith(\n486:         bytesByAsset: bytesByAsset,\n487:         fixtureManifest: _manifestFor(bytesByAsset),\n488:         store: store,\n489:       ).boot();\n490: \n491:       expect(result.isReady, isTrue);\n492:       expect(result.usedCachedManifest, isFalse);\n493:     });\n494: \n495:     test('readCached ignores invalid cached manifests', () async {\n496:       final bytesByAsset = _realBytes();\n497:       final good = _manifestFor(bytesByAsset);\n498:       final store = InMemoryManifestStore(\n499:         // Three clips is not a supported layout (1, 2, or 4): a two-clip\n500:         // prefix manifest WOULD be valid here, so the invalid shape must\n501:         // use an unsupported count.\n502:         PlaybackManifest(\n503:           partyId: good.partyId,\n504:           channelId: good.channelId,\n505:           version: 1,\n506:           clips: good.clips.take(3).toList(),\n507:           publishedAt: good.publishedAt,\n508:         ),\n509:       );\n510:       final boot = _bootWith(\n511:         bytesByAsset: bytesByAsset,\n512:         fixtureManifest: good,\n513:         store: store,\n514:       );\n515: \n516:       expect(await boot.readCached(), isNull);\n517: \n518:       store.stored = _manifestFor(bytesByAsset, version: 4);\n519:       expect((await boot.readCached())!.version, 4);\n520:     });\n521: \n522:     test('readCached rejects other-party manifests', () async {\n523:       final bytesByAsset = _realBytes();\n524:       final store = InMemoryManifestStore(\n525:         _manifestFor(bytesByAsset, partyId: 'intruder-party', version: 4),\n526:       );\n527:       final boot = _bootWith(\n528:         bytesByAsset: bytesByAsset,\n529:         fixtureManifest: _manifestFor(bytesByAsset),\n530:         store: store,\n531:       );\n532: \n533:       expect(await boot.readCached(), isNull);\n534:     });\n535: \n536:     test('sha256Hex matches the real committed cam01 bytes', () async {\n537:       final manifestFile = File('assets/fixture_manifest.json');\n538:       expect(\n539:         await manifestFile.exists(),\n540:         isTrue,\n541:         reason: 'run from the tv_app package directory',\n542:       );\n543:       final manifestJson =\n544:           jsonDecode(await manifestFile.readAsString()) as Map<String, Object?>;\n545:       final clips = (manifestJson['clips'] as List)\n546:           .cast<Map<String, Object?>>();\n547:       final cam01 = clips.singleWhere(\n548:         (c) => c['cameraId'] == 'CAM-01',\n549:         orElse: () =>\n550:             throw StateError('CAM-01 missing from fixture_manifest.json'),\n551:       );\n552:       final expectedSize = cam01['sizeBytes'] as int;\n553:       final expectedSha = cam01['sha256'] as String;\n554:       final file = File('assets/cam01.mp4');\n555:       expect(\n556:         await file.exists(),\n557:         isTrue,\n558:         reason: 'run from the tv_app package directory',\n559:       );\n560:       final bytes = await file.readAsBytes();\n561:       expect(\n562:         bytes.length,\n563:         expectedSize,\n564:         reason:\n565:             'on-disk cam01 bytes must match the committed fixture_manifest.json',\n566:       );\n567:       expect(\n568:         sha256Hex(bytes),\n569:         expectedSha,\n570:         reason:\n571:             'on-disk cam01 bytes must match the committed fixture_manifest.json',\n572:       );\n573:       // Negative control: the comparison above is not a tautology — tampered\n574:       // bytes must disagree with the committed manifest entry.\n575:       final tampered = List<int>.of(bytes);\n576:       tampered[0] ^= 0xff;\n577:       expect(\n578:         sha256Hex(tampered),\n579:         isNot(equals(expectedSha)),\n580:         reason: 'tampered bytes must mismatch the manifest sha256',\n581:       );\n582:       expect(\n583:         tampered.length + 1,\n584:         isNot(equals(expectedSize)),\n585:         reason: 'a wrong size must mismatch the manifest sizeBytes',\n586:       );\n587:     });\n588: \n589:     test('boots the real committed fixture manifest end to end', () async {\n590:       // Real-artifact path: the committed assets/fixture_manifest.json flows\n591:       // through the prod loaders (loadBundledFixtureManifest /\n592:       // parseFixtureManifestJson), validates, and verifies all four clips\n593:       // against file-backed asset bytes through the real WallBoot.boot.\n594:       final manifestFile = File('assets/fixture_manifest.json');\n595:       expect(\n596:         await manifestFile.exists(),\n597:         isTrue,\n598:         reason: 'run from the tv_app package directory',\n599:       );\n600:       final String raw = await manifestFile.readAsString();\n601:       final PlaybackManifest parsed = await loadBundledFixtureManifest(\n602:         partyId: 'local-party',\n603:         channelId: hauntedSurveillanceChannelId,\n604:         loader: (String key) async {\n605:           expect(key, kBundledFixtureManifestKey);\n606:           return raw;\n607:         },\n608:       );\n609:       expect(\n610:         validateCctvManifest(parsed).isOk,\n611:         isTrue,\n612:         reason: 'committed fixture must satisfy the CCTV contract',\n613:       );\n614:       expect(parsed.clips.map((ClipDescriptor c) => c.cameraId), <String>[\n615:         'CAM-01',\n616:         'CAM-02',\n617:         'CAM-03',\n618:         'CAM-04',\n619:       ]);\n620: \n621:       Future<List<int>> fileBytes(String assetPath) =>\n622:           File(assetPath).readAsBytes();\n623:       final store = InMemoryManifestStore();\n624:       final boot = WallBoot(\n625:         store: store,\n626:         fixtureLoader:\n627:             ({required String partyId, required String channelId}) async =>\n628:                 parsed,\n629:         assetBytesLoader: fileBytes,\n630:       );\n631:       final result = await boot.boot();\n632:       expect(result.isReady, isTrue, reason: result.unavailableReason);\n633:       expect(result.manifest!.clips, hasLength(4));\n634:       // Every committed clip file exists and matches its manifest entry.\n635:       for (final ClipDescriptor clip in result.manifest!.clips) {\n636:         final List<int> bytes = await File(clip.storageObjectId).readAsBytes();\n637:         expect(\n638:           bytes.length,\n639:           clip.sizeBytes,\n640:           reason: '${clip.cameraId} on-disk size must match the manifest',\n641:         );\n642:         expect(\n643:           sha256Hex(bytes),\n644:           clip.sha256,\n645:           reason: '${clip.cameraId} on-disk sha must match the manifest',\n646:         );\n647:       }\n648:       // The bundle key boot loads by default is the pubspec asset entry.\n649:       final String pubspec = await File('pubspec.yaml').readAsString();\n650:       expect(pubspec, contains(kBundledFixtureManifestKey));\n651:     });\n652:   });\n653: }\n654: \n655: ChannelRegistry _retroOnlyRegistry() {\n656:   final ChannelRegistry registry = ChannelRegistry();\n657:   // Only the inactive retro stub: resolving the CCTV channel must fail.\n658:   registry.register(_ChannelPluginStub());\n659:   return registry;\n660: }\n661: \n662: /// Minimal plugin used to build a registry without the CCTV channel.\n663: final class _ChannelPluginStub implements ChannelPlugin {\n664:   @override\n665:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n666:     id: 'retro_horror_test',\n667:     title: 'Retro',\n668:     version: 1,\n669:   );\n670: \n671:   @override\n672:   Widget build(ChannelContext context) => const SizedBox.shrink();\n673: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3ed4b70828149c83e0dbf7079"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/wall_boot_test.dart\"}"},"time":{"start":1793463676274,"end":1793463676756}}}}
