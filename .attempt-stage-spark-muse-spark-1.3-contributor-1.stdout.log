: string;\n43:   channelId: string;\n44:   status: GuestMediaDoc[\"status\"];\n45:   objectPath: string;\n46:   consentRevision: string;\n47:   expiresAt: string;\n48:   sha256?: string;\n49:   sizeBytes?: number;\n50: }\n51: \n52: export interface WithdrawGuestMediaResult {\n53:   submissionId: string;\n54:   status: \"withdrawn\";\n55:   deletedObjects: string[];\n56:   verifiedAbsent: boolean;\n57: }\n58: \n59: function isRecord(value: unknown): value is Record<string, unknown> {\n60:   return value !== null && typeof value === \"object\" && !Array.isArray(value);\n61: }\n62: \n63: function newSubmissionId(): string {\n64:   return `gsub-${randomUUID().replace(/-/g, \"\")}`;\n65: }\n66: \n67: function expiryIso(value: unknown): string {\n68:   if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n69:     return (value as { toDate: () => Date }).toDate().toISOString();\n70:   }\n71:   if (value instanceof Date) return value.toISOString();\n72:   if (typeof value === \"string\") return value;\n73:   throw new BackendError(\"INTERNAL\", \"Guest media expiry is missing.\");\n74: }\n75: \n76: function hardDeleteMs(doc: GuestMediaDoc, fallbackMs: number): number {\n77:   const raw = (doc as unknown as Record<string, unknown>).deleteAt;\n78:   if (raw && typeof raw === \"object\" && \"toDate\" in raw && typeof (raw as { toDate?: unknown }).toDate === \"function\") {\n79:     const ms = (raw as { toDate: () => Date }).toDate().getTime();\n80:     if (Number.isFinite(ms)) return ms;\n81:   }\n82:   if (raw instanceof Date && Number.isFinite(raw.getTime())) return raw.getTime();\n83:   if (typeof raw === \"string\") {\n84:     const parsed = Date.parse(raw);\n85:     if (Number.isFinite(parsed)) return parsed;\n86:   }\n87:   return fallbackMs;\n88: }\n89: \n90: function looksLikeImage(bytes: Buffer): boolean {\n91:   if (bytes.length >= 3 && bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return true;\n92:   if (bytes.length >= 4 && bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return true;\n93:   return false;\n94: }\n95: \n96: async function deleteWithRetry(deleteObject: (file: File) => Promise<void>, file: File, attempts = 3): Promise<void> {\n97:   let lastError: unknown;\n98:   for (let attempt = 0; attempt < attempts; attempt += 1) {\n99:     try {\n100:       await deleteObject(file);\n101:       return;\n102:     } catch (error) {\n103:       lastError = error;\n104:     }\n105:   }\n106:   throw lastError instanceof Error ? lastError : new Error(\"Guest object deletion failed.\");\n107: }\n108: \n109: export function createGuestUploadService(options: GuestUploadServiceOptions) {\n110:   const { db, bucket } = options;\n111:   const now = options.now ?? (() => new Date());\n112:   const signUploadUrl = options.signUploadUrl ?? (async (file, contentType, expiresAt) => {\n113:     const [url] = await file.getSignedUrl({ action: \"write\", version: \"v4\", expires: expiresAt, contentType });\n114:     return url;\n115:   });\n116:   const deleteObject = options.deleteObject ?? (async (file) => {\n117:     await file.delete({ ignoreNotFound: true });\n118:   });\n119: \n120:   async function requestGuestUpload(value: unknown): Promise<RequestGuestUploadResult> {\n121:     const identity = requireIdentity(value);\n122:     if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n123:     if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Guest upload payload must be an object.\");\n124:     if (\"objectPath\" in value || \"submissionId\" in value || \"uploadUrl\" in value) {\n125:       throw new BackendError(\"INVALID_ARGUMENT\", \"Upload paths are assigned by the server.\");\n126:     }\n127:     const consent = value.consent;\n128:     if (!isRecord(consent) || consent.accepted !== true) {\n129:       throw new BackendError(\"FORBIDDEN\", \"Affirmative guest consent is required before upload.\");\n130:     }\n131:     // Consent namespace: guest devices use v1/guest_cameo; host devices use\n132:     // the distinct host_source_v1/host_source pair (with an attestation copy\n133:     // stored below). Either pair is a supported consent version/purpose, but\n134:     // the pairs never mix across roles.\n135:     if (!isSupportedConsent(consent.textVersion, consent.purpose)) {\n136:       throw new BackendError(\"INVALID_ARGUMENT\", \"Guest consent version or purpose is unsupported.\");\n137:     }\n138:     const contentType = value.contentType;\n139:     if (typeof contentType !== \"string\" ||\n140:         !(GUEST_ALLOWED_CONTENT_TYPES as readonly string[]).includes(contentType)) {\n141:       throw new BackendError(\"INVALID_ARGUMENT\", \"Only JPEG or PNG guest photos are supported.\");\n142:     }\n143:     const registered = await assertRegisteredPartyDevice(db, identity);\n144:     const callerRole = String(registered.device.role ?? \"guest\");\n145:     const hostCaller = callerRole === \"host\";\n146:     if (hostCaller !== isHostSourceConsent(consent.textVersion, consent.purpose)) {\n147:       throw new BackendError(\"INVALID_ARGUMENT\", \"Consent version or purpose does not match the caller role.\");\n148:     }\n149:     const submissionId = newSubmissionId();\n150:     validateId(submissionId, \"submissionId\");\n151:     const objectPath = guestObjectPath(identity.partyId, identity.deviceId, submissionId);\n152:     const acceptedAt = now();\n153:     const acceptedAtIso = acceptedAt.toISOString();\n154:     // Namespaced revision: host sources carry host_source_v1:…, guest\n155:     // sources carry v1:… (via consentRevisionFor). The revision travels on\n156:     // the job binding and is rechecked at eligibility time.\n157:     const consentRevision = hostCaller\n158:       ? `${String(consent.textVersion)}:${acceptedAtIso}`\n159:       : consentRevisionFor(acceptedAtIso);\n160:     const expiresAt = new Date(acceptedAt.getTime() + GUEST_UPLOAD_TTL_MS);\n161:     // Immutable creation-based deletion deadline: completion may narrow the\n162:     // visible expiry but must never extend retention past creation + 24h.\n163:     const deleteAt = new Date(acceptedAt.getTime() + GUEST_INPUT_TTL_MS);\n164:     const ref = guestMediaRef(db, identity.partyId, submissionId);\n165:     await ref.create({\n166:       submissionId,\n167:       partyId: identity.partyId,\n168:       deviceId: identity.deviceId,\n169:       channelId: identity.channelId,\n170:       status: \"pending_upload\",\n171:       consent: {\n172:         accepted: true,\n173:         textVersion: String(consent.textVersion),\n174:         purpose: String(consent.purpose),\n175:         acceptedAt: acceptedAtIso,\n176:         deviceId: identity.deviceId,\n177:       },\n178:       // Attestation copy: mirrors the consent text/purpose at acceptance so\n179:       // later audits can distinguish host-originated sources from guest\n180:       // cameo sources without re-reading the consent history.\n181:       attestation: {\n182:         textVersion: String(consent.textVersion),\n183:         purpose: String(consent.purpose),\n184:         acceptedAt: acceptedAtIso,\n185:         deviceId: identity.deviceId,\n186:         role: hostCaller ? \"host\" : \"guest\",\n187:       },\n188:       consentRevision,\n189:       objectPath,\n190:       contentType,\n191:       expiresAt: Timestamp.fromDate(expiresAt),\n192:       deleteAt: Timestamp.fromDate(deleteAt),\n193:       createdAt: FieldValue.serverTimestamp(),\n194:       updatedAt: FieldValue.serverTimestamp(),\n195:     });\n196:     // The signed PUT capability is returned, never persisted in Firestore or logs.\n197:     const uploadUrl = await signUploadUrl(bucket.file(objectPath), contentType, expiresAt);\n198:     return { submissionId, objectPath, uploadUrl, expiresAt: expiresAt.toISOString(), consentRevision };\n199:   }\n200: \n201:   async function completeGuestUpload(value: unknown): Promise<GuestMediaStatusResult> {\n202:     if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Completion payload must be an object.\");\n203:     const identity = requireIdentity(value);\n204:     if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n205:     if (typeof value.submissionId !== \"string\" || !value.submissionId) {\n206:       throw new BackendError(\"INVALID_ARGUMENT\", \"submissionId is required.\");\n207:     }\n208:     const submissionId = validateId(value.submissionId, \"submissionId\");\n209:     await assertRegisteredPartyDevice(db, identity);\n210:     const ref = guestMediaRef(db, identity.partyId, submissionId);\n211:     const snapshot = await ref.get();\n212:     if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Guest media does not exist.\");\n213:     const doc = snapshot.data() as GuestMediaDoc;\n214:     if (doc.partyId !== identity.partyId || doc.deviceId !== identity.deviceId || doc.channelId !== identity.channelId) {\n215:       throw new BackendError(\"FORBIDDEN\", \"Guest media is not bound to this party, device, and channel.\");\n216:     }\n217:     if (doc.status === \"withdrawn\") throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn.\");\n218:     const expiryMs = doc.expiresAt instanceof Timestamp ? doc.expiresAt.toDate().getTime() : Date.parse(String(doc.expiresAt));\n219:     if (!Number.isFinite(expiryMs) || expiryMs <= now().getTime()) {\n220:       if (doc.status !== \"expired\") {\n221:         await ref.update({ status: \"expired\", updatedAt: FieldValue.serverTimestamp() });\n222:       }\n223:       throw new BackendError(\"CLIP_EXPIRED\", \"Guest upload capability has expired.\");\n224:     }\n225:     const expectedPath = guestObjectPath(identity.partyId, identity.deviceId, submissionId);\n226:     if (doc.objectPath !== expectedPath) {\n227:       throw new BackendErro