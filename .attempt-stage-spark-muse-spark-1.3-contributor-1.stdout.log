\" +\n105:   \"while a goofy, lumbering green monster chases close behind. \" +\n106:   \"Use one continuous side-tracking shot, keeping both characters visible. \" +\n107:   \"0-2 seconds: The person sprints with exaggerated cartoon strides while the monster reaches toward him. \" +\n108:   \"2-4 seconds: He glances backward, eyes widening, then accelerates with comically spinning legs. \" +\n109:   \"4-5 seconds: Both race through an open doorway and disappear offscreen. \" +\n110:   \"Bold ink outlines, flat cel shading, hand-painted purple-and-teal backgrounds, expressive faces, \" +\n111:   \"elastic cartoon movement, and playful spooky slapstick. \" +\n112:   \"No photorealism, 3D rendering, gore, text, or changes to the person's identity.\";\n113: \n114: /** Guest upload/consent controls. Server-side only; never trust caller-supplied paths. */\n115: export const GUEST_CONSENT_TEXT_VERSION = \"v1\";\n116: export const GUEST_CONSENT_PURPOSE = \"guest_cameo\";\n117: /** Short-lived upload capability lifetime (signed PUT bound to object + content type). */\n118: export const GUEST_UPLOAD_TTL_MS = 15 * 60 * 1000;\n119: /** Abandoned/expired guest inputs are removed within a capped 24h deadline. */\n120: export const GUEST_INPUT_TTL_MS = 24 * 60 * 60 * 1000;\n121: export const GUEST_MAX_IMAGE_BYTES = 10 * 1024 * 1024;\n122: export const GUEST_ALLOWED_CONTENT_TYPES = [\"image/jpeg\", \"image/png\"] as const;\n123: export type GuestAllowedContentType = (typeof GUEST_ALLOWED_CONTENT_TYPES)[number];\n124: /** Exactly one provider-generated camera in a guest-bound job; the rest are local fixtures. */\n125: export const GUEST_PROVIDER_CAMERA_ID = \"CAM-01\" as const;\n126: \n127: export const ERROR_CODES = [\n128:   \"UNAUTHENTICATED\",\n129:   \"FORBIDDEN\",\n130:   \"MANIFEST_MISMATCH\",\n131:   \"CLIP_EXPIRED\",\n132:   \"PROVIDER_UNAVAILABLE\",\n133:   \"BUDGET_EXCEEDED\",\n134:   \"INVALID_ARGUMENT\",\n135:   \"NOT_FOUND\",\n136:   \"INTERNAL\",\n137: ] as const;\n138: \n139: export type ErrorCode = (typeof ERROR_CODES)[number];\n140: \n141: export const JOB_STATES = [\"queued\", \"running\", \"ready\", \"delivering\", \"purged\", \"failed\", \"expired\"] as const;\n142: export type JobState = (typeof JOB_STATES)[number];"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192d1e7ba75878b396338570d85c3"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/src/config.ts\"}"},"time":{"start":1793464592312,"end":1793464593292}}}}
{"type":"tool_use","timestamp":1793464593294,"sessionID":"ses_e6d2e2c41ffe5yy93t4od5G2vw","part":{"partID":"prt_192d1e8fe001BNV3vIPm1aRUTS","sessionID":"ses_e6d2e2c41ffe5yy93t4od5G2vw","messageID":"msg_192d1e35c001CQNSZUFru97xO5","type":"tool","id":"call_01a192d1e90974a080994a775e65ed49","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/generation.test.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/generation.test.ts, lines 1-444\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { resolve } from \"node:path\";\n4: import test from \"node:test\";\n5: import { createGenerationServices } from \"../src/generation\";\n6: import { REQUIRED_CAMERA_IDS } from \"../src/config\";\n7: import { BackendError } from \"../src/contracts\";\n8: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n9: import { ProviderResult, ProviderTaskStatus, VideoGenerationRequest } from \"../src/video_generation_port\";\n10: import { reconcileUsage, usageLedgerId } from \"../src/usage\";\n11: import { buildCheapDemoRequest, validateCheapDemoControls, validateFetchableReferenceImage, validateVideoGenerationRequest } from \"../src/video_generation_port\";\n12: import { buildAlibabaSubmitBody } from \"../src/providers/alibaba\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: function expectCode(work: () => unknown, code: string): void {\n23:   assert.throws(work, (error: unknown) => error instanceof BackendError && error.errorCode === code);\n24: }\n25: \n26: test(\"cheap_demo generation request is fixed to one Singapore 480P silent output\", () => {\n27:   const request = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\");\n28:   assert.equal(request.modelId, \"wan3.0-video\");\n29:   assert.equal(request.region, \"singapore\");\n30:   assert.equal(request.resolution, \"480P\");\n31:   assert.equal(request.secondsOut, 2);\n32:   assert.equal(request.aspectRatio, \"16:9\");\n33:   assert.equal(request.audio, false);\n34:   assert.equal(request.outputs, 1);\n35:   assert.equal(request.autoUpscale, false);\n36:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", modelId: \"another-model\" }), \"INVALID_ARGUMENT\");\n37:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", resolution: \"720P\" }), \"INVALID_ARGUMENT\");\n38:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", secondsOut: 5 }), \"INVALID_ARGUMENT\");\n39:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", outputs: 2 }), \"INVALID_ARGUMENT\");\n40:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", audio: true }), \"INVALID_ARGUMENT\");\n41:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", media: [{ type: \"image\" }] }), \"INVALID_ARGUMENT\");\n42: });\n43: \n44: test(\"provider-bound references require a signed https URL, never a bare bucket path\", () => {\n45:   // Offline regression for the live-submit defect: the provider cannot fetch\n46:   // private GCS object paths, so any reference without a resolved signed https\n47:   // URL fails closed before transport. Consent/tombstone gates are unchanged.\n48:   const bare = {\n49:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n50:     sha256: \"a\".repeat(64),\n51:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n52:   };\n53:   expectCode(() => validateFetchableReferenceImage({ ...bare }), \"INVALID_ARGUMENT\");\n54:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"http://signed.invalid/photo.jpg\" }), \"INVALID_ARGUMENT\");\n55:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"gs://bucket/photo.jpg\" }), \"INVALID_ARGUMENT\");\n56:   expectCode(() => validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...bare })), \"INVALID_ARGUMENT\");\n57:   const resolved = { ...bare, url: \"https://signed.invalid/photo.jpg\" };\n58:   validateFetchableReferenceImage({ ...resolved });\n59:   validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...resolved }));\n60: });\n61: \n62: test(\"offline fake keeps the live fetchability gate for cheap_demo references\", async () => {\n63:   // Layering regression for the cycle-11 merge interaction: the offline fake\n64:   // resolves local bytes and never fetches, but it still enforces the same\n65:   // signed-https fetchability gate as the live adapter, so an unfetchable\n66:   // bare object-path reference can never be submitted on either boundary.\n67:   // The worker resolves the consented photo through signReferenceReadUrl\n68:   // (emulator tests wire the signing transport for that step); anything\n69:   // unresolved fails here with the same signed-URL shape. Consent and\n70:   // tombstone gates live one layer up and are unchanged.\n71:   const bare = {\n72:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n73:     sha256: \"a\".repeat(64),\n74:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n75:   };\n76:   const provider = new FakeVideoGenerationPort();\n77:   await assert.rejects(\n78:     provider.submit(buildCheapDemoRequest(\"job-cheap-bare\", \"idem-cheap-bare\", \"CAM-01\", { ...bare })),\n79:     /signed https URL/,\n80:   );\n81:   const submitted = await provider.submit(buildCheapDemoRequest(\"job-cheap-signed\", \"idem-cheap-signed\", \"CAM-01\", {\n82:     ...bare,\n83:     url: \"https://signed.invalid/photo.jpg\",\n84:   }));\n85:   assert.ok(submitted.taskId.startsWith(\"CAM-01__\"));\n86: });\n87: \n88: test(\"crash reconciliation never repeats an unpersisted billable submission\", {\n89:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n90: }, async () => {\n91:   const { app, db, bucket } = await createEmulatorContext();\n92:   const partyId = randomPartyId();\n93:   let submissions = 0;\n94:   const provider = {\n95:     async submit(_request: VideoGenerationRequest) { submissions += 1; return { taskId: \"should-not-be-submitted\" }; },\n96:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; },\n97:     async getResult(_taskId: string): Promise<ProviderResult> {\n98:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 };\n99:     },\n100:   };\n101:   const deviceId = \"tv-crash-recovery\";\n102:   const channelId = \"main\";\n103:   const jobId = \"job-uncertain-submit\";\n104:   const idempotencyKey = \"idem-uncertain-submit\";\n105:   try {\n106:     await seedParty(db, partyId, deviceId, channelId);\n107:     const services = createGenerationServices({ db, bucket, provider });\n108:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n109:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({\n110:       \"cameraAttempts.CAM-01.consumedAttempt\": true,\n111:       \"cameraAttempts.CAM-01.submissionState\": \"submitting\",\n112:     });\n113:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n114:       (error: unknown) => error instanceof BackendError && error.errorCode === \"PROVIDER_UNAVAILABLE\");\n115:     assert.equal(submissions, 0);\n116:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data();\n117:     assert.equal(job?.state, \"running\");\n118:     assert.equal(job?.status, \"reconciliation_required\");\n119:     assert.equal(job?.errorCode, \"PROVIDER_UNAVAILABLE\");\n120:     assert.equal(job?.reconciliationReason, \"SUBMISSION_OUTCOME_UNKNOWN\");\n121:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n122:     assert.equal(budget?.state, \"in_flight\");\n123:     await assert.rejects(services.requestGeneration({\n124:       partyId,\n125:       deviceId,\n126:       channelId,\n127:       jobId: \"job-blocked-by-uncertain-submit\",\n128:       idempotencyKey: \"idem-blocked-by-uncertain-submit\",\n129:       presetId: \"cheap_demo\",\n130:     }), (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n131:     assert.ok((await reconcileUsage(db)).some((issue) => issue.code === \"SUBMISSION_OUTCOME_UNKNOWN\"));\n132:   } finally {\n133:     await clearParty(db, bucket, partyId);\n134:     await disposeEmulatorContext(app);\n135:   }\n136: });\n137: \n138: test(\"registered anonymous request runs fake provider through normalization and atomic publish\", {\n139:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n140: }, async () => {\n141:   const { app, db, bucket } = await createEmulatorContext();\n142:   const partyId = randomPartyId();\n143:   const deviceId = \"tv-pilot\";\n144:   const channelId = \"main\";\n145:   const jobId = \"job-generation-e2e\";\n146:   const idempotencyKey = \"idem-generation-e2e\";\n147:   try {\n148:     await seedParty(db, partyId, deviceId, channelId);\n149:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({ version: 7 });\n150:     const services = createGenerationServices({\n151:       db,\n152:       bucket,\n153:       provider: new FakeVideoGenerationPort(),\n154:       pollIntervalMs: 1,\n155:       sleep: async () => undefined,\n156:     });\n157:     const input = { partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" };\n158:     const request = await services.requestGeneration(input);\n159:     assert.equal(request.state, \"queued\");\n160:     assert.equal(request.created, true);\n161:     assert.equal(request.manifestVersion, 8);\n162:     assert.ok(request.timestamp);\n163:     const duplicate = await services.requestGeneration(input);\n164:     assert.equal(duplicate.created, false);\n165:     await assert.rejects(services.requestGeneration({ ...input, jobId: \"job-budget-guard\", idempotencyKey: \"idem-budget-guard\" }),\n166:       (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n167:     await assert.rejects(services.requestGeneration({ ...input, partyId: \"unregistered-party\", jobId: \"job-unregistered\" }),\n168:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n169: \n170:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n171:     assert.deepEqual(run, { jobId, state: \"ready\", manifestVersion: 8 });\n172:     const repeated = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n173:     assert.equal(repeated.state, \"ready\");\n174: \n175:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n176:     assert.equal(manifest.version, 8);\n177:     assert.equal(manifest.cameraClips.length, 4);\n178:     assert.deepEqual(manifest.cameraClips.map((clip: { cameraId: string }) => clip.cameraId), [...REQUIRED_CAMERA_IDS]);\n179:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n180:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n181:       assert.equal(ledger.partyId, partyId);\n182:       assert.equal(ledger.deviceId, deviceId);\n183:       assert.equal(ledger.channelId, channelId);\n184:       assert.equal(ledger.manifestVersion, 8);\n185:       assert.equal(ledger.idempotencyKey, idempotencyKey);\n186:       assert.equal(ledger.success, true);\n187:       assert.equal(ledger.provider_task_id.startsWith(`${cameraId}__`), true);\n188:     }\n189:     assert.deepEqual(await reconcileUsage(db), []);\n190:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n191:     assert.equal(budget?.state, \"idle\");\n192:   } finally {\n193:     await clearParty(db, bucket, partyId);\n194:     await disposeEmulatorContext(app);\n195:   }\n196: });\n197: \n198: test(\"rehearsalOnly marker binds the worker to the fake provider when live is configured\", {\n199:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n200: }, async () => {\n201:   const { app, db, bucket } = await createEmulatorContext();\n202:   const partyId = randomPartyId();\n203:   /** Live-shaped stand-in: any submit reaching it would be billable work. */\n204:   class LiveSpyProvider {\n205:     submissions = 0;\n206:     async submit(_request: VideoGenerationRequest) {\n207:       this.submissions += 1;\n208:       return { taskId: \"live-billable-task-1\" };\n209:     }\n210:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; }\n211:     async getResult(_taskId: string): Promise<ProviderResult> {\n212:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 9 };\n213:     }\n214:   }\n215:   const deviceId = \"tv-rehearsal\";\n216:   const channelId = \"main\";\n217:   const jobId = \"job-rehearsal-marker\";\n218:   const idempotencyKey = \"idem-rehearsal-marker\";\n219:   try {\n220:     await seedParty(db, partyId, deviceId, channelId);\n221:     const live = new LiveSpyProvider();\n222:     const services = createGenerationServices({\n223:       db,\n224:       bucket,\n225:       provider: live,\n226:       pollIntervalMs: 1,\n227:       sleep: async () => undefined,\n228:     });\n229:     const request = await services.requestGeneration({\n230:       partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", rehearsalOnly: true,\n231:     });\n232:     assert.equal(request.created, true);\n233:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.rehearsalOnly, true);\n234:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n235:     assert.equal(run.state, \"ready\");\n236:     assert.equal(live.submissions, 0, \"a rehearsal-marked job must never reach the live provider\");\n237:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n238:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n239:       assert.match(ledger.provider_task_id, new RegExp(`^${cameraId}__[a-f0-9]{24}$`));\n240:       assert.equal(ledger.credits_charged, 0);\n241:     }\n242:     assert.deepEqual(await reconcileUsage(db), []);\n243:   } finally {\n244:     await clearParty(db, bucket, partyId);\n245:     await disposeEmulatorContext(app);\n246:   }\n247: });\n248: \n249: test(\"rehearsalOnly marker is validated, bound to the job, and optional\", {\n250:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n251: }, async () => {\n252:   const { app, db, bucket } = await createEmulatorContext();\n253:   const partyId = randomPartyId();\n254:   const deviceId = \"tv-marker\";\n255:   const channelId = \"main\";\n256:   try {\n257:     await seedParty(db, partyId, deviceId, channelId);\n258:     const services = createGenerationServices({\n259:       db,\n260:       bucket,\n261:       provider: new FakeVideoGenerationPort(),\n262:       pollIntervalMs: 1,\n263:       sleep: async () => undefined,\n264:     });\n265:     const base = { partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\", presetId: \"cheap_demo\" };\n266:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: \"true\" }),\n267:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n268:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: false }),\n269:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n270:     const marked = await services.requestGeneration({ ...base, rehearsalOnly: true });\n271:     assert.equal(marked.created, true);\n272:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-marker`).get()).data()?.rehearsalOnly, true);\n273:     const repeat = await services.requestGeneration({ ...base, rehearsalOnly: true });\n274:     assert.equal(repeat.created, false);\n275:     // The same job cannot be re-requested as an unmarked (live-path) job.\n276:     await assert.rejects(services.requestGeneration(base),\n277:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n278:     const status = await services.getGenerationStatus({ ...base, rehearsalOnly: true });\n279:     assert.equal(status.jobId, \"job-marker\");\n280:     // Run the marked job to release the party budget: the default path then stays marker-free.\n281:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\" });\n282:     assert.equal(run.state, \"ready\");\n283:     await services.requestGeneration({ partyId, deviceId, channelId, jobId: \"job-default\", idempotencyKey: \"idem-default\", presetId: \"cheap_demo\" });\n284:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-default`).get()).data()?.rehearsalOnly, undefined);\n285:   } finally {\n286:     await clearParty(db, bucket, partyId);\n287:     await disposeEmulatorContext(app);\n288:   }\n289: });\n290: \n291: test(\"request idempotency cannot be rebound to another device\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n292:   const { app, db, bucket } = await createEmulatorContext();\n293:   const partyId = randomPartyId();\n294:   try {\n295:     await seedParty(db, partyId, \"tv-1\", \"main\");\n296:     await seedParty(db, partyId, \"tv-2\", \"main\");\n297:     const services = createGenerationServices({ db, bucket, provider: new FakeVideoGenerationPort() });\n298:     const input = { partyId, deviceId: \"tv-1\", channelId: \"main\", jobId: \"job-rebind\", idempotencyKey: \"idem-rebind\", presetId: \"cheap_demo\" };\n299:     await services.requestGeneration(input);\n300:     await assert.rejects(services.requestGeneration({ ...input, deviceId: \"tv-2\" }),\n301:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n302:   } finally {\n303:     await clearParty(db, bucket, partyId);\n304:     await disposeEmulatorContext(app);\n305:   }\n306: });\n307: \n308: test(\"submit body uses the media-field form for references (no network)\", () => {\n309:   // Offline regression for the live r2v defect: the signed URL rides as\n310:   // input.media; sha256 / reference_image never enter the submitted JSON.\n311:   const reference = {\n312:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n313:     sha256: \"c\".repeat(64),\n314:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n315:     url: \"https://signed.invalid/media-photo.jpg\",\n316:   };\n317:   const body = buildAlibabaSubmitBody(buildCheapDemoRequest(\"job-media\", \"idem-media\", \"CAM-01\", { ...reference }));\n318:   assert.deepEqual((body.input as Record<string, unknown>).media, [{ type: \"reference_image\", url: \"https://signed.invalid/media-photo.jpg\" }]);\n319:   assert.ok(!(\"reference_image\" in (body.input as Record<string, unknown>)));\n320:   assert.ok(!JSON.stringify(body).includes(\"c\".repeat(64)));\n321: });\n322: \n323: test(\"worker surfaces a provider FAILED reason in the error and on the job doc\", {\n324:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n325: }, async () => {\n326:   const { app, db, bucket } = await createEmulatorContext();\n327:   const partyId = randomPartyId();\n328:   const deviceId = \"tv-fail-reason\";\n329:   const channelId = \"main\";\n330:   const jobId = \"job-fail-reason\";\n331:   const idempotencyKey = \"idem-fail-reason\";\n332:   try {\n333:     await seedParty(db, partyId, deviceId, channelId);\n334:     const failingProvider = {\n335:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failreason000000000001\" }; },\n336:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> {\n337:         return { state: \"FAILED\", errorCode: \"InvalidParameter\", errorMessage: \"Field required: input.media\" };\n338:       },\n339:       async getResult(_taskId: string): Promise<ProviderResult> {\n340:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n341:       },\n342:     };\n343:     const services = createGenerationServices({\n344:       db, bucket, provider: failingProvider, pollIntervalMs: 1, sleep: async () => undefined,\n345:     });\n346:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n347:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n348:       (error: unknown) => error instanceof BackendError\n349:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n350:         && /Field required: input\\.media/.test(error.message));\n351:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n352:     assert.equal(job.state, \"failed\");\n353:     assert.ok(typeof job.providerErrorCode === \"string\" && job.providerErrorCode.includes(\"InvalidParameter\"));\n354:     assert.ok(job.providerErrorCode.includes(\"Field_required\"));\n355:     assert.ok(!JSON.stringify(job).includes(\"https://\"));\n356:   } finally {\n357:     await clearParty(db, bucket, partyId);\n358:     await disposeEmulatorContext(app);\n359:   }\n360: });\n361: \n362: test(\"worker keeps the generic mapping when a FAILED task carries no reason\", {\n363:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n364: }, async () => {\n365:   const { app, db, bucket } = await createEmulatorContext();\n366:   const partyId = randomPartyId();\n367:   const deviceId = \"tv-fail-empty\";\n368:   const channelId = \"main\";\n369:   const jobId = \"job-fail-empty\";\n370:   const idempotencyKey = \"idem-fail-empty\";\n371:   try {\n372:     await seedParty(db, partyId, deviceId, channelId);\n373:     const emptyProvider = {\n374:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failempty000000000001\" }; },\n375:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"FAILED\" }; },\n376:       async getResult(_taskId: string): Promise<ProviderResult> {\n377:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n378:       },\n379:     };\n380:     const services = createGenerationServices({\n381:       db, bucket, provider: emptyProvider, pollIntervalMs: 1, sleep: async () => undefined,\n382:     });\n383:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n384:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n385:       (error: unknown) => error instanceof BackendError\n386:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n387:         && error.message === \"Provider task failed.\");\n388:   } finally {\n389:     await clearParty(db, bucket, partyId);\n390:     await disposeEmulatorContext(app);\n391:   }\n392: });\n393: \n394: \n395: test(\"lazy provider fallback threads fixtureDirectory through both construction paths\", {\n396:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n397: }, async () => {\n398:   const { app, db, bucket } = await createEmulatorContext();\n399:   const partyId = randomPartyId();\n400:   const deviceId = \"tv-lazy-fixture\";\n401:   const channelId = \"main\";\n402:   const jobId = \"job-lazy-fixture\";\n403:   const idempotencyKey = \"idem-lazy-fixture\";\n404:   const { mkdtemp, copyFile, readFile } = await import(\"node:fs/promises\");\n405:   const { tmpdir } = await import(\"node:os\");\n406:   const { join } = await import(\"node:path\");\n407:   const { normalizeProviderVideo, removeNormalizedVideo } = await import(\"../src/normalize\");\n408:   const assets = resolve(process.cwd(), \"../../apps/tv_app/assets\");\n409:   // Every slot reads the CAM-01 bytes: only the threaded directory produces\n410:   // this digest on all four cameras.\n411:   const isolated = await mkdtemp(join(tmpdir(), \"halloween-fixtures-\"));\n412:   const cam01 = await readFile(join(assets, \"cam01.mp4\"));\n413:   for (const name of [\"cam01.mp4\", \"cam02.mp4\", \"cam03.mp4\", \"cam04.mp4\"]) {\n414:     await copyFile(join(assets, \"cam01.mp4\"), join(isolated, name));\n415:   }\n416:   const defaultCam02 = await readFile(join(assets, \"cam02.mp4\"));\n417:   assert.notDeepEqual(cam01, defaultCam02, \"fixture inputs must differ for this regression to discriminate\");\n418:   const expected = await normalizeProviderVideo(\n419:     { video: { kind: \"file\", value: join(isolated, \"cam01.mp4\") }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 },\n420:   );\n421:   try {\n422:     await seedParty(db, partyId, deviceId, channelId);\n423:     // No explicit provider: the service must lazily construct one from the\n424:     // threaded fixture directory instead of the repository default.\n425:     const services = createGenerationServices({\n426:       db, bucket, fixtureDirectory: isolated, pollIntervalMs: 1, sleep: async () => undefined,\n427:     });\n428:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n429:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n430:     assert.equal(run.state, \"ready\");\n431:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n432:     assert.equal(manifest.cameraClips.length, 4);\n433:     for (const clip of manifest.cameraClips as Array<{ cameraId: string; sha256: string; sizeBytes: number; objectPath: string }>) {\n434:       assert.equal(clip.sha256, expected.sha256, `${clip.cameraId} must come from the threaded fixture directory`);\n435:       assert.equal(clip.sizeBytes, expected.sizeBytes);\n436:       const [bytes] = await bucket.file(clip.objectPath).download();\n437:       assert.equal(createHash(\"sha256\").update(bytes).digest(\"hex\"), clip.sha256);\n438:     }\n439:   } finally {\n440:     await removeNormalizedVideo(expected).catch(() => undefined);\n441:     await clearParty(db, bucket, partyId);\n442:     await disposeEmulatorContext(app);\n443:   }\n444: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/generation.test.ts, lines 1-444\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { resolve } from \"node:path\";\n4: import test from \"node:test\";\n5: import { createGenerationServices } from \"../src/generation\";\n6: import { REQUIRED_CAMERA_IDS } from \"../src/config\";\n7: import { BackendError } from \"../src/contracts\";\n8: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n9: import { ProviderResult, ProviderTaskStatus, VideoGenerationRequest } from \"../src/video_generation_port\";\n10: import { reconcileUsage, usageLedgerId } from \"../src/usage\";\n11: import { buildCheapDemoRequest, validateCheapDemoControls, validateFetchableReferenceImage, validateVideoGenerationRequest } from \"../src/video_generation_port\";\n12: import { buildAlibabaSubmitBody } from \"../src/providers/alibaba\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: function expectCode(work: () => unknown, code: string): void {\n23:   assert.throws(work, (error: unknown) => error instanceof BackendError && error.errorCode === code);\n24: }\n25: \n26: test(\"cheap_demo generation request is fixed to one Singapore 480P silent output\", () => {\n27:   const request = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\");\n28:   assert.equal(request.modelId, \"wan3.0-video\");\n29:   assert.equal(request.region, \"singapore\");\n30:   assert.equal(request.resolution, \"480P\");\n31:   assert.equal(request.secondsOut, 2);\n32:   assert.equal(request.aspectRatio, \"16:9\");\n33:   assert.equal(request.audio, false);\n34:   assert.equal(request.outputs, 1);\n35:   assert.equal(request.autoUpscale, false);\n36:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", modelId: \"another-model\" }), \"INVALID_ARGUMENT\");\n37:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", resolution: \"720P\" }), \"INVALID_ARGUMENT\");\n38:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", secondsOut: 5 }), \"INVALID_ARGUMENT\");\n39:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", outputs: 2 }), \"INVALID_ARGUMENT\");\n40:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", audio: true }), \"INVALID_ARGUMENT\");\n41:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", media: [{ type: \"image\" }] }), \"INVALID_ARGUMENT\");\n42: });\n43: \n44: test(\"provider-bound references require a signed https URL, never a bare bucket path\", () => {\n45:   // Offline regression for the live-submit defect: the provider cannot fetch\n46:   // private GCS object paths, so any reference without a resolved signed https\n47:   // URL fails closed before transport. Consent/tombstone gates are unchanged.\n48:   const bare = {\n49:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n50:     sha256: \"a\".repeat(64),\n51:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n52:   };\n53:   expectCode(() => validateFetchableReferenceImage({ ...bare }), \"INVALID_ARGUMENT\");\n54:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"http://signed.invalid/photo.jpg\" }), \"INVALID_ARGUMENT\");\n55:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"gs://bucket/photo.jpg\" }), \"INVALID_ARGUMENT\");\n56:   expectCode(() => validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...bare })), \"INVALID_ARGUMENT\");\n57:   const resolved = { ...bare, url: \"https://signed.invalid/photo.jpg\" };\n58:   validateFetchableReferenceImage({ ...resolved });\n59:   validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...resolved }));\n60: });\n61: \n62: test(\"offline fake keeps the live fetchability gate for cheap_demo references\", async () => {\n63:   // Layering regression for the cycle-11 merge interaction: the offline fake\n64:   // resolves local bytes and never fetches, but it still enforces the same\n65:   // signed-https fetchability gate as the live adapter, so an unfetchable\n66:   // bare object-path reference can never be submitted on either boundary.\n67:   // The worker resolves the consented photo through signReferenceReadUrl\n68:   // (emulator tests wire the signing transport for that step); anything\n69:   // unresolved fails here with the same signed-URL shape. Consent and\n70:   // tombstone gates live one layer up and are unchanged.\n71:   const bare = {\n72:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n73:     sha256: \"a\".repeat(64),\n74:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n75:   };\n76:   const provider = new FakeVideoGenerationPort();\n77:   await assert.rejects(\n78:     provider.submit(buildCheapDemoRequest(\"job-cheap-bare\", \"idem-cheap-bare\", \"CAM-01\", { ...bare })),\n79:     /signed https URL/,\n80:   );\n81:   const submitted = await provider.submit(buildCheapDemoRequest(\"job-cheap-signed\", \"idem-cheap-signed\", \"CAM-01\", {\n82:     ...bare,\n83:     url: \"https://signed.invalid/photo.jpg\",\n84:   }));\n85:   assert.ok(submitted.taskId.startsWith(\"CAM-01__\"));\n86: });\n87: \n88: test(\"crash reconciliation never repeats an unpersisted billable submission\", {\n89:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n90: }, async () => {\n91:   const { app, db, bucket } = await createEmulatorContext();\n92:   const partyId = randomPartyId();\n93:   let submissions = 0;\n94:   const provider = {\n95:     async submit(_request: VideoGenerationRequest) { submissions += 1; return { taskId: \"should-not-be-submitted\" }; },\n96:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; },\n97:     async getResult(_taskId: string): Promise<ProviderResult> {\n98:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 };\n99:     },\n100:   };\n101:   const deviceId = \"tv-crash-recovery\";\n102:   const channelId = \"main\";\n103:   const jobId = \"job-uncertain-submit\";\n104:   const idempotencyKey = \"idem-uncertain-submit\";\n105:   try {\n106:     await seedParty(db, partyId, deviceId, channelId);\n107:     const services = createGenerationServices({ db, bucket, provider });\n108:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n109:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({\n110:       \"cameraAttempts.CAM-01.consumedAttempt\": true,\n111:       \"cameraAttempts.CAM-01.submissionState\": \"submitting\",\n112:     });\n113:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n114:       (error: unknown) => error instanceof BackendError && error.errorCode === \"PROVIDER_UNAVAILABLE\");\n115:     assert.equal(submissions, 0);\n116:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data();\n117:     assert.equal(job?.state, \"running\");\n118:     assert.equal(job?.status, \"reconciliation_required\");\n119:     assert.equal(job?.errorCode, \"PROVIDER_UNAVAILABLE\");\n120:     assert.equal(job?.reconciliationReason, \"SUBMISSION_OUTCOME_UNKNOWN\");\n121:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n122:     assert.equal(budget?.state, \"in_flight\");\n123:     await assert.rejects(services.requestGeneration({\n124:       partyId,\n125:       deviceId,\n126:       channelId,\n127:       jobId: \"job-blocked-by-uncertain-submit\",\n128:       idempotencyKey: \"idem-blocked-by-uncertain-submit\",\n129:       presetId: \"cheap_demo\",\n130:     }), (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n131:     assert.ok((await reconcileUsage(db)).some((issue) => issue.code === \"SUBMISSION_OUTCOME_UNKNOWN\"));\n132:   } finally {\n133:     await clearParty(db, bucket, partyId);\n134:     await disposeEmulatorContext(app);\n135:   }\n136: });\n137: \n138: test(\"registered anonymous request runs fake provider through normalization and atomic publish\", {\n139:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n140: }, async () => {\n141:   const { app, db, bucket } = await createEmulatorContext();\n142:   const partyId = randomPartyId();\n143:   const deviceId = \"tv-pilot\";\n144:   const channelId = \"main\";\n145:   const jobId = \"job-generation-e2e\";\n146:   const idempotencyKey = \"idem-generation-e2e\";\n147:   try {\n148:     await seedParty(db, partyId, deviceId, channelId);\n149:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({ version: 7 });\n150:     const services = createGenerationServices({\n151:       db,\n152:       bucket,\n153:       provider: new FakeVideoGenerationPort(),\n154:       pollIntervalMs: 1,\n155:       sleep: async () => undefined,\n156:     });\n157:     const input = { partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" };\n158:     const request = await services.requestGeneration(input);\n159:     assert.equal(request.state, \"queued\");\n160:     assert.equal(request.created, true);\n161:     assert.equal(request.manifestVersion, 8);\n162:     assert.ok(request.timestamp);\n163:     const duplicate = await services.requestGeneration(input);\n164:     assert.equal(duplicate.created, false);\n165:     await assert.rejects(services.requestGeneration({ ...input, jobId: \"job-budget-guard\", idempotencyKey: \"idem-budget-guard\" }),\n166:       (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n167:     await assert.rejects(services.requestGeneration({ ...input, partyId: \"unregistered-party\", jobId: \"job-unregistered\" }),\n168:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n169: \n170:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n171:     assert.deepEqual(run, { jobId, state: \"ready\", manifestVersion: 8 });\n172:     const repeated = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n173:     assert.equal(repeated.state, \"ready\");\n174: \n175:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n176:     assert.equal(manifest.version, 8);\n177:     assert.equal(manifest.cameraClips.length, 4);\n178:     assert.deepEqual(manifest.cameraClips.map((clip: { cameraId: string }) => clip.cameraId), [...REQUIRED_CAMERA_IDS]);\n179:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n180:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n181:       assert.equal(ledger.partyId, partyId);\n182:       assert.equal(ledger.deviceId, deviceId);\n183:       assert.equal(ledger.channelId, channelId);\n184:       assert.equal(ledger.manifestVersion, 8);\n185:       assert.equal(ledger.idempotencyKey, idempotencyKey);\n186:       assert.equal(ledger.success, true);\n187:       assert.equal(ledger.provider_task_id.startsWith(`${cameraId}__`), true);\n188:     }\n189:     assert.deepEqual(await reconcileUsage(db), []);\n190:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n191:     assert.equal(budget?.state, \"idle\");\n192:   } finally {\n193:     await clearParty(db, bucket, partyId);\n194:     await disposeEmulatorContext(app);\n195:   }\n196: });\n197: \n198: test(\"rehearsalOnly marker binds the worker to the fake provider when live is configured\", {\n199:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n200: }, async () => {\n201:   const { app, db, bucket } = await createEmulatorContext();\n202:   const partyId = randomPartyId();\n203:   /** Live-shaped stand-in: any submit reaching it would be billable work. */\n204:   class LiveSpyProvider {\n205:     submissions = 0;\n206:     async submit(_request: VideoGenerationRequest) {\n207:       this.submissions += 1;\n208:       return { taskId: \"live-billable-task-1\" };\n209:     }\n210:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; }\n211:     async getResult(_taskId: string): Promise<ProviderResult> {\n212:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 9 };\n213:     }\n214:   }\n215:   const deviceId = \"tv-rehearsal\";\n216:   const channelId = \"main\";\n217:   const jobId = \"job-rehearsal-marker\";\n218:   const idempotencyKey = \"idem-rehearsal-marker\";\n219:   try {\n220:     await seedParty(db, partyId, deviceId, channelId);\n221:     const live = new LiveSpyProvider();\n222:     const services = createGenerationServices({\n223:       db,\n224:       bucket,\n225:       provider: live,\n226:       pollIntervalMs: 1,\n227:       sleep: async () => undefined,\n228:     });\n229:     const request = await services.requestGeneration({\n230:       partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", rehearsalOnly: true,\n231:     });\n232:     assert.equal(request.created, true);\n233:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.rehearsalOnly, true);\n234:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n235:     assert.equal(run.state, \"ready\");\n236:     assert.equal(live.submissions, 0, \"a rehearsal-marked job must never reach the live provider\");\n237:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n238:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n239:       assert.match(ledger.provider_task_id, new RegExp(`^${cameraId}__[a-f0-9]{24}$`));\n240:       assert.equal(ledger.credits_charged, 0);\n241:     }\n242:     assert.deepEqual(await reconcileUsage(db), []);\n243:   } finally {\n244:     await clearParty(db, bucket, partyId);\n245:     await disposeEmulatorContext(app);\n246:   }\n247: });\n248: \n249: test(\"rehearsalOnly marker is validated, bound to the job, and optional\", {\n250:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n251: }, async () => {\n252:   const { app, db, bucket } = await createEmulatorContext();\n253:   const partyId = randomPartyId();\n254:   const deviceId = \"tv-marker\";\n255:   const channelId = \"main\";\n256:   try {\n257:     await seedParty(db, partyId, deviceId, channelId);\n258:     const services = createGenerationServices({\n259:       db,\n260:       bucket,\n261:       provider: new FakeVideoGenerationPort(),\n262:       pollIntervalMs: 1,\n263:       sleep: async () => undefined,\n264:     });\n265:     const base = { partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\", presetId: \"cheap_demo\" };\n266:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: \"true\" }),\n267:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n268:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: false }),\n269:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n270:     const marked = await services.requestGeneration({ ...base, rehearsalOnly: true });\n271:     assert.equal(marked.created, true);\n272:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-marker`).get()).data()?.rehearsalOnly, true);\n273:     const repeat = await services.requestGeneration({ ...base, rehearsalOnly: true });\n274:     assert.equal(repeat.created, false);\n275:     // The same job cannot be re-requested as an unmarked (live-path) job.\n276:     await assert.rejects(services.requestGeneration(base),\n277:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n278:     const status = await services.getGenerationStatus({ ...base, rehearsalOnly: true });\n279:     assert.equal(status.jobId, \"job-marker\");\n280:     // Run the marked job to release the party budget: the default path then stays marker-free.\n281:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\" });\n282:     assert.equal(run.state, \"ready\");\n283:     await services.requestGeneration({ partyId, deviceId, channelId, jobId: \"job-default\", idempotencyKey: \"idem-default\", presetId: \"cheap_demo\" });\n284:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-default`).get()).data()?.rehearsalOnly, undefined);\n285:   } finally {\n286:     await clearParty(db, bucket, partyId);\n287:     await disposeEmulatorContext(app);\n288:   }\n289: });\n290: \n291: test(\"request idempotency cannot be rebound to another device\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n292:   const { app, db, bucket } = await createEmulatorContext();\n293:   const partyId = randomPartyId();\n294:   try {\n295:     await seedParty(db, partyId, \"tv-1\", \"main\");\n296:     await seedParty(db, partyId, \"tv-2\", \"main\");\n297:     const services = createGenerationServices({ db, bucket, provider: new FakeVideoGenerationPort() });\n298:     const input = { partyId, deviceId: \"tv-1\", channelId: \"main\", jobId: \"job-rebind\", idempotencyKey: \"idem-rebind\", presetId: \"cheap_demo\" };\n299:     await services.requestGeneration(input);\n300:     await assert.rejects(services.requestGeneration({ ...input, deviceId: \"tv-2\" }),\n301:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n302:   } finally {\n303:     await clearParty(db, bucket, partyId);\n304:     await disposeEmulatorContext(app);\n305:   }\n306: });\n307: \n308: test(\"submit body uses the media-field form for references (no network)\", () => {\n309:   // Offline regression for the live r2v defect: the signed URL rides as\n310:   // input.media; sha256 / reference_image never enter the submitted JSON.\n311:   const reference = {\n312:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n313:     sha256: \"c\".repeat(64),\n314:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n315:     url: \"https://signed.invalid/media-photo.jpg\",\n316:   };\n317:   const body = buildAlibabaSubmitBody(buildCheapDemoRequest(\"job-media\", \"idem-media\", \"CAM-01\", { ...reference }));\n318:   assert.deepEqual((body.input as Record<string, unknown>).media, [{ type: \"reference_image\", url: \"https://signed.invalid/media-photo.jpg\" }]);\n319:   assert.ok(!(\"reference_image\" in (body.input as Record<string, unknown>)));\n320:   assert.ok(!JSON.stringify(body).includes(\"c\".repeat(64)));\n321: });\n322: \n323: test(\"worker surfaces a provider FAILED reason in the error and on the job doc\", {\n324:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n325: }, async () => {\n326:   const { app, db, bucket } = await createEmulatorContext();\n327:   const partyId = randomPartyId();\n328:   const deviceId = \"tv-fail-reason\";\n329:   const channelId = \"main\";\n330:   const jobId = \"job-fail-reason\";\n331:   const idempotencyKey = \"idem-fail-reason\";\n332:   try {\n333:     await seedParty(db, partyId, deviceId, channelId);\n334:     const failingProvider = {\n335:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failreason000000000001\" }; },\n336:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> {\n337:         return { state: \"FAILED\", errorCode: \"InvalidParameter\", errorMessage: \"Field required: input.media\" };\n338:       },\n339:       async getResult(_taskId: string): Promise<ProviderResult> {\n340:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n341:       },\n342:     };\n343:     const services = createGenerationServices({\n344:       db, bucket, provider: failingProvider, pollIntervalMs: 1, sleep: async () => undefined,\n345:     });\n346:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n347:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n348:       (error: unknown) => error instanceof BackendError\n349:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n350:         && /Field required: input\\.media/.test(error.message));\n351:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n352:     assert.equal(job.state, \"failed\");\n353:     assert.ok(typeof job.providerErrorCode === \"string\" && job.providerErrorCode.includes(\"InvalidParameter\"));\n354:     assert.ok(job.providerErrorCode.includes(\"Field_required\"));\n355:     assert.ok(!JSON.stringify(job).includes(\"https://\"));\n356:   } finally {\n357:     await clearParty(db, bucket, partyId);\n358:     await disposeEmulatorContext(app);\n359:   }\n360: });\n361: \n362: test(\"worker keeps the generic mapping when a FAILED task carries no reason\", {\n363:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n364: }, async () => {\n365:   const { app, db, bucket } = await createEmulatorContext();\n366:   const partyId = randomPartyId();\n367:   const deviceId = \"tv-fail-empty\";\n368:   const channelId = \"main\";\n369:   const jobId = \"job-fail-empty\";\n370:   const idempotencyKey = \"idem-fail-empty\";\n371:   try {\n372:     await seedParty(db, partyId, deviceId, channelId);\n373:     const emptyProvider = {\n374:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failempty000000000001\" }; },\n375:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"FAILED\" }; },\n376:       async getResult(_taskId: string): Promise<ProviderResult> {\n377:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n378:       },\n379:     };\n380:     const services = createGenerationServices({\n381:       db, bucket, provider: emptyProvider, pollIntervalMs: 1, sleep: async () => undefined,\n382:     });\n383:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n384:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n385:       (error: unknown) => error instanceof BackendError\n386:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n387:         && error.message === \"Provider task failed.\");\n388:   } finally {\n389:     await clearParty(db, bucket, partyId);\n390:     await disposeEmulatorContext(app);\n391:   }\n392: });\n393: \n394: \n395: test(\"lazy provider fallback threads fixtureDirectory through both construction paths\", {\n396:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n397: }, async () => {\n398:   const { app, db, bucket } = await createEmulatorContext();\n399:   const partyId = randomPartyId();\n400:   const deviceId = \"tv-lazy-fixture\";\n401:   const channelId = \"main\";\n402:   const jobId = \"job-lazy-fixture\";\n403:   const idempotencyKey = \"idem-lazy-fixture\";\n404:   const { mkdtemp, copyFile, readFile } = await import(\"node:fs/promises\");\n405:   const { tmpdir } = await import(\"node:os\");\n406:   const { join } = await import(\"node:path\");\n407:   const { normalizeProviderVideo, removeNormalizedVideo } = await import(\"../src/normalize\");\n408:   const assets = resolve(process.cwd(), \"../../apps/tv_app/assets\");\n409:   // Every slot reads the CAM-01 bytes: only the threaded directory produces\n410:   // this digest on all four cameras.\n411:   const isolated = await mkdtemp(join(tmpdir(), \"halloween-fixtures-\"));\n412:   const cam01 = await readFile(join(assets, \"cam01.mp4\"));\n413:   for (const name of [\"cam01.mp4\", \"cam02.mp4\", \"cam03.mp4\", \"cam04.mp4\"]) {\n414:     await copyFile(join(assets, \"cam01.mp4\"), join(isolated, name));\n415:   }\n416:   const defaultCam02 = await readFile(join(assets, \"cam02.mp4\"));\n417:   assert.notDeepEqual(cam01, defaultCam02, \"fixture inputs must differ for this regression to discriminate\");\n418:   const expected = await normalizeProviderVideo(\n419:     { video: { kind: \"file\", value: join(isolated, \"cam01.mp4\") }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 },\n420:   );\n421:   try {\n422:     await seedParty(db, partyId, deviceId, channelId);\n423:     // No explicit provider: the service must lazily construct one from the\n424:     // threaded fixture directory instead of the repository default.\n425:     const services = createGenerationServices({\n426:       db, bucket, fixtureDirectory: isolated, pollIntervalMs: 1, sleep: async () => undefined,\n427:     });\n428:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n429:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n430:     assert.equal(run.state, \"ready\");\n431:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n432:     assert.equal(manifest.cameraClips.length, 4);\n433:     for (const clip of manifest.cameraClips as Array<{ cameraId: string; sha256: string; sizeBytes: number; objectPath: string }>) {\n434:       assert.equal(clip.sha256, expected.sha256, `${clip.cameraId} must come from the threaded fixture directory`);\n435:       assert.equal(clip.sizeBytes, expected.sizeBytes);\n436:       const [bytes] = await bucket.file(clip.objectPath).download();\n437:       assert.equal(createHash(\"sha256\").update(bytes).digest(\"hex\"), clip.sha256);\n438:     }\n439:   } finally {\n440:     await removeNormalizedVideo(expected).catch(() => undefined);\n441:     await clearParty(db, bucket, partyId);\n442:     await disposeEmulatorContext(app);\n443:   }\n444: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192d1e90974a080994a775e65ed49"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/generation.test.ts\"}"},"time":{"start":1793464592638,"end":1793464593294}}}}
{"type":"tool_use","timestamp":1793464593296,"sessionID":"ses_e6d2e2c41ffe5yy93t4od5G2vw","part":{"partID":"prt_192d1eb27001v7i9GuJXVxQeza","sessionID":"ses_e6d2e2c41ffe5yy93t4od5G2vw","messageID":"msg_192d1e35c001CQNSZUFru97xO5","type":"tool","id":"call_01a192d1eb3374889faf00d16483920e","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/guest_upload.test.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/guest_upload.test.ts, lines 1-704\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import test from \"node:test\";\n6: import type { Bucket, File } from \"@google-cloud/storage\";\n7: import type { Firestore } from \"firebase-admin/firestore\";\n8: import { BackendError } from \"../src/contracts\";\n9: import { GUEST_CONSENT_PURPOSE, GUEST_CONSENT_TEXT_VERSION, GUEST_MAX_IMAGE_BYTES } from \"../src/config\";\n10: import { createRuntimeServices } from \"../src/runtime\";\n11: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n12: import { sweepExpiredMedia } from \"../src/retention\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: const CONSENT = { accepted: true, textVersion: GUEST_CONSENT_TEXT_VERSION, purpose: GUEST_CONSENT_PURPOSE };\n23: \n24: async function photoBytes(): Promise<Buffer> {\n25:   return readFile(resolve(__dirname, \"fixtures/guest_photo.jpg\"));\n26: }\n27: \n28: function servicesFor(db: Firestore, bucket: Bucket, overrides: {\n29:   deleteGuestObject?: (file: File) => Promise<void>;\n30: } = {}) {\n31:   return createRuntimeServices({\n32:     db,\n33:     bucket,\n34:     generationEnabled: true,\n35:     provider: new FakeVideoGenerationPort(),\n36:     pollIntervalMs: 1,\n37:     sleep: async () => undefined,\n38:     // Emulator transport substitute: the Storage emulator cannot mint real v4\n39:     // signed URLs, so tests inject a deterministic capability string. This is\n40:     // NOT equivalent to cloud IAM signing; it only proves the backend returns\n41:     // a per-submission capability without persisting it.\n42:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n43:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n44:     ...overrides,\n45:   });\n46: }\n47: \n48: test(\"requestGuestUpload refuses missing consent, bad consent, and caller-supplied paths\", {\n49:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n50: }, async () => {\n51:   const { app, db, bucket } = await createEmulatorContext();\n52:   const partyId = randomPartyId();\n53:   try {\n54:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n55:     const services = servicesFor(db, bucket);\n56:     const base = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", contentType: \"image/jpeg\" };\n57:     await assert.rejects(services.requestGuestUpload({ ...base }),\n58:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n59:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: false, textVersion: \"v1\", purpose: \"guest_cameo\" } }),\n60:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n61:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v9\", purpose: \"guest_cameo\" } }),\n62:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n63:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v1\", purpose: \"other\" } }),\n64:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n65:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, contentType: \"image/gif\" }),\n66:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n67:     await assert.rejects(\n68:       services.requestGuestUpload({ ...base, consent: CONSENT, objectPath: \"parties/x/guests/y/ingest/z/photo.jpg\" }),\n69:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n70:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, deviceId: \"not-registered\" }),\n71:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n72:   } finally {\n73:     await clearParty(db, bucket, partyId);\n74:     await disposeEmulatorContext(app);\n75:   }\n76: });\n77: \n78: test(\"guest upload completes against real bytes and repeats idempotently\", {\n79:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n80: }, async () => {\n81:   const { app, db, bucket } = await createEmulatorContext();\n82:   const partyId = randomPartyId();\n83:   try {\n84:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n85:     const services = servicesFor(db, bucket);\n86:     const requested = await services.requestGuestUpload({\n87:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n88:     });\n89:     assert.ok(requested.submissionId);\n90:     assert.ok(requested.objectPath.startsWith(`parties/${partyId}/guests/p-guest-1/ingest/${requested.submissionId}/`));\n91:     assert.ok(requested.uploadUrl.includes(encodeURIComponent(requested.objectPath)));\n92:     assert.equal(requested.consentRevision, \"v1:\" + (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.consent.acceptedAt);\n93:     // The signed PUT capability is returned, never persisted.\n94:     const stored = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n95:     assert.equal(stored.status, \"pending_upload\");\n96:     assert.ok(!(\"uploadUrl\" in stored) && !JSON.stringify(stored).includes(\"upload.invalid\"));\n97:     // Simulate the PUT through the issued capability with real image bytes.\n98:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n99:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n100:     assert.equal(completed.status, \"eligible\");\n101:     const photo = await photoBytes();\n102:     assert.equal(completed.sha256, createHash(\"sha256\").update(photo).digest(\"hex\"));\n103:     assert.equal(completed.sizeBytes, photo.byteLength);\n104:     assert.ok(/^[a-f0-9]{64}$/.test(completed.sha256!));\n105:     assert.ok((completed.sizeBytes ?? 0) > 0);\n106:     const repeated = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n107:     assert.deepEqual(repeated, completed);\n108:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n109:     assert.equal(status.status, \"eligible\");\n110:     assert.equal(status.sha256, completed.sha256);\n111:     assert.ok(!(\"uploadUrl\" in status));\n112:   } finally {\n113:     await clearParty(db, bucket, partyId);\n114:     await disposeEmulatorContext(app);\n115:   }\n116: });\n117: \n118: test(\"guest media is scoped: cross-device and cross-party access is refused\", {\n119:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n120: }, async () => {\n121:   const { app, db, bucket } = await createEmulatorContext();\n122:   const partyId = randomPartyId();\n123:   try {\n124:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n125:     await seedParty(db, partyId, \"p-guest-2\", \"main\");\n126:     const services = servicesFor(db, bucket);\n127:     const requested = await services.requestGuestUpload({\n128:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n129:     });\n130:     await assert.rejects(services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n131:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n132:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n133:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n134:     await assert.rejects(services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n135:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n136:     await assert.rejects(services.getGuestMediaStatus({ partyId: \"other-party\", deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n137:       (e: unknown) => e instanceof BackendError && (e.errorCode === \"FORBIDDEN\" || e.errorCode === \"NOT_FOUND\"));\n138:   } finally {\n139:     await clearParty(db, bucket, partyId);\n140:     await disposeEmulatorContext(app);\n141:   }\n142: });\n143: \n144: test(\"withdrawal is idempotent, deletes the source, and verifies absence\", {\n145:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n146: }, async () => {\n147:   const { app, db, bucket } = await createEmulatorContext();\n148:   const partyId = randomPartyId();\n149:   try {\n150:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n151:     const services = servicesFor(db, bucket);\n152:     const requested = await services.requestGuestUpload({\n153:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n154:     });\n155:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n156:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n157:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n158:     assert.equal(withdrawn.status, \"withdrawn\");\n159:     assert.equal(withdrawn.verifiedAbsent, true);\n160:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n161:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n162:     const repeated = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n163:     assert.equal(repeated.status, \"withdrawn\");\n164:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n165:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n166:     assert.equal(tombstone.status, \"withdrawn\");\n167:     assert.equal(tombstone.tombstone, true);\n168:     // Withdrawn media can never become eligible again.\n169:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n170:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n171:   } finally {\n172:     await clearParty(db, bucket, partyId);\n173:     await disposeEmulatorContext(app);\n174:   }\n175: });\n176: \n177: test(\"PUT after withdrawal never restores eligibility and is deleted\", {\n178:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n179: }, async () => {\n180:   const { app, db, bucket } = await createEmulatorContext();\n181:   const partyId = randomPartyId();\n182:   try {\n183:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n184:     const services = servicesFor(db, bucket);\n185:     const requested = await services.requestGuestUpload({\n186:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n187:     });\n188:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n189:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n190:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n191:     // Late PUT through the stale capability.\n192:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n193:     assert.equal((await bucket.file(requested.objectPath).exists())[0], true);\n194:     const cleanup = await services.handleGuestIngestFinalized(requested.objectPath);\n195:     assert.deepEqual(cleanup, { handled: true, deleted: true });\n196:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n197:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n198:     assert.equal(status.status, \"withdrawn\");\n199:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n200:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n201:   } finally {\n202:     await clearParty(db, bucket, partyId);\n203:     await disposeEmulatorContext(app);\n204:   }\n205: });\n206: \n207: test(\"withdrawal retries a failed delete and verifies absence\", {\n208:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n209: }, async () => {\n210:   const { app, db, bucket } = await createEmulatorContext();\n211:   const partyId = randomPartyId();\n212:   try {\n213:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n214:     let deletes = 0;\n215:     const services = servicesFor(db, bucket, {\n216:       deleteGuestObject: async (file: { delete: (o?: object) => Promise<unknown> }) => {\n217:         deletes += 1;\n218:         if (deletes === 1) throw new Error(\"injected deletion failure\");\n219:         await file.delete({ ignoreNotFound: true });\n220:       },\n221:     });\n222:     const requested = await services.requestGuestUpload({\n223:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n224:     });\n225:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n226:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n227:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n228:     assert.equal(withdrawn.verifiedAbsent, true);\n229:     assert.ok(deletes >= 2, `expected a retried delete, saw ${deletes}`);\n230:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n231:   } finally {\n232:     await clearParty(db, bucket, partyId);\n233:     await disposeEmulatorContext(app);\n234:   }\n235: });\n236: \n237: test(\"retention protects pending uploads and removes abandoned inputs within 24h\", {\n238:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n239: }, async () => {\n240:   const { app, db, bucket } = await createEmulatorContext();\n241:   const partyId = randomPartyId();\n242:   try {\n243:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n244:     const services = servicesFor(db, bucket);\n245:     const live = await services.requestGuestUpload({\n246:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n247:     });\n248:     await bucket.file(live.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n249:     // Abandoned pending upload whose window lapsed (written directly to set a past expiry).\n250:     const abandonedId = \"gsub-abandoned000000000000000001\";\n251:     const abandonedPath = `parties/${partyId}/guests/p-guest-1/ingest/${abandonedId}/photo.jpg`;\n252:     await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).set({\n253:       submissionId: abandonedId,\n254:       partyId,\n255:       deviceId: \"p-guest-1\",\n256:       channelId: \"main\",\n257:       status: \"pending_upload\",\n258:       consent: { accepted: true, textVersion: \"v1\", purpose: \"guest_cameo\", acceptedAt: new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString(), deviceId: \"p-guest-1\" },\n259:       consentRevision: \"v1:abandoned\",\n260:       objectPath: abandonedPath,\n261:       contentType: \"image/jpeg\",\n262:       expiresAt: new Date(Date.now() - 60 * 1000),\n263:     });\n264:     await bucket.file(abandonedPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n265:     const result = await sweepExpiredMedia(db, bucket, new Date());\n266:     assert.ok(result.expiredGuestInputs >= 1);\n267:     assert.equal((await bucket.file(live.objectPath).exists())[0], true);\n268:     assert.equal((await bucket.file(abandonedPath).exists())[0], false);\n269:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).get()).data()?.status, \"expired\");\n270:   } finally {\n271:     await clearParty(db, bucket, partyId);\n272:     await disposeEmulatorContext(app);\n273:   }\n274: });\n275: \n276: const ASSET_FIXTURE_DIR = resolve(__dirname, \"../../../apps/tv_app/assets\");\n277: \n278: function stubReferenceSigning(bucket: Bucket): void {\n279:   // Emulator transport for the worker's reference-signing step: the Storage\n280:   // emulator cannot mint real v4 signed URLs, so the worker's\n281:   // signReferenceReadUrl (same machinery as delivery signReadUrl, 15-min TTL)\n282:   // is resolved here through a deterministic https capability. Save/download\n283:   // stay on the real file object; only signing is substituted. Idempotent.\n284:   const current = bucket.file as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n285:   if (current.__referenceSigningStubbed) return;\n286:   const originalFile = bucket.file.bind(bucket);\n287:   const stubbed = ((path: string, ...rest: unknown[]) => {\n288:     const ref = (originalFile as (...args: unknown[]) => ReturnType<Bucket[\"file\"]>)(path, ...rest);\n289:     ref.getSignedUrl = (async () => [`https://signed.invalid/${encodeURIComponent(String(path))}`]) as unknown as typeof ref.getSignedUrl;\n290:     return ref;\n291:   }) as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n292:   stubbed.__referenceSigningStubbed = true;\n293:   (bucket as unknown as { file: Bucket[\"file\"] }).file = stubbed;\n294: }\n295: \n296: function fullServices(db: Firestore, bucket: Bucket) {\n297:   // Full pipeline composition with the reference signing transport wired:\n298:   // without the stub the worker's signReferenceReadUrl cannot mint a v4 URL\n299:   // on the Storage emulator and guest-bound runGeneration fails closed with\n300:   // PROVIDER_UNAVAILABLE (\"Guest reference URL could not be signed\"). The\n301:   // fake provider itself keeps the strict fetchability gate (bare object-path\n302:   // references are rejected, exactly like the live adapter).\n303:   stubReferenceSigning(bucket);\n304:   return createRuntimeServices({\n305:     db,\n306:     bucket,\n307:     generationEnabled: true,\n308:     provider: new FakeVideoGenerationPort(ASSET_FIXTURE_DIR),\n309:     fixtureDirectory: ASSET_FIXTURE_DIR,\n310:     enqueueGeneration: async () => undefined,\n311:     pollIntervalMs: 1,\n312:     sleep: async () => undefined,\n313:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n314:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n315:   });\n316: }\n317: \n318: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n319:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n320: }, async () => {\n321:   const { app, db, bucket } = await createEmulatorContext();\n322:   const partyId = randomPartyId();\n323:   const deviceId = \"p-guest-1\";\n324:   const channelId = \"main\";\n325:   try {\n326:     await seedParty(db, partyId, deviceId, channelId);\n327:     const services = fullServices(db, bucket);\n328:     const requested = await services.requestGuestUpload({\n329:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n330:     });\n331:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n332:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n333:     const jobId = \"job-revoke-delivery\";\n334:     const idempotencyKey = \"idem-revoke-delivery\";\n335:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n336:     // The worker resolves the consented photo through the emulator signing\n337:     // transport above; the offline fake then enforces the same signed-https\n338:     // gate as the live adapter before accepting the submit.\n339:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n340:     assert.equal(run.state, \"ready\");\n341:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n342:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n343:     assert.equal(clipPaths.length, 4);\n344:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n345:     assert.equal(baseline.clips.length, 4);\n346:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n347:     assert.equal(withdrawn.verifiedAbsent, true);\n348:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n349:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n350:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n351:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n352:     // The tombstone is irreversible: the withdrawn binding can never back a\n353:     // new generation, so no new delivery can ever be issued from it. (At the\n354:     // merged cycle-11 tip this test additionally asserts the published\n355:     // manifest document is removed and getDeliveryUrls/getCurrentManifest\n356:     // reject afterwards; that revocation lives in the delivery/withdrawal\n357:     // composition outside this partition and is covered tip-side.)\n358:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n359:     assert.equal(tombstone.status, \"withdrawn\");\n360:     assert.equal(tombstone.tombstone, true);\n361:     await assert.rejects(services.requestGeneration({\n362:       partyId, deviceId, channelId, jobId: \"job-revoke-blocked\", idempotencyKey: \"idem-revoke-blocked\",\n363:       presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n364:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n365:   } finally {\n366:     await clearParty(db, bucket, partyId);\n367:     await disposeEmulatorContext(app);\n368:   }\n369: });\n370: \n371: test(\"withdrawn media refuses future generation\", {\n372:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n373: }, async () => {\n374:   const { app, db, bucket } = await createEmulatorContext();\n375:   const partyId = randomPartyId();\n376:   try {\n377:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n378:     const services = servicesFor(db, bucket);\n379:     const requested = await services.requestGuestUpload({\n380:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n381:     });\n382:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n383:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n384:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n385:     await assert.rejects(services.requestGeneration({\n386:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n387:       jobId: \"job-refused\", idempotencyKey: \"idem-refused\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n388:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n389:     await assert.rejects(services.requestGeneration({\n390:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n391:       jobId: \"job-unknown-guest\", idempotencyKey: \"idem-unknown-guest\", presetId: \"cheap_demo\", guestMediaId: \"gsub-doesnotexist00000000000001\",\n392:     }), (e: unknown) => e instanceof BackendError && (e.errorCode === \"NOT_FOUND\" || e.errorCode === \"FORBIDDEN\"));\n393:   } finally {\n394:     await clearParty(db, bucket, partyId);\n395:     await disposeEmulatorContext(app);\n396:   }\n397: });\n398: \n399: \n400: /** Wraps a bucket so object downloads are observable without changing stored bytes. */\n401: function downloadCountingBucket(bucket: Bucket): { bucket: Bucket; downloads: () => number } {\n402:   let count = 0;\n403:   const wrapped = new Proxy(bucket, {\n404:     get(target, prop, receiver) {\n405:       if (prop === \"file\") {\n406:         return (path: string) => {\n407:           const file = (target as Bucket).file(path);\n408:           return new Proxy(file, {\n409:             get(fileTarget, fileProp, fileReceiver) {\n410:               if (fileProp === \"download\") {\n411:                 return async (...args: unknown[]) => {\n412:                   count += 1;\n413:                   return Reflect.apply(\n414:                     (fileTarget as { download: (...a: unknown[]) => Promise<unknown> }).download,\n415:                     fileTarget,\n416:                     args,\n417:                   );\n418:                 };\n419:               }\n420:               const value = Reflect.get(fileTarget as object, fileProp, fileReceiver);\n421:               return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(fileTarget) : value;\n422:             },\n423:           });\n424:         };\n425:       }\n426:       const value = Reflect.get(target as object, prop, receiver);\n427:       return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(target) : value;\n428:     },\n429:   });\n430:   return { bucket: wrapped as unknown as Bucket, downloads: () => count };\n431: }\n432: \n433: test(\"oversized guest bytes are rejected size-first without a full download\", {\n434:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n435: }, async () => {\n436:   const { app, db, bucket } = await createEmulatorContext();\n437:   const partyId = randomPartyId();\n438:   try {\n439:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n440:     const counting = downloadCountingBucket(bucket);\n441:     const services = createRuntimeServices({\n442:       db,\n443:       bucket: counting.bucket,\n444:       generationEnabled: true,\n445:       provider: new FakeVideoGenerationPort(),\n446:       pollIntervalMs: 1,\n447:       sleep: async () => undefined,\n448:       signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n449:       signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n450:     });\n451:     const requested = await services.requestGuestUpload({\n452:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n453:     });\n454:     const oversized = Buffer.alloc(GUEST_MAX_IMAGE_BYTES + 1024, 0);\n455:     oversized[0] = 0xff; oversized[1] = 0xd8; oversized[2] = 0xff;\n456:     await bucket.file(requested.objectPath).save(oversized, { contentType: \"image/jpeg\" });\n457:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n458:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n459:     assert.equal(counting.downloads(), 0, \"size cap must be enforced from metadata before any download\");\n460:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.status, \"pending_upload\");\n461:   } finally {\n462:     await clearParty(db, bucket, partyId);\n463:     await disposeEmulatorContext(app);\n464:   }\n465: });\n466: \n467: test(\"completion never extends the immutable creation-based deletion deadline\", {\n468:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n469: }, async () => {\n470:   const { app, db, bucket } = await createEmulatorContext();\n471:   const partyId = randomPartyId();\n472:   try {\n473:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n474:     const services = servicesFor(db, bucket);\n475:     const requested = await services.requestGuestUpload({\n476:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n477:     });\n478:     const before = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n479:     assert.ok(before.deleteAt, \"request must persist an immutable deletion deadline\");\n480:     const deadlineMs = (before.deleteAt as { toDate: () => Date }).toDate().getTime();\n481:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n482:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n483:     assert.ok(Date.parse(completed.expiresAt) <= deadlineMs, \"completion must not extend retention past the creation-based deadline\");\n484:     const after = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n485:     assert.equal((after.deleteAt as { toDate: () => Date }).toDate().toISOString(), new Date(deadlineMs).toISOString());\n486:   } finally {\n487:     await clearParty(db, bucket, partyId);\n488:     await disposeEmulatorContext(app);\n489:   }\n490: });\n491: \n492: test(\"withdrawal releases the party budget pointer like failForWithdrawnConsent\", {\n493:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n494: }, async () => {\n495:   const { app, db, bucket } = await createEmulatorContext();\n496:   const partyId = randomPartyId();\n497:   try {\n498:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n499:     const services = fullServices(db, bucket);\n500:     const requested = await services.requestGuestUpload({\n501:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n502:     });\n503:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n504:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n505:     const jobId = \"job-budget-release\";\n506:     await services.requestGeneration({\n507:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", jobId, idempotencyKey: \"idem-budget-release\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n508:     });\n509:     assert.equal((await db.doc(`parties/${partyId}/generationBudget/active`).get()).data()?.activeJobId, jobId);\n510:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n511:     assert.equal(withdrawn.verifiedAbsent, true);\n512:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n513:     assert.equal(job.state, \"failed\");\n514:     assert.equal(job.errorCode, \"FORBIDDEN\");\n515:     assert.equal(job.reconciliationReason, \"GUEST_CONSENT_WITHDRAWN\");\n516:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n517:     assert.equal(budget?.activeJobId, null);\n518:     assert.equal(budget?.state, \"idle\");\n519:   } finally {\n520:     await clearParty(db, bucket, partyId);\n521:     await disposeEmulatorContext(app);\n522:   }\n523: });\n524: \n525: test(\"concurrent completion and withdrawal never leaves eligible-on-tombstone\", {\n526:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n527: }, async () => {\n528:   const { app, db, bucket } = await createEmulatorContext();\n529:   const partyId = randomPartyId();\n530:   try {\n531:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n532:     const services = servicesFor(db, bucket);\n533:     const requested = await services.requestGuestUpload({\n534:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n535:     });\n536:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n537:     const identity = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId };\n538:     const [completed, withdrawn] = await Promise.allSettled([\n539:       services.completeGuestUpload(identity),\n540:       services.withdrawGuestMedia(identity),\n541:     ]);\n542:     assert.equal(withdrawn.status, \"fulfilled\", \"withdrawal must settle\");\n543:     // Withdrawal is irreversible: whatever the interleaving, the tombstone wins.\n544:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n545:     assert.equal(tombstone.status, \"withdrawn\");\n546:     assert.equal(tombstone.tombstone, true);\n547:     const finalFields = tombstone as unknown as Record<string, unknown>;\n548:     assert.ok(!(finalFields.status === \"eligible\" && finalFields.tombstone === true), \"eligible-on-tombstone must be impossible\");\n549:     if (completed.status === \"rejected\") {\n550:       assert.ok(completed.reason instanceof BackendError && completed.reason.errorCode === \"FORBIDDEN\");\n551:     }\n552:     await assert.rejects(services.completeGuestUpload(identity),\n553:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n554:   } finally {\n555:     await clearParty(db, bucket, partyId);\n556:     await disposeEmulatorContext(app);\n557:   }\n558: });\n559: \n560: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n561:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n562: }, async () => {\n563:   const { app, db, bucket } = await createEmulatorContext();\n564:   const partyId = randomPartyId();\n565:   const deviceId = \"p-guest-1\";\n566:   const channelId = \"main\";\n567:   try {\n568:     await seedParty(db, partyId, deviceId, channelId);\n569:     const services = fullServices(db, bucket);\n570:     const requested = await services.requestGuestUpload({\n571:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n572:     });\n573:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n574:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n575:     const jobId = \"job-revoke-delivery\";\n576:     const idempotencyKey = \"idem-revoke-delivery\";\n577:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n578:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n579:     assert.equal(run.state, \"ready\");\n580:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n581:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n582:     assert.equal(clipPaths.length, 4);\n583:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n584:     assert.equal(baseline.clips.length, 4);\n585:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n586:     assert.equal(withdrawn.verifiedAbsent, true);\n587:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n588:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n589:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n590:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n591:     assert.equal((await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).exists, false);\n592:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n593:       (e: unknown) => e instanceof BackendError);\n594:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n595:       (e: unknown) => e instanceof BackendError);\n596:   } finally {\n597:     await clearParty(db, bucket, partyId);\n598:     await disposeEmulatorContext(app);\n599:   }\n600: });\n601: \n602: test(\"host-originated uploads use the namespaced host consent pair with an attestation copy\", {\n603:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n604: }, async () => {\n605:   const { app, db, bucket } = await createEmulatorContext();\n606:   const partyId = randomPartyId();\n607:   try {\n608:     await seedParty(db, partyId, \"p-host-1\", \"main\");\n609:     await db.doc(`parties/${partyId}/devices/p-host-1`).update({ role: \"host\" });\n610:     const services = servicesFor(db, bucket);\n611:     const requested = await services.requestGuestUpload({\n612:       partyId, deviceId: \"p-host-1\", channelId: \"main\",\n613:       consent: { accepted: true, textVersion: \"host_source_v1\", purpose: \"host_source\" },\n614:       contentType: \"image/jpeg\",\n615:     });\n616:     assert.ok(requested.submissionId);\n617:     const stored = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n618:     assert.equal(stored.consent.textVersion, \"host_source_v1\");\n619:     assert.equal(stored.consent.purpose, \"host_source\");\n620:     assert.equal(stored.attestation.textVersion, \"host_source_v1\");\n621:     assert.equal(stored.attestation.purpose, \"host_source\");\n622:     assert.equal(stored.attestation.role, \"host\");\n623:     assert.ok(String(requested.consentRevision).startsWith(\"host_source_v1:\"));\n624:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n625:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-host-1\", channelId: \"main\", submissionId: requested.submissionId });\n626:     assert.equal(completed.status, \"eligible\");\n627:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.status, \"eligible\");\n628:   } finally {\n629:     await clearParty(db, bucket, partyId);\n630:     await disposeEmulatorContext(app);\n631:   }\n632: });\n633: \n634: test(\"consent pairs never mix across roles\", {\n635:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n636: }, async () => {\n637:   const { app, db, bucket } = await createEmulatorContext();\n638:   const partyId = randomPartyId();\n639:   try {\n640:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n641:     await seedParty(db, partyId, \"p-host-1\", \"main\");\n642:     await db.doc(`parties/${partyId}/devices/p-host-1`).update({ role: \"host\" });\n643:     const services = servicesFor(db, bucket);\n644:     // A guest device presenting the host pair is rejected, and vice versa.\n645:     await assert.rejects(services.requestGuestUpload({\n646:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n647:       consent: { accepted: true, textVersion: \"host_source_v1\", purpose: \"host_source\" },\n648:       contentType: \"image/jpeg\",\n649:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n650:     await assert.rejects(services.requestGuestUpload({\n651:       partyId, deviceId: \"p-host-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n652:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n653:     // Unknown versions stay unsupported for both roles.\n654:     await assert.rejects(services.requestGuestUpload({\n655:       partyId, deviceId: \"p-host-1\", channelId: \"main\",\n656:       consent: { accepted: true, textVersion: \"v9\", purpose: \"host_source\" },\n657:       contentType: \"image/jpeg\",\n658:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n659:   } finally {\n660:     await clearParty(db, bucket, partyId);\n661:     await disposeEmulatorContext(app);\n662:   }\n663: });\n664: \n665: test(\"withdrawal deletes retained host previews and fails the bound seed closed\", {\n666:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n667: }, async () => {\n668:   const { app, db, bucket } = await createEmulatorContext();\n669:   const partyId = randomPartyId();\n670:   try {\n671:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n672:     const services = servicesFor(db, bucket);\n673:     const requested = await services.requestGuestUpload({\n674:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n675:     });\n676:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n677:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n678:     // A host seed bound to this submission with retained preview copies.\n679:     const jobId = \"hv-seed-bound\";\n680:     const stagedPath = `parties/${partyId}/channels/main/delivery/9/CAM-01.mp4`;\n681:     const previewPath = `parties/${partyId}/hostPreviews/seed-bound/CAM-01.mp4`;\n682:     await bucket.file(stagedPath).save(Buffer.from(\"staged\"));\n683:     await bucket.file(previewPath).save(Buffer.from(\"preview\"));\n684:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n685:       jobId, partyId, deviceId: \"p-guest-1\", channelId: \"main\", state: \"running\",\n686:       manifestVersion: 9, idempotencyKey: \"idem-bound\",\n687:       guestMedia: { submissionId: requested.submissionId },\n688:       stagedOutputs: { \"CAM-01\": { cameraId: \"CAM-01\", objectPath: stagedPath, sha256: \"a\".repeat(64) } },\n689:     });\n690:     await db.doc(`parties/${partyId}/seedVideos/seed-bound`).set({\n691:       seedId: \"seed-bound\", partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n692:       jobId, status: \"running\", previewPaths: [previewPath],\n693:     });\n694:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n695:     assert.ok(withdrawn.deletedObjects.includes(previewPath), \"retained host preview must be deleted at withdrawal\");\n696:     assert.ok(withdrawn.deletedObjects.includes(stagedPath), \"staged host derivative must be deleted at withdrawal\");\n697:     assert.equal((await bucket.file(previewPath).exists())[0], false);\n698:     assert.equal((await db.doc(`parties/${partyId}/seedVideos/seed-bound`).get()).data()?.status, \"failed\");\n699:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.hostDeleted, true);\n700:   } finally {\n701:     await clearParty(db, bucket, partyId);\n702:     await disposeEmulatorContext(app);\n703:   }\n704: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/guest_upload.test.ts, lines 1-704\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import test from \"node:test\";\n6: import type { Bucket, File } from \"@google-cloud/storage\";\n7: import type { Firestore } from \"firebase-admin/firestore\";\n8: import { BackendError } from \"../src/contracts\";\n9: import { GUEST_CONSENT_PURPOSE, GUEST_CONSENT_TEXT_VERSION, GUEST_MAX_IMAGE_BYTES } from \"../src/config\";\n10: import { createRuntimeServices } from \"../src/runtime\";\n11: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n12: import { sweepExpiredMedia } from \"../src/retention\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: const CONSENT = { accepted: true, textVersion: GUEST_CONSENT_TEXT_VERSION, purpose: GUEST_CONSENT_PURPOSE };\n23: \n24: async function photoBytes(): Promise<Buffer> {\n25:   return readFile(resolve(__dirname, \"fixtures/guest_photo.jpg\"));\n26: }\n27: \n28: function servicesFor(db: Firestore, bucket: Bucket, overrides: {\n29:   deleteGuestObject?: (file: File) => Promise<void>;\n30: } = {}) {\n31:   return createRuntimeServices({\n32:     db,\n33:     bucket,\n34:     generationEnabled: true,\n35:     provider: new FakeVideoGenerationPort(),\n36:     pollIntervalMs: 1,\n37:     sleep: async () => undefined,\n38:     // Emulator transport substitute: the Storage emulator cannot mint real v4\n39:     // signed URLs, so tests inject a deterministic capability string. This is\n40:     // NOT equivalent to cloud IAM signing; it only proves the backend returns\n41:     // a per-submission capability without persisting it.\n42:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n43:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n44:     ...overrides,\n45:   });\n46: }\n47: \n48: test(\"requestGuestUpload refuses missing consent, bad consent, and caller-supplied paths\", {\n49:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n50: }, async () => {\n51:   const { app, db, bucket } = await createEmulatorContext();\n52:   const partyId = randomPartyId();\n53:   try {\n54:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n55:     const services = servicesFor(db, bucket);\n56:     const base = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", contentType: \"image/jpeg\" };\n57:     await assert.rejects(services.requestGuestUpload({ ...base }),\n58:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n59:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: false, textVersion: \"v1\", purpose: \"guest_cameo\" } }),\n60:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n61:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v9\", purpose: \"guest_cameo\" } }),\n62:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n63:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v1\", purpose: \"other\" } }),\n64:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n65:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, contentType: \"image/gif\" }),\n66:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n67:     await assert.rejects(\n68:       services.requestGuestUpload({ ...base, consent: CONSENT, objectPath: \"parties/x/guests/y/ingest/z/photo.jpg\" }),\n69:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n70:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, deviceId: \"not-registered\" }),\n71:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n72:   } finally {\n73:     await clearParty(db, bucket, partyId);\n74:     await disposeEmulatorContext(app);\n75:   }\n76: });\n77: \n78: test(\"guest upload completes against real bytes and repeats idempotently\", {\n79:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n80: }, async () => {\n81:   const { app, db, bucket } = await createEmulatorContext();\n82:   const partyId = randomPartyId();\n83:   try {\n84:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n85:     const services = servicesFor(db, bucket);\n86:     const requested = await services.requestGuestUpload({\n87:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n88:     });\n89:     assert.ok(requested.submissionId);\n90:     assert.ok(requested.objectPath.startsWith(`parties/${partyId}/guests/p-guest-1/ingest/${requested.submissionId}/`));\n91:     assert.ok(requested.uploadUrl.includes(encodeURIComponent(requested.objectPath)));\n92:     assert.equal(requested.consentRevision, \"v1:\" + (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.consent.acceptedAt);\n93:     // The signed PUT capability is returned, never persisted.\n94:     const stored = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n95:     assert.equal(stored.status, \"pending_upload\");\n96:     assert.ok(!(\"uploadUrl\" in stored) && !JSON.stringify(stored).includes(\"upload.invalid\"));\n97:     // Simulate the PUT through the issued capability with real image bytes.\n98:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n99:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n100:     assert.equal(completed.status, \"eligible\");\n101:     const photo = await photoBytes();\n102:     assert.equal(completed.sha256, createHash(\"sha256\").update(photo).digest(\"hex\"));\n103:     assert.equal(completed.sizeBytes, photo.byteLength);\n104:     assert.ok(/^[a-f0-9]{64}$/.test(completed.sha256!));\n105:     assert.ok((completed.sizeBytes ?? 0) > 0);\n106:     const repeated = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n107:     assert.deepEqual(repeated, completed);\n108:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n109:     assert.equal(status.status, \"eligible\");\n110:     assert.equal(status.sha256, completed.sha256);\n111:     assert.ok(!(\"uploadUrl\" in status));\n112:   } finally {\n113:     await clearParty(db, bucket, partyId);\n114:     await disposeEmulatorContext(app);\n115:   }\n116: });\n117: \n118: test(\"guest media is scoped: cross-device and cross-party access is refused\", {\n119:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n120: }, async () => {\n121:   const { app, db, bucket } = await createEmulatorContext();\n122:   const partyId = randomPartyId();\n123:   try {\n124:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n125:     await seedParty(db, partyId, \"p-guest-2\", \"main\");\n126:     const services = servicesFor(db, bucket);\n127:     const requested = await services.requestGuestUpload({\n128:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n129:     });\n130:     await assert.rejects(services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n131:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n132:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n133:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n134:     await assert.rejects(services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n135:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n136:     await assert.rejects(services.getGuestMediaStatus({ partyId: \"other-party\", deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n137:       (e: unknown) => e instanceof BackendError && (e.errorCode === \"FORBIDDEN\" || e.errorCode === \"NOT_FOUND\"));\n138:   } finally {\n139:     await clearParty(db, bucket, partyId);\n140:     await disposeEmulatorContext(app);\n141:   }\n142: });\n143: \n144: test(\"withdrawal is idempotent, deletes the source, and verifies absence\", {\n145:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n146: }, async () => {\n147:   const { app, db, bucket } = await createEmulatorContext();\n148:   const partyId = randomPartyId();\n149:   try {\n150:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n151:     const services = servicesFor(db, bucket);\n152:     const requested = await services.requestGuestUpload({\n153:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n154:     });\n155:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n156:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n157:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n158:     assert.equal(withdrawn.status, \"withdrawn\");\n159:     assert.equal(withdrawn.verifiedAbsent, true);\n160:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n161:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n162:     const repeated = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n163:     assert.equal(repeated.status, \"withdrawn\");\n164:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n165:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n166:     assert.equal(tombstone.status, \"withdrawn\");\n167:     assert.equal(tombstone.tombstone, true);\n168:     // Withdrawn media can never become eligible again.\n169:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n170:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n171:   } finally {\n172:     await clearParty(db, bucket, partyId);\n173:     await disposeEmulatorContext(app);\n174:   }\n175: });\n176: \n177: test(\"PUT after withdrawal never restores eligibility and is deleted\", {\n178:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n179: }, async () => {\n180:   const { app, db, bucket } = await createEmulatorContext();\n181:   const partyId = randomPartyId();\n182:   try {\n183:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n184:     const services = servicesFor(db, bucket);\n185:     const requested = await services.requestGuestUpload({\n186:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n187:     });\n188:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n189:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n190:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n191:     // Late PUT through the stale capability.\n192:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n193:     assert.equal((await bucket.file(requested.objectPath).exists())[0], true);\n194:     const cleanup = await services.handleGuestIngestFinalized(requested.objectPath);\n195:     assert.deepEqual(cleanup, { handled: true, deleted: true });\n196:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n197:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n198:     assert.equal(status.status, \"withdrawn\");\n199:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n200:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n201:   } finally {\n202:     await clearParty(db, bucket, partyId);\n203:     await disposeEmulatorContext(app);\n204:   }\n205: });\n206: \n207: test(\"withdrawal retries a failed delete and verifies absence\", {\n208:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n209: }, async () => {\n210:   const { app, db, bucket } = await createEmulatorContext();\n211:   const partyId = randomPartyId();\n212:   try {\n213:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n214:     let deletes = 0;\n215:     const services = servicesFor(db, bucket, {\n216:       deleteGuestObject: async (file: { delete: (o?: object) => Promise<unknown> }) => {\n217:         deletes += 1;\n218:         if (deletes === 1) throw new Error(\"injected deletion failure\");\n219:         await file.delete({ ignoreNotFound: true });\n220:       },\n221:     });\n222:     const requested = await services.requestGuestUpload({\n223:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n224:     });\n225:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n226:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n227:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n228:     assert.equal(withdrawn.verifiedAbsent, true);\n229:     assert.ok(deletes >= 2, `expected a retried delete, saw ${deletes}`);\n230:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n231:   } finally {\n232:     await clearParty(db, bucket, partyId);\n233:     await disposeEmulatorContext(app);\n234:   }\n235: });\n236: \n237: test(\"retention protects pending uploads and removes abandoned inputs within 24h\", {\n238:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n239: }, async () => {\n240:   const { app, db, bucket } = await createEmulatorContext();\n241:   const partyId = randomPartyId();\n242:   try {\n243:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n244:     const services = servicesFor(db, bucket);\n245:     const live = await services.requestGuestUpload({\n246:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n247:     });\n248:     await bucket.file(live.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n249:     // Abandoned pending upload whose window lapsed (written directly to set a past expiry).\n250:     const abandonedId = \"gsub-abandoned000000000000000001\";\n251:     const abandonedPath = `parties/${partyId}/guests/p-guest-1/ingest/${abandonedId}/photo.jpg`;\n252:     await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).set({\n253:       submissionId: abandonedId,\n254:       partyId,\n255:       deviceId: \"p-guest-1\",\n256:       channelId: \"main\",\n257:       status: \"pending_upload\",\n258:       consent: { accepted: true, textVersion: \"v1\", purpose: \"guest_cameo\", acceptedAt: new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString(), deviceId: \"p-guest-1\" },\n259:       consentRevision: \"v1:abandoned\",\n260:       objectPath: abandonedPath,\n261:       contentType: \"image/jpeg\",\n262:       expiresAt: new Date(Date.now() - 60 * 1000),\n263:     });\n264:     await bucket.file(abandonedPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n265:     const result = await sweepExpiredMedia(db, bucket, new Date());\n266:     assert.ok(result.expiredGuestInputs >= 1);\n267:     assert.equal((await bucket.file(live.objectPath).exists())[0], true);\n268:     assert.equal((await bucket.file(abandonedPath).exists())[0], false);\n269:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).get()).data()?.status, \"expired\");\n270:   } finally {\n271:     await clearParty(db, bucket, partyId);\n272:     await disposeEmulatorContext(app);\n273:   }\n274: });\n275: \n276: const ASSET_FIXTURE_DIR = resolve(__dirname, \"../../../apps/tv_app/assets\");\n277: \n278: function stubReferenceSigning(bucket: Bucket): void {\n279:   // Emulator transport for the worker's reference-signing step: the Storage\n280:   // emulator cannot mint real v4 signed URLs, so the worker's\n281:   // signReferenceReadUrl (same machinery as delivery signReadUrl, 15-min TTL)\n282:   // is resolved here through a deterministic https capability. Save/download\n283:   // stay on the real file object; only signing is substituted. Idempotent.\n284:   const current = bucket.file as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n285:   if (current.__referenceSigningStubbed) return;\n286:   const originalFile = bucket.file.bind(bucket);\n287:   const stubbed = ((path: string, ...rest: unknown[]) => {\n288:     const ref = (originalFile as (...args: unknown[]) => ReturnType<Bucket[\"file\"]>)(path, ...rest);\n289:     ref.getSignedUrl = (async () => [`https://signed.invalid/${encodeURIComponent(String(path))}`]) as unknown as typeof ref.getSignedUrl;\n290:     return ref;\n291:   }) as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n292:   stubbed.__referenceSigningStubbed = true;\n293:   (bucket as unknown as { file: Bucket[\"file\"] }).file = stubbed;\n294: }\n295: \n296: function fullServices(db: Firestore, bucket: Bucket) {\n297:   // Full pipeline composition with the reference signing transport wired:\n298:   // without the stub the worker's signReferenceReadUrl cannot mint a v4 URL\n299:   // on the Storage emulator and guest-bound runGeneration fails closed with\n300:   // PROVIDER_UNAVAILABLE (\"Guest reference URL could not be signed\"). The\n301:   // fake provider itself keeps the strict fetchability gate (bare object-path\n302:   // references are rejected, exactly like the live adapter).\n303:   stubReferenceSigning(bucket);\n304:   return createRuntimeServices({\n305:     db,\n306:     bucket,\n307:     generationEnabled: true,\n308:     provider: new FakeVideoGenerationPort(ASSET_FIXTURE_DIR),\n309:     fixtureDirectory: ASSET_FIXTURE_DIR,\n310:     enqueueGeneration: async () => undefined,\n311:     pollIntervalMs: 1,\n312:     sleep: async () => undefined,\n313:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n314:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n315:   });\n316: }\n317: \n318: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n319:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n320: }, async () => {\n321:   const { app, db, bucket } = await createEmulatorContext();\n322:   const partyId = randomPartyId();\n323:   const deviceId = \"p-guest-1\";\n324:   const channelId = \"main\";\n325:   try {\n326:     await seedParty(db, partyId, deviceId, channelId);\n327:     const services = fullServices(db, bucket);\n328:     const requested = await services.requestGuestUpload({\n329:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n330:     });\n331:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n332:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n333:     const jobId = \"job-revoke-delivery\";\n334:     const idempotencyKey = \"idem-revoke-delivery\";\n335:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n336:     // The worker resolves the consented photo through the emulator signing\n337:     // transport above; the offline fake then enforces the same signed-https\n338:     // gate as the live adapter before accepting the submit.\n339:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n340:     assert.equal(run.state, \"ready\");\n341:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n342:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n343:     assert.equal(clipPaths.length, 4);\n344:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n345:     assert.equal(baseline.clips.length, 4);\n346:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n347:     assert.equal(withdrawn.verifiedAbsent, true);\n348:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n349:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n350:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n351:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n352:     // The tombstone is irreversible: the withdrawn binding can never back a\n353:     // new generation, so no new delivery can ever be issued from it. (At the\n354:     // merged cycle-11 tip this test additionally asserts the published\n355:     // manifest document is removed and getDeliveryUrls/getCurrentManifest\n356:     // reject afterwards; that revocation lives in the delivery/withdrawal\n357:     // composition outside this partition and is covered tip-side.)\n358:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n359:     assert.equal(tombstone.status, \"withdrawn\");\n360:     assert.equal(tombstone.tombstone, true);\n361:     await assert.rejects(services.requestGeneration({\n362:       partyId, deviceId, channelId, jobId: \"job-revoke-blocked\", idempotencyKey: \"idem-revoke-blocked\",\n363:       presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n364:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n365:   } finally {\n366:     await clearParty(db, bucket, partyId);\n367:     await disposeEmulatorContext(app);\n368:   }\n369: });\n370: \n371: test(\"withdrawn media refuses future generation\", {\n372:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n373: }, async () => {\n374:   const { app, db, bucket } = await createEmulatorContext();\n375:   const partyId = randomPartyId();\n376:   try {\n377:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n378:     const services = servicesFor(db, bucket);\n379:     const requested = await services.requestGuestUpload({\n380:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n381:     });\n382:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n383:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n384:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n385:     await assert.rejects(services.requestGeneration({\n386:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n387:       jobId: \"job-refused\", idempotencyKey: \"idem-refused\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n388:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n389:     await assert.rejects(services.requestGeneration({\n390:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n391:       jobId: \"job-unknown-guest\", idempotencyKey: \"idem-unknown-guest\", presetId: \"cheap_demo\", guestMediaId: \"gsub-doesnotexist00000000000001\",\n392:     }), (e: unknown) => e instanceof BackendError && (e.errorCode === \"NOT_FOUND\" || e.errorCode === \"FORBIDDEN\"));\n393:   } finally {\n394:     await clearParty(db, bucket, partyId);\n395:     await disposeEmulatorContext(app);\n396:   }\n397: });\n398: \n399: \n400: /** Wraps a bucket so object downloads are observable without changing stored bytes. */\n401: function downloadCountingBucket(bucket: Bucket): { bucket: Bucket; downloads: () => number } {\n402:   let count = 0;\n403:   const wrapped = new Proxy(bucket, {\n404:     get(target, prop, receiver) {\n405:       if (prop === \"file\") {\n406:         return (path: string) => {\n407:           const file = (target as Bucket).file(path);\n408:           return new Proxy(file, {\n409:             get(fileTarget, fileProp, fileReceiver) {\n410:               if (fileProp === \"download\") {\n411:                 return async (...args: unknown[]) => {\n412:                   count += 1;\n413:                   return Reflect.apply(\n414:                     (fileTarget as { download: (...a: unknown[]) => Promise<unknown> }).download,\n415:                     fileTarget,\n416:                     args,\n417:                   );\n418:                 };\n419:               }\n420:               const value = Reflect.get(fileTarget as object, fileProp, fileReceiver);\n421:               return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(fileTarget) : value;\n422:             },\n423:           });\n424:         };\n425:       }\n426:       const value = Reflect.get(target as object, prop, receiver);\n427:       return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(target) : value;\n428:     },\n429:   });\n430:   return { bucket: wrapped as unknown as Bucket, downloads: () => count };\n431: }\n432: \n433: test(\"oversized guest bytes are rejected size-first without a full download\", {\n434:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n435: }, async () => {\n436:   const { app, db, bucket } = await createEmulatorContext();\n437:   const partyId = randomPartyId();\n438:   try {\n439:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n440:     const counting = downloadCountingBucket(bucket);\n441:     const services = createRuntimeServices({\n442:       db,\n443:       bucket: counting.bucket,\n444:       generationEnabled: true,\n445:       provider: new FakeVideoGenerationPort(),\n446:       pollIntervalMs: 1,\n447:       sleep: async () => undefined,\n448:       signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n449:       signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n450:     });\n451:     const requested = await services.requestGuestUpload({\n452:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n453:     });\n454:     const oversized = Buffer.alloc(GUEST_MAX_IMAGE_BYTES + 1024, 0);\n455:     oversized[0] = 0xff; oversized[1] = 0xd8; oversized[2] = 0xff;\n456:     await bucket.file(requested.objectPath).save(oversized, { contentType: \"image/jpeg\" });\n457:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n458:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n459:     assert.equal(counting.downloads(), 0, \"size cap must be enforced from metadata before any download\");\n460:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.status, \"pending_upload\");\n461:   } finally {\n462:     await clearParty(db, bucket, partyId);\n463:     await disposeEmulatorContext(app);\n464:   }\n465: });\n466: \n467: test(\"completion never extends the immutable creation-based deletion deadline\", {\n468:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n469: }, async () => {\n470:   const { app, db, bucket } = await createEmulatorContext();\n471:   const partyId = randomPartyId();\n472:   try {\n473:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n474:     const services = servicesFor(db, bucket);\n475:     const requested = await services.requestGuestUpload({\n476:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n477:     });\n478:     const before = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n479:     assert.ok(before.deleteAt, \"request must persist an immutable deletion deadline\");\n480:     const deadlineMs = (before.deleteAt as { toDate: () => Date }).toDate().getTime();\n481:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n482:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n483:     assert.ok(Date.parse(completed.expiresAt) <= deadlineMs, \"completion must not extend retention past the creation-based deadline\");\n484:     const after = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n485:     assert.equal((after.deleteAt as { toDate: () => Date }).toDate().toISOString(), new Date(deadlineMs).toISOString());\n486:   } finally {\n487:     await clearParty(db, bucket, partyId);\n488:     await disposeEmulatorContext(app);\n489:   }\n490: });\n491: \n492: test(\"withdrawal releases the party budget pointer like failForWithdrawnConsent\", {\n493:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n494: }, async () => {\n495:   const { app, db, bucket } = await createEmulatorContext();\n496:   const partyId = randomPartyId();\n497:   try {\n498:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n499:     const services = fullServices(db, bucket);\n500:     const requested = await services.requestGuestUpload({\n501:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n502:     });\n503:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n504:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n505:     const jobId = \"job-budget-release\";\n506:     await services.requestGeneration({\n507:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", jobId, idempotencyKey: \"idem-budget-release\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n508:     });\n509:     assert.equal((await db.doc(`parties/${partyId}/generationBudget/active`).get()).data()?.activeJobId, jobId);\n510:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n511:     assert.equal(withdrawn.verifiedAbsent, true);\n512:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n513:     assert.equal(job.state, \"failed\");\n514:     assert.equal(job.errorCode, \"FORBIDDEN\");\n515:     assert.equal(job.reconciliationReason, \"GUEST_CONSENT_WITHDRAWN\");\n516:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n517:     assert.equal(budget?.activeJobId, null);\n518:     assert.equal(budget?.state, \"idle\");\n519:   } finally {\n520:     await clearParty(db, bucket, partyId);\n521:     await disposeEmulatorContext(app);\n522:   }\n523: });\n524: \n525: test(\"concurrent completion and withdrawal never leaves eligible-on-tombstone\", {\n526:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n527: }, async () => {\n528:   const { app, db, bucket } = await createEmulatorContext();\n529:   const partyId = randomPartyId();\n530:   try {\n531:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n532:     const services = servicesFor(db, bucket);\n533:     const requested = await services.requestGuestUpload({\n534:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n535:     });\n536:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n537:     const identity = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId };\n538:     const [completed, withdrawn] = await Promise.allSettled([\n539:       services.completeGuestUpload(identity),\n540:       services.withdrawGuestMedia(identity),\n541:     ]);\n542:     assert.equal(withdrawn.status, \"fulfilled\", \"withdrawal must settle\");\n543:     // Withdrawal is irreversible: whatever the interleaving, the tombstone wins.\n544:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n545:     assert.equal(tombstone.status, \"withdrawn\");\n546:     assert.equal(tombstone.tombstone, true);\n547:     const finalFields = tombstone as unknown as Record<string, unknown>;\n548:     assert.ok(!(finalFields.status === \"eligible\" && finalFields.tombstone === true), \"eligible-on-tombstone must be impossible\");\n549:     if (completed.status === \"rejected\") {\n550:       assert.ok(completed.reason instanceof BackendError && completed.reason.errorCode === \"FORBIDDEN\");\n551:     }\n552:     await assert.rejects(services.completeGuestUpload(identity),\n553:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n554:   } finally {\n555:     await clearParty(db, bucket, partyId);\n556:     await disposeEmulatorContext(app);\n557:   }\n558: });\n559: \n560: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n561:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n562: }, async () => {\n563:   const { app, db, bucket } = await createEmulatorContext();\n564:   const partyId = randomPartyId();\n565:   const deviceId = \"p-guest-1\";\n566:   const channelId = \"main\";\n567:   try {\n568:     await seedParty(db, partyId, deviceId, channelId);\n569:     const services = fullServices(db, bucket);\n570:     const requested = await services.requestGuestUpload({\n571:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n572:     });\n573:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n574:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n575:     const jobId = \"job-revoke-delivery\";\n576:     const idempotencyKey = \"idem-revoke-delivery\";\n577:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n578:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n579:     assert.equal(run.state, \"ready\");\n580:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n581:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n582:     assert.equal(clipPaths.length, 4);\n583:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n584:     assert.equal(baseline.clips.length, 4);\n585:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n586:     assert.equal(withdrawn.verifiedAbsent, true);\n587:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n588:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n589:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n590:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n591:     assert.equal((await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).exists, false);\n592:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n593:       (e: unknown) => e instanceof BackendError);\n594:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n595:       (e: unknown) => e instanceof BackendError);\n596:   } finally {\n597:     await clearParty(db, bucket, partyId);\n598:     await disposeEmulatorContext(app);\n599:   }\n600: });\n601: \n602: test(\"host-originated uploads use the namespaced host consent pair with an attestation copy\", {\n603:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n604: }, async () => {\n605:   const { app, db, bucket } = await createEmulatorContext();\n606:   const partyId = randomPartyId();\n607:   try {\n608:     await seedParty(db, partyId, \"p-host-1\", \"main\");\n609:     await db.doc(`parties/${partyId}/devices/p-host-1`).update({ role: \"host\" });\n610:     const services = servicesFor(db, bucket);\n611:     const requested = await services.requestGuestUpload({\n612:       partyId, deviceId: \"p-host-1\", channelId: \"main\",\n613:       consent: { accepted: true, textVersion: \"host_source_v1\", purpose: \"host_source\" },\n614:       contentType: \"image/jpeg\",\n615:     });\n616:     assert.ok(requested.submissionId);\n617:     const stored = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n618:     assert.equal(stored.consent.textVersion, \"host_source_v1\");\n619:     assert.equal(stored.consent.purpose, \"host_source\");\n620:     assert.equal(stored.attestation.textVersion, \"host_source_v1\");\n621:     assert.equal(stored.attestation.purpose, \"host_source\");\n622:     assert.equal(stored.attestation.role, \"host\");\n623:     assert.ok(String(requested.consentRevision).startsWith(\"host_source_v1:\"));\n624:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n625:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-host-1\", channelId: \"main\", submissionId: requested.submissionId });\n626:     assert.equal(completed.status, \"eligible\");\n627:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.status, \"eligible\");\n628:   } finally {\n629:     await clearParty(db, bucket, partyId);\n630:     await disposeEmulatorContext(app);\n631:   }\n632: });\n633: \n634: test(\"consent pairs never mix across roles\", {\n635:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n636: }, async () => {\n637:   const { app, db, bucket } = await createEmulatorContext();\n638:   const partyId = randomPartyId();\n639:   try {\n640:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n641:     await seedParty(db, partyId, \"p-host-1\", \"main\");\n642:     await db.doc(`parties/${partyId}/devices/p-host-1`).update({ role: \"host\" });\n643:     const services = servicesFor(db, bucket);\n644:     // A guest device presenting the host pair is rejected, and vice versa.\n645:     await assert.rejects(services.requestGuestUpload({\n646:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n647:       consent: { accepted: true, textVersion: \"host_source_v1\", purpose: \"host_source\" },\n648:       contentType: \"image/jpeg\",\n649:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n650:     await assert.rejects(services.requestGuestUpload({\n651:       partyId, deviceId: \"p-host-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n652:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n653:     // Unknown versions stay unsupported for both roles.\n654:     await assert.rejects(services.requestGuestUpload({\n655:       partyId, deviceId: \"p-host-1\", channelId: \"main\",\n656:       consent: { accepted: true, textVersion: \"v9\", purpose: \"host_source\" },\n657:       contentType: \"image/jpeg\",\n658:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n659:   } finally {\n660:     await clearParty(db, bucket, partyId);\n661:     await disposeEmulatorContext(app);\n662:   }\n663: });\n664: \n665: test(\"withdrawal deletes retained host previews and fails the bound seed closed\", {\n666:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n667: }, async () => {\n668:   const { app, db, bucket } = await createEmulatorContext();\n669:   const partyId = randomPartyId();\n670:   try {\n671:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n672:     const services = servicesFor(db, bucket);\n673:     const requested = await services.requestGuestUpload({\n674:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n675:     });\n676:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n677:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n678:     // A host seed bound to this submission with retained preview copies.\n679:     const jobId = \"hv-seed-bound\";\n680:     const stagedPath = `parties/${partyId}/channels/main/delivery/9/CAM-01.mp4`;\n681:     const previewPath = `parties/${partyId}/hostPreviews/seed-bound/CAM-01.mp4`;\n682:     await bucket.file(stagedPath).save(Buffer.from(\"staged\"));\n683:     await bucket.file(previewPath).save(Buffer.from(\"preview\"));\n684:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n685:       jobId, partyId, deviceId: \"p-guest-1\", channelId: \"main\", state: \"running\",\n686:       manifestVersion: 9, idempotencyKey: \"idem-bound\",\n687:       guestMedia: { submissionId: requested.submissionId },\n688:       stagedOutputs: { \"CAM-01\": { cameraId: \"CAM-01\", objectPath: stagedPath, sha256: \"a\".repeat(64) } },\n689:     });\n690:     await db.doc(`parties/${partyId}/seedVideos/seed-bound`).set({\n691:       seedId: \"seed-bound\", partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n692:       jobId, status: \"running\", previewPaths: [previewPath],\n693:     });\n694:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n695:     assert.ok(withdrawn.deletedObjects.includes(previewPath), \"retained host preview must be deleted at withdrawal\");\n696:     assert.ok(withdrawn.deletedObjects.includes(stagedPath), \"staged host derivative must be deleted at withdrawal\");\n697:     assert.equal((await bucket.file(previewPath).exists())[0], false);\n698:     assert.equal((await db.doc(`parties/${partyId}/seedVideos/seed-bound`).get()).data()?.status, \"failed\");\n699:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.hostDeleted, true);\n700:   } finally {\n701:     await clearParty(db, bucket, partyId);\n702:     await disposeEmulatorContext(app);\n703:   }\n704: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192d1eb3374889faf00d16483920e"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/test/guest_upload.test.ts\"}"},"time":{"start":1793464593191,"end":1793464593296}}}}
