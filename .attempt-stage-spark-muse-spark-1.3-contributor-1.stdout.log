dError(\"INVALID_ARGUMENT\", \"A positive manifestVersion is required.\");\n117:   }\n118:   if (!isRecord(value.clipHashes)) throw new BackendError(\"INVALID_ARGUMENT\", \"clipHashes must be an object.\");\n119:   // 1/2/4-camera layouts: the ACK key set must exactly equal the first-N\n120:   // canonical prefix for one supported count. Extra hashes (beyond the\n121:   // manifest's prefix) are rejected here; exact match against the actual\n122:   // manifest (same length + same hashes) is enforced at ACK acceptance.\n123:   const keys = Object.keys(value.clipHashes).sort();\n124:   const supportedKeySets = (SUPPORTED_CAMERA_COUNTS as readonly number[]).map(\n125:     (count) => [...expectedCameraIds(count)].sort().join(\",\"),\n126:   );\n127:   if (!supportedKeySets.includes(keys.join(\",\"))) {\n128:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK must include one hash for each canonical camera clip (1, 2, or 4 clips, first-N prefix).\");\n129:   }\n130:   const clipHashes: Record<string, string> = {};\n131:   for (const cameraId of keys) {\n132:     const hash = (value.clipHashes as Record<string, unknown>)[cameraId];\n133:     if (typeof hash !== \"string\" || !HASH_RE.test(hash)) {\n134:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hashes must be canonical SHA-256 hex values.\");\n135:     }\n136:     clipHashes[cameraId] = hash;\n137:   }\n138:   return { ...identity, manifestVersion: Number(value.manifestVersion), clipHashes };\n139: }\n140: \n141: export function parseCurrentManifestInput(value: unknown): CurrentManifestInput {\n142:   const identity = requireIdentity(value);\n143:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n144:   return identity;\n145: }\n146: \n147: export interface JoinPartyInput extends Identity {\n148:   joinPin?: string;\n149: }\n150: \n151: /** Exactly six ASCII digits; leading zeros are significant. */\n152: export const JOIN_PIN_RE = /^[0-9]{6}$/;\n153: \n154: export function parseJoinPartyInput(value: unknown): JoinPartyInput {\n155:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n156:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n157:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n158:   }\n159:   const partyId = validateId(value.partyId, \"partyId\");\n160:   const deviceId = validateId(value.deviceId, \"deviceId\");\n161:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n162:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n163:   }\n164:   const channelId = validateId(value.channelId, \"channelId\");\n165:   if (value.joinPin === undefined) {\n166:     return { partyId, deviceId, channelId };\n167:   }\n168:   if (typeof value.joinPin !== \"string\" || !JOIN_PIN_RE.test(value.joinPin)) {\n169:     throw new BackendError(\"INVALID_ARGUMENT\", \"joinPin must be six digits.\");\n170:   }\n171:   return { partyId, deviceId, channelId, joinPin: value.joinPin };\n172: }\n173: \n174: export function validateId(value: unknown, label: string): string {\n175:   if (typeof value !== \"string\" || !ID_RE.test(value)) {\n176:     throw new BackendError(\"INVALID_ARGUMENT\", `${label} is invalid.`);\n177:   }\n178:   return value;\n179: }\n180: \n181: export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n182:   if (!Array.isArray(clips) || !(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(clips.length)) {\n183:     throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain 1, 2, or 4 camera clips (four is the default layout).\");\n184:   }\n185:   const expected = new Set<string>([...expectedCameraIds(clips.length)]);\n186:   const byCamera = new Map<string, CanonicalClip>();\n187:   for (const raw of clips) {\n188:     if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n189:         !expected.has(raw.cameraId) ||\n190:         typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n191:         !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n192:         (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n193:         typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n194:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n195:     }\n196:     if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n197:     byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n198:   }\n199:   // Prefix rule: reordered valid clips are accepted, but gaps (e.g.\n200:   // {CAM-01, CAM-03} for count 2) and unknown cameras are rejected.\n201:   if (byCamera.size !== expected.size || [...expected].some((cameraId) => !byCamera.has(cameraId))) {\n202:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set must equal the first-N canonical cameras.\");\n203:   }\n204: }\n205: \n206: export function canonicalManifestHash(manifest: Pick<DeliveryManifest, \"partyId\" | \"channelId\" | \"version\" | \"cameraClips\">): string {\n207:   const canonical = {\n208:     partyId: manifest.partyId,\n209:     channelId: manifest.channelId,\n210:     version: manifest.version,\n211:     cameraClips: [...manifest.cameraClips]\n212:       .sort((a, b) => a.cameraId.localeCompare(b.cameraId))\n213:       .map(({ cameraId, sha256, sizeBytes, durationMs }) => ({ cameraId, sha256, sizeBytes, durationMs })),\n214:   };\n215:   return createHash(\"sha256\").update(JSON.stringify(canonical)).digest(\"hex\");\n216: }\n217: \n218: export function ackIdempotencyKey(deviceId: string, channelId: string, manifestVersion: number): string {\n219:   return createHash(\"sha256\").update(`${deviceId}\\n${channelId}\\n${manifestVersion}`).digest(\"hex\");\n220: }\n221: \n222: export function isErrorCode(value: unknown): value is ErrorCode {\n223:   return typeof value === \"string\" && (ERROR_CODES as readonly string[]).includes(value);\n224: }\n225: \n226: // ---------------------------------------------------------------------------\n227: // Host administration (cycle-12, partition p1).\n228: //\n229: // The companion uses a dedicated host entry screen (HostEntryScreen with\n230: // Scan Host QR + explicit Join-as-guest route; see partition p4/5 + README).\n231: // Rationale: guest PIN admission is intentionally broad (anyone who sees the\n232: // TV can join as a guest with full party-scoped read/generate/ACK power),\n233: // so host administration must never be reachable through the guest PIN or a\n234: // client-supplied role string. Host access is a separate server-minted,\n235: // short-lived invite capability redeemable once, bound to party/channel/\n236: // expiry, with the host role assigned server-side only.\n237: //\n238: // Callable surface (all exported through index.ts + runtime.ts):\n239: //   createHostInvite  (TV-only)  -> { inviteToken, expiresAt }\n240: //   joinHost          (phone)     -> { role: \"host\" } (separate device identity)\n241: //   listHostVideos    (host-only) -> seed catalog entries\n242: //   generateHostVideo (host-only) -> fixed-preset queued generation + seed entry\n243: //   getHostVideoPreview (host-only) -> signed preview URLs (never persisted)\n244: //   deleteHostVideo   (host-only) -> delete seeds + objects, revoke manifests\n245: // ---------------------------------------------------------------------------\n246: \n247: /** Server-assigned device roles. Clients can never self-assign \"host\" or \"tv\". */\n248: export const DEVICE_ROLES = [\"guest\", \"host\", \"tv\"] as const;\n249: export type DeviceRole = (typeof DEVICE_ROLES)[number];\n250: \n251: export interface CreateHostInviteInput extends Identity {}\n252: \n253: export interface CreateHostInviteResult {\n254:   partyId: string;\n255:   channelId: string;\n256:   inviteToken: string;\n257:   expiresAt: string;\n258: }\n259: \n260: export interface JoinHostInput extends Identity {\n261:   inviteToken: string;\n262: }\n263: \n264: export interface JoinHostResult {\n265:   partyId: string;\n266:   deviceId: string;\n267:   channelId: string;\n268:   role: \"host\";\n269:   status: \"active\";\n270:   created: boolean;\n271: }\n272: \n273: export interface ListHostVideosInput extends Identity {}\n274: \n275: export type HostSeedStatus = \"queued\" | \"running\" | \"ready\" | \"failed\" | \"deleted\";\n276: \n277: export interface HostSeedEntry {\n278:   seedId: string;\n279:   partyId: string;\n280:   channelId: string;\n281:   status: HostSeedStatus;\n282:   jobId: string;\n283:   createdAt: string;\n284:   expiresAt: string;\n285:   previewAvailable: boolean;\n286:   cameraIds: string[];\n287: }\n288: \n289: export interface GenerateHostVideoInput extends Identity {\n290:   seedId: string;\n291:   idempotencyKey: string;\n292:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n293:   guestMediaId?: string;\n294: }\n295: \n296: export interface GenerateHostVideoResult {\n297:   seedId: string;\n298:   jobId: string;\n299:   state: string;\n300:   created: boolean;\n301: }\n302: \n303: export interface GetHostVideoPreviewInput extends Identity {\n304:   seedId: string;\n305: }\n306: \n307: export interface GetHostVideoPreviewResult {\n308:   seedId: string;\n309:   expiresAt: string;\n310:   clips: Array<{ cameraId: string; sha256: string; url: string; expiresAt: string }>;\n311: }\n312: \n313: export interface DeleteHostVideoInput extends Identity {\n314:   seedIds: string[];\n315: }\n316: \n317: export interface DeleteHostVideoResult {\n318:   deletedSeedIds: string[];\n319:   deletedObjects: string[];\n320:   revokedManifest: boolean;\n321: }\n322: \n323: export function parseCreateHostInviteInput(value: unknown): CreateHostInviteInput {\n324:   const identity = requireIdentity(value);\n325:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n326:   return identity;\n327: }\n328: \n329: export function parseJoinHostInput(value: unknown): JoinHostInput {\n330:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n331:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n332:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n333:   }\n334:   const partyId = validateId(value.partyId, \"partyId\");\n335:   const deviceId = validateId(value.deviceId, \"deviceId\");\n336:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n337:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n338:   }\n339:   const channelId = validateId(value.channelId, \"channelId\");\n340:   // The invite token is a server-minted capability, never a guest PIN: PIN\n341:   // shape alone must not redeem host access, and client-supplied role\n342:   // strings are ignored (the server assigns \"host\" transactionally).\n343:   if (typeof value.inviteToken !== \"string\" || value.inviteToken.trim() === \"\" || value.inviteToken.length > 256) {\n344:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken is required.\");\n345:   }\n346:   if (JOIN_PIN_RE.test(value.inviteToken)) {\n347:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken must be a host invite, not a guest PIN.\");\n348:   }\n349:   return { partyId, deviceId, channelId, inviteToken: value.inviteToken };\n350: }\n351: \n352: export function parseListHostVideosInput(value: unknown): ListHostVideosInput {\n353:   const identity = requireIdentity(value);\n354:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n355:   return identity;\n356: }\n357: \n358: export function parseGenerateHostVideoInput(value: unknown): GenerateHostVideoInput {\n359:   const identity = requireIdentity(value);\n360:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n361:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n362:   const seedId = validateId(value.seedId, \"seedId\");\n363:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n364:   // Fixed-preset queue only: same lock as requestGeneration (cheap_demo or\n365:   // cameo_demo with its consent binding); caller overrides are rejected.\n366:   if (value.presetId !== undefined &&\n367:       value.presetId !== CHEAP_DEMO_PRESET.presetId &&\n368:       value.presetId !== CAMEO_DEMO_PRESET.presetId) {\n369:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the fixed generation presets are supported.\");\n370:   }\n371:   const presetId = (value.presetId ?? CHEAP_DEMO_PRESET.presetId) as GenerateHostVideoInput[\"presetId\"];\n372:   if (presetId === CAMEO_DEMO_PRESET.presetId) {\n373:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n374:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n375:     }\n376:     validateId(value.guestMediaId, \"guestMediaId\");\n377:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n378:   }\n379:   if (value.guestMediaId !== undefined) {\n380:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n381:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n382:     }\n383:     validateId(value.guestMediaId, \"guestMediaId\");\n384:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n385:   }\n386:   return { ...identity, seedId, idempotencyKey, presetId };\n387: }\n388: \n389: export function parseGetHostVideoPreviewInput(value: unknown): GetHostVideoPreviewInput {\n390:   const identity = requireIdentity(value);\n391:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n392:   if (!isRecord(value) || typeof value.seedId !== \"string\" || !value.seedId) {\n393:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedId is required.\");\n394:   }\n395:   return { ...identity, seedId: validateId(value.seedId, \"seedId\") };\n396: }\n397: \n398: export function parseDeleteHostVideoInput(value: unknown): DeleteHostVideoInput {\n399:   const identity = requireIdentity(value);\n400:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n401:   if (!isRecord(value) || !Array.isArray(value.seedIds) || value.seedIds.length === 0 || value.seedIds.length > 32) {\n402:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedIds must be a non-empty list (max 32).\");\n403:   }\n404:   const seen = new Set<string>();\n405:   const seedIds: string[] = [];\n406:   for (const raw of value.seedIds) {\n407:     const seedId = validateId(raw, \"seedId\");\n408:     if (seen.has(seedId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Duplicate seedId.\");\n409:     seen.add(seedId);\n410:     seedIds.push(seedId);\n411:   }\n412:   return { ...identity, seedIds };\n413: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/contracts.ts, lines 1-413\n1: import { createHash } from \"node:crypto\";\n2: import { CAMEO_DEMO_PRESET, CHEAP_DEMO_PRESET, ERROR_CODES, ErrorCode, REQUIRED_CAMERA_IDS, SUPPORTED_CAMERA_COUNTS, expectedCameraIds } from \"./config\";\n3: \n4: export type { ErrorCode };\n5: \n6: export class BackendError extends Error {\n7:   constructor(readonly errorCode: ErrorCode, message: string) {\n8:     super(message);\n9:     this.name = \"BackendError\";\n10:   }\n11: }\n12: \n13: export interface Identity {\n14:   partyId: string;\n15:   deviceId: string;\n16:   channelId: string;\n17: }\n18: \n19: export interface RequestGenerationInput extends Identity {\n20:   jobId: string;\n21:   idempotencyKey: string;\n22:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n23:   /** Optional consent-bound guest media submission bound at request time. */\n24:   guestMediaId?: string;\n25: }\n26: \n27: export interface CanonicalClip {\n28:   cameraId: (typeof REQUIRED_CAMERA_IDS)[number];\n29:   objectPath: string;\n30:   sha256: string;\n31:   sizeBytes: number;\n32:   durationMs: number;\n33:   expiresAt: string;\n34: }\n35: \n36: export interface DeliveryManifest {\n37:   partyId: string;\n38:   channelId: string;\n39:   version: number;\n40:   schemaVersion: number;\n41:   jobId: string;\n42:   cameraClips: CanonicalClip[];\n43:   /** Firestore timestamp in storage; callable serialization converts it to ISO. */\n44:   createdAt?: unknown;\n45:   expiresAt: string;\n46: }\n47: \n48: export interface CurrentManifestInput extends Identity {}\n49: \n50: export interface AckInput extends Identity {\n51:   manifestVersion: number;\n52:   clipHashes: Record<string, string>;\n53: }\n54: \n55: const ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;\n56: const HASH_RE = /^[a-f0-9]{64}$/;\n57: const isRecord = (value: unknown): value is Record<string, unknown> =>\n58:   value !== null && typeof value === \"object\" && !Array.isArray(value);\n59: \n60: export function requireIdentity(value: unknown): Identity {\n61:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n62:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n63:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n64:   }\n65:   const partyId = validateId(value.partyId, \"partyId\");\n66:   const deviceId = validateId(value.deviceId, \"deviceId\");\n67:   const channelId = typeof value.channelId === \"string\" && value.channelId\n68:     ? validateId(value.channelId, \"channelId\")\n69:     : \"\";\n70:   return { partyId, deviceId, channelId };\n71: }\n72: \n73: export function parseRequestGeneration(value: unknown): RequestGenerationInput {\n74:   const identity = requireIdentity(value);\n75:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n76:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n77:   const jobId = validateId(value.jobId, \"jobId\");\n78:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n79:   if (value.presetId === CAMEO_DEMO_PRESET.presetId) {\n80:     // STEP 2 cameo batch: separate server lock, guest-bound only. Text-only\n81:     // requests for this preset are rejected; prompts stay fixed server-side.\n82:     for (const [key, expected] of Object.entries(CAMEO_DEMO_PRESET)) {\n83:       if (key in value && value[key] !== expected) {\n84:         throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n85:       }\n86:     }\n87:     if (!(\"guestMediaId\" in value) || typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n88:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n89:     }\n90:     validateId(value.guestMediaId, \"guestMediaId\");\n91:     return { ...identity, jobId, idempotencyKey, presetId: CAMEO_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n92:   }\n93:   if (value.presetId !== CHEAP_DEMO_PRESET.presetId) {\n94:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the cheap_demo preset is supported.\");\n95:   }\n96:   // Model and generation controls are fixed server-side; caller overrides are rejected.\n97:   for (const [key, expected] of Object.entries(CHEAP_DEMO_PRESET)) {\n98:     if (key in value && value[key] !== expected) {\n99:       throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n100:     }\n101:   }\n102:   if (\"guestMediaId\" in value && value.guestMediaId !== undefined) {\n103:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n104:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n105:     }\n106:     validateId(value.guestMediaId, \"guestMediaId\");\n107:     return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n108:   }\n109:   return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId };\n110: }\n111: \n112: export function parseAck(value: unknown): AckInput {\n113:   const identity = requireIdentity(value);\n114:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n115:   if (!isRecord(value) || !Number.isSafeInteger(value.manifestVersion) || Number(value.manifestVersion) < 1) {\n116:     throw new BackendError(\"INVALID_ARGUMENT\", \"A positive manifestVersion is required.\");\n117:   }\n118:   if (!isRecord(value.clipHashes)) throw new BackendError(\"INVALID_ARGUMENT\", \"clipHashes must be an object.\");\n119:   // 1/2/4-camera layouts: the ACK key set must exactly equal the first-N\n120:   // canonical prefix for one supported count. Extra hashes (beyond the\n121:   // manifest's prefix) are rejected here; exact match against the actual\n122:   // manifest (same length + same hashes) is enforced at ACK acceptance.\n123:   const keys = Object.keys(value.clipHashes).sort();\n124:   const supportedKeySets = (SUPPORTED_CAMERA_COUNTS as readonly number[]).map(\n125:     (count) => [...expectedCameraIds(count)].sort().join(\",\"),\n126:   );\n127:   if (!supportedKeySets.includes(keys.join(\",\"))) {\n128:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK must include one hash for each canonical camera clip (1, 2, or 4 clips, first-N prefix).\");\n129:   }\n130:   const clipHashes: Record<string, string> = {};\n131:   for (const cameraId of keys) {\n132:     const hash = (value.clipHashes as Record<string, unknown>)[cameraId];\n133:     if (typeof hash !== \"string\" || !HASH_RE.test(hash)) {\n134:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hashes must be canonical SHA-256 hex values.\");\n135:     }\n136:     clipHashes[cameraId] = hash;\n137:   }\n138:   return { ...identity, manifestVersion: Number(value.manifestVersion), clipHashes };\n139: }\n140: \n141: export function parseCurrentManifestInput(value: unknown): CurrentManifestInput {\n142:   const identity = requireIdentity(value);\n143:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n144:   return identity;\n145: }\n146: \n147: export interface JoinPartyInput extends Identity {\n148:   joinPin?: string;\n149: }\n150: \n151: /** Exactly six ASCII digits; leading zeros are significant. */\n152: export const JOIN_PIN_RE = /^[0-9]{6}$/;\n153: \n154: export function parseJoinPartyInput(value: unknown): JoinPartyInput {\n155:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n156:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n157:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n158:   }\n159:   const partyId = validateId(value.partyId, \"partyId\");\n160:   const deviceId = validateId(value.deviceId, \"deviceId\");\n161:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n162:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n163:   }\n164:   const channelId = validateId(value.channelId, \"channelId\");\n165:   if (value.joinPin === undefined) {\n166:     return { partyId, deviceId, channelId };\n167:   }\n168:   if (typeof value.joinPin !== \"string\" || !JOIN_PIN_RE.test(value.joinPin)) {\n169:     throw new BackendError(\"INVALID_ARGUMENT\", \"joinPin must be six digits.\");\n170:   }\n171:   return { partyId, deviceId, channelId, joinPin: value.joinPin };\n172: }\n173: \n174: export function validateId(value: unknown, label: string): string {\n175:   if (typeof value !== \"string\" || !ID_RE.test(value)) {\n176:     throw new BackendError(\"INVALID_ARGUMENT\", `${label} is invalid.`);\n177:   }\n178:   return value;\n179: }\n180: \n181: export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n182:   if (!Array.isArray(clips) || !(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(clips.length)) {\n183:     throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain 1, 2, or 4 camera clips (four is the default layout).\");\n184:   }\n185:   const expected = new Set<string>([...expectedCameraIds(clips.length)]);\n186:   const byCamera = new Map<string, CanonicalClip>();\n187:   for (const raw of clips) {\n188:     if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n189:         !expected.has(raw.cameraId) ||\n190:         typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n191:         !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n192:         (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n193:         typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n194:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n195:     }\n196:     if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n197:     byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n198:   }\n199:   // Prefix rule: reordered valid clips are accepted, but gaps (e.g.\n200:   // {CAM-01, CAM-03} for count 2) and unknown cameras are rejected.\n201:   if (byCamera.size !== expected.size || [...expected].some((cameraId) => !byCamera.has(cameraId))) {\n202:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set must equal the first-N canonical cameras.\");\n203:   }\n204: }\n205: \n206: export function canonicalManifestHash(manifest: Pick<DeliveryManifest, \"partyId\" | \"channelId\" | \"version\" | \"cameraClips\">): string {\n207:   const canonical = {\n208:     partyId: manifest.partyId,\n209:     channelId: manifest.channelId,\n210:     version: manifest.version,\n211:     cameraClips: [...manifest.cameraClips]\n212:       .sort((a, b) => a.cameraId.localeCompare(b.cameraId))\n213:       .map(({ cameraId, sha256, sizeBytes, durationMs }) => ({ cameraId, sha256, sizeBytes, durationMs })),\n214:   };\n215:   return createHash(\"sha256\").update(JSON.stringify(canonical)).digest(\"hex\");\n216: }\n217: \n218: export function ackIdempotencyKey(deviceId: string, channelId: string, manifestVersion: number): string {\n219:   return createHash(\"sha256\").update(`${deviceId}\\n${channelId}\\n${manifestVersion}`).digest(\"hex\");\n220: }\n221: \n222: export function isErrorCode(value: unknown): value is ErrorCode {\n223:   return typeof value === \"string\" && (ERROR_CODES as readonly string[]).includes(value);\n224: }\n225: \n226: // ---------------------------------------------------------------------------\n227: // Host administration (cycle-12, partition p1).\n228: //\n229: // The companion uses a dedicated host entry screen (HostEntryScreen with\n230: // Scan Host QR + explicit Join-as-guest route; see partition p4/5 + README).\n231: // Rationale: guest PIN admission is intentionally broad (anyone who sees the\n232: // TV can join as a guest with full party-scoped read/generate/ACK power),\n233: // so host administration must never be reachable through the guest PIN or a\n234: // client-supplied role string. Host access is a separate server-minted,\n235: // short-lived invite capability redeemable once, bound to party/channel/\n236: // expiry, with the host role assigned server-side only.\n237: //\n238: // Callable surface (all exported through index.ts + runtime.ts):\n239: //   createHostInvite  (TV-only)  -> { inviteToken, expiresAt }\n240: //   joinHost          (phone)     -> { role: \"host\" } (separate device identity)\n241: //   listHostVideos    (host-only) -> seed catalog entries\n242: //   generateHostVideo (host-only) -> fixed-preset queued generation + seed entry\n243: //   getHostVideoPreview (host-only) -> signed preview URLs (never persisted)\n244: //   deleteHostVideo   (host-only) -> delete seeds + objects, revoke manifests\n245: // ---------------------------------------------------------------------------\n246: \n247: /** Server-assigned device roles. Clients can never self-assign \"host\" or \"tv\". */\n248: export const DEVICE_ROLES = [\"guest\", \"host\", \"tv\"] as const;\n249: export type DeviceRole = (typeof DEVICE_ROLES)[number];\n250: \n251: export interface CreateHostInviteInput extends Identity {}\n252: \n253: export interface CreateHostInviteResult {\n254:   partyId: string;\n255:   channelId: string;\n256:   inviteToken: string;\n257:   expiresAt: string;\n258: }\n259: \n260: export interface JoinHostInput extends Identity {\n261:   inviteToken: string;\n262: }\n263: \n264: export interface JoinHostResult {\n265:   partyId: string;\n266:   deviceId: string;\n267:   channelId: string;\n268:   role: \"host\";\n269:   status: \"active\";\n270:   created: boolean;\n271: }\n272: \n273: export interface ListHostVideosInput extends Identity {}\n274: \n275: export type HostSeedStatus = \"queued\" | \"running\" | \"ready\" | \"failed\" | \"deleted\";\n276: \n277: export interface HostSeedEntry {\n278:   seedId: string;\n279:   partyId: string;\n280:   channelId: string;\n281:   status: HostSeedStatus;\n282:   jobId: string;\n283:   createdAt: string;\n284:   expiresAt: string;\n285:   previewAvailable: boolean;\n286:   cameraIds: string[];\n287: }\n288: \n289: export interface GenerateHostVideoInput extends Identity {\n290:   seedId: string;\n291:   idempotencyKey: string;\n292:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n293:   guestMediaId?: string;\n294: }\n295: \n296: export interface GenerateHostVideoResult {\n297:   seedId: string;\n298:   jobId: string;\n299:   state: string;\n300:   created: boolean;\n301: }\n302: \n303: export interface GetHostVideoPreviewInput extends Identity {\n304:   seedId: string;\n305: }\n306: \n307: export interface GetHostVideoPreviewResult {\n308:   seedId: string;\n309:   expiresAt: string;\n310:   clips: Array<{ cameraId: string; sha256: string; url: string; expiresAt: string }>;\n311: }\n312: \n313: export interface DeleteHostVideoInput extends Identity {\n314:   seedIds: string[];\n315: }\n316: \n317: export interface DeleteHostVideoResult {\n318:   deletedSeedIds: string[];\n319:   deletedObjects: string[];\n320:   revokedManifest: boolean;\n321: }\n322: \n323: export function parseCreateHostInviteInput(value: unknown): CreateHostInviteInput {\n324:   const identity = requireIdentity(value);\n325:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n326:   return identity;\n327: }\n328: \n329: export function parseJoinHostInput(value: unknown): JoinHostInput {\n330:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n331:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n332:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n333:   }\n334:   const partyId = validateId(value.partyId, \"partyId\");\n335:   const deviceId = validateId(value.deviceId, \"deviceId\");\n336:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n337:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n338:   }\n339:   const channelId = validateId(value.channelId, \"channelId\");\n340:   // The invite token is a server-minted capability, never a guest PIN: PIN\n341:   // shape alone must not redeem host access, and client-supplied role\n342:   // strings are ignored (the server assigns \"host\" transactionally).\n343:   if (typeof value.inviteToken !== \"string\" || value.inviteToken.trim() === \"\" || value.inviteToken.length > 256) {\n344:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken is required.\");\n345:   }\n346:   if (JOIN_PIN_RE.test(value.inviteToken)) {\n347:     throw new BackendError(\"INVALID_ARGUMENT\", \"inviteToken must be a host invite, not a guest PIN.\");\n348:   }\n349:   return { partyId, deviceId, channelId, inviteToken: value.inviteToken };\n350: }\n351: \n352: export function parseListHostVideosInput(value: unknown): ListHostVideosInput {\n353:   const identity = requireIdentity(value);\n354:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n355:   return identity;\n356: }\n357: \n358: export function parseGenerateHostVideoInput(value: unknown): GenerateHostVideoInput {\n359:   const identity = requireIdentity(value);\n360:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n361:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n362:   const seedId = validateId(value.seedId, \"seedId\");\n363:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n364:   // Fixed-preset queue only: same lock as requestGeneration (cheap_demo or\n365:   // cameo_demo with its consent binding); caller overrides are rejected.\n366:   if (value.presetId !== undefined &&\n367:       value.presetId !== CHEAP_DEMO_PRESET.presetId &&\n368:       value.presetId !== CAMEO_DEMO_PRESET.presetId) {\n369:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the fixed generation presets are supported.\");\n370:   }\n371:   const presetId = (value.presetId ?? CHEAP_DEMO_PRESET.presetId) as GenerateHostVideoInput[\"presetId\"];\n372:   if (presetId === CAMEO_DEMO_PRESET.presetId) {\n373:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n374:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n375:     }\n376:     validateId(value.guestMediaId, \"guestMediaId\");\n377:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n378:   }\n379:   if (value.guestMediaId !== undefined) {\n380:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n381:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n382:     }\n383:     validateId(value.guestMediaId, \"guestMediaId\");\n384:     return { ...identity, seedId, idempotencyKey, presetId, guestMediaId: value.guestMediaId };\n385:   }\n386:   return { ...identity, seedId, idempotencyKey, presetId };\n387: }\n388: \n389: export function parseGetHostVideoPreviewInput(value: unknown): GetHostVideoPreviewInput {\n390:   const identity = requireIdentity(value);\n391:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n392:   if (!isRecord(value) || typeof value.seedId !== \"string\" || !value.seedId) {\n393:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedId is required.\");\n394:   }\n395:   return { ...identity, seedId: validateId(value.seedId, \"seedId\") };\n396: }\n397: \n398: export function parseDeleteHostVideoInput(value: unknown): DeleteHostVideoInput {\n399:   const identity = requireIdentity(value);\n400:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n401:   if (!isRecord(value) || !Array.isArray(value.seedIds) || value.seedIds.length === 0 || value.seedIds.length > 32) {\n402:     throw new BackendError(\"INVALID_ARGUMENT\", \"seedIds must be a non-empty list (max 32).\");\n403:   }\n404:   const seen = new Set<string>();\n405:   const seedIds: string[] = [];\n406:   for (const raw of value.seedIds) {\n407:     const seedId = validateId(raw, \"seedId\");\n408:     if (seen.has(seedId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Duplicate seedId.\");\n409:     seen.add(seedId);\n410:     seedIds.push(seedId);\n411:   }\n412:   return { ...identity, seedIds };\n413: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5d62c74bd9488de2f53d4faa7"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/contracts.ts\"}"},"time":{"start":1793461704872,"end":1793461704880}}}}
{"type":"tool_use","timestamp":1793461704880,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5d8a6001idINDumhqf8F2D","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5d01c001jf0MkgUnxpoXPw","type":"tool","id":"call_01a192a5d37476f58a2fbedbbd3f8209","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/host_join.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/host_join.ts, lines 1-186\n1: import { createHash, randomBytes } from \"node:crypto\";\n2: import { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\n3: import {\n4:   BackendError,\n5:   CreateHostInviteResult,\n6:   JoinHostResult,\n7:   parseCreateHostInviteInput,\n8:   parseJoinHostInput,\n9: } from \"./contracts\";\n10: import { HOST_INVITE_TTL_MS } from \"./config\";\n11: import { assertRegisteredTvDevice } from \"./auth\";\n12: \n13: export interface HostJoinServiceOptions {\n14:   db: Firestore;\n15:   now?: () => Date;\n16: }\n17: \n18: function inviteTokenHash(token: string): string {\n19:   return createHash(\"sha256\").update(token).digest(\"hex\");\n20: }\n21: \n22: function inviteRef(db: Firestore, partyId: string, inviteId: string) {\n23:   return db.doc(`parties/${partyId}/hostInvites/${inviteId}`);\n24: }\n25: \n26: /**\n27:  * Host invite + redemption service.\n28:  *\n29:  * Only a registered TV may mint a short-lived host invite. The token is\n30:  * returned once and only its SHA-256 hash is stored, bound to\n31:  * party/channel/expiry. Redemption is transactional for a separate phone\n32:  * identity with the server-assigned host role: same-device redemption\n33:  * retries are idempotent, while other-device replay, expiry, guest PIN\n34:  * reuse, and client-only role changes can never grant host access. Legacy\n35:  * joinParty remains guest-only (see join_party.ts: non-guest device docs\n36:  * are rejected and the role is always written server-side).\n37:  */\n38: export function createHostJoinService(options: HostJoinServiceOptions): {\n39:   createHostInvite(value: unknown): Promise<CreateHostInviteResult>;\n40:   joinHost(value: unknown): Promise<JoinHostResult>;\n41: } {\n42:   const { db } = options;\n43:   const now = options.now ?? (() => new Date());\n44: \n45:   async function createHostInvite(value: unknown): Promise<CreateHostInviteResult> {\n46:     const input = parseCreateHostInviteInput(value);\n47:     const tv = await assertRegisteredTvDevice(db, input);\n48:     const token = `hi-${randomBytes(24).toString(\"hex\")}`;\n49:     const tokenHash = inviteTokenHash(token);\n50:     const inviteId = tokenHash.slice(0, 32);\n51:     const createdAt = now();\n52:     const expiresAt = new Date(createdAt.getTime() + HOST_INVITE_TTL_MS);\n53:     await inviteRef(db, tv.partyId, inviteId).create({\n54:       inviteId,\n55:       tokenHash,\n56:       partyId: tv.partyId,\n57:       channelId: tv.channelId,\n58:       status: \"pending\",\n59:       createdByDevice: tv.deviceId,\n60:       usedByDevice: null,\n61:       createdAt: FieldValue.serverTimestamp(),\n62:       expiresAt: Timestamp.fromDate(expiresAt),\n63:     });\n64:     return {\n65:       partyId: tv.partyId,\n66:       channelId: tv.channelId,\n67:       inviteToken: token,\n68:       expiresAt: expiresAt.toISOString(),\n69:     };\n70:   }\n71: \n72:   async function joinHost(value: unknown): Promise<JoinHostResult> {\n73:     const input = parseJoinHostInput(value);\n74:     const tokenHash = inviteTokenHash(input.inviteToken);\n75:     const inviteId = tokenHash.slice(0, 32);\n76:     return db.runTransaction(async (transaction) => {\n77:       const inviteSnap = await transaction.get(inviteRef(db, input.partyId, inviteId));\n78:       if (!inviteSnap.exists) {\n79:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n80:       }\n81:       const invite = inviteSnap.data()!;\n82:       if (\n83:         invite.tokenHash !== tokenHash ||\n84:         invite.partyId !== input.partyId ||\n85:         invite.channelId !== input.channelId\n86:       ) {\n87:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n88:       }\n89:       const expiresMs =\n90:         invite.expiresAt instanceof Timestamp\n91:           ? invite.expiresAt.toDate().getTime()\n92:           : Date.parse(String(invite.expiresAt));\n93:       if (!Number.isFinite(expiresMs) || expiresMs <= now().getTime()) {\n94:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n95:       }\n96:       // Cross-party / wrong-channel tokens never redeem: the invite doc lives\n97:       // under the party path and binds the channel explicitly.\n98:       const partyRef = db.doc(`parties/${input.partyId}`);\n99:       const channelRef = partyRef.collection(\"channels\").doc(input.channelId);\n100:       const deviceRef = partyRef.collection(\"devices\").doc(input.deviceId);\n101:       const [partySnap, channelSnap, deviceSnap] = await Promise.all([\n102:         transaction.get(partyRef),\n103:         transaction.get(channelRef),\n104:         transaction.get(deviceRef),\n105:       ]);\n106:       if (!partySnap.exists || partySnap.data()?.status !== \"active\") {\n107:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n108:       }\n109:       if (\n110:         !channelSnap.exists ||\n111:         channelSnap.data()?.partyId !== input.partyId ||\n112:         channelSnap.data()?.status !== \"active\" ||\n113:         partySnap.data()?.activeChannelId !== input.channelId\n114:       ) {\n115:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n116:       }\n117:       // Other-device replay: an invite redeemed by one phone cannot admit\n118:       // another phone, even with the same token.\n119:       if (\n120:         typeof invite.usedByDevice === \"string\" &&\n121:         invite.usedByDevice !== input.deviceId\n122:       ) {\n123:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n124:       }\n125:       if (deviceSnap.exists) {\n126:         const device = deviceSnap.data()!;\n127:         if (\n128:           device.partyId !== input.partyId ||\n129:           device.status !== \"active\" ||\n130:           (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n131:         ) {\n132:           throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n133:         }\n134:         // A guest-PIN registration (role guest) or any non-host doc can never\n135:         // be upgraded by re-presenting the invite for a different device, and\n136:         // a client-supplied role string is ignored: the role below is always\n137:         // written server-side.\n138:         if (device.role === \"host\") {\n139:           if (invite.status !== \"redeemed\" || invite.usedByDevice !== input.deviceId) {\n140:             transaction.update(inviteRef(db, input.partyId, inviteId), {\n141:               status: \"redeemed\",\n142:               usedByDevice: input.deviceId,\n143:               redeemedAt: FieldValue.serverTimestamp(),\n144:             });\n145:           }\n146:           return {\n147:             partyId: input.partyId,\n148:             deviceId: input.deviceId,\n149:             channelId: input.channelId,\n150:             role: \"host\" as const,\n151:             status: \"active\" as const,\n152:             created: false,\n153:           };\n154:         }\n155:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n156:       }\n157:       transaction.set(deviceRef, {\n158:         partyId: input.partyId,\n159:         deviceId: input.deviceId,\n160:         role: \"host\",\n161:         status: \"active\",\n162:         registeredAt: FieldValue.serverTimestamp(),\n163:       });\n164:       transaction.update(inviteRef(db, input.partyId, inviteId), {\n165:         status: \"redeemed\",\n166:         usedByDevice: input.deviceId,\n167:         redeemedAt: FieldValue.serverTimestamp(),\n168:       });\n169:       return {\n170:         partyId: input.partyId,\n171:         deviceId: input.deviceId,\n172:         channelId: input.channelId,\n173:         role: \"host\" as const,\n174:         status: \"active\" as const,\n175:         created: true,\n176:       };\n177:     });\n178:   }\n179: \n180:   return { createHostInvite, joinHost };\n181: }\n182: \n183: /** Test/ops helper: hash an invite token to locate its stored invite doc. */\n184: export function hashHostInviteToken(token: string): string {\n185:   return inviteTokenHash(token);\n186: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/host_join.ts, lines 1-186\n1: import { createHash, randomBytes } from \"node:crypto\";\n2: import { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\n3: import {\n4:   BackendError,\n5:   CreateHostInviteResult,\n6:   JoinHostResult,\n7:   parseCreateHostInviteInput,\n8:   parseJoinHostInput,\n9: } from \"./contracts\";\n10: import { HOST_INVITE_TTL_MS } from \"./config\";\n11: import { assertRegisteredTvDevice } from \"./auth\";\n12: \n13: export interface HostJoinServiceOptions {\n14:   db: Firestore;\n15:   now?: () => Date;\n16: }\n17: \n18: function inviteTokenHash(token: string): string {\n19:   return createHash(\"sha256\").update(token).digest(\"hex\");\n20: }\n21: \n22: function inviteRef(db: Firestore, partyId: string, inviteId: string) {\n23:   return db.doc(`parties/${partyId}/hostInvites/${inviteId}`);\n24: }\n25: \n26: /**\n27:  * Host invite + redemption service.\n28:  *\n29:  * Only a registered TV may mint a short-lived host invite. The token is\n30:  * returned once and only its SHA-256 hash is stored, bound to\n31:  * party/channel/expiry. Redemption is transactional for a separate phone\n32:  * identity with the server-assigned host role: same-device redemption\n33:  * retries are idempotent, while other-device replay, expiry, guest PIN\n34:  * reuse, and client-only role changes can never grant host access. Legacy\n35:  * joinParty remains guest-only (see join_party.ts: non-guest device docs\n36:  * are rejected and the role is always written server-side).\n37:  */\n38: export function createHostJoinService(options: HostJoinServiceOptions): {\n39:   createHostInvite(value: unknown): Promise<CreateHostInviteResult>;\n40:   joinHost(value: unknown): Promise<JoinHostResult>;\n41: } {\n42:   const { db } = options;\n43:   const now = options.now ?? (() => new Date());\n44: \n45:   async function createHostInvite(value: unknown): Promise<CreateHostInviteResult> {\n46:     const input = parseCreateHostInviteInput(value);\n47:     const tv = await assertRegisteredTvDevice(db, input);\n48:     const token = `hi-${randomBytes(24).toString(\"hex\")}`;\n49:     const tokenHash = inviteTokenHash(token);\n50:     const inviteId = tokenHash.slice(0, 32);\n51:     const createdAt = now();\n52:     const expiresAt = new Date(createdAt.getTime() + HOST_INVITE_TTL_MS);\n53:     await inviteRef(db, tv.partyId, inviteId).create({\n54:       inviteId,\n55:       tokenHash,\n56:       partyId: tv.partyId,\n57:       channelId: tv.channelId,\n58:       status: \"pending\",\n59:       createdByDevice: tv.deviceId,\n60:       usedByDevice: null,\n61:       createdAt: FieldValue.serverTimestamp(),\n62:       expiresAt: Timestamp.fromDate(expiresAt),\n63:     });\n64:     return {\n65:       partyId: tv.partyId,\n66:       channelId: tv.channelId,\n67:       inviteToken: token,\n68:       expiresAt: expiresAt.toISOString(),\n69:     };\n70:   }\n71: \n72:   async function joinHost(value: unknown): Promise<JoinHostResult> {\n73:     const input = parseJoinHostInput(value);\n74:     const tokenHash = inviteTokenHash(input.inviteToken);\n75:     const inviteId = tokenHash.slice(0, 32);\n76:     return db.runTransaction(async (transaction) => {\n77:       const inviteSnap = await transaction.get(inviteRef(db, input.partyId, inviteId));\n78:       if (!inviteSnap.exists) {\n79:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n80:       }\n81:       const invite = inviteSnap.data()!;\n82:       if (\n83:         invite.tokenHash !== tokenHash ||\n84:         invite.partyId !== input.partyId ||\n85:         invite.channelId !== input.channelId\n86:       ) {\n87:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n88:       }\n89:       const expiresMs =\n90:         invite.expiresAt instanceof Timestamp\n91:           ? invite.expiresAt.toDate().getTime()\n92:           : Date.parse(String(invite.expiresAt));\n93:       if (!Number.isFinite(expiresMs) || expiresMs <= now().getTime()) {\n94:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n95:       }\n96:       // Cross-party / wrong-channel tokens never redeem: the invite doc lives\n97:       // under the party path and binds the channel explicitly.\n98:       const partyRef = db.doc(`parties/${input.partyId}`);\n99:       const channelRef = partyRef.collection(\"channels\").doc(input.channelId);\n100:       const deviceRef = partyRef.collection(\"devices\").doc(input.deviceId);\n101:       const [partySnap, channelSnap, deviceSnap] = await Promise.all([\n102:         transaction.get(partyRef),\n103:         transaction.get(channelRef),\n104:         transaction.get(deviceRef),\n105:       ]);\n106:       if (!partySnap.exists || partySnap.data()?.status !== \"active\") {\n107:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n108:       }\n109:       if (\n110:         !channelSnap.exists ||\n111:         channelSnap.data()?.partyId !== input.partyId ||\n112:         channelSnap.data()?.status !== \"active\" ||\n113:         partySnap.data()?.activeChannelId !== input.channelId\n114:       ) {\n115:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n116:       }\n117:       // Other-device replay: an invite redeemed by one phone cannot admit\n118:       // another phone, even with the same token.\n119:       if (\n120:         typeof invite.usedByDevice === \"string\" &&\n121:         invite.usedByDevice !== input.deviceId\n122:       ) {\n123:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n124:       }\n125:       if (deviceSnap.exists) {\n126:         const device = deviceSnap.data()!;\n127:         if (\n128:           device.partyId !== input.partyId ||\n129:           device.status !== \"active\" ||\n130:           (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n131:         ) {\n132:           throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n133:         }\n134:         // A guest-PIN registration (role guest) or any non-host doc can never\n135:         // be upgraded by re-presenting the invite for a different device, and\n136:         // a client-supplied role string is ignored: the role below is always\n137:         // written server-side.\n138:         if (device.role === \"host\") {\n139:           if (invite.status !== \"redeemed\" || invite.usedByDevice !== input.deviceId) {\n140:             transaction.update(inviteRef(db, input.partyId, inviteId), {\n141:               status: \"redeemed\",\n142:               usedByDevice: input.deviceId,\n143:               redeemedAt: FieldValue.serverTimestamp(),\n144:             });\n145:           }\n146:           return {\n147:             partyId: input.partyId,\n148:             deviceId: input.deviceId,\n149:             channelId: input.channelId,\n150:             role: \"host\" as const,\n151:             status: \"active\" as const,\n152:             created: false,\n153:           };\n154:         }\n155:         throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n156:       }\n157:       transaction.set(deviceRef, {\n158:         partyId: input.partyId,\n159:         deviceId: input.deviceId,\n160:         role: \"host\",\n161:         status: \"active\",\n162:         registeredAt: FieldValue.serverTimestamp(),\n163:       });\n164:       transaction.update(inviteRef(db, input.partyId, inviteId), {\n165:         status: \"redeemed\",\n166:         usedByDevice: input.deviceId,\n167:         redeemedAt: FieldValue.serverTimestamp(),\n168:       });\n169:       return {\n170:         partyId: input.partyId,\n171:         deviceId: input.deviceId,\n172:         channelId: input.channelId,\n173:         role: \"host\" as const,\n174:         status: \"active\" as const,\n175:         created: true,\n176:       };\n177:     });\n178:   }\n179: \n180:   return { createHostInvite, joinHost };\n181: }\n182: \n183: /** Test/ops helper: hash an invite token to locate its stored invite doc. */\n184: export function hashHostInviteToken(token: string): string {\n185:   return inviteTokenHash(token);\n186: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5d37476f58a2fbedbbd3f8209"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/host_join.ts\"}"},"time":{"start":1793461704870,"end":1793461704880}}}}
