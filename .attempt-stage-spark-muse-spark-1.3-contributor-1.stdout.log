{"type":"tool_use","timestamp":1793460992648,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929afa2d001cPQWPrQzSa1DjQ","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929af735001CaLTASv2oiGcuk","type":"tool","id":"call_01a1929af8f57706b97972de2596e5f3","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/packages/core_playlist/lib/core_playlist.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/core_playlist/lib/core_playlist.dart, lines 1-486\n1: /// Playback manifest model (Technical Design v1.0, section 8).\n2: ///\n3: /// Camera identity (owner Q3 — labels are config-driven, never hardcoded):\n4: /// [CctvSlot]/[cctvSlots] is the single source of truth for CCTV camera\n5: /// identity — canonical wall order, camera ids, and default room labels.\n6: /// The `channel_cctv` tile map, the tv_app asset catalog, and wall-slot\n7: /// label resolution all derive from it; no `CAM-0x` literals are duplicated\n8: /// in other layers.\n9: ///\n10: /// Port direction (finding D-08 — recorded exception): the control-plane\n11: /// ports (`ManifestSource`, `SettingsPort`) are owned by the contracts\n12: /// layer in `package:channel_api/channel_api.dart`, so channels can consume\n13: /// them without importing `infra_*`. The `infra_*` packages ship only the\n14: /// adapters bound to those contracts; their barrels keep re-exporting the\n15: /// port names so existing importers keep compiling.\n16: library;\n17: \n18: import 'package:core_foundation/core_foundation.dart';\n19: \n20: /// One CCTV wall slot: camera identity plus its default presentation.\n21: ///\n22: /// Wall order is the order of `cctvSlots` (top-left reading order).\n23: final class CctvSlot {\n24:   /// Camera id (e.g. `CAM-01`).\n25:   final String id;\n26: \n27:   /// Wall slot index (`0..3`; matches the position in [cctvSlots]).\n28:   final int index;\n29: \n30:   /// Default room name shown on the tile HUD.\n31:   ///\n32:   /// Replaceable per clip by the manifest `label` field (see\n33:   /// [ClipDescriptor.label] and [resolveCctvLabel]).\n34:   final String room;\n35: \n36:   /// Creates a slot binding [id] to wall position [index] with default\n37:   /// room [room].\n38:   const CctvSlot({required this.id, required this.index, required this.room});\n39: \n40:   /// Default tile label (`'$id · $room'`), used when the manifest clip\n41:   /// carries no custom label.\n42:   String get defaultLabel => '$id · $room';\n43: \n44:   @override\n45:   String toString() => 'CctvSlot($id, slot $index, $room)';\n46: }\n47: \n48: /// Canonical CCTV wall slots in wall order (top-left reading order).\n49: ///\n50: /// Single source of truth for camera identity: id, slot index, and default\n51: /// room label travel together so `channel_cctv`, the tv_app asset catalog,\n52: /// and manifest validation can never drift apart. Add a camera here — never\n53: /// by scattering new `CAM-0x` literals across layers.\n54: const List<CctvSlot> cctvSlots = <CctvSlot>[\n55:   CctvSlot(id: 'CAM-01', index: 0, room: 'hallway'),\n56:   CctvSlot(id: 'CAM-02', index: 1, room: 'kitchen'),\n57:   CctvSlot(id: 'CAM-03', index: 2, room: 'staircase'),\n58:   CctvSlot(id: 'CAM-04', index: 3, room: 'storage room'),\n59: ];\n60: \n61: /// Valid CCTV camera ids, derived from [cctvSlots].\n62: ///\n63: /// Kept for callers that only need the id set; prefer [cctvSlots] (or\n64: /// [slotForCameraId]) when order, index, or default labels matter.\n65: final Set<String> kCctvCameraIds = Set<String>.unmodifiable(\n66:   <String>{for (final CctvSlot slot in cctvSlots) slot.id},\n67: );\n68: \n69: /// Slot for [cameraId], or `null` when it is not a known camera.\n70: CctvSlot? slotForCameraId(String cameraId) {\n71:   for (final CctvSlot slot in cctvSlots) {\n72:     if (slot.id == cameraId) {\n73:       return slot;\n74:     }\n75:   }\n76:   return null;\n77: }\n78: \n79: /// Maximum manifest clip id length.\n80: ///\n81: /// The tile HUD ellipsizes long labels (p5 owns the HUD), but ids longer\n82: /// than this are rejected by [validateCctvManifest] so oversized\n83: /// control-plane payloads never reach the wall.\n84: const int kMaxClipIdLength = 64;\n85: \n86: /// Resolves the wall-slot label for [clip].\n87: ///\n88: /// The manifest clip `label` field wins when present and non-blank (owner\n89: /// Q3: labels are config-driven and replaceable); otherwise the\n90: /// [CctvSlot.defaultLabel] for the clip's camera applies. Unknown cameras\n91: /// fall back to the raw camera id — validation rejects those separately.\n92: String resolveCctvLabel(ClipDescriptor clip) {\n93:   final String? custom = clip.label;\n94:   if (custom != null && custom.trim().isNotEmpty) {\n95:     return custom;\n96:   }\n97:   final CctvSlot? slot = slotForCameraId(clip.cameraId);\n98:   if (slot != null) {\n99:     return slot.defaultLabel;\n100:   }\n101:   return clip.cameraId;\n102: }\n103: \n104: final RegExp _sha256Pattern = RegExp(r'^[0-9a-fA-F]{64}$');\n105: \n106: /// True when [value] is a 64 character hex sha256 digest.\n107: ///\n108: /// Digests are compared and stored as lowercase hex elsewhere; this helper\n109: /// only checks well-formedness so callers can normalise case themselves.\n110: bool isValidSha256Hex(String value) => _sha256Pattern.hasMatch(value);\n111: \n112: /// Clamps [value] into the inclusive [min]..[max] range.\n113: double _clamp(double value, double min, double max) {\n114:   if (value.isNaN) {\n115:     return min;\n116:   }\n117:   if (value < min) {\n118:     return min;\n119:   }\n120:   if (value > max) {\n121:     return max;\n122:   }\n123:   return value;\n124: }\n125: \n126: /// Single clip entry in a manifest.\n127: final class ClipDescriptor {\n128:   /// Clip id, unique within the manifest.\n129:   final String id;\n130: \n131:   /// Camera id (for CCTV: one of CAM-01..CAM-04).\n132:   final String cameraId;\n133: \n134:   /// Opaque storage object id.\n135:   final String storageObjectId;\n136: \n137:   /// Lowercase hex sha256 of the clip bytes.\n138:   final String sha256;\n139: \n140:   /// Size in bytes, must be > 0.\n141:   final int sizeBytes;\n142: \n143:   /// Duration of the clip.\n144:   final Duration duration;\n145: \n146:   /// MIME type (e.g. video/mp4).\n147:   final String mimeType;\n148: \n149:   /// Optional config-driven display label (owner Q3).\n150:   ///\n151:   /// When non-null and non-blank, wall slots show this instead of the\n152:   /// [CctvSlot.defaultLabel]. Absent in older manifests; [resolveCctvLabel]\n153:   /// falls back to the slot default. Never validated for length — the tile\n154:   /// HUD ellipsizes (p5 owns the HUD).\n155:   final String? label;\n156: \n157:   const ClipDescriptor({\n158:     required this.id,\n159:     required this.cameraId,\n160:     required this.storageObjectId,\n161:     required this.sha256,\n162:     required this.sizeBytes,\n163:     required this.duration,\n164:     required this.mimeType,\n165:     this.label,\n166:   });\n167: \n168:   Map<String, Object?> toJson() {\n169:     final Map<String, Object?> map = <String, Object?>{\n170:       'id': id,\n171:       'cameraId': cameraId,\n172:       'storageObjectId': storageObjectId,\n173:       'sha256': sha256,\n174:       'sizeBytes': sizeBytes,\n175:       'durationMs': duration.inMilliseconds,\n176:       'mimeType': mimeType,\n177:     };\n178:     // Only newer manifests carry `label`; omitting it when null keeps the\n179:     // wire shape of older manifests byte-identical.\n180:     if (label != null) {\n181:       map['label'] = label;\n182:     }\n183:     return map;\n184:   }\n185: \n186:   factory ClipDescriptor.fromJson(Map<String, Object?> json) => ClipDescriptor(\n187:     id: json['id']! as String,\n188:     cameraId: json['cameraId']! as String,\n189:     storageObjectId: json['storageObjectId']! as String,\n190:     sha256: json['sha256']! as String,\n191:     sizeBytes: (json['sizeBytes']! as num).toInt(),\n192:     duration: Duration(milliseconds: (json['durationMs']! as num).toInt()),\n193:     mimeType: json['mimeType']! as String,\n194:     label: json['label'] as String?,\n195:   );\n196: \n197:   @override\n198:   bool operator ==(Object other) =>\n199:       identical(this, other) ||\n200:       (other is ClipDescriptor &&\n201:           other.id == id &&\n202:           other.cameraId == cameraId &&\n203:           other.storageObjectId == storageObjectId &&\n204:           other.sha256 == sha256 &&\n205:           other.sizeBytes == sizeBytes &&\n206:           other.duration == duration &&\n207:           other.mimeType == mimeType &&\n208:           other.label == label);\n209: \n210:   @override\n211:   int get hashCode => Object.hash(\n212:     id,\n213:     cameraId,\n214:     storageObjectId,\n215:     sha256,\n216:     sizeBytes,\n217:     duration,\n218:     mimeType,\n219:     label,\n220:   );\n221: \n222:   @override\n223:   String toString() => 'ClipDescriptor($id, $cameraId)';\n224: }\n225: \n226: /// Overlay tuning with bounded numerics (all clamped to `0.0 .. 1.0`).\n227: final class OverlaySettings {\n228:   /// Scanline opacity in [0, 1].\n229:   final double scanlineOpacity;\n230: \n231:   /// Noise/grain level in [0, 1].\n232:   final double noiseLevel;\n233: \n234:   /// Vignette strength in [0, 1].\n235:   final double vignette;\n236: \n237:   const OverlaySettings({\n238:     this.scanlineOpacity = 0.5,\n239:     this.noiseLevel = 0.3,\n240:     this.vignette = 0.5,\n241:   }) : assert(scanlineOpacity >= 0 && scanlineOpacity <= 1),\n242:        assert(noiseLevel >= 0 && noiseLevel <= 1),\n243:        assert(vignette >= 0 && vignette <= 1);\n244: \n245:   /// Builds settings from untrusted numeric input, clamping each value\n246:   /// into `0.0 .. 1.0` (NaN becomes the lower bound).\n247:   factory OverlaySettings.clamped({\n248:     double scanlineOpacity = 0.5,\n249:     double noiseLevel = 0.3,\n250:     double vignette = 0.5,\n251:   }) => OverlaySettings(\n252:     scanlineOpacity: _clamp(scanlineOpacity, 0.0, 1.0),\n253:     noiseLevel: _clamp(noiseLevel, 0.0, 1.0),\n254:     vignette: _clamp(vignette, 0.0, 1.0),\n255:   );\n256: \n257:   factory OverlaySettings.fromJson(Map<String, Object?> json) =>\n258:       OverlaySettings.clamped(\n259:         scanlineOpacity: ((json['scanlineOpacity'] ?? 0.5) as num).toDouble(),\n260:         noiseLevel: ((json['noiseLevel'] ?? 0.3) as num).toDouble(),\n261:         vignette: ((json['vignette'] ?? 0.5) as num).toDouble(),\n262:       );\n263: \n264:   Map<String, Object?> toJson() => <String, Object?>{\n265:     'scanlineOpacity': scanlineOpacity,\n266:     'noiseLevel': noiseLevel,\n267:     'vignette': vignette,\n268:   };\n269: \n270:   @override\n271:   bool operator ==(Object other) =>\n272:       identical(this, other) ||\n273:       (other is OverlaySettings &&\n274:           other.scanlineOpacity == scanlineOpacity &&\n275:           other.noiseLevel == noiseLevel &&\n276:           other.vignette == vignette);\n277: \n278:   @override\n279:   int get hashCode => Object.hash(scanlineOpacity, noiseLevel, vignette);\n280: \n281:   @override\n282:   String toString() =>\n283:       'OverlaySettings(scanline: $scanlineOpacity, '\n284:       'noise: $noiseLevel, vignette: $vignette)';\n285: }\n286: \n287: /// A published set of clips for one party + channel.\n288: final class PlaybackManifest {\n289:   /// Party this manifest belongs to (non-empty).\n290:   final String partyId;\n291: \n292:   /// Channel this manifest belongs to (non-empty).\n293:   final String channelId;\n294: \n295:   /// Manifest version, must be > 0.\n296:   final int version;\n297: \n298:   /// Clips in playback order.\n299:   final List<ClipDescriptor> clips;\n300: \n301:   /// Overlay tuning.\n302:   final OverlaySettings overlay;\n303: \n304:   /// Publish timestamp.\n305:   final DateTime publishedAt;\n306: \n307:   PlaybackManifest({\n308:     required this.partyId,\n309:     required this.channelId,\n310:     required this.version,\n311:     required List<ClipDescriptor> clips,\n312:     this.overlay = const OverlaySettings(),\n313:     required this.publishedAt,\n314:   }) : clips = List<ClipDescriptor>.unmodifiable(clips);\n315: \n316:   Map<String, Object?> toJson() => <String, Object?>{\n317:     'partyId': partyId,\n318:     'channelId': channelId,\n319:     'version': version,\n320:     'clips': clips.map((c) => c.toJson()).toList(growable: false),\n321:     'overlay': overlay.toJson(),\n322:     'publishedAt': publishedAt.toUtc().toIso8601String(),\n323:   };\n324: \n325:   @override\n326:   bool operator ==(Object other) {\n327:     if (identical(this, other)) {\n328:       return true;\n329:     }\n330:     if (other is! PlaybackManifest ||\n331:         other.partyId != partyId ||\n332:         other.channelId != channelId ||\n333:         other.version != version ||\n334:         other.overlay != overlay ||\n335:         other.publishedAt.toUtc() != publishedAt.toUtc() ||\n336:         other.clips.length != clips.length) {\n337:       return false;\n338:     }\n339:     for (var i = 0; i < clips.length; i++) {\n340:       if (other.clips[i] != clips[i]) {\n341:         return false;\n342:       }\n343:     }\n344:     return true;\n345:   }\n346: \n347:   @override\n348:   int get hashCode => Object.hash(\n349:     partyId,\n350:     channelId,\n351:     version,\n352:     Object.hashAll(clips),\n353:     overlay,\n354:     publishedAt.toUtc(),\n355:   );\n356: \n357:   @override\n358:   String toString() =>\n359:       'PlaybackManifest($partyId/$channelId v$version, '\n360:       '${clips.length} clips)';\n361: }\n362: \n363: /// Parses a manifest from decoded JSON; throws [FormatException] on bad shape.\n364: PlaybackManifest parseManifest(Map<String, Object?> json) {\n365:   try {\n366:     final partyId = json['partyId']! as String;\n367:     final chann