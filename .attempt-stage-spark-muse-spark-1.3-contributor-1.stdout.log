PanelScreen.leaveKey,\n182:                       onPressed: () {\n183:                         widget.onLeave();\n184:                       },\n185:                       child: const Text('Leave'),\n186:                     ),\n187:                   ],\n188:                 ),\n189:               ],\n190:             ),\n191:           ),\n192:         ),\n193:       ),\n194:     );\n195:   }\n196: \n197:   Widget _body(HostSessionState snapshot) {\n198:     switch (snapshot.status) {\n199:       case HostSessionStatus.idle:\n200:         return const Text('Not joined as host.');\n201:       case HostSessionStatus.loading:\n202:         return const Center(child: CircularProgressIndicator());\n203:       case HostSessionStatus.denied:\n204:         return Text(\n205:           snapshot.message ?? 'Access was denied.',\n206:           key: HostPanelScreen.messageKey,\n207:         );\n208:       case HostSessionStatus.unavailable:\n209:       case HostSessionStatus.invalidData:\n210:         return Text(\n211:           snapshot.message ?? 'Could not load the catalog.',\n212:           key: HostPanelScreen.messageKey,\n213:         );\n214:       case HostSessionStatus.ready:\n215:       case HostSessionStatus.stale:\n216:         return Column(\n217:           key: HostPanelScreen.listKey,\n218:           crossAxisAlignment: CrossAxisAlignment.stretch,\n219:           mainAxisSize: MainAxisSize.min,\n220:           children: <Widget>[\n221:             _generateRow(),\n222:             const SizedBox(height: 12),\n223:             if (snapshot.videos.isEmpty)\n224:               const Text(\n225:                 'No seed videos yet. Generate the first entry above.',\n226:                 key: HostPanelScreen.emptyKey,\n227:               )\n228:             else\n229:               ...snapshot.videos.map(_seedTile),\n230:           ],\n231:         );\n232:     }\n233:   }\n234: \n235:   Widget _generateRow() => Row(\n236:     children: <Widget>[\n237:       Exp