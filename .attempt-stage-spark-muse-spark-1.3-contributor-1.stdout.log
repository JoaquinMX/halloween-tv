cription requested.\n35: final class ManifestScopeException implements Exception {\n36:   const ManifestScopeException(this.message);\n37: \n38:   final String message;\n39: \n40:   @override\n41:   String toString() => 'ManifestScopeException: $message';\n42: }\n43: \n44: /// Watches only `parties/{partyId}/manifests/current_{channelId}`.\n45: ///\n46: /// The Firebase SDK is resolved lazily when [watchCurrent] is subscribed, so\n47: /// constructing offline-first stub dependencies does not initialize Firebase.\n48: final class FirebaseManifestSource implements ManifestSource<PlaybackManifest> {\n49:   FirebaseManifestSource({\n50:     FirebaseFirestore? firestore,\n51:     FirebaseManifestDocumentStream? watchDocumentData,\n52:     DateTime Function()? now,\n53:     this.maxTransportResubscriptions = 3,\n54:     this.transportRetryDelay = const Duration(milliseconds: 250),\n55:   }) : _firestore = firestore,\n56:        _watchDocumentData = watchDocumentData,\n57:        _now = now ?? DateTime.now;\n58: \n59:   final FirebaseFirestore? _firestore;\n60:   final FirebaseManifestDocumentStream? _watchDocumentData;\n61:   final DateTime Function() _now;\n62: \n63:   /// Number of times a failed document stream is reopened before surfacing.\n64:   final int maxTransportResubscriptions;\n65: \n66:   /// Delay between bounded transport resubscriptions.\n67:   final Duration transportRetryDelay;\n68: \n69:   @override\n70:   Stream<PlaybackManifest> watchCurrent({\n71:     required String partyId,\n72:     required String channelId,\n73:   }) async* {\n74:     _validatePathId(partyId, 'partyId');\n75:     _validatePathId(channelId, 'channelId');\n76:     final String documentPath = 'parties/$partyId/manifests/current_$channelId';\n77: \n78:     if (maxTransportResubscriptions < 0 || transportRetryDelay.isNegative) {\n79:       throw ArgumentError('transport retry settings must be non-negative');\n80:     }\n81:     var failures = 0;\n82:     while (true) {\n83:       try {\n84:         final Stream<Map<String, Object?>?> documents = _documentsFor(\n85:           partyId,\n86:           channelId,\n87:           documentPath,\n88:         );\n89:         await for (final Map<String, Object?>? raw in documents) {\n90:           if (raw == null) {\n91:             throw const ManifestTransportException(\n92:               'current manifest document does not exist',\n93:             );\n94:           }\n95:           final Map<String, Object?> normalized = _normalizeMap(raw);\n96:           final PlaybackManifest manifest = manifestFromFirestore(\n97:             normalized,\n98:             now: _now,\n99:           );\n100:           if (manifest.partyId != partyId || manifest.channelId != channelId) {\n101:             throw ManifestScopeException(\n102:               'requested $partyId/$channelId but document contains '\n103:               '${manifest.partyId}/${manifest.channelId}',\n104:             );\n105:           }\n106:           failures = 0;\n107:           yield manifest;\n108:         }\n109:         return;\n110:       } on ManifestSchemaException {\n111:         rethrow;\n112:       } on ManifestScopeException {\n113:         rethrow;\n114:       } on ManifestTransportException catch (error, stackTrace) {\n115:         if (failures >= maxTransportResubscriptions) {\n116:           Error.throwWithStackTrace(error, stackTrace);\n117:         }\n118:         failures++;\n119:         await Future<void>.delayed(transportRetryDelay * failures);\n120:       } on FirebaseException catch (error, stackTrace) {\n121:         if (failures >= maxTransportResubscriptions) {\n122:           Error.throwWithStackTrace(\n123:             ManifestTransportException(\n124:               'Firestore manifest stream failed',\n125:               error,\n126:             ),\n127:             stackTrace,\n128:           );\n129:         }\n130:         failures++;\n131:         await Future<void>.delayed(transportRetryDelay * failures);\n132: