vate/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-cameo-wall.mp4\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/tv-wall.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-tv-post-purge.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-tv-v4a.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/tv-guest-list-full.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/recovery-panel.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-tv-v4b.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-camera-lineup.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-tv-cameo.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-live-credit-log.csv\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/wall-live-v1.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/tv-guest-panel-live.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-tv-generated.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/phone-now-playing-lineup.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/phone-new-party-lineup.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/rehearsal-2026-10-30/cycle11-tv-v5.png\n/private/tmp/orchestrator/cycle-12/fix-2/docs/COMPANION-CAMERA-PROOF.md","title":"glob","metadata":{"metadata":{"count":36,"truncated":false},"content":[{"type":"text","text":"/private/tmp/orchestrator/cycle-12/fix-2/docs/RELEASE-SIGNING.md\n/private/tmp/orchestrator/cycle-12/fix-2/docs/ADRs/0001-package-mapping.md\n/private/tmp/orchestrator/cycle-12/fix-2/docs/ADRs/0002-cycle2-scoped-fixes.md\n/private/tmp/orchestrator/cycle-12/fix-2/docs/owner-questions.md\n/private/tmp/orchestrator/cycle-12/fix-2/docs/CHEAP-DEMO-OWNER-GATE.md\n/private/tmp/orchestrato