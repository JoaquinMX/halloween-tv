     deliveryRequestCount++;\n36:       final Map<String, Object?> response = Map<String, Object?>.from(\n37:         (fixture['deliveryUrls']! as Map)['response']! as Map,\n38:       );\n39:       response['manifestVersion'] = currentDeliveryVersion;\n40:       response['manifestHash'] = 'f' * 64;\n41:       response['clips'] = <Map<String, Object?>>[\n42:         for (final CctvSlot slot in cctvSlots) _deliveryClip(slot.id),\n43:       ];\n44:       return response;\n45:     }\n46:     if (name == 'acknowledgeDelivery') {\n47:       await onAcknowledgement?.call(payload);\n48:       if (rejectAcknowledgements) {\n49:         throw StateError('backend rejected stale acknowledgement');\n50:       }\n51:       return <String, Object?>{\n52:         'ackId': 'ack-${payload['manifestVersion']}',\n53:         'manifestVersion': payload['manifestVersion'],\n54:         'purged': true,\n55:       };\n56:     }\n57:     throw StateError('unexpected callable $name');\n58:   }\n59: \n60:   Map<String, Object?> _deliveryClip(String cameraId) {\n61:     final List<Object?> clips =\n62:         currentDocument['cameraClips']! as List<Object?>;\n63:     final Map<String, Object?> clip = Map<String, Object?>.from(\n64:       clips.cast<Map<Object?, Object?>>().singleWhere(\n65:         (Map<Object?, Object?> value) => value['cameraId'] == cameraId,\n66:       ),\n67:     );\n68:     final bool isMismatch = cameraId == contentMismatchCamera;\n69:     final String hash = isMismatch ? 'e' * 64 : clip['sha256']! as String;\n70:     final String path;\n71:     if (deliveryRequestCount <= 2) {\n72:       path = '/expired/$cameraId';\n73:     } else if (cameraId == corruptCamera) {\n74:       path = '/corrupt/$cameraId';\n75:     } else {\n76:       path = '/fresh/$cameraId';\n77:     }\n78:     return <String, Object?>{\n79:       'cameraId': cameraId,\n80:       'sha256': hash,\n81:       'url': _server!.uriFor(path).toString(),\n82:       'expiresAt': '2030-01-01T00:00:00.000Z',\n83:     };\n84:   }\n85: \n86:   HttpsFixtureServer? _server;\n87: \n88:   set server(HttpsFixtureServer value) => _server = value;\n89: }\n90: \n91: Map<String, Object?> _readFixture() => Map<String, Object?>.from(\n92:   jsonDecode(\n93:         File('../../test/fixtures/backend_contract_v1.json').readAsStringSync(),\n94:       )\n95:       as Map,\n96: );\n97: \n98: Map<String, Object?> _backendManifest({\n99:   required Map<String, Object?> fixture,\n100:   required int version,\n101:   required Map<String, List<int>> bytesByCamera,\n102: }) {\n103:   final Map<String, Object?> template = Map<String, Object?>.from(\n104:     fixture['manifest']! as Map,\n105:   );\n106:   final String partyId = template['partyId']! as String;\n107:   final String channelId = template['channelId']! as String;\n108:   template['version'] = version;\n109:   template['createdAt'] = DateTime.utc(2026, 10, 29, version).toIso8601String();\n110:   template['expiresAt'] = '2030-01-01T00:00:00.000Z';\n111:   template['cameraClips'] = <Map<String, Object?>>[\n112:     for (final CctvSlot slot in cctvSlots)\n113:       <String, Object?>{\n114:         'cameraId': slot.id,\n115:         'objectPath':\n116:             'parties/$partyId/channels/$channelId/delivery/$version/${slot.id}.mp4',\n117:         'sha256': sha256Hex(bytesByCamera[slot.id]!),\n118:         'sizeBytes': bytesByCamera[slot.id]!.length,\n119:         'durationMs': 2000,\n120:         'expiresAt': '2030-01-01T00:00:00.000Z',\n121:       },\n122:   ];\n123:   return template;\n124: }\n125: \n126: Map<String, List<int>> _bytesForVersion(int version) => <String, List<int>>{\n127:   for (final CctvSlot slot in cctvSlots)\n128:     slot.id: <int>[version, slot.index + 10, slot.index + 20, version + 30],\n129: };\n130: \n131: void main() {\n132:   test(\n133:     'shared backend fixture flows through manifest mapping, HTTPS delivery, durable cache, ACK and offline restore',\n134:     () async {\n135:       final Map<String, Object?> fixture = _readFixture();\n136:       final Map<String, List<int>> v1Bytes = _bytesForVersion(1);\n137:       final Map<String, List<int>> v2Bytes = _bytesForVersion(2);\n138:       final Map<String, List<int>> httpBodies = <String, List<int>>{\n139:         for (final CctvSlot slot in cctvSlots)\n140:           '/fresh/${slot.id}': v1Bytes[slot.id]!,\n141:         '/corrupt/CAM-03': <int>[0, 0, 0, 0],\n142:       };\n143:       final Map<String, HttpsFixtureResponse> responses =\n144:           <String, HttpsFixtureResponse>{\n145:             for (final CctvSlot slot in cctvSlots)\n146:               '/expired/${slot.id}': const HttpsFixtureResponse(\n147:                 statusCode: HttpStatus.forbidden,\n148:               ),\n149:             for (final CctvSlot slot in cctvSlots)\n150:               '/fresh/${slot.id}': HttpsFixtureResponse(\n151:                 statusCode: HttpStatus.ok,\n152:                 body: httpBodies['/fresh/${slot.id}']!,\n153:               ),\n154:             '/corrupt/CAM-03': HttpsFixtureResponse(\n155:               statusCode: HttpStatus.ok,\n156:               body: httpBodies['/corrupt/CAM-03']!,\n157:             ),\n158:           };\n159:       final HttpsFixtureServer server = await HttpsFixtureServer.start(\n160:         responses: responses,\n161:       );\n162:       final HttpClient httpClient = testHttpClient();\n163:       final Directory root = await Directory.systemTemp.createTemp(\n164:         'backend-delivery-contract-',\n165:       );\n166:       final Directory indexRoot = Directory('${root.path}/indexes');\n167:       try {\n168:         final _BackendCallable callable = _BackendCallable(fixture: fixture)\n169:           ..server = server;\n170:         callable.currentDocument = _backendManifest(\n171:           fixture: fixture,\n172:           version: 1,\n173:           bytesByCamera: v1Bytes,\n174:         );\n175:         final FirebaseManifestSource manifestSource = FirebaseManifestSource(\n176:           watchDocumentData: FirebaseCallableManifestTransport(\n177:             identity: FirebaseTvIdentity(\n178:               partyId: 'pilot',\n179:               deviceId: 'tv-pilot',\n180:             ),\n181:             callableInvoker: callable,\n182:             pollInterval: const Duration(seconds: 1),\n183:           ).watchDocumentData,\n184:         );\n185:         final FirebaseDeliveryClient delivery = FirebaseDeliveryClient(\n186:           identity: FirebaseTvIdentity(partyId: 'pilot', deviceId: 'tv-pilot'),\n187:           callableInvoker: callable,\n188:           now: () => DateTime.utc(2026, 10, 29),\n189:         );\n190:         final FirebaseUrlSigner signer = FirebaseUrlSigner(\n191:           deliveryClient: delivery,\n192:           channelId: 'main',\n193:         );\n194:         final FileCacheStore cache = FileCacheStore(root, indexRoot: indexRoot);\n195:         final FileManifestIndexStore indexes = FileManifestIndexStore(\n196:           indexRoot,\n197:         );\n198:         callable.onAcknowledgement = (Map<String, Object?> payload) async {\n199:           final CommittedManifestIndex? committed = await indexes.readCommitted(\n200:             partyId: 'pilot',\n201:             channelId: 'main',\n202:           );\n203:           if (committed == null ||\n204:               committed.committedVersion != payload['manifestVersion']) {\n205:             throw StateError('ACK arrived before the atomic index commit');\n206:           }\n207:           final PlaybackManifest mapped = manifestFromFirestore(\n208:             callable.currentDocument,\n209:           );\n210:           for (final ClipDescriptor clip in mapped.clips) {\n211:             if (await cache.findVerified(clip) == null) {\n212:               throw StateError(\n213:                 'ACK arrived before ${clip.cameraId} was committed',\n214:               );\n215:             }\n216:           }\n217:         };\n218:         var urlRefreshCount = 0;\n219