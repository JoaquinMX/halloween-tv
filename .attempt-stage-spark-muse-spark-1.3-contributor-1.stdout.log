h stays usable.\n33: final class JoinPayloadUnavailable extends JoinPayloadScanResult {\n34:   const JoinPayloadUnavailable();\n35: }\n36: \n37: /// Camera permission was denied. When [permanently] is true the OS will no\n38: /// longer show the prompt, so the message must point at Settings.\n39: final class JoinPayloadPermissionDenied extends JoinPayloadScanResult {\n40:   const JoinPayloadPermissionDenied({this.permanently = false});\n41:   final bool permanently;\n42: }\n43: \n44: abstract interface class JoinPayloadScanner {\n45:   /// Runs one scan attempt. When [context] — a descendant of the app's\n46:   /// [MaterialApp], supplied by [JoinScreen] at invocation — is provided it\n47:   /// is used for any navigation; otherwise the scanner falls back to its\n48:   /// own context supplier. Never retain the context beyond the future.\n49:   Future<JoinPayloadScanResult> scan([BuildContext? context]);\n50: }\n51: \n52: final class UnavailableJoinPayloadScanner implements JoinPayloadScanner {\n53:   const UnavailableJoinPayloadScanner();\n54:   @override\n55:   Future<JoinPayloadScanResult> scan([BuildContext? context]) async =>\n56:       const JoinPayloadUnavailable();\n57: }\n58: \n59: /// Camera-permission states, decoupled from `permission_handler` for tests.\n60: enum CameraPermissionState { granted, denied, permanentlyDenied }\n61: \n62: /// Permission gateway seam; the shipped implementation delegates to\n63: /// `permission_handler`, tests inject fakes.\n64: abstract interface class CameraPermissionClient {\n65:   Future<CameraPermissionState> check();\n66:   Future<CameraPermissionState> request();\n67: }\n68: \n69: final class PermissionHandlerCameraPermissions\n70:     implements CameraPermissionClient {\n71:   const PermissionHandlerCameraPermissions();\n72: \n73:   @override\n74:   Future<CameraPermissionState> check() async =>\n75:       _map(await Permission.camera.status);\n76: \n77:   @override\n78:   Future<CameraPermissionState> request() async =>\n79:       _map(await Permission.camera.request());\n80: \n81:   CameraPermissionState _map(PermissionStatus status) {\n82:     if (status.isGranted || status.isLimited) {\n83:       return CameraPermissionState.granted;\n84:     }\n85:     if (status.isPermanentlyDenied || status.isRestricted) {\n86:       return CameraPermissionState.permanentlyDenied;\n87:     }\n88:     return CameraPermissionState.denied;\n89:   }\n90: }\n91: \n92: /// Push outcome: [_Pushed] ran a real route (whose null/empty result is a\n93: /// cancellation), [_NoNavigator] found no [Navigator] above the context.\n94: sealed class _PushOutcome {\n95:   const _PushOutcome();\n96: }\n97: \n98: final class _Pushed extends _PushOutcome {\n99:   const _Pushed(this.text);\n100:   final String? text;\n101: }\n102: \n103: final class _NoNavigator extends _PushOutcome {\n104:   const _NoNavigator();\n105: }\n106: \n107: /// Camera-backed scanner: permission flow with graceful denial, then a\n108: /// full-screen [QrScanScreen] whose captured text reuses the existing\n109: /// first-join registration and error states in [JoinScreen].\n110: final class CameraJoinPayloadScanner implements JoinPayloadScanner {\n111:   CameraJoinPayloadScanner({\n112:     BuildContext Function()? contextOf,\n113:     CameraPermissionClient permissions =\n114:         const PermissionHandlerCameraPermissions(),\n115:   }) : _contextOf = contextOf,\n116:        _permissions = permissions;\n117: \n118:   /// Legacy ancestor-context supplier, kept for source compatibility.\n119:   /// The invocation context always wins; this is only a last-resort\n120:   /// fallback when it carries no [Navigator].\n121:   final BuildContext Function()? _contextOf;\n122:   final CameraPermissionClient _permissions;\n123: \n124:   @override\n125:   Future<JoinPayloadScanResult> scan([BuildContext? context]) async {\n126:     final CameraPermissionState state = await _resolvePermission();\n127:     switch (state) {\n128:       case CameraPermissionState.granted:\n129:         break;\n130:       case CameraPermissionState.denied:\n131:         return const JoinPayloadPermissionDenied();\n132:       case CameraPermissionState.permanentlyDenied:\n133:         return const JoinPayloadPermissionDenied(permanently: true);\n134:     }\n135:     // Prefer the invocation (descendant-of-MaterialApp) context: the\n136:     // permission prompt may have backgrounded or closed the join screen,\n137:     // so never push onto a dead element.\n138:     final BuildContext? invocation = context;\n139:     if (invocation != null) {\n140:       if (!invocation.mounted) {\n141:         return const JoinPayloadUnavailable();\n142:       }\n143:       final _PushOutcome first = await _pushScanner(invocation);\n144:       switch (first) {\n145:         case _Pushed(:final String? text):\n146:           return _toResult(text);\n147:         case _NoNavigator():\n148:           // The invocation context carried no Navigator (a stale ancestor\n149:           // context): try the legacy supplier once before giving up to\n150:           // the type-or-paste path.\n151:           break;\n152:       }\n153:     }\n154:     final BuildContext? fallback = _legacyContext();\n155:     if (fallback == null || !fallback.mounted) {\n156:       return const JoinPayloadUnavailable();\n157:     }\n158:     final _PushOutcome second = await _pushScanner(fallback);\n159:     if (second is! _Pushed || second.text == null) {\n160:       return const JoinPayloadUnavailable();\n161:     }\n162:     return _toResult(second.text!);\n163:   }\n164: \n165:   JoinPayloadScanResult _toResult(String? text) {\n166:     if (text == null || text.trim().isEmpty) {\n167:       return const JoinPayloadUnavailable();\n168:     }\n169:     return JoinPayloadText(text);\n170:   }\n171: \n172:   /// Returns the legacy ancestor context when it can still host a route.\n173:   BuildContext? _legacyContext() {\n174:     final BuildContext Function()? supplier = _cont