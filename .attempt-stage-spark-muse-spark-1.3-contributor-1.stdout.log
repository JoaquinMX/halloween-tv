{"type":"tool_use","timestamp":1793461704879,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a5d8a7001nUrc0tv8qBkRk2","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a5d01c001jf0MkgUnxpoXPw","type":"tool","id":"call_01a192a5d4b370bbbec1503a2c492a44","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/host_media.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-3/backend/functions/src/host_media.ts, lines 1-439\n1: import { Bucket, File } from \"@google-cloud/storage\";\n2: import { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\n3: import {\n4:   BackendError,\n5:   DeleteHostVideoResult,\n6:   GenerateHostVideoResult,\n7:   GetHostVideoPreviewResult,\n8:   HostSeedEntry,\n9:   HostSeedStatus,\n10:   parseDeleteHostVideoInput,\n11:   parseGenerateHostVideoInput,\n12:   parseGetHostVideoPreviewInput,\n13:   parseListHostVideosInput,\n14: } from \"./contracts\";\n15: import {\n16:   DELIVERY_URL_TTL_SECONDS,\n17:   HOST_PREVIEW_TTL_MS,\n18:   REQUIRED_CAMERA_IDS,\n19:   hostPreviewObjectPath,\n20: } from \"./config\";\n21: import { assertRegisteredHostDevice } from \"./auth\";\n22: import { FirestoreGenerationStore } from \"./generation_store\";\n23: \n24: export interface HostMediaServiceOptions {\n25:   db: Firestore;\n26:   bucket: Bucket;\n27:   now?: () => Date;\n28:   signPreviewUrl?: (file: File, expiresAt: Date) => Promise<string>;\n29:   deleteObject?: (file: File) => Promise<void>;\n30: }\n31: \n32: /**\n33:  * Server-backed seed catalog (cycle-12 host administration).\n34:  *\n35:  * Catalog entries live at `parties/{partyId}/seedVideos/{seedId}` and carry\n36:  * generation status plus the camera video references. Deletion granularity:\n37:  * `deleteHostVideo` removes selected seed entries and their associated\n38:  * preview + delivery objects, revokes an affected current manifest whose\n39:  * jobId matches a deleted seed, and preserves accounting records (costLogs\n40:  * / usage ledger rows are never deleted). Expiry: each seed carries\n41:  * `expiresAt` (creation + HOST_PREVIEW_TTL_MS); the retention sweep expires\n42:  * due seeds and deletes their preview objects, while live seeds protect\n43:  * their preview paths from the orphan pass. Direct client access remains\n44:  * denied: callable-only Firestore docs (catch-all deny in firestore.rules)\n45:  * and callable-only Storage objects (catch-all deny in storage.rules);\n46:  * preview URLs are signed on demand and never persisted.\n47:  *\n48:  * Previews are separately referenced (`hostPreviews/{seedId}/…`) from\n49:  * delivery objects (`channels/{channel}/delivery/…`) and are materialized\n50:  * before delivery objects can be ACK-purged (eagerly after the job is\n51:  * ready, retried lazily on list/preview reads), so an ACK purge of delivery\n52:  * bytes never removes preview bytes.\n53:  */\n54: export function jobIdForHostSeed(seedId: string): string {\n55:   return `hv-${seedId}`;\n56: }\n57: \n58: function seedIdForHostJob(jobId: string): string | undefined {\n59:   return jobId.startsWith(\"hv-\") ? jobId.slice(\"hv-\".length) : undefined;\n60: }\n61: \n62: function seedRef(db: Firestore, partyId: string, seedId: string) {\n63:   return db.doc(`parties/${partyId}/seedVideos/${seedId}`);\n64: }\n65: \n66: function jobRef(db: Firestore, partyId: string, jobId: string) {\n67:   return db.doc(`parties/${partyId}/jobs/${jobId}`);\n68: }\n69: \n70: export function createHostMediaService(options: HostMediaServiceOptions): {\n71:   listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }>;\n72:   generateHostVideo(value: unknown): Promise<GenerateHostVideoResult>;\n73:   getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult>;\n74:   deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult>;\n75: } {\n76:   const { db, bucket } = options;\n77:   const now = options.now ?? (() => new Date());\n78:   const signPreviewUrl =\n79:     options.signPreviewUrl ??\n80:     (async (file, expiresAt) => {\n81:       const [url] = await file.getSignedUrl({ action: \"read\", expires: expiresAt, version: \"v4\" });\n82:       return url;\n83:     });\n84:   const deleteObject =\n85:     options.deleteObject ??\n86:     (async (file) => {\n87:       await file.delete({ ignoreNotFound: true });\n88:     });\n89:   const store = new FirestoreGenerationStore({ db, bucket, now });\n90: \n91:   function exposedIso(value: unknown): string {\n92:     if (value instanceof Timestamp) return value.toDate().toISOString();\n93:     if (value instanceof Date) return value.toISOString();\n94:     if (typeof value === \"string\") return value;\n95:     return now().toISOString();\n96:   }\n97: \n98:   async function syncSeedStatus(\n99:     partyId: string,\n100:     seedSnap: FirebaseFirestore.DocumentSnapshot,\n101:   ): Promise<FirebaseFirestore.DocumentData | undefined> {\n102:     const seed = seedSnap.data();\n103:     if (!seed || seed.status === \"deleted\") return seed ?? undefined;\n104:     try {\n105:       const jobSnap = await jobRef(db, partyId, String(seed.jobId)).get();\n106:       if (!jobSnap.exists) return seed;\n107:       const job = jobSnap.data()!;\n108:       const state = String(job.state);\n109:       const next: HostSeedStatus | undefined =\n110:         state === \"ready\" || state === \"delivering\" || state === \"purged\"\n111:           ? \"ready\"\n112:           : state === \"failed\" || state === \"expired\"\n113:             ? \"failed\"\n114:             : state === \"running\"\n115:               ? \"running\"\n116:               : undefined;\n117:       if (next && next !== seed.status) {\n118:         await seedSnap.ref.update({ status: next, updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n119:         return { ...seed, status: next };\n120:       }\n121:       return seed;\n122:     } catch {\n123:       return seed;\n124:     }\n125:   }\n126: \n127:   /** Copies delivery bytes to separately referenced preview objects (idempotent). */\n128:   async function ensurePreviewCopies(\n129:     partyId: string,\n130:     seedId: string,\n131:     clips: Array<{ cameraId: string; objectPath: string; sha256: string }>,\n132:     previewExpiresAt: Date,\n133:   ): Promise<string[]> {\n134:     const paths: string[] = [];\n135:     for (const clip of clips) {\n136:       const previewPath = hostPreviewObjectPath(partyId, seedId, clip.cameraId);\n137:       const preview = bucket.file(previewPath);\n138:       const [exists] = await preview.exists().catch(() => [false] as unknown as [boolean]);\n139:       if (!exists) {\n140:         // Deleted seeds must never recreate previews: the caller checks the\n141:         // seed status inside a transaction first; this copy is the\n142:         // materialization step only for live seeds.\n143:         await bucket.file(clip.objectPath).copy(preview);\n144:         await preview\n145:           .setMetadata({\n146:             contentType: \"video/mp4\",\n147:             customTime: previewExpiresAt.toISOString(),\n148:             metadata: {\n149:               expiresAt: previewExpiresAt.toISOString(),\n150:               partyId,\n151:               seedId,\n152:               jobId: jobIdForHostSeed(seedId),\n153:               cameraId: clip.cameraId,\n154:               purpose: \"host-preview\",\n155:               sha256: clip.sha256,\n156:             },\n157:           })\n158:           .catch(() => undefined);\n159:       }\n160:       paths.push(previewPath);\n161:     }\n162:     return paths;\n163:   }\n164: \n165:   async function deliveryClipsForJob(\n166:     partyId: string,\n167:     channelId: string,\n168:     jobId: string,\n169:   ): Promise<Array<{ cameraId: string; objectPath: string; sha256: string }>> {\n170:     const jobSnap = await jobRef(db, partyId, jobId).get();\n171:     if (!jobSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n172:     const job = jobSnap.data()!;\n173:     const staged = (job.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown; sha256?: unknown; cameraId?: unknown }>;\n174:     const fromStaged = Object.values(staged).filter(\n175:       (clip): clip is { cameraId: string; objectPath: string; sha256: string } =>\n176:         !!clip && typeof clip.objectPath === \"string\" && typeof clip.sha256 === \"string\" && typeof clip.cameraId === \"string\",\n177:     );\n178:     if (fromStaged.length > 0) return fromStaged;\n179:     // Fall back to the published current manifest when it belongs to this job.\n180:     const current = await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get();\n181:     if (current.exists) {\n182:       const manifest = current.data() as { jobId?: unknown; cameraClips?: unknown };\n183:       if (manifest.jobId === jobId && Array.isArray(manifest.cameraClips)) {\n184:         return (manifest.cameraClips as Array<Record<string, unknown>>)\n185:           .filter((clip) => typeof clip.cameraId === \"string\" && typeof clip.objectPath === \"string\" && typeof clip.sha256 === \"string\")\n186:           .map((clip) => ({ cameraId: clip.cameraId as string, objectPath: clip.objectPath as string, sha256: clip.sha256 as string }));\n187:       }\n188:     }\n189:     throw new BackendError(\"NOT_FOUND\", \"Seed video preview is not ready yet.\");\n190:   }\n191: \n192:   async function listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }> {\n193:     const input = parseListHostVideosInput(value);\n194:     const host = await assertRegisteredHostDevice(db, input);\n195:     const snapshot = await db.collection(`parties/${host.partyId}/seedVideos`).get();\n196:     const videos: HostSeedEntry[] = [];\n197:     for (const doc of snapshot.docs) {\n198:       const seed = doc.data();\n199:       if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) continue;\n200:       const synced = await syncSeedStatus(host.partyId, doc);\n201:       const current = synced ?? seed;\n202:       videos.push({\n203:         seedId: String(seed.seedId),\n204:         partyId: host.partyId,\n205:         channelId: host.channelId,\n206:         status: current.status as HostSeedStatus,\n207:         jobId: String(seed.jobId),\n208:         createdAt: exposedIso(seed.createdAt),\n209:         expiresAt: exposedIso(seed.expiresAt),\n210:         previewAvailable: Array.isArray(seed.previewPaths) && seed.previewPaths.length > 0,\n211:         cameraIds: Array.isArray(seed.cameraIds) ? (seed.cameraIds as string[]) : [...REQUIRED_CAMERA_IDS],\n212:       });\n213:     }\n214:     videos.sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n215:     return { videos };\n216:   }\n217: \n218:   async function generateHostVideo(value: unknown): Promise<GenerateHostVideoResult> {\n219:     const input = parseGenerateHostVideoInput(value);\n220:     const host = await assertRegisteredHostDevice(db, input);\n221:     const jobId = jobIdForHostSeed(input.seedId);\n222:     const ref = seedRef(db, host.partyId, input.seedId);\n223:     const existing = await ref.get();\n224:     if (existing.exists) {\n225:       const old = existing.data()!;\n226:       if (\n227:         old.partyId !== host.partyId ||\n228:         old.channelId !== host.channelId ||\n229:         old.jobId !== jobId ||\n230:         old.idempotencyKey !== input.idempotencyKey ||\n231:         old.deviceId !== host.deviceId ||\n232:         (old.guestMediaId ?? undefined) !== (input.guestMediaId ?? undefined) ||\n233:         old.presetId !== input.presetId\n234:       ) {\n235:         throw new BackendError(\"FORBIDDEN\", \"seedId is already bound to a different request.\");\n236:       }\n237:       const synced = await syncSeedStatus(host.partyId, existing);\n238:       const jobSnap = await jobRef(db, host.partyId, jobId).get();\n239:       return {\n2