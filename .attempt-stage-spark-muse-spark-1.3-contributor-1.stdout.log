74:       // and retention retries revoked-manifest objects.\n475:     }\n476:     // Published manifest clips attributable to a bound job are deliverable\n477:     // until revoked: collect them here and delete the manifest doc below.\n478:     let revokedManifestPaths: string[] = [];\n479:     try {\n480:       const currentRef = db.doc(`parties/${identity.partyId}/manifests/current_${identity.channelId}`);\n481:       const current = await currentRef.get();\n482:       if (current.exists) {\n483:         const manifest = current.data() as Record<string, unknown>;\n484:         if (typeof manifest.jobId === \"string\" && boundJobIds.includes(manifest.jobId)) {\n485:           const clips = manifest.cameraClips;\n486:           if (Array.isArray(clips)) {\n487:             for (const clip of clips) {\n488:               if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n489:                 const path = (clip as Record<string, unknown>).objectPath as string;\n490:                 if (path.startsWith(\"parties/\")) {\n491:                   attributable.add(path);\n492:                   revokedManifestPaths.push(path);\n493:                 }\n494:               }\n495:             }\n496:           }\n497:         }\n498:       }\n499:     } catch {\n500:       revokedManifestPaths = [...attributable].filter((p) => p.includes(\"/delivery/\"));\n501:     }\n502:     const deletedObjects: string[] = [];\n503:     const pendingDeletions: string[] = [];\n504:     for (const path of attributable) {\n505:       try {\n506:         await deleteWithRetry(deleteObject, bucket.file(path));\n507:         deletedObjects.push(path);\n508:       } catch {\n509:         // Persisted below for the sweeper; verifiedAbsent stays false until\n510:         // every attributable object is confirmed absent.\n511:         pendingDeletions.push(path);\n512:       }\n513:     }\n514:     // Fail bound jobs closed with budget-pointer release (same semantics as\n515:     // the worker-side failForWithdrawnConsent path).\n516:     const budgetRef = db.doc(`parties/${identity.partyId}/generationBudget/active`);\n517:     for (const jobDoc of jobs.docs) {\n518:       const job = jobDoc.data() as Record<string, unknown>;\n519:       if ([\"failed\", \"purged\", \"expired\"].includes(String(job.state))) {\n520:         await db.runTransaction(async (transaction) => {\n521:           const budget = await transaction.get(budgetRef);\n522:           if (budget.exists && budget.data()?.activeJobId === jobDoc.id) {\n523:             transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n524:           }\n525:         }).catch(() => undefined);\n526:         continue;\n527:       }\n528:       await db.runTransaction(async (transaction) => {\n529:         const [current, budget] = await Promise.all([transaction.get(jobDoc.ref), transaction.get(budgetRef)]);\n530:         if (!current.exists) return;\n531:         transaction.update(jobDoc.ref, {\n532:           state: \"failed\",\n533:           status: \"failed\",\n534:           errorCode: \"FORBIDDEN\",\n535:           reconciliationReason: \"GUEST_CONSENT_WITHDRAWN\",\n536:           failedAt: FieldValue.serverTimestamp(),\n537:           timestamp: FieldValue.serverTimestamp(),\n538:           workerLeaseUntilMs: 0,\n539:         });\n540:         if (budget.exists && budget.data()?.activeJobId === jobDoc.id) {\n541:           transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n542:         }\n543:       }).catch(() => undefined);\n544:     }\n545:     // Revoke the deliverable manifest after its bytes are deleted.\n546:     try {\n547:       const currentRef = db.doc(`parties/${identity.partyId}/manifests/current_${identity.channelId}`);\n548:       const current = await currentRef.get();\n549:       if (current.exists) {\n550:         const manifest = current.data() as Record<string, unknown>;\n551:         if (typeof manifest.jobId === \"string\" && boundJobIds.includes(manifest.jobId)) {\n552:           await currentRef.delete().catch(() => undefined);\n553:         }\n554:       }\n555:     } catch {\n556:       // Revocation best-effort: delivery paths additionally refuse withdrawn\n557:       // bindings, and retention retries revoked-manifest objects.\n558:     }\n559:     // verifiedAbsent ONLY after every attributable object (source + staged +\n560:     // delivered + generated) is confirmed absent.\n561:     let verifiedAbsent = pendingDeletions.length === 0;\n562:     if (verifiedAbsent) {\n563:       for (const path of attributable) {\n564:         try {\n565:           const [stillExists] = await bucket.file(path).exists();\n566:           if (stillExists) {\n567:             verifiedAbsent = false;\n568:             pendingDeletions.push(path);\n569:           }\n570:         } catch {\n571:           verifiedAbsent = false;\n572:           pendingDeletions.push(path);\n573:         }\n574:       }\n575:     }\n576:     // Order the source first for stable assertions, without duplicating it.\n577:     const orderedDeleted = [\n578:       ...(deletedObjects.includes(objectPath) ? [objectPath] : []),\n579:       ...deletedObjects.filter((p) => p !== objectPath),\n580:     ];\n581:     await ref.update({\n582:       pendingDeletions,\n583:       revokedManifestPaths,\n584:       updatedAt: FieldValue.serverTimestamp(),\n585:     }).catch(() => undefined);\n586:     return { submissionId, status: \"withdrawn\", deletedObjects: orderedDeleted, verifiedAbsent };\n587:   }\n588: \n589:   /**\n590:    * Object-finalization cleanup: a PUT after withdrawal must not restore\n591:    * eligibility and is deleted. Pending uploads are left alone; explicit\n592:    * completion validates bytes before any eligibility change.\n593:    */\n594:   async function handleIngestFinalized(objectPath: string): Promise<{ handled: boolean; deleted: boolean }> {\n595:     const parsed = parseGuestObjectPath(objectPath);\n596:     if (!parsed) return { handled: false, deleted: false };\n597:     const snapshot = await guestMediaRef(db, parsed.partyId, parsed.submissionId).get();\n598:     if (!snapshot.exists) {\n599:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n600:       return { handled: true, deleted: true };\n601:     }\n602:     const doc = snapshot.data() as GuestMediaDoc;\n603:     if (doc.deviceId !== parsed.deviceId || doc.partyId !== parsed.partyId) {\n604:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n605:       return { handled: true, deleted: true };\n606:     }\n607:     if (doc.status === \"withdrawn\" || doc.status === \"expired\") {\n608:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n609:       const [stillExists] = await bucket.file(objectPath).exists();\n610:       if (stillExists) throw new BackendError(\"INTERNAL\", \"Withdrawn guest object could not be removed.\");\n611:       return { handled: true, deleted: true };\n612:     }\n613:     return { handled: true, deleted: false };\n614:   }\n615: \n616:   return { requestGuestUpload, completeGuestUpload, getGuestMediaStatus, withdrawGuestMedia, handleIngestFinalized };\n617: }\n618: \n619: export type GuestUploadServices = ReturnType<typeof createGuestUploadService>;"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192d1e670754ea81b34b3c176ebc4"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-3/backend/functions/src/guest_upload.ts\"}"},"time":{"start":1793464592304,"end":1793464593289}}}}
