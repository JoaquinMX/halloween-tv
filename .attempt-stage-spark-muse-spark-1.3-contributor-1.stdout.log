{"type":"tool_use","timestamp":1793463626774,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c32a88001dvuQ4C36ma3STK","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c32001001B9H3531PH1m3AX","type":"tool","id":"call_01a192c32a65769e8cf53561467c7288","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/guest_codes.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/guest_codes.dart, lines 1-335\n1: /// Host-visible guest code data (TV settings panel).\n2: ///\n3: /// The TV panel shows the TV's own party/device code as large text plus a QR\n4: /// encoding the anonymous session join payload, and lists the joined guest\n5: /// devices. Identifiers are opaque binding values only — never URLs,\n6: /// endpoints, or secrets. Registration is always decided server-side at\n7: /// callable time; nothing here implies a code is valid.\n8: ///\n9: /// Session QR JSON (TV display, companion parse) contains exactly\n10: /// `partyId` + `channelId` + `role` (`'guest'`) plus optional six-digit\n11: /// `joinPin`. It never carries a deviceId, URL, or secret.\n12: library;\n13: \n14: import 'dart:convert';\n15: \n16: import 'package:cloud_functions/cloud_functions.dart';\n17: \n18: /// Validates the optional six-digit session PIN (leading zeros significant).\n19: bool isValidJoinPin(String value) => RegExp(r'^[0-9]{6}$').hasMatch(value);\n20: \n21: /// One per-guest device visible to the host.\n22: ///\n23: /// Self-registered guests may have no `label` (absent or empty on the wire);\n24: /// readers must fall back to a neutral device-based display, never duplicate\n25: /// the id as label+value, and never prompt for names.\n26: final class GuestCodeEntry {\n27:   /// Creates a guest code row.\n28:   const GuestCodeEntry({\n29:     required this.deviceId,\n30:     this.label,\n31:     this.role,\n32:     this.status,\n33:   });\n34: \n35:   /// Guest device id (opaque value shown once as the row value).\n36:   final String deviceId;\n37: \n38:   /// Host label when the backend supplied a non-empty one; null otherwise.\n39:   final String? label;\n40: \n41:   /// Device role as reported by the listing (e.g. \"guest\"); null when absent.\n42:   final String? role;\n43: \n44:   /// Device status as reported by the listing; null when absent.\n45:   final String? status;\n46: \n47:   /// True when the backend supplied a non-blank label.\n48:   bool get hasCustomLabel => label != null && label!.trim().isNotEmpty;\n49: \n50:   /// Neutral display label: the custom label when present, else a generic\n51:   /// fallback that never echoes the device id.\n52:   String get displayLabel => hasCustomLabel ? label!.trim() : 'Guest device';\n53: \n54:   @override\n55:   bool operator ==(Object other) =>\n56:       identical(this, other) ||\n57:       (other is GuestCodeEntry &&\n58:           other.deviceId == deviceId &&\n59:           other.label == label &&\n60:           other.role == role &&\n61:           other.status == status);\n62: \n63:   @override\n64:   int get hashCode => Object.hash(deviceId, label, role, status);\n65: \n66:   @override\n67:   String toString() => 'GuestCodeEntry($displayLabel: $deviceId)';\n68: }\n69: \n70: /// Builds the anonymous session QR/join payload as a JSON object.\n71: ///\n72: /// Contains exactly `partyId` + `channelId` + `role` (`'guest'`) plus the\n73: /// optional six-digit `joinPin` (omitted when null). Never includes a\n74: /// deviceId, URL, or secret. Throws [ArgumentError] when [joinPin] is\n75: /// non-null but malformed.\n76: ///\n77: /// Rationale: the companion offers a dedicated host entry screen (Scan Host\n78: /// QR + an explicit Join-as-guest route), so the two QR kinds must be\n79: /// visibly distinct on the wire. The guest QR always carries\n80: /// `role: 'guest'`; legacy payloads without `role` remain parseable by\n81: /// consumers (role-absent means guest), with vectors in\n82: /// `test/fixtures/join_roles_v1.json`.\n83: String buildJoinPayload({\n84:   required String partyId,\n85:   required String channelId,\n86:   String? joinPin,\n87: }) {\n88:   if (joinPin != null && !isValidJoinPin(joinPin)) {\n89:     throw ArgumentError.value(joinPin, 'joinPin', 'must be six ASCII digits');\n90:   }\n91:   final Map<String, String> payload = <String, String>{\n92:     'partyId': partyId,\n93:     'channelId': channelId,\n94:     'role': 'guest',\n95:   };\n96:   if (joinPin != null) {\n97:     payload['joinPin'] = joinPin;\n98:   }\n99:   return jsonEncode(payload);\n100: }\n101: \n102: /// Failure reading the host guest-code listing.\n103: final class GuestCodeException implements Exception {\n104:   /// Creates a guest-code read failure.\n105:   const GuestCodeException(this.message);\n106: \n107:   /// Human-readable reason shown on the TV panel.\n108:   final String message;\n109: \n110:   @override\n111:   String toString() => 'GuestCodeException: $message';\n112: }\n113: \n114: /// Callable invoker seam: calls the named callable with the payload and\n115: /// returns the decoded response data. Production passes Cloud Functions;\n116: /// tests pass a fake.\n117: typedef CallableInvoker =\n118:     Future<Map<String, Object?>> Function(\n119:       String name,\n120:       Map<String, Object?> payload,\n121:     );\n122: \n123: /// Validated host-only session listing from `listPartyDevices`.\n124: ///\n125: /// Carries the authoritative session scope (`partyId`/`channelId`/\n126: /// `tvDeviceId`), the optional `joinPin` (string when configured, absent\n127: /// otherwise), and the guest device entries. PIN state always comes from\n128: /// this response, never from build-time config.\n129: final class GuestCodeListing {\n130:   /// Creates a validated listing.\n131:   const GuestCodeListing({\n132:     required this.partyId,\n133:     required this.channelId,\n134:     required this.tvDeviceId,\n135:     required this.devices,\n136:     this.joinPin,\n137:   });\n138: \n139:   /// Party the TV belongs to (must match the requesting client).\n140:   final String partyId;\n141: \n142:   /// Active channel (must match the requesting client).\n143:   final String channelId;\n144: \n145:   /// TV's own device id (must match the requesting client).\n146:   final String tvDeviceId;\n147: \n148:   /// Session PIN when configured; null means no PIN is required.\n149:   final String? joinPin;\n150: \n151:   /// Guest device entries (TV's own device excluded server-side).\n152:   final List<GuestCodeEntry> devices;\n153: \n154:   /// Validates a raw callable response against the requesting client's\n155:   /// scope. Throws [GuestCodeException] on any malformed field.\n156:   factory GuestCodeListing.fromResponse(\n157:     Map<String, Object?> data, {\n158:     required String expectedPartyId,\n159:     required String expectedChannelId,\n160:     required String expectedTvDeviceId,\n161:   }) {\n162:     final Object? partyId = data['partyId'];\n163:     final Object? channelId = data['channelId'];\n164:     final Object? tvDeviceId = data['tvDeviceId'] ?? data['deviceId'];\n165:     if (partyId is! String || partyId.isEmpty) {\n166:       throw const GuestCodeException('Guest list response has no party.');\n167:     }\n168:     if (channelId is! String || channelId.isEmpty) {\n169:       throw const GuestCodeException('Guest list response has no channel.');\n170:     }\n171:     if (tvDeviceId is! String || tvDeviceId.isEmpty) {\n172:       throw const GuestCodeException('Guest list response has no TV device.');\n173:     }\n174:     if (partyId != expectedPartyId) {\n175:       throw const GuestCodeException('Guest list party mismatch.');\n176:     }\n177:     if (channelId != expectedChannelId) {\n178:       throw const GuestCodeException('Guest list channel mismatch.');\n179:     }\n180:     if (tvDeviceId != expectedTvDeviceId) {\n181:       throw const GuestCodeException('Guest list TV device mismatch.');\n182:     }\n183:     String? joinPin;\n184:     if (data.containsKey('joinPin')) {\n185:       final Object? rawPin = data['joinPin'];\n186:       if (rawPin == null) {\n187:         joinPin = null;\n188:       } else if (rawPin is String && isValidJoinPin(rawPin)) {\n189:         joinPin = rawPin;\n190:       } else {\n191:         throw const GuestCodeException('Guest list PIN is malformed.');\n192:       }\n193:     }\n194:     final Object? devices = data['devices'];\n195:     if (devices is! List) {\n196:       throw const GuestCodeException('Guest list response has no device list.');\n197:     }\n198:     final List<GuestCodeEntry> entries = <GuestCodeEntry>[];\n199:     for (final Object? item in devices) {\n200:       if (item is! Map) {\n201:         throw const GuestCodeException('Guest list entry was not an object.');\n202:       }\n203:       final Map<String, Object?> row = Map<String, Object?>.from(item);\n204:       final Object? deviceId = row['deviceId'];\n205:       if (deviceId is! String || deviceId.isEmpty) {\n206:         throw const GuestCodeException('Guest list entry is missing fields.');\n207:       }\n208:       String? label;\n209:       if (row.containsKey('label')) {\n210:         final Object? rawLabel = row['label'];\n211:         if (rawLabel == null) {\n212:           label = null;\n213:         } else if (rawLabel is String) {\n214:           label = rawLabel.trim().isEmpty ? null : rawLabel.trim();\n215:         } else {\n216:           throw const GuestCodeException('Guest list entry is missing fields.');\n217:         }\n218:       }\n219:       String? role;\n220:       if (row.containsKey('role')) {\n221:         final Object? rawRole = row['role'];\n222:         if (rawRole == null) {\n223:           role = null;\n224:         } else if (rawRole is String && rawRole.isNotEmpty) {\n225:           role = rawRole;\n226:         } else {\n227:           throw const GuestCodeException('Guest list entry is missing fields.');\n228:         }\n229:       }\n230:       String? status;\n231:       if (row.containsKey('status')) {\n232:         final Object? rawStatus = row['status'];\n233:         if (rawStatus == null) {\n234:           status = null;\n235:         } else if (rawStatus is String && rawStatus.isNotEmpty) {\n236:           status = rawStatus;\n237:         } else {\n238:           throw const GuestCodeException('Guest list entry is missing fields.');\n239:         }\n240:       }\n241:       entries.add(\n242:         GuestCodeEntry(\n243:           deviceId: deviceId,\n244:           label: label,\n245:           role: role,\n246:           status: status,\n247:         ),\n248:       );\n249:     }\n250:     return GuestCodeListing(\n251:       partyId: partyId,\n252:       channelId: channelId,\n253:       tvDeviceId: tvDeviceId,\n254:       joinPin: joinPin,\n255:       devices: List<GuestCodeEntry>.unmodifiable(entries),\n256:     );\n257:   }\n258: }\n259: \n260: /// Reads the host-only `listPartyDevices` callable (TV device only).\n261: final class GuestCodeClient {\n262:   /// Creates a client over an invoker seam.\n263:   const GuestCodeClient({\n264:     required this.invoker,\n265:     required this.partyId,\n266:     required this.deviceId,\n267:     required this.channelId,\n268:   });\n269: \n270:   /// Builds a client over real Cloud Functions.\n271:   factory GuestCodeClient.cloudFunctions({\n272:     required FirebaseFunctions functions,\n273:     required String partyId,\n274:     required String deviceId,\n275:     required String channelId,\n276:   }) => GuestCodeClient(\n277:     invoker: (String name, Map<String, Object?> payload) async {\n278:       final HttpsCallableResult<Object?> result = await functions\n279:           .httpsCallable(name)\n280:           .call(payload);\n281:       final Object? data = result.data;\n282:       if (data is! Map) {\n283:         throw const GuestCodeException(\n284:           'Guest list response was not an object.',\n285:         );\n286:       }\n287:       return Map<String, Object?>.from(data);\n288:     },\n289:     partyId: partyId,\n290:     deviceId: deviceId,\n291:     channelId: channelId,\n292:   );\n293: \n294:   /// Invoker seam (Cloud Functions in production, fake in tests).\n295:   final CallableInvoker invoker;\n296: \n297:   /// Party the TV belongs to.\n298:   final String partyId;\n299: \n300:   /// TV's own device code (the authorized host caller).\n301:   final String deviceId;\n302: \n303:   /// Active channel.\n304:   final String channelId;\n305: \n306:   /// Fetches the validated host listing (scope + optional PIN + devices).\n307:   ///\n308:   /// Authorization still travels in the request as the TV's own `deviceId`;\n309:   /// the session QR never carries it. Throws [GuestCodeException] when the\n310:   /// response is malformed. Authorization failures surface as the caller's\n311:   /// error.\n312:   Future<GuestCodeListing> fetchListing() async {\n313:     final Map<String, Object?> data = await invoker(\n314:       'listPartyDevices',\n315:       <String, Object?>{\n316:         'partyId': partyId,\n317:         'deviceId': deviceId,\n318:         'channelId': channelId,\n319:       },\n320:     );\n321:     return GuestCodeListing.fromResponse(\n322:       data,\n323:       expectedPartyId: partyId,\n324:       expectedChannelId: channelId,\n325:       expectedTvDeviceId: deviceId,\n326:     );\n327:   }\n328: \n329:   /// Fetches guest codes; throws [GuestCodeException] when the response is\n330:   /// malformed. Authorization failures surface as the caller's error.\n331:   Future<List<GuestCodeEntry>> fetchGuestCodes() async {\n332:     final GuestCodeListing listing = await fetchListing();\n333:     return listing.devices;\n334:   }\n335: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall