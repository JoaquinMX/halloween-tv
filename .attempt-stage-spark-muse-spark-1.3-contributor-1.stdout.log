async {\n453:     var calls = 0;\n454:     await _pumpJoin(\n455:       tester,\n456:       CameraJoinPayloadScanner(\n457:         permissions: _FakePermissions(\n458:           checkResult: CameraPermissionState.granted,\n459:         ),\n460:       ),\n461:       (_) => calls++,\n462:     );\n463: \n464:     await _tapScan(tester);\n465:     await tester.pumpAndSettle();\n466:     expect(camera.startCalls, 1);\n467: \n468:     await tester.tap(find.byKey(QrScanScreen.closeKey));\n469:     await tester.pumpAndSettle();\n470: \n471:     expect(calls, 0);\n472:     expect(camera.startCalls, 1);\n473:     expect(find.byType(QrScanScreen), findsNothing);\n474:     expect(find.text('Scanner is unavailable on this device.'), findsOneWidget);\n475:     expect(tester.takeException(), isNull);\n476:   });\n477: \n478:   testWidgets('camera start failure shows retry and manual-entry fallback', (\n479:     tester,\n480:   ) async {\n481:     camera.startError = const MobileScannerException(\n482:       errorCode: MobileScannerErrorCode.unsupported,\n483:     );\n484:     GuestJoinData? received;\n485:     await _pumpJoin(\n486:       tester,\n487:       CameraJoinPayloadScanner(\n488:         permissions: _FakePermissions(\n489:           checkResult: CameraPermissionState.granted,\n490:         ),\n491:       ),\n492:       (data) => received = data,\n493:     );\n494: \n495:     await _tapScan(tester);\n496:     await tester.pumpAndSettle();\n497: \n498:     expect(find.byKey(QrScanScreen.errorKey), findsOneWidget);\n499:     expect(find.byKey(QrScanScreen.retryKey), findsOneWidget);\n500: \n501:     // Retry with a working camera recovers the preview.\n502:     camera.startError = null;\n503:     await tester.tap(find.byKey(QrScanScreen.retryKey));\n504:     await tester.pumpAndSettle();\n505:     expect(find.byKey(const Key('fake-camera-view')), findsOneWidget);\n506: \n507:     // A later failure (here: resume with a dead camera) resurfaces the\n508:     // error screen, whose manual-entry fallback pops back to the usable\n509:     // paste path.\n510:     camera.startError = const MobileScannerException(\n511:       errorCode: MobileScannerErrorCode.unsupported,\n512:     );\n513:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.inactive);\n514:     await tester.pump();\n515:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);\n516:     await tester.pump();\n517:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);\n518:     await tester.pump();\n519:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);\n520:     await tester.pump();\n521:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.inactive);\n522:     await tester.pump();\n523:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);\n524:     await tester.pumpAndSettle();\n525:     expect(find.byKey(QrScanScreen.errorKey), findsOneWidget);\n526:     await tester.tap(find.byKey(QrScanScreen.manualEntryKey));\n527:     await tester.pumpAndSettle();\n528:     expect(find.byType(QrScanScreen), findsNothing);\n529:     expect(find.text('Scanner is unavailable on this device.'), findsOneWidget);\n530: \n531:     await _enterPayload(tester, '{\"partyId\":\"paste\",\"channelId\":\"cctv\"}');\n532:     await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n533:     await tester.pumpAndSettle();\n534:     await tester.tap(find.byKey(JoinScreen.submitKey));\n535:     await tester.pumpAndSettle();\n536:     expect(received?.partyId.value, 'paste');\n537:     expect(tester.takeException(), isNull);\n538:   });\n539: \n540:   testWidgets('disposing the join screen while permission is pending is safe', (\n541:     tester,\n542:   ) async {\n543:     final Completer<CameraPermissionState> gate =\n544:         Completer<CameraPermissionState>();\n545:     await _pumpJoin(\n546:       tester,\n547:       CameraJoinPayloadScanner(\n548:         permissions: _FakePermissions(\n549:           checkResult: CameraPermissionState.denied,\n550:           requestGate: gate,\n551:         ),\n552:       ),\n553:       (_) {},\n554:     );\n555: \n556:     await _tapScan(tester);\n557:     await tester.pump();\n558: \n559:     // Tear down the whole tree while the OS permission prompt is \"up\".\n560:     await tester.pumpWidget(const SizedBox());\n561:     await tester.pump();\n562:     gate.complete(CameraPermissionState.granted);\n563:     await tester.pumpAndSettle();\n564: \n565:     expect(tester.takeException(), isNull);\n566:   });\n567: \n568:   testWidgets('camera denial is graceful and keeps the paste path usable', (\n569:     tester,\n570:   ) async {\n571:     GuestJoinData? received;\n572:     await _pumpJoin(\n573:       tester,\n574:       _FakeScanner(const JoinPayloadPermissionDenied()),\n575:       (data) => received = data,\n576:     );\n577:     await _tapScan(tester);\n578:     await tester.pumpAndSettle();\n579:     expect(received, isNull);\n580:     expect(\n581:       find.text(\n582:         'Camera permission is needed to scan QR codes. Allow access and try again, or paste the join data instead.',\n583:       ),\n584:       findsOneWidget,\n585:     );\n586:     await _enterPayload(tester, '{\"partyId\":\"paste\",\"channelId\":\"cctv\"}');\n587:     await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n588:     await tester.pumpAndSettle();\n589:     await tester.tap(find.byKey(JoinScreen.submitKey));\n590:     await tester.pumpAndSettle();\n591:     expect(received?.partyId.value, 'paste');\n592:   });\n593: \n594:   testWidgets('permanent denial points at Settings', (tester) async {\n595:     var called = false;\n596:     await _pumpJoin(\n597:       tester,\n598:       _FakeScanner(const JoinPayloadPermissionDenied(permanently: true)),\n599:       (_) => called = true,\n600:     );\n601:     await _tapScan(tester);\n602:     await tester.pumpAndSettle();\n603:     expect(called, isFalse);\n604:     expect(find.textContaining('Settings'), findsOneWidget);\n605:   });\n606: \n607:   test(\n608:     'camera scanner returns denial without requesting twice or navigating',\n609:     () async {\n610:       // check() denied -> request() denied: surfaces a retryable denial.\n611:       final retryable = _FakePermissions(\n612:         checkResult: CameraPermissionState.denied,\n613:         requestResult: CameraPermissionState.denied,\n614:       );\n615:       // (No navigation happens on denial paths.)\n616:       final scanner = CameraJoinPayloadScanner(\n617:         contextOf: () => throw StateError('must not need context on denial'),\n618:         permissions: retryable,\n619:       );\n620:       final first = await scanner.scan();\n621:       expect(first, isA<JoinPayloadPermissionDenied>());\n622:       expect((first as JoinPayloadPermissionDenied).permanently, isFalse);\n623:       expect(retryable.requests, 1);\n624: \n625:       // check() permanently denied: never prompts, never navigates.\n626:       final blocked = _FakePermissions(\n627:         checkResult: CameraPermissionState.permanentlyDenied,\n628:       );\n629:       final scanner2 = CameraJoinPayloadScanner(\n630:         contextOf: () => throw StateError('must not need context on denial'),\n631:         permissions: blocked,\n632:       );\n633:       final second = await scanner2.scan();\n634:       expect(second, isA<JoinPayloadPermissionDenied>());\n635:       expect((second as JoinPayloadPermissionDenied).permanently, isTrue);\n636:       expect(blocked.requests, 0);\n637:     },\n638:   );\n639: \n640:   test(\n641:     'granted scan with no usable context falls back instead of throwing',\n642:     () async {\n643:       final scanner = CameraJoinPayloadScanner(\n644:         permissions: _FakePermissions(\n645:           checkResult: CameraPermissionState.granted,\n646:         ),\n647:       );\n648:       // No invocation context and no legacy supplier: no Navigator anywhere.\n649:       final result = await scanner.scan();\n650:       expect(result, isA<JoinPayloadUnavailable>());\n651:     },\n652:   );\n653: \n654:   testWidgets(\n655:     'stale ancestor context without a Navigator falls back instead of crashing',\n656:     (tester) async {\n657:       // Regression: _pushScanner caught only Exception, but Navigator.of\n658:       // throws FlutterError (an Error) when no Navigator is in scope — e.g.\n659:       // a stale ancestor context captured above MaterialApp. The scan must\n660:       // fall back to type-or-paste instead of crashing.\n661:       BuildContext? stale;\n662:       await tester.pumpWidget(\n663:         Builder(\n664:           builder: (BuildContext context) {\n665:             stale = context;\n666:             return const SizedBox();\n667:           },\n668:         ),\n669:       );\n670:       expect(stale, isNotNull);\n671:       final scanner = CameraJoinPayloadScanner(\n672:         permissions: _FakePermissions(\n673:           checkResult: CameraPermissionState.granted,\n674:         ),\n675:       );\n676:       final result = await scanner.scan(stale);\n677:       expect(result, isA<JoinPayloadUnavailable>());\n678:       expect(tester.takeException(), isNull);\n679:     },\n680:   );\n681: \n682:   test(\n683:     'legacy supplier throwing FlutterError falls back instead of crashing',\n684:     () async {\n685:       final scanner = CameraJoinPayloadScanner(\n686:         contextOf: () => throw FlutterError('stale element'),\n687:         permissions: _FakePermissions(\n688:           checkResult: CameraPermissionState.granted,\n689:         ),\n690:       );\n691:       final result = await scanner.scan();\n692:       expect(result, isA<JoinPayloadUnavailable>());\n693:     },\n694:   );\n695: \n696:   group('shipped CompanionApp hierarchy', () {\n697:     const MethodChannel permissionChannel = MethodChannel(\n698:       'flutter.baseflow.com/permissions/methods',\n699:     );\n700:     late _FakeManifestSource source;\n701: \n702:     void mockPermission({required int check, int request = 1}) {\n703:       TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger\n704:           .setMockMethodCallHandler(permissionChannel, (MethodCall call) async {\n705:             if (call.method == 'checkPermissionStatus') {\n706:               return check;\n707:             }\n708:             if (call.method == 'requestPermissions') {\n709:               return <int, int>{1: request};\n710:             }\n711:             return null;\n712:           });\n713:     }\n714: \n715:     setUp(() {\n716:       source = _FakeManifestSource();\n717:     });\n718: \n719:     tearDown(() async {\n720:       TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger\n721:           .setMockMethodCallHandler(permissionChannel, null);\n722:       for (final StreamController<PlaybackManifest> controller\n723:           in source.controllers) {\n724:         if (!controller.isClosed) {\n725:           await controller.close();\n726:         }\n727:       }\n728:     });\n729: \n730:     Future<void> pumpShippedApp(WidgetTester tester) async {\n731:       SharedPreferences.setMockInitialValues(<String, Object>{\n732:         DeviceIdentityStore.storageKey: _kDeviceId,\n733:       });\n734:       await tester.pumpWidget(\n735:         CompanionApp(manifestSource: source, clock: const SystemClock()),\n736:       );\n737:       await _flush(tester);\n738:     }\n739: \n740:     testWidgets(\n741:       'denied-to-granted permission starts the camera from the shipped tree',\n742:       (tester) async {\n743:         // First check: denied. Request: granted. Only the permission\n744:         // boundary is mocked; the scanner, screen, and camera controller\n745:         // are the shipped production objects.\n746:         mockPermission(check: 0, request: 1);\n747:         await pumpShippedApp(tester);\n748:         expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n749: \n750:         await _tapScan(tester);\n751:         await tester.pumpAndSettle();\n752: \n753:         // Pre-fix this push threw (ancestor context has no Navigator) and\n754:         // the camera never started. Now the real screen is up and running.\n755:         expect(find.byType(QrScanScreen), findsOneWidget);\n756:         expect(camera.startCalls, 1);\n757:         expect(find.byKey(const Key('fake-camera-view')), findsOneWidget);\n758:         expect(tester.takeException(), isNull);\n759:       },\n760:     );\n761: \n762:     testWidgets('shipped scan reaches the joined lineup', (tester) async {\n763:       mockPermission(check: 1);\n764:       await pumpShippedApp(tester);\n765: \n766:       await _tapScan(tester);\n767:       await tester.pumpAndSettle();\n768:       expect(find.byType(QrScanScreen), findsOneWidget);\n769: \n770:       camera.emit('{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}');\n771:       await _flush(tester);\n772:       expect(source.controllers, hasLength(1));\n773: \n774:       source.controllers.single.add(_manifest(version: 7));\n775:       await _flush(tester);\n776: \n777:       expect(find.textContaining('Manifest version 7'), findsOneWidget);\n778:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n779:       expect(tester.takeException(), isNull);\n780:     });\n781:   });\n782: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/camera_join_scan_test.dart, lines 1-782\n1: import 'dart:async';\n2: \n3: import 'package:channel_api/channel_api.dart';\n4: import 'package:companion_app/src/companion_app.dart';\n5: import 'package:companion_app/src/join/device_identity_store.dart';\n6: import 'package:companion_app/src/join/guest_join_data.dart';\n7: import 'package:companion_app/src/join/join_payload_scanner.dart';\n8: import 'package:companion_app/src/join/qr_scan_screen.dart';\n9: import 'package:companion_app/src/ui/join_screen.dart';\n10: import 'package:core_foundation/core_foundation.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: import 'package:flutter/material.dart';\n13: import 'package:flutter/services.dart';\n14: import 'package:flutter_test/flutter_test.dart';\n15: import 'package:mobile_scanner/mobile_scanner.dart';\n16: import 'package:shared_preferences/shared_preferences.dart';\n17: \n18: /// Granted-camera regressions for the join QR flow.\n19: ///\n20: /// Only two boundaries are substituted: the permission gateway (fake\n21: /// [CameraPermissionClient], or the permission method channel for the\n22: /// shipped-hierarchy test) and the native camera platform (fake\n23: /// [MobileScannerPlatform]). Every test below drives the REAL\n24: /// [CameraJoinPayloadScanner], the REAL [QrScanScreen], and the REAL\n25: /// [JoinScreen] validation/submission paths. The pre-fix production code\n26: /// failed these: [CompanionApp] built the scanner with its own\n27: /// above-[MaterialApp] context, so the post-grant push found no [Navigator]\n28: /// and the camera never started.\n29: \n30: final class _FakeScanner implements JoinPayloadScanner {\n31:   _FakeScanner(this.result);\n32:   final JoinPayloadScanResult result;\n33:   @override\n34:   Future<JoinPayloadScanResult> scan([BuildContext? context]) async => result;\n35: }\n36: \n37: /// Scriptable permission gateway that also records the check/request order\n38: /// relative to the camera start (shared [events] log).\n39: final class _FakePermissions implements CameraPermissionClient {\n40:   _FakePermissions({\n41:     required this.checkResult,\n42:     this.requestResult,\n43:     this.requestGate,\n44:     List<String>? events,\n45:   }) : events = events ?? <String>[];\n46:   final CameraPermissionState checkResult;\n47:   final CameraPermissionState? requestResult;\n48:   final Completer<CameraPermissionState>? requestGate;\n49:   final List<String> events;\n50:   int requests = 0;\n51: \n52:   @override\n53:   Future<CameraPermissionState> check() async {\n54:     events.add('check');\n55:     return checkResult;\n56:   }\n57: \n58:   @override\n59:   Future<CameraPermissionState> request() async {\n60:     events.add('request');\n61:     requests++;\n62:     final Completer<CameraPermissionState>? gate = requestGate;\n63:     if (gate != null) {\n64:       return gate.future;\n65:     }\n66:     return requestResult ?? checkResult;\n67:   }\n68: }\n69: \n70: /// Native-camera boundary fake: records start/stop/dispose, serves scripted\n71: /// start failures, and emits captures into the controller's barcode stream.\n72: final class _FakeScannerPlatform extends MobileScannerPlatform {\n73:   _FakeScannerPlatform({List<String>? events}) : events = events ?? <String>[];\n74:   final List<String> events;\n75:   int startCalls = 0;\n76:   int stopCalls = 0;\n77:   int pauseCalls = 0;\n78:   int disposeCalls = 0;\n79:   MobileScannerException? startError;\n80:   final StreamController<BarcodeCapture?> barcodes =\n81:       StreamController<BarcodeCapture?>.broadcast();\n82:   final StreamController<TorchState> torchStates =\n83:       StreamController<TorchState>.broadcast();\n84:   final StreamController<double> zoomScales =\n85:       StreamController<double>.broadcast();\n86: \n87:   void emit(String rawValue) {\n88:     barcodes.add(\n89:       BarcodeCapture(barcodes: <Barcode>[Barcode(rawValue: rawValue)]),\n90:     );\n91:   }\n92: \n93:   @override\n94:   Stream<BarcodeCapture?> get barcodesStream => barcodes.stream;\n95: \n96:   @override\n97:   Stream<TorchState> get torchStateStream => torchStates.stream;\n98: \n99:   @override\n100:   Stream<double> get zoomScaleStateStream => zoomScales.stream;\n101: \n102:   @override\n103:   Widget buildCameraView() =>\n104:       const SizedBox(key: Key('fake-camera-view'), width: 64, height: 64);\n105: \n106:   @override\n107:   Future<MobileScannerViewAttributes> start(StartOptions startOptions) async {\n108:     startCalls++;\n109:     events.add('start');\n110:     final MobileScannerException? error = startError;\n111:     if (error != null) {\n112:       throw error;\n113:     }\n114:     return const MobileScannerViewAttributes(\n115:       cameraDirection: CameraFacing.back,\n116:       currentTorchMode: TorchState.off,\n117:       size: Size(640, 480),\n118:       numberOfCameras: 1,\n119:     );\n120:   }\n121: \n122:   @override\n123:   Future<void> stop() async {\n124:     stopCalls++;\n125:   }\n126: \n127:   @override\n128:   Future<void> pause() async {\n129:     pauseCalls++;\n130:   }\n131: \n132:   @override\n133:   Future<void> dispose() async {\n134:     disposeCalls++;\n135:   }\n136: }\n137: \n138: /// Port-level fake: substitutes only the callable-boundary source.\n139: final class _FakeManifestSource implements ManifestSource<PlaybackManifest> {\n140:   final List<StreamController<PlaybackManifest>> controllers =\n141:       <StreamController<PlaybackManifest>>[];\n142: \n143:   @override\n144:   Stream<PlaybackManifest> watchCurrent({\n145:     required String partyId,\n146:     required String channelId,\n147:   }) {\n148:     final StreamController<PlaybackManifest> controller =\n149:         StreamController<PlaybackManifest>();\n150:     controllers.add(controller);\n151:     return controller.stream;\n152:   }\n153: }\n154: \n155: PlaybackManifest _manifest({int version = 1}) {\n156:   String sha(String seed) => List.filled(64, seed).join();\n157:   return PlaybackManifest(\n158:     partyId: 'party-1',\n159:     channelId: 'cctv',\n160:     version: version,\n161:     clips: <ClipDescriptor>[\n162:       for (int i = 1; i <= 4; i++)\n163:         ClipDescriptor(\n164:           id: 'clip-$i',\n165:           cameraId: 'CAM-0$i',\n166:           storageObjectId: 'cctv/cam-0$i.mp4',\n167:           sha256: sha('$i'),\n168:           sizeBytes: 1024,\n169:           duration: const Duration(seconds: 8),\n170:           mimeType: 'video/mp4',\n171:         ),\n172:     ],\n173:     publishedAt: DateTime.utc(2026, 10, 29, 14),\n174:   );\n175: }\n176: \n177: const String _kDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n178: \n179: /// Flushes async stream delivery without pumpAndSettle (spinners schedule\n180: /// endless frames, so fixed pumps only).\n181: Future<void> _flush(WidgetTester tester) async {\n182:   for (int i = 0; i < 6; i++) {\n183:     await tester.pump(const Duration(milliseconds: 50));\n184:   }\n185: }\n186: \n187: Future<void> _pumpJoin(\n188:   WidgetTester tester,\n189:   JoinPayloadScanner scanner,\n190:   void Function(GuestJoinData data) onJoin,\n191: ) async {\n192:   SharedPreferences.setMockInitialValues(<String, Object>{\n193:     DeviceIdentityStore.storageKey: _kDeviceId,\n194:   });\n195:   await tester.pumpWidget(\n196:     MaterialApp(\n197:       home: JoinScreen(scanner: scanner, onJoin: (data) async => onJoin(data)),\n198:     ),\n199:   );\n200:   await tester.pumpAndSettle();\n201: }\n202: \n203: Future<void> _tapScan(WidgetTester tester) async {\n204:   await tester.ensureVisible(find.byKey(JoinScreen.scanKey));\n205:   await tester.pump(const Duration(milliseconds: 50));\n206:   final ScrollableState scrollable = tester.state<ScrollableState>(\n207:     find.byType(Scrollable).first,\n208:   );\n209:   final Rect rect = tester.getRect(find.byKey(JoinScreen.scanKey));\n210:   final double viewHeight =\n211:       tester.view.physicalSize.height / tester.view.devicePixelRatio;\n212:   final double pixels = scrollable.position.pixels;\n213:   final double max = scrollable.position.maxScrollExtent;\n214:   if (rect.bottom > viewHeight - 4.0) {\n215:     final double delta = rect.bottom - viewHeight + 80.0;\n216:     scrollable.position.jumpTo((pixels + delta).clamp(0.0, max).toDouble());\n217:     await tester.pump(const Duration(milliseconds: 50));\n218:   }\n219:   await tester.tap(find.byKey(JoinScreen.scanKey));\n220: }\n221: \n222: Future<void> _enterPayload(WidgetTester tester, String text) async {\n223:   await tester.ensureVisible(find.byKey(JoinScreen.payloadFieldKey));\n224:   await tester.pump(const Duration(milliseconds: 50));\n225:   await tester.enterText(find.byKey(JoinScreen.payloadFieldKey), text);\n226: }\n227: \n228: /// Pushes a real [QrScanScreen] over a bare host route; [onPop] receives\n229: /// the value it pops with.\n230: Future<void> _pushScanScreen(\n231:   WidgetTester tester,\n232:   void Function(String? value) onPop,\n233: ) async {\n234:   await tester.pumpWidget(\n235:     MaterialApp(\n236:       home: Builder(\n237:         builder: (BuildContext context) => Scaffold(\n238:           body: Center(\n239:             child: TextButton(\n240:               key: const Key('open-scanner'),\n241:               onPressed: () {\n242:                 Navigator.of(context)\n243:                     .push<String>(\n244:                       MaterialPageRoute(builder: (_) => const QrScanScreen()),\n245:                     )\n246:                     .then(onPop);\n247:               },\n248:               child: const Text('open'),\n249:             ),\n250:           ),\n251:         ),\n252:       ),\n253:     ),\n254:   );\n255:   await tester.pumpAndSettle();\n256:   await tester.tap(find.byKey(const Key('open-scanner')));\n257:   await tester.pumpAndSettle();\n258:   expect(find.byType(QrScanScreen), findsOneWidget);\n259: }\n260: \n261: void main() {\n262:   TestWidgetsFlutterBinding.ensureInitialized();\n263: \n264:   late MobileScannerPlatform savedPlatform;\n265:   late _FakeScannerPlatform camera;\n266: \n267:   setUp(() {\n268:     savedPlatform = MobileScannerPlatform.instance;\n269:     camera = _FakeScannerPlatform();\n270:     MobileScannerPlatform.instance = camera;\n271:     MobileScannerController.resetPlatformSessionOwner();\n272:   });\n273: \n274:   tearDown(() async {\n275:     MobileScannerPlatform.instance = savedPlatform;\n276:     MobileScannerController.resetPlatformSessionOwner();\n277:     await camera.barcodes.close();\n278:     await camera.torchStates.close();\n279:     await camera.zoomScales.close();\n280:   });\n281: \n282:   testWidgets(\n283:     'denied-to-granted permission opens the real scanner and starts the camera',\n284:     (tester) async {\n285:       final List<String> events = <String>[];\n286:       camera.events.clear();\n287:       final _FakePermissions permissions = _FakePermissions(\n288:         checkResult: CameraPermissionState.denied,\n289:         requestResult: CameraPermissionState.granted,\n290:         events: events,\n291:       );\n292:       GuestJoinData? received;\n293:       await _pumpJoin(\n294:         tester,\n295:         CameraJoinPayloadScanner(permissions: permissions),\n296:         (data) => received = data,\n297:       );\n298: \n299:       await _tapScan(tester);\n300:       await tester.pumpAndSettle();\n301: \n302:       // Permission was requested exactly once, then the camera started after\n303:       // the grant — and the real scan screen is up with a live preview.\n304:       expect(permissions.requests, 1);\n305:       expect(events, <String>['check', 'request']);\n306:       expect(camera.startCalls, 1);\n307:       expect(find.byType(QrScanScreen), findsOneWidget);\n308:       expect(find.byKey(QrScanScreen.scannerKey), findsOneWidget);\n309:       expect(find.byKey(const Key('fake-camera-view')), findsOneWidget);\n310:       expect(received, isNull);\n311:       expect(tester.takeException(), isNull);\n312:     },\n313:   );\n314: \n315:   testWidgets('granted scan submits through the same validation as paste', (\n316:     tester,\n317:   ) async {\n318:     GuestJoinData? received;\n319:     await _pumpJoin(\n320:       tester,\n321:       CameraJoinPayloadScanner(\n322:         permissions: _FakePermissions(\n323:           checkResult: CameraPermissionState.granted,\n324:         ),\n325:       ),\n326:       (data) => received = data,\n327:     );\n328: \n329:     await _tapScan(tester);\n330:     await tester.pumpAndSettle();\n331:     expect(find.byType(QrScanScreen), findsOneWidget);\n332: \n333:     camera.emit('{\"partyId\":\"qr-party\",\"channelId\":\"cctv\",\"joinPin\":\"123456\"}');\n334:     await tester.pumpAndSettle();\n335: \n336:     // Detection pops the scanner and the text flows through the shared\n337:     // parser + first-join submission.\n338:     expect(find.byType(QrScanScreen), findsNothing);\n339:     expect(received?.partyId.value, 'qr-party');\n340:     expect(received?.channelId, 'cctv');\n341:     expect(received?.joinPin, '123456');\n342:     expect(find.byKey(JoinScreen.errorKey), findsNothing);\n343:     expect(tester.takeException(), isNull);\n344:   });\n345: \n346:   testWidgets(\n347:     'scanned garbage surfaces the same parse error as pasted garbage',\n348:     (tester) async {\n349:       var called = false;\n350:       await _pumpJoin(\n351:         tester,\n352:         _FakeScanner(const JoinPayloadText('{\"nope\":1}')),\n353:         (_) => called = true,\n354:       );\n355:       await _tapScan(tester);\n356:       await tester.pumpAndSettle();\n357:       expect(called, isFalse);\n358:       expect(find.byKey(JoinScreen.errorKey), findsOneWidget);\n359:       expect(\n360:         find.text('join payload must contain string partyId and channelId'),\n361:         findsOneWidget,\n362:       );\n363:     },\n364:   );\n365: \n366:   testWidgets('duplicate detections pop only once with the first payload', (\n367:     tester,\n368:   ) async {\n369:     String? popped;\n370:     var pops = 0;\n371:     await _pushScanScreen(tester, (String? value) {\n372:       pops++;\n373:       popped = value;\n374:     });\n375:     expect(camera.startCalls, 1);\n376: \n377:     camera.emit('{\"partyId\":\"first\",\"channelId\":\"cctv\"}');\n378:     camera.emit('{\"partyId\":\"second\",\"channelId\":\"cctv\"}');\n379:     await tester.pumpAndSettle();\n380: \n38