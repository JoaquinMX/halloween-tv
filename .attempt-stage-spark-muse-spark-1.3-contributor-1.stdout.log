\", channelId }),\n50:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n51:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId: \"not-registered\", channelId }),\n52:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n53:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId: \"other-channel\" }),\n54:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n55:     await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ status: \"disabled\" });\n56:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n57:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n58:     await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ status: \"active\" });\n59:     await db.doc(`parties/${partyId}`).update({ status: \"inactive\" });\n60:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n61:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n62:     await db.doc(`parties/${partyId}`).update({ status: \"active\" });\n63:     await db.doc(`parties/${partyId}/channels/${channelId}`).update({ status: \"inactive\" });\n64:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n65:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n66:     await db.doc(`parties/${partyId}/channels/${channelId}`).update({ status: \"active\" });\n67: \n68:     const invalidHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n69:     invalidHashes[\"CAM-01\"] = \"f\".repeat(64);\n70:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes: invalidHashes }),\n71:       (erro