{"type":"tool_use","timestamp":1793461687458,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a58cfd001Pa7oY87jr1wGlm","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a58a4c001esd1e160zU527e","type":"tool","id":"call_01a192a58ca87466a5c41cbb9b58d4b5","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/plugin.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/plugin.dart, lines 1-442\n1: /// Haunted-surveillance channel plugin + 2x2 wall shell.\n2: library;\n3: \n4: import 'dart:async';\n5: \n6: import 'package:channel_api/channel_api.dart';\n7: import 'package:core_effects/core_effects.dart';\n8: import 'package:core_foundation/core_foundation.dart';\n9: import 'package:core_playlist/core_playlist.dart';\n10: import 'package:core_ui/core_ui.dart';\n11: import 'package:flutter/material.dart';\n12: \n13: import 'cctv_tiles.dart';\n14: \n15: /// Builds the video surface for one wall tile.\n16: ///\n17: /// The channel never touches a concrete player: the app layer implements\n18: /// this callback (owning `VideoPlayerController` lifecycles) and the wall\n19: /// wraps the returned surface in [CctvTile] chrome.\n20: typedef CctvTileBuilder = Widget Function(\n21:   BuildContext context,\n22:   int index,\n23:   String label,\n24:   String cameraId,\n25: );\n26: \n27: /// Placeholder surface used when the app supplies no [CctvTileBuilder].\n28: Widget _defaultTileSurface(\n29:   BuildContext context,\n30:   int index,\n31:   String label,\n32:   String cameraId,\n33: ) =>\n34:     Container(\n35:       color: Colors.black,\n36:       child: Center(\n37:         child: Text(\n38:           'NO FEED · $cameraId',\n39:           style: CctvTheme.timestampStyle,\n40:         ),\n41:       ),\n42:     );\n43: \n44: /// Channel id for the haunted-surveillance feed.\n45: const String hauntedSurveillanceChannelId = 'haunted_surveillance';\n46: \n47: /// ChannelContext.settings keys honored by [HauntedSurveillancePlugin.build].\n48: ///\n49: /// Wall configuration travels through the channel contract (not through\n50: /// plugin re-instantiation): the app publishes its live wall state here and\n51: /// [HauntedSurveillancePlugin.build] applies it. Constructor fields remain\n52: /// as defaults for direct use; settings win when present so the registry\n53: /// object and any app-side copy can never diverge on wall config.\n54: class CctvWallSettingsKeys {\n55:   /// When `true`, drops effect overlays and glitch ticking.\n56:   static const String effectsDisabled = 'effectsDisabled';\n57: \n58:   /// Wall manifest version the app currently displays (diagnostics only).\n59:   static const String manifestVersion = 'manifestVersion';\n60: \n61:   /// Whether the host pads HUD content into the overscan-safe area.\n62:   static const String overscanSafe = 'overscanSafe';\n63: \n64:   /// Optional per-camera label overrides (`{cameraId: label}`).\n65:   static const String labels = 'labels';\n66: }\n67: \n68: /// Reads per-camera label overrides from [settings].\n69: ///\n70: /// Accepts any `Map` shape (the settings map is untyped) and keeps only\n71: /// string-keyed, string-valued entries.\n72: Map<String, String> cctvLabelOverridesFromSettings(ChannelSettings settings) {\n73:   final Object? raw = settings.values[CctvWallSettingsKeys.labels];\n74:   if (raw is! Map) {\n75:     return const <String, String>{};\n76:   }\n77:   final Map<String, String> out = <String, String>{};\n78:   for (final MapEntry<dynamic, dynamic> entry in raw.entries) {\n79:     if (entry.key is String && entry.value is String) {\n80:       out[entry.key as String] = entry.value as String;\n81:     }\n82:   }\n83:   return out;\n84: }\n85: \n86: /// Derives the tile effect profile from manifest [OverlaySettings].\n87: ///\n88: /// Manifest overlay values are already bounded to `0..1` by the playlist\n89: /// contract, so they map straight onto [EffectSpec] intensities.\n90: EffectProfile effectProfileFromOverlay(OverlaySettings overlay) =>\n91:     EffectProfile(<EffectSpec>[\n92:       EffectSpec(EffectType.scanlines, overlay.scanlineOpacity),\n93:       EffectSpec(EffectType.vignette, overlay.vignette),\n94:       EffectSpec(EffectType.noise, overlay.noiseLevel),\n95:     ]);\n96: \n97: /// Haunted-surveillance CCTV channel plugin.\n98: ///\n99: /// Descriptor id is [hauntedSurveillanceChannelId] with video-playback,\n100: /// effects, and timed-events capabilities. [build] assembles the 2x2 wall\n101: /// shell, delegating video surfaces to the app layer via PlaybackHandle +\n102: /// [tileBuilder].\n103: final class HauntedSurveillancePlugin implements ChannelPlugin {\n104:   /// Creates the plugin.\n105:   const HauntedSurveillancePlugin({\n106:     this.tileBuilder = _defaultTileSurface,\n107:     this.profile,\n108:     this.manifest,\n109:     this.clock = const SystemClock(),\n110:     this.disableEffects = false,\n111:     this.glitchSeed = 0xc0ffee,\n112:   });\n113: \n114:   /// Builds per-tile video surfaces (app-owned player lifecycles).\n115:   final CctvTileBuilder tileBuilder;\n116: \n117:   /// Effect profile applied to tile overlays; defaults to [cctvProfile].\n118:   final EffectProfile? profile;\n119: \n120:   /// Optional playback manifest; when it carries exactly four clips their\n121:   /// camera ids drive the wall slots, otherwise [tileFor] defaults apply.\n122:   final PlaybackManifest? manifest;\n123: \n124:   /// Clock source for tile HUD timestamps.\n125:   final Clock clock;\n126: \n127:   /// Drops effect overlays (tests / hidden recovery overlay).\n128:   final bool disableEffects;\n129: \n130:   /// Seed for the wall glitch controller (deterministic replay).\n131:   final int glitchSeed;\n132: \n133:   @override\n134:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n135:         id: hauntedSurveillanceChannelId,\n136:         title: 'Haunted Surveillance',\n137:         version: 1,\n138:         capabilities: ChannelCapability(\n139:           videoPlayback: true,\n140:           effects: true,\n141:           timedEvents: true,\n142:         ),\n143:       );\n144: \n145:   @override\n146:   Widget build(ChannelContext context) {\n147:     // Wall config flows through the channel contract: settings published by\n148:     // the host win over constructor defaults, so the registry object never\n149:     // needs to be discarded/re-instantiated to change wall behaviour.\n150:     final bool settingsDisabled = context.settings\n151:         .get<bool>(CctvWallSettingsKeys.effectsDisabled, false);\n152:     return CctvWall(\n153:       playbackHandle: context.playbackHandle,\n154:       tileBuilder: tileBuilder,\n155:       profile: profile ??\n156:           (manifest == null\n157:               ? cctvProfile()\n158:               : effectProfileFromOverlay(manifest!.overlay)),\n159:       manifest: manifest,\n160:       clock: clock,\n161:       disableEffects: disableEffects || settingsDisabled,\n162:       glitchSeed: glitchSeed,\n163:       labelOverrides: cctvLabelOverridesFromSettings(context.settings),\n164:     );\n165:   }\n166: }\n167: \n168: /// 2x2 CCTV wall shell.\n169: ///\n170: /// Boots by preparing the app-owned [PlaybackHandle], then shows four\n171: /// [CctvTile]s (video surface + HUD + effect overlay). A single tile\n172: /// failure never takes down the wall: surface builders that throw are\n173: /// caught per tile and render [SignalLost].\n174: class CctvWall extends StatefulWidget {\n175:   /// Creates the wall shell.\n176:   CctvWall({\n177:     super.key,\n178:     required this.playbackHandle,\n179:     this.tileBuilder = _defaultTileSurface,\n180:     EffectProfile? profile,\n181:     this.manifest,\n182:     this.clock = const SystemClock(),\n183:     this.disableEffects = false,\n184:     this.glitchSeed = 0xc0ffee,\n185:     this.glitchTick = const Duration(milliseconds: 700),\n186:     this.labelOverrides = const <String, String>{},\n187:   }) : profile = profile ?? cctvProfile();\n188: \n189:   /// Opaque app-owned playback control surface.\n190:   final PlaybackHandle playbackHandle;\n191: \n192:   /// Builds per-tile video surfaces.\n193:   final CctvTileBuilder tileBuilder;\n194: \n195:   /// Effect profile applied to tile overlays.\n196:   final EffectProfile profile;\n197: \n198:   /// Optional manifest overriding the default camera slot map.\n199:   final PlaybackManifest? manifest;\n200: \n201:   /// Clock source for tile HUD timestamps.\n202:   final Clock clock;\n203: \n204:   /// Drops effect overlays and glitch ticking.\n205:   final bool disableEffects;\n206: \n207:   /// Seed for the wall glitch controller.\n208:   final int glitchSeed;\n209: \n210:   /// Cadence of glitch-controller ticks.\n211:   final Duration glitchTick;\n212: \n213:   /// Per-camera label overrides applied on top of the slot map\n214:   /// (`{cameraId: label}`); empty means no overrides.\n215:   final Map<String, String> labelOverrides;\n216: \n217:   @override\n218:   State<CctvWall> createState() => _CctvWallState();\n219: }\n220: \n221: class _CctvWallState extends State<CctvWall> {\n222:   late final GlitchController _glitch;\n223:   Timer? _glitchTimer;\n224:   bool _ready = false;\n225:   bool _bootFailed = false;\n226: \n227:   @override\n228:   void initState() {\n229:     super.initState();\n230:     _glitch = GlitchController(seed: widget.glitchSeed);\n231:     if (!widget.disableEffects) {\n232:       _glitchTimer =\n233:           Timer.periodic(widget.glitchTick, (_) => _glitch.tick());\n234:     }\n235:     unawaited(_boot());\n236:   }\n237: \n238:   Future<void> _boot() async {\n239:     bool failed = false;\n240:     try {\n241:       await widget.playbackHandle.prepare();\n242:     } catch (_) {\n243:       // A failed coordinator boot must not take the wall down: every tile\n244:       // degrades to the SIGNAL LOST fallback instead.\n245:       failed = true;\n246:     }\n247:     if (!mounted) {\n248:       return;\n249:     }\n250:     setState(() {\n251:       _ready = true;\n252:       _bootFailed = failed;\n253:     });\n254:   }\n255: \n256:   @override\n257:   void didUpdateWidget(CctvWall oldWidget) {\n258:     super.didUpdateWidget(oldWidget);\n259:     // Reconcile the glitch ticker when effect state changes (e.g. the\n260:     // recovery panel toggles effects OFF -> ON): a stale timer must not\n261:     // keep ticking while disabled, and re-enabling must restart it.\n262:     if (oldWidget.disableEffects != widget.disableEffects) {\n263:       if (widget.disableEffects) {\n264:         _glitchTimer?.cancel();\n265:         _glitchTimer = null;\n266:         _glitch.reset();\n267:       } else {\n268:         _glitchTimer ??= Timer.periodic(\n269:           widget.glitchTick,\n270:           (_) => _glitch.tick(),\n271:         );\n272:       }\n273:     } else if (!widget.disableEffects &&\n274:         oldWidget.glitchTick != widget.glitchTick) {\n275:       _glitchTimer?.cancel();\n276:       _glitchTimer = Timer.periodic(\n277:         widget.glitchTick,\n278:         (_) => _glitch.tick(),\n279:       );\n280:     }\n281:   }\n282: \n283:   @override\n284:   void dispose() {\n285:     _glitchTimer?.cancel();\n286:     _glitch.dispose();\n287:     super.dispose();\n288:   }\n289: \n290:   /// Wall slots in canonical order, one per `core_playlist` [CctvSlot].\n291:   ///\n292:   /// Slot placement always follows camera identity (`cctvSlots` order), never\n293:   /// manifest clip order, so a reordered control-plane payload cannot move a\n294:   /// feed to the wrong tile. When the manifest carries one clip per slot, the\n295:   /// clip drives the tile via [tileForClip]: its `label` wins when present,\n296:   /// else the `core_playlist` slot default applies (owner Q3). Manifests that\n297:   /// are short, oversized, or name unknown cameras fall back to the static\n298:   /// [tileFor] defaults per slot instead of taking the wall down.\n299:   /// Per-camera label overrides from [ChannelContext.settings] apply on top.\n300:   List<({String label, String cameraId})> _slots() {\n301:     final PlaybackManifest? manifest = widget.manifest;\n302:     final Map<String, ClipDescriptor> byCamera = <String, ClipDescriptor>{};\n303:     if (manifest != null && manifest.clips.length == cctvSlots.length) {\n304:       for (final ClipDescriptor clip in manifest.clips) {\n305:         byCamera.putIfAbsent(clip.cameraId, () => clip);\n306:       }\n307:     }\n308:     final List<({String label, String cameraId})> base =\n309:         <({String label, String cameraId})>[\n310:       for (final CctvSlot slot in cctvSlots)\n311:         if (byCamera[slot.id] case final ClipDescriptor clip)\n312:           tileForClip(clip)\n313:         else\n314:           tileFor(slot.index),\n315:     ];\n316:     if (widget.labelOverrides.isEmpty) {\n317:       return base;\n318:     }\n319:     return <({String label, String cameraId})>[\n320:       for (final ({String label, String cameraId}) slot in base)\n321:         (\n322:           label: widget.labelOverrides[slot.cameraId] ?? slot.label,\n323:           cameraId: slot.cameraId,\n324:         ),\n325:     ];\n326:   }\n327: \n328:   @override\n329:   Widget build(BuildContext context) {\n330:     if (!_ready) {\n331:       return const Center(child: CircularProgressIndicator());\n332:     }\n333:     // 2x2 wall sized by the viewport: Column/Row of Expanded cells fills\n334:     // exactly the incoming constraints (720p through 1080p, including the\n335:     // host's overscan-safe padding) with no scrollable and no overflow.\n336:     // A fixed GridView cross-axis layout cannot guarantee this: without a\n337:     // viewport-derived childAspectRatio the bottom row renders off-screen.\n338:     final List<({String label, String cameraId})> slots = _slots();\n339:     Widget cell(int index) => Expanded(\n340:           child: Padding(\n341:             padding: const EdgeInsets.all(2),\n342:             child: _WallTile(\n343:               index: index,\n344:               label: slots[index].label,\n345:               cameraId: slots[index].cameraId,\n346:               tileBuilder: widget.tileBuilder,\n347:               profile: widget.profile,\n348:               clock: widget.clock,\n349:               disableEffects: widget.disableEffects,\n350:               glitch: _glitch,\n351:               bootFailed: _bootFailed,\n352:             ),\n353:           ),\n354:         );\n355:     return Container(\n356:       color: CctvTheme.gutter,\n357:       padding: const EdgeInsets.all(4),\n358:       child: Column(\n359:         children: <Widget>[\n360:           Expanded(\n361:             child: Row(\n362:               children: <Widget>[cell(0), cell(1)],\n363:             ),\n364:           ),\n365:           Expanded(\n366:             child: Row(\n367:               children: <Widget>[cell(2), cell(3)],\n368:             ),\n369:           ),\n370:         ],\n371:       ),\n372:     );\n373:   }\n374: }\n375: \n376: /// One wall slot: safe surface build + tile chrome.\n377: class _WallTile extends StatelessWidget {\n378:   const _WallTile({\n379:     required this.index,\n380:     required this.label,\n381:     required this.cameraId,\n382:     required this.tileBuilder,\n383:     required this.profile,\n384:     required this.clock,\n385:     required this.disableEffects,\n386:     required this.glitch,\n387:     required this.bootFailed,\n388:   });\n389: \n390:   final int index;\n391:   final String label;\n392:   final String cameraId;\n393:   final CctvTileBuilder tileBuilder;\n394:   final EffectProfile profile;\n395:   final Clock clock;\n396:   final bool disableEffects;\n397:   final GlitchController glitch;\n398:   final bool bootFailed;\n399: \n400:   @override\n401:   Widget build(BuildContext context) {\n402:     if (bootFailed) {\n403:       return const CctvTile(hasError: true, child: SizedBox.shrink());\n404:     }\n405:     Widget surface;\n406:     try {\n407:       surface = tileBuilder(context, index, label, cameraId);\n408:     } catch (_) {\n409:       return const CctvTile(\n410:         hasError: true,\n411:         child: SizedBox.shrink(),\n412:       );\n413:     }\n414:     Widget? effects;\n415:     if (!disableEffects) {\n416:       effects = _TileEffects(profile: profile, glitch: glitch);\n417:     }\n418:     return CctvTile(\n419:       disableEffects: disableEffects,\n420:       effectOverlay: effects,\n421:       hud: HudOverlay(label: label, clock: clock),\n422:       child: surface,\n423:     );\n424:   }\n425: }\n426: \n427: /// Scanlines + vignette + seeded noise overlay for one tile.\n428: class _TileEffects extends StatelessWidget {\n429:   const _TileEffects({required this.profile, required this.glitch});\n430: \n431:   final EffectProfile profile;\n432:   final GlitchController glitch;\n433: \n434:   @override\n435:   Widget build(BuildContext context) => ListenableBuilder(\n436:         listenable: glitch,\n437:         builder: (BuildContext context, Widget? _) => CctvEffectsOverlay(\n438:           profile: profile,\n439:           glitchIntensity: glitch.currentIntensity,\n440:         ),\n441:       );\n442: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/plugin.dart, lines 1-442\n1: /// Haunted-surveillance channel plugin + 2x2 wall shell.\n2: library;\n3: \n4: import 'dart:async';\n5: \n6: import 'package:channel_api/channel_api.dart';\n7: import 'package:core_effects/core_effects.dart';\n8: import 'package:core_foundation/core_foundation.dart';\n9: import 'package:core_playlist/core_playlist.dart';\n10: import 'package:core_ui/core_ui.dart';\n11: import 'package:flutter/material.dart';\n12: \n13: import 'cctv_tiles.dart';\n14: \n15: /// Builds the video surface for one wall tile.\n16: ///\n17: /// The channel never touches a concrete player: the app layer implements\n18: /// this callback (owning `VideoPlayerController` lifecycles) and the wall\n19: /// wraps the returned surface in [CctvTile] chrome.\n20: typedef CctvTileBuilder = Widget Function(\n21:   BuildContext context,\n22:   int index,\n23:   String label,\n24:   String cameraId,\n25: );\n26: \n27: /// Placeholder surface used when the app supplies no [CctvTileBuilder].\n28: Widget _defaultTileSurface(\n29:   BuildContext context,\n30:   int index,\n31:   String label,\n32:   String cameraId,\n33: ) =>\n34:     Container(\n35:       color: Colors.black,\n36:       child: Center(\n37:         child: Text(\n38:           'NO FEED · $cameraId',\n39:           style: CctvTheme.timestampStyle,\n40:         ),\n41:       ),\n42:     );\n43: \n44: /// Channel id for the haunted-surveillance feed.\n45: const String hauntedSurveillanceChannelId = 'haunted_surveillance';\n46: \n47: /// ChannelContext.settings keys honored by [HauntedSurveillancePlugin.build].\n48: ///\n49: /// Wall configuration travels through the channel contract (not through\n50: /// plugin re-instantiation): the app publishes its live wall state here and\n51: /// [HauntedSurveillancePlugin.build] applies it. Constructor fields remain\n52: /// as defaults for direct use; settings win when present so the registry\n53: /// object and any app-side copy can never diverge on wall config.\n54: class CctvWallSettingsKeys {\n55:   /// When `true`, drops effect overlays and glitch ticking.\n56:   static const String effectsDisabled = 'effectsDisabled';\n57: \n58:   /// Wall manifest version the app currently displays (diagnostics only).\n59:   static const String manifestVersion = 'manifestVersion';\n60: \n61:   /// Whether the host pads HUD content into the overscan-safe area.\n62:   static const String overscanSafe = 'overscanSafe';\n63: \n64:   /// Optional per-