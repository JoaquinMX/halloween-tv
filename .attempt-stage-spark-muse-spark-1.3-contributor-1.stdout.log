{"type":"tool_use","timestamp":1793464102371,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c9fe260010btbx2WdV1bBrE","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c9ced3001FSQrh4pDtbjPbW","type":"tool","id":"call_01a192c9fde27316a65556fdaaf569ac","tool":"write","state":{"status":"completed","input":{"content":"/// Host invite panel tests: mint, pairing code, expiry, list + revoke.\n///\n/// Exercises the REAL panel + invite/device clients over fake callable\n/// invokers (network boundary only): validation, QR payload shape, the\n/// expiry ticker, BACK routing, and the label-only host list with its\n/// confirm-then-revoke flow.\nlibrary;\n\nimport 'dart:async';\nimport 'dart:convert';\n\nimport 'package:core_foundation/core_foundation.dart';\nimport 'package:core_ui/core_ui.dart';\nimport 'package:flutter/material.dart';\nimport 'package:flutter/services.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:qr_flutter/qr_flutter.dart';\nimport 'package:testing_toolkit/testing_toolkit.dart';\nimport 'package:tv_app/src/wall/guest_codes.dart';\nimport 'package:tv_app/src/wall/host_code_panel.dart';\nimport 'package:tv_app/src/wall/host_codes.dart';\n\nconst String _party = 'party-1';\nconst String _channel = 'cctv';\nconst String _tv = 'tv-abc';\nconst String _token = 'hi-0123456789abcdef0123456789abcdef01';\n\nMap<String, Object?> inviteResponse({\n  String partyId = _party,\n  String channelId = _channel,\n  String inviteToken = _token,\n  Object? pairingCode = '123456',\n  String? expiresAt,\n}) {\n  final Map<String, Object?> map = <String, Object?>{\n    'partyId': partyId,\n    'channelId': channelId,\n    'inviteToken': inviteToken,\n    'expiresAt':\n        expiresAt ?? DateTime.utc(2030, 1, 1).toIso8601String(),\n  };\n  if (pairingCode is! _Absent) {\n    map['pairingCode'] = pairingCode as Object?;\n  }\n  return map;\n}\n\nclass _Absent {\n  const _Absent();\n}\n\nHostInviteClient inviteClient(\n  Map<String, Object?> response, {\n  List<Map<String, Object?>>? seenPayloads,\n  Future<Map<String, Object?>> Function()? next,\n  int callsBeforeNext = 0,\n}) {\n  int calls = 0;\n  return HostInviteClient(\n    invoker: (String name, Map<String, Object?> payload) async {\n      expect(name, 'createHostInvite');\n      seenPayloads?.add(Map<String, Object?>.of(payload));\n      calls++;\n      if (next != null && calls > callsBeforeNext) {\n        return next();\n      }\n      return response;\n    },\n    partyId: _party,\n    deviceId: _tv,\n    channelId: _channel,\n  );\n}\n\nMap<String, Object?> hostListingResponse({\n  List<Object?> devices = const <Object?>[],\n}) => <String, Object?>{\n  'partyId': _party,\n  'channelId': _channel,\n  'tvDeviceId': _tv,\n  'devices': devices,\n};\n\nMap<String, Object?> hostRow(String id, String label) => <String, Object?>{\n  'deviceId': id,\n  'label': label,\n  'role': 'host',\n  'status': 'active',\n};\n\n/// Fake host-management invoker: serves [devices] for `listPartyDevices`\n/// and records `revokeHostDevice` calls, removing the target on success.\nfinal class FakeHostDeviceInvoker {\n  FakeHostDeviceInvoker(this.devices);\n\n  List<Map<String, Object?>> devices;\n  final List<Map<String, Object?>> seenPayloads = <Map<String, Object?>>[];\n  final List<String> revoked = <String>[];\n  Object? revokeFailure;\n\n  Future<Map<String, Object?>> call(\n    String name,\n    Map<String, Object?> payload,\n  ) async {\n    seenPayloads.add(<String, Object?>{'call': name, ...payload});\n    if (name == 'listPartyDevices') {\n      return hostListingResponse(\n        devices: <Object?>[\n          for (final Map<String, Object?> d in devices)\n            Map<String, Object?>.of(d),\n        ],\n      );\n    }\n    if (name == 'revokeHostDevice') {\n      final Object? failure = revokeFailure;\n      if (failure != null) {\n        throw failure;\n      }\n      final String target = payload['targetDeviceId'] as String;\n      revoked.add(target);\n      devices = <Map<String, Object?>>[\n        for (final Map<String, Object?> d in devices)\n          if (d['deviceId'] != target) d,\n      ];\n      return <String, Object?>{'revokedDeviceId': target};\n    }\n    throw StateError('unexpected callable $name');\n  }\n}\n\nHostDeviceClient deviceClient(FakeHostDeviceInvoker fake) => HostDeviceClient(\n  invoker: fake.call,\n  partyId: _party,\n  deviceId: _tv,\n  channelId: _channel,\n);\n\nFuture<void> pumpPanel(\n  WidgetTester tester,\n  HostInviteClient client, {\n  HostDeviceClient? devicesClient,\n  VoidCallback? onBack,\n  VoidCallback? onClose,\n  FocusNode? primaryFocusNode,\n  Clock clock = const SystemClock(),\n}) async {\n  await tester.pumpWidget(\n    MaterialApp(\n      theme: CctvTheme.dark(),\n      home: Scaffold(\n        body: HostCodePanel(\n          client: client,\n          devicesClient: devicesClient,\n          onBack: onBack,\n          onClose: onClose ?? () {},\n          primaryFocusNode: primaryFocusNode,\n          clock: clock,\n        ),\n      ),\n    ),\n  );\n}\n\nFuture<void> disposePanel(WidgetTester tester) async {\n  await tester.pumpWidget(const SizedBox.shrink());\n  await tester.pump();\n}\n\nString qrDataOf(WidgetTester tester) {\n  final QrImageView qr = tester.widget<QrImageView>(\n    find.byKey(kHostCodeQrKey),\n  );\n  return qr.semanticsLabel;\n}\n\nfinal class _FakeClock implements Clock {\n  _FakeClock(this.current);\n  DateTime current;\n  @override\n  DateTime now() => current;\n}\n\nvoid main() {\n  group('buildHostJoinPayload', () {\n    test('carries the pairing code alongside the invite capability', () {\n      final String payload = buildHostJoinPayload(\n        partyId: _party,\n        channelId: _channel,\n        inviteToken: _token,\n        pairingCode: '123456',\n      );\n      final Map<String, Object?> decoded = Map<String, Object?>.from(\n        jsonDecode(payload) as Map,\n      );\n      expect(decoded, <String, Object?>{\n        'partyId': _party,\n        'channelId': _channel,\n        'inviteToken': _token,\n        'role': 'host',\n        'pairingCode': '123456',\n      });\n      expect(payload.contains(_tv), isFalse);\n      expect(payload.contains('deviceId'), isFalse);\n    });\n\n    test('rejects malformed invite tokens and pairing codes', () {\n      expect(\n        () => buildHostJoinPayload(\n          partyId: 'p',\n          channelId: 'c',\n          inviteToken: '123456',\n        ),\n        throwsArgumentError,\n      );\n      expect(\n        () => buildHostJoinPayload(\n          partyId: 'p',\n          channelId: 'c',\n          inviteToken: _token,\n          pairingCode: '12345',\n        ),\n        throwsArgumentError,\n      );\n      expect(\n        () => buildHostJoinPayload(\n          partyId: 'p',\n          channelId: 'c',\n          inviteToken: _token,\n          pairingCode: 'abcdef',\n        ),\n        throwsArgumentError,\n      );\n    });\n  });\n\n  group('HostInvite.fromResponse', () {\n    test('parses the pairing code with the invite scope', () {\n      final HostInvite invite = HostInvite.fromResponse(\n        inviteResponse(),\n        expectedPartyId: _party,\n        expectedChannelId: _channel,\n      );\n      expect(invite.partyId, _party);\n      expect(invite.inviteToken, _token);\n      expect(invite.pairingCode, '123456');\n    });\n\n    test('rejects missing or malformed pairing codes', () {\n      Future<void> expectBad(Map<String, Object?> response) async {\n        expect(\n          () => HostInvite.fromResponse(\n            response,\n            expectedPartyId: _party,\n            expectedChannelId: _channel,\n          ),\n          throwsA(isA<HostInviteException>()),\n        );\n      }\n\n      await expectBad(inviteResponse(pairingCode: const _Absent()));\n      await expectBad(inviteResponse(pairingCode: null));\n      await expectBad(inviteResponse(pairingCode: '12345'));\n      await expectBad(inviteResponse(pairingCode: 'abcdef'));\n      await expectBad(inviteResponse(pairingCode: 123456));\n      await expectBad(inviteResponse(inviteToken: '123456'));\n      await expectBad(inviteResponse(partyId: 'other-party'));\n    });\n  });\n\n  group('HostCodePanel widget', () {\n    testWidgets('mint success shows one QR + pairing code, refreshed', (\n      WidgetTester tester,\n    ) async {\n      int mints = 0;\n      final HostInviteClient client = HostInviteClient(\n        invoker: (_, __) async {\n          mints++;\n          return inviteResponse(pairingCode: '11111$mints');\n        },\n        partyId: _party,\n        deviceId: _tv,\n        channelId: _channel,\n      );\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\n        <Map<String, Object?>>[],\n      );\n      await pumpPanel(\n        tester,\n        client,\n        devicesClient: deviceClient(fakeDevices),\n        onBack: () {},\n      );\n      await tester.pump();\n      await tester.pump();\n\n      expect(find.text('HOST QR'), findsOneWidget);\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\n      // The pairing code is shown next to the QR and travels in it.\n      expect(find.byKey(kHostPairingCodeKey), findsOneWidget);\n      expect(find.text('111111'), findsOneWidget);\n      final Map<String, Object?> decoded = Map<String, Object?>.from(\n        jsonDecode(qrDataOf(tester)) as Map,\n      );\n      expect(decoded['role'], 'host');\n      expect(decoded['pairingCode'], '111111');\n      expect(decoded.containsKey('deviceId'), isFalse);\n      expect(find.byKey(kHostCodeRefreshKey), findsOneWidget);\n\n      // REFRESH re-mints: the pairing code refreshes with the invite.\n      await tester.tap(find.byKey(kHostCodeRefreshKey));\n      await tester.pump();\n      await tester.pump();\n      expect(mints, 2);\n      expect(find.text('111112'), findsOneWidget);\n      expect(find.text('111111'), findsNothing);\n      final Map<String, Object?> refreshed = Map<String, Object?>.from(\n        jsonDecode(qrDataOf(tester)) as Map,\n      );\n      expect(refreshed['pairingCode'], '111112');\n      await disposePanel(tester);\n    });\n\n    testWidgets('malformed mint shows error with no QR and no code', (\n      WidgetTester tester,\n    ) async {\n      final HostInviteClient client = inviteClient(\n        inviteResponse(pairingCode: const _Absent()),\n      );\n      await pumpPanel(tester, client);\n      await tester.pump();\n      await tester.pump();\n      expect(find.byKey(kHostCodeErrorKey), findsOneWidget);\n      expect(find.textContaining('pairing'), findsOneWidget);\n      expect(find.byType(QrImageView), findsNothing);\n      expect(find.byKey(kHostPairingCodeKey), findsNothing);\n      await disposePanel(tester);\n    });\n\n    testWidgets('loading shows no fabricated QR or code', (\n      WidgetTester tester,\n    ) async {\n      final Completer<Map<String, Object?>> gate =\n          Completer<Map<String, Object?>>();\n      final HostInviteClient slow = HostInviteClient(\n        invoker: (_, __) => gate.future,\n        partyId: _party,\n        deviceId: _tv,\n        channelId: _channel,\n      );\n      await pumpPanel(tester, slow);\n      await tester.pump();\n      expect(find.byKey(kHostCodeLoadingKey), findsOneWidget);\n      expect(find.byType(QrImageView), findsNothing);\n      expect(find.byKey(kHostPairingCodeKey), findsNothing);\n      gate.complete(inviteResponse());\n      await tester.pump();\n      await tester.pump();\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\n      expect(find.byKey(kHostPairingCodeKey), findsOneWidget);\n      await disposePanel(tester);\n    });\n\n    testWidgets('expiry ticker hides QR + code until refresh', (\n      WidgetTester tester,\n    ) async {\n      final _FakeClock clock = _FakeClock(DateTime.utc(2026, 10, 31, 20));\n      int mints = 0;\n      final HostInviteClient client = HostInviteClient(\n        invoker: (_, __) async {\n          mints++;\n          return inviteResponse(\n            pairingCode: '22222$mints',\n            expiresAt: clock\n                .now()\n                .add(const Duration(seconds: 2))\n                .toIso8601String(),\n          );\n        },\n        partyId: _party,\n        deviceId: _tv,\n        channelId: _channel,\n      );\n      await pumpPanel(tester, client, clock: clock);\n      await tester.pump();\n      await tester.pump();\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\n      expect(find.text('222221'), findsOneWidget);\n\n      // The invite lapses: the ticker hides the stale capability + code.\n      clock.current = clock.current.add(const Duration(seconds: 5));\n      await tester.pump(const Duration(seconds: 2));\n      await tester.pump();\n      expect(find.byType(QrImageView), findsNothing);\n      expect(find.byKey(kHostPairingCodeKey), findsNothing);\n      expect(find.byKey(kHostCodeExpiryKey), findsOneWidget);\n\n      // REFRESH mints a fresh invite with a fresh pairing code.\n      await tester.tap(find.byKey(kHostCodeRefreshKey));\n      await tester.pump();\n      await tester.pump();\n      expect(mints, 2);\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\n      expect(find.text('222222'), findsOneWidget);\n      await disposePanel(tester);\n    });\n\n    testWidgets('D-pad back/close keys invoke callbacks', (\n      WidgetTester tester,\n    ) async {\n      bool backed = false;\n      bool closed = false;\n      final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n      addTearDown(primary.dispose);\n      await pumpPanel(\n        tester,\n        inviteClient(inviteResponse()),\n        onBack: () => backed = true,\n        onClose: () => closed = true,\n        primaryFocusNode: primary,\n      );\n      await tester.pump();\n      await tester.pump();\n      primary.requestFocus();\n      await tester.pump();\n      await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n      await tester.pump();\n      expect(backed, isTrue);\n      expect(closed, isFalse);\n      await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n      await tester.pump();\n      expect(closed, isTrue);\n      primary.unfocus();\n      await disposePanel(tester);\n    });\n\n    testWidgets('escape falls back to onClose when no onBack', (\n      WidgetTester tester,\n    ) async {\n      bool closed = false;\n      final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n      addTearDown(primary.dispose);\n      await pumpPanel(\n        tester,\n        inviteClient(inviteResponse()),\n        onClose: () => closed = true,\n        primaryFocusNode: primary,\n      );\n      await tester.pump();\n      await tester.pump();\n      expect(find.byKey(kHostCodeBackKey), findsNothing);\n      primary.requestFocus();\n      await tester.pump();\n      await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n      await tester.pump();\n      expect(closed, isTrue);\n      primary.unfocus();\n      await disposePanel(tester);\n    });\n\n    testWidgets('host list shows labels only, never device ids', (\n      WidgetTester tester,\n    ) async {\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\n        <Map<String, Object?>>[\n          hostRow('p-host-aaaaaaaa', 'Phone A'),\n          hostRow('p-host-bbbbbbbb', 'Phone B'),\n          <String, Object?>{\n            'deviceId': 'g-1',\n            'label': 'Guest 1',\n            'role': 'guest',\n            'status': 'active',\n          },\n        ],\n      );\n      await pumpPanel(\n        tester,\n        inviteClient(inviteResponse()),\n        devicesClient: deviceClient(fakeDevices),\n      );\n      await tester.pump();\n      await tester.pump();\n      await tester.pump();\n\n      expect(find.byKey(kHostDeviceListKey), findsOneWidget);\n      expect(find.text('Phone A'), findsOneWidget);\n      expect(find.text('Phone B'), findsOneWidget);\n      // Guest rows never leak into the host list, and device ids are never\n      // rendered anywhere in the panel.\n      expect(find.text('Guest 1'), findsNothing);\n      for (final String id in <String>[\n        'p-host-aaaaaaaa',\n        'p-host-bbbbbbbb',\n        'g-1',\n        _tv,\n      ]) {\n        expect(find.text(id), findsNothing, reason: 'id $id rendered');\n        expect(\n          find.textContaining(id),\n          findsNothing,\n          reason: 'id $id rendered as substring',\n        );\n      }\n      await disposePanel(tester);\n    });\n\n    testWidgets('revoke confirms, then removes only after success', (\n      WidgetTester tester,\n    ) async {\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\n        <Map<String, Object?>>[\n          hostRow('p-host-aaaaaaaa', 'Phone A'),\n          hostRow('p-host-bbbbbbbb', 'Phone B'),\n        ],\n      );\n      await pumpPanel(\n        tester,\n        inviteClient(inviteResponse()),\n        devicesClient: deviceClient(fakeDevices),\n      );\n      await tester.pump();\n      await tester.pump();\n      await tester.pump();\n\n      // CANCEL keeps the row and issues no revoke.\n      await tester.tap(HostCodePanel.revokeKeyFor('Phone A'));\n      await tester.pumpAndSettle();\n      expect(find.byKey(kHostRevokeDialogKey), findsOneWidget);\n      expect(\n        find.textContaining('Phone A'),\n        findsWidgets,\n        reason: 'dialog names the host label',\n      );\n      expect(find.textContaining('previews'), findsOneWidget);\n      expect(find.textContaining('manifest'), findsOneWidget);\n      await tester.tap(find.byKey(kHostRevokeCancelKey));\n      await tester.pumpAndSettle();\n      expect(find.byKey(kHostRevokeDialogKey), findsNothing);\n      expect(fakeDevices.revoked, isEmpty);\n      expect(find.text('Phone A'), findsOneWidget);\n\n      // Confirm revokes the opaque id and reconciles from the server list.\n      await tester.tap(HostCodePanel.revokeKeyFor('Phone A'));\n      await tester.pumpAndSettle();\n      await tester.tap(find.byKey(kHostRevokeConfirmKey));\n      await tester.pump();\n      await tester.pump();\n      await tester.pump();\n      expect(fakeDevices.revoked, <String>['p-host-aaaaaaaa']);\n      final Map<String, Object?> revokeCall = fakeDevices.seenPayloads\n          .lastWhere((Map<String, Object?> p) => p['call'] == 'revokeHostDevice');\n      expect(revokeCall['targetDeviceId'], 'p-host-aaaaaaaa');\n      expect(revokeCall['partyId'], _party);\n      expect(find.text('Phone A'), findsNothing);\n      expect(find.text('Phone B'), findsOneWidget);\n      expect(find.byKey(kHostDeviceErrorKey), findsNothing);\n      await disposePanel(tester);\n    });\n\n    testWidgets('revoke failure keeps the row with an inline error', (\n      WidgetTester tester,\n    ) async {\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\n        <Map<String, Object?>>[hostRow('p-host-aaaaaaaa', 'Phone A')],\n      );\n      fakeDevices.revokeFailure = const HostDeviceException('denied');\n      await pumpPanel(\n        tester,\n        inviteClient(inviteResponse()),\n        devicesClient: deviceClient(fakeDevices),\n      );\n      await tester.pump();\n      await tester.pump();\n      await tester.pump();\n\n      await tester.tap(HostCodePanel.revokeKeyFor('Phone A'));\n      await tester.pumpAndSettle();\n      await tester.tap(find.byKey(kHostRevokeConfirmKey));\n      await tester.pump();\n      await tester.pump();\n      // Selection kept until authoritative success: the row stays retryable.\n      expect(find.text('Phone A'), findsOneWidget);\n      expect(find.byKey(kHostDeviceErrorKey), findsOneWidget);\n      expect(find.textContaining('denied'), findsOneWidget);\n      await disposePanel(tester);\n    });\n\n    testWidgets('no devices client hides the host list section', (\n      WidgetTester tester,\n    ) async {\n      await pumpPanel(tester, inviteClient(inviteResponse()));\n      await tester.pump();\n      await tester.pump();\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\n      expect(find.text('ACTIVE HOSTS'), findsNothing);\n      expect(find.byKey(kHostDeviceListKey), findsNothing);\n      await disposePanel(tester);\n    });\n  });\n}\n","path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/host_code_panel_test.dart"},"output":"Created file successfully: apps/tv_app/test/host_code_panel_test.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/tv_app/test/host_code_panel_test.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c9fde27316a65556fdaaf569ac"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Host invite panel tests: mint, pairing code, expiry, list + revoke.\\n///\\n/// Exercises the REAL panel + invite/device clients over fake callable\\n/// invokers (network boundary only): validation, QR payload shape, the\\n/// expiry ticker, BACK routing, and the label-only host list with its\\n/// confirm-then-revoke flow.\\nlibrary;\\n\\nimport 'dart:async';\\nimport 'dart:convert';\\n\\nimport 'package:core_foundation/core_foundation.dart';\\nimport 'package:core_ui/core_ui.dart';\\nimport 'package:flutter/material.dart';\\nimport 'package:flutter/services.dart';\\nimport 'package:flutter_test/flutter_test.dart';\\nimport 'package:qr_flutter/qr_flutter.dart';\\nimport 'package:testing_toolkit/testing_toolkit.dart';\\nimport 'package:tv_app/src/wall/guest_codes.dart';\\nimport 'package:tv_app/src/wall/host_code_panel.dart';\\nimport 'package:tv_app/src/wall/host_codes.dart';\\n\\nconst String _party = 'party-1';\\nconst String _channel = 'cctv';\\nconst String _tv = 'tv-abc';\\nconst String _token = 'hi-0123456789abcdef0123456789abcdef01';\\n\\nMap<String, Object?> inviteResponse({\\n  String partyId = _party,\\n  String channelId = _channel,\\n  String inviteToken = _token,\\n  Object? pairingCode = '123456',\\n  String? expiresAt,\\n}) {\\n  final Map<String, Object?> map = <String, Object?>{\\n    'partyId': partyId,\\n    'channelId': channelId,\\n    'inviteToken': inviteToken,\\n    'expiresAt':\\n        expiresAt ?? DateTime.utc(2030, 1, 1).toIso8601String(),\\n  };\\n  if (pairingCode is! _Absent) {\\n    map['pairingCode'] = pairingCode as Object?;\\n  }\\n  return map;\\n}\\n\\nclass _Absent {\\n  const _Absent();\\n}\\n\\nHostInviteClient inviteClient(\\n  Map<String, Object?> response, {\\n  List<Map<String, Object?>>? seenPayloads,\\n  Future<Map<String, Object?>> Function()? next,\\n  int callsBeforeNext = 0,\\n}) {\\n  int calls = 0;\\n  return HostInviteClient(\\n    invoker: (String name, Map<String, Object?> payload) async {\\n      expect(name, 'createHostInvite');\\n      seenPayloads?.add(Map<String, Object?>.of(payload));\\n      calls++;\\n      if (next != null && calls > callsBeforeNext) {\\n        return next();\\n      }\\n      return response;\\n    },\\n    partyId: _party,\\n    deviceId: _tv,\\n    channelId: _channel,\\n  );\\n}\\n\\nMap<String, Object?> hostListingResponse({\\n  List<Object?> devices = const <Object?>[],\\n}) => <String, Object?>{\\n  'partyId': _party,\\n  'channelId': _channel,\\n  'tvDeviceId': _tv,\\n  'devices': devices,\\n};\\n\\nMap<String, Object?> hostRow(String id, String label) => <String, Object?>{\\n  'deviceId': id,\\n  'label': label,\\n  'role': 'host',\\n  'status': 'active',\\n};\\n\\n/// Fake host-management invoker: serves [devices] for `listPartyDevices`\\n/// and records `revokeHostDevice` calls, removing the target on success.\\nfinal class FakeHostDeviceInvoker {\\n  FakeHostDeviceInvoker(this.devices);\\n\\n  List<Map<String, Object?>> devices;\\n  final List<Map<String, Object?>> seenPayloads = <Map<String, Object?>>[];\\n  final List<String> revoked = <String>[];\\n  Object? revokeFailure;\\n\\n  Future<Map<String, Object?>> call(\\n    String name,\\n    Map<String, Object?> payload,\\n  ) async {\\n    seenPayloads.add(<String, Object?>{'call': name, ...payload});\\n    if (name == 'listPartyDevices') {\\n      return hostListingResponse(\\n        devices: <Object?>[\\n          for (final Map<String, Object?> d in devices)\\n            Map<String, Object?>.of(d),\\n        ],\\n      );\\n    }\\n    if (name == 'revokeHostDevice') {\\n      final Object? failure = revokeFailure;\\n      if (failure != null) {\\n        throw failure;\\n      }\\n      final String target = payload['targetDeviceId'] as String;\\n      revoked.add(target);\\n      devices = <Map<String, Object?>>[\\n        for (final Map<String, Object?> d in devices)\\n          if (d['deviceId'] != target) d,\\n      ];\\n      return <String, Object?>{'revokedDeviceId': target};\\n    }\\n    throw StateError('unexpected callable $name');\\n  }\\n}\\n\\nHostDeviceClient deviceClient(FakeHostDeviceInvoker fake) => HostDeviceClient(\\n  invoker: fake.call,\\n  partyId: _party,\\n  deviceId: _tv,\\n  channelId: _channel,\\n);\\n\\nFuture<void> pumpPanel(\\n  WidgetTester tester,\\n  HostInviteClient client, {\\n  HostDeviceClient? devicesClient,\\n  VoidCallback? onBack,\\n  VoidCallback? onClose,\\n  FocusNode? primaryFocusNode,\\n  Clock clock = const SystemClock(),\\n}) async {\\n  await tester.pumpWidget(\\n    MaterialApp(\\n      theme: CctvTheme.dark(),\\n      home: Scaffold(\\n        body: HostCodePanel(\\n          client: client,\\n          devicesClient: devicesClient,\\n          onBack: onBack,\\n          onClose: onClose ?? () {},\\n          primaryFocusNode: primaryFocusNode,\\n          clock: clock,\\n        ),\\n      ),\\n    ),\\n  );\\n}\\n\\nFuture<void> disposePanel(WidgetTester tester) async {\\n  await tester.pumpWidget(const SizedBox.shrink());\\n  await tester.pump();\\n}\\n\\nString qrDataOf(WidgetTester tester) {\\n  final QrImageView qr = tester.widget<QrImageView>(\\n    find.byKey(kHostCodeQrKey),\\n  );\\n  return qr.semanticsLabel;\\n}\\n\\nfinal class _FakeClock implements Clock {\\n  _FakeClock(this.current);\\n  DateTime current;\\n  @override\\n  DateTime now() => current;\\n}\\n\\nvoid main() {\\n  group('buildHostJoinPayload', () {\\n    test('carries the pairing code alongside the invite capability', () {\\n      final String payload = buildHostJoinPayload(\\n        partyId: _party,\\n        channelId: _channel,\\n        inviteToken: _token,\\n        pairingCode: '123456',\\n      );\\n      final Map<String, Object?> decoded = Map<String, Object?>.from(\\n        jsonDecode(payload) as Map,\\n      );\\n      expect(decoded, <String, Object?>{\\n        'partyId': _party,\\n        'channelId': _channel,\\n        'inviteToken': _token,\\n        'role': 'host',\\n        'pairingCode': '123456',\\n      });\\n      expect(payload.contains(_tv), isFalse);\\n      expect(payload.contains('deviceId'), isFalse);\\n    });\\n\\n    test('rejects malformed invite tokens and pairing codes', () {\\n      expect(\\n        () => buildHostJoinPayload(\\n          partyId: 'p',\\n          channelId: 'c',\\n          inviteToken: '123456',\\n        ),\\n        throwsArgumentError,\\n      );\\n      expect(\\n        () => buildHostJoinPayload(\\n          partyId: 'p',\\n          channelId: 'c',\\n          inviteToken: _token,\\n          pairingCode: '12345',\\n        ),\\n        throwsArgumentError,\\n      );\\n      expect(\\n        () => buildHostJoinPayload(\\n          partyId: 'p',\\n          channelId: 'c',\\n          inviteToken: _token,\\n          pairingCode: 'abcdef',\\n        ),\\n        throwsArgumentError,\\n      );\\n    });\\n  });\\n\\n  group('HostInvite.fromResponse', () {\\n    test('parses the pairing code with the invite scope', () {\\n      final HostInvite invite = HostInvite.fromResponse(\\n        inviteResponse(),\\n        expectedPartyId: _party,\\n        expectedChannelId: _channel,\\n      );\\n      expect(invite.partyId, _party);\\n      expect(invite.inviteToken, _token);\\n      expect(invite.pairingCode, '123456');\\n    });\\n\\n    test('rejects missing or malformed pairing codes', () {\\n      Future<void> expectBad(Map<String, Object?> response) async {\\n        expect(\\n          () => HostInvite.fromResponse(\\n            response,\\n            expectedPartyId: _party,\\n            expectedChannelId: _channel,\\n          ),\\n          throwsA(isA<HostInviteException>()),\\n        );\\n      }\\n\\n      await expectBad(inviteResponse(pairingCode: const _Absent()));\\n      await expectBad(inviteResponse(pairingCode: null));\\n      await expectBad(inviteResponse(pairingCode: '12345'));\\n      await expectBad(inviteResponse(pairingCode: 'abcdef'));\\n      await expectBad(inviteResponse(pairingCode: 123456));\\n      await expectBad(inviteResponse(inviteToken: '123456'));\\n      await expectBad(inviteResponse(partyId: 'other-party'));\\n    });\\n  });\\n\\n  group('HostCodePanel widget', () {\\n    testWidgets('mint success shows one QR + pairing code, refreshed', (\\n      WidgetTester tester,\\n    ) async {\\n      int mints = 0;\\n      final HostInviteClient client = HostInviteClient(\\n        invoker: (_, __) async {\\n          mints++;\\n          return inviteResponse(pairingCode: '11111$mints');\\n        },\\n        partyId: _party,\\n        deviceId: _tv,\\n        channelId: _channel,\\n      );\\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\\n        <Map<String, Object?>>[],\\n      );\\n      await pumpPanel(\\n        tester,\\n        client,\\n        devicesClient: deviceClient(fakeDevices),\\n        onBack: () {},\\n      );\\n      await tester.pump();\\n      await tester.pump();\\n\\n      expect(find.text('HOST QR'), findsOneWidget);\\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\\n      // The pairing code is shown next to the QR and travels in it.\\n      expect(find.byKey(kHostPairingCodeKey), findsOneWidget);\\n      expect(find.text('111111'), findsOneWidget);\\n      final Map<String, Object?> decoded = Map<String, Object?>.from(\\n        jsonDecode(qrDataOf(tester)) as Map,\\n      );\\n      expect(decoded['role'], 'host');\\n      expect(decoded['pairingCode'], '111111');\\n      expect(decoded.containsKey('deviceId'), isFalse);\\n      expect(find.byKey(kHostCodeRefreshKey), findsOneWidget);\\n\\n      // REFRESH re-mints: the pairing code refreshes with the invite.\\n      await tester.tap(find.byKey(kHostCodeRefreshKey));\\n      await tester.pump();\\n      await tester.pump();\\n      expect(mints, 2);\\n      expect(find.text('111112'), findsOneWidget);\\n      expect(find.text('111111'), findsNothing);\\n      final Map<String, Object?> refreshed = Map<String, Object?>.from(\\n        jsonDecode(qrDataOf(tester)) as Map,\\n      );\\n      expect(refreshed['pairingCode'], '111112');\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('malformed mint shows error with no QR and no code', (\\n      WidgetTester tester,\\n    ) async {\\n      final HostInviteClient client = inviteClient(\\n        inviteResponse(pairingCode: const _Absent()),\\n      );\\n      await pumpPanel(tester, client);\\n      await tester.pump();\\n      await tester.pump();\\n      expect(find.byKey(kHostCodeErrorKey), findsOneWidget);\\n      expect(find.textContaining('pairing'), findsOneWidget);\\n      expect(find.byType(QrImageView), findsNothing);\\n      expect(find.byKey(kHostPairingCodeKey), findsNothing);\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('loading shows no fabricated QR or code', (\\n      WidgetTester tester,\\n    ) async {\\n      final Completer<Map<String, Object?>> gate =\\n          Completer<Map<String, Object?>>();\\n      final HostInviteClient slow = HostInviteClient(\\n        invoker: (_, __) => gate.future,\\n        partyId: _party,\\n        deviceId: _tv,\\n        channelId: _channel,\\n      );\\n      await pumpPanel(tester, slow);\\n      await tester.pump();\\n      expect(find.byKey(kHostCodeLoadingKey), findsOneWidget);\\n      expect(find.byType(QrImageView), findsNothing);\\n      expect(find.byKey(kHostPairingCodeKey), findsNothing);\\n      gate.complete(inviteResponse());\\n      await tester.pump();\\n      await tester.pump();\\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\\n      expect(find.byKey(kHostPairingCodeKey), findsOneWidget);\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('expiry ticker hides QR + code until refresh', (\\n      WidgetTester tester,\\n    ) async {\\n      final _FakeClock clock = _FakeClock(DateTime.utc(2026, 10, 31, 20));\\n      int mints = 0;\\n      final HostInviteClient client = HostInviteClient(\\n        invoker: (_, __) async {\\n          mints++;\\n          return inviteResponse(\\n            pairingCode: '22222$mints',\\n            expiresAt: clock\\n                .now()\\n                .add(const Duration(seconds: 2))\\n                .toIso8601String(),\\n          );\\n        },\\n        partyId: _party,\\n        deviceId: _tv,\\n        channelId: _channel,\\n      );\\n      await pumpPanel(tester, client, clock: clock);\\n      await tester.pump();\\n      await tester.pump();\\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\\n      expect(find.text('222221'), findsOneWidget);\\n\\n      // The invite lapses: the ticker hides the stale capability + code.\\n      clock.current = clock.current.add(const Duration(seconds: 5));\\n      await tester.pump(const Duration(seconds: 2));\\n      await tester.pump();\\n      expect(find.byType(QrImageView), findsNothing);\\n      expect(find.byKey(kHostPairingCodeKey), findsNothing);\\n      expect(find.byKey(kHostCodeExpiryKey), findsOneWidget);\\n\\n      // REFRESH mints a fresh invite with a fresh pairing code.\\n      await tester.tap(find.byKey(kHostCodeRefreshKey));\\n      await tester.pump();\\n      await tester.pump();\\n      expect(mints, 2);\\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\\n      expect(find.text('222222'), findsOneWidget);\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('D-pad back/close keys invoke callbacks', (\\n      WidgetTester tester,\\n    ) async {\\n      bool backed = false;\\n      bool closed = false;\\n      final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\\n      addTearDown(primary.dispose);\\n      await pumpPanel(\\n        tester,\\n        inviteClient(inviteResponse()),\\n        onBack: () => backed = true,\\n        onClose: () => closed = true,\\n        primaryFocusNode: primary,\\n      );\\n      await tester.pump();\\n      await tester.pump();\\n      primary.requestFocus();\\n      await tester.pump();\\n      await tester.sendKeyEvent(LogicalKeyboardKey.escape);\\n      await tester.pump();\\n      expect(backed, isTrue);\\n      expect(closed, isFalse);\\n      await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\\n      await tester.pump();\\n      expect(closed, isTrue);\\n      primary.unfocus();\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('escape falls back to onClose when no onBack', (\\n      WidgetTester tester,\\n    ) async {\\n      bool closed = false;\\n      final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\\n      addTearDown(primary.dispose);\\n      await pumpPanel(\\n        tester,\\n        inviteClient(inviteResponse()),\\n        onClose: () => closed = true,\\n        primaryFocusNode: primary,\\n      );\\n      await tester.pump();\\n      await tester.pump();\\n      expect(find.byKey(kHostCodeBackKey), findsNothing);\\n      primary.requestFocus();\\n      await tester.pump();\\n      await tester.sendKeyEvent(LogicalKeyboardKey.escape);\\n      await tester.pump();\\n      expect(closed, isTrue);\\n      primary.unfocus();\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('host list shows labels only, never device ids', (\\n      WidgetTester tester,\\n    ) async {\\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\\n        <Map<String, Object?>>[\\n          hostRow('p-host-aaaaaaaa', 'Phone A'),\\n          hostRow('p-host-bbbbbbbb', 'Phone B'),\\n          <String, Object?>{\\n            'deviceId': 'g-1',\\n            'label': 'Guest 1',\\n            'role': 'guest',\\n            'status': 'active',\\n          },\\n        ],\\n      );\\n      await pumpPanel(\\n        tester,\\n        inviteClient(inviteResponse()),\\n        devicesClient: deviceClient(fakeDevices),\\n      );\\n      await tester.pump();\\n      await tester.pump();\\n      await tester.pump();\\n\\n      expect(find.byKey(kHostDeviceListKey), findsOneWidget);\\n      expect(find.text('Phone A'), findsOneWidget);\\n      expect(find.text('Phone B'), findsOneWidget);\\n      // Guest rows never leak into the host list, and device ids are never\\n      // rendered anywhere in the panel.\\n      expect(find.text('Guest 1'), findsNothing);\\n      for (final String id in <String>[\\n        'p-host-aaaaaaaa',\\n        'p-host-bbbbbbbb',\\n        'g-1',\\n        _tv,\\n      ]) {\\n        expect(find.text(id), findsNothing, reason: 'id $id rendered');\\n        expect(\\n          find.textContaining(id),\\n          findsNothing,\\n          reason: 'id $id rendered as substring',\\n        );\\n      }\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('revoke confirms, then removes only after success', (\\n      WidgetTester tester,\\n    ) async {\\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\\n        <Map<String, Object?>>[\\n          hostRow('p-host-aaaaaaaa', 'Phone A'),\\n          hostRow('p-host-bbbbbbbb', 'Phone B'),\\n        ],\\n      );\\n      await pumpPanel(\\n        tester,\\n        inviteClient(inviteResponse()),\\n        devicesClient: deviceClient(fakeDevices),\\n      );\\n      await tester.pump();\\n      await tester.pump();\\n      await tester.pump();\\n\\n      // CANCEL keeps the row and issues no revoke.\\n      await tester.tap(HostCodePanel.revokeKeyFor('Phone A'));\\n      await tester.pumpAndSettle();\\n      expect(find.byKey(kHostRevokeDialogKey), findsOneWidget);\\n      expect(\\n        find.textContaining('Phone A'),\\n        findsWidgets,\\n        reason: 'dialog names the host label',\\n      );\\n      expect(find.textContaining('previews'), findsOneWidget);\\n      expect(find.textContaining('manifest'), findsOneWidget);\\n      await tester.tap(find.byKey(kHostRevokeCancelKey));\\n      await tester.pumpAndSettle();\\n      expect(find.byKey(kHostRevokeDialogKey), findsNothing);\\n      expect(fakeDevices.revoked, isEmpty);\\n      expect(find.text('Phone A'), findsOneWidget);\\n\\n      // Confirm revokes the opaque id and reconciles from the server list.\\n      await tester.tap(HostCodePanel.revokeKeyFor('Phone A'));\\n      await tester.pumpAndSettle();\\n      await tester.tap(find.byKey(kHostRevokeConfirmKey));\\n      await tester.pump();\\n      await tester.pump();\\n      await tester.pump();\\n      expect(fakeDevices.revoked, <String>['p-host-aaaaaaaa']);\\n      final Map<String, Object?> revokeCall = fakeDevices.seenPayloads\\n          .lastWhere((Map<String, Object?> p) => p['call'] == 'revokeHostDevice');\\n      expect(revokeCall['targetDeviceId'], 'p-host-aaaaaaaa');\\n      expect(revokeCall['partyId'], _party);\\n      expect(find.text('Phone A'), findsNothing);\\n      expect(find.text('Phone B'), findsOneWidget);\\n      expect(find.byKey(kHostDeviceErrorKey), findsNothing);\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('revoke failure keeps the row with an inline error', (\\n      WidgetTester tester,\\n    ) async {\\n      final FakeHostDeviceInvoker fakeDevices = FakeHostDeviceInvoker(\\n        <Map<String, Object?>>[hostRow('p-host-aaaaaaaa', 'Phone A')],\\n      );\\n      fakeDevices.revokeFailure = const HostDeviceException('denied');\\n      await pumpPanel(\\n        tester,\\n        inviteClient(inviteResponse()),\\n        devicesClient: deviceClient(fakeDevices),\\n      );\\n      await tester.pump();\\n      await tester.pump();\\n      await tester.pump();\\n\\n      await tester.tap(HostCodePanel.revokeKeyFor('Phone A'));\\n      await tester.pumpAndSettle();\\n      await tester.tap(find.byKey(kHostRevokeConfirmKey));\\n      await tester.pump();\\n      await tester.pump();\\n      // Selection kept until authoritative success: the row stays retryable.\\n      expect(find.text('Phone A'), findsOneWidget);\\n      expect(find.byKey(kHostDeviceErrorKey), findsOneWidget);\\n      expect(find.textContaining('denied'), findsOneWidget);\\n      await disposePanel(tester);\\n    });\\n\\n    testWidgets('no devices client hides the host list section', (\\n      WidgetTester tester,\\n    ) async {\\n      await pumpPanel(tester, inviteClient(inviteResponse()));\\n      await tester.pump();\\n      await tester.pump();\\n      expect(find.byKey(kHostCodeQrKey), findsOneWidget);\\n      expect(find.text('ACTIVE HOSTS'), findsNothing);\\n      expect(find.byKey(kHostDeviceListKey), findsNothing);\\n      await disposePanel(tester);\\n    });\\n  });\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/host_code_panel_test.dart\"}"},"time":{"start":1793464073766,"end":1793464102371}}}}
