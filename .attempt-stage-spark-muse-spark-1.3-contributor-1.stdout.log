{"type":"tool_use","timestamp":1793464372983,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192ce8eca001CTHshn0NoqVTs2","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192ce895f001r8Ku9VumwHHWL2","type":"tool","id":"call_01a192ce8c4776edbff04eff08bb2691","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart, lines 1-117\n1: // On-device camera join regression (physical Pixel, manual run).\n2: //\n3: // Run (from apps/companion_app, release + live defines, permission\n4: // pre-granted so no OS dialog blocks the run):\n5: //\n6: //   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n7: //   flutter test integration_test/camera_join_scan_device_test.dart \\\n8: //     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n9: //     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n10: //     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\n11: //     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\n12: //\n13: // What it proves on hardware: the shipped join screen pushes the real\n14: // QrScanScreen and the native camera preview initializes (no black stall\n15: // after the permission grant), cancellation returns to a usable join form,\n16: // and the type-or-paste path still joins. Aiming the camera at a real\n17: // party QR and reaching the lineup is covered by the manual written\n18: // procedure in docs/COMPANION-CAMERA-PROOF.md (human aims the camera;\n19: // automation cannot point the lens).\n20: //\n21: // Live paste-join runs only when DEVICE_PARTY_ID/DEVICE_CHANNEL_ID are\n22: // supplied; otherwise the test is skipped with a reason (never a vacuous\n23: // pass). It registers one guest device against the seeded rehearsal party\n24: // (same cost class as the typed manual join in rehearsal NOTES — no\n25: // generation, no spend).\n26: //\n27: // The scanner test needs physical camera hardware, so it stays skipped\n28: // unless explicitly opted in for an on-device run:\n29: //\n30: //   flutter test integration_test/camera_join_scan_device_test.dart \\\n31: //     --dart-define=DEVICE_CAMERA=true ...\n32: library;\n33: \n34: import 'package:companion_app/src/companion_app.dart';\n35: import 'package:companion_app/src/join/qr_scan_screen.dart';\n36: import 'package:companion_app/src/ui/host_entry_screen.dart';\n37: import 'package:companion_app/src/ui/join_screen.dart';\n38: import 'package:flutter_test/flutter_test.dart';\n39: import 'package:integration_test/integration_test.dart';\n40: import 'package:shared_preferences/shared_preferences.dart';\n41: \n42: const String _devicePartyId = String.fromEnvironment('DEVICE_PARTY_ID');\n43: const String _deviceChannelId = String.fromEnvironment('DEVICE_CHANNEL_ID');\n44: const bool _deviceCamera = bool.fromEnvironment('DEVICE_CAMERA');\n45: \n46: /// Opt-in gate for tests that need physical hardware: skipped with a\n47: /// reason everywhere else, so a missing device never reads as a pass.\n48: Object _hardwareSkip(String what) => _deviceCamera\n49:     ? false\n50:     : 'Requires physical $what; rerun with --dart-define=DEVICE_CAMERA=true '\n51:           'on a camera-capable device (see docs/COMPANION-CAMERA-PROOF.md).';\n52: \n53: Future<void> _settle(WidgetTester tester) async {\n54:   for (int i = 0; i < 12; i++) {\n55:     await tester.pump(const Duration(milliseconds: 250));\n56:   }\n57: }\n58: \n59: void main() {\n60:   IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n61: \n62:   testWidgets(\n63:     'device: granted camera opens the live scanner',\n64:     skip: _hardwareSkip('camera hardware'),\n65:     (tester) async {\n66:       SharedPreferences.setMockInitialValues(<String, Object>{});\n67:       await tester.pumpWidget(const CompanionApp());\n68:       await _settle(tester);\n69:       // Host-first boot: take the explicit guest route before scanning.\n70:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n71:       await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\n72:       await _settle(tester);\n73:       expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n74: \n75:       await tester.ensureVisible(find.byKey(JoinScreen.scanKey));\n76:       await tester.pump(const Duration(milliseconds: 250));\n77:       await tester.tap(find.byKey(JoinScreen.scanKey));\n78:       await _settle(tester);\n79: \n80:       // The real scan screen is up (camera preview initializes on device;\n81:       // a post-grant stall would leave the join screen showing instead).\n82:       expect(find.byType(QrScanScreen), findsOneWidget);\n83:       expect(find.byKey(QrScanScreen.scannerKey), findsOneWidget);\n84: \n85:       await tester.tap(find.byKey(QrScanScreen.closeKey));\n86:       await _settle(tester);\n87:       expect(find.byType(QrScanScreen), findsNothing);\n88:       expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n89:     },\n90:   );\n91: \n92:   testWidgets(\n93:     'device: pasted join data joins the seeded party',\n94:     skip: _devicePartyId.isEmpty || _deviceChannelId.isEmpty\n95:         ? 'Pass --dart-define=DEVICE_PARTY_ID=... '\n96:               'DEVICE_CHANNEL_ID=... (see docs/COMPANION-CAMERA-PROOF.md).'\n97:         : _hardwareSkip('device backend access'),\n98:     (tester) async {\n99:       SharedPreferences.setMockInitialValues(<String, Object>{});\n100:       await tester.pumpWidget(const CompanionApp());\n101:       await _settle(tester);\n102:       await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\n103:       await _settle(tester);\n104: \n105:       await tester.enterText(\n106:         find.byKey(JoinScreen.payloadFieldKey),\n107:         '{\"partyId\":\"$_devicePartyId\",\"channelId\":\"$_deviceChannelId\"}',\n108:       );\n109:       await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n110:       await tester.pump(const Duration(milliseconds: 250));\n111:       await tester.tap(find.byKey(JoinScreen.submitKey));\n112:       await _settle(tester);\n113: \n114:       expect(find.textContaining('Manifest version'), findsOneWidget);\n115:     },\n116:   );\n117: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart, lines 1-117\n1: // On-device camera join regression (physical Pixel, manual run).\n2: //\n3: // Run (from apps/companion_app, release + live defines, permission\n4: // pre-granted so no OS dialog blocks the run):\n5: //\n6: //   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n7: //   flutter test integration_test/camera_join_scan_device_test.dart \\\n8: //     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n9: //     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n10: //     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\n11: //     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\n12: //\n13: // What it proves on hardware: the shipped join screen pushes the real\n14: // QrScanScreen and the native camera preview initializes (no black stall\n15: // after the permission grant), cancellation returns to a usable join form,\n16: // and the type-or-paste path still joins. Aiming the camera at a real\n17: // party QR and reaching the lineup is covered by the manual written\n18: // procedure in docs/COMPANION-CAMERA-PROOF.md (human aims the camera;\n19: // automation cannot point the lens).\n20: //\n21: // Live paste-join runs only when DEVICE_PARTY_ID/DEVICE_CHANNEL_ID are\n22: // supplied; otherwise the test is skipped with a reason (never a vacuous\n23: // pass). It registers one guest device against the seeded rehearsal party\n24: // (same cost class as the typed manual 