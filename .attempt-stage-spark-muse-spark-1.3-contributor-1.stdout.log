String status) => switch (status) {\n27:   'queued' => 'Queued',\n28:   'running' => 'Generating',\n29:   'ready' => 'Ready',\n30:   'failed' => 'Failed',\n31:   'deleted' => 'Deleted',\n32:   'expired' => 'Expired',\n33:   _ => status,\n34: };\n35: \n36: final class HostPanelScreen extends StatefulWidget {\n37:   const HostPanelScreen({\n38:     super.key,\n39:     required this.session,\n40:     required this.onLeave,\n41:     required this.onPreview,\n42:     this.onPhoto,\n43:   });\n44: \n45:   final HostSession session;\n46: \n47:   /// Leaves the host session (stops polling, clears identity + catalog).\n48:   final Future<void> Function() onLeave;\n49: \n50:   /// Opens the preview for [seedId] (fresh scoped capability per view).\n51:   final void Function(String seedId) onPreview;\n52: \n53:   /// Opens the optional source-photo flow, when a photo client is wired.\n54:   /// Null hides the entry point.\n55:   final VoidCallback? onPhoto;\n56: \n57:   static const Key listKey = Key('host-panel-list');\n58:   static const Key emptyKey = Key('host-panel-empty');\n59:   static const Key generateSeedKey = Key('host-panel-generate-seed');\n60:   static const Key generateKey = Key('host-panel-generate');\n61:   static const Key retryKey = Key('host-panel-retry');\n62:   static const Key leaveKey = Key('host-panel-leave');\n63:   static const Key messageKey = Key('host-panel-message');\n64:   static Key deleteKey(String seedId) => Key('host-delete-$seedId');\n65:   static Key viewKey(String seedId) => Key('host-view-$seedId');\n66: \n67:   @override\n68:   State<HostPanelScreen> createState() => _HostPanelScreenState();\n69: }\n70: \n71: final class _HostPanelScreenState extends State<HostPanelScreen> {\n72:   final TextEditingController _seedId = TextEditingController();\n73:   StreamSubscription<HostSessionState>? _states;\n74:   bool _working = false;\n75:   String? _actionError;\n76:   final Set<String> _busySeeds = <String>{};\n77: \n78:   @override\n79:   void initState() {\n80:     super.initState();\n81:     _states = widget.session.states.listen((_) {\n82:       if (mounted) setState(() {});\n83:     });\n84:   }\n85: \n86:   @override\n87:   void dispose() {\n88:     _states?.cancel();\n89:     _seedId.dispose();\n90:     super.dispose();\n91:   }\n92: \n93:   Future<void> _generate() async {\n94:     if (_working) return;\n95:     final String seedId = _seedId.text.trim();\n96:     if (seedId.isEmpty) {\n97:       setState(() => _actionError = 'Enter a seed id to generate.');\n98:       return;\n99:     }\n100:     setState(() {\n101:       _working = true;\n102:       _actionError = null;\n103:     });\n104:     try {\n105:       await widget.session.generate(seedId);\n106:     } on Object catch (error) {\n107:       if (mounted) setState(() => _actionError = '$error');\n108:     } finally {\n109:       if (mounted) setState(() => _working = false);\n110:     }\n111:   }\n112: \n113:   Future<void> _delete(String seedId) async {\n114:     if (_busySeeds.contains(seedId)) return;\n115:     setState(() {\n116:       _busySeeds.add(seedId);\n117:       _actionError = null;\n118:     });\n119:     try {\n120:       await widget.session.deleteVideos(<String>[seedId]);\n121:     } on Object catch (error) {\n122:       if (mounted) setState(() => _actionError = '$error');\n123:     } finally {\n124:       if (mounted) {\n125:         setState(() => _busySeeds.remove(seedId));\n126:       }\n127:     }\n128:   }\n129: \n130:   @override\n131:   Widget build(BuildContext context) {\n132:     final HostSessionState snapshot = widget.session.state;\n133:     return Scaffold(\n134:       appBar: AppBar(title: const Text('Host panel')),\n135:       body: Center(\n136:         child: SingleChildScrollView(\n137:           padding: const EdgeInsets.all(24),\n138:           child: ConstrainedBox(\n139:             constraints: const BoxConstraints(maxWidth: 720),\n140:             child: Column(\n141:               crossAxisAlignm