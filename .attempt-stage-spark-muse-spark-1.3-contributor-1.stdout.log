2: \n123: function serializeManifest(manifest: DeliveryManifest): SerializedDeliveryManifest {\n124:   for (const clip of manifest.cameraClips) validateDeliveryPath(clip, manifest.partyId, manifest.channelId, manifest.version);\n125:   return {\n126:     partyId: manifest.partyId,\n127:     channelId: manifest.channelId,\n128:     version: manifest.version,\n129:     schemaVersion: manifest.schemaVersion,\n130:     jobId: manifest.jobId,\n131:     cameraClips: manifest.cameraClips.map((clip) => ({\n132:       cameraId: clip.cameraId,\n133:       objectPath: clip.objectPath,\n134:       sha256: clip.sha256,\n135:       sizeBytes: clip.sizeBytes,\n136:       durationMs: clip.durationMs,\n137:       expiresAt: new Date(Date.parse(clip.expiresAt)).toISOString(),\n138:     })),\n139:     createdAt: timestampIso(manifest.createdAt),\n140:     expiresAt: new Date(Date.parse(manifest.expiresAt)).toISOString(),\n141:   };\n142: }\n143: \n144: function canonicalClipsMatch(manifest: DeliveryManifest, ack: AckInput): void {\n145:   if (manifest.version !== ack.manifestVersion || manifest.partyId !== ack.partyId || manifest.channelId !== ack.channelId) {\n146:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK does not match the current party, channel, and manifest version.\");\n147:   }\n148:   for (const clip of manifest.cameraClips) {\n149:     if (ack.clipHashes[clip.cameraId] !== clip.sha256) {\n150:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hash does not match the canonical manifest.\");\n151:     }\n152:     validateDeliveryPath(clip, manifest.partyId, manifest.channelId, manifest.version);\n153:   }\n154: }\n155: \n156: /**\n157:  * Delivery-time consent revocation: a manifest produced from a guest-bound\n158:  * job whose consent was withdrawn (or whose binding is gone) must not yield\n159:  * new signed URLs, even if the manifest document itself has not been\n160:  * collected yet. Text-only jobs (no guest binding) are unaffected.\n161:  */\n162: async function assertManifestConsentLive(db: Firestore, partyId: string, jobId: string): Promise<void> {\n163:   let job: FirebaseFirestore.DocumentData | undefined;\n164:   try {\n165:     const snapshot = await db.doc(`parties/${partyId}/jobs/${jobId}`).get();\n166:     if (!snapshot.exists) return;\n167:     job = snapshot.data();\n168:   } catch {\n169:     return;\n170:   }\n171:   const guest = job?.guestMedia as Record<string, unknown> | undefined;\n172:   const submissionId = guest && typeof guest.submissionId === \"string\" ? guest.submissionId : undefined;\n173:   if (!submissionId) return;\n174:   let current: FirebaseFirestore.DocumentData | undefined;\n175:   try {\n176:     const snapshot = await db.doc(`parties/${partyId}/guestMedia/${submissionId}`).get();\n177:     if (!snapshot.exists) throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for delivery.\");\n178:     current = snapshot.data();\n179:   } catch (error) {\n180:     if (error instanceof BackendError) throw error;\n181:     return;\n182:   }\n183:   if (!current || current.status !== \"eligible\" || (current as Record<string, unknown>).tombstone === true) {\n184:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn; this manifest is revoked.\");\n185:   }\n186: }\n187: \n188: export function createDeliveryServices(options: DeliveryServiceOptions): DeliveryServices {\n189:   const { db, bucket } = options;\n190:   const now = options.now ?? (() => new Date());\n191:   const enqueueGeneration = options.enqueueGeneration ?? (async () => undefined);\n192:   const generationRunner = options.generationRunner ?? defaultRunner;\n193:   const signReadUrl = options.signReadUrl ?? (async (file, expiresAt) => {\n194:     const [url] = await file.getSignedUrl({ action: \"read\", expires: expiresAt, version: \"v4\" });\n195:     return url;\n196:   });\n197:   const deleteDeliveryObject = options.deleteDeliveryObject ?? (async (file) => {\n198:     await file.de