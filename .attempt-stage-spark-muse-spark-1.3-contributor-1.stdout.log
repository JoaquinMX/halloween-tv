as = <String>{};\n468:   final seenClipIds = <String>{};\n469:   for (final clip in m.clips) {\n470:     if (clip.id.trim().isEmpty) {\n471:       return const Err<PlaybackManifest>('clip id must be non-empty');\n472:     }\n473:     if (clip.id.length > kMaxClipIdLength) {\n474:       return Err<PlaybackManifest>(\n475:         'clip id ${clip.id} exceeds $kMaxClipIdLength characters',\n476:       );\n477:     }\n478:     if (!seenClipIds.add(clip.id)) {\n479:       return Err<PlaybackManifest>('duplicate clip id ${clip.id}');\n480:     }\n481:     if (!kCctvCameraIds.contains(clip.cameraId)) {\n482:       return Err<PlaybackManifest>(\n483:         'unknown cameraId ${clip.cameraId}; expected one of $kCctvCameraIds',\n484:       );\n485:     }\n486:     if (!seenCameras.add(clip.cameraId)) {\n487:       return Err<PlaybackManifest>('duplicate cameraId ${clip.cameraId}');\n488:     }\n489:     if (clip.storageObjectId.trim().isEmpty) {\n490:       return const Err<PlaybackManifest>('storageObjectId must be non-empty');\n491:     }\n492:     if (!isValidSha256Hex(clip.sha256)) {\n493:       return Err<PlaybackManifest>('invalid sha256 for clip ${clip.id}');\n494:     }\n495:     if (clip.sizeBytes <= 0) {\n496:       return Err<PlaybackManifest>('sizeBytes must be > 0 for clip ${clip.id}');\n497:     }\n498:     if (clip.duration.inMilliseconds <= 0) {\n499:       return Err<PlaybackManifest>('duration must be > 0 for clip ${clip.id}');\n[Output truncated. Continue reading with offset: 500]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/packages/core_playlist/lib/core_playlist.dart, lines 440-499\n440: /// (the supported TV layouts; four remains the default) with unique ids\n441: /// (each at most [kMaxClipIdLength] characters) and unique cameraId values\n442: /// whose set equals the first N canonical slot ids in wall order\n443: /// ([expectedCctvCameraIds]; reordered 