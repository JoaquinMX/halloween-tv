on, 1);\n459:       expect(failed.mediaByClipId, hasLength(4));\n460:       expect(indexes.indexes.values.single.committedVersion, 1);\n461:       expect(ack.records.map((record) => record.version), <int>[1]);\n462:       expect(original.activateCount, 1);\n463:     },\n464:   );\n465: \n466:   test(\n467:     'download failure leaves last-known-good index and provides retry delay',\n468:     () async {\n469:       final _CacheStore cache = _CacheStore();\n470:       final _IndexStore indexes = _IndexStore();\n471:       final _Downloader downloader = _Downloader();\n472:       final _Acknowledger ack = _Acknowledger();\n473:       final PreparePlayback service = _useCase(\n474:         cache: cache,\n475:         index: indexes,\n476:         downloader: downloader,\n477:         acknowledger: ack,\n478:       );\n479:       addTearDown(service.dispose);\n480:       await service.prepareManifest(_manifest());\n481: \n482:       downloader.failures.add('clip-3');\n483:       final PlaybackSyncSnapshot failed = await service.prepareManifest(\n484:         _manifest(version: 2),\n485:       );\n486:       expect(failed.state, PlaybackSyncState.errorRecoverable);\n487:       expect(failed.retryAfter, const Duration(milliseconds: 500));\n488:       final PlaybackSyncSnapshot retried = await service.prepareManifest(\n489:         _manifest(version: 2),\n490:       );\n491:       expect(retried.state, PlaybackSyncState.errorRecoverable);\n492:       expect(retried.retryAfter, const Duration(milliseconds: 1000));\n493:       expect(indexes.indexes.values.single.committedVersion, 1);\n494:       expect(ack.records.map((record) => record.version), <int>[1]);\n495:     },\n496:   );\n497: \n498:   test(\n499:     'cancel interrupts a partial download before index commit or ACK',\n500:     () async {\n501:       final _CacheStore cache = _CacheStore();\n502:       final _IndexStore indexes = _IndexStore();\n503:       final _Downloader downloader = _Downloader();\n504:       final Completer<void> blocked = Completer<void>();\n505:       final Completer<void> started = Completer<void>();\n506:       downloader.blocked['clip-1'] = blocked;\n507:       downloader.started['clip-1'] = started;\n508:       final _Acknowledger ack = _Acknowledger();\n509:       final PreparePlayback service = _useCase(\n510:         cache: cache,\n511:         index: indexes,\n512:         downloader: downloader,\n513:         acknowledger: ack,\n514:       );\n515:       addTearDown(service.dispose);\n516: \n517:       final Future<PlaybackSyncSnapshot> pending = service.prepareManifest(\n518:         _manifest(),\n519:       );\n520:       await started.future;\n521:       service.cancel();\n522:       blocked.complete();\n523:       await pending;\n524: \n525:       expect(service.snapshot.state, PlaybackSyncState.booting);\n526:       expect(indexes.indexes, isEmpty);\n527:       expect(ack.records, isEmpty);\n528:     },\n529:   );\n530: \n531:   test(\n532:     'newer racing manifest wins; delayed stale completion cannot ACK',\n533:     () async {\n534:       final _CacheStore cache = _CacheStore();\n535:       final _IndexStore indexes = _IndexStore();\n536:       final _Downloader downloader = _Downloader();\n537:       final Completer<void> blocked = Completer<void>();\n538:       final Completer<void> started = Completer<void>();\n539:       downloader.blocked['clip-1'] = blocked;\n540:       downloader.started['clip-1'] = started;\n541:       final _Acknowledger ack = _Acknowledger();\n542:       final PreparePlayback service = _useCase(\n543:         cache: cache,\n544:         index: indexes,\n545:         downloader: downloader,\n546:         acknowledger: ack,\n547:       );\n548:       addTearDown(service.dispose);\n549: \n550:       final Future<PlaybackSyncSnapshot> stale = service.prepareManifest(\n551:         _manifest(version: 2),\n552:       );\n553:       await started.future;\n554:       final PlaybackSyncSnapshot newest = await service.prepareManifest(\n555:         _manifest(version: 3),\n556:       );\n557:       blocked.complete();\n558:       await stale;\n559: \n560:       expect(newest.state, PlaybackSyncState.ready);\n561:       expect(indexes.indexes.values.single.committedVersion, 3);\n562:       expect(ack.records.map((record) => record.version), <int>[3]);\n563:       expect(downloader.maxActive, lessThanOrEqualTo(2));\n564: \n565:       final PlaybackSyncSnapshot rejected = await service.prepareManifest(\n566:         _manifest(version: 2),\n567:       );\n568:       expect(rejected.state, PlaybackSyncState.errorRecoverable);\n569:       expect(indexes.indexes.values.single.committedVersion, 3);\n570:     },\n571:   );\n572: \n573:   test(\n574:     'invalid camera assignment is fatal and does not replace current version',\n575:     () async {\n576:       final _CacheStore cache = _CacheStore();\n577:       final _IndexStore indexes = _IndexStore();\n578:       final _Downloader downloader = _Downloader();\n579:       final _Acknowledger ack = _Acknowledger();\n580:       final PreparePlayback service = _useCase(\n581:         cache: cache,\n582:         index: indexes,\n583:         downloader: downloader,\n584:         acknowledger: ack,\n585:       );\n586:       addTearDown(service.dispose);\n587:       await service.prepareManifest(_manifest());\n588:       final PlaybackManifest valid = _manifest(version: 2);\n589:       final List<ClipDescriptor> duplicatedCamera = <ClipDescriptor>[\n590:         ...valid.clips,\n591:       ];\n592:       duplicatedCamera[3] = ClipDescriptor(\n593:         id: 'bad-camera',\n594:         cameraId: 'CAM-01',\n595:         storageObjectId: 'bad.mp4',\n596:         sha256: sha256Hex(<int>[9, 9, 9]),\n597:         sizeBytes: 3,\n598:         duration: const Duration(seconds: 5),\n599:         mimeType: 'video/mp4',\n600:       );\n601: \n602:       final PlaybackSyncSnapshot invalid = await service.prepareManifest(\n603:         _manifest(version: 2, clips: duplicatedCamera),\n604:       );\n605:       expect(invalid.state, PlaybackSyncState.errorFatal);\n606:       expect(invalid.manifest?.version, 1);\n607:       expect(indexes.indexes.values.single.committedVersion, 1);\n608:       expect(ack.records.map((record) => record.version), <int>[1]);\n609:     },\n610:   );\n611: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/kernel_app/test/prepare_playback_test.dart, lines 1-611\n1: import 'dart:async';\n2: \n3: import 'package:core_cache/core_cache.dart';\n4: import 'package:core_playlist/core_playlist.dart';\n5: import 'package:flutter_test/flutter_test.dart';\n6: import 'package:infra_signed_urls/infra_signed_urls.dart';\n7: import 'package:kernel_app/kernel_app.dart';\n8: \n9: final class _ManifestSource implements ManifestSource<PlaybackManifest> {\n10:   _ManifestSource(this.manifest);\n11: \n12:   final PlaybackManifest manifest;\n13: \n14:   @override\n15:   Stream<PlaybackManifest> watchCurrent({\n16:     required String partyId,\n17:     required String channelId,\n18:   }) async* {\n19:     yield manifest;\n20:   }\n21: }\n22: \n23: final class _UrlSigner implements UrlSigner {\n24:   final List<String> signedClipIds = <String>[];\n25: \n26:   @override\n27:   Future<Uri> signFor(\n28:     ClipDescriptor clip, {\n29:     Duration expiry = const Duration(hours: 1),\n30:   }) async {\n31:     signedClipIds.add(clip.id);\n32:     return Uri.parse('https://media.test/${clip.storageObjectId}');\n33:   }\n34: }\n35: \n36: final class _Downloader implements MediaDownloader {\n37:   final Set<String> failures = <String>{};\n38:   final Map<String, List<int>> corruptPayloads = <String, List<int>>{};\n39:   final Map<String, Completer<void>> blocked = <String, Completer<void>>{};\n40:   final Map<String, Completer<void>> started = <String, Completer<void>>{};\n41:   int active = 0;\n42:   int maxActive = 0;\n43:   int downloadCount = 0;\n44: \n45:   @override\n46:   Future<DownloadedMedia> downloadAndVerify(\n47:     ClipDescriptor clip,\n48:     Uri source,\n49:   ) async {\n50:     downloadCount++;\n51:     active++;\n52:     if (active > maxActive) {\n53:       maxActive = active;\n54:     }\n55:     final Completer<void>? startedSignal = started[clip.id];\n56:     if (startedSignal != null && !startedSignal.isCompleted) {\n57:       startedSignal.complete();\n58:     }\n59:     try {\n60:       final Completer<void>? gate = blocked.remove(clip.id);\n61:       if (gate != null) {\n62:         await gate.future;\n63:       }\n64:       if (failures.contains(clip.id)) {\n65:         throw StateError('interrupted download for ${clip.id}');\n66:       }\n67:       await Future<void>.delayed(const Duration(milliseconds: 1));\n68:       final List<int> bytes = corruptPayloads[clip.id] ?? _bytesFor(clip);\n69:       return DownloadedMedia.fromBytes(clipId: clip.id, bytes: bytes);\n70:     } finally {\n71:       active--;\n72:     }\n73:   }\n74: }\n75: \n76: /// In-memory test double for [CacheStore].\n77: ///\n78: /// Verification semantics (id + lowercase-sha256 key, size check, digest\n79: /// re-hash on read, digest check on commit) intentionally mirror the real\n80: /// [FileCacheStore]; the same flows also run against the real store in\n81: /// backend_delivery_contract_test.dart and the tv_app live-wall-session\n82: /// suite, so a divergence here would surface there.\n83: final class _CacheStore implements CacheStore {\n84:   final Map<String, CachedMedia> entries = <String, CachedMedia>{};\n85:   final Map<String, List<int>> bytesByRef = <String, List<int>>{};\n86: \n87:   String _key(ClipDescriptor clip) => '${clip.id}/${clip.sha256.toLowerCase()}';\n88: \n89:   @override\n90:   Future<CachedMedia?> findVerified(ClipDescriptor clip) async {\n91:     final CachedMedia? entry = entries[_key(clip)];\n92:     final List<int>? bytes = entry == null ? null : bytesByRef[entry.localRef];\n93:     if (entry == null ||\n94:         bytes == null ||\n95:         bytes.length != clip.sizeBytes ||\n96:         sha256Hex(bytes) != clip.sha256.toLowerCase()) {\n97:       return null;\n98:     }\n99:     return entry;\n100:   }\n101: \n102:   @override\n103:   Future<CachedMedia> commit(DownloadedMedia media) async {\n104:     if (sha256Hex(media.bytes) != media.sha256.toLowerCase()) {\n105:       throw StateError('cache refused a bad digest');\n106:     }\n107:     final String ref = 'mem://${media.clipId}/${media.sha256.toLowerCase()}';\n108:     final CachedMedia entry = CachedMedia(\n109:       clipId: media.clipId,\n110:       localRef: ref,\n111:       sha256: media.sha256.toLowerCase(),\n112:     );\n113:     entries['${media.clipId}/${media.sha256.toLowerCase()}'] = entry;\n114:     bytesByRef[ref] = List<int>.unmodifiable(media.bytes);\n115:     return entry;\n116:   }\n117: \n118:   @override\n119:   Future<int> deleteExpired() async => 0;\n120: }\n121: \n122: final class _IndexStore implements ManifestIndexStore {\n123:   final Map<String, CommittedManifestIndex> indexes =\n124:       <String, CommittedManifestIndex>{};\n125: \n126:   String _key(String partyId, String channelId) => '$partyId/$channelId';\n127: \n128:   @override\n129:   Future<CommittedManifestIndex?> readCommitted({\n130:     required String partyId,\n131:     required String channelId,\n132:   }) async => indexes[_key(partyId, channelId)];\n133: \n134:   @override\n135:   Future<void> writeAtomically(CommittedManifestIndex index) async {\n136:     if (failWrites) {\n137:       throw StateError('atomic index write failed');\n138:     }\n139:     indexes[_key(index.manifest.partyId, index.manifest.channelId)] = index;\n140:   }\n141: \n142:   bool failWrites = false;\n143: }\n144: \n145: final class _AckRecord {\n146:   _AckRecord(this.partyId, this.channelId, this.version, this.hashes);\n147: \n148:   final String partyId;\n149:   final String channelId;\n150:   final int version;\n151:   final Map<String, String> hashes;\n152: }\n153: \n154: final class _Acknowledger implements DeliveryAcknowledger {\n155:   final List<_AckRecord> records = <_AckRecord>[];\n156:   Object? failure;\n157: \n158:   @override\n159:   Future<void> acknowledge({\n160:     required String partyId,\n161:     required String channelId,\n162:     required int manifestVersion,\n163:     required Map<String, String> verifiedClipHashes,\n164:   }) async {\n165:     final Object? currentFailure = failure;\n166:     failure = null;\n167:     if (currentFailure != null) {\n168:       throw currentFailure;\n169:     }\n170:     records.add(\n171:       _AckRecord(\n172:         partyId,\n173:         channelId,\n174:         manifestVersion,\n175:         Map<String, String>.unmodifiable(verifiedClipHashes),\n176:       ),\n177:     );\n178:   }\n179: }\n180: \n181: final class _PlaybackHandle implements PlaybackHandle {\n182:   int prepareCount = 0;\n183:   int activateCount = 0;\n184:   bool failPrepare = false;\n185: \n186:   @override\n187:   Future<void> prepare() async {\n188:     prepareCount++;\n189:     if (failPrepare) {\n190:       throw StateError('staged player could not prepare');\n191:     }\n192:   }\n193: \n194:   @override\n195:   Future<void> activate() async => activateCount++;\n196: }\n197: \n198: List<int> _bytesFor(ClipDescriptor clip) {\n199:   final List<String> parts = clip.storageObjectId.split('-');\n200:   final int version = int.parse(parts.first.substring(1));\n201:   final int cameraNumber = int.parse(parts[2].split('.').first);\n202:   final int firstByte = cameraNumber + version * 20;\n203:   return <int>[firstByte, firstByte + 10, firstByte + 20];\n204: }\n205: \n206: PlaybackManifest _manifest({int version = 1, List<ClipDescriptor>? clips}) {\n207:   final List<ClipDescriptor> selected =\n208:       clips ??\n209:       <ClipDescriptor>[\n210:         for (var i = 1; i <= 4; i++)\n211:           ClipDescriptor(\n212:             id: 'clip-$i',\n213:             cameraId: 'CAM-0$i',\n214:             storageObjectId: 'v$version-camera-$i.mp4',\n215:             sha256: sha256Hex(<int>[\n216:               i + version * 20,\n217:               i + version * 20 + 10,\n218:               i + version * 20 + 20,\n219:             ]),\n220:             sizeBytes: 3,\n221:             duration: const Duration(seconds: 5),\n222:             mimeType: 'video/mp4',\n223:           ),\n224:       ];\n225:   return PlaybackManifest(\n226:     partyId: 'party-1',\n227:     channelId: 'cctv',\n228:     version: version,\n229:     clips: selected,\n230:     publishedAt: DateTime.utc(2026, 10, 29, version),\n231:   );\n232: }\n233: \n234: PreparePlayback _useCase({\n235:   required _CacheStore cache,\n236:   required _IndexStore index,\n237:   required _Downloader downloader,\n238:   required _Acknowledger acknowledger,\n239:   _ManifestSource? source,\n240:   _UrlSigner? signer,\n241: }) => PreparePlayback(\n242:   manifestSource: source ?? _ManifestSource(_manifest()),\n243:   urlSigner: signer ?? _UrlSigner(),\n244:   downloader: downloader,\n245:   cacheStore: cache,\n246:   manifestIndexStore: index,\n247:   acknowledger: acknowledger,\n248:   backoff: CappedExponentialBackoff(randomUnit: () => 1),\n249: );\n250: \n251: void main() {\n252:   test(\n253:     'prepare, activate, ACK, then boot offline from committed index',\n254:     () async {\n255:       final _CacheStore cache = _CacheStore();\n256:       final _IndexStore indexes = _IndexStore();\n257:       final _Downloader downloader = _Downloader();\n258:       final _Acknowledger ack = _Acknowledger();\n259:       final _UrlSigner signer = _UrlSigner();\n260:       final PreparePlayback service = _useCase(\n261:         cache: cache,\n262:         index: indexes,\n263:         downloader: downloader,\n264:         acknowledger: ack,\n265:         source: _ManifestSource(_manifest()),\n266:         signer: signer,\n267:       );\n268:       addTearDown(service.dispose);\n269: \n270:       expect(service.snapshot.state, PlaybackSyncState.booting);\n271:       final PlaybackSyncSnapshot prepared = await service.prepareLatest(\n272:         partyId: 'party-1',\n273:         channelId: 'cctv',\n274:       );\n275:       expect(prepared.state, PlaybackSyncState.ready);\n276:       expect(prepared.hasCompleteMedia, isTrue);\n277:       expect(prepared.mediaByClipId, hasLength(4));\n278:       expect(indexes.indexes.values.single.committedVersion, 1);\n279:       expect(ack.records, hasLength(1));\n280:       expect(ack.records.single.hashes, hasLength(4));\n281:       expect(downloader.maxActive, lessThanOrEqualTo(2));\n282: \n283:       final _PlaybackHandle handle = _PlaybackHandle();\n284:       final PlaybackSyncSnapshot active = await service.activate(handle);\n285:       expect(active.state, PlaybackSyncState.ready);\n286:       expect(handle.prepareCount, 1);\n287:       expect(handle.activateCount, 1);\n288: \n289:       final _Downloader offlineDownloader = _Downloader();\n290:       final _UrlSigner offlineSigner = _UrlSigner();\n291:       final PreparePlayback offline = _useCase(\n292:         cache: cache,\n293:         index: indexes,\n294:         downloader: offlineDownloader,\n295:         acknowledger: _Acknowledger(),\n296:         signer: offlineSigner,\n297:       );\n298:       addTearDown(offline.dispose);\n299:       final PlaybackSyncSnapshot cached = await offline.bootOffline(\n300:         partyId: 'party-1',\n301:         channelId: 'cctv',\n302:       );\n303:       expect(cached.state, PlaybackSyncState.usingCache);\n304:       expect(cached.hasCompleteMedia, isTrue);\n305:       expect(offlineDownloader.maxActive, 0);\n306:       expect(offlineSigner.signedClipIds, isEmpty);\n307:     },\n308:   );\n309: \n310:   test(\n311:     'shuffled manifests ACK hashes by camera id instead of list position',\n312:     () async {\n313:       final _CacheStore cache = _CacheStore();\n314:       final _IndexStore indexes = _IndexStore();\n315:       final _Downloader downloader = _Downloader();\n316:       final _Acknowledger ack = _Acknowledger();\n317:       final List<ClipDescriptor> shuffled = _manifest().clips.reversed.toList();\n318:       final PreparePlayback service = _useCase(\n319:         cache: cache,\n320:         index: indexes,\n321:         downloader: downloader,\n322:         acknowledger: ack,\n323:       );\n324:       addTearDown(service.dispose);\n325: \n326:       final PlaybackManifest manifest = _manifest(clips: shuffled);\n327:       expect(\n328:         (await service.prepareManifest(manifest)).state,\n329:         PlaybackSyncState.ready,\n330:       );\n331:       expect(ack.records.single.hashes, <String, String>{\n332:         for (final ClipDescriptor clip in manifest.clips)\n333:           clip.cameraId: clip.sha256,\n334:       });\n335:       expect(ack.records.single.hashes.values.toSet(), hasLength(4));\n336:     },\n337:   );\n338: \n339:   test(\n340:     'lost ACK response retries committed version without downloading again',\n341:     () async {\n342:       final _CacheStore cache = _CacheStore();\n343:       final _IndexStore indexes = _IndexStore();\n344:       final _Downloader downloader = _Downloader();\n345:       final _Acknowledger ack = _Acknowledger()\n346:         ..failure = StateError('ACK response was lost');\n347:       final PreparePlayback service = _useCase(\n348:         cache: cache,\n349:         index: indexes,\n350:         downloader: downloader,\n351:         acknowledger: ack,\n352:       );\n353:       addTearDown(service.dispose);\n354:       final PlaybackManifest manifest = _manifest();\n355: \n356:       final PlaybackSyncSnapshot first = await service.prepareManifest(\n357:         manifest,\n358:       );\n359:       expect(first.state, PlaybackSyncState.errorRecoverable);\n360:       expect(first.hasCompleteMedia, isTrue);\n361:       expect(indexes.indexes.values.single.committedVersion, 1);\n362:       final int downloadsAfterFirstCommit = downloader.downloadCount;\n363: \n364:       final PlaybackSyncSnapshot retried = await service.prepareManifest(\n365:         manifest,\n366:       );\n367:       expect(retried.state, PlaybackSyncState.ready);\n368:       expect(downloader.downloadCount, downloadsAfterFirstCommit);\n369:       expect(ack.records, hasLength(1));\n370:       expect(ack.records.single.version, 1);\n371:     },\n372:   );\n373: \n374:   test(\n375:     'ACK rejection keeps verified playback available for a later retry',\n376:     () async {\n377:       final _CacheStore cache = _CacheStore();\n378:       final _IndexStore indexes = _IndexStore();\n379:       final _Downloader downloader = _Downloader();\n380:       final _Acknowledger ack = _Acknowledger()\n381:         ..failure = StateError('backend rejected ACK');\n382:       final PreparePlayback service = _useCase(\n383:         cache: cache,\n384:         index: indexes,\n385:         downloader: downloader,\n386:         acknowledger: ack,\n387:       );\n388:       addTearDown(service.dispose);\n389:       final PlaybackManifest manifest = _manifest();\n390: \n391:       final PlaybackSyncSnapshot rejected = await service.prepareManifest(\n392:         manifest,\n393:       );\n394:       expect(rejected.state, PlaybackSyncState.errorRecoverable);\n395:       expect(rejected.hasCompleteMedia, isTrue);\n396:       expect(indexes.indexes.values.single.committedVersion, 1);\n397:       expect(ack.records, isEmpty);\n398:       final int downloads = downloader.downloadCount;\n399: \n400:       final PlaybackSyncSnapshot retried = await service.prepareManifest(\n401:         manifest,\n402:       );\n403:       expect(retried.state, PlaybackSyncState.ready);\n404:       expect(downloader.downloadCount, downloads);\n405:       expect(ack.records.single.version, 1);\n406:     },\n407:   );\n408: \n409:   test('failed atomic index write cannot ACK verified clip files', () async {\n410:     final _CacheStore cache = _CacheStore();\n411:     final _IndexStore indexes = _IndexStore()..failWrites = true;\n412:     final _Downloader downloader = _Downloader();\n413:     final _Acknowledger ack = _Acknowledger();\n414:     final PreparePlayback service = _useCase(\n415:       cache: cache,\n416:       index: indexes,\n417:       downloader: downloader,\n418:       acknowledger: ack,\n419:     );\n420:     addTearDown(service.dispose);\n421: \n422:     final PlaybackSyncSnapshot failed = await service.prepareManifest(\n423:       _manifest(),\n424:     );\n425:     expect(failed.state, PlaybackSyncState.errorRecoverable);\n426:     expect(indexes.indexes, isEmpty);\n427:     expect(ack.records, isEmpty);\n428:   });\n429: \n430:   test(\n431:     'corrupt download keeps previous playback and committed version',\n432:     () async {\n433:       final _CacheStore cache = _CacheStore();\n434:       final _IndexStore indexes = _IndexStore();\n435:       final _Downloader downloader = _Downloader();\n436:       final _Acknowledger ack = _Acknowledger();\n437:       final PreparePlayback service = _useCase(\n438:         cache: cache,\n439:         index: indexes,\n440:         downloader: downloader,\n441:         acknowledger: ack,\n442:       );\n443:       addTearDown(service.dispose);\n444: \n445:       final PlaybackManifest first = _manifest();\n446:       expect(\n447:         (await service.prepareManifest(first)).state,\n448:         PlaybackSyncState.ready,\n449:       );\n450:       final _PlaybackHandle original = _PlaybackHandle();\n451:       await service.activate(original);\n452: \n453:       downloader.corruptPayloads['clip-2'] = <int>[99, 98, 97];\n454:       final PlaybackSyncSnapshot failed = await service.prepareManifest(\n455:         _manifest(version: 2),\n456:       );\n457:       expect(failed.state, PlaybackSyncState.errorRecoverable);\n458:       expect(failed.manifest?.version, 1);\n459:       expect(failed.mediaByClipId, hasLength(4));\n460:       expect(indexes.indexes.values.single.committedVersion, 1);\n461:       expect(ack.records.map((record) => record.version), <int>[1]);\n462:       expect(original.activateCount, 1);\n463:     },\n464:   );\n465: \n466:   test(\n467:     'download failure leaves last-known-good index and provides retry delay',\n468:     () async {\n469:       final _CacheStore cache = _CacheStore();\n470:       final _IndexStore indexes = _IndexStore();\n471:       final _Downloader downloader = _Downloader();\n472:       final _Acknowledger ack = _Acknowledger();\n473:       final PreparePlayback service = _useCase(\n474:         cache: cache,\n475:         index: indexes,\n476:         downloader: downloader,\n477:         acknowledger: ack,\n478:       );\n479:       addTearDown(service.dispose);\n480:       await service.prepareManifest(_manifest());\n481: \n482:       downloader.failures.add('clip-3');\n483:       final PlaybackSyncSnapshot failed = await service.prepareManifest(\n484:         _manifest(version: 2),\n485:       );\n486:       expect(failed.state, PlaybackSyncState.errorRecoverable);\n487:       expect(failed.retryAfter, const Duration(milliseconds: 500));\n488:       final PlaybackSyncSnapshot retried = await service.prepareManifest(\n489:         _manifest(version: 2),\n490:       );\n491:       expect(retried.state, PlaybackSyncState.errorRecoverable);\n492:       expect(retried.retryAfter, const Duration(milliseconds: 1000));\n493:       expect(indexes.indexes.values.single.committedVersion, 1);\n494:       expect(ack.records.map((record) => record.version), <int>[1]);\n495:     },\n496:   );\n497: \n498:   test(\n499:     'cancel interrupts a partial download before index commit or ACK',\n500:     () async {\n501:       final _CacheStore cache = _CacheStore();\n502:       final _IndexStore indexes = _IndexStore();\n503:       final _Downloader downloader = _Downloader();\n504:       final Completer<void> blocked = Completer<void>();\n505:       final Completer<void> started = Completer<void>();\n506:       downloader.blocked['clip-1'] = blocked;\n507:       downloader.started['clip-1'] = started;\n508:       final _Acknowledger ack = _Acknowledger();\n509:       final PreparePlayback service = _useCase(\n510:         cache: cache,\n511:         index: indexes,\n512:         downloader: downloader,\n513:         acknowledger: ack,\n514:       );\n515:       addTearDown(service.dispose);\n516: \n517:       final Future<PlaybackSyncSnapshot> pending = service.prepareManifest(\n518:         _manifest(),\n519:       );\n520:       await started.future;\n521:       service.cancel();\n522:       blocked.complete();\n523:       await pending;\n524: \n525:       expect(service.snapshot.state, PlaybackSyncState.booting);\n526:       expect(indexes.indexes, isEmpty);\n527:       expect(ack.records, isEmpty);\n528:     },\n529:   );\n530: \n531:   test(\n532:     'newer racing manifest wins; delayed stale completion cannot ACK',\n533:     () async {\n534:       final _CacheStore cache = _CacheStore();\n535:       final _IndexStore indexes = _IndexStore();\n536:       final _Downloader downloader = _Downloader();\n537:       final Completer<void> blocked = Completer<void>();\n538:       final Completer<void> started = Completer<void>();\n539:       downloader.blocked['clip-1'] = blocked;\n540:       downloader.started['clip-1'] = started;\n541:       final _Acknowledger ack = _Acknowledger();\n542:       final PreparePlayback service = _useCase(\n543:         cache: cache,\n544:         index: indexes,\n545:         downloader: downloader,\n546:         acknowledger: ack,\n547:       );\n548:       addTearDown(service.dispose);\n549: \n550:       final Future<PlaybackSyncSnapshot> stale = service.prepareManifest(\n551:         _manifest(version: 2),\n552:       );\n553:       await started.future;\n554:       final PlaybackSyncSnapshot newest = await service.prepareManifest(\n555:         _manifest(version: 3),\n556:       );\n557:       blocked.complete();\n558:       await stale;\n559: \n560:       expect(newest.state, PlaybackSyncState.ready);\n561:       expect(indexes.indexes.values.single.committedVersion, 3);\n562:       expect(ack.records.map((record) => record.version), <int>[3]);\n563:       expect(downloader.maxActive, lessThanOrEqualTo(2));\n564: \n565:       final PlaybackSyncSnapshot rejected = await service.prepareManifest(\n566:         _manifest(version: 2),\n567:       );\n568:       expect(rejected.state, PlaybackSyncState.errorRecoverable);\n569:       expect(indexes.indexes.values.single.committedVersion, 3);\n570:     },\n571:   );\n572: \n573:   test(\n574:     'invalid camera assignment is fatal and does not replace current version',\n575:     () async {\n576:       final _CacheStore cache = _CacheStore();\n577:       final _IndexStore indexes = _IndexStore();\n578:       final _Downloader downloader = _Downloader();\n579:       final _Acknowledger ack = _Acknowledger();\n580:       final PreparePlayback service = _useCase(\n581:         cache: cache,\n582:         index: indexes,\n583:         downloader: downloader,\n584:         acknowledger: ack,\n585:       );\n586:       addTearDown(service.dispose);\n587:       await service.prepareManifest(_manifest());\n588:       final PlaybackManifest valid = _manifest(version: 2);\n589:       final List<ClipDescriptor> duplicatedCamera = <ClipDescriptor>[\n590:         ...valid.clips,\n591:       ];\n592:       duplicatedCamera[3] = ClipDescriptor(\n593:         id: 'bad-camera',\n594:         cameraId: 'CAM-01',\n595:         storageObjectId: 'bad.mp4',\n596:         sha256: sha256Hex(<int>[9, 9, 9]),\n597:         sizeBytes: 3,\n598:         duration: const Duration(seconds: 5),\n599:         mimeType: 'video/mp4',\n600:       );\n601: \n602:       final PlaybackSyncSnapshot invalid = await service.prepareManifest(\n603:         _manifest(version: 2, clips: duplicatedCamera),\n604:       );\n605:       expect(invalid.state, PlaybackSyncState.errorFatal);\n606:       expect(invalid.manifest?.version, 1);\n607:       expect(indexes.indexes.values.single.committedVersion, 1);\n608:       expect(ack.records.map((record) => record.version), <int>[1]);\n609:     },\n610:   );\n611: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b0d6575a9b8fc5c37ff02c1eb"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/packages/kernel_app/test/prepare_playback_test.dart\"}"},"time":{"start":1793460997796,"end":1793460997829}}}}
