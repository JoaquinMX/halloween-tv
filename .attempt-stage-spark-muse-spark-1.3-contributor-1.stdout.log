stays lazy (exactly as before) so unknown or\n295:     // misconfigured providers fail at the same point with the same shape.\n296:     const active = activeProvider ?? getProvider();\n297:     while (true) {\n298:       const status = await active.getStatus(taskId);\n299:       if (status.state === \"SUCCEEDED\" || status.state === \"FAILED\") return status;\n300:       if (now().getTime() >= deadline) throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider task polling timed out; task ID is retained for reconciliation.\");\n301:       await sleep(pollIntervalMs);\n302:     }\n303:   }\n304: \n305:   async function runGeneration(task: GenerationTask) {\n306:     const validTask: GenerationTask = {\n307:       partyId: validateId(task.partyId, \"partyId\"),\n308:       deviceId: validateId(task.deviceId, \"deviceId\"),\n309:       channelId: validateId(task.channelId, \"channelId\"),\n310:       jobId: validateId(task.jobId, \"jobId\"),\n311:       idempotencyKey: validateId(task.idempotencyKey, \"idempotencyKey\"),\n312:     };\n313:     await assertRegisteredPartyDevice(options.db, validTask);\n314:     const claim = await store.claimWorker(validTask);\n315:     if (!claim.claimed) return { jobId: validTask.jobId, state: String(claim.job.state), manifestVersion: Number(claim.job.manifestVersion) };\n316:     // Rehearsal-marked jobs bind to the fake provider before any submit;\n317:     // unmarked jobs keep `undefined` so every default-path call site resolves\n318:     // lazily through getProvider() exactly as before.\n319:     const activeProvider = resolveRehearsalProvider(claim.job);\n320:     // 5s on every slot (one provider camera + three padded fixture slots).\n321:     const jobPresetId = claim.job.presetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.presetId : \"cheap_demo\";\n322:     const expectedSecondsOut = jobPresetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.secondsOut : 2;\n323:     // Consent-bound guest execution plan: exac