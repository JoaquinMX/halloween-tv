: \"main\", seedId: \"seed-1\" });\n156:     const seedBefore = (await db.doc(`parties/${partyId}/seedVideos/seed-1`).get()).data()!;\n157:     const previewPaths = [...(seedBefore.previewPaths as string[])];\n158:     const manifestBefore = (await db.doc(`parties/${partyId}/manifests/current_main`).get()).data()!;\n159:     const deliveryPaths = (manifestBefore.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n160: \n161:     const deleted = await services.deleteHostVideo({ partyId, deviceId: host, channelId: \"main\", seedIds: [\"seed-1\"] });\n162:     assert.deepEqual(deleted.deletedSeedIds, [\"seed-1\"]);\n163:     assert.equal(deleted.revokedManifest, true);\n164:     for (const path of [...previewPaths, ...deliveryPaths]) assert.ok(deleted.deletedObjects.includes(path), `${path} must be reported deleted`);\n165:     assert.equal((await db.doc(`parties/${partyId}/seedVideos/seed-1`).get()).data()?.status, \"deleted\");\n166:     assert.equal((await db.doc(`parties/${partyId}/manifests/current_main`).get()).exists, false);\n167:     for (const path of [...previewPaths, ...deliveryPaths]) assert.equal((await bucket.file(path).exists())[0], false);\n168:     // Accounting records are preserved.\n169:     assert.ok((await db.collection(`parties/${partyId}/costLogs`).get()).docs.length >= 4, \"cost logs must survive seed deletion\");\n170:     // A deleted seed never recreates previews and its job never republishes.\n171:     await assert.rejects(services.getHostVideoPreview({ partyId, deviceId: host, channelId: \"main\", seedId: \"seed-1\" }),\n172:       (e: unknown) => e instanceof BackendError && e.errorCode === \"NOT_FOUND\");\n173:     await assert.rejects(services.runGeneration({ partyId, deviceId: host, channelId: \"main\", jobId: created.jobId, idempotencyKey: \"idem-1\" }).then(async (run) => {\n174:       if (run.state === \"ready\") {\n175:         const { publishManifest } = await import(\"../src/publish\");\n176:         const { FirestoreGenerationStore } = await import(\"../src/generation_store\");\n177:         await publishManifest(new FirestoreGenerationStore({ db, bucket }), partyId, created.jobId, \"idem-1\");\n178:       }\n179:       return run;\n180:     }), (e: unknown) => e instanceof BackendError);\n181:     // Deleting an unknown seed is NOT_FOUND; cross-party deletion is refused.\n182:     await assert.rejects(services.deleteHostVideo({ partyId, deviceId: host, channelId: \"main\", seedIds: [\"nope\"] }),\n183:       (e: unknown) => e instanceof BackendError && e.errorCode === \"NOT_FOUND\");\n184:   } finally {\n185:     await clearParty(db, bucket, partyId);\n186:     await disposeEmulatorContext(app);\n187:   }\n188: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c34bda749c8d8f177ae4662eb6"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/host_media.test.ts\"}"},"time":{"start":1793463634973,"end":1793463636091}}}}
