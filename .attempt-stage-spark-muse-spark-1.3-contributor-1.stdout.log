er, FirebaseManifestCallableInvoker {\n15:   _BackendCallable({required this.fixture});\n16: \n17:   final Map<String, Object?> fixture;\n18:   final List<(String, Map<String, Object?>)> calls =\n19:       <(String, Map<String, Object?>)>[];\n20:   int deliveryRequestCount = 0;\n21:   late Map<String, Object?> currentDocument;\n22:   int currentDeliveryVersion = 2;\n23:   String? contentMismatchCamera;\n24:   String? corruptCamera;\n25:   bool rejectAcknowledgements = false;\n26:   Future<void> Function(Map<String, Object?> payload)? onAcknowledgement;\n27: \n28:   @override\n29:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n30:     calls.add((name, Map<String, Object?>.of(payload)));\n31:     if (name == 'getCurrentManifest') {\n32:       return currentDocument;\n33:     }\n34:     if (name == 'getDeliveryUrls') {\n35:       deliveryRequestCount++;\n36:       final Map<String, Object?> response = Map<String, Object?>.from(\n37:         (fixture['deliveryUrls']! as Map)['response']! as Map,\n38:       );\n39:       response['manifestVersion'] = currentDeliveryVersion;\n40:       response['manifestHash'] = 'f' * 64;\n41:       response['clips'] = <Map<String, Object?>>[\n42:         for (final CctvSlot slot in cctvSlots) _deliveryClip(slot.id),\n43:       ];\n44:       return response;\n45:     }\n46:     if (name == 'acknowledgeDelivery') {\n47:       await onAcknowledgement?.call(payload);\n48:       if (rejectAcknowledgements) {\n49:         throw StateError('backend rejected stale acknowledgement');\n50:       }\n51:       return <String, Object?>{\n52:         'ackId': 'ack-${payload['manifestVersion']}',\n53:         'manifestVersion': payload['manifestVersion'],\n54:         'purged': true,\n55:       };\n56:     }\n57:     throw StateError('unexpected callable $name');\n58:   }\n59: \n60:   Map<String, Object?> _deliveryClip(String cameraId) {\n61:     final List<Object?> clips =\n62:         currentDocument['cameraClips']! as Lis