zed);\n123:     const registered = await assertRegisteredPartyDevice(this.db, input);\n124:     if (registered.channel.status !== \"active\") throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n125:     // Consent-bound request gate: the guest photo must be eligible right now.\n126:     // The worker and the publication transaction recheck before submitting and\n127:     // before publishing, so a withdrawal races fail closed.\n128:     let guest: GuestMediaDoc | undefined;\n129:     if (input.guestMediaId) {\n130:       guest = await assertGuestEligible(this.db, input, input.guestMediaId, this.now().getTime());\n131:     }\n132:     const ref = jobRef(this.db, input.partyId, input.jobId);\n133:     const result = await this.db.runTransaction(async (transaction) => {\n134:       const existing = await transaction.get(ref);\n135:       if (existing.exists) {\n136:         const old = existing.data()!;\n137:         if (old.idempotencyKey !== input.idempotencyKey || old.deviceId !== input.deviceId || old.channelId !== input.channelId ||\n138:             (old.guestMediaId ?? undefined) !== (input.guestMediaId ?? undefined) ||\n139:             (old.rehearsalOnly === true) !== rehearsalOnly) {\n140:           throw new BackendError(\"FORBIDDEN\", \"jobId is already bound to a different request.\");\n141:         }\n142:         return {\n143:           state: String(old.state),\n144:           created: false,\n145:           manifestVersion: Number(old.manifestVersion),\n146:           timestamp: old.timestamp,\n147:         };\n148:       }\n149:       const inFlight = await transaction.get(\n150:         this.db.collection(`parties/${input.partyId}/jobs`).where(\"state\", \"in\", [\"queued\", \"running\"]).limit(1),\n151:       );\n152:       if (!inFlight.empty) throw new BackendError(\"BUDGET_EXCEEDED\", \"One generation is already in flight for this party.\");\n153:       await transaction.get(budgetRef(this.db, input.partyId));\n154