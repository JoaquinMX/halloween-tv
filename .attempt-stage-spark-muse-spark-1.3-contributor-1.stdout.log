a256 as string }));\n187:       }\n188:     }\n189:     throw new BackendError(\"NOT_FOUND\", \"Seed video preview is not ready yet.\");\n190:   }\n191: \n192:   async function listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }> {\n193:     const input = parseListHostVideosInput(value);\n194:     const host = await assertRegisteredHostDevice(db, input);\n195:     const snapshot = await db.collection(`parties/${host.partyId}/seedVideos`).get();\n196:     const videos: HostSeedEntry[] = [];\n197:     for (const doc of snapshot.docs) {\n198:       const seed = doc.data();\n199:       if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) continue;\n200:       const synced = await syncSeedStatus(host.partyId, doc);\n201:       const current = synced ?? seed;\n202:       videos.push({\n203:         seedId: String(seed.seedId),\n204:         partyId: host.partyId,\n205:         channelId: host.channelId,\n206:         status: current.status as HostSeedStatus,\n207:         jobId: String(seed.jobId),\n208:         createdAt: exposedIso(seed.createdAt),\n209:         expiresAt: exposedIso(seed.expiresAt),\n210:         previewAvailable: Array.isArray(seed.previewPaths) && seed.previewPaths.length > 0,\n211:         cameraIds: Array.isArray(seed.cameraIds) ? (seed.cameraIds as string[]) : [...REQUIRED_CAMERA_IDS],\n212:       });\n213:     }\n214:     videos.sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n215:     return { videos };\n216:   }\n217: \n218:   async function generateHostVideo(value: unknown): Promise<GenerateHostVideoResult> {\n219:     const input = parseGenerateHostVideoInput(value);\n220:     const host = await assertRegisteredHostDevice(db, input);\n221:     const jobId = jobIdForHostSeed(input.seedId);\n222:     const ref = seedRef(db, host.partyId, input.seedId);\n223:     const existing = await ref.get();\n224:     if (existing.exists) {\n225:       const old = existing.data()!;\n226:       if (\n227:         old.partyId !== host.partyId ||\n228:         old.channelId !== host.channelId ||\n229:         old.jobId !== jobId ||\n230:         old.idempotencyKey !== input.idempotencyKey ||\n231:         old.deviceId !== host.deviceId ||\n232:         (old.guestMediaId ?? undefined) !== (input.guestMediaId ?? undefined) ||\n233:         old.presetId !== input.presetId\n234:       ) {\n235:         throw new BackendError(\"FORBIDDEN\", \"seedId is already bound to a different request.\");\n236:       }\n237:       const synced = await syncSeedStatus(host.partyId, existing);\n238:       const jobSnap = await jobRef(db, host.partyId, jobId).get();\n239:       return {\n240:         seedId: input.seedId,\n241:         jobId,\n242:         state: jobSnap.exists ? String(jobSnap.data()?.state ?? synced?.status ?? \"queued\") : String(synced?.status ?? \"queued\"),\n243:         created: false,\n244:       };\n245:     }\n246:     // Deletion/withdrawal races: a seed id bound to a deleted seed can never\n247:     // be resurrected through generate (tombstone check below is best-effort;\n248:     // the publish path rechecks transactionally).\n249:     const createdAt = now();\n250:     const expiresAt = new Date(createdAt.getTime() + HOST_PREVIEW_TTL_MS);\n251:     await ref.create({\n252:       seedId: input.seedId,\n253:       partyId: host.partyId,\n254:       deviceId: host.deviceId,\n255:       channelId: host.channelId,\n256:       jobId,\n257:       idempotencyKey: input.idempotencyKey,\n258:       presetId: input.presetId,\n259:       ...(input.guestMediaId ? { guestMediaId: input.guestMediaId } : {}),\n260:       status: \"queued\",\n261:       cameraIds: [...REQUIRED_CAMERA_IDS],\n262:       previewPaths: [],\n263:       createdAt: FieldValue.serverTimestamp(),\n264:       updatedAt: FieldValue.serverTimestamp(),\n265:       expiresAt: Timestamp.fromDate(expiresAt),\n266:     });\n267:     // Fixed-preset queue with the existing idempotency, budget, and consent\n268:     // checks: host generation is a scoped entry point to the same pipeline,\n269:     // never a parallel one.\n270:     try {\n271:       const request = await store.requestGeneration({\n272:         partyId: host.partyId,\n273:         deviceId: host.deviceId,\n274:         channelId: host.channelId,\n275:         jobId,\n276:         idempotencyKey: input.idempotencyKey,\n277:         presetId: input.presetId,\n278:         ...(input.guestMediaId ? { guestMediaId: input.guestMediaId } : {}),\n279:       });\n280:       await ref.update({ status: request.state === \"queued\" ? \"queued\" : request.state, updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n281:       return { seedId: input.seedId, jobId, state: request.state, created: request.created };\n282:     } catch (error) {\n283:       await ref.update({ status: \"failed\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n284:       throw error;\n285:     }\n286:   }\n287: \n288:   async function getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult> {\n289:     const input = parseGetHostVideoPreviewInput(value);\n290:     const host = await assertRegisteredHostDevice(db, input);\n291:     const ref = seedRef(db, host.partyId, input.seedId);\n292:     const seedSnap = await ref.get();\n293:     if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n294:     const seed = seedSnap.data()!;\n295:     if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n296:       throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n297:     }\n298:     // A deleted seed never recreates previews.\n299:     if (seed.status === \"deleted\") throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n300:     const jobSnap = await jobRef(db, host.partyId, String(seed.jobId)).get();\n301:     if (!jobSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n302:     if (jobSnap.data()?.hostDeleted === true) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n303:     const clips = await deliveryClipsForJob(host.partyId, host.channelId, String(seed.jobId));\n304:     const previewExpiry = seed.expiresAt instanceof Timestamp\n305:       ? seed.expiresAt.toDate()\n306:       : new Date(Date.parse(String(seed.expiresAt)));\n307:     const previewExpiresAt = Number.isFinite(previewExpiry.getTime())\n308:       ? previewExpiry\n309:       : new Date(now().getTime() + HOST_PREVIEW_TTL_MS);\n310:     const previewPaths = await ensurePreviewCopies(host.partyId, input.seedId, clips, previewExpiresAt);\n311:     await ref.update({ previewPaths, status: \"ready\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n312:     const nowMs = now().getTime();\n313:     // Signed TTL is capped at the preview's own expiry (same pattern as delivery URLs).\n314:     const clipsOut = await Promise.all(\n315:       clips.map(async (clip) => {\n316:         const previewPath = hostPreviewObjectPath(host.partyId, input.seedId, clip.cameraId);\n317:         const expiresAt = new Date(Math.min(nowMs + DELIVERY_URL_TTL_SECONDS * 1000, previewExpiresAt.getTime()));\n318:         return {\n319:           cameraId: clip.cameraId,\n320:           sha256: clip.sha256,\n321:           url: await signPreviewUrl(bucket.file(previewPath), expiresAt),\n322:           expiresAt: expiresAt.toISOString(),\n323:         };\n324:       }),\n325:     );\n326:     return { seedId: input.seedId, expiresAt: previewExpiresAt.toISOString(), clips: clipsOut };\n327:   }\n328: \n329:   async function deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult> {\n330:     const input = parseDeleteHostVideoInput(value);\n331:     const host = await assertRegisteredHostDevice(db, input);\n332:     const deletedSeedIds: string[] = [];\n333:     const doomedObjects = new Set<string>();\n334:     const doomedJobs: string[] = [];\n335:     let revokedManifest = false;\n336:     for (const seedId of input.seedIds) {\n337:       const ref = seedRef(db, host.partyId, seedId);\n338:       const outcome = await db.runTransaction(async (transaction) => {\n339:         const seedSnap = await transaction.get(ref);\n340:         if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", `Seed video ${seedId} does not exist.`);\n341:         const seed = seedSnap.data()!;\n342:         if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n343:           throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n344:         }\n345:         if (seed.status === \"deleted\") return { already: true as const, jobId: String(seed.jobId), previews: seed.previewPaths };\n346:         const jobId = String(seed.jobId);\n347:         const jobSnap = await transaction.get(jobRef(db, host.partyId, jobId));\n348:         const job = jobSnap.exists ? jobSnap.data()! : undefined;\n349:         const staged = ((job?.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown }>) ?? {};\n350:         const previews = Array.isArray(seed.previewPaths) ? (seed.previewPaths as unknown[]) : [];\n351:         transaction.update(ref, {\n352:           status: \"deleted\",\n353:           deletedAt: FieldValue.serverTimestamp(),\n354:           updatedAt: FieldValue.serverTimestamp(),\n355:         });\n356:         if (jobSnap.exists) {\n357:           // Tombstone the job so a deletion/withdrawal racing the worker can\n358:           // never republish it (publish.ts rechecks this flag\n359:           // transactionally) and so no preview is recreated afterwards.\n360:           transaction.update(jobRef(db, host.partyId, jobId), {\n361:             hostDeleted: true,\n362:             deletedSeedId: seedId,\n363:             timestamp: FieldValue.serverTimestamp(),\n364:           });\n365:         }\n366:         // Revoke an affected current manifest whose job matches this seed.\n367:         return { already: false as const, jobId, previews, staged, seed };\n368:       });\n369:       if (outcome.already) {\n370:         deletedSeedIds.push(seedId);\n371:         for (const path of (outcome.previews ?? []) as unknown[]) {\n372:           if (typeof path === \"string\" && path.startsWith(\"parties/\")) doomedObjects.add(path);\n373:         }\n374:         continue;\n375:       }\n376:       deletedSeedIds.push(seedId);\n377:       doomedJobs.push(outcome.jobId);\n378:       for (const preview of (outcome.previews ?? []) as unknown[]) {\n379:         if (typeof preview === \"string\" && preview.startsWith(\"parties/\")) doomedObjects.add(preview);\n380:       }\n381:       for (const clip of Object.values((outcome as { staged: Record<string, { objectPath?: unknown }> }).staged ?? {})) {\n382:         if (clip && typeof clip.objectPath === \"string\" && clip.objectPath.startsWith(\"parties/\")) {\n383:           doomedObjects.add(clip.objectPath);\n384:         }\n385:       }\n386:       const jobSnap = await jobRef(db, host.partyId, outcome.jobId).get().catch(() => undefined);\n387:       const job = jobSnap?.exists ? jobSnap.data()! : undefined;\n388:       for (const key of [\"deliveryPaths\", \"generatedPaths\"] as const) {\n389:         const list = job?.[key];\n390:         if (Array.isArray(list)) {\n391:           for (const item of list) if (typeof item === \"string\" && item.startsWith(\"parties/\")) doomedObjects.add(item);\n392:         }\n393:       }\n394:     }\n395:     // Revoke affected manifests after the tombstones are durable.\n396:     if (doomedJobs.length > 0) {\n397:       const currentRef = db.doc(`parties/${host.partyId}/manifests/current_${host.channelId}`);\n398:       const current = await currentRef.get().catch(() => undefined);\n399:       if (current?.exists) {\n400:         const manifest = current.data() as Record<string, unknown>;\n401:         if (typeof manifest.jobId ===