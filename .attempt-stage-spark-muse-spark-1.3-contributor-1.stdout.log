estIndex? committed = await indexes.readCommitted(\n200:             partyId: 'pilot',\n201:             channelId: 'main',\n202:           );\n203:           if (committed == null ||\n204:               committed.committedVersion != payload['manifestVersion']) {\n205:             throw StateError('ACK arrived before the atomic index commit');\n206:           }\n207:           final PlaybackManifest mapped = manifestFromFirestore(\n208:             callable.currentDocument,\n209:           );\n210:           for (final ClipDescriptor clip in mapped.clips) {\n211:             if (await cache.findVerified(clip) == null) {\n212:               throw StateError(\n213:                 'ACK arrived before ${clip.cameraId} was committed',\n214:               );\n215:             }\n216:           }\n217:         };\n218:         var urlRefreshCount = 0;\n219:         final List<Uri> refreshedUris = <Uri>[];\n220:         final PreparePlayback service = PreparePlayback(\n221:           manifestSource: manifestSource,\n222:           urlSigner: signer,\n223:           downloader: HttpsMediaDownloader(\n224:             httpClient: httpClient,\n225:             expiredUrlRefresher: (clip, _) async {\n226:               urlRefreshCount++;\n227:               final Uri uri = await signer.signFor(clip);\n228:               refreshedUris.add(uri);\n229:               return uri;\n230:             },\n231:           ),\n232:           cacheStore: cache,\n233:           manifestIndexStore: indexes,\n234:           acknowledger: delivery,\n235:         );\n236:         addTearDown(service.dispose);\n237: \n238:         final PlaybackSyncSnapshot ready = await service.prepareLatest(\n239:           partyId: 'pilot',\n240:           channelId: 'main',\n241:         );\n242:         expect(ready.state, PlaybackSyncState.ready, reason: ready.error);\n243:         expect(ready.manifest?.version, 1);\n244:         expect(callable.currentDeliveryVersion, 2);\n245:         expect(urlRefreshC