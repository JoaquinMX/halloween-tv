verlaySettings(scanline: $scanlineOpacity, '\n284:       'noise: $noiseLevel, vignette: $vignette)';\n285: }\n286: \n287: /// A published set of clips for one party + channel.\n288: final class PlaybackManifest {\n289:   /// Party this manifest belongs to (non-empty).\n290:   final String partyId;\n291: \n292:   /// Channel this manifest belongs to (non-empty).\n293:   final String channelId;\n294: \n295:   /// Manifest version, must be > 0.\n296:   final int version;\n297: \n298:   /// Clips in playback order.\n299:   final List<ClipDescriptor> clips;\n300: \n301:   /// Overlay tuning.\n302:   final OverlaySettings overlay;\n303: \n304:   /// Publish timestamp.\n305:   final DateTime publishedAt;\n306: \n307:   PlaybackManifest({\n308:     required this.partyId,\n309:     required this.channelId,\n310:     required this.version,\n311:     required List<ClipDescriptor> clips,\n312:     this.overlay = const OverlaySettings(),\n313:     required this.publishedAt,\n314:   }) : clips = List<ClipDescriptor>.unmodifiable(clips);\n315: \n316:   Map<String, Object?> toJson() => <String, Object?>{\n317:     'partyId': partyId,\n318:     'channelId': channelId,\n319:     'version': version,\n320:     'clips': clips.map((c) => c.toJson()).toList(growable: false),\n321:     'overlay': overlay.toJson(),\n322:     'publishedAt': publishedAt.toUtc().toIso8601String(),\n323:   };\n324: \n325:   @override\n326:   bool operator ==(Object other) {\n327:     if (identical(this, other)) {\n328:       return true;\n329:     }\n330:     if (other is! PlaybackManifest ||\n331:         other.partyId != partyId ||\n332:         other.channelId != channelId ||\n333:         other.version != version ||\n334:         other.overlay != overlay ||\n335:         other.publishedAt.toUtc() != publishedAt.toUtc() ||\n336:         other.clips.length != clips.length) {\n337:       return false;\n338:     }\n339:     for (var i = 0; i < clips.length; i++) {\n340:       if (other.clips[i] != clips[i]) {\n341:         return false;\n342:       }\n343:     }\n344:     return true;\n345:   }\n346: \n347:   @override\n348:   int get hashCode => Object.hash(\n349:     partyId,\n350:     channelId,\n351:     version,\n352:     Object.hashAll(clips),\n353:     overlay,\n354:     publishedAt.toUtc(),\n355:   );\n356: \n357:   @override\n358:   String toString() =>\n359:       'PlaybackManifest($partyId/$channelId v$version, '\n360:       '${clips.length} clips)';\n361: }\n362: \n363: /// Parses a manifest from decoded JSON; throws [FormatException] on bad shape.\n364: PlaybackManifest parseManifest(Map<String, Object?> json) {\n365:   try {\n366:     final partyId = json['partyId']! as String;\n367:     final channelId = json['channelId']! as String;\n368:     final version = (json['version']! as num).toInt();\n369:     final rawClips = json['clips']! as List<Object?>;\n370:     final clips = rawClips\n371:         .map(\n372:           (e) => ClipDescriptor.fromJson(\n373:             Map<String, Object?>.from(e! as Map<Object?, Object?>),\n374:           ),\n375:         )\n376:         .toList(growable: false);\n377:     final rawOverlay = json['overlay'];\n378:     if (rawOverlay != null && rawOverlay is! Map) {\n379:       throw const FormatException('overlay must be a JSON object');\n380:     }\n381:     final overlay = rawOverlay == null\n382:         ? const OverlaySettings()\n383:         : OverlaySettings.fromJson(\n384:             Map<String, Object?>.from(rawOverlay as Map<Object?, Object?>),\n385:           );\n386:     final publishedAt = DateTime.parse(json['publishedAt']! as String);\n387:     return PlaybackManifest(\n388:       partyId: partyId,\n389:       channelId: channelId,\n390:       version: version,\n391:       clips: clips,\n392:       overlay: overlay,\n393:       publishedAt: publishedAt,\n394:     );\n395:   } on FormatException {\n396:     rethrow;\n397:   } catch (e) {\n398:     throw FormatException('Invalid manifest JSON: $e');\n399:   }\n400: }\n401: \n402: /// Validates CCTV manifest rules.\n403: ///\n404: /// Enforces: non-empty party/channel, version > 0, exactly 4 clips with\n405: /// unique ids (each at most [kMaxClipIdLength] characters) and unique\n406: /// cameraId each in [kCctvCameraIds] (derived from [cctvSlots]), sane sha256\n407: /// (64 hex chars), sizeBytes > 0 and positive duration. Clip `label` values\n408: /// are config-driven display strings (owner Q3) and are not length-checked\n409: /// here — the tile HUD ellipsizes them.\n410: Result<PlaybackManifest> validateCctvManifest(PlaybackManifest m) {\n411:   if (m.partyId.trim().isEmpty) {\n412:     return const Err<PlaybackManifest>('partyId must be non-empty');\n413:   }\n414:   if (m.channelId.trim().isEmpty) {\n415:     return const Err<PlaybackManifest>('channelId must be non-empty');\n416:   }\n417:   if (m.version <= 0) {\n418:     return const Err<PlaybackManifest>('version must be > 0');\n419:   }\n420:   if (m.clips.length != 4) {\n421:     return Err<PlaybackManifest>(\n422:       'cctv manifest must have exactly 4 clips, got ${m.clips.length}',\n423:     );\n424:   }\n425:   final seenCameras = <String>{};\n426:   final seenClipIds = <String>{};\n427:   for (final clip in m.clips) {\n428:     if (clip.id.trim().isEmpty) {\n429:       return const Err<PlaybackManifest>('clip id must be non-empty');\n430:     }\n431:     if (clip.id.length > kMaxClipIdLength) {\n432:       return Err<PlaybackManifest>(\n433:         'clip id ${clip.id} exceeds $kMaxClipIdLength characters',\n434:       );\n435:     }\n436:     if (!seenClipIds.add(clip.id)) {\n437:       return Err<PlaybackManifest>('duplicate clip id ${clip.id}');\n438:     }\n439:     if (!kCctvCameraIds.contains(clip.cameraId)) {\n440:       return Err<PlaybackManifest>(\n441:         'unknown cameraId ${clip.cameraId}; expected one of $kCctvCameraIds',\n442:       );\n443:     }\n444:     if (!seenCameras.add(clip.cameraId)) {\n445:       return Err<PlaybackManifest>('duplicate cameraId ${clip.cameraId}');\n446:     }\n447:     if (clip.storageObjectId.trim().isEmpty) {\n448:       return const Err<PlaybackManifest>('storageObjectId must be non-empty');\n449:     }\n450:     if (!isValidSha256Hex(clip.sha256)) {\n451:       return Err<PlaybackManifest>('invalid sha256 for clip ${clip.id}');\n452:     }\n453:     if (clip.sizeBytes <= 0) {\n454:       return Err<PlaybackManifest>('sizeBytes must be > 0 for clip ${clip.id}');\n455:     }\n456:     if (clip.duration.inMilliseconds <= 0) {\n457:       return Err<PlaybackManifest>('duration must be > 0 for clip ${clip.id}');\n458:     }\n459:     if (clip.mimeType.trim().isEmpty) {\n460:       return const Err<PlaybackManifest>('mimeType must be non-empty');\n461:     }\n462:   }\n463:   return Ok<PlaybackManifest>(m);\n464: }\n465: \n466: /// Validates that [candidate] advances beyond [committedVersion].\n467: ///\n468: /// A manifest with the same version is not a new publication: callers may\n469: /// treat an identical, already committed manifest as an idempotent cache hit,\n470: /// but must reject it as an update. This keeps version ordering explicit at\n471: /// the point where persisted state is available.\n472: Result<PlaybackManifest> validateManifestVersion(\n473:   PlaybackManifest candidate,\n474:   int? committedVersion,\n475: ) {\n476:   if (candidate.version <= 0) {\n477:     return const Err<PlaybackManifest>('version must be > 0');\n478:   }\n479:   if (committedVersion != null && candidate.version <= committedVersion) {\n480:     return Err<PlaybackManifest>(\n481:       'manifest version ${candidate.version} must be newer than '\n482:       'committed version $committedVersion',\n483:     );\n484:   }\n485:   return Ok<PlaybackManifest>(candidate);\n486: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929af8f57706b97972de2596e5f3"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/packages/core_playlist/lib/core_playlist.dart\"}"},"time":{"start":1793460992557,"end":1793460992648}}}}
{"type":"tool_use","timestamp":1793460992649,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929afa32001nwGr1S9kvB3Vw4","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929af735001CaLTASv2oiGcuk","type":"tool","id":"call_01a1929af92476a59c2863524f6bb85b","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/contracts.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/contracts.ts, lines 1-214\n1: import { createHash } from \"node:crypto\";\n2: import { CAMEO_DEMO_PRESET, CHEAP_DEMO_PRESET, ERROR_CODES, ErrorCode, REQUIRED_CAMERA_IDS } from \"./config\";\n3: \n4: export type { ErrorCode };\n5: \n6: export class BackendError extends Error {\n7:   constructor(readonly errorCode: ErrorCode, message: string) {\n8:     super(message);\n9:     this.name = \"BackendError\";\n10:   }\n11: }\n12: \n13: export interface Identity {\n14:   partyId: string;\n15:   deviceId: string;\n16:   channelId: string;\n17: }\n18: \n19: export interface RequestGenerationInput extends Identity {\n20:   jobId: string;\n21:   idempotencyKey: string;\n22:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n23:   /** Optional consent-bound guest media submission bound at request time. */\n24:   guestMediaId?: string;\n25: }\n26: \n27: export interface CanonicalClip {\n28:   cameraId: (typeof REQUIRED_CAMERA_IDS)[number];\n29:   objectPath: string;\n30:   sha256: string;\n31:   sizeBytes: number;\n32:   durationMs: number;\n33:   expiresAt: string;\n34: }\n35: \n36: export interface DeliveryManifest {\n37:   partyId: string;\n38:   channelId: string;\n39:   version: number;\n40:   schemaVersion: number;\n41:   jobId: string;\n42:   cameraClips: CanonicalClip[];\n43:   /** Firestore timestamp in storage; callable serialization converts it to ISO. */\n44:   createdAt?: unknown;\n45:   expiresAt: string;\n46: }\n47: \n48: export interface CurrentManifestInput extends Identity {}\n49: \n50: export interface AckInput extends Identity {\n51:   manifestVersion: number;\n52:   clipHashes: Record<string, string>;\n53: }\n54: \n55: const ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;\n56: const HASH_RE = /^[a-f0-9]{64}$/;\n57: const isRecord = (value: unknown): value is Record<string, unknown> =>\n58:   value !== null && typeof value === \"object\" && !Array.isArray(value);\n59: \n60: export function requireIdentity(value: unknown): Identity {\n61:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n62:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n63:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n64:   }\n65:   const partyId = validateId(value.partyId, \"partyId\");\n66:   const deviceId = validateId(value.deviceId, \"deviceId\");\n67:   const channelId = typeof value.channelId === \"string\" && value.channelId\n68:     ? validateId(value.channelId, \"channelId\")\n69:     : \"\";\n70:   return { partyId, deviceId, channelId };\n71: }\n72: \n73: export function parseRequestGeneration(value: unknown): RequestGenerationInput {\n74:   const identity = requireIdentity(value);\n75:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n76:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n77:   const jobId = validateId(value.jobId, \"jobId\");\n78:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n79:   if (value.presetId === CAMEO_DEMO_PRESET.presetId) {\n80:     // STEP 2 cameo batch: separate server lock, guest-bound only. Text-only\n81:     // requests for this preset are rejected; prompts stay fixed server-side.\n82:     for (const [key, expected] of Object.entries(CAMEO_DEMO_PRESET)) {\n83:       if (key in value && value[key] !== expected) {\n84:         throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n85:       }\n86:     }\n87:     if (!(\"guestMediaId\" in value) || typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n88:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n89:     }\n90:     validateId(value.guestMediaId, \"guestMediaId\");\n91:     return { ...identity, jobId, idempotencyKey, presetId: CAMEO_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n92:   }\n93:   if (value.presetId !== CHEAP_DEMO_PRESET.presetId) {\n94:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the cheap_demo preset is supported.\");\n95:   }\n96:   // Model and generation controls are fixed server-side; caller overrides are rejected.\n97:   for (const [key, expected] of Object.entries(CHEAP_DEMO_PRESET)) {\n98:     if (key in value && value[key] !== expected) {\n99:       throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n100:     }\n101:   }\n102:   if (\"guestMediaId\" in value && value.guestMediaId !== undefined) {\n103:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n104:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n105:     }\n106:     validateId(value.guestMediaId, \"guestMediaId\");\n107:     return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n108:   }\n109:   return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId };\n110: }\n111: \n112: export function parseAck(value: unknown): AckInput {\n113:   const identity = requireIdentity(value);\n114:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n115:   if (!isRecord(value) || !Number.isSafeInteger(value.manifestVersion) || Number(value.manifestVersion) < 1) {\n116:     throw new BackendError(\"INVALID_ARGUMENT\", \"A positive manifestVersion is required.\");\n117:   }\n118:   if (!isRecord(value.clipHashes)) throw new BackendError(\"INVALID_ARGUMENT\", \"clipHashes must be an object.\");\n119:   const keys = Object.keys(value.clipHashes).sort();\n120:   if (keys.join(\",\") !== [...REQUIRED_CAMERA_IDS].sort().join(\",\")) {\n121:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK must include one hash for each canonical camera clip.\");\n122:   }\n123:   const clipHashes: Record<string, string> = {};\n124:   for (const cameraId of REQUIRED_CAMERA_IDS) {\n125:     const hash = value.clipHashes[cameraId];\n126:     if (typeof hash !== \"string\" || !HASH_RE.test(hash)) {\n127:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hashes must be canonical SHA-256 hex values.\");\n128:     }\n129:     clipHashes[cameraId] = hash;\n130:   }\n131:   return { ...identity, manifestVersion: Number(value.manifestVersion), clipHashes };\n132: }\n133: \n134: export function parseCurrentManifestInput(value: unknown): CurrentManifestInput {\n135:   const identity = requireIdentity(value);\n136:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n137:   return identity;\n138: }\n139: \n140: export interface JoinPartyInput extends Identity {\n141:   joinPin?: string;\n142: }\n143: \n144: /** Exactly six ASCII digits; leading zeros are significant. */\n145: export const JOIN_PIN_RE = /^[0-9]{6}$/;\n146: \n147: export function parseJoinPartyInput(value: unknown): JoinPartyInput {\n148:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n149:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n150:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n151:   }\n152:   const partyId = validateId(value.partyId, \"partyId\");\n153:   const deviceId = validateId(value.deviceId, \"deviceId\");\n154:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n155:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n156:   }\n157:   const channelId = validateId(value.channelId, \"channelId\");\n158:   if (value.joinPin === undefined) {\n159:     return { partyId, deviceId, channelId };\n160:   }\n161:   if (typeof value.joinPin !== \"string\" || !JOIN_PIN_RE.test(value.joinPin)) {\n162:     throw new BackendError(\"INVALID_ARGUMENT\", \"joinPin must be six digits.\");\n163:   }\n164:   return { partyId, deviceId, channelId, joinPin: value.joinPin };\n165: }\n166: \n167: export function validateId(value: unknown, label: string): string {\n168:   if (typeof value !== \"string\" || !ID_RE.test(value)) {\n169:     throw new BackendError(\"INVALID_ARGUMENT\", `${label} is invalid.`);\n170:   }\n171:   return value;\n172: }\n173: \n174: export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n175:   if (!Array.isArray(clips) || clips.length !== REQUIRED_CAMERA_IDS.length) {\n176:     throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain exactly four camera clips.\");\n177:   }\n178:   const byCamera = new Map<string, CanonicalClip>();\n179:   for (const raw of clips) {\n180:     if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n181:         !REQUIRED_CAMERA_IDS.includes(raw.cameraId as (typeof REQUIRED_CAMERA_IDS)[number]) ||\n182:         typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n183:         !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n184:         (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n185:         typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n186:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n187:     }\n188:     if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n189:     byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n190:   }\n191:   if (REQUIRED_CAMERA_IDS.some((cameraId) => !byCamera.has(cameraId))) {\n192:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set is incomplete.\");\n193:   }\n194: }\n195: \n196: export function canonicalManifestHash(manifest: Pick<DeliveryManifest, \"partyId\" | \"channelId\" | \"version\" | \"cameraClips\">): string {\n197:   const canonical = {\n198:     partyId: manifest.partyId,\n199:     channelId: manifest.channelId,\n200:     version: manifest.version,\n201:     cameraClips: [...manifest.cameraClips]\n202:       .sort((a, b) => a.cameraId.localeCompare(b.cameraId))\n203:       .map(({ cameraId, sha256, sizeBytes, durationMs }) => ({ cameraId, sha256, sizeBytes, durationMs })),\n204:   };\n205:   return createHash(\"sha256\").update(JSON.stringify(canonical)).digest(\"hex\");\n206: }\n207: \n208: export function ackIdempotencyKey(deviceId: string, channelId: string, manifestVersion: number): string {\n209:   return createHash(\"sha256\").update(`${deviceId}\\n${channelId}\\n${manifestVersion}`).digest(\"hex\");\n210: }\n211: \n212: export function isErrorCode(value: unknown): value is ErrorCode {\n213:   return typeof value === \"string\" && (ERROR_CODES as readonly string[]).includes(value);\n214: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/contracts.ts, lines 1-214\n1: import { createHash } from \"node:crypto\";\n2: import { CAMEO_DEMO_PRESET, CHEAP_DEMO_PRESET, ERROR_CODES, ErrorCode, REQUIRED_CAMERA_IDS } from \"./config\";\n3: \n4: export type { ErrorCode };\n5: \n6: export class BackendError extends Error {\n7:   constructor(readonly errorCode: ErrorCode, message: string) {\n8:     super(message);\n9:     this.name = \"BackendError\";\n10:   }\n11: }\n12: \n13: export interface Identity {\n14:   partyId: string;\n15:   deviceId: string;\n16:   channelId: string;\n17: }\n18: \n19: export interface RequestGenerationInput extends Identity {\n20:   jobId: string;\n21:   idempotencyKey: string;\n22:   presetId: typeof CHEAP_DEMO_PRESET.presetId | typeof CAMEO_DEMO_PRESET.presetId;\n23:   /** Optional consent-bound guest media submission bound at request time. */\n24:   guestMediaId?: string;\n25: }\n26: \n27: export interface CanonicalClip {\n28:   cameraId: (typeof REQUIRED_CAMERA_IDS)[number];\n29:   objectPath: string;\n30:   sha256: string;\n31:   sizeBytes: number;\n32:   durationMs: number;\n33:   expiresAt: string;\n34: }\n35: \n36: export interface DeliveryManifest {\n37:   partyId: string;\n38:   channelId: string;\n39:   version: number;\n40:   schemaVersion: number;\n41:   jobId: string;\n42:   cameraClips: CanonicalClip[];\n43:   /** Firestore timestamp in storage; callable serialization converts it to ISO. */\n44:   createdAt?: unknown;\n45:   expiresAt: string;\n46: }\n47: \n48: export interface CurrentManifestInput extends Identity {}\n49: \n50: export interface AckInput extends Identity {\n51:   manifestVersion: number;\n52:   clipHashes: Record<string, string>;\n53: }\n54: \n55: const ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;\n56: const HASH_RE = /^[a-f0-9]{64}$/;\n57: const isRecord = (value: unknown): value is Record<string, unknown> =>\n58:   value !== null && typeof value === \"object\" && !Array.isArray(value);\n59: \n60: export function requireIdentity(value: unknown): Identity {\n61:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n62:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n63:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n64:   }\n65:   const partyId = validateId(value.partyId, \"partyId\");\n66:   const deviceId = validateId(value.deviceId, \"deviceId\");\n67:   const channelId = typeof value.channelId === \"string\" && value.channelId\n68:     ? validateId(value.channelId, \"channelId\")\n69:     : \"\";\n70:   return { partyId, deviceId, channelId };\n71: }\n72: \n73: export function parseRequestGeneration(value: unknown): RequestGenerationInput {\n74:   const identity = requireIdentity(value);\n75:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n76:   if (!isRecord(value)) throw new BackendError(\"INVALID_ARGUMENT\", \"Request payload must be an object.\");\n77:   const jobId = validateId(value.jobId, \"jobId\");\n78:   const idempotencyKey = validateId(value.idempotencyKey, \"idempotencyKey\");\n79:   if (value.presetId === CAMEO_DEMO_PRESET.presetId) {\n80:     // STEP 2 cameo batch: separate server lock, guest-bound only. Text-only\n81:     // requests for this preset are rejected; prompts stay fixed server-side.\n82:     for (const [key, expected] of Object.entries(CAMEO_DEMO_PRESET)) {\n83:       if (key in value && value[key] !== expected) {\n84:         throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n85:       }\n86:     }\n87:     if (!(\"guestMediaId\" in value) || typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n88:       throw new BackendError(\"INVALID_ARGUMENT\", \"The cameo_demo preset requires a consent-bound guestMediaId.\");\n89:     }\n90:     validateId(value.guestMediaId, \"guestMediaId\");\n91:     return { ...identity, jobId, idempotencyKey, presetId: CAMEO_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n92:   }\n93:   if (value.presetId !== CHEAP_DEMO_PRESET.presetId) {\n94:     throw new BackendError(\"INVALID_ARGUMENT\", \"Only the cheap_demo preset is supported.\");\n95:   }\n96:   // Model and generation controls are fixed server-side; caller overrides are rejected.\n97:   for (const [key, expected] of Object.entries(CHEAP_DEMO_PRESET)) {\n98:     if (key in value && value[key] !== expected) {\n99:       throw new BackendError(\"INVALID_ARGUMENT\", `Unsupported ${key}.`);\n100:     }\n101:   }\n102:   if (\"guestMediaId\" in value && value.guestMediaId !== undefined) {\n103:     if (typeof value.guestMediaId !== \"string\" || !value.guestMediaId) {\n104:       throw new BackendError(\"INVALID_ARGUMENT\", \"guestMediaId is invalid.\");\n105:     }\n106:     validateId(value.guestMediaId, \"guestMediaId\");\n107:     return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId, guestMediaId: value.guestMediaId };\n108:   }\n109:   return { ...identity, jobId, idempotencyKey, presetId: CHEAP_DEMO_PRESET.presetId };\n110: }\n111: \n112: export function parseAck(value: unknown): AckInput {\n113:   const identity = requireIdentity(value);\n114:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n115:   if (!isRecord(value) || !Number.isSafeInteger(value.manifestVersion) || Number(value.manifestVersion) < 1) {\n116:     throw new BackendError(\"INVALID_ARGUMENT\", \"A positive manifestVersion is required.\");\n117:   }\n118:   if (!isRecord(value.clipHashes)) throw new BackendError(\"INVALID_ARGUMENT\", \"clipHashes must be an object.\");\n119:   const keys = Object.keys(value.clipHashes).sort();\n120:   if (keys.join(\",\") !== [...REQUIRED_CAMERA_IDS].sort().join(\",\")) {\n121:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK must include one hash for each canonical camera clip.\");\n122:   }\n123:   const clipHashes: Record<string, string> = {};\n124:   for (const cameraId of REQUIRED_CAMERA_IDS) {\n125:     const hash = value.clipHashes[cameraId];\n126:     if (typeof hash !== \"string\" || !HASH_RE.test(hash)) {\n127:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hashes must be canonical SHA-256 hex values.\");\n128:     }\n129:     clipHashes[cameraId] = hash;\n130:   }\n131:   return { ...identity, manifestVersion: Number(value.manifestVersion), clipHashes };\n132: }\n133: \n134: export function parseCurrentManifestInput(value: unknown): CurrentManifestInput {\n135:   const identity = requireIdentity(value);\n136:   if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n137:   return identity;\n138: }\n139: \n140: export interface JoinPartyInput extends Identity {\n141:   joinPin?: string;\n142: }\n143: \n144: /** Exactly six ASCII digits; leading zeros are significant. */\n145: export const JOIN_PIN_RE = /^[0-9]{6}$/;\n146: \n147: export function parseJoinPartyInput(value: unknown): JoinPartyInput {\n148:   if (!isRecord(value) || typeof value.partyId !== \"string\" || !value.partyId ||\n149:       typeof value.deviceId !== \"string\" || !value.deviceId) {\n150:     throw new BackendError(\"UNAUTHENTICATED\", \"A registered partyId and deviceId are required.\");\n151:   }\n152:   const partyId = validateId(value.partyId, \"partyId\");\n153:   const deviceId = validateId(value.deviceId, \"deviceId\");\n154:   if (typeof value.channelId !== \"string\" || !value.channelId) {\n155:     throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n156:   }\n157:   const channelId = validateId(value.channelId, \"channelId\");\n158:   if (value.joinPin === undefined) {\n159:     return { partyId, deviceId, channelId };\n160:   }\n161:   if (typeof value.joinPin !== \"string\" || !JOIN_PIN_RE.test(value.joinPin)) {\n162:     throw new BackendError(\"INVALID_ARGUMENT\", \"joinPin must be six digits.\");\n163:   }\n164:   return { partyId, deviceId, channelId, joinPin: value.joinPin };\n165: }\n166: \n167: export function validateId(value: unknown, label: string): string {\n168:   if (typeof value !== \"string\" || !ID_RE.test(value)) {\n169:     throw new BackendError(\"INVALID_ARGUMENT\", `${label} is invalid.`);\n170:   }\n171:   return value;\n172: }\n173: \n174: export function validateCanonicalClips(clips: unknown): asserts clips is CanonicalClip[] {\n175:   if (!Array.isArray(clips) || clips.length !== REQUIRED_CAMERA_IDS.length) {\n176:     throw new BackendError(\"MANIFEST_MISMATCH\", \"A manifest must contain exactly four camera clips.\");\n177:   }\n178:   const byCamera = new Map<string, CanonicalClip>();\n179:   for (const raw of clips) {\n180:     if (!isRecord(raw) || typeof raw.cameraId !== \"string\" ||\n181:         !REQUIRED_CAMERA_IDS.includes(raw.cameraId as (typeof REQUIRED_CAMERA_IDS)[number]) ||\n182:         typeof raw.objectPath !== \"string\" || typeof raw.sha256 !== \"string\" || !HASH_RE.test(raw.sha256) ||\n183:         !Number.isSafeInteger(raw.sizeBytes) || Number(raw.sizeBytes) <= 0 ||\n184:         (!Number.isSafeInteger(raw.durationMs) || (Number(raw.durationMs) !== 2000 && Number(raw.durationMs) !== 5000)) ||\n185:         typeof raw.expiresAt !== \"string\" || !Number.isFinite(Date.parse(raw.expiresAt))) {\n186:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest clip fields are invalid.\");\n187:     }\n188:     if (byCamera.has(raw.cameraId)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Duplicate camera clip.\");\n189:     byCamera.set(raw.cameraId, raw as unknown as CanonicalClip);\n190:   }\n191:   if (REQUIRED_CAMERA_IDS.some((cameraId) => !byCamera.has(cameraId))) {\n192:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest camera set is incomplete.\");\n193:   }\n194: }\n195: \n196: export function canonicalManifestHash(manifest: Pick<DeliveryManifest, \"partyId\" | \"channelId\" | \"version\" | \"cameraClips\">): string {\n197:   const canonical = {\n198:     partyId: manifest.partyId,\n199:     channelId: manifest.channelId,\n200:     version: manifest.version,\n201:     cameraClips: [...manifest.cameraClips]\n202:       .sort((a, b) => a.cameraId.localeCompare(b.cameraId))\n203:       .map(({ cameraId, sha256, sizeBytes, durationMs }) => ({ cameraId, sha256, sizeBytes, durationMs })),\n204:   };\n205:   return createHash(\"sha256\").update(JSON.stringify(canonical)).digest(\"hex\");\n206: }\n207: \n208: export function ackIdempotencyKey(deviceId: string, channelId: string, manifestVersion: number): string {\n209:   return createHash(\"sha256\").update(`${deviceId}\\n${channelId}\\n${manifestVersion}`).digest(\"hex\");\n210: }\n211: \n212: export function isErrorCode(value: unknown): value is ErrorCode {\n213:   return typeof value === \"string\" && (ERROR_CODES as readonly string[]).includes(value);\n214: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929af92476a59c2863524f6bb85b"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/contracts.ts\"}"},"time":{"start":1793460992562,"end":1793460992649}}}}
{"type":"tool_use","timestamp":1793460992650,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929afa36001o5grDXhwZClhiS","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929af735001CaLTASv2oiGcuk","type":"tool","id":"call_01a1929af96375a997d5f12a99491cfb","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/config.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/config.ts, lines 1-115\n1: export const REGION = \"us-central1\";\n2: // v2 storage triggers must live in the bucket's region, not the functions\n3: // default. The ingest bucket is US-EAST1, so only the object-finalized\n4: // trigger is pinned here; every other function stays on REGION.\n5: export const STORAGE_TRIGGER_REGION = \"us-east1\";\n6: export const SCHEMA_VERSION = 1;\n7: /**\n8:  * Generation task worker memory headroom for ffmpeg normalization.\n9:  * Linux ffmpeg plus the ~147MB packaged runtime plus frame buffers OOM at the\n10:  * default 256MiB (\"Memory limit of 256 MiB exceeded\"); 1GiB gives the worker\n11:  * explicit headroom. Referenced by runGeneration in src/index.ts and floored\n12:  * (>= 512MiB) by tools/deploy_preflight.ts.\n13:  */\n14: export const GENERATION_WORKER_MEMORY = \"1GiB\" as const;\n15: export const DELIVERY_URL_TTL_SECONDS = 15 * 60;\n16: export const MEDIA_RETENTION_MS = 24 * 60 * 60 * 1000;\n17: export const REQUIRED_CAMERA_IDS = [\"CAM-01\", \"CAM-02\", \"CAM-03\", \"CAM-04\"] as const;\n18: \n19: /** Generation is inert unless an operator explicitly opts in. */\n20: export function isGenerationEnabled(environment: NodeJS.ProcessEnv = process.env): boolean {\n21:   return environment.GENERATION_ENABLED === \"true\";\n22: }\n23: \n24: export const CHEAP_DEMO_PRESET = Object.freeze({\n25:   presetId: \"cheap_demo\" as const,\n26:   modelId: \"wan3.0-video\" as const,\n27:   region: \"singapore\" as const,\n28:   resolution: \"480P\" as const,\n29:   secondsOut: 2 as const,\n30:   aspectRatio: \"16:9\" as const,\n31:   audio: false as const,\n32:   outputs: 1 as const,\n33:   autoUpscale: false as const,\n34: });\n35: \n36: /**\n37:  * Owner-approved STEP 2 cameo batch preset (single approved batch only).\n38:  *\n39:  * Separate from cheap_demo, which is never altered: 5 seconds, 480p, silent,\n40:  * 1 output, exactly ONE provider-generated camera slot (CAM-01) plus three\n41:  * local fixture slots, reference-image input via the validated guest binding.\n42:  * Text-only requests are rejected for this preset; it exists solely for the\n43:  * consented-reference batch.\n44:  *\n45:  * Model choice: happyhorse-1.1-r2v (reference-image-to-video). The checked-in\n46:  * adapter performs no per-model capability validation and the repo carries no\n47:  * offline documentation establishing that wan3.0-video accepts a\n48:  * reference_image input at a 5-second duration, so mapping the 5s\n49:  * reference-bound batch to the r2v (reference-to-video) model is the\n50:  * technically safer call. Verified offline via serialization fixtures only;\n51:  * no provider network call was made.\n52:  *\n53:  * Billing caveat (surfaced, never estimated): reference inputs can bill\n54:  * input duration — the adapter surfaces the provider's realized\n55:  * usage.input_video_duration as secondsIn, and Token Plan Credits may differ\n56:  * from list prices. Only realized console Credits are billable truth.\n57:  */\n58: export const CAMEO_DEMO_PRESET = Object.freeze({\n59:   presetId: \"cameo_demo\" as const,\n60:   modelId: \"happyhorse-1.1-r2v\" as const,\n61:   region: \"singapore\" as const,\n62:   resolution: \"480P\" as const,\n63:   secondsOut: 5 as const,\n64:   aspectRatio: \"16:9\" as const,\n65:   audio: false as const,\n66:   outputs: 1 as const,\n67:   autoUpscale: false as const,\n68: });\n69: \n70: /**\n71:  * Fixed server-side prompt for the STEP 2 cameo batch. Baked in exactly as\n72:  * owner-approved; never caller-supplied, never logged.\n73:  */\n74: export const CAMEO_DEMO_PROMPT =\n75:   \"Create a 5-second, fully 2D animated clip in the style of classic Scooby-Doo. \" +\n76:   \"Use the person in V2 as the character reference, preserving his glasses, hair, beard, and outfit, all fully drawn. \" +\n77:   \"In a spooky mansion hallway with crooked portraits, cobwebs, and flickering lamps, the terrified person runs left to right \" +\n78:   \"while a goofy, lumbering green monster chases close behind. \" +\n79:   \"Use one continuous side-tracking shot, keeping both characters visible. \" +\n80:   \"0-2 seconds: The person sprints with exaggerated cartoon strides while the monster reaches toward him. \" +\n81:   \"2-4 seconds: He glances backward, eyes widening, then accelerates with comically spinning legs. \" +\n82:   \"4-5 seconds: Both race through an open doorway and disappear offscreen. \" +\n83:   \"Bold ink outlines, flat cel shading, hand-painted purple-and-teal backgrounds, expressive faces, \" +\n84:   \"elastic cartoon movement, and playful spooky slapstick. \" +\n85:   \"No photorealism, 3D rendering, gore, text, or changes to the person's identity.\";\n86: \n87: /** Guest upload/consent controls. Server-side only; never trust caller-supplied paths. */\n88: export const GUEST_CONSENT_TEXT_VERSION = \"v1\";\n89: export const GUEST_CONSENT_PURPOSE = \"guest_cameo\";\n90: /** Short-lived upload capability lifetime (signed PUT bound to object + content type). */\n91: export const GUEST_UPLOAD_TTL_MS = 15 * 60 * 1000;\n92: /** Abandoned/expired guest inputs are removed within a capped 24h deadline. */\n93: export const GUEST_INPUT_TTL_MS = 24 * 60 * 60 * 1000;\n94: export const GUEST_MAX_IMAGE_BYTES = 10 * 1024 * 1024;\n95: export const GUEST_ALLOWED_CONTENT_TYPES = [\"image/jpeg\", \"image/png\"] as const;\n96: export type GuestAllowedContentType = (typeof GUEST_ALLOWED_CONTENT_TYPES)[number];\n97: /** Exactly one provider-generated camera in a guest-bound job; the rest are local fixtures. */\n98: export const GUEST_PROVIDER_CAMERA_ID = \"CAM-01\" as const;\n99: \n100: export const ERROR_CODES = [\n101:   \"UNAUTHENTICATED\",\n102:   \"FORBIDDEN\",\n103:   \"MANIFEST_MISMATCH\",\n104:   \"CLIP_EXPIRED\",\n105:   \"PROVIDER_UNAVAILABLE\",\n106:   \"BUDGET_EXCEEDED\",\n107:   \"INVALID_ARGUMENT\",\n108:   \"NOT_FOUND\",\n109:   \"INTERNAL\",\n110: ] as const;\n111: \n112: export type ErrorCode = (typeof ERROR_CODES)[number];\n113: \n114: export const JOB_STATES = [\"queued\", \"running\", \"ready\", \"delivering\", \"purged\", \"failed\", \"expired\"] as const;\n115: export type JobState = (typeof JOB_STATES)[number];","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/config.ts, lines 1-115\n1: export const REGION = \"us-central1\";\n2: // v2 storage triggers must live in the bucket's region, not the functions\n3: // default. The ingest bucket is US-EAST1, so only the object-finalized\n4: // trigger is pinned here; every other function stays on REGION.\n5: export const STORAGE_TRIGGER_REGION = \"us-east1\";\n6: export const SCHEMA_VERSION = 1;\n7: /**\n8:  * Generation task worker memory headroom for ffmpeg normalization.\n9:  * Linux ffmpeg plus the ~147MB packaged runtime plus frame buffers OOM at the\n10:  * default 256MiB (\"Memory limit of 256 MiB exceeded\"); 1GiB gives the worker\n11:  * explicit headroom. Referenced by runGeneration in src/index.ts and floored\n12:  * (>= 512MiB) by tools/deploy_preflight.ts.\n13:  */\n14: export const GENERATION_WORKER_MEMORY = \"1GiB\" as const;\n15: export const DELIVERY_URL_TTL_SECONDS = 15 * 60;\n16: export const MEDIA_RETENTION_MS = 24 * 60 * 60 * 1000;\n17: export const REQUIRED_CAMERA_IDS = [\"CAM-01\", \"CAM-02\", \"CAM-03\", \"CAM-04\"] as const;\n18: \n19: /** Generation is inert unless an operator explicitly opts in. */\n20: exp