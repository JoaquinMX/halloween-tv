e);\n123:     if (request.created) {\n124:       const task: GenerationTask = {\n125:         partyId: request.partyId,\n126:         deviceId: request.deviceId,\n127:         channelId: request.channelId,\n128:         jobId: request.jobId,\n129:         idempotencyKey: request.idempotencyKey,\n130:       };\n131:       try {\n132:         await enqueue(task);\n133:       } catch {\n134:         await generation.failEnqueue(task);\n135:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation task could not be queued.\");\n136:       }\n137:     }\n138:     return { jobId: request.jobId, state: request.state, created: request.created };\n139:   }\n140: \n141:   async function runGeneration(task: GenerationTask) {\n142:     if (!generation) throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation is not enabled.\");\n143:     return generation.runGeneration(task);\n144:   }\n145: \n146:   async function normalizeAndStage(partyId: string, jobId: string, cameraId: CameraId, result: ProviderResult) {\n147:     if (!generation) throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation is not enabled.\");\n148:     return generation.normalizeAndStage(partyId, jobId, cameraId, result);\n149:   }\n150: \n151:   async function publishManifest(partyId: string, jobId: string, idempotencyKey: string) {\n152:     if (!generation) throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation is not enabled.\");\n153:     return generation.publishManifest(partyId, jobId, idempotencyKey);\n154:   }\n155: \n156:   return {\n157:     requestGeneration,\n158:     runGeneration,\n159:     normalizeAndStage,\n160:     publishManifest,\n161:     getCurrentManifest: delivery.getCurrentManifest,\n162:     getDeliveryUrls: delivery.getDeliveryUrls,\n163:     acknowledgeDelivery: delivery.acknowledgeDelivery,\n164:     listPartyDevices: guestList.listPartyDevices,\n165:     joinParty: joinPartyService.joinParty,\n166:     createHostInvite: hostJoin.createHostInvite,\n167:     joinHost: hostJoin.joinHost,\n168:     listHostVideos: hostMedia.listHostVideos,\n169:     generateHostVideo: hostMedia.generateHostVideo,\n170:     getHostVideoPreview: hostMedia.getHostVideoPreview,\n171:     deleteHostVideo: hostMedia.deleteHostVideo,\n172:     requestGuestUpload: guestUpload.requestGuestUpload,\n173:     completeGuestUpload: guestUpload.completeGuestUpload,\n174:     getGuestMediaStatus: guestUpload.getGuestMediaStatus,\n175:     withdrawGuestMedia: guestUpload.withdrawGuestMedia,\n176:     handleGuestIngestFinalized: guestUpload.handleIngestFinalized,\n177:   };\n178: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3382f73d2bef97e1373c52221"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/runtime.ts\"}"},"time":{"start":1793463629946,"end":1793463630480}}}}
