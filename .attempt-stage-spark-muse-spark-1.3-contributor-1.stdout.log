export type SupportedCameraCount = (typeof SUPPORTED_CAMERA_COUNTS)[number];\n27: \n28: /** First-N canonical camera ids for a supported count, in wall order. */\n29: export function expectedCameraIds(count: number): readonly string[] {\n30:   if (!(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(count)) {\n31:     throw new Error(`Unsupported camera count ${count}; expected one of ${SUPPORTED_CAMERA_COUNTS.join(\", \")}.`);\n32:   }\n33:   return REQUIRED_CAMERA_IDS.slice(0, count);\n34: }\n35: \n36: /** Short-lived host-invite capability lifetime (TV-minted, phone-redeemed). */\n37: export const HOST_INVITE_TTL_MS = 5 * 60 * 1000;\n38: /** TTL for separately referenced host preview objects (seed catalog). */\n39: export const HOST_PREVIEW_TTL_MS = 24 * 60 * 60 * 1000;\n40: \n41: /** Preview object path: separately referenced from delivery objects so an ACK purge never removes previews. */\n42: export function hostPreviewObjectPath(partyId: string, seedId: string, cameraId: string): string {\n43:   return `parties/${partyId}/hostPreviews/${seedId}/${cameraId}.mp4`;\n44: }\n45: \n46: /** Generation is inert unless an operator explicitly opts in. */\n47: export function isGenerationEnabled(environment: NodeJS.ProcessEnv = process.env): boolean {\n48:   return environment.GENERATION_ENABLED === \"true\";\n49: }\n50: \n51: export const CHEAP_DEMO_PRESET = Object.freeze({\n52:   presetId: \"cheap_demo\" as const,\n53:   modelId: \"wan3.0-video\" as const,\n54:   region: \"singapore\" as const,\n55:   resolution: \"480P\" as const,\n56:   secondsOut: 2 as const,\n57:   aspectRatio: \"16:9\" as const,\n58:   audio: false as const,\n59:   outputs: 1 as const,\n60:   autoUpscale: false as const,\n61: });\n62: \n63: /**\n64:  * Owner-approved STEP 2 cameo batch preset (single approved batch only).\n65:  *\n66:  * Separate from cheap_demo, which is never altered: 5 seconds, 480p, silent,\n67:  * 1 output, exactly ONE provider-generated camera slot (CAM-01) plus three\n