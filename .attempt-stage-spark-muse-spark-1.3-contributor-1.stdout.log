    byCamera.set(cameraId, { cameraId, objectPath: clip.objectPath, sha256: clip.sha256 });\n529:   }\n530:   if (REQUIRED_CAMERA_IDS.some((cameraId) => !byCamera.has(cameraId))) return mismatch();\n531:   return { jobId: String(value.jobId), clips: REQUIRED_CAMERA_IDS.map((cameraId) => byCamera.get(cameraId)!) };\n532: }\n533: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/delivery.ts, lines 1-533\n1: import { createHash } from \"node:crypto\";\n2: import { Bucket, File } from \"@google-cloud/storage\";\n3: import { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\n4: import {\n5:   AckInput,\n6:   ackIdempotencyKey,\n7:   BackendError,\n8:   CanonicalClip,\n9:   CurrentManifestInput,\n10:   DeliveryManifest,\n11:   Identity,\n12:   canonicalManifestHash,\n13:   parseAck,\n14:   parseCurrentManifestInput,\n15:   parseRequestGeneration,\n16:   RequestGenerationInput,\n17:   requireIdentity,\n18:   validateCanonicalClips,\n19: } from \"./contracts\";\n20: import {\n21:   CHEAP_DEMO_PRESET,\n22:   DELIVERY_URL_TTL_SECONDS,\n23:   MEDIA_RETENTION_MS,\n24:   REQUIRED_CAMERA_IDS,\n25:   SCHEMA_VERSION,\n26: } from \"./config\";\n27: import { assertRegisteredPartyDevice } from \"./auth\";\n28: \n29: export interface GeneratedClipInput {\n30:   cameraId: string;\n31:   sourcePath: string;\n32:   sha256: string;\n33:   durationMs: number;\n34:   sizeBytes: number;\n35: }\n36: \n37: export interface GenerationTask {\n38:   partyId: string;\n39:   deviceId: string;\n40:   channelId: string;\n41:   jobId: string;\n42:   idempotencyKey: string;\n43: }\n44: \n45: export interface DeliveryServiceOptions {\n46:   db: Firestore;\n47:   bucket: Bucket;\n48:   enqueueGeneration?: (task: GenerationTask) => Promise<void>;\n49:   generationRunner?: (job: FirebaseFirestore.DocumentData) => Promise<void>;\n50:   signReadUrl?: (file: File, expiresAt: