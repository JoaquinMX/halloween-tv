vices = createGuestListService({ db });\n21:     const listing = await services.listPartyDevices({ partyId, deviceId: tvDevice, channelId });\n22:     assert.equal(listing.partyId, partyId);\n23:     assert.equal(listing.channelId, channelId);\n24:     assert.equal(listing.tvDeviceId, tvDevice);\n25:     assert.deepEqual(listing.devices.map((entry) => entry.deviceId), [\"g-aaa\", \"g-bbb\"]);\n26:     assert.ok(listing.devices.every((entry) => entry.role === \"guest\" && entry.status === \"active\"));\n27:     // The TV itself is never listed as a guest code.\n28:     assert.ok(!listing.devices.some((entry) => entry.deviceId === tvDevice));\n29: \n30:     await assert.rejects(services.listPartyDevices({ partyId, deviceId: \"g-aaa\", channelId }),\n31:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n32:     await assert.rejects(services.listPartyDevices({ partyId, deviceId: \"stranger\", channelId }),\n33:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n34:     await assert.rejects(services.listPartyDevices({ partyId, deviceId: tvDevice }),\n35:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n36: \n37:     // The exported runtime composition serves the same handler (preflight gate).\n38:     const runtime = createRuntimeServices({ db, bucket });\n39:     const runtimeListing = await runtime.listPartyDevices({ partyId, deviceId: tvDevice, channelId });\n40:     assert.equal(runtimeListing.devices.length, 2);\n41:   } finally {\n42:     await db.recursiveDelete(db.doc(`parties/${partyId}`));\n43:     await disposeEmulatorContext(app);\n44:   }\n45: });\n46: \n47: test(\"host listing tolerates label-absent guests and surfaces joinPin only when configured\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n48:   const { app, db, bucket } = await createEmulatorContext();\n49:   const partyId = randomPartyId();\n50:   const