{"type":"tool_use","timestamp":1793461696186,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a5aaaa0018PStUZixh8VVp6","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a5a325001MC2iVrLs5D38Ja","type":"tool","id":"call_01a192a5a9f7725ea507c44ef50fb8ee","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/bootstrap/playback_dependencies.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/bootstrap/playback_dependencies.dart, lines 1-260\n1: /// Production composition for verified playback, Firebase delivery, and\n2: /// party-scoped settings.\n3: library;\n4: \n5: import 'dart:io';\n6: \n7: import 'package:cloud_firestore/cloud_firestore.dart';\n8: import 'package:cloud_functions/cloud_functions.dart';\n9: import 'package:channel_cctv/channel_cctv.dart';\n10: import 'package:core_cache/core_cache.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: import 'package:firebase_core/firebase_core.dart';\n13: import 'package:infra_firestore/infra_firestore.dart';\n14: import 'package:infra_settings/infra_settings.dart'\n15:     show SharedPreferencesSettings;\n16: import 'package:infra_signed_urls/infra_signed_urls.dart';\n17: import 'package:kernel_app/kernel_app.dart';\n18: import 'package:path_provider/path_provider.dart';\n19: \n20: import 'package:tv_app/src/config/backend_config.dart';\n21: import 'package:tv_app/src/wall/guest_codes.dart';\n22: import 'package:tv_app/src/wall/live_wall_session.dart';\n23: import 'package:tv_app/src/wall/manifest_store.dart';\n24: import 'package:tv_app/src/wall/wall_boot.dart';\n25: \n26: typedef FirebaseBootstrap = Future<void> Function(BackendConfig config);\n27: \n28: /// Fully composed app dependencies. Creating these directories and settings\n29: /// does not start remote work; the live stream begins only after offline boot.\n30: final class PlaybackDependencies {\n31:   PlaybackDependencies._({\n32:     required this.config,\n33:     required this.preparePlayback,\n34:     required this.settings,\n35:     required this.liveSession,\n36:     required this.remoteUnavailableReason,\n37:     required this.manifestIndexStore,\n38:     required this.cacheStore,\n39:     required this.guestCodeClient,\n40:   });\n41: \n42:   final BackendConfig config;\n43:   final PreparePlayback preparePlayback;\n44:   final SettingsPort settings;\n45:   final LiveWallSession? liveSession;\n46: \n47:   /// Host guest-code reader; null unless the live backend is configured.\n48:   ///\n49:   /// Null keeps the recovery panel on its offline actions only.\n50:   final GuestCodeClient? guestCodeClient;\n51:   final String? remoteUnavailableReason;\n52:   final ManifestIndexStore manifestIndexStore;\n53:   final CacheStore cacheStore;\n54: \n55:   static Future<PlaybackDependencies> create({\n56:     BackendConfig? config,\n57:     Directory? supportDirectory,\n58:     Directory? stagingDirectory,\n59:     FirebaseBootstrap? firebaseBootstrap,\n60:     FirebaseFirestore? firestoreOverride,\n61:     FirebaseFunctions? functionsOverride,\n62:   }) async {\n63:     final BackendConfig resolved = config ?? BackendConfig.fromEnvironment();\n64:     final Directory support =\n65:         supportDirectory ?? await getApplicationSupportDirectory();\n66:     final Directory staging = stagingDirectory ?? await getTemporaryDirectory();\n67:     final Directory root = Directory(_join(support.path, 'halloween-tv'));\n68:     final Directory mediaRoot = Directory(_join(root.path, 'media-cache'));\n69:     final Directory indexRoot = Directory(_join(root.path, 'manifest-index'));\n70:     final Directory downloadRoot = Directory(\n71:       _join(staging.path, 'halloween-tv-downloads'),\n72:     );\n73:     await Future.wait<void>(<Future<void>>[\n74:       mediaRoot.create(recursive: true),\n75:       indexRoot.create(recursive: true),\n76:       downloadRoot.create(recursive: true),\n77:     ]);\n78: \n79:     final FileCacheStore cache = FileCacheStore(\n80:       mediaRoot,\n81:       indexRoot: indexRoot,\n82:     );\n83:     final FileManifestIndexStore manifestIndex = FileManifestIndexStore(\n84:       indexRoot,\n85:     );\n86:     final SharedPreferencesSettings settings = SharedPreferencesSettings();\n87: \n88:     FirebaseFirestore? firestore;\n89:     FirebaseFunctions? functions;\n90:     String? unavailable;\n91:     if (resolved.isLiveRequested && !resolved.isLiveConfigured) {\n92:       unavailable = resolved.error ?? 'live configuration is incomplete';\n93:     } else if (resolved.isLiveConfigured) {\n94:       try {\n95:         await (firebaseBootstrap ?? _initializeFirebase)(resolved);\n96:         firestore = firestoreOverride ?? FirebaseFirestore.instance;\n97:         if (resolved.useEmulator) {\n98:           firestore.useFirestoreEmulator(\n99:             resolved.firestoreEmulatorHost,\n100:             resolved.firestoreEmulatorPort!,\n101:           );\n102:         }\n103:         functions =\n104:             functionsOverride ??\n105:             FirebaseFunctions.instanceFor(region: resolved.functionsRegion);\n106:         if (resolved.useEmulator) {\n107:           functions.useFunctionsEmulator(\n108:             resolved.functionsEmulatorHost,\n109:             resolved.functionsEmulatorPort!,\n110:           );\n111:         }\n112:       } on Object catch (error) {\n113:         unavailable = 'Firebase could not be initialized: $error';\n114:         firestore = null;\n115:         functions = null;\n116:       }\n117:     }\n118: \n119:     late final PreparePlayback prepare;\n120:     LiveWallSession? live;\n121:     GuestCodeClient? guestCodes;\n122:     if (resolved.isLiveConfigured &&\n123:         unavailable == null &&\n124:         firestore != null &&\n125:         functions != null) {\n126:       final FirebaseTvIdentity identity = FirebaseTvIdentity(\n127:         partyId: resolved.partyId,\n128:         deviceId: resolved.deviceId,\n129:       );\n130:       final FirebaseDeliveryClient delivery = FirebaseDeliveryClient(\n131:         identity: identity,\n132:         functions: functions,\n133:       );\n134:       // Manifests flow through the registered getCurrentManifest callable.\n135:       // Direct Firestore manifest reads stay denied by backend/firestore.rules;\n136:       // passing no firestore instance here guarantees the source cannot fall\n137:       // back to snapshot listeners even if the seam default changes.\n138:       final FirebaseManifestSource source = FirebaseManifestSource(\n139:         watchDocumentData: FirebaseCallableManifestTransport(\n140:           identity: identity,\n141:           functions: functions,\n142:         ).watchDocumentData,\n143:       );\n144:       final FirebaseUrlSigner signer = FirebaseUrlSigner(\n145:         deliveryClient: delivery,\n146:         channelId: hauntedSurveillanceChannelId,\n147:       );\n148:       final HttpsMediaDownloader downloader = HttpsMediaDownloader(\n149:         tempDirectory: downloadRoot,\n150:         expiredUrlRefresher: (ClipDescriptor clip, Uri expired) => delivery\n151:             .refreshUrlFor(channelId: hauntedSurveillanceChannelId, clip: clip),\n152:       );\n153:       prepare = PreparePlayback(\n154:         manifestSource: source,\n155:         urlSigner: signer,\n156:         downloader: downloader,\n157:         cacheStore: cache,\n158:         manifestIndexStore: manifestIndex,\n159:         acknowledger: delivery,\n160:       );\n161:       live = LiveWallSession(\n162:         partyId: resolved.partyId,\n163:         channelId: hauntedSurveillanceChannelId,\n164:         manifestSource: source,\n165:         preparation: prepare,\n166:       );\n167:       // Host panel reader: the TV device lists guest codes over the\n168:       // TV-only listPartyDevices callable. Null when live is unavailable\n169:       // keeps the recovery panel on its offline actions only.\n170:       guestCodes = GuestCodeClient.cloudFunctions(\n171:         functions: functions,\n172:         partyId: resolved.partyId,\n173:         deviceId: resolved.deviceId,\n174:         channelId: hauntedSurveillanceChannelId,\n175:       );\n176:     } else {\n177:       prepare = PreparePlayback(\n178:         manifestSource: _UnavailableManifestSource(),\n179:         urlSigner: _UnavailableUrlSigner(),\n180:         downloader: _UnavailableDownloader(),\n181:         cacheStore: cache,\n182:         manifestIndexStore: manifestIndex,\n183:         acknowledger: _UnavailableAcknowledger(),\n184:       );\n185:     }\n186: \n187:     return PlaybackDependencies._(\n188:       config: resolved,\n189:       preparePlayback: prepare,\n190:       settings: settings,\n191:       liveSession: live,\n192:       guestCodeClient: guestCodes,\n193:       remoteUnavailableReason: unavailable,\n194:       manifestIndexStore: manifestIndex,\n195:       cacheStore: cache,\n196:     );\n197:   }\n198: \n199:   /// Boot object uses the configured party and keeps legacy manifest prefs\n200:   /// physically and logically separate from the durable remote index.\n201:   WallBoot createWallBoot({\n202:     WallManifestStore store = const PrefsManifestStore(),\n203:   }) => WallBoot(\n204:     store: store,\n205:     partyId: config.partyIdOrOffline,\n206:     tvDeviceId: config.deviceId,\n207:     guestCodeClient: guestCodeClient,\n208:     preparePlayback: preparePlayback,\n209:     liveSession: liveSession,\n210:     settings: settings,\n211:     remoteUnavailableReason: remoteUnavailableReason,\n212:     manifestIndexStore: manifestIndexStore,\n213:     cacheStore: cacheStore,\n214:   );\n215: \n216:   static Future<void> _initializeFirebase(BackendConfig config) async {\n217:     if (Firebase.apps.isEmpty) {\n218:       await Firebase.initializeApp(options: config.firebaseOptions!);\n219:     }\n220:   }\n221: }\n222: \n223: final class _UnavailableManifestSource\n224:     implements ManifestSource<PlaybackManifest> {\n225:   @override\n226:   Stream<PlaybackManifest> watchCurrent({\n227:     required String partyId,\n228:     required String channelId,\n229:   }) =>\n230:       Stream<PlaybackManifest>.error(StateError('remote playback is disabled'));\n231: }\n232: \n233: final class _UnavailableUrlSigner implements UrlSigner {\n234:   @override\n235:   Future<Uri> signFor(\n236:     ClipDescriptor clip, {\n237:     Duration expiry = const Duration(hours: 1),\n238:   }) => Future<Uri>.error(StateError('remote playback is disabled'));\n239: }\n240: \n241: final class _UnavailableDownloader implements MediaDownloader {\n242:   @override\n243:   Future<DownloadedMedia> downloadAndVerify(ClipDescriptor clip, Uri source) =>\n244:       Future<DownloadedMedia>.error(StateError('remote playback is disabled'));\n245: }\n246: \n247: final class _UnavailableAcknowledger implements DeliveryAcknowledger {\n248:   @override\n249:   Future<void> acknowledge({\n250:     required String partyId,\n251:     required String channelId,\n252:     required int manifestVersion,\n253:     required Map<String, String> verifiedClipHashes,\n254:   }) => Future<void>.error(StateError('remote playback is disabled'));\n255: }\n256: \n257: String _join(String parent, String child) =>\n258:     parent.endsWith(Platform.pathSeparator)\n259:     ? '$parent$child'\n260:     : '$parent${Platform.pathSeparator}$child';","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/bootstrap/playback_dependencies.dart, lines 1-260\n1: /// Production composition for verified playback, Firebase delivery, and\n2: /// party-scoped settings.\n3: library;\n4: \n5: import 'dart:io';\n6: \n7: import 'package:cloud_firestore/cloud_firestore.dart';\n8: import 'package:cloud_functions/cloud_functions.dart';\n9: import 'package:channel_cctv/channel_cctv.dart';\