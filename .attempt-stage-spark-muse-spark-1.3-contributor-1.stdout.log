) {\n37:   return db.doc(`parties/${partyId}/jobs/${jobId}`);\n38: }\n39: \n40: function currentManifestRef(db: Firestore, partyId: string, channelId: string) {\n41:   return db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n42: }\n43: \n44: function budgetRef(db: Firestore, partyId: string) {\n45:   return db.doc(`parties/${partyId}/generationBudget/active`);\n46: }\n47: \n48: function deliveryObjectPath(partyId: string, channelId: string, version: number, cameraId: CameraId): string {\n49:   return `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`;\n50: }\n51: \n52: /**\n53:  * Persistence guard: signed reference URLs are in-flight only and must never\n54:  * reach Firestore job docs. The guest binding stores server-side state\n55:  * (objectPath + sourceHash + consentRevision) exclusively.\n56:  */\n57: function assertNoSignedReferenceUrl(value: unknown): void {\n58:   const serialized = JSON.stringify(value ?? null);\n59:   if (/https?:\\/\\//.test(serialized) && /signed/.test(serialized)) {\n60:     throw new BackendError(\"INTERNAL\", \"Signed reference URLs must never be persisted.\");\n61:   }\n62: }\n63: \n64: function exposedTimestamp(value: unknown): unknown {\n65:   if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n66:     return ((value as { toDate: () => Date }).toDate()).toISOString();\n67:   }\n68:   if (value instanceof Date) return value.toISOString();\n69:   return value;\n70: }\n71: \n72: /**\n73:  * Fake-only rehearsal marker. The operator rehearsal tool always sends\n74:  * `rehearsalOnly: true`; the marker is persisted on the job document and the\n75:  * worker resolves ONLY the offline fake provider for marked jobs, regardless\n76:  * of the deployed provider configuration. Requests without the marker take\n77:  * the unchanged default path. Any other marker value is rejected fail-closed\n78:  * so the flag can never be