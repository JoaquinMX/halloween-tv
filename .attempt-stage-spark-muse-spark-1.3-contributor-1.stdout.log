stResponse, fixture.requestGeneration.response);\n87:     assert.equal(enqueued, 1);\n88: \n89:     await db.doc(`parties/${partyId}/manifests/current_${fixture.manifest.channelId}`).set(fixture.manifest);\n90:     await Promise.all(fixture.manifest.cameraClips.map((clip) => bucket.file(clip.objectPath).save(Buffer.from(clip.cameraId))));\n91:     const currentManifest = await services.getCurrentManifest(fixture.getCurrentManifest.request);\n92:     assert.deepEqual(currentManifest, fixture.getCurrentManifest.response);\n93: \n94:     const delivery = await services.getDeliveryUrls(fixture.deliveryUrls.request);\n95:     assert.equal(delivery.manifestHash, fixture.deliveryUrls.response.manifestHash);\n96:     assert.equal(delivery.manifestVersion, fixture.deliveryUrls.response.manifestVersion);\n97:     assert.deepEqual(delivery.clips.map(({ cameraId, sha256, expiresAt }) => ({ cameraId, sha256, expiresAt, url: \"<signed-v4-read-url>\" })),\n98:       fixture.deliveryUrls.response.clips);\n99:     assert.ok(delivery.clips.every((clip) => clip.url.startsWith(\"https://signed.invalid/\")));\n100: \n101:     const ackResponse = await services.acknowledgeDelivery(fixture.acknowledgeDelivery.request);\n102:     assert.deepEqual(ackResponse, fixture.acknowledgeDelivery.response);\n103:     for (const clip of fixture.manifest.cameraClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n104:   } finally {\n105:     await clearParty(db, bucket, partyId);\n106:     await disposeEmulatorContext(app);\n107:   }\n108: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b12e5749e8794973fc6a90642"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/backend_contract_fixture.test.ts\"}"},"time":{"start":1793460999734,"end":1793460999759}}}}
{"type":"tool_use","timestamp":1793460999760,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b163b001T5sFKO63UGP8Ng","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929b0ee60016oSh7xFKkIwnhF","type":"tool","id":"call_01a1929b133c74d6a02a0afddef8095c","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/generation.test.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/generation.test.ts, lines 1-444\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { resolve } from \"node:path\";\n4: import test from \"node:test\";\n5: import { createGenerationServices } from \"../src/generation\";\n6: import { REQUIRED_CAMERA_IDS } from \"../src/config\";\n7: import { BackendError } from \"../src/contracts\";\n8: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n9: import { ProviderResult, ProviderTaskStatus, VideoGenerationRequest } from \"../src/video_generation_port\";\n10: import { reconcileUsage, usageLedgerId } from \"../src/usage\";\n11: import { buildCheapDemoRequest, validateCheapDemoControls, validateFetchableReferenceImage, validateVideoGenerationRequest } from \"../src/video_generation_port\";\n12: import { buildAlibabaSubmitBody } from \"../src/providers/alibaba\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: function expectCode(work: () => unknown, code: string): void {\n23:   assert.throws(work, (error: unknown) => error instanceof BackendError && error.errorCode === code);\n24: }\n25: \n26: test(\"cheap_demo generation request is fixed to one Singapore 480P silent output\", () => {\n27:   const request = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\");\n28:   assert.equal(request.modelId, \"wan3.0-video\");\n29:   assert.equal(request.region, \"singapore\");\n30:   assert.equal(request.resolution, \"480P\");\n31:   assert.equal(request.secondsOut, 2);\n32:   assert.equal(request.aspectRatio, \"16:9\");\n33:   assert.equal(request.audio, false);\n34:   assert.equal(request.outputs, 1);\n35:   assert.equal(request.autoUpscale, false);\n36:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", modelId: \"another-model\" }), \"INVALID_ARGUMENT\");\n37:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", resolution: \"720P\" }), \"INVALID_ARGUMENT\");\n38:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", secondsOut: 5 }), \"INVALID_ARGUMENT\");\n39:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", outputs: 2 }), \"INVALID_ARGUMENT\");\n40:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", audio: true }), \"INVALID_ARGUMENT\");\n41:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", media: [{ type: \"image\" }] }), \"INVALID_ARGUMENT\");\n42: });\n43: \n44: test(\"provider-bound references require a signed https URL, never a bare bucket path\", () => {\n45:   // Offline regression for the live-submit defect: the provider cannot fetch\n46:   // private GCS object paths, so any reference without a resolved signed https\n47:   // URL fails closed before transport. Consent/tombstone gates are unchanged.\n48:   const bare = {\n49:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n50:     sha256: \"a\".repeat(64),\n51:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n52:   };\n53:   expectCode(() => validateFetchableReferenceImage({ ...bare }), \"INVALID_ARGUMENT\");\n54:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"http://signed.invalid/photo.jpg\" }), \"INVALID_ARGUMENT\");\n55:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"gs://bucket/photo.jpg\" }), \"INVALID_ARGUMENT\");\n56:   expectCode(() => validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...bare })), \"INVALID_ARGUMENT\");\n57:   const resolved = { ...bare, url: \"https://signed.invalid/photo.jpg\" };\n58:   validateFetchableReferenceImage({ ...resolved });\n59:   validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...resolved }));\n60: });\n61: \n62: test(\"offline fake keeps the live fetchability gate for cheap_demo references\", async () => {\n63:   // Layering regression for the cycle-11 merge interaction: the offline fake\n64:   // resolves local bytes and never fetches, but it still enforces the same\n65:   // signed-https fetchability gate as the live adapter, so an unfetchable\n66:   // bare object-path reference can never be submitted on either boundary.\n67:   // The worker resolves the consented photo through signReferenceReadUrl\n68:   // (emulator tests wire the signing transport for that step); anything\n69:   // unresolved fails here with the same signed-URL shape. Consent and\n70:   // tombstone gates live one layer up and are unchanged.\n71:   const bare = {\n72:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n73:     sha256: \"a\".repeat(64),\n74:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n75:   };\n76:   const provider = new FakeVideoGenerationPort();\n77:   await assert.rejects(\n78:     provider.submit(buildCheapDemoRequest(\"job-cheap-bare\", \"idem-cheap-bare\", \"CAM-01\", { ...bare })),\n79:     /signed https URL/,\n80:   );\n81:   const submitted = await provider.submit(buildCheapDemoRequest(\"job-cheap-signed\", \"idem-cheap-signed\", \"CAM-01\", {\n82:     ...bare,\n83:     url: \"https://signed.invalid/photo.jpg\",\n84:   }));\n85:   assert.ok(submitted.taskId.startsWith(\"CAM-01__\"));\n86: });\n87: \n88: test(\"crash reconciliation never repeats an unpersisted billable submission\", {\n89:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n90: }, async () => {\n91:   const { app, db, bucket } = await createEmulatorContext();\n92:   const partyId = randomPartyId();\n93:   let submissions = 0;\n94:   const provider = {\n95:     async submit(_request: VideoGenerationRequest) { submissions += 1; return { taskId: \"should-not-be-submitted\" }; },\n96:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; },\n97:     async getResult(_taskId: string): Promise<ProviderResult> {\n98:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 };\n99:     },\n100:   };\n101:   const deviceId = \"tv-crash-recovery\";\n102:   const channelId = \"main\";\n103:   const jobId = \"job-uncertain-submit\";\n104:   const idempotencyKey = \"idem-uncertain-submit\";\n105:   try {\n106:     await seedParty(db, partyId, deviceId, channelId);\n107:     const services = createGenerationServices({ db, bucket, provider });\n108:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n109:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({\n110:       \"cameraAttempts.CAM-01.consumedAttempt\": true,\n111:       \"cameraAttempts.CAM-01.submissionState\": \"submitting\",\n112:     });\n113:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n114:       (error: unknown) => error instanceof BackendError && error.errorCode === \"PROVIDER_UNAVAILABLE\");\n115:     assert.equal(submissions, 0);\n116:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data();\n117:     assert.equal(job?.state, \"running\");\n118:     assert.equal(job?.status, \"reconciliation_required\");\n119:     assert.equal(job?.errorCode, \"PROVIDER_UNAVAILABLE\");\n120:     assert.equal(job?.reconciliationReason, \"SUBMISSION_OUTCOME_UNKNOWN\");\n121:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n122:     assert.equal(budget?.state, \"in_flight\");\n123:     await assert.rejects(services.requestGeneration({\n124:       partyId,\n125:       deviceId,\n126:       channelId,\n127:       jobId: \"job-blocked-by-uncertain-submit\",\n128:       idempotencyKey: \"idem-blocked-by-uncertain-submit\",\n129:       presetId: \"cheap_demo\",\n130:     }), (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n131:     assert.ok((await reconcileUsage(db)).some((issue) => issue.code === \"SUBMISSION_OUTCOME_UNKNOWN\"));\n132:   } finally {\n133:     await clearParty(db, bucket, partyId);\n134:     await disposeEmulatorContext(app);\n135:   }\n136: });\n137: \n138: test(\"registered anonymous request runs fake provider through normalization and atomic publish\", {\n139:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n140: }, async () => {\n141:   const { app, db, bucket } = await createEmulatorContext();\n142:   const partyId = randomPartyId();\n143:   const deviceId = \"tv-pilot\";\n144:   const channelId = \"main\";\n145:   const jobId = \"job-generation-e2e\";\n146:   const idempotencyKey = \"idem-generation-e2e\";\n147:   try {\n148:     await seedParty(db, partyId, deviceId, channelId);\n149:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({ version: 7 });\n150:     const services = createGenerationServices({\n151:       db,\n152:       bucket,\n153:       provider: new FakeVideoGenerationPort(),\n154:       pollIntervalMs: 1,\n155:       sleep: async () => undefined,\n156:     });\n157:     const input = { partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" };\n158:     const request = await services.requestGeneration(input);\n159:     assert.equal(request.state, \"queued\");\n160:     assert.equal(request.created, true);\n161:     assert.equal(request.manifestVersion, 8);\n162:     assert.ok(request.timestamp);\n163:     const duplicate = await services.requestGeneration(input);\n164:     assert.equal(duplicate.created, false);\n165:     await assert.rejects(services.requestGeneration({ ...input, jobId: \"job-budget-guard\", idempotencyKey: \"idem-budget-guard\" }),\n166:       (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n167:     await assert.rejects(services.requestGeneration({ ...input, partyId: \"unregistered-party\", jobId: \"job-unregistered\" }),\n168:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n169: \n170:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n171:     assert.deepEqual(run, { jobId, state: \"ready\", manifestVersion: 8 });\n172:     const repeated = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n173:     assert.equal(repeated.state, \"ready\");\n174: \n175:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n176:     assert.equal(manifest.version, 8);\n177:     assert.equal(manifest.cameraClips.length, 4);\n178:     assert.deepEqual(manifest.cameraClips.map((clip: { cameraId: string }) => clip.cameraId), [...REQUIRED_CAMERA_IDS]);\n179:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n180:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n181:       assert.equal(ledger.partyId, partyId);\n182:       assert.equal(ledger.deviceId, deviceId);\n183:       assert.equal(ledger.channelId, channelId);\n184:       assert.equal(ledger.manifestVersion, 8);\n185:       assert.equal(ledger.idempotencyKey, idempotencyKey);\n186:       assert.equal(ledger.success, true);\n187:       assert.equal(ledger.provider_task_id.startsWith(`${cameraId}__`), true);\n188:     }\n189:     assert.deepEqual(await reconcileUsage(db), []);\n190:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n191:     assert.equal(budget?.state, \"idle\");\n192:   } finally {\n193:     await clearParty(db, bucket, partyId);\n194:     await disposeEmulatorContext(app);\n195:   }\n196: });\n197: \n198: test(\"rehearsalOnly marker binds the worker to the fake provider when live is configured\", {\n199:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n200: }, async () => {\n201:   const { app, db, bucket } = await createEmulatorContext();\n202:   const partyId = randomPartyId();\n203:   /** Live-shaped stand-in: any submit reaching it would be billable work. */\n204:   class LiveSpyProvider {\n205:     submissions = 0;\n206:     async submit(_request: VideoGenerationRequest) {\n207:       this.submissions += 1;\n208:       return { taskId: \"live-billable-task-1\" };\n209:     }\n210:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; }\n211:     async getResult(_taskId: string): Promise<ProviderResult> {\n212:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 9 };\n213:     }\n214:   }\n215:   const deviceId = \"tv-rehearsal\";\n216:   const channelId = \"main\";\n217:   const jobId = \"job-rehearsal-marker\";\n218:   const idempotencyKey = \"idem-rehearsal-marker\";\n219:   try {\n220:     await seedParty(db, partyId, deviceId, channelId);\n221:     const live = new LiveSpyProvider();\n222:     const services = createGenerationServices({\n223:       db,\n224:       bucket,\n225:       provider: live,\n226:       pollIntervalMs: 1,\n227:       sleep: async () => undefined,\n228:     });\n229:     const request = await services.requestGeneration({\n230:       partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", rehearsalOnly: true,\n231:     });\n232:     assert.equal(request.created, true);\n233:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.rehearsalOnly, true);\n234:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n235:     assert.equal(run.state, \"ready\");\n236:     assert.equal(live.submissions, 0, \"a rehearsal-marked job must never reach the live provider\");\n237:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n238:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n239:       assert.match(ledger.provider_task_id, new RegExp(`^${cameraId}__[a-f0-9]{24}$`));\n240:       assert.equal(ledger.credits_charged, 0);\n241:     }\n242:     assert.deepEqual(await reconcileUsage(db), []);\n243:   } finally {\n244:     await clearParty(db, bucket, partyId);\n245:     await disposeEmulatorContext(app);\n246:   }\n247: });\n248: \n249: test(\"rehearsalOnly marker is validated, bound to the job, and optional\", {\n250:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n251: }, async () => {\n252:   const { app, db, bucket } = await createEmulatorContext();\n253:   const partyId = randomPartyId();\n254:   const deviceId = \"tv-marker\";\n255:   const channelId = \"main\";\n256:   try {\n257:     await seedParty(db, partyId, deviceId, channelId);\n258:     const services = createGenerationServices({\n259:       db,\n260:       bucket,\n261:       provider: new FakeVideoGenerationPort(),\n262:       pollIntervalMs: 1,\n263:       sleep: async () => undefined,\n264:     });\n265:     const base = { partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\", presetId: \"cheap_demo\" };\n266:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: \"true\" }),\n267:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n268:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: false }),\n269:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n270:     const marked = await services.requestGeneration({ ...base, rehearsalOnly: true });\n271:     assert.equal(marked.created, true);\n272:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-marker`).get()).data()?.rehearsalOnly, true);\n273:     const repeat = await services.requestGeneration({ ...base, rehearsalOnly: true });\n274:     assert.equal(repeat.created, false);\n275:     // The same job cannot be re-requested as an unmarked (live-path) job.\n276:     await assert.rejects(services.requestGeneration(base),\n277:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n278:     const status = await services.getGenerationStatus({ ...base, rehearsalOnly: true });\n279:     assert.equal(status.jobId, \"job-marker\");\n280:     // Run the marked job to release the party budget: the default path then stays marker-free.\n281:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\" });\n282:     assert.equal(run.state, \"ready\");\n283:     await services.requestGeneration({ partyId, deviceId, channelId, jobId: \"job-default\", idempotencyKey: \"idem-default\", presetId: \"cheap_demo\" });\n284:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-default`).get()).data()?.rehearsalOnly, undefined);\n285:   } finally {\n286:     await clearParty(db, bucket, partyId);\n287:     await disposeEmulatorContext(app);\n288:   }\n289: });\n290: \n291: test(\"request idempotency cannot be rebound to another device\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n292:   const { app, db, bucket } = await createEmulatorContext();\n293:   const partyId = randomPartyId();\n294:   try {\n295:     await seedParty(db, partyId, \"tv-1\", \"main\");\n296:     await seedParty(db, partyId, \"tv-2\", \"main\");\n297:     const services = createGenerationServices({ db, bucket, provider: new FakeVideoGenerationPort() });\n298:     const input = { partyId, deviceId: \"tv-1\", channelId: \"main\", jobId: \"job-rebind\", idempotencyKey: \"idem-rebind\", presetId: \"cheap_demo\" };\n299:     await services.requestGeneration(input);\n300:     await assert.rejects(services.requestGeneration({ ...input, deviceId: \"tv-2\" }),\n301:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n302:   } finally {\n303:     await clearParty(db, bucket, partyId);\n304:     await disposeEmulatorContext(app);\n305:   }\n306: });\n307: \n308: test(\"submit body uses the media-field form for references (no network)\", () => {\n309:   // Offline regression for the live r2v defect: the signed URL rides as\n310:   // input.media; sha256 / reference_image never enter the submitted JSON.\n311:   const reference = {\n312:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n313:     sha256: \"c\".repeat(64),\n314:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n315:     url: \"https://signed.invalid/media-photo.jpg\",\n316:   };\n317:   const body = buildAlibabaSubmitBody(buildCheapDemoRequest(\"job-media\", \"idem-media\", \"CAM-01\", { ...reference }));\n318:   assert.deepEqual((body.input as Record<string, unknown>).media, [{ type: \"reference_image\", url: \"https://signed.invalid/media-photo.jpg\" }]);\n319:   assert.ok(!(\"reference_image\" in (body.input as Record<string, unknown>)));\n320:   assert.ok(!JSON.stringify(body).includes(\"c\".repeat(64)));\n321: });\n322: \n323: test(\"worker surfaces a provider FAILED reason in the error and on the job doc\", {\n324:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n325: }, async () => {\n326:   const { app, db, bucket } = await createEmulatorContext();\n327:   const partyId = randomPartyId();\n328:   const deviceId = \"tv-fail-reason\";\n329:   const channelId = \"main\";\n330:   const jobId = \"job-fail-reason\";\n331:   const idempotencyKey = \"idem-fail-reason\";\n332:   try {\n333:     await seedParty(db, partyId, deviceId, channelId);\n334:     const failingProvider = {\n335:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failreason000000000001\" }; },\n336:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> {\n337:         return { state: \"FAILED\", errorCode: \"InvalidParameter\", errorMessage: \"Field required: input.media\" };\n338:       },\n339:       async getResult(_taskId: string): Promise<ProviderResult> {\n340:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n341:       },\n342:     };\n343:     const services = createGenerationServices({\n344:       db, bucket, provider: failingProvider, pollIntervalMs: 1, sleep: async () => undefined,\n345:     });\n346:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n347:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n348:       (error: unknown) => error instanceof BackendError\n349:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n350:         && /Field required: input\\.media/.test(error.message));\n351:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n352:     assert.equal(job.state, \"failed\");\n353:     assert.ok(typeof job.providerErrorCode === \"string\" && job.providerErrorCode.includes(\"InvalidParameter\"));\n354:     assert.ok(job.providerErrorCode.includes(\"Field_required\"));\n355:     assert.ok(!JSON.stringify(job).includes(\"https://\"));\n356:   } finally {\n357:     await clearParty(db, bucket, partyId);\n358:     await disposeEmulatorContext(app);\n359:   }\n360: });\n361: \n362: test(\"worker keeps the generic mapping when a FAILED task carries no reason\", {\n363:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n364: }, async () => {\n365:   const { app, db, bucket } = await createEmulatorContext();\n366:   const partyId = randomPartyId();\n367:   const deviceId = \"tv-fail-empty\";\n368:   const channelId = \"main\";\n369:   const jobId = \"job-fail-empty\";\n370:   const idempotencyKey = \"idem-fail-empty\";\n371:   try {\n372:     await seedParty(db, partyId, deviceId, channelId);\n373:     const emptyProvider = {\n374:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failempty000000000001\" }; },\n375:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"FAILED\" }; },\n376:       async getResult(_taskId: string): Promise<ProviderResult> {\n377:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n378:       },\n379:     };\n380:     const services = createGenerationServices({\n381:       db, bucket, provider: emptyProvider, pollIntervalMs: 1, sleep: async () => undefined,\n382:     });\n383:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n384:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n385:       (error: unknown) => error instanceof BackendError\n386:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n387:         && error.message === \"Provider task failed.\");\n388:   } finally {\n389:     await clearParty(db, bucket, partyId);\n390:     await disposeEmulatorContext(app);\n391:   }\n392: });\n393: \n394: \n395: test(\"lazy provider fallback threads fixtureDirectory through both construction paths\", {\n396:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n397: }, async () => {\n398:   const { app, db, bucket } = await createEmulatorContext();\n399:   const partyId = randomPartyId();\n400:   const deviceId = \"tv-lazy-fixture\";\n401:   const channelId = \"main\";\n402:   const jobId = \"job-lazy-fixture\";\n403:   const idempotencyKey = \"idem-lazy-fixture\";\n404:   const { mkdtemp, copyFile, readFile } = await import(\"node:fs/promises\");\n405:   const { tmpdir } = await import(\"node:os\");\n406:   const { join } = await import(\"node:path\");\n407:   const { normalizeProviderVideo, removeNormalizedVideo } = await import(\"../src/normalize\");\n408:   const assets = resolve(process.cwd(), \"../../apps/tv_app/assets\");\n409:   // Every slot reads the CAM-01 bytes: only the threaded directory produces\n410:   // this digest on all four cameras.\n411:   const isolated = await mkdtemp(join(tmpdir(), \"halloween-fixtures-\"));\n412:   const cam01 = await readFile(join(assets, \"cam01.mp4\"));\n413:   for (const name of [\"cam01.mp4\", \"cam02.mp4\", \"cam03.mp4\", \"cam04.mp4\"]) {\n414:     await copyFile(join(assets, \"cam01.mp4\"), join(isolated, name));\n415:   }\n416:   const defaultCam02 = await readFile(join(assets, \"cam02.mp4\"));\n417:   assert.notDeepEqual(cam01, defaultCam02, \"fixture inputs must differ for this regression to discriminate\");\n418:   const expected = await normalizeProviderVideo(\n419:     { video: { kind: \"file\", value: join(isolated, \"cam01.mp4\") }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 },\n420:   );\n421:   try {\n422:     await seedParty(db, partyId, deviceId, channelId);\n423:     // No explicit provider: the service must lazily construct one from the\n424:     // threaded fixture directory instead of the repository default.\n425:     const services = createGenerationServices({\n426:       db, bucket, fixtureDirectory: isolated, pollIntervalMs: 1, sleep: async () => undefined,\n427:     });\n428:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n429:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n430:     assert.equal(run.state, \"ready\");\n431:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n432:     assert.equal(manifest.cameraClips.length, 4);\n433:     for (const clip of manifest.cameraClips as Array<{ cameraId: string; sha256: string; sizeBytes: number; objectPath: string }>) {\n434:       assert.equal(clip.sha256, expected.sha256, `${clip.cameraId} must come from the threaded fixture directory`);\n435:       assert.equal(clip.sizeBytes, expected.sizeBytes);\n436:       const [bytes] = await bucket.file(clip.objectPath).download();\n437:       assert.equal(createHash(\"sha256\").update(bytes).digest(\"hex\"), clip.sha256);\n438:     }\n439:   } finally {\n440:     await removeNormalizedVideo(expected).catch(() => undefined);\n441:     await clearParty(db, bucket, partyId);\n442:     await disposeEmulatorContext(app);\n443:   }\n444: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/generation.test.ts, lines 1-444\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { resolve } from \"node:path\";\n4: import test from \"node:test\";\n5: import { createGenerationServices } from \"../src/generation\";\n6: import { REQUIRED_CAMERA_IDS } from \"../src/config\";\n7: import { BackendError } from \"../src/contracts\";\n8: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n9: import { ProviderResult, ProviderTaskStatus, VideoGenerationRequest } from \"../src/video_generation_port\";\n10: import { reconcileUsage, usageLedgerId } from \"../src/usage\";\n11: import { buildCheapDemoRequest, validateCheapDemoControls, validateFetchableReferenceImage, validateVideoGenerationRequest } from \"../src/video_generation_port\";\n12: import { buildAlibabaSubmitBody } from \"../src/providers/alibaba\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: function expectCode(work: () => unknown, code: string): void {\n23:   assert.throws(work, (error: unknown) => error instanceof BackendError && error.errorCode === code);\n24: }\n25: \n26: test(\"cheap_demo generation request is fixed to one Singapore 480P silent output\", () => {\n27:   const request = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\");\n28:   assert.equal(request.modelId, \"wan3.0-video\");\n29:   assert.equal(request.region, \"singapore\");\n30:   assert.equal(request.resolution, \"480P\");\n31:   assert.equal(request.secondsOut, 2);\n32:   assert.equal(request.aspectRatio, \"16:9\");\n33:   assert.equal(request.audio, false);\n34:   assert.equal(request.outputs, 1);\n35:   assert.equal(request.autoUpscale, false);\n36:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", modelId: \"another-model\" }), \"INVALID_ARGUMENT\");\n37:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", resolution: \"720P\" }), \"INVALID_ARGUMENT\");\n38:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", secondsOut: 5 }), \"INVALID_ARGUMENT\");\n39:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", outputs: 2 }), \"INVALID_ARGUMENT\");\n40:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", audio: true }), \"INVALID_ARGUMENT\");\n41:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", media: [{ type: \"image\" }] }), \"INVALID_ARGUMENT\");\n42: });\n43: \n44: test(\"provider-bound references require a signed https URL, never a bare bucket path\", () => {\n45:   // Offline regression for the live-submit defect: the provider cannot fetch\n46:   // private GCS object paths, so any reference without a resolved signed https\n47:   // URL fails closed before transport. Consent/tombstone gates are unchanged.\n48:   const bare = {\n49:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n50:     sha256: \"a\".repeat(64),\n51:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n52:   };\n53:   expectCode(() => validateFetchableReferenceImage({ ...bare }), \"INVALID_ARGUMENT\");\n54:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"http://signed.invalid/photo.jpg\" }), \"INVALID_ARGUMENT\");\n55:   expectCode(() => validateFetchableReferenceImage({ ...bare, url: \"gs://bucket/photo.jpg\" }), \"INVALID_ARGUMENT\");\n56:   expectCode(() => validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...bare })), \"INVALID_ARGUMENT\");\n57:   const resolved = { ...bare, url: \"https://signed.invalid/photo.jpg\" };\n58:   validateFetchableReferenceImage({ ...resolved });\n59:   validateVideoGenerationRequest(buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", { ...resolved }));\n60: });\n61: \n62: test(\"offline fake keeps the live fetchability gate for cheap_demo references\", async () => {\n63:   // Layering regression for the cycle-11 merge interaction: the offline fake\n64:   // resolves local bytes and never fetches, but it still enforces the same\n65:   // signed-https fetchability gate as the live adapter, so an unfetchable\n66:   // bare object-path reference can never be submitted on either boundary.\n67:   // The worker resolves the consented photo through signReferenceReadUrl\n68:   // (emulator tests wire the signing transport for that step); anything\n69:   // unresolved fails here with the same signed-URL shape. Consent and\n70:   // tombstone gates live one layer up and are unchanged.\n71:   const bare = {\n72:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n73:     sha256: \"a\".repeat(64),\n74:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n75:   };\n76:   const provider = new FakeVideoGenerationPort();\n77:   await assert.rejects(\n78:     provider.submit(buildCheapDemoRequest(\"job-cheap-bare\", \"idem-cheap-bare\", \"CAM-01\", { ...bare })),\n79:     /signed https URL/,\n80:   );\n81:   const submitted = await provider.submit(buildCheapDemoRequest(\"job-cheap-signed\", \"idem-cheap-signed\", \"CAM-01\", {\n82:     ...bare,\n83:     url: \"https://signed.invalid/photo.jpg\",\n84:   }));\n85:   assert.ok(submitted.taskId.startsWith(\"CAM-01__\"));\n86: });\n87: \n88: test(\"crash reconciliation never repeats an unpersisted billable submission\", {\n89:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n90: }, async () => {\n91:   const { app, db, bucket } = await createEmulatorContext();\n92:   const partyId = randomPartyId();\n93:   let submissions = 0;\n94:   const provider = {\n95:     async submit(_request: VideoGenerationRequest) { submissions += 1; return { taskId: \"should-not-be-submitted\" }; },\n96:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; },\n97:     async getResult(_taskId: string): Promise<ProviderResult> {\n98:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 };\n99:     },\n100:   };\n101:   const deviceId = \"tv-crash-recovery\";\n102:   const channelId = \"main\";\n103:   const jobId = \"job-uncertain-submit\";\n104:   const idempotencyKey = \"idem-uncertain-submit\";\n105:   try {\n106:     await seedParty(db, partyId, deviceId, channelId);\n107:     const services = createGenerationServices({ db, bucket, provider });\n108:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n109:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({\n110:       \"cameraAttempts.CAM-01.consumedAttempt\": true,\n111:       \"cameraAttempts.CAM-01.submissionState\": \"submitting\",\n112:     });\n113:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n114:       (error: unknown) => error instanceof BackendError && error.errorCode === \"PROVIDER_UNAVAILABLE\");\n115:     assert.equal(submissions, 0);\n116:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data();\n117:     assert.equal(job?.state, \"running\");\n118:     assert.equal(job?.status, \"reconciliation_required\");\n119:     assert.equal(job?.errorCode, \"PROVIDER_UNAVAILABLE\");\n120:     assert.equal(job?.reconciliationReason, \"SUBMISSION_OUTCOME_UNKNOWN\");\n121:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n122:     assert.equal(budget?.state, \"in_flight\");\n123:     await assert.rejects(services.requestGeneration({\n124:       partyId,\n125:       deviceId,\n126:       channelId,\n127:       jobId: \"job-blocked-by-uncertain-submit\",\n128:       idempotencyKey: \"idem-blocked-by-uncertain-submit\",\n129:       presetId: \"cheap_demo\",\n130:     }), (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n131:     assert.ok((await reconcileUsage(db)).some((issue) => issue.code === \"SUBMISSION_OUTCOME_UNKNOWN\"));\n132:   } finally {\n133:     await clearParty(db, bucket, partyId);\n134:     await disposeEmulatorContext(app);\n135:   }\n136: });\n137: \n138: test(\"registered anonymous request runs fake provider through normalization and atomic publish\", {\n139:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n140: }, async () => {\n141:   const { app, db, bucket } = await createEmulatorContext();\n142:   const partyId = randomPartyId();\n143:   const deviceId = \"tv-pilot\";\n144:   const channelId = \"main\";\n145:   const jobId = \"job-generation-e2e\";\n146:   const idempotencyKey = \"idem-generation-e2e\";\n147:   try {\n148:     await seedParty(db, partyId, deviceId, channelId);\n149:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({ version: 7 });\n150:     const services = createGenerationServices({\n151:       db,\n152:       bucket,\n153:       provider: new FakeVideoGenerationPort(),\n154:       pollIntervalMs: 1,\n155:       sleep: async () => undefined,\n156:     });\n157:     const input = { partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" };\n158:     const request = await services.requestGeneration(input);\n159:     assert.equal(request.state, \"queued\");\n160:     assert.equal(request.created, true);\n161:     assert.equal(request.manifestVersion, 8);\n162:     assert.ok(request.timestamp);\n163:     const duplicate = await services.requestGeneration(input);\n164:     assert.equal(duplicate.created, false);\n165:     await assert.rejects(services.requestGeneration({ ...input, jobId: \"job-budget-guard\", idempotencyKey: \"idem-budget-guard\" }),\n166:       (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\");\n167:     await assert.rejects(services.requestGeneration({ ...input, partyId: \"unregistered-party\", jobId: \"job-unregistered\" }),\n168:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n169: \n170:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n171:     assert.deepEqual(run, { jobId, state: \"ready\", manifestVersion: 8 });\n172:     const repeated = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n173:     assert.equal(repeated.state, \"ready\");\n174: \n175:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n176:     assert.equal(manifest.version, 8);\n177:     assert.equal(manifest.cameraClips.length, 4);\n178:     assert.deepEqual(manifest.cameraClips.map((clip: { cameraId: string }) => clip.cameraId), [...REQUIRED_CAMERA_IDS]);\n179:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n180:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n181:       assert.equal(ledger.partyId, partyId);\n182:       assert.equal(ledger.deviceId, deviceId);\n183:       assert.equal(ledger.channelId, channelId);\n184:       assert.equal(ledger.manifestVersion, 8);\n185:       assert.equal(ledger.idempotencyKey, idempotencyKey);\n186:       assert.equal(ledger.success, true);\n187:       assert.equal(ledger.provider_task_id.startsWith(`${cameraId}__`), true);\n188:     }\n189:     assert.deepEqual(await reconcileUsage(db), []);\n190:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n191:     assert.equal(budget?.state, \"idle\");\n192:   } finally {\n193:     await clearParty(db, bucket, partyId);\n194:     await disposeEmulatorContext(app);\n195:   }\n196: });\n197: \n198: test(\"rehearsalOnly marker binds the worker to the fake provider when live is configured\", {\n199:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n200: }, async () => {\n201:   const { app, db, bucket } = await createEmulatorContext();\n202:   const partyId = randomPartyId();\n203:   /** Live-shaped stand-in: any submit reaching it would be billable work. */\n204:   class LiveSpyProvider {\n205:     submissions = 0;\n206:     async submit(_request: VideoGenerationRequest) {\n207:       this.submissions += 1;\n208:       return { taskId: \"live-billable-task-1\" };\n209:     }\n210:     async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"SUCCEEDED\" }; }\n211:     async getResult(_taskId: string): Promise<ProviderResult> {\n212:       return { video: { kind: \"file\", value: \"unused\" }, secondsOut: 2, secondsIn: 0, creditsCharged: 9 };\n213:     }\n214:   }\n215:   const deviceId = \"tv-rehearsal\";\n216:   const channelId = \"main\";\n217:   const jobId = \"job-rehearsal-marker\";\n218:   const idempotencyKey = \"idem-rehearsal-marker\";\n219:   try {\n220:     await seedParty(db, partyId, deviceId, channelId);\n221:     const live = new LiveSpyProvider();\n222:     const services = createGenerationServices({\n223:       db,\n224:       bucket,\n225:       provider: live,\n226:       pollIntervalMs: 1,\n227:       sleep: async () => undefined,\n228:     });\n229:     const request = await services.requestGeneration({\n230:       partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", rehearsalOnly: true,\n231:     });\n232:     assert.equal(request.created, true);\n233:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.rehearsalOnly, true);\n234:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n235:     assert.equal(run.state, \"ready\");\n236:     assert.equal(live.submissions, 0, \"a rehearsal-marked job must never reach the live provider\");\n237:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n238:       const ledger = (await db.doc(`parties/${partyId}/costLogs/${usageLedgerId(jobId, cameraId)}`).get()).data()!;\n239:       assert.match(ledger.provider_task_id, new RegExp(`^${cameraId}__[a-f0-9]{24}$`));\n240:       assert.equal(ledger.credits_charged, 0);\n241:     }\n242:     assert.deepEqual(await reconcileUsage(db), []);\n243:   } finally {\n244:     await clearParty(db, bucket, partyId);\n245:     await disposeEmulatorContext(app);\n246:   }\n247: });\n248: \n249: test(\"rehearsalOnly marker is validated, bound to the job, and optional\", {\n250:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n251: }, async () => {\n252:   const { app, db, bucket } = await createEmulatorContext();\n253:   const partyId = randomPartyId();\n254:   const deviceId = \"tv-marker\";\n255:   const channelId = \"main\";\n256:   try {\n257:     await seedParty(db, partyId, deviceId, channelId);\n258:     const services = createGenerationServices({\n259:       db,\n260:       bucket,\n261:       provider: new FakeVideoGenerationPort(),\n262:       pollIntervalMs: 1,\n263:       sleep: async () => undefined,\n264:     });\n265:     const base = { partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\", presetId: \"cheap_demo\" };\n266:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: \"true\" }),\n267:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n268:     await assert.rejects(services.requestGeneration({ ...base, rehearsalOnly: false }),\n269:       (error: unknown) => error instanceof BackendError && error.errorCode === \"INVALID_ARGUMENT\");\n270:     const marked = await services.requestGeneration({ ...base, rehearsalOnly: true });\n271:     assert.equal(marked.created, true);\n272:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-marker`).get()).data()?.rehearsalOnly, true);\n273:     const repeat = await services.requestGeneration({ ...base, rehearsalOnly: true });\n274:     assert.equal(repeat.created, false);\n275:     // The same job cannot be re-requested as an unmarked (live-path) job.\n276:     await assert.rejects(services.requestGeneration(base),\n277:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n278:     const status = await services.getGenerationStatus({ ...base, rehearsalOnly: true });\n279:     assert.equal(status.jobId, \"job-marker\");\n280:     // Run the marked job to release the party budget: the default path then stays marker-free.\n281:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId: \"job-marker\", idempotencyKey: \"idem-marker\" });\n282:     assert.equal(run.state, \"ready\");\n283:     await services.requestGeneration({ partyId, deviceId, channelId, jobId: \"job-default\", idempotencyKey: \"idem-default\", presetId: \"cheap_demo\" });\n284:     assert.equal((await db.doc(`parties/${partyId}/jobs/job-default`).get()).data()?.rehearsalOnly, undefined);\n285:   } finally {\n286:     await clearParty(db, bucket, partyId);\n287:     await disposeEmulatorContext(app);\n288:   }\n289: });\n290: \n291: test(\"request idempotency cannot be rebound to another device\", { skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST }, async () => {\n292:   const { app, db, bucket } = await createEmulatorContext();\n293:   const partyId = randomPartyId();\n294:   try {\n295:     await seedParty(db, partyId, \"tv-1\", \"main\");\n296:     await seedParty(db, partyId, \"tv-2\", \"main\");\n297:     const services = createGenerationServices({ db, bucket, provider: new FakeVideoGenerationPort() });\n298:     const input = { partyId, deviceId: \"tv-1\", channelId: \"main\", jobId: \"job-rebind\", idempotencyKey: \"idem-rebind\", presetId: \"cheap_demo\" };\n299:     await services.requestGeneration(input);\n300:     await assert.rejects(services.requestGeneration({ ...input, deviceId: \"tv-2\" }),\n301:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n302:   } finally {\n303:     await clearParty(db, bucket, partyId);\n304:     await disposeEmulatorContext(app);\n305:   }\n306: });\n307: \n308: test(\"submit body uses the media-field form for references (no network)\", () => {\n309:   // Offline regression for the live r2v defect: the signed URL rides as\n310:   // input.media; sha256 / reference_image never enter the submitted JSON.\n311:   const reference = {\n312:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n313:     sha256: \"c\".repeat(64),\n314:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n315:     url: \"https://signed.invalid/media-photo.jpg\",\n316:   };\n317:   const body = buildAlibabaSubmitBody(buildCheapDemoRequest(\"job-media\", \"idem-media\", \"CAM-01\", { ...reference }));\n318:   assert.deepEqual((body.input as Record<string, unknown>).media, [{ type: \"reference_image\", url: \"https://signed.invalid/media-photo.jpg\" }]);\n319:   assert.ok(!(\"reference_image\" in (body.input as Record<string, unknown>)));\n320:   assert.ok(!JSON.stringify(body).includes(\"c\".repeat(64)));\n321: });\n322: \n323: test(\"worker surfaces a provider FAILED reason in the error and on the job doc\", {\n324:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n325: }, async () => {\n326:   const { app, db, bucket } = await createEmulatorContext();\n327:   const partyId = randomPartyId();\n328:   const deviceId = \"tv-fail-reason\";\n329:   const channelId = \"main\";\n330:   const jobId = \"job-fail-reason\";\n331:   const idempotencyKey = \"idem-fail-reason\";\n332:   try {\n333:     await seedParty(db, partyId, deviceId, channelId);\n334:     const failingProvider = {\n335:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failreason000000000001\" }; },\n336:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> {\n337:         return { state: \"FAILED\", errorCode: \"InvalidParameter\", errorMessage: \"Field required: input.media\" };\n338:       },\n339:       async getResult(_taskId: string): Promise<ProviderResult> {\n340:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n341:       },\n342:     };\n343:     const services = createGenerationServices({\n344:       db, bucket, provider: failingProvider, pollIntervalMs: 1, sleep: async () => undefined,\n345:     });\n346:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n347:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n348:       (error: unknown) => error instanceof BackendError\n349:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n350:         && /Field required: input\\.media/.test(error.message));\n351:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n352:     assert.equal(job.state, \"failed\");\n353:     assert.ok(typeof job.providerErrorCode === \"string\" && job.providerErrorCode.includes(\"InvalidParameter\"));\n354:     assert.ok(job.providerErrorCode.includes(\"Field_required\"));\n355:     assert.ok(!JSON.stringify(job).includes(\"https://\"));\n356:   } finally {\n357:     await clearParty(db, bucket, partyId);\n358:     await disposeEmulatorContext(app);\n359:   }\n360: });\n361: \n362: test(\"worker keeps the generic mapping when a FAILED task carries no reason\", {\n363:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n364: }, async () => {\n365:   const { app, db, bucket } = await createEmulatorContext();\n366:   const partyId = randomPartyId();\n367:   const deviceId = \"tv-fail-empty\";\n368:   const channelId = \"main\";\n369:   const jobId = \"job-fail-empty\";\n370:   const idempotencyKey = \"idem-fail-empty\";\n371:   try {\n372:     await seedParty(db, partyId, deviceId, channelId);\n373:     const emptyProvider = {\n374:       async submit(_request: VideoGenerationRequest) { return { taskId: \"CAM-01__failempty000000000001\" }; },\n375:       async getStatus(_taskId: string): Promise<ProviderTaskStatus> { return { state: \"FAILED\" }; },\n376:       async getResult(_taskId: string): Promise<ProviderResult> {\n377:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"unreachable\");\n378:       },\n379:     };\n380:     const services = createGenerationServices({\n381:       db, bucket, provider: emptyProvider, pollIntervalMs: 1, sleep: async () => undefined,\n382:     });\n383:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n384:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey }),\n385:       (error: unknown) => error instanceof BackendError\n386:         && error.errorCode === \"PROVIDER_UNAVAILABLE\"\n387:         && error.message === \"Provider task failed.\");\n388:   } finally {\n389:     await clearParty(db, bucket, partyId);\n390:     await disposeEmulatorContext(app);\n391:   }\n392: });\n393: \n394: \n395: test(\"lazy provider fallback threads fixtureDirectory through both construction paths\", {\n396:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n397: }, async () => {\n398:   const { app, db, bucket } = await createEmulatorContext();\n399:   const partyId = randomPartyId();\n400:   const deviceId = \"tv-lazy-fixture\";\n401:   const channelId = \"main\";\n402:   const jobId = \"job-lazy-fixture\";\n403:   const idempotencyKey = \"idem-lazy-fixture\";\n404:   const { mkdtemp, copyFile, readFile } = await import(\"node:fs/promises\");\n405:   const { tmpdir } = await import(\"node:os\");\n406:   const { join } = await import(\"node:path\");\n407:   const { normalizeProviderVideo, removeNormalizedVideo } = await import(\"../src/normalize\");\n408:   const assets = resolve(process.cwd(), \"../../apps/tv_app/assets\");\n409:   // Every slot reads the CAM-01 bytes: only the threaded directory produces\n410:   // this digest on all four cameras.\n411:   const isolated = await mkdtemp(join(tmpdir(), \"halloween-fixtures-\"));\n412:   const cam01 = await readFile(join(assets, \"cam01.mp4\"));\n413:   for (const name of [\"cam01.mp4\", \"cam02.mp4\", \"cam03.mp4\", \"cam04.mp4\"]) {\n414:     await copyFile(join(assets, \"cam01.mp4\"), join(isolated, name));\n415:   }\n416:   const defaultCam02 = await readFile(join(assets, \"cam02.mp4\"));\n417:   assert.notDeepEqual(cam01, defaultCam02, \"fixture inputs must differ for this regression to discriminate\");\n418:   const expected = await normalizeProviderVideo(\n419:     { video: { kind: \"file\", value: join(isolated, \"cam01.mp4\") }, secondsOut: 2, secondsIn: 0, creditsCharged: 0 },\n420:   );\n421:   try {\n422:     await seedParty(db, partyId, deviceId, channelId);\n423:     // No explicit provider: the service must lazily construct one from the\n424:     // threaded fixture directory instead of the repository default.\n425:     const services = createGenerationServices({\n426:       db, bucket, fixtureDirectory: isolated, pollIntervalMs: 1, sleep: async () => undefined,\n427:     });\n428:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\" });\n429:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n430:     assert.equal(run.state, \"ready\");\n431:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n432:     assert.equal(manifest.cameraClips.length, 4);\n433:     for (const clip of manifest.cameraClips as Array<{ cameraId: string; sha256: string; sizeBytes: number; objectPath: string }>) {\n434:       assert.equal(clip.sha256, expected.sha256, `${clip.cameraId} must come from the threaded fixture directory`);\n435:       assert.equal(clip.sizeBytes, expected.sizeBytes);\n436:       const [bytes] = await bucket.file(clip.objectPath).download();\n437:       assert.equal(createHash(\"sha256\").update(bytes).digest(\"hex\"), clip.sha256);\n438:     }\n439:   } finally {\n440:     await removeNormalizedVideo(expected).catch(() => undefined);\n441:     await clearParty(db, bucket, partyId);\n442:     await disposeEmulatorContext(app);\n443:   }\n444: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b133c74d6a02a0afddef8095c"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/generation.test.ts\"}"},"time":{"start":1793460999739,"end":1793460999760}}}}
