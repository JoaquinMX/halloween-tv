ntData): VideoGenerationPort | undefined => {\n107:     if ((job as Record<string, unknown>).rehearsalOnly !== true) return undefined;\n108:     const fake = getRehearsalProvider();\n109:     if (!(fake instanceof FakeVideoGenerationPort)) {\n110:       throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Rehearsal jobs resolve only the fake provider; refusing a live submission.\");\n111:     }\n112:     return fake;\n113:   };\n114:   const store = new FirestoreGenerationStore({ db: options.db, bucket: options.bucket, now: options.now });\n115:   const sleep = options.sleep ?? ((milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds)));\n116:   const now = options.now ?? (() => new Date());\n117:   const pollIntervalMs = options.pollIntervalMs ?? 15_000;\n118:   const providerTimeoutMs = options.providerTimeoutMs ?? 12 * 60 * 1000;\n119: \n120:   async function normalizeAndStage(partyId: string, jobId: string, cameraId: CameraId, result: ProviderResult): Promise<Record<string, unknown>> {\n121:     validateId(partyId, \"partyId\");\n122:     validateId(jobId, \"jobId\");\n123:     if (!REQUIRED_CAMERA_IDS.includes(cameraId)) throw new BackendError(\"INVALID_ARGUMENT\", \"Camera ID is invalid.\");\n124:     const job = await store.getJob(partyId, jobId);\n125:     if (job.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running generation job can stage media.\");\n126:     const old = (job.stagedOutputs ?? {})[cameraId];\n127:     if (old && typeof old === \"object\") return old as Record<string, unknown>;\n128:     const expectedSecondsOut = job.presetId === CAMEO_DEMO_PRESET.presetId ? CAMEO_DEMO_PRESET.secondsOut : 2;\n129:     const normalized = await normalizeProviderVideo(result, { ...options.normalization, expectedSecondsOut });\n130:     const expiresAt = new Date(now().getTime() + MEDIA_RETENTION_MS).toISOString();\n131:     const objectPath = store.plannedObjectPath(job.partyId, job.channelId, Number(job.manif