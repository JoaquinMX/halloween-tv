   cameraId: 'CAM-01',\n97:       ));\n98:       expect(tileFor(0, label: '   '), (\n99:         label: cctvSlots[0].defaultLabel,\n100:         cameraId: 'CAM-01',\n101:       ));\n102:       expect(tileFor(0), (\n103:         label: cctvSlots[0].defaultLabel,\n104:         cameraId: 'CAM-01',\n105:       ));\n106:     });\n107: \n108:     test('tileForCamera places by camera identity, not index', () {\n109:       expect(tileForCamera('CAM-03', label: 'Stairs'), (\n110:         label: 'Stairs',\n111:         cameraId: 'CAM-03',\n112:       ));\n113:       expect(() => tileForCamera('CAM-09'), throwsArgumentError);\n114:     });\n115: \n116:     test('tileForClip resolves config labels, else slot defaults', () {\n117:       ClipDescriptor clip(String cameraId, {String? label}) => ClipDescriptor(\n118:         id: 'clip-$cameraId',\n119:         cameraId: cameraId,\n120:         storageObjectId: 'obj-$cameraId',\n121:         sha256: _sha,\n122:         sizeBytes: 1024,\n123:         duration: const Duration(seconds: 4),\n124:         mimeType: 'video/mp4',\n125:         label: label,\n126:       );\n127:       expect(tileForClip(clip('CAM-02', label: 'Kitchen Cam')), (\n128:         label: 'Kitchen Cam',\n129:         cameraId: 'CAM-02',\n130:       ));\n131:       expect(tileForClip(clip('CAM-04')), (\n132:         label: cctvSlots[3].defaultLabel,\n133:         cameraId: 'CAM-04',\n134:       ));\n135:     });\n136:   });\n137: \n138:   group('HauntedSurveillancePlugin', () {\n139:     test('descriptor is valid with wall capabilities', () {\n140:       const ChannelPlugin plugin = HauntedSurveillancePlugin();\n141:       expect(plugin.descriptor.id, hauntedSurveillanceChannelId);\n142:       expect(plugin.descriptor.title, 'Haunted Surveillance');\n143:       expect(plugin.descriptor.version, greaterThan(0));\n144:       expect(plugin.descriptor.capabilities.videoPlayback, isTrue);\n145:       expect(plugin.descriptor.capabilities.effects, isTrue);\n146:       expect(plugin.descriptor.capabilities.timedEvents, isTrue);\n147:     });\n148: \n149:     test('descriptor round-trips through json', () {\n150:       const ChannelPlugin plugin = HauntedSurveillancePlugin();\n151:       final ChannelDescriptor back = ChannelDescriptor.fromJson(\n152:         plugin.descriptor.toJson(),\n153:       );\n154:       expect(back.id, hauntedSurveillanceChannelId);\n155:       expect(back.capabilities, plugin.descriptor.capabilities);\n156:     });\n157: \n158:     test('is registry-compatible alongside sibling channels', () {\n159:       // Inline registry shape (no kernel_app import needed); the sibling\n160:       // stub stands in for RetroHorrorPlugin's descriptor id contract.\n161:       final Map<String, ChannelPlugin> registry = <String, ChannelPlugin>{\n162:         for (final ChannelPlugin p in <ChannelPlugin>[\n163:           const HauntedSurveillancePlugin(),\n164:           const _SiblingStubPlugin(),\n165:         ])\n166:           p.descriptor.id: p,\n167:       };\n168:       expect(\n169:         registry['haunted_surveillance'],\n170:         isA<HauntedSurveillancePlugin>(),\n171:       );\n172:       expect(registry['retro_horror'], isA<_SiblingStubPlugin>());\n173:     });\n174: \n175:     testWidgets('boots the wall with a fake coordinator', (\n176:       WidgetTester tester,\n177:     ) async {\n178:       final _FakeHandle handle = _FakeHandle();\n179:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n180:         disableEffects: true,\n181:         tileBuilder: _fakeSurface,\n182:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n183:       );\n184:       final ChannelContext ctx = ChannelContext(\n185:         partyId: PartyId('party-1'),\n186:         playbackHandle: handle,\n187:       );\n188:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n189:       await tester.pumpAndSettle();\n190:       expect(handle.prepared, isTrue);\n191:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n192:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n193:       expect(find.text('CAM-03 · staircase'), findsOneWidget);\n194:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n195:       expect(find.text('REC'), findsWidgets);\n196:       expect(find.text('20:00:00'), findsNWidgets(4));\n197:       expect(find.text('SIGNAL LOST'), findsNothing);\n198:     });\n199: \n200:     testWidgets(\n201:       'manifest without labels falls back to core_playlist defaults',\n202:       (WidgetTester tester) async {\n203:         // Manifest clips carry no `label`: wall labels must resolve to the\n204:         // canonical slot defaults from core_playlist, never to clip ids.\n205:         final _FakeHandle handle = _FakeHandle();\n206:         final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n207:           disableEffects: true,\n208:           manifest: _manifest(),\n209:           tileBuilder: _fakeSurface,\n210:         );\n211:         final ChannelContext ctx = ChannelContext(\n212:           partyId: PartyId('party-1'),\n213:           playbackHandle: handle,\n214:         );\n215:         await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n216:         await tester.pumpAndSettle();\n217:         for (final CctvSlot slot in cctvSlots) {\n218:           expect(find.text(slot.defaultLabel), findsOneWidget);\n219:         }\n220:         expect(find.textContaining('clip-0'), findsNothing);\n221:       },\n222:     );\n223: \n224:     testWidgets('custom-label manifest drives wall slot labels end-to-end', (\n225:       WidgetTester tester,\n226:     ) async {\n227:       // Owner Q3: labels are config-driven. A manifest whose clips carry\n228:       // `label` must drive the HUD text on the matching camera slot, while\n229:       // slots without a label keep the core_playlist default.\n230:       final _FakeHandle handle = _FakeHandle();\n231:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n232:         disableEffects: true,\n233:         manifest: _manifest(\n234:           labels: const <String, String?>{\n235:             'CAM-01': 'Front Door',\n236:             'CAM-02': null,\n237:             'CAM-03': 'Basement',\n238:             'CAM-04': '   ',\n239:           },\n240:         ),\n241:         tileBuilder: _fakeSurface,\n242:       );\n243:       final ChannelContext ctx = ChannelContext(\n244:         partyId: PartyId('party-1'),\n245:         playbackHandle: handle,\n246:       );\n247:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n248:       await tester.pumpAndSettle();\n249:       expect(find.text('Front Door'), findsOneWidget);\n250:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n251:       expect(find.text('Basement'), findsOneWidget);\n252:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n253:       // Blank labels are not rendered as-is.\n254:       expect(find.text('   '), findsNothing);\n255:     });\n256: \n257:     testWidgets('slots follow camera identity, not manifest clip order', (\n258:       WidgetTester tester,\n259:     ) async {\n260:       final _FakeHandle handle = _FakeHandle();\n261:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n262:         disableEffects: true,\n263:         manifest: _manifest(\n264:           labels: const <String, String?>{\n265:             'CAM-01': 'Front Door',\n266:             'CAM-02': 'Kitchen Cam',\n267:             'CAM-03': 'Stairs',\n268:             'CAM-04': 'Vault',\n269:           },\n270:           reverseClipOrder: true,\n271:         ),\n272:         tileBuilder: _fakeSurface,\n273:       );\n274:       final ChannelContext ctx = ChannelContext(\n275:         partyId: PartyId('party-1'),\n276:         playbackHandle: handle,\n277:       );\n278:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n279:       await tester.pumpAndSettle();\n280:       // Labels are placed by camera id, so reversed clip order still puts\n281:       // CAM-01's label on wall slot 0.\n282:       final Text first = tester.widget<Text>(find.text('Front Door'));\n283:       expect(first.data, 'Front Door');\n284:       expect(\n285:         tester.getTopLeft(find.text('Front Door')).dx,\n286:         lessThan(tester.getTopLeft(find.text('Kitchen Cam')).dx),\n287:       );\n288:       expect(\n289:         tester.getTopLeft(find.text('Stairs')).dy,\n290:         greaterThan(tester.getTopLeft(find.text('Kitchen Cam')).dy),\n291:       );\n292:     });\n293: \n294:     testWidgets('unknown-camera manifest degrades to defaults per slot', (\n295:       WidgetTester tester,\n296:     ) async {\n297:       // Validation rejects unknown camera ids upstream (core_playlist), but\n298:       // a stale payload must never crash the wall: an unmatched clip is\n299:       // ignored and its slot keeps the canonical default.\n300:       final _FakeHandle handle = _FakeHandle();\n301:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n302:         disableEffects: true,\n303:         manifest: PlaybackManifest(\n304:           partyId: 'party-1',\n305:           channelId: hauntedSurveillanceChannelId,\n306:           version: 3,\n307:           publishedAt: DateTime.utc(2026, 10, 31, 20),\n308:           clips: <ClipDescriptor>[\n309:             for (int i = 0; i < 3; i++)\n310:               ClipDescriptor(\n311:                 id: 'clip-0$i',\n312:                 cameraId: 'CAM-0${i + 1}',\n313:                 storageObjectId: 'obj-0$i',\n314:                 sha256: _sha,\n315:                 sizeBytes: 1024,\n316:                 duration: const Duration(seconds: 4),\n317:                 mimeType: 'video/mp4',\n318:               ),\n319:             const ClipDescriptor(\n320:               id: 'clip-99',\n321:               cameraId: 'CAM-09',\n322:               storageObjectId: 'obj-99',\n323:               sha256: _sha,\n324:               sizeBytes: 1024,\n325:               duration: Duration(seconds: 4),\n326:               mimeType: 'video/mp4',\n327:               label: 'Rodent Cam',\n328:             ),\n329:           ],\n330:         ),\n331:         tileBuilder: _fakeSurface,\n332:       );\n333:       final ChannelContext ctx = ChannelContext(\n334:         partyId: PartyId('party-1'),\n335:         playbackHandle: handle,\n336:       );\n337:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n338:       await tester.pumpAndSettle();\n339:       expect(tester.takeException(), isNull);\n340:       expect(find.text('Rodent Cam'), findsNothing);\n341:       for (final CctvSlot slot in cctvSlots) {\n342:         expect(find.text(slot.defaultLabel), findsOneWidget);\n343:       }\n344:     });\n345: \n346:     testWidgets('manifest overlay tunes the tile effect intensities', (\n347:       WidgetTester tester,\n348:     ) async {\n349:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n350:         manifest: _manifest(\n351:           overlay: const OverlaySettings(\n352:             scanlineOpacity: 0.8,\n353:             noiseLevel: 0.05,\n354:             vignette: 0.3,\n355:           ),\n356:         ),\n357:         tileBuilder: _fakeSurface,\n358:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n359:       );\n360:       final ChannelContext ctx = ChannelContext(\n361:         partyId: PartyId('party-1'),\n362:         playbackHandle: _FakeHandle(),\n363:       );\n364:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n365:       await tester.pumpAndSettle();\n366: \n367:       final Iterable<CustomPaint> scanlines = tester.widgetList<CustomPaint>(\n368:         find.byWidgetPredicate(\n369:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n370:         ),\n371:       );\n372:       expect(scanlines, hasLength(4));\n373:       expect(\n374:         (scanlines.first.painter! as ScanlinesPainter).opacity,\n375:         closeTo(0.1 + 0.25 * 0.8, 1e-9),\n376:       );\n377: \n378:       final Iterable<CustomPaint> vignettes = tester.widgetList<CustomPaint>(\n379:         find.byWidgetPredicate(\n380:           (Widget w) => w is CustomPaint && w.painter is VignettePainter,\n381:         ),\n382:       );\n383:       expect(vignettes, hasLength(4));\n384:       expect((vignettes.first.painter! as VignettePainter).strength, 0.3);\n385:     });\n386: \n387:     testWidgets('default wall wires scanline + vignette overlays per tile', (\n388:       WidgetTester tester,\n389:     ) async {\n390:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n391:         tileBuilder: _fakeSurface,\n392:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n393:       );\n394:       final ChannelContext ctx = ChannelContext(\n395:         partyId: PartyId('party-1'),\n396:         playbackHandle: _FakeHandle(),\n397:       );\n398:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n399:       await tester.pumpAndSettle();\n400: \n401:       final Finder scanlines = find.byWidgetPredicate(\n402:         (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n403:       );\n404:       final Finder vignette = find.byWidgetPredicate(\n405:         (Widget w) => w is CustomPaint && w.painter is VignettePainter,\n406:       );\n407:       expect(scanlines, findsNWidgets(4));\n408:       expect(vignette, findsNWidgets(4));\n409:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n410:     });\n411: \n412:     testWidgets('disableEffects removes painters from every tile', (\n413:       WidgetTester tester,\n414:     ) async {\n415:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n416:         disableEffects: true,\n417:         tileBuilder: _fakeSurface,\n418:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n419:       );\n420:       final ChannelContext ctx = ChannelContext(\n421:         partyId: PartyId('party-1'),\n422:         playbackHandle: _FakeHandle(),\n423:       );\n424:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n425:       await tester.pumpAndSettle();\n426:       expect(\n427:         find.byWidgetPredicate(\n428:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n429:         ),\n430:         findsNothing,\n431:       );\n432:     });\n433: \n434:     testWidgets(\n435:       'coordinator boot failure degrades to SignalLost, wall survives',\n436:       (WidgetTester tester) async {\n437:         const HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n438:           disableEffects: true,\n439:           tileBuilder: _fakeSurface,\n440:         );\n441:         final ChannelContext ctx = ChannelContext(\n442:           partyId: PartyId('party-1'),\n443:           playbackHandle: _FailingHandle(),\n444:         );\n445:         await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n446:         await tester.pumpAndSettle();\n447:         expect(find.text('SIGNAL LOST'), findsNWidgets(4));\n448:         expect(tester.takeException(), isNull);\n449:       },\n450:     );\n451: \n452:     testWidgets('a throwing surface degrades to SignalLost, wall survives', (\n453:       WidgetTester tester,\n454:     ) async {\n455:       const HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n456:         disableEffects: true,\n457:         tileBuilder: _throwingSurface,\n458:       );\n459:       final ChannelContext ctx = ChannelContext(\n460:         partyId: PartyId('party-1'),\n461:         playbackHandle: _FakeHandle(),\n462:       );\n463:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n464:       await tester.pumpAndSettle();\n465:       expect(find.text('SIGNAL LOST'), findsNWidgets(4));\n466:       expect(tester.takeException(), isNull);\n467:     });\n468: \n469:     testWidgets('build applies wall config from ChannelContext.settings', (\n470:       WidgetTester tester,\n471:     ) async {\n472:       // Constructor leaves effects on, but the host disables them via the\n473:       // channel contract: settings win without re-instantiating the plugin.\n474:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n475:         tileBuilder: _fakeSurface,\n476:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n477:       );\n478:       final ChannelContext ctx = ChannelContext(\n479:         partyId: PartyId('party-1'),\n480:         playbackHandle: _FakeHandle(),\n481:         settings: const ChannelSettings(<String, Object?>{\n482:           'effectsDisabled': true,\n483:           'manifestVersion': 7,\n484:           'overscanSafe': true,\n485:           'labels': <String, String>{'CAM-01': 'PORCH · custom'},\n486:         }),\n487:       );\n488:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n489:       await tester.pumpAndSettle();\n490: \n491:       expect(\n492:         find.byWidgetPredicate(\n493:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n494:         ),\n495:         findsNothing,\n496:         reason: 'settings effectsDisabled must drop overlays',\n497:       );\n498:       expect(find.text('PORCH · custom'), findsOneWidget);\n499:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n500:       expect(tester.takeException(), isNull);\n501:     });\n502: \n503:     testWidgets('constructor wall config still applies with empty settings', (\n504:       WidgetTester tester,\n505:     ) async {\n506:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n507:         disableEffects: true,\n508:         tileBuilder: _fakeSurface,\n509:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n510:       );\n511:       final ChannelContext ctx = ChannelContext(\n512:         partyId: PartyId('party-1'),\n513:         playbackHandle: _FakeHandle(),\n514:       );\n515:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n516:       await tester.pumpAndSettle();\n517: \n518:       expect(\n519:         find.byWidgetPredicate(\n520:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n521:         ),\n522:         findsNothing,\n523:       );\n524:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n525:       expect(tester.takeException(), isNull);\n526:     });\n527: \n528:     testWidgets('settings label overrides win over manifest clip labels', (\n529:       WidgetTester tester,\n530:     ) async {\n531:       // Precedence composition on one wall: the manifest carries a clip\n532:       // label for CAM-01 AND settings carry an override for the same\n533:       // camera — settings win. CAM-03 keeps its manifest label, CAM-02\n534:       // and CAM-04 keep slot defaults.\n535:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n536:         disableEffects: true,\n537:         manifest: _manifest(\n538:           labels: const <String, String?>{\n539:             'CAM-01': 'Manifest Door',\n540:             'CAM-03': 'Manifest Basement',\n541:           },\n542:         ),\n543:         tileBuilder: _fakeSurface,\n544:       );\n545:       final ChannelContext ctx = ChannelContext(\n546:         partyId: PartyId('party-1'),\n547:         playbackHandle: _FakeHandle(),\n548:         settings: const ChannelSettings(<String, Object?>{\n549:           'labels': <String, String>{'CAM-01': 'PORCH · settings'},\n550:         }),\n551:       );\n552:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n553:       await tester.pumpAndSettle();\n554: \n555:       expect(find.text('PORCH · settings'), findsOneWidget);\n556:       expect(find.text('Manifest Door'), findsNothing);\n557:       expect(find.text('Manifest Basement'), findsOneWidget);\n558:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n559:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n560:       expect(tester.takeException(), isNull);\n561:     });\n562: \n563:     test(\n564:       'cctvLabelOverridesFromSettings filters non-Map/non-string shapes',\n565:       () {\n566:         // No `labels` key at all.\n567:         expect(\n568:           cctvLabelOverridesFromSettings(const ChannelSettings()),\n569:           isEmpty,\n570:         );\n571:         // Non-Map value is ignored, not thrown on.\n572:         expect(\n573:           cctvLabelOverridesFromSettings(\n574:             const ChannelSettings(<String, Object?>{'labels': 'PORCH'}),\n575:           ),\n576:           isEmpty,\n577:         );\n578:         // Non-string keys/values are dropped; only String->String survives.\n579:         expect(\n580:           cctvLabelOverridesFromSettings(\n581:             const ChannelSettings(<String, Object?>{\n582:               'labels': <Object?, Object?>{\n583:                 'CAM-01': 'Porch',\n584:                 'CAM-02': 42,\n585:                 'CAM-03': null,\n586:                 7: 'Attic',\n587:               },\n588:             }),\n589:           ),\n590:           <String, String>{'CAM-01': 'Porch'},\n591:         );\n592:       },\n593:     );\n594:   });\n595: \n596:   group('cctvCameraCountFromSettings', () {\n597:     ChannelSettings settingsWith(Object? value) => ChannelSettings(\n598:       <String, Object?>{CctvWallSettingsKeys.cameraCount: value},\n599:     );\n600: \n601:     test('documented string encoding maps to itself', () {\n602:       expect(cctvCameraCountFromSettings(settingsWith('1')), 1);\n603:       expect(cctvCameraCountFromSettings(settingsWith('2')), 2);\n604:       expect(cctvCameraCountFromSettings(settingsWith('4')), 4);\n605:     });\n606: \n607:     test('absent, invalid, and unreadable values default to four', () {\n608:       expect(cctvCameraCountFromSettings(const ChannelSettings()), 4);\n609:       expect(cctvCameraCountFromSettings(settingsWith('3')), 4);\n610:       expect(cctvCameraCountFromSettings(settingsWith('0')), 4);\n611:       expect(cctvCameraCountFromSettings(settingsWith('')), 4);\n612:       expect(cctvCameraCountFromSettings(settingsWith('banana')), 4);\n613:       expect(cctvCameraCountFromSettings(settingsWith('1.5')), 4);\n614:       expect(cctvCameraCountFromSettings(settingsWith(null)), 4);\n615:       expect(cctvCameraCountFromSettings(settingsWith(true)), 4);\n616:       expect(cctvCameraCountFromSettings(settingsWith(3)), 4);\n617:       expect(cctvCameraCountFromSettings(settingsWith(1.0)), 4);\n618:     });\n619: \n620:     test('surrounding whitespace is tolerated, raw ints pass through', () {\n621:       expect(cctvCameraCountFromSettings(settingsWith(' 2 ')), 2);\n622:       expect(cctvCameraCountFromSettings(settingsWith(2)), 2);\n623:     });\n624:   });\n625: \n626:   group('cctvHeroCameraIdFromSettings', () {\n627:     test('absent and non-string values mean grid', () {\n628:       expect(cctvHeroCameraIdFromSettings(const ChannelSettings()), isNull);\n629:       expect(\n630:         cctvHeroCameraIdFromSettings(\n631:           const ChannelSettings(<String, Object?>{'heroCameraId': ''}),\n632:         ),\n633:         isNull,\n634:       );\n635:       expect(\n636:         cctvHeroCameraIdFromSettings(\n637:           const ChannelSettings(<String, Object?>{'heroCameraId': 42}),\n638:         ),\n639:         isNull,\n640:       );\n641:     });\n642: \n643:     test('non-empty strings pass through (wall validates membership)', () {\n644:       expect(\n645:         cctvHeroCameraIdFromSettings(\n646:           ChannelSettings(<String, Object?>{\n647:             CctvWallSettingsKeys.heroCameraId: 'CAM-02',\n648:           }),\n649:         ),\n650:         'CAM-02',\n651:       );\n652:     });\n653:   });\n654: \n655:   group('cctvEffectiveCount', () {\n656:     test('is min(configured, manifest clips), always supported', () {\n657:       expect(cctvEffectiveCount(configuredCount: 4, manifestClipCount: 4), 4);\n658:       expect(cctvEffectiveCount(configuredCount: 2, manifestClipCount: 4), 2);\n659:       expect(cctvEffectiveCount(configuredCount: 1, manifestClipCount: 4), 1);\n660:       expect(cctvEffectiveCount(configuredCount: 4, manifestClipCount: 2), 2);\n661:       expect(cctvEffectiveCount(configuredCount: 4, manifestClipCount: 1), 1);\n662:       expect(cctvEffectiveCount(configuredCount: 2, manifestClipCount: 1), 1);\n663:     });\n664: \n665:     test('unsupported inputs degrade instead of crashing', () {\n666:       expect(cctvEffectiveCount(configuredCount: 3, manifestClipCount: 4), 4);\n667:       expect(cctvEffectiveCount(configuredCount: 2, manifestClipCount: 3), 2);\n668:     });\n669:   });\n670: \n671:   group('adaptive wall layouts', () {\n672:     Future<void> pumpWall(\n673:       WidgetTester tester,\n674:       ChannelSettings settings, {\n675:       PlaybackManifest? manifest,\n676:     }) async {\n677:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n678:         disableEffects: true,\n679:         manifest: manifest,\n680:         tileBuilder: _fakeSurface,\n681:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n682:       );\n683:       final ChannelContext ctx = ChannelContext(\n684:         partyId: PartyId('party-1'),\n685:         playbackHandle: _FakeHandle(),\n686:         settings: settings,\n687:       );\n688:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n689:       await tester.pumpAndSettle();\n690:     }\n691: \n692:     ChannelSettings countSettings(String count) => ChannelSettings(\n693:       <String, Object?>{CctvWallSettingsKeys.cameraCount: count},\n694:     );\n695: \n696:     testWidgets('count 1 renders one full-size tile', (\n697:       WidgetTester tester,\n698:     ) async {\n699:       await pumpWall(tester, countSettings('1'));\n700:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n701:       for (final String camera in <String>['CAM-02', 'CAM-03', 'CAM-04']) {\n702:         expect(find.byKey(Key('surface-$camera')), findsNothing);\n703:       }\n704:       final Size wall = tester.getSize(find.byKey(kCctvWallKey));\n705:       final Rect tile = tester.getRect(find.byKey(const Key('surface-CAM-01')));\n706:       // Padded single tile: strictly inside the viewport-sized wall, and\n707:       // larger than any single quadrant of the 2x2 grid would be.\n708:       expect(tile.width, greaterThan(wall.width / 2));\n709:       expect(tile.height, greaterThan(wall.height / 2));\n710:       expect(\n711:         Rect.fromLTWH(0, 0, wall.width, wall.height).contains(tile.topLeft) &&\n712:             Rect.fromLTWH(\n713:               0,\n714:               0,\n715:               wall.width,\n716:               wall.height,\n717:             ).contains(tile.bottomRight),\n718:         isTrue,\n719:       );\n720:       expect(tester.takeException(), isNull);\n721:     });\n722: \n723:     testWidgets('count 2 renders two side-by-side tiles in one row', (\n724:       WidgetTester tester,\n725:     ) async {\n726:       await pumpWall(tester, countSettings('2'));\n727:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n728:       expect(find.byKey(const Key('surface-CAM-02')), findsOneWidget);\n729:       expect(find.byKey(const Key('surface-CAM-03')), findsNothing);\n730:       expect(find.byKey(const Key('surface-CAM-04')), findsNothing);\n731:       final Rect first = tester.getRect(\n732:         find.byKey(const ValueKey<String>('wall-slot-CAM-01')),\n733:       );\n734:       final Rect second = tester.getRect(\n735:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n736:       );\n737:       // Same row (equal tops), canonical order (CAM-01 left of CAM-02),\n738:       // roughly half the wall each.\n739:       expect(first.top, second.top);\n740:       expect(first.left, lessThan(second.left));\n741:       expect(first.width, closeTo(second.width, 1));\n742:       final Size wall = tester.getSize(find.byKey(kCctvWallKey));\n743:       expect(first.width, closeTo(wall.width / 2, 6));\n744:       expect(tester.takeException(), isNull);\n745:     });\n746: \n747:     testWidgets('invalid count defaults to four tiles', (\n748:       WidgetTester tester,\n749:     ) async {\n750:       await pumpWall(tester, countSettings('3'));\n751:       for (final String camera in cctvCameraIds) {\n752:         expect(find.byKey(Key('surface-$camera')), findsOneWidget);\n753:       }\n754:       expect(tester.takeException(), isNull);\n755:     });\n756: \n757:     testWidgets('tile builders run for active ids only', (\n758:       WidgetTester tester,\n759:     ) async {\n760:       final List<String> built = <String>[];\n761:       Widget recording(\n762:         BuildContext context,\n763:         int index,\n764:         String label,\n765:         String cameraId,\n766:       ) {\n767:         built.add(cameraId);\n768:         return _fakeSurface(context, index, label, cameraId);\n769:       }\n770: \n771:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n772:         disableEffects: true,\n773:         tileBuilder: recording,\n774:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n775:       );\n776:       final ChannelContext ctx = ChannelContext(\n777:         partyId: PartyId('party-1'),\n778:         playbackHandle: _FakeHandle(),\n779:         settings: countSettings('2'),\n780:       );\n781:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n782:       await tester.pumpAndSettle();\n783:       expect(built, <String>['CAM-01', 'CAM-02']);\n784:     });\n785: \n786:     testWidgets('labels and manifest mapping use the active set', (\n787:       WidgetTester tester,\n788:     ) async {\n789:       await pumpWall(\n790:         tester,\n791:         countSettings('2'),\n792:         manifest: _manifest(\n793:           labels: const <String, String?>{\n794:             'CAM-01': 'Front Door',\n795:             'CAM-02': 'Kitchen Cam',\n796:             'CAM-03': 'Basement',\n797:             'CAM-04': 'Vault',\n798:           },\n799:         ),\n800:       );\n801:       expect(find.text('Front Door'), findsOneWidget);\n802:       expect(find.text('Kitchen Cam'), findsOneWidget);\n803:       expect(find.text('Basement'), findsNothing);\n804:       expect(find.text('Vault'), findsNothing);\n805:     });\n806: \n807:     testWidgets('a two-clip manifest caps the wall at two tiles', (\n808:       WidgetTester tester,\n809:     ) async {\n810:       PlaybackManifest twoClip() {\n811:         final PlaybackManifest full = _manifest();\n812:         return PlaybackManifest(\n813:           partyId: full.partyId,\n814:           channelId: full.channelId,\n815:           version: full.version,\n816:           publishedAt: full.publishedAt,\n817:           clips: full.clips.take(2).toList(),\n818:         );\n819:       }\n820: \n821:       await pumpWall(tester, const ChannelSettings(), manifest: twoClip());\n822:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n823:       expect(find.byKey(const Key('surface-CAM-02')), findsOneWidget);\n824:       expect(find.byKey(const Key('surface-CAM-03')), findsNothing);\n825:       expect(find.byKey(const Key('surface-CAM-04')), findsNothing);\n826:       expect(tester.takeException(), isNull);\n827:     });\n828: \n829:     testWidgets(\n830:       'an unsupported-length manifest degrades to per-slot defaults',\n831:       (WidgetTester tester) async {\n832:         PlaybackManifest threeClip() {\n833:           final PlaybackManifest full = _manifest();\n834:           return PlaybackManifest(\n835:             partyId: full.partyId,\n836:             channelId: full.channelId,\n837:             version: full.version,\n838:             publishedAt: full.publishedAt,\n839:             clips: full.clips.take(3).toList(),\n840:           );\n841:         }\n842: \n843:         await pumpWall(tester, const ChannelSettings(), manifest: threeClip());\n844:         for (final CctvSlot slot in cctvSlots) {\n845:           expect(find.text(slot.defaultLabel), findsOneWidget);\n846:         }\n847:         expect(tester.takeException(), isNull);\n848:       },\n849:     );\n850: \n851:     testWidgets('settings count wins; constructor count is the fallback', (\n852:       WidgetTester tester,\n853:     ) async {\n854:       // No settings key: the constructor default (2 here) applies.\n855:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n856:         disableEffects: true,\n857:         tileBuilder: _fakeSurface,\n858:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n859:         cameraCount: 2,\n860:       );\n861:       ChannelContext ctx = ChannelContext(\n862:         partyId: PartyId('party-1'),\n863:         playbackHandle: _FakeHandle(),\n864:       );\n865:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n866:       await tester.pumpAndSettle();\n867:       expect(find.byKey(const Key('surface-CAM-03')), findsNothing);\n868: \n869:       // Present settings win over the constructor default.\n870:       ctx = ChannelContext(\n871:         partyId: PartyId('party-1'),\n872:         playbackHandle: _FakeHandle(),\n873:         settings: countSettings('4'),\n874:       );\n875:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n876:       await tester.pumpAndSettle();\n877:       expect(find.byKey(const Key('surface-CAM-03')), findsOneWidget);\n878:     });\n879: \n880:     testWidgets('hero animates the existing tile fullscreen, siblings fade', (\n881:       WidgetTester tester,\n882:     ) async {\n883:       Future<void> pumpWithHero(WidgetTester tester, String? hero) async {\n884:         final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n885:           disableEffects: true,\n886:           tileBuilder: _fakeSurface,\n887:           clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n888:         );\n889:         final ChannelContext ctx = ChannelContext(\n890:           partyId: PartyId('party-1'),\n891:           playbackHandle: _FakeHandle(),\n892:           settings: ChannelSettings(<String, Object?>{\n893:             if (hero != null) CctvWallSettingsKeys.heroCameraId: hero,\n894:           }),\n895:         );\n896:         await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n897:       }\n898: \n899:       await pumpWithHero(tester, null);\n900:       await tester.pumpAndSettle();\n901:       final Rect cell = tester.getRect(\n902:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n903:       );\n904:       final Size wall = tester.getSize(find.byKey(kCctvWallKey));\n905: \n906:       await pumpWithHero(tester, 'CAM-02');\n907:       await tester.pump(kWallLayoutDuration ~/ 2);\n908:       final Rect mid = tester.getRect(\n909:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n910:       );\n911:       // Intermediate geometry: strictly between the grid cell and the full\n912:       // viewport rectangle.\n913:       expect(mid.width, greaterThan(cell.width));\n914:       expect(mid.width, lessThan(wall.width));\n915:       expect(mid.height, greaterThan(cell.height));\n916: \n917:       await tester.pumpAndSettle();\n918:       final Rect heroRect = tester.getRect(\n919:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n920:       );\n921:       expect(heroRect.left, 0);\n922:       expect(heroRect.top, 0);\n923:       expect(heroRect.width, wall.width);\n924:       expect(heroRect.height, wall.height);\n925:       // Siblings stay mounted (faded, but present) — no decoder churn.\n926:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n927:       expect(find.byKey(const Key('surface-CAM-03')), findsOneWidget);\n928:       expect(find.byKey(const Key('surface-CAM-04')), findsOneWidget);\n929:       final Finder faded = find.byWidgetPredicate(\n930:         (Widget w) =>\n931:             w is AnimatedOpacity && w.opacity == 0 && w.child is IgnorePointer,\n932:       );\n933:       expect(faded, findsNWidgets(3));\n934:       expect(tester.takeException(), isNull);\n935:     });\n936: \n937:     testWidgets('unknown hero id degrades to the grid', (\n938:       WidgetTester tester,\n939:     ) async {\n940:       await pumpWall(\n941:         tester,\n942:         ChannelSettings(<String, Object?>{\n943:           CctvWallSettingsKeys.heroCameraId: 'CAM-09',\n944:         }),\n945:       );\n946:       for (final String camera in cctvCameraIds) {\n947:         expect(find.byKey(Key('surface-$camera')), findsOneWidget);\n948:       }\n949:       expect(\n950:         find.byWidgetPredicate(\n951:           (Widget w) => w is AnimatedOpacity && w.opacity == 0,\n952:         ),\n953:         findsNothing,\n954:       );\n955:       expect(tester.takeException(), isNull);\n956:     });\n957:   });\n958: \n959:   group('port direction (D-08)', () {\n960:     // Finding D-08: channels must be able to consume the control-plane ports\n961:     // without importing `infra_*`. These two tests keep that true from the\n962:     // consumer side: one walks the real import graph, the other compiles and\n963:     // runs fakes implemented purely against `channel_api`.\n964:     test('lib graph of this channel imports no infra_* package', () {\n965:       final Set<String> visitedPackages = <String>{};\n966:       final List<File> sources = _transitiveLibSources(\n967:         Directory.current,\n968:         visitedPackages,\n969:       );\n970:       expect(\n971:         visitedPackages,\n972:         containsAll(<String>['channel_cctv', 'channel_api']),\n973:         reason: 'walk must actually reach the contracts package',\n974:       );\n975:       final List<String> offenders = <String>[\n976:         for (final File f in sources)\n977:           if (f.readAsStringSync().contains('package:infra_')) f.path,\n978:       ];\n979:       expect(\n980:         offenders,\n981:         isEmpty,\n982:         reason: 'channels must not import infra_* (finding D-08)',\n983:       );\n984:     });\n985: \n986:     test('ports are implementable from channel_api alone', () async {\n987:       final _ContractOnlyManifestSource source = _ContractOnlyManifestSource(\n988:         _manifest(),\n989:       );\n990:       final ManifestSource<PlaybackManifest> port = source;\n991:       final List<PlaybackManifest> seen = await port\n992:           .watchCurrent(\n993:             partyId: 'party-1',\n994:             channelId: hauntedSurveillanceChannelId,\n995:           )\n996:           .toList();\n997:       expect(seen, hasLength(1));\n998:       expect(seen.single.channelId, hauntedSurveillanceChannelId);\n999: \n1000:       final SettingsPort settings = _ContractOnlySettings();\n1001:       await settings.setString(\n1002:         partyId: PartyId('party-1'),\n1003:         key: 'label.cam-01',\n1004:         value: 'Front Door',\n1005:       );\n1006:       expect(\n1007:         await settings.getString(\n1008:           partyId: PartyId('party-1'),\n1009:           key: 'label.cam-01',\n1010:         ),\n1011:         'Front Door',\n1012:       );\n1013:     });\n1014:   });\n1015: }\n1016: \n1017: /// Collects the `lib/` sources of [packageRoot] and, transitively, of every\n1018: /// sibling path package reachable through `package:<name>/<path>` imports.\n1019: ///\n1020: /// Only local siblings (`<packages>/<name>/lib/*.dart`) are followed, so SDK\n1021: /// and pub-cache packages terminate the walk. Names are recorded in\n1022: /// [visited] so the caller can assert the graph was not vacuous.\n1023: List<File> _transitiveLibSources(Directory packageRoot, Set<String> visited) {\n1024:   final List<File> collected = <File>[];\n1025:   final List<(String, Directory)> queue = <(String, Directory)>[\n1026:     (_packageNameOf(packageRoot), packageRoot),\n1027:   ];\n1028:   while (queue.isNotEmpty) {\n1029:     final (String name, Directory root) = queue.removeLast();\n1030:     if (!visited.add(name)) {\n1031:       continue;\n1032:     }\n1033:     final Directory lib = Directory('${root.path}/lib');\n1034:     if (!lib.existsSync()) {\n1035:       continue;\n1036:     }\n1037:     for (final File file in lib.listSync(recursive: true).whereType<File>()) {\n1038:       if (!file.path.endsWith('.dart')) {\n1039:         continue;\n1040:       }\n1041:       collected.add(file);\n1042:       for (final String uri in _packageUrisOf(file.readAsStringSync())) {\n1043:         final String target = uri.split('/').first;\n1044:         final Directory sibling = Directory(\n1045:           '${packageRoot.parent.path}/$target',\n1046:         );\n1047:         if (sibling.existsSync()) {\n1048:           queue.add((target, sibling));\n1049:         }\n1050:       }\n1051:     }\n1052:   }\n1053:   return collected;\n1054: }\n1055: \n1056: /// Package name of [root], read from its `pubspec.yaml` name line.\n1057: String _packageNameOf(Directory root) {\n1058:   final File pubspec = File('${root.path}/pubspec.yaml');\n1059:   for (final String line in pubspec.readAsLinesSync()) {\n1060:     if (line.startsWith('name:')) {\n1061:       return line.substring('name:'.length).trim();\n1062:     }\n1063:   }\n1064:   return root.uri.pathSegments.where((String s) => s.isNotEmpty).last;\n1065: }\n1066: \n1067: /// `package:<name>/<path>` URIs referenced by [source].\n1068: Iterable<String> _packageUrisOf(String source) sync* {\n1069:   for (final RegExpMatch match in RegExp(\n1070:     r'package:([a-z0-9_]+/[A-Za-z0-9_./]+)',\n1071:   ).allMatches(source)) {\n1072:     yield match.group(1)!;\n1073:   }\n1074: }\n1075: \n1076: /// Manifest source bound to `PlaybackManifest` using only the contracts port.\n1077: final class _ContractOnlyManifestSource\n1078:     implements ManifestSource<PlaybackManifest> {\n1079:   _ContractOnlyManifestSource(this.manifest);\n1080: \n1081:   final PlaybackManifest manifest;\n1082: \n1083:   @override\n1084:   Stream<PlaybackManifest> watchCurrent({\n1085:     required String partyId,\n1086:     required String channelId,\n1087:   }) async* {\n1088:     yield manifest;\n1089:   }\n1090: }\n1091: \n1092: /// Settings store written against the contracts port; no infra adapter used.\n1093: final class _ContractOnlySettings implements SettingsPort {\n1094:   final Map<String, String> _values = <String, String>{};\n1095: \n1096:   @override\n1097:   Future<String?> getString({\n1098:     required PartyId partyId,\n1099:     required String key,\n1100:   }) async => _values['${partyId.value}/$key'];\n1101: \n1102:   @override\n1103:   Future<void> setString({\n1104:     required PartyId partyId,\n1105:     required String key,\n1106:     required String value,\n1107:   }) async {\n1108:     _values['${partyId.value}/$key'] = value;\n1109:   }\n1110: \n1111:   @override\n1112:   Future<bool?> getBool({\n1113:     required PartyId partyId,\n1114:     required String key,\n1115:   }) async => _values['${partyId.value}/$key'] == 'true';\n1116: \n1117:   @override\n1118:   Future<void> setBool({\n1119:     required PartyId partyId,\n1120:     required String key,\n1121:     required bool value,\n1122:   }) async {\n1123:     _values['${partyId.value}/$key'] = '$value';\n1124:   }\n1125: }\n1126: \n1127: Widget _fakeSurface(\n1128:   BuildContext context,\n1129:   int index,\n1130:   String label,\n1131:   String cameraId,\n1132: ) => Container(color: Colors.black, key: Key('surface-$cameraId'));\n1133: \n1134: Widget _throwingSurface(\n1135:   BuildContext context,\n1136:   int index,\n1137:   String label,\n1138:   String cameraId,\n1139: ) {\n1140:   throw StateError('no decoder in tests');\n1141: }\n1142: \n1143: /// Inline stand-in for a sibling channel's descriptor id contract.\n1144: final class _SiblingStubPlugin implements ChannelPlugin {\n1145:   const _SiblingStubPlugin();\n1146: \n1147:   @override\n1148:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n1149:     id: 'retro_horror',\n1150:     title: 'Retro Horror',\n1151:     version: 1,\n1152:   );\n1153: \n1154:   @override\n1155:   Widget build(ChannelContext context) => const SizedBox.shrink();\n1156: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/packages/channel_cctv/test/channel_cctv_test.dart, lines 1-1156\n1: import 'dart:io';\n2: \n3: import 'package:channel_api/channel_api.dart';\n4: import 'package:channel_cctv/channel_cctv.dart';\n5: import 'package:core_effects/core_effects.dart';\n6: import 'package:core_foundation/core_foundation.dart';\n7: import 'package:core_playlist/core_playlist.dart';\n8: import 'package:flutter/material.dart';\n9: import 'package:flutter_test/flutter_test.dart';\n10: \n11: final class _FakeHandle implements PlaybackHandle {\n12:   bool prepared = false;\n13: \n14:   @override\n15:   Future<void> prepare() async {\n16:     prepared = true;\n17:   }\n18: \n19:   @override\n20:   Future<void> activate() async {}\n21: }\n22: \n23: final class _FailingHandle implements PlaybackHandle {\n24:   @override\n25:   Future<void> prepare() async => throw StateError('coordinator offline');\n26: \n27:   @override\n28:   Future<void> activate() async {}\n29: }\n30: \n31: final class _FakeClock implements Clock {\n32:   _FakeClock(this.current);\n33: \n34:   DateTime current;\n35: \n36:   @override\n37:   DateTime now() => current;\n38: }\n39: \n40: /// Sixty-four lowercase hex chars (valid sha256 shape for fixtures).\n41: const String _sha =\n42:     'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n43: \n44: PlaybackManifest _manifest({\n45:   OverlaySettings overlay = const OverlaySettings(),\n46:   Map<String, String?> labels = const <String, String?>{},\n47:   bool reverseClipOrder = false,\n48: }) {\n49:   final List<ClipDescriptor> clips = <ClipDescriptor>[\n50:     for (int i = 0; i < 4; i++)\n51:       ClipDescriptor(\n52:         id: 'clip-0$i',\n53:         cameraId: 'CAM-0${i + 1}',\n54:         storageObjectId: 'obj-0$i',\n55:         sha256: _sha,\n56:         sizeBytes: 1024,\n57:         duration: const Duration(seconds: 4),\n58:         mimeType: 'video/mp4',\n59:         label: labels['CAM-0${i + 1}'],\n60:       ),\n61:   ];\n62:   return PlaybackManifest(\n63:     partyId: 'party-1',\n64:     channelId: hauntedSurveillanceChannelId,\n65:     version: 3,\n66:     publishedAt: DateTime.utc(2026, 10, 31, 20),\n67:     clips: reverseClipOrder ? clips.reversed.toList() : clips,\n68:     overlay: overlay,\n69:   );\n70: }\n71: \n72: void main() {\n73:   group('tileFor', () {\n74:     test('maps slots 0..3 to CAM-01..04 with rooms', () {\n75:       expect(tileFor(0), (label: 'CAM-01 · hallway', cameraId: 'CAM-01'));\n76:       expect(tileFor(1), (label: 'CAM-02 · kitchen', cameraId: 'CAM-02'));\n77:       expect(tileFor(2), (label: 'CAM-03 · staircase', cameraId: 'CAM-03'));\n78:       expect(tileFor(3), (label: 'CAM-04 · storage room', cameraId: 'CAM-04'));\n79:     });\n80: \n81:     test('rejects out-of-range slots', () {\n82:       expect(() => tileFor(-1), throwsRangeError);\n83:       expect(() => tileFor(4), throwsRangeError);\n84:     });\n85: \n86:     test('slot list and labels derive from core_playlist cctvSlots', () {\n87:       expect(cctvCameraIds, cctvSlots.map((CctvSlot s) => s.id).toList());\n88:       expect(cctvRooms, cctvSlots.map((CctvSlot s) => s.room).toList());\n89:       expect(() => cctvCameraIds.add('CAM-99'), throwsUnsupportedError);\n90:       expect(() => cctvRooms.add('attic'), throwsUnsupportedError);\n91:     });\n92: \n93:     test('a custom label overrides the slot default, blank keeps it', () {\n94:       expect(tileFor(0, label: 'Front Door'), (\n95:         label: 'Front Door',\n96:         cameraId: 'CAM-01',\n97:       ));\n98:       expect(tileFor(0, label: '   '), (\n99:         label: cctvSlots[0].defaultLabel,\n100:         cameraId: 'CAM-01',\n101:       ));\n102:       expect(tileFor(0), (\n103:         label: cctvSlots[0].defaultLabel,\n104:         cameraId: 'CAM-01',\n105:       ));\n106:     });\n107: \n108:     test('tileForCamera places by camera identity, not index', () {\n109:       expect(tileForCamera('CAM-03', label: 'Stairs'), (\n110:         label: 'Stairs',\n111:         cameraId: 'CAM-03',\n112:       ));\n113:       expect(() => tileForCamera('CAM-09'), throwsArgumentError);\n114:     });\n115: \n116:     test('tileForClip resolves config labels, else slot defaults', () {\n117:       ClipDescriptor clip(String cameraId, {String? label}) => ClipDescriptor(\n118:         id: 'clip-$cameraId',\n119:         cameraId: cameraId,\n120:         storageObjectId: 'obj-$cameraId',\n121:         sha256: _sha,\n122:         sizeBytes: 1024,\n123:         duration: const Duration(seconds: 4),\n124:         mimeType: 'video/mp4',\n125:         label: label,\n126:       );\n127:       expect(tileForClip(clip('CAM-02', label: 'Kitchen Cam')), (\n128:         label: 'Kitchen Cam',\n129:         cameraId: 'CAM-02',\n130:       ));\n131:       expect(tileForClip(clip('CAM-04')), (\n132:         label: cctvSlots[3].defaultLabel,\n133:         cameraId: 'CAM-04',\n134:       ));\n135:     });\n136:   });\n137: \n138:   group('HauntedSurveillancePlugin', () {\n139:     test('descriptor is valid with wall capabilities', () {\n140:       const ChannelPlugin plugin = HauntedSurveillancePlugin();\n141:       expect(plugin.descriptor.id, hauntedSurveillanceChannelId);\n142:       expect(plugin.descriptor.title, 'Haunted Surveillance');\n143:       expect(plugin.descriptor.version, greaterThan(0));\n144:       expect(plugin.descriptor.capabilities.videoPlayback, isTrue);\n145:       expect(plugin.descriptor.capabilities.effects, isTrue);\n146:       expect(plugin.descriptor.capabilities.timedEvents, isTrue);\n147:     });\n148: \n149:     test('descriptor round-trips through json', () {\n150:       const ChannelPlugin plugin = HauntedSurveillancePlugin();\n151:       final ChannelDescriptor back = ChannelDescriptor.fromJson(\n152:         plugin.descriptor.toJson(),\n153:       );\n154:       expect(back.id, hauntedSurveillanceChannelId);\n155:       expect(back.capabilities, plugin.descriptor.capabilities);\n156:     });\n157: \n158:     test('is registry-compatible alongside sibling channels', () {\n159:       // Inline registry shape (no kernel_app import needed); the sibling\n160:       // stub stands in for RetroHorrorPlugin's descriptor id contract.\n161:       final Map<String, ChannelPlugin> registry = <String, ChannelPlugin>{\n162:         for (final ChannelPlugin p in <ChannelPlugin>[\n163:           const HauntedSurveillancePlugin(),\n164:           const _SiblingStubPlugin(),\n165:         ])\n166:           p.descriptor.id: p,\n167:       };\n168:       expect(\n169:         registry['haunted_surveillance'],\n170:         isA<HauntedSurveillancePlugin>(),\n171:       );\n172:       expect(registry['retro_horror'], isA<_SiblingStubPlugin>());\n173:     });\n174: \n175:     testWidgets('boots the wall with a fake coordinator', (\n176:       WidgetTester tester,\n177:     ) async {\n178:       final _FakeHandle handle = _FakeHandle();\n179:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n180:         disableEffects: true,\n181:         tileBuilder: _fakeSurface,\n182:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n183:       );\n184:       final ChannelContext ctx = ChannelContext(\n185:         partyId: PartyId('party-1'),\n186:         playbackHandle: handle,\n187:       );\n188:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n189:       await tester.pumpAndSettle();\n190:       expect(handle.prepared, isTrue);\n191:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n192:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n193:       expect(find.text('CAM-03 · staircase'), findsOneWidget);\n194:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n195:       expect(find.text('REC'), findsWidgets);\n196:       expect(find.text('20:00:00'), findsNWidgets(4));\n197:       expect(find.text('SIGNAL LOST'), findsNothing);\n198:     });\n199: \n200:     testWidgets(\n201:       'manifest without labels falls back to core_playlist defaults',\n202:       (WidgetTester tester) async {\n203:         // Manifest clips carry no `label`: wall labels must resolve to the\n204:         // canonical slot defaults from core_playlist, never to clip ids.\n205:         final _FakeHandle handle = _FakeHandle();\n206:         final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n207:           disableEffects: true,\n208:           manifest: _manifest(),\n209:           tileBuilder: _fakeSurface,\n210:         );\n211:         final ChannelContext ctx = ChannelContext(\n212:           partyId: PartyId('party-1'),\n213:           playbackHandle: handle,\n214:         );\n215:         await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n216:         await tester.pumpAndSettle();\n217:         for (final CctvSlot slot in cctvSlots) {\n218:           expect(find.text(slot.defaultLabel), findsOneWidget);\n219:         }\n220:         expect(find.textContaining('clip-0'), findsNothing);\n221:       },\n222:     );\n223: \n224:     testWidgets('custom-label manifest drives wall slot labels end-to-end', (\n225:       WidgetTester tester,\n226:     ) async {\n227:       // Owner Q3: labels are config-driven. A manifest whose clips carry\n228:       // `label` must drive the HUD text on the matching camera slot, while\n229:       // slots without a label keep the core_playlist default.\n230:       final _FakeHandle handle = _FakeHandle();\n231:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n232:         disableEffects: true,\n233:         manifest: _manifest(\n234:           labels: const <String, String?>{\n235:             'CAM-01': 'Front Door',\n236:             'CAM-02': null,\n237:             'CAM-03': 'Basement',\n238:             'CAM-04': '   ',\n239:           },\n240:         ),\n241:         tileBuilder: _fakeSurface,\n242:       );\n243:       final ChannelContext ctx = ChannelContext(\n244:         partyId: PartyId('party-1'),\n245:         playbackHandle: handle,\n246:       );\n247:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n248:       await tester.pumpAndSettle();\n249:       expect(find.text('Front Door'), findsOneWidget);\n250:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n251:       expect(find.text('Basement'), findsOneWidget);\n252:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n253:       // Blank labels are not rendered as-is.\n254:       expect(find.text('   '), findsNothing);\n255:     });\n256: \n257:     testWidgets('slots follow camera identity, not manifest clip order', (\n258:       WidgetTester tester,\n259:     ) async {\n260:       final _FakeHandle handle = _FakeHandle();\n261:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n262:         disableEffects: true,\n263:         manifest: _manifest(\n264:           labels: const <String, String?>{\n265:             'CAM-01': 'Front Door',\n266:             'CAM-02': 'Kitchen Cam',\n267:             'CAM-03': 'Stairs',\n268:             'CAM-04': 'Vault',\n269:           },\n270:           reverseClipOrder: true,\n271:         ),\n272:         tileBuilder: _fakeSurface,\n273:       );\n274:       final ChannelContext ctx = ChannelContext(\n275:         partyId: PartyId('party-1'),\n276:         playbackHandle: handle,\n277:       );\n278:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n279:       await tester.pumpAndSettle();\n280:       // Labels are placed by camera id, so reversed clip order still puts\n281:       // CAM-01's label on wall slot 0.\n282:       final Text first = tester.widget<Text>(find.text('Front Door'));\n283:       expect(first.data, 'Front Door');\n284:       expect(\n285:         tester.getTopLeft(find.text('Front Door')).dx,\n286:         lessThan(tester.getTopLeft(find.text('Kitchen Cam')).dx),\n287:       );\n288:       expect(\n289:         tester.getTopLeft(find.text('Stairs')).dy,\n290:         greaterThan(tester.getTopLeft(find.text('Kitchen Cam')).dy),\n291:       );\n292:     });\n293: \n294:     testWidgets('unknown-camera manifest degrades to defaults per slot', (\n295:       WidgetTester tester,\n296:     ) async {\n297:       // Validation rejects unknown camera ids upstream (core_playlist), but\n298:       // a stale payload must never crash the wall: an unmatched clip is\n299:       // ignored and its slot keeps the canonical default.\n300:       final _FakeHandle handle = _FakeHandle();\n301:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n302:         disableEffects: true,\n303:         manifest: PlaybackManifest(\n304:           partyId: 'party-1',\n305:           channelId: hauntedSurveillanceChannelId,\n306:           version: 3,\n307:           publishedAt: DateTime.utc(2026, 10, 31, 20),\n308:           clips: <ClipDescriptor>[\n309:             for (int i = 0; i < 3; i++)\n310:               ClipDescriptor(\n311:                 id: 'clip-0$i',\n312:                 cameraId: 'CAM-0${i + 1}',\n313:                 storageObjectId: 'obj-0$i',\n314:                 sha256: _sha,\n315:                 sizeBytes: 1024,\n316:                 duration: const Duration(seconds: 4),\n317:                 mimeType: 'video/mp4',\n318:               ),\n319:             const ClipDescriptor(\n320:               id: 'clip-99',\n321:               cameraId: 'CAM-09',\n322:               storageObjectId: 'obj-99',\n323:               sha256: _sha,\n324:               sizeBytes: 1024,\n325:               duration: Duration(seconds: 4),\n326:               mimeType: 'video/mp4',\n327:               label: 'Rodent Cam',\n328:             ),\n329:           ],\n330:         ),\n331:         tileBuilder: _fakeSurface,\n332:       );\n333:       final ChannelContext ctx = ChannelContext(\n334:         partyId: PartyId('party-1'),\n335:         playbackHandle: handle,\n336:       );\n337:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n338:       await tester.pumpAndSettle();\n339:       expect(tester.takeException(), isNull);\n340:       expect(find.text('Rodent Cam'), findsNothing);\n341:       for (final CctvSlot slot in cctvSlots) {\n342:         expect(find.text(slot.defaultLabel), findsOneWidget);\n343:       }\n344:     });\n345: \n346:     testWidgets('manifest overlay tunes the tile effect intensities', (\n347:       WidgetTester tester,\n348:     ) async {\n349:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n350:         manifest: _manifest(\n351:           overlay: const OverlaySettings(\n352:             scanlineOpacity: 0.8,\n353:             noiseLevel: 0.05,\n354:             vignette: 0.3,\n355:           ),\n356:         ),\n357:         tileBuilder: _fakeSurface,\n358:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n359:       );\n360:       final ChannelContext ctx = ChannelContext(\n361:         partyId: PartyId('party-1'),\n362:         playbackHandle: _FakeHandle(),\n363:       );\n364:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n365:       await tester.pumpAndSettle();\n366: \n367:       final Iterable<CustomPaint> scanlines = tester.widgetList<CustomPaint>(\n368:         find.byWidgetPredicate(\n369:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n370:         ),\n371:       );\n372:       expect(scanlines, hasLength(4));\n373:       expect(\n374:         (scanlines.first.painter! as ScanlinesPainter).opacity,\n375:         closeTo(0.1 + 0.25 * 0.8, 1e-9),\n376:       );\n377: \n378:       final Iterable<CustomPaint> vignettes = tester.widgetList<CustomPaint>(\n379:         find.byWidgetPredicate(\n380:           (Widget w) => w is CustomPaint && w.painter is VignettePainter,\n381:         ),\n382:       );\n383:       expect(vignettes, hasLength(4));\n384:       expect((vignettes.first.painter! as VignettePainter).strength, 0.3);\n385:     });\n386: \n387:     testWidgets('default wall wires scanline + vignette overlays per tile', (\n388:       WidgetTester tester,\n389:     ) async {\n390:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n391:         tileBuilder: _fakeSurface,\n392:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n393:       );\n394:       final ChannelContext ctx = ChannelContext(\n395:         partyId: PartyId('party-1'),\n396:         playbackHandle: _FakeHandle(),\n397:       );\n398:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n399:       await tester.pumpAndSettle();\n400: \n401:       final Finder scanlines = find.byWidgetPredicate(\n402:         (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n403:       );\n404:       final Finder vignette = find.byWidgetPredicate(\n405:         (Widget w) => w is CustomPaint && w.painter is VignettePainter,\n406:       );\n407:       expect(scanlines, findsNWidgets(4));\n408:       expect(vignette, findsNWidgets(4));\n409:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n410:     });\n411: \n412:     testWidgets('disableEffects removes painters from every tile', (\n413:       WidgetTester tester,\n414:     ) async {\n415:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n416:         disableEffects: true,\n417:         tileBuilder: _fakeSurface,\n418:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n419:       );\n420:       final ChannelContext ctx = ChannelContext(\n421:         partyId: PartyId('party-1'),\n422:         playbackHandle: _FakeHandle(),\n423:       );\n424:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n425:       await tester.pumpAndSettle();\n426:       expect(\n427:         find.byWidgetPredicate(\n428:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n429:         ),\n430:         findsNothing,\n431:       );\n432:     });\n433: \n434:     testWidgets(\n435:       'coordinator boot failure degrades to SignalLost, wall survives',\n436:       (WidgetTester tester) async {\n437:         const HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n438:           disableEffects: true,\n439:           tileBuilder: _fakeSurface,\n440:         );\n441:         final ChannelContext ctx = ChannelContext(\n442:           partyId: PartyId('party-1'),\n443:           playbackHandle: _FailingHandle(),\n444:         );\n445:         await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n446:         await tester.pumpAndSettle();\n447:         expect(find.text('SIGNAL LOST'), findsNWidgets(4));\n448:         expect(tester.takeException(), isNull);\n449:       },\n450:     );\n451: \n452:     testWidgets('a throwing surface degrades to SignalLost, wall survives', (\n453:       WidgetTester tester,\n454:     ) async {\n455:       const HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n456:         disableEffects: true,\n457:         tileBuilder: _throwingSurface,\n458:       );\n459:       final ChannelContext ctx = ChannelContext(\n460:         partyId: PartyId('party-1'),\n461:         playbackHandle: _FakeHandle(),\n462:       );\n463:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n464:       await tester.pumpAndSettle();\n465:       expect(find.text('SIGNAL LOST'), findsNWidgets(4));\n466:       expect(tester.takeException(), isNull);\n467:     });\n468: \n469:     testWidgets('build applies wall config from ChannelContext.settings', (\n470:       WidgetTester tester,\n471:     ) async {\n472:       // Constructor leaves effects on, but the host disables them via the\n473:       // channel contract: settings win without re-instantiating the plugin.\n474:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n475:         tileBuilder: _fakeSurface,\n476:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n477:       );\n478:       final ChannelContext ctx = ChannelContext(\n479:         partyId: PartyId('party-1'),\n480:         playbackHandle: _FakeHandle(),\n481:         settings: const ChannelSettings(<String, Object?>{\n482:           'effectsDisabled': true,\n483:           'manifestVersion': 7,\n484:           'overscanSafe': true,\n485:           'labels': <String, String>{'CAM-01': 'PORCH · custom'},\n486:         }),\n487:       );\n488:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n489:       await tester.pumpAndSettle();\n490: \n491:       expect(\n492:         find.byWidgetPredicate(\n493:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n494:         ),\n495:         findsNothing,\n496:         reason: 'settings effectsDisabled must drop overlays',\n497:       );\n498:       expect(find.text('PORCH · custom'), findsOneWidget);\n499:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n500:       expect(tester.takeException(), isNull);\n501:     });\n502: \n503:     testWidgets('constructor wall config still applies with empty settings', (\n504:       WidgetTester tester,\n505:     ) async {\n506:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n507:         disableEffects: true,\n508:         tileBuilder: _fakeSurface,\n509:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n510:       );\n511:       final ChannelContext ctx = ChannelContext(\n512:         partyId: PartyId('party-1'),\n513:         playbackHandle: _FakeHandle(),\n514:       );\n515:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n516:       await tester.pumpAndSettle();\n517: \n518:       expect(\n519:         find.byWidgetPredicate(\n520:           (Widget w) => w is CustomPaint && w.painter is ScanlinesPainter,\n521:         ),\n522:         findsNothing,\n523:       );\n524:       expect(find.text('CAM-01 · hallway'), findsOneWidget);\n525:       expect(tester.takeException(), isNull);\n526:     });\n527: \n528:     testWidgets('settings label overrides win over manifest clip labels', (\n529:       WidgetTester tester,\n530:     ) async {\n531:       // Precedence composition on one wall: the manifest carries a clip\n532:       // label for CAM-01 AND settings carry an override for the same\n533:       // camera — settings win. CAM-03 keeps its manifest label, CAM-02\n534:       // and CAM-04 keep slot defaults.\n535:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n536:         disableEffects: true,\n537:         manifest: _manifest(\n538:           labels: const <String, String?>{\n539:             'CAM-01': 'Manifest Door',\n540:             'CAM-03': 'Manifest Basement',\n541:           },\n542:         ),\n543:         tileBuilder: _fakeSurface,\n544:       );\n545:       final ChannelContext ctx = ChannelContext(\n546:         partyId: PartyId('party-1'),\n547:         playbackHandle: _FakeHandle(),\n548:         settings: const ChannelSettings(<String, Object?>{\n549:           'labels': <String, String>{'CAM-01': 'PORCH · settings'},\n550:         }),\n551:       );\n552:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n553:       await tester.pumpAndSettle();\n554: \n555:       expect(find.text('PORCH · settings'), findsOneWidget);\n556:       expect(find.text('Manifest Door'), findsNothing);\n557:       expect(find.text('Manifest Basement'), findsOneWidget);\n558:       expect(find.text('CAM-02 · kitchen'), findsOneWidget);\n559:       expect(find.text('CAM-04 · storage room'), findsOneWidget);\n560:       expect(tester.takeException(), isNull);\n561:     });\n562: \n563:     test(\n564:       'cctvLabelOverridesFromSettings filters non-Map/non-string shapes',\n565:       () {\n566:         // No `labels` key at all.\n567:         expect(\n568:           cctvLabelOverridesFromSettings(const ChannelSettings()),\n569:           isEmpty,\n570:         );\n571:         // Non-Map value is ignored, not thrown on.\n572:         expect(\n573:           cctvLabelOverridesFromSettings(\n574:             const ChannelSettings(<String, Object?>{'labels': 'PORCH'}),\n575:           ),\n576:           isEmpty,\n577:         );\n578:         // Non-string keys/values are dropped; only String->String survives.\n579:         expect(\n580:           cctvLabelOverridesFromSettings(\n581:             const ChannelSettings(<String, Object?>{\n582:               'labels': <Object?, Object?>{\n583:                 'CAM-01': 'Porch',\n584:                 'CAM-02': 42,\n585:                 'CAM-03': null,\n586:                 7: 'Attic',\n587:               },\n588:             }),\n589:           ),\n590:           <String, String>{'CAM-01': 'Porch'},\n591:         );\n592:       },\n593:     );\n594:   });\n595: \n596:   group('cctvCameraCountFromSettings', () {\n597:     ChannelSettings settingsWith(Object? value) => ChannelSettings(\n598:       <String, Object?>{CctvWallSettingsKeys.cameraCount: value},\n599:     );\n600: \n601:     test('documented string encoding maps to itself', () {\n602:       expect(cctvCameraCountFromSettings(settingsWith('1')), 1);\n603:       expect(cctvCameraCountFromSettings(settingsWith('2')), 2);\n604:       expect(cctvCameraCountFromSettings(settingsWith('4')), 4);\n605:     });\n606: \n607:     test('absent, invalid, and unreadable values default to four', () {\n608:       expect(cctvCameraCountFromSettings(const ChannelSettings()), 4);\n609:       expect(cctvCameraCountFromSettings(settingsWith('3')), 4);\n610:       expect(cctvCameraCountFromSettings(settingsWith('0')), 4);\n611:       expect(cctvCameraCountFromSettings(settingsWith('')), 4);\n612:       expect(cctvCameraCountFromSettings(settingsWith('banana')), 4);\n613:       expect(cctvCameraCountFromSettings(settingsWith('1.5')), 4);\n614:       expect(cctvCameraCountFromSettings(settingsWith(null)), 4);\n615:       expect(cctvCameraCountFromSettings(settingsWith(true)), 4);\n616:       expect(cctvCameraCountFromSettings(settingsWith(3)), 4);\n617:       expect(cctvCameraCountFromSettings(settingsWith(1.0)), 4);\n618:     });\n619: \n620:     test('surrounding whitespace is tolerated, raw ints pass through', () {\n621:       expect(cctvCameraCountFromSettings(settingsWith(' 2 ')), 2);\n622:       expect(cctvCameraCountFromSettings(settingsWith(2)), 2);\n623:     });\n624:   });\n625: \n626:   group('cctvHeroCameraIdFromSettings', () {\n627:     test('absent and non-string values mean grid', () {\n628:       expect(cctvHeroCameraIdFromSettings(const ChannelSettings()), isNull);\n629:       expect(\n630:         cctvHeroCameraIdFromSettings(\n631:           const ChannelSettings(<String, Object?>{'heroCameraId': ''}),\n632:         ),\n633:         isNull,\n634:       );\n635:       expect(\n636:         cctvHeroCameraIdFromSettings(\n637:           const ChannelSettings(<String, Object?>{'heroCameraId': 42}),\n638:         ),\n639:         isNull,\n640:       );\n641:     });\n642: \n643:     test('non-empty strings pass through (wall validates membership)', () {\n644:       expect(\n645:         cctvHeroCameraIdFromSettings(\n646:           ChannelSettings(<String, Object?>{\n647:             CctvWallSettingsKeys.heroCameraId: 'CAM-02',\n648:           }),\n649:         ),\n650:         'CAM-02',\n651:       );\n652:     });\n653:   });\n654: \n655:   group('cctvEffectiveCount', () {\n656:     test('is min(configured, manifest clips), always supported', () {\n657:       expect(cctvEffectiveCount(configuredCount: 4, manifestClipCount: 4), 4);\n658:       expect(cctvEffectiveCount(configuredCount: 2, manifestClipCount: 4), 2);\n659:       expect(cctvEffectiveCount(configuredCount: 1, manifestClipCount: 4), 1);\n660:       expect(cctvEffectiveCount(configuredCount: 4, manifestClipCount: 2), 2);\n661:       expect(cctvEffectiveCount(configuredCount: 4, manifestClipCount: 1), 1);\n662:       expect(cctvEffectiveCount(configuredCount: 2, manifestClipCount: 1), 1);\n663:     });\n664: \n665:     test('unsupported inputs degrade instead of crashing', () {\n666:       expect(cctvEffectiveCount(configuredCount: 3, manifestClipCount: 4), 4);\n667:       expect(cctvEffectiveCount(configuredCount: 2, manifestClipCount: 3), 2);\n668:     });\n669:   });\n670: \n671:   group('adaptive wall layouts', () {\n672:     Future<void> pumpWall(\n673:       WidgetTester tester,\n674:       ChannelSettings settings, {\n675:       PlaybackManifest? manifest,\n676:     }) async {\n677:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n678:         disableEffects: true,\n679:         manifest: manifest,\n680:         tileBuilder: _fakeSurface,\n681:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n682:       );\n683:       final ChannelContext ctx = ChannelContext(\n684:         partyId: PartyId('party-1'),\n685:         playbackHandle: _FakeHandle(),\n686:         settings: settings,\n687:       );\n688:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n689:       await tester.pumpAndSettle();\n690:     }\n691: \n692:     ChannelSettings countSettings(String count) => ChannelSettings(\n693:       <String, Object?>{CctvWallSettingsKeys.cameraCount: count},\n694:     );\n695: \n696:     testWidgets('count 1 renders one full-size tile', (\n697:       WidgetTester tester,\n698:     ) async {\n699:       await pumpWall(tester, countSettings('1'));\n700:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n701:       for (final String camera in <String>['CAM-02', 'CAM-03', 'CAM-04']) {\n702:         expect(find.byKey(Key('surface-$camera')), findsNothing);\n703:       }\n704:       final Size wall = tester.getSize(find.byKey(kCctvWallKey));\n705:       final Rect tile = tester.getRect(find.byKey(const Key('surface-CAM-01')));\n706:       // Padded single tile: strictly inside the viewport-sized wall, and\n707:       // larger than any single quadrant of the 2x2 grid would be.\n708:       expect(tile.width, greaterThan(wall.width / 2));\n709:       expect(tile.height, greaterThan(wall.height / 2));\n710:       expect(\n711:         Rect.fromLTWH(0, 0, wall.width, wall.height).contains(tile.topLeft) &&\n712:             Rect.fromLTWH(\n713:               0,\n714:               0,\n715:               wall.width,\n716:               wall.height,\n717:             ).contains(tile.bottomRight),\n718:         isTrue,\n719:       );\n720:       expect(tester.takeException(), isNull);\n721:     });\n722: \n723:     testWidgets('count 2 renders two side-by-side tiles in one row', (\n724:       WidgetTester tester,\n725:     ) async {\n726:       await pumpWall(tester, countSettings('2'));\n727:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n728:       expect(find.byKey(const Key('surface-CAM-02')), findsOneWidget);\n729:       expect(find.byKey(const Key('surface-CAM-03')), findsNothing);\n730:       expect(find.byKey(const Key('surface-CAM-04')), findsNothing);\n731:       final Rect first = tester.getRect(\n732:         find.byKey(const ValueKey<String>('wall-slot-CAM-01')),\n733:       );\n734:       final Rect second = tester.getRect(\n735:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n736:       );\n737:       // Same row (equal tops), canonical order (CAM-01 left of CAM-02),\n738:       // roughly half the wall each.\n739:       expect(first.top, second.top);\n740:       expect(first.left, lessThan(second.left));\n741:       expect(first.width, closeTo(second.width, 1));\n742:       final Size wall = tester.getSize(find.byKey(kCctvWallKey));\n743:       expect(first.width, closeTo(wall.width / 2, 6));\n744:       expect(tester.takeException(), isNull);\n745:     });\n746: \n747:     testWidgets('invalid count defaults to four tiles', (\n748:       WidgetTester tester,\n749:     ) async {\n750:       await pumpWall(tester, countSettings('3'));\n751:       for (final String camera in cctvCameraIds) {\n752:         expect(find.byKey(Key('surface-$camera')), findsOneWidget);\n753:       }\n754:       expect(tester.takeException(), isNull);\n755:     });\n756: \n757:     testWidgets('tile builders run for active ids only', (\n758:       WidgetTester tester,\n759:     ) async {\n760:       final List<String> built = <String>[];\n761:       Widget recording(\n762:         BuildContext context,\n763:         int index,\n764:         String label,\n765:         String cameraId,\n766:       ) {\n767:         built.add(cameraId);\n768:         return _fakeSurface(context, index, label, cameraId);\n769:       }\n770: \n771:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n772:         disableEffects: true,\n773:         tileBuilder: recording,\n774:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n775:       );\n776:       final ChannelContext ctx = ChannelContext(\n777:         partyId: PartyId('party-1'),\n778:         playbackHandle: _FakeHandle(),\n779:         settings: countSettings('2'),\n780:       );\n781:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n782:       await tester.pumpAndSettle();\n783:       expect(built, <String>['CAM-01', 'CAM-02']);\n784:     });\n785: \n786:     testWidgets('labels and manifest mapping use the active set', (\n787:       WidgetTester tester,\n788:     ) async {\n789:       await pumpWall(\n790:         tester,\n791:         countSettings('2'),\n792:         manifest: _manifest(\n793:           labels: const <String, String?>{\n794:             'CAM-01': 'Front Door',\n795:             'CAM-02': 'Kitchen Cam',\n796:             'CAM-03': 'Basement',\n797:             'CAM-04': 'Vault',\n798:           },\n799:         ),\n800:       );\n801:       expect(find.text('Front Door'), findsOneWidget);\n802:       expect(find.text('Kitchen Cam'), findsOneWidget);\n803:       expect(find.text('Basement'), findsNothing);\n804:       expect(find.text('Vault'), findsNothing);\n805:     });\n806: \n807:     testWidgets('a two-clip manifest caps the wall at two tiles', (\n808:       WidgetTester tester,\n809:     ) async {\n810:       PlaybackManifest twoClip() {\n811:         final PlaybackManifest full = _manifest();\n812:         return PlaybackManifest(\n813:           partyId: full.partyId,\n814:           channelId: full.channelId,\n815:           version: full.version,\n816:           publishedAt: full.publishedAt,\n817:           clips: full.clips.take(2).toList(),\n818:         );\n819:       }\n820: \n821:       await pumpWall(tester, const ChannelSettings(), manifest: twoClip());\n822:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n823:       expect(find.byKey(const Key('surface-CAM-02')), findsOneWidget);\n824:       expect(find.byKey(const Key('surface-CAM-03')), findsNothing);\n825:       expect(find.byKey(const Key('surface-CAM-04')), findsNothing);\n826:       expect(tester.takeException(), isNull);\n827:     });\n828: \n829:     testWidgets(\n830:       'an unsupported-length manifest degrades to per-slot defaults',\n831:       (WidgetTester tester) async {\n832:         PlaybackManifest threeClip() {\n833:           final PlaybackManifest full = _manifest();\n834:           return PlaybackManifest(\n835:             partyId: full.partyId,\n836:             channelId: full.channelId,\n837:             version: full.version,\n838:             publishedAt: full.publishedAt,\n839:             clips: full.clips.take(3).toList(),\n840:           );\n841:         }\n842: \n843:         await pumpWall(tester, const ChannelSettings(), manifest: threeClip());\n844:         for (final CctvSlot slot in cctvSlots) {\n845:           expect(find.text(slot.defaultLabel), findsOneWidget);\n846:         }\n847:         expect(tester.takeException(), isNull);\n848:       },\n849:     );\n850: \n851:     testWidgets('settings count wins; constructor count is the fallback', (\n852:       WidgetTester tester,\n853:     ) async {\n854:       // No settings key: the constructor default (2 here) applies.\n855:       final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n856:         disableEffects: true,\n857:         tileBuilder: _fakeSurface,\n858:         clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n859:         cameraCount: 2,\n860:       );\n861:       ChannelContext ctx = ChannelContext(\n862:         partyId: PartyId('party-1'),\n863:         playbackHandle: _FakeHandle(),\n864:       );\n865:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n866:       await tester.pumpAndSettle();\n867:       expect(find.byKey(const Key('surface-CAM-03')), findsNothing);\n868: \n869:       // Present settings win over the constructor default.\n870:       ctx = ChannelContext(\n871:         partyId: PartyId('party-1'),\n872:         playbackHandle: _FakeHandle(),\n873:         settings: countSettings('4'),\n874:       );\n875:       await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n876:       await tester.pumpAndSettle();\n877:       expect(find.byKey(const Key('surface-CAM-03')), findsOneWidget);\n878:     });\n879: \n880:     testWidgets('hero animates the existing tile fullscreen, siblings fade', (\n881:       WidgetTester tester,\n882:     ) async {\n883:       Future<void> pumpWithHero(WidgetTester tester, String? hero) async {\n884:         final HauntedSurveillancePlugin plugin = HauntedSurveillancePlugin(\n885:           disableEffects: true,\n886:           tileBuilder: _fakeSurface,\n887:           clock: _FakeClock(DateTime(2026, 10, 31, 20)),\n888:         );\n889:         final ChannelContext ctx = ChannelContext(\n890:           partyId: PartyId('party-1'),\n891:           playbackHandle: _FakeHandle(),\n892:           settings: ChannelSettings(<String, Object?>{\n893:             if (hero != null) CctvWallSettingsKeys.heroCameraId: hero,\n894:           }),\n895:         );\n896:         await tester.pumpWidget(MaterialApp(home: plugin.build(ctx)));\n897:       }\n898: \n899:       await pumpWithHero(tester, null);\n900:       await tester.pumpAndSettle();\n901:       final Rect cell = tester.getRect(\n902:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n903:       );\n904:       final Size wall = tester.getSize(find.byKey(kCctvWallKey));\n905: \n906:       await pumpWithHero(tester, 'CAM-02');\n907:       await tester.pump(kWallLayoutDuration ~/ 2);\n908:       final Rect mid = tester.getRect(\n909:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n910:       );\n911:       // Intermediate geometry: strictly between the grid cell and the full\n912:       // viewport rectangle.\n913:       expect(mid.width, greaterThan(cell.width));\n914:       expect(mid.width, lessThan(wall.width));\n915:       expect(mid.height, greaterThan(cell.height));\n916: \n917:       await tester.pumpAndSettle();\n918:       final Rect heroRect = tester.getRect(\n919:         find.byKey(const ValueKey<String>('wall-slot-CAM-02')),\n920:       );\n921:       expect(heroRect.left, 0);\n922:       expect(heroRect.top, 0);\n923:       expect(heroRect.width, wall.width);\n924:       expect(heroRect.height, wall.height);\n925:       // Siblings stay mounted (faded, but present) — no decoder churn.\n926:       expect(find.byKey(const Key('surface-CAM-01')), findsOneWidget);\n927:       expect(find.byKey(const Key('surface-CAM-03')), findsOneWidget);\n928:       expect(find.byKey(const Key('surface-CAM-04')), findsOneWidget);\n929:       final Finder faded = find.byWidgetPredicate(\n930:         (Widget w) =>\n931:             w is AnimatedOpacity && w.opacity == 0 && w.child is IgnorePointer,\n932:       );\n933:       expect(faded, findsNWidgets(3));\n934:       expect(tester.takeException(), isNull);\n935:     });\n936: \n937:     testWidgets('unknown hero id degrades to the grid', (\n938:       WidgetTester tester,\n939:     ) async {\n940:       await pumpWall(\n941:         tester,\n942:         ChannelSettings(<String, Object?>{\n943:           CctvWallSettingsKeys.heroCameraId: 'CAM-09',\n944:         }),\n945:       );\n946:       for (final String camera in cctvCameraIds) {\n947:         expect(find.byKey(Key('surface-$camera')), findsOneWidget);\n948:       }\n949:       expect(\n950:         find.byWidgetPredicate(\n951:           (Widget w) => w is AnimatedOpacity && w.opacity == 0,\n952:         ),\n953:         findsNothing,\n954:       );\n955:       expect(tester.takeException(), isNull);\n956:     });\n957:   });\n958: \n959:   group('port direction (D-08)', () {\n960:     // Finding D-08: channels must be able to consume the control-plane ports\n961:     // without importing `infra_*`. These two tests keep that true from the\n962:     // consumer side: one walks the real import graph, the other compiles and\n963:     // runs fakes implemented purely against `channel_api`.\n964:     test('lib graph of this channel imports no infra_* package', () {\n965:       final Set<String> visitedPackages = <String>{};\n966:       final List<File> sources = _transitiveLibSources(\n967:         Directory.current,\n968:         visitedPackages,\n969:       );\n970:       expect(\n971:         visitedPackages,\n972:         containsAll(<String>['channel_cctv', 'channel_api']),\n973:         reason: 'walk must actually reach the contracts package',\n974:       );\n975:       final List<String> offenders = <String>[\n976:         for (final File f in sources)\n977:           if (f.readAsStringSync().contains('package:infra_')) f.path,\n978:       ];\n979:       expect(\n980:         offenders,\n981:         isEmpty,\n982:         reason: 'channels must not import infra_* (finding D-08)',\n983:       );\n984:     });\n985: \n986:     test('ports are implementable from channel_api alone', () async {\n987:       final _ContractOnlyManifestSource source = _ContractOnlyManifestSource(\n988:         _manifest(),\n989:       );\n990:       final ManifestSource<PlaybackManifest> port = source;\n991:       final List<PlaybackManifest> seen = await port\n992:           .watchCurrent(\n993:             partyId: 'party-1',\n994:             channelId: hauntedSurveillanceChannelId,\n995:           )\n996:           .toList();\n997:       expect(seen, hasLength(1));\n998:       expect(seen.single.channelId, hauntedSurveillanceChannelId);\n999: \n1000:       final SettingsPort settings = _ContractOnlySettings();\n1001:       await settings.setString(\n1002:         partyId: PartyId('party-1'),\n1003:         key: 'label.cam-01',\n1004:         value: 'Front Door',\n1005:       );\n1006:       expect(\n1007:         await settings.getString(\n1008:           partyId: PartyId('party-1'),\n1009:           key: 'label.cam-01',\n1010:         ),\n1011:         'Front Door',\n1012:       );\n1013:     });\n1014:   });\n1015: }\n1016: \n1017: /// Collects the `lib/` sources of [packageRoot] and, transitively, of every\n1018: /// sibling path package reachable through `package:<name>/<path>` imports.\n1019: ///\n1020: /// Only local siblings (`<packages>/<name>/lib/*.dart`) are followed, so SDK\n1021: /// and pub-cache packages terminate the walk. Names are recorded in\n1022: /// [visited] so the caller can assert the graph was not vacuous.\n1023: List<File> _transitiveLibSources(Directory packageRoot, Set<String> visited) {\n1024:   final List<File> collected = <File>[];\n1025:   final List<(String, Directory)> queue = <(String, Directory)>[\n1026:     (_packageNameOf(packageRoot), packageRoot),\n1027:   ];\n1028:   while (queue.isNotEmpty) {\n1029:     final (String name, Directory root) = queue.removeLast();\n1030:     if (!visited.add(name)) {\n1031:       continue;\n1032:     }\n1033:     final Directory lib = Directory('${root.path}/lib');\n1034:     if (!lib.existsSync()) {\n1035:       continue;\n1036:     }\n1037:     for (final File file in lib.listSync(recursive: true).whereType<File>()) {\n1038:       if (!file.path.endsWith('.dart')) {\n1039:         continue;\n1040:       }\n1041:       collected.add(file);\n1042:       for (final String uri in _packageUrisOf(file.readAsStringSync())) {\n1043:         final String target = uri.split('/').first;\n1044:         final Directory sibling = Directory(\n1045:           '${packageRoot.parent.path}/$target',\n1046:         );\n1047:         if (sibling.existsSync()) {\n1048:           queue.add((target, sibling));\n1049:         }\n1050:       }\n1051:     }\n1052:   }\n1053:   return collected;\n1054: }\n1055: \n1056: /// Package name of [root], read from its `pubspec.yaml` name line.\n1057: String _packageNameOf(Directory root) {\n1058:   final File pubspec = File('${root.path}/pubspec.yaml');\n1059:   for (final String line in pubspec.readAsLinesSync()) {\n1060:     if (line.startsWith('name:')) {\n1061:       return line.substring('name:'.length).trim();\n1062:     }\n1063:   }\n1064:   return root.uri.pathSegments.where((String s) => s.isNotEmpty).last;\n1065: }\n1066: \n1067: /// `package:<name>/<path>` URIs referenced by [source].\n1068: Iterable<String> _packageUrisOf(String source) sync* {\n1069:   for (final RegExpMatch match in RegExp(\n1070:     r'package:([a-z0-9_]+/[A-Za-z0-9_./]+)',\n1071:   ).allMatches(source)) {\n1072:     yield match.group(1)!;\n1073:   }\n1074: }\n1075: \n1076: /// Manifest source bound to `PlaybackManifest` using only the contracts port.\n1077: final class _ContractOnlyManifestSource\n1078:     implements ManifestSource<PlaybackManifest> {\n1079:   _ContractOnlyManifestSource(this.manifest);\n1080: \n1081:   final PlaybackManifest manifest;\n1082: \n1083:   @override\n1084:   Stream<PlaybackManifest> watchCurrent({\n1085:     required String partyId,\n1086:     required String channelId,\n1087:   }) async* {\n1088:     yield manifest;\n1089:   }\n1090: }\n1091: \n1092: /// Settings store written against the contracts port; no infra adapter used.\n1093: final class _ContractOnlySettings implements SettingsPort {\n1094:   final Map<String, String> _values = <String, String>{};\n1095: \n1096:   @override\n1097:   Future<String?> getString({\n1098:     required PartyId partyId,\n1099:     required String key,\n1100:   }) async => _values['${partyId.value}/$key'];\n1101: \n1102:   @override\n1103:   Future<void> setString({\n1104:     required PartyId partyId,\n1105:     required String key,\n1106:     required String value,\n1107:   }) async {\n1108:     _values['${partyId.value}/$key'] = value;\n1109:   }\n1110: \n1111:   @override\n1112:   Future<bool?> getBool({\n1113:     required PartyId partyId,\n1114:     required String key,\n1115:   }) async => _values['${partyId.value}/$key'] == 'true';\n1116: \n1117:   @override\n1118:   Future<void> setBool({\n1119:     required PartyId partyId,\n1120:     required String key,\n1121:     required bool value,\n1122:   }) async {\n1123:     _values['${partyId.value}/$key'] = '$value';\n1124:   }\n1125: }\n1126: \n1127: Widget _fakeSurface(\n1128:   BuildContext context,\n1129:   int index,\n1130:   String label,\n1131:   String cameraId,\n1132: ) => Container(color: Colors.black, key: Key('surface-$cameraId'));\n1133: \n1134: Widget _throwingSurface(\n1135:   BuildContext context,\n1136:   int index,\n1137:   String label,\n1138:   String cameraId,\n1139: ) {\n1140:   throw StateError('no decoder in tests');\n1141: }\n1142: \n1143: /// Inline stand-in for a sibling channel's descriptor id contract.\n1144: final class _SiblingStubPlugin implements ChannelPlugin {\n1145:   const _SiblingS