n110:     this.disableEffects = false,\n111:     this.glitchSeed = 0xc0ffee,\n112:   });\n113: \n114:   /// Builds per-tile video surfaces (app-owned player lifecycles).\n115:   final CctvTileBuilder tileBuilder;\n116: \n117:   /// Effect profile applied to tile overlays; defaults to [cctvProfile].\n118:   final EffectProfile? profile;\n119: \n120:   /// Optional playback manifest; when it carries exactly four clips their\n121:   /// camera ids drive the wall slots, otherwise [tileFor] defaults apply.\n122:   final PlaybackManifest? manifest;\n123: \n124:   /// Clock source for tile HUD timestamps.\n125:   final Clock clock;\n126: \n127:   /// Drops effect overlays (tests / hidden recovery overlay).\n128:   final bool disableEffects;\n129: \n130:   /// Seed for the wall glitch controller (deterministic replay).\n131:   final int glitchSeed;\n132: \n133:   @override\n134:   ChannelDescriptor get descriptor => const ChannelDescriptor(\n135:         id: hauntedSurveillanceChannelId,\n136:         title: 'Haunted Surveillance',\n137:         version: 1,\n138:         capabilities: ChannelCapability(\n139:           videoPlayback: true,\n140:           effects: true,\n141:           timedEvents: true,\n142:         ),\n143:       );\n144: \n145:   @override\n146:   Widget build(ChannelContext context) {\n147:     // Wall config flows through the channel contract: settings published by\n148:     // the host win over constructor defaults, so the registry object never\n149:     // needs to be discarded/re-instantiated to change wall behaviour.\n150:     final bool settingsDisabled = context.settings\n151:         .get<bool>(CctvWallSettingsKeys.effectsDisabled, false);\n152:     return CctvWall(\n153:       playbackHandle: context.playbackHandle,\n154:       tileBuilder: tileBuilder,\n155:       profile: profile ??\n156:           (manifest == null\n157:               ? cctvProfile()\n158:               : effectProfileFromOverlay(manifest!.overlay)),\n159:       manifest: manifest,\n160:       clock: clock,\n161:       disableEffects: disableEffects || settingsDisabled,\n162:       glitchSeed: glitchSeed,\n163:       labelOverrides: cctvLabelOverridesFromSettings(context.settings),\n164:     );\n165:   }\n166: }\n167: \n168: /// 2x2 CCTV wall shell.\n169: ///\n170: /// Boots by preparing the app-owned [PlaybackHandle], then shows four\n171: /// [CctvTile]s (video surface + HUD + effect overlay). A single tile\n172: /// failure never takes down the wall: surface builders that throw are\n173: /// caught per tile and render [SignalLost].\n174: class CctvWall extends StatefulWidget {\n175:   /// Creates the wall shell.\n176:   CctvWall({\n177:     super.key,\n178:     required this.playbackHandle,\n179:     this.tileBuilder = _defaultTileSurface,\n180:     EffectProfile? profile,\n181:     this.manifest,\n182:     this.clock = const SystemClock(),\n183:     this.disableEffects = false,\n184:     this.glitchSeed = 0xc0ffee,\n185:     this.glitchTick = const Duration(milliseconds: 700),\n186:     this.labelOverrides = const <String, String>{},\n187:   }) : profile = profile ?? cctvProfile();\n188: \n189:   /// Opaque app-owned playback control surface.\n190:   final PlaybackHandle playbackHandle;\n191: \n192:   /// Builds per-tile video surfaces.\n193:   final CctvTileBuilder tileBuilder;\n194: \n195:   /// Effect profile applied to tile overlays.\n196:   final EffectProfile profile;\n197: \n198:   /// Optional manifest overriding the default camera slot map.\n199:   final PlaybackManifest? manifest;\n200: \n201:   /// Clock source for tile HUD timestamps.\n202:   final Clock clock;\n203: \n204:   /// Drops effect overlays and glitch ticking.\n205:   final bool disableEffects;\n206: \n207:   /// Seed for the wall glitch controller.\n208:   final int glitchSeed;\n209: \n210:   /// Cadence of glitch-controller ticks.\n211:   final Duration glitchTick;\n212: \n213:   /// Per-camera label overrides applied on top of the slot map\n214:   /// (`{cameraId: label}`); empty means no overrides.\n215:   final Map<String, String> labelOverrides;\n216: \n217:   @override\n218:   State<CctvWall> createState() => _CctvWallState();\n219: }\n220: \n221: class _CctvWallState extends State<CctvWall> {\n222:   late final GlitchController _glitch;\n223:   Timer? _glitchTimer;\n224:   bool _ready = false;\n225:   bool _bootFailed = false;\n226: \n227:   @override\n228:   void initState() {\n229:     super.initState();\n230:     _glitch = GlitchController(seed: widget.glitchSeed);\n231:     if (!widget.disableEffects) {\n232:       _glitchTimer =\n233:           Timer.periodic(widget.glitchTick, (_) => _glitch.tick());\n234:     }\n235:     unawaited(_boot());\n236:   }\n237: \n238:   Future<void> _boot() async {\n239:     bool failed = false;\n240:     try {\n241:       await widget.playbackHandle.prepare();\n242:     } catch (_) {\n243:       // A failed coordinator boot must not take the wall down: every tile\n244:       // degrades to the SIGNAL LOST fallback instead.\n245:       failed = true;\n246:     }\n247:     if (!mounted) {\n248:       return;\n249:     }\n250:     setState(() {\n251:       _ready = true;\n252:       _bootFailed = failed;\n253:     });\n254:   }\n255: \n256:   @override\n257:   void didUpdateWidget(CctvWall oldWidget) {\n258:     super.didUpdateWidget(oldWidget);\n259:     // Reconcile the glitch ticker when effect state changes (e.g. the\n260:     // recovery panel toggles effects OFF -> ON): a stale timer must not\n261:     // keep ticking while disabled, and re-enabling must restart it.\n262:     if (oldWidget.disableEffects != widget.disableEffects) {\n263:       if (widget.disableEffects) {\n264:         _glitchTimer?.cancel();\n265:         _glitchTimer = null;\n266:         _glitch.reset();\n267:       } else {\n268:         _glitchTimer ??= Timer.periodic(\n269:           widget.glitchTick,\n270:           (_) => _glitch.tick(),\n271:         );\n272:       }\n273:     } else if (!widget.disableEffects &&\n274:         oldWidget.glitchTick != widget.glitchTick) {\n275:       _glitchTimer?.cancel();\n276:       _glitchTimer = Timer.periodic(\n277:         widget.glitchTick,\n278:         (_) => _glitch.tick(),\n279:       );\n280:     }\n281:   }\n282: \n283:   @override\n284:   void dispose() {\n285:     _glitchTimer?.cancel();\n286:     _glitch.dispose();\n287:     super.dispose();\n288:   }\n289: \n290:   /// Wall slots in canonical order, one per `core_playlist` [CctvSlot].\n291:   ///\n292:   /// Slot placement always follows camera identity (`cctvSlots` order), never\n293:   /// manifest clip order, so a reordered control-plane payload cannot move a\n294:   /// feed to the wrong tile. When the manifest carries one clip per slot, the\n295:   /// clip drives the tile via [tileForClip]: its `label` wins when present,\n296:   /// else the `core_playlist` slot default applies (owner Q3). Manifests that\n297:   /// are short, oversized, or name unknown cameras fall back to the static\n298:   /// [tileFor] defaults per slot instead of taking the wall down.\n299:   /// Per-camera label overrides from [ChannelContext.settings] apply on top.\n300:   List<({String label, String cameraId})> _slots() {\n301:     final PlaybackManifest? manifest = widget.manifest;\n302:     final Map<String, ClipDescriptor> byCamera = <String, ClipDescriptor>{};\n303:     if (manifest != null && manifest.clips.length == cctvSlots.length) {\n304:       for (final ClipDescriptor clip in manifest.clips) {\n305:         byCamera.putIfAbsent(clip.cameraId, () => clip);\n306:       }\n307:     }\n308:     final List<({String label, String cameraId})> base =\n309:         <({String label, String cameraId})>[\n310:       for (final CctvSlot slot in cctvSlots)\n311:         if (byCamera[slot.id] case final ClipDescriptor clip)\n312:           tileForClip(clip)\n313:         else\n314:           tileFor(slot.index),\n315:     ];\n316:     if (widget.labelOverrides.isEmpty) {\n317:       return base;\n318:     }\n319:     return <({String label, String cameraId})>[\n320:       for (final ({String label, String cameraId}) slot in base)\n321:         (\n322:           label: widget.labelOverrides[slot.cameraId] ?? slot.label,\n323:           cameraId: slot.cameraId,\n324:         ),\n325:     ];\n326:   }\n327: \n328:   @override\n329:   Widget build(BuildContext context) {\n330:     if (!_ready) {\n331:       return const Center(child: CircularProgressIndicator());\n332:     }\n333:     // 2x2 wall sized by the viewport: Column/Row of Expanded cells fills\n334:     // exactly the incoming constraints (720p through 1080p, including the\n335:     // host's overscan-safe padding) with no scrollable and no overflow.\n336:     // A fixed GridView cross-axis layout cannot guarantee this: without a\n337:     // viewport-derived childAspectRatio the bottom row renders off-screen.\n338:     final List<({String label, String cameraId})> slots = _slots();\n339:     Widget cell(int index) => Expanded(\n340:           child: Padding(\n341:             padding: const EdgeInsets.all(2),\n342:             child: _WallTile(\n343:               index: index,\n344:               label: slots[index].label,\n345:               cameraId: slots[index].cameraId,\n346:               tileBuilder: widget.tileBuilder,\n347:               profile: widget.profile,\n348:               clock: widget.clock,\n349:               disableEffects: widget.disableEffects,\n350:               glitch: _glitch,\n351:               bootFailed: _bootFailed,\n352:             ),\n353:           ),\n354:         );\n355:     return Container(\n356:       color: CctvTheme.gutter,\n357:       padding: const EdgeInsets.all(4),\n358:       child: Column(\n359:         children: <Widget>[\n360:           Expanded(\n361:             child: Row(\n362:               children: <Widget>[cell(0), cell(1)],\n363:             ),\n364:           ),\n365:           Expanded(\n366:             child: Row(\n367:               children: <Widget>[cell(2), cell(3)],\n368:             ),\n369:           ),\n370:         ],\n371:       ),\n372:     );\n373:   }\n374: }\n375: \n376: /// One wall slot: safe surface build + tile chrome.\n377: class _WallTile extends StatelessWidget {\n378:   const _WallTile({\n379:     required this.index,\n380:     required this.label,\n381:     required this.cameraId,\n382:     required this.tileBuilder,\n383:     required this.profile,\n384:     required this.clock,\n385:     required this.disableEffects,\n386:     required this.glitch,\n387:     required this.bootFailed,\n388:   });\n389: \n390:   final int index;\n391:   final String label;\n392:   final String cameraId;\n393:   final CctvTileBuilder tileBuilder;\n394:   final EffectProfile profile;\n395:   final Clock clock;\n396:   final bool disableEffects;\n397:   final GlitchController glitch;\n398:   final bool bootFailed;\n399: \n400:   @override\n401:   Widget build(BuildContext context) {\n402:     if (bootFailed) {\n403:       return const CctvTile(hasError: true, child: SizedBox.shrink());\n404:     }\n405:     Widget surface;\n406:     try {\n407:       surface = tileBuilder(context, index, label, cameraId);\n408:     } catch (_) {\n409:       return const CctvTile(\n410:         hasError: true,\n411:         child: SizedBox.shrink(),\n412:       );\n413:     }\n414:     Widget? effects;\n415:     if (!disableEffects) {\n416:       effects = _TileEffects(profile: profile, glitch: glitch);\n417:     }\n418:     return CctvTile(\n419:       disableEffects: disableEffects,\n420:       effectOverlay: effects,\n421:       hud: HudOverlay(label: label, clock: clock),\n422:       child: surface,\n423:     );\n424:   }\n425: }\n426: \n427: /// Scanlines + vignette + seeded noise overlay for one tile.\n428: class _TileEffects extends StatelessWidget {\n429:   const _TileEffects({required this.profile, required this.glitch});\n430: \n431:   final EffectProfile profile;\n432:   final GlitchController glitch;\n433: \n434:   @override\n435:   Widget build(BuildContext context) => ListenableBuilder(\n436:         listenable: glitch,\n437:         builder: (BuildContext context, Widget? _) => CctvEffectsOverlay(\n438:           profile: profile,\n439:           glitchIntensity: glitch.currentIntensity,\n440:         ),\n441:       );\n442: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a58ca87466a5c41cbb9b58d4b5"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/plugin.dart\"}"},"time":{"start":1793461685501,"end":1793461687458}}}}
{"type":"tool_use","timestamp":1793461687459,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a58ea4001j8UhjPeisWLgPf","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a58a4c001esd1e160zU527e","type":"tool","id":"call_01a192a58e4e742181599244bc342644","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/cctv_tiles.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/cctv_tiles.dart, lines 1-75\n1: /// Static tile map for the 2x2 CCTV wall.\n2: ///\n3: /// Derived from `core_playlist`'s `cctvSlots` — the single source of truth\n4: /// for camera identity (owner Q3). No `CAM-0x` literals live here; id, wall\n5: /// order, and default room labels all come from the slot list, so adding a\n6: /// camera in `core_playlist` flows through without touching this file.\n7: library;\n8: \n9: import 'package:core_playlist/core_playlist.dart';\n10: \n11: /// Camera room names in wall order (top-left reading order).\n12: ///\n13: /// Derived from `cctvSlots`; kept for callers that only need rooms.\n14: final List<String> cctvRooms = List<String>.unmodifiable(\n15:   <String>[for (final CctvSlot slot in cctvSlots) slot.room],\n16: );\n17: \n18: /// Camera ids in wall order.\n19: ///\n20: /// Derived from `cctvSlots`; kept for callers that only need ids.\n21: final List<String> cctvCameraIds = List<String>.unmodifiable(\n22:   <String>[for (final CctvSlot slot in cctvSlots) slot.id],\n23: );\n24: \n25: /// Resolves wall slot [index] to its label and camera id.\n26: ///\n27: /// Valid indices are `0..3`; anything else throws a [RangeError]. Pass\n28: /// [label] to override the slot default with a config-driven label (e.g. a\n29: /// manifest clip label); absent or blank overrides fall back to the\n30: /// `core_playlist` slot default. See also [tileForCamera] and [tileForClip].\n31: ({String label, String cameraId}) tileFor(int index, {String? label}) {\n32:   if (index < 0 || index >= cctvSlots.length) {\n33:     throw RangeError.range(\n34:       index,\n35:       0,\n36:       cctvSlots.length - 1,\n37:       'index',\n38:       'tileFor index must be a wall slot 0..3',\n39:     );\n40:   }\n41:   final CctvSlot slot = cctvSlots[index];\n42:   final String resolved = (label != null && label.trim().isNotEmpty)\n43:       ? label\n44:       : slot.defaultLabel;\n45:   return (label: resolved, cameraId: slot.id);\n46: }\n47: \n48: /// Resolves the wall slot for [cameraId] to its label and camera id.\n49: ///\n50: /// Throws [ArgumentError] for unknown cameras; the wall converts a throwing\n51: /// tile builder into a `SIGNAL LOST` tile so one bad slot cannot take the\n52: /// wall down. Pass [label] to override the slot default (see [tileFor]).\n53: ({String label, String cameraId}) tileForCamera(\n54:   String cameraId, {\n55:   String? label,\n56: }) {\n57:   final CctvSlot? slot = slotForCameraId(cameraId);\n58:   if (slot == null) {\n59:     throw ArgumentError.value(\n60:       cameraId,\n61:       'cameraId',\n62:       'unknown CCTV camera id',\n63:     );\n64:   }\n65:   return tileFor(slot.index, label: label);\n66: }\n67: \n68: /// Resolves the wall slot for manifest [clip].\n69: ///\n70: /// Delegates to [resolveCctvLabel] for the label (custom clip label wins,\n71: /// else the `core_playlist` slot default) and to [tileForCamera] for slot\n72: /// placement — this is the end-to-end manifest-to-wall-label path the wall\n73: /// uses for config-driven labels (owner Q3).\n74: ({String label, String cameraId}) tileForClip(ClipDescriptor clip) =>\n75:     tileForCamera(clip.cameraId, label: resolveCctvLabel(clip));","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/cctv_tiles.dart, lines 1-75\n1: /// Static tile map for the 2x2 CCTV wall.\n2: ///\n3: /// Derived from `core_playlist`'s `cctvSlots` — the single source of truth\n4: /// for camera identity (owner Q3). No `CAM-0x` literals live here; id, wall\n5: /// order, and default room labels all come from the slot list, so adding a\n6: /// camera in `core_playlist` flows through without touching this file.\n7: library;\n8: \n9: import 'package:core_playlist/core_playlist.dart';\n10: \n11: /// Camera room names in wall order (top-left reading order).\n12: ///\n13: /// Derived from `cctvSlots`; kept for callers that only need rooms.\n14: final List<String> cctvRooms = List<String>.unmodifiable(\n15:   <String>[for (final CctvSlot slot in cctvSlots) slot.room],\n16: );\n17: \n18: /// Camera ids in wall order.\n19: ///\n20: /// Derived from `cctvSlots`; kept for callers that only need ids.\n21: final List<String> cctvCameraIds = List<String>.unmodifiable(\n22:   <String>[for (final CctvSlot slot in cctvSlots) slot.id],\n23: );\n24: \n25: /// Resolves wall slot [index] to its label and camera id.\n26: ///\n27: /// Valid indices are `0..3`; anything else throws a [RangeError]. Pass\n28: /// [label] to override the slot default with a config-driven label (e.g. a\n29: /// manifest clip label); absent or blank overrides fall back to the\n30: /// `core_playlist` slot default. See also [tileForCamera] and [tileForClip].\n31: ({String label, String cameraId}) tileFor(int index, {String? label}) {\n32:   if (index < 0 || index >= cctvSlots.length) {\n33:     throw RangeError.range(\n34:       index,\n35:       0,\n36:       cctvSlots.length - 1,\n37:       'index',\n38:       'tileFor index must be a wall slot 0..3',\n39:     );\n40:   }\n41:   final CctvSlot slot = cctvSlots[index];\n42:   final String resolved = (label != null && label.trim().isNotEmpty)\n43:       ? label\n44:       : slot.defaultLabel;\n45:   return (label: resolved, cameraId: slot.id);\n46: }\n47: \n48: /// Resolves the wall slot for [cameraId] to its label and camera id.\n49: ///\n50: /// Throws [ArgumentError] for unknown cameras; the wall converts a throwing\n51: /// tile builder into a `SIGNAL LOST` tile so one bad slot cannot take the\n52: /// wall down. Pass [label] to override the slot default (see [tileFor]).\n53: ({String label, String cameraId}) tileForCamera(\n54:   String cameraId, {\n55:   String? label,\n56: }) {\n57:   final CctvSlot? slot = slotForCameraId(cameraId);\n58:   if (slot == null) {\n59:     throw ArgumentError.value(\n60:       cameraId,\n61:       'cameraId',\n62:       'unknown CCTV camera id',\n63:     );\n64:   }\n65:   return tileFor(slot.index, label: label);\n66: }\n67: \n68: /// Resolves the wall slot for manifest [clip].\n69: ///\n70: /// Delegates to [resolveCctvLabel] for the label (custom clip label wins,\n71: /// else the `core_playlist` slot default) and to [tileForCamera] for slot\n72: /// placement — this is the end-to-end manifest-to-wall-label path the wall\n73: /// uses for config-driven labels (owner Q3).\n74: ({String label, String cameraId}) tileForClip(ClipDescriptor clip) =>\n75:     tileForCamera(clip.cameraId, label: resolveCctvLabel(clip));"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a58e4e742181599244bc342644"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/packages/channel_cctv/lib/src/cctv_tiles.dart\"}"},"time":{"start":1793461685924,"end":1793461687459}}}}
{"type":"tool_use","timestamp":1793461687460,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a591bd001m3zafLAzZb9dkJ","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a58a4c001esd1e160zU527e","type":"tool","id":"call_01a192a5916970138886ba1da0295696","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_boot.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_boot.dart, lines 1-569\n1: /// Boot sequence: kernel registry -> channels -> manifest -> wall.\n2: ///\n3: /// Offline-first: zero network on boot. The fallback manifest comes from the\n4: /// bundled `assets/fixture_manifest.json` (emitted by\n5: /// `tool/gen_fixtures.sh` from the REAL asset bytes via `parseManifest`),\n6: /// loaded with `rootBundle`. `package:testing_toolkit`'s `manifestFixture`\n7: /// (fabricated digests) is test-only and must never be imported here.\n8: ///\n9: /// Phase-2 note (full CacheStore adapter, not yet wired): once the\n10: /// on-disk verified media cache lands, boot will resolve each clip through\n11: /// `CacheStore.findVerified` (re-hash on hit, miss on digest mismatch) and\n12: /// `commit` verified downloads before handing the manifest to the wall.\n13: /// Until then, boot verifies the bundled offline bytes directly with\n14: /// `sha256Hex` and fails closed to unavailable on any sha256/size mismatch.\n15: library;\n16: \n17: import 'dart:convert';\n18: \n19: import 'package:channel_cctv/channel_cctv.dart';\n20: import 'package:channel_retro_tv/channel_retro_tv.dart';\n21: import 'package:core_cache/core_cache.dart';\n22: import 'package:core_foundation/core_foundation.dart';\n23: import 'package:core_playlist/core_playlist.dart';\n24: import 'package:flutter/services.dart';\n25: import 'package:kernel_app/kernel_app.dart';\n26: import 'package:tv_app/src/media/feed_assets.dart';\n27: import 'package:tv_app/src/wall/guest_codes.dart';\n28: import 'package:tv_app/src/wall/live_wall_session.dart';\n29: import 'package:tv_app/src/wall/manifest_store.dart';\n30: \n31: /// Bundled fixture manifest asset (emitted from real asset bytes).\n32: const String kBundledFixtureManifestKey = 'assets/fixture_manifest.json';\n33: \n34: /// Outcome of booting the wall: either a resolved channel + manifest, or the\n35: /// reason no wall is available (drives the app-level status screen).\n36: final class WallBootResult {\n37:   /// Everything needed to render the wall is present.\n38:   const WallBootResult.ready({\n39:     required ChannelRegistry this.registry,\n40:     required ChannelPlugin this.plugin,\n41:     required PlaybackManifest this.manifest,\n42:     required this.usedCachedManifest,\n43:     this.mediaByClipId = const <String, CachedMedia>{},\n44:     this.liveSession,\n45:     this.settings,\n46:     this.initialEffectsDisabled = false,\n47:     this.remoteUnavailableReason,\n48:   }) : unavailableReason = null;\n49: \n50:   /// No wall can be shown; [unavailableReason] is user-facing.\n51:   const WallBootResult.unavailable(this.unavailableReason)\n52:     : registry = null,\n53:       plugin = null,\n54:       manifest = null,\n55:       usedCachedManifest = false,\n56:       mediaByClipId = const <String, CachedMedia>{},\n57:       liveSession = null,\n58:       settings = null,\n59:       initialEffectsDisabled = false,\n60:       remoteUnavailableReason = null;\n61: \n62:   /// Channel registry built during boot.\n63:   final ChannelRegistry? registry;\n64: \n65:   /// Resolved active channel plugin.\n66:   final ChannelPlugin? plugin;\n67: \n68:   /// Validated manifest driving the wall.\n69:   final PlaybackManifest? manifest;\n70: \n71:   /// True when the wall came from the last cached manifest (not the bundle).\n72:   final bool usedCachedManifest;\n73: \n74:   /// Verified durable media keyed by clip id; empty means bundled fallback.\n75:   final Map<String, CachedMedia> mediaByClipId;\n76: \n77:   /// Remote session started only after this wall has rendered.\n78:   final LiveWallSession? liveSession;\n79: \n80:   /// Party-scoped TV settings.\n81:   final SettingsPort? settings;\n82: \n83:   /// Restored effect setting for this party.\n84:   final bool initialEffectsDisabled;\n85: \n86:   /// Why configured live playback was disabled, if applicable.\n87:   final String? remoteUnavailableReason;\n88: \n89:   /// Why the wall is unavailable, when it is.\n90:   final String? unavailableReason;\n91: \n92:   /// Whether a wall can be rendered.\n93:   bool get isReady => plugin != null && manifest != null;\n94: }\n95: \n96: /// Builds the channel registry; injectable so tests can simulate a registry\n97: /// without the haunted-surveillance channel.\n98: typedef WallRegistryFactory = ChannelRegistry Function();\n99: \n100: /// Builds the offline fallback manifest (legacy sync override, tests only).\n101: typedef WallManifestFixture =\n102:     PlaybackManifest Function({\n103:       required String partyId,\n104:       required String channelId,\n105:     });\n106: \n107: /// Loads the bundled fixture manifest JSON text (injected in tests so a\n108: /// missing bundle file does not need the real asset pipeline).\n109: typedef WallBundleLoader = Future<String> Function(String assetKey);\n110: \n111: /// Loads raw bytes for a bundled asset path (injected in tests).\n112: typedef WallAssetBytesLoader = Future<List<int>> Function(String assetPath);\n113: \n114: /// Async fallback-manifest loader (bundled `fixture_manifest.json`).\n115: typedef WallFixtureLoader =\n116:     Future<PlaybackManifest> Function({\n117:       required String partyId,\n118:       required String channelId,\n119:     });\n120: \n121: /// Default registry: haunted surveillance (active) + retro horror (stub that\n122: /// is registered so the kernel can list it, but never resolved/activated).\n123: ChannelRegistry defaultWallRegistry() {\n124:   final ChannelRegistry registry = ChannelRegistry();\n125:   registry.register(const HauntedSurveillancePlugin());\n126:   registry.register(const RetroHorrorPlugin());\n127:   return registry;\n128: }\n129: \n130: /// Default bundle text loader: the real Flutter asset pipeline.\n131: Future<String> defaultBundleLoader(String assetKey) =>\n132:     rootBundle.loadString(assetKey);\n133: \n134: /// Default asset-bytes loader: the real Flutter asset pipeline.\n135: Future<List<int>> defaultAssetBytesLoader(String assetPath) async {\n136:   final ByteData data = await rootBundle.load(assetPath);\n137:   return data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes);\n138: }\n139: \n140: /// Parses a bundled fixture-manifest JSON document.\n141: ///\n142: /// Accepts two shapes:\n143: ///  * full manifest JSON (as produced by `manifest.toJson()` / consumed by\n144: ///    `parseManifest`), and\n145: ///  * the `gen_fixtures.sh` offline shape\n146: ///    `{clips: [{cameraId, sha256, sizeBytes, durationMs, asset}]}`.\n147: ///    In the latter case [partyId]/[channelId] are supplied by the caller,\n148: ///    clip `id` defaults to the camera id, `storageObjectId` to `asset`,\n149: ///    and `mimeType` to `video/mp4`.\n150: PlaybackManifest parseFixtureManifestJson(\n151:   Map<String, Object?> json, {\n152:   required String partyId,\n153:   required String channelId,\n154: }) {\n155:   final Object? rawClips = json['clips'];\n156:   final bool looksLikeFixtureShape =\n157:       rawClips is List &&\n158:       rawClips.isNotEmpty &&\n159:       rawClips.first is Map &&\n160:       (rawClips.first as Map).containsKey('cameraId') &&\n161:       !(rawClips.first as Map).containsKey('id');\n162:   if (!looksLikeFixtureShape) {\n163:     return parseManifest(json);\n164:   }\n165:   final List<ClipDescriptor> clips = <ClipDescriptor>[\n166:     for (final Object? entry in rawClips as List<Object?>)\n167:       _clipFromFixtureEntry(\n168:         Map<String, Object?>.from(entry! as Map<Object?, Object?>),\n169:       ),\n170:   ];\n171:   final int version = (json['version'] as num?)?.toInt() ?? 1;\n172:   final Object? published = json['publishedAt'];\n173:   final DateTime publishedAt = published is String\n174:       ? DateTime.parse(published)\n175:       : DateTime.utc(2026, 10, 31, 20);\n176:   return PlaybackManifest(\n177:     partyId: partyId,\n178:     channelId: channelId,\n179:     version: version,\n180:     clips: clips,\n181:     publishedAt: publishedAt,\n182:   );\n183: }\n184: \n185: ClipDescriptor _clipFromFixtureEntry(Map<String, Object?> entry) {\n186:   final String cameraId = entry['cameraId']! as String;\n187:   final String asset = entry['asset']! as String;\n188:   // Clip ids follow the wall convention `clip-01` for `CAM-01` (the HUD\n189:   // renders `CAM-01 · clip-01`); fall back to the camera id when the\n190:   // suffix is not a plain number.\n191:   final String suffix = cameraId.startsWith('CAM-')\n192:       ? cameraId.substring(4)\n193:       : cameraId;\n194:   final String id = RegExp(r'^\\d+$').hasMatch(suffix)\n195:       ? 'clip-$suffix'\n196:       : cameraId;\n197:   return ClipDescriptor(\n198:     id: id,\n199:     cameraId: cameraId,\n200:     storageObjectId: asset,\n201:     sha256: entry['sha256']! as String,\n202:     sizeBytes: (entry['sizeBytes']! as num).toInt(),\n203:     duration: Duration(milliseconds: (entry['durationMs']! as num).toInt()),\n204:     mimeType: (entry['mimeType'] as String?) ?? 'video/mp4',\n205:   );\n206: }\n207: \n208: /// Loads the bundled offline fallback manifest (zero network).\n209: Future<PlaybackManifest> loadBundledFixtureManifest({\n210:   required String partyId,\n211:   required String channelId,\n212:   WallBundleLoader loader = defaultBundleLoader,\n213:   String assetKey = kBundledFixtureManifestKey,\n214: }) async {\n215:   final String raw = await loader(assetKey);\n216:   final Object? decoded = jsonDecode(raw);\n217:   if (decoded is! Map<Object?, Object?>) {\n218:     throw const FormatException('fixture manifest must be a JSON object');\n219:   }\n220:   return parseFixtureManifestJson(\n221:     Map<String, Object?>.from(decoded),\n222:     partyId: partyId,\n223:     channelId: channelId,\n224:   );\n225: }\n226: \n227: /// Resolves the bundled asset path for [clip].\n228: ///\n229: /// Prefers an explicit `assets/…` storage reference (the shape emitted by\n230: /// `gen_fixtures.sh`); otherwise falls back to the camera catalog.\n231: String? assetPathForClip(ClipDescriptor clip) {\n232:   if (clip.storageObjectId.startsWith('assets/')) {\n233:     return clip.storageObjectId;\n234:   }\n235:   return kCameraAssetPaths[clip.cameraId];\n236: }\n237: \n238: /// Boots the microkernel and restores the wall manifest.\n239: final class WallBoot {\n240:   /// Creates the boot sequence.\n241:   const WallBoot({\n242:     this.store = const PrefsManifestStore(),\n243:     this.partyId = 'local-party',\n244:     this.tvDeviceId = '',\n245:     this.guestCodeClient,\n246:     this.registryFactory = defaultWallRegistry,\n247:     this.fixture,\n248:     this.fixtureLoader,\n249:     this.assetBytesLoader,\n250:     this.bundleLoader = defaultBundleLoader,\n251:     this.preparePlayback,\n252:     this.liveSession,\n253:     this.settings,\n254:     this.manifestIndexStore,\n255:     this.cacheStore,\n256:     this.remoteUnavailableReason,\n257:   });\n258: \n259:   /// Last-known-good manifest persistence.\n260:   final WallManifestStore store;\n261: \n262:   /// Party the wall belongs to.\n263:   final String partyId;\n264: \n265:   /// TV's own device code, shown on the host guest-code page.\n266:   final String tvDeviceId;\n267: \n268:   /// Host guest-code reader; null keeps the recovery panel offline-only.\n269:   final GuestCodeClient? guestCodeClient;\n270: \n271:   /// Registry factory (channel registration).\n272:   final WallRegistryFactory registryFactory;\n273: \n274:   /// Legacy sync fallback override (tests only; takes precedence when set).\n275:   final WallManifestFixture? fixture;\n276: \n277:   /// Async bundled-fixture loader (defaults to `fixture_manifest.json`).\n278:   final WallFixtureLoader? fixtureLoader;\n279: \n280:   /// Bundled asset-bytes loader (defaults to `rootBundle`).\n281:   final WallAssetBytesLoader? assetBytesLoader;\n282: \n283:   /// Bundle text loader for the fixture manifest (injected in tests).\n284:   final WallBundleLoader bundleLoader;\n285: \n286:   /// Offline-first remote playback coordinator (remote work is not started).\n287:   final PreparePlayback? preparePlayback;\n288: \n289:   /// Live subscription starts from WallScreen after a verified boot.\n290:   final LiveWallSession? liveSession;\n291: \n292:   /// Party-scoped effects persistence.\n293:   final SettingsPort? settings;\n294: \n295:   /// Durable remote index and cache used by recovery and offline boot.\n296:   final ManifestIndexStore? manifestIndexStore;\n297:   final CacheStore? cacheStore;\n298: \n299:   /// Diagnostic detail for a disabled/incomplete live configuration.\n300:   final String? remoteUnavailableReason;\n301: \n302:   Future<bool> _readEffectsDisabled() async {\n303:     final SettingsPort? port = settings;\n304:     if (port == null) return false;\n305:     try {\n306:       return await port.getBool(\n307:             partyId: PartyId(partyId),\n308:             key: CctvWallSettingsKeys.effectsDisabled,\n309:           ) ??\n310:           false;\n311:     } on Object {\n312:       return false;\n313:     }\n314:   }\n315: \n316:   WallBootResult _ready({\n317:     required ChannelRegistry registry,\n318:     required ChannelPlugin plugin,\n319:     required PlaybackManifest manifest,\n320:     required bool usedCachedManifest,\n321:     Map<String, CachedMedia> mediaByClipId = const <String, CachedMedia>{},\n322:     bool effectsDisabled = false,\n323:   }) => WallBootResult.ready(\n324:     registry: registry,\n325:     plugin: plugin,\n326:     manifest: manifest,\n327:     usedCachedManifest: usedCachedManifest,\n328:     mediaByClipId: mediaByClipId,\n329:     liveSession: liveSession,\n330:     settings: settings,\n331:     initialEffectsDisabled: effectsDisabled,\n332:     remoteUnavailableReason: remoteUnavailableReason,\n333:   );\n334: \n335:   Future<PlaybackManifest> _loadFallback() {\n336:     if (fixture != null) {\n337:       return Future<PlaybackManifest>.value(\n338:         fixture!(partyId: partyId, channelId: hauntedSurveillanceChannelId),\n339:       );\n340:     }\n341:     if (fixtureLoader != null) {\n342:       return fixtureLoader!(\n343:         partyId: partyId,\n344:         channelId: hauntedSurveillanceChannelId,\n345:       );\n346:     }\n347:     return loadBundledFixtureManifest(\n348:       partyId: partyId,\n349:       channelId: hauntedSurveillanceChannelId,\n350:       loader: bundleLoader,\n351:     );\n352:   }\n353: \n354:   /// Verifies every clip's sha256 + size against the bundled asset bytes.\n355:   /// Any mismatch, unknown asset, or load failure fails closed (false).\n356:   ///\n357:   /// Fail-closed verified/played-byte identity: tiles play\n358:   /// `assetPathForCamera(cameraId)` ([WallScreen]), so a manifest whose\n359:   /// `assetPathForClip` resolves anywhere else (e.g. a swapped-asset\n360:   /// manifest where CAM-01 names cam04's bytes with cam04's sha) is\n361:   /// rejected even when its digests match the named file. Both [boot] and\n362:   /// [readCached] go through this check.\n363:   Future<bool> _verifyManifestBytes(PlaybackManifest manifest) async {\n364:     final WallAssetBytesLoader load =\n365:         assetBytesLoader ?? defaultAssetBytesLoader;\n366:     for (final ClipDescriptor clip in manifest.clips) {\n367:       final String? assetPath = assetPathForClip(clip);\n368:       if (assetPath == null) {\n369:         return false;\n370:       }\n371:       final String playedPath;\n372:       try {\n373:         playedPath = assetPathForCamera(clip.cameraId);\n374:       } on ArgumentError {\n375:         return false;\n376:       }\n377:       if (assetPath != playedPath) {\n378:         return false;\n379:       }\n380:       late final List<int> bytes;\n381:       try {\n382:         bytes = await load(assetPath);\n383:       } catch (_) {\n384:         return false;\n385:       }\n386:       if (bytes.length != clip.sizeBytes) {\n387:         return false;\n388:       }\n389:       if (sha256Hex(bytes).toLowerCase() != clip.sha256.toLowerCase()) {\n390:         return false;\n391:       }\n392:     }\n393:     return true;\n394:   }\n395: \n396:   /// Runs the boot sequence. Never throws: failures become\n397:   /// [WallBootResult.unavailable] so the app can show a status screen.\n398:   Future<WallBootResult> boot() async {\n399:     final ChannelRegistry registry;\n400:     try {\n401:       registry = registryFactory();\n402:     } catch (error) {\n403:       return WallBootResult.unavailable('CHANNEL REGISTRY FAILED · $error');\n404:     }\n405: \n406:     final ChannelPlugin? plugin = registry.resolve(\n407:       hauntedSurveillanceChannelId,\n408:     );\n409:     if (plugin == null) {\n410:       return const WallBootResult.unavailable(\n411:         'NO WALL · channel \"$hauntedSurveillanceChannelId\" is not registered',\n412:       );\n413:     }\n414: \n415:     // The durable remote index is distinct from PrefsManifestStore and the\n416:     // bundled fixture. In particular, a bundled v1 can never reserve backend\n417:     // v1 or cause a same-version remote conflict.\n418:     final PreparePlayback? preparation = preparePlayback;\n419:     if (preparation != null) {\n420:       final PlaybackSyncSnapshot offline = await preparation.bootOffline(\n421:         partyId: partyId,\n422:         channelId: hauntedSurveillanceChannelId,\n423:       );\n424:       if (offline.state == PlaybackSyncState.usingCache &&\n425:           offline.hasCompleteMedia &&\n426:           offline.manifest != null) {\n427:         return _ready(\n428:           registry: registry,\n429:           plugin: plugin,\n430:           manifest: offline.manifest!,\n431:           usedCachedManifest: true,\n432:           mediaByClipId: offline.mediaByClipId,\n433:           effectsDisabled: await _readEffectsDisabled(),\n434:         );\n435:       }\n436:     }\n437: \n438:     PlaybackManifest? cached;\n439:     try {\n440:       cached = await store.read();\n441:     } catch (_) {\n442:       cached = null;\n443:     }\n444: \n445:     // Prefer the last known good manifest, but only when it belongs to this\n446:     // party + channel and its bytes still verify; a corrupt cache falls back\n447:     // to the bundled fixture instead of blacking out the TV.\n448:     if (cached != null &&\n449:         cached.partyId == partyId &&\n450:         cached.channelId == hauntedSurveillanceChannelId) {\n451:       final Result<PlaybackManifest> cachedCheck = validateCctvManifest(cached);\n452:       if (cachedCheck is Ok<PlaybackManifest> &&\n453:           await _verifyManifestBytes(cachedCheck.value)) {\n454:         return _ready(\n455:           registry: registry,\n456:           plugin: plugin,\n457:           manifest: cachedCheck.value,\n458:           usedCachedManifest: true,\n459:           effectsDisabled: await _readEffectsDisabled(),\n460:         );\n461:       }\n462:       // A cached manifest for another party/channel, or one whose bytes no\n463:       // longer verify, is treated as a miss (falls through to the bundle).\n464:     }\n465: \n466:     late final PlaybackManifest fallback;\n467:     try {\n468:       fallback = await _loadFallback();\n469:     } catch (error) {\n470:       return WallBootResult.unavailable(\n471:         'WALL UNAVAILABLE · bundled fixture failed: $error',\n472:       );\n473:     }\n474:     final Result<PlaybackManifest> fallbackCheck = validateCctvManifest(\n475:       fallback,\n476:     );\n477:     if (fallbackCheck is Err<PlaybackManifest>) {\n478:       return WallBootResult.unavailable(\n479:         'WALL UNAVAILABLE · ${fallbackCheck.message}',\n480:       );\n481:     }\n482:     final PlaybackManifest manifest =\n483:         (fallbackCheck as Ok<PlaybackManifest>).value;\n484:     if (!await _verifyManifestBytes(manifest)) {\n485:       return const WallBootResult.unavailable(\n486:         'WALL UNAVAILABLE · bundled clip hash mismatch',\n487:       );\n488:     }\n489: \n490:     // First boot (or repaired cache): persist the fixture so the next start\n491:     // restores a wall even if the fixture pipeline changes.\n492:     try {\n493:       await store.write(manifest);\n494:     } catch (_) {\n495:       // Non-fatal: the wall still plays, it just will not be cached.\n496:     }\n497: \n498:     return _ready(\n499:       registry: registry,\n500:       plugin: plugin,\n501:       manifest: manifest,\n502:       usedCachedManifest: false,\n503:       effectsDisabled: await _readEffectsDisabled(),\n504:     );\n505:   }\n506: \n507:   /// Reads the durable committed version for the recovery action without\n508:   /// disturbing an in-flight live preparation.\n509:   Future<VerifiedWallPlayback?> readCommittedPlayback() async {\n510:     final ManifestIndexStore? indexStore = manifestIndexStore;\n511:     final CacheStore? cache = cacheStore;\n512:     if (indexStore == null || cache == null) return null;\n513:     try {\n514:       final CommittedManifestIndex? index = await indexStore.readCommitted(\n515:         partyId: partyId,\n516:         channelId: hauntedSurveillanceChannelId,\n517:       );\n518:       if (index == null) return null;\n519:       final Map<String, CachedMedia> media = <String, CachedMedia>{};\n520:       for (final ClipDescriptor clip in index.manifest.clips) {\n521:         final CachedMedia? cached = await cache.findVerified(clip);\n522:         if (cached == null ||\n523:             cached.localRef != index.localRefFor(clip) ||\n524:             cached.clipId != clip.id ||\n525:             cached.sha256.toLowerCase() != clip.sha256.toLowerCase()) {\n526:           return null;\n527:         }\n528:         media[clip.id] = cached;\n529:       }\n530:       return VerifiedWallPlayback(index.manifest, media);\n531:     } on Object {\n532:       return null;\n533:     }\n534:   }\n535: \n536:   /// Reads + validates the cached manifest (recovery \"retry cached wall\").\n537:   /// Returns null when nothing valid is stored.\n538:   Future<PlaybackManifest?> readCached() async {\n539:     try {\n540:       final PlaybackManifest? cached = await store.read();\n541:       if (cached == null) {\n542:         return null;\n543:       }\n544:       if (cached.partyId != partyId ||\n545:           cached.channelId != hauntedSurveillanceChannelId) {\n546:         return null;\n547:       }\n548:       final Result<PlaybackManifest> checked = validateCctvManifest(cached);\n549:       if (checked is! Ok<PlaybackManifest>) {\n550:         return null;\n551:       }\n552:       if (!await _verifyManifestBytes(checked.value)) {\n553:         return null;\n554:       }\n555:       return checked.value;\n556:     } catch (_) {\n557:       return null;\n558:     }\n559:   }\n560: }\n561: \n562: /// A complete, re-verified remote version available for manual recovery.\n563: final class VerifiedWallPlayback {\n564:   VerifiedWallPlayback(this.manifest, Map<String, CachedMedia> mediaByClipId)\n565:     : mediaByClipId = Map<String, CachedMedia>.unmodifiable(mediaByClipId);\n566: \n567:   final PlaybackManifest manifest;\n568:   final Map<String, CachedMedia> mediaByClipId;\n569: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_boot.dart, lines 1-569\n1: /// Boot sequence: kernel registry -> channels -> manifest -> wall.\n2: ///\n3: /// Offline-first: zero network on boot. The fallback manifest comes from the\n4: /// bundled `assets/fixture_manifest.json` (emitted by\n5: /// `tool/gen_fixtures.sh` from the REAL asset bytes via `parseManifest`),\n6: /// loaded with `rootBundle`. `package:testing_toolkit`'s `manifestFixture`\n7: /// (fabricated digests) is test-only and must never be imported here.\n8: ///\n9: /// Phase-2 note (full CacheStore adapter, not yet wired): once the\n10: /// on-disk verified media cache lands, boot will resolve each clip through\n11: /// `CacheStore.findVerified` (re-hash on hit, miss on digest mismatch) and\n12: /// `commit` verified downloads before handing the manifest to the wall.\n13: /// Until then, boot verifies the bundled offline bytes directly with\n14: /// `sha256Hex` and fails closed to unavailable on any sha256/size mismatch.\n15: library;\n16: \n17: import 'dart:convert';\n18: \n19: import 'package:channel_cctv/channel_cctv.dart';\n20: import 'package:channel_retro_tv/channel_retro_tv.dart';\n21: import 'package:core_cache/core_cache.dart';\n22: import 'package:core_foundation/core_foundation.dart';\n23: import 'package:core_playlist/core_playlist.dart';\n24: import 'package:flutter/services.dart';\n25: import 'package:kernel_app/kernel_app.dart';\n26: import 'package:tv_app/src/media/feed_assets.dart';\n27: import 'package:tv_app/src/wall/guest_codes.dart';\n28: import 'package:tv_app/src/wall/live_wall_session.dart';\n29: import 'package:tv_app/src/wall/manifest_store.dart';\n30: \n31: /// Bundled fixture manifest asset (emitted from real asset bytes).\n32: const String kBundledFixtureManifestKey = 'assets/fixture_manifest.json';\n33: \n34: /// Outcome of booting the wall: either a resolved channel + manifest, or the\n35: /// reason no wall is available (drives the app-level status screen).\n36: final class WallBootResult {\n37:   /// Everything needed to render the wall is present.\n38:   const WallBootResult.ready({\n39:     required ChannelRegistry this.registry,\n40:     required ChannelPlugin this.plugin,\n41:     required PlaybackManifest this.manifest,\n42:     required this.usedCachedManifest,\n43:     this.mediaByClipId = const <String, CachedMedia>{},\n44:     this.liveSession,\n45:     this.settings,\n46:     this.initialEffectsDisabled = false,\n47:     this.remoteUnavailableReason,\n48:   }) : unavailableReason = null;\n49: \n50:   /// No wall can be shown; [unavailableReason] is user-facing.\n51:   const WallBootResult.unavailable(this.unavailableReason)\n52:     : registry = null,\n53:       plugin = null,\n54:       manifest = null,\n55:       usedCachedManifest = false,\n56:       mediaByClipId = const <String, CachedMedia>{},\n57:       liveSession = null,\n58:       settings = null,\n59:       initialEffectsDisabled = false,\n60:       remoteUnavailableReason = null;\n61: \n62:   /// Channel registry built during boot.\n63:   final ChannelRegistry? registry;\n64: \n65:   /// Resolved active channel plugin.\n66:   final ChannelPlugin? plugin;\n67: \n68:   /// Validated manifest driving the wall.\n69:   final PlaybackManifest? manifest;\n70: \n71:   /// True when the wall came from the last cached manifest (not the bundle).\n72:   final bool usedCachedManifest;\n73: \n74:   /// Verified durable media keyed by clip id; empty means bundled fallback.\n75:   final Map<String, CachedMedia> mediaByClipId;\n76: \n77:   /// Remote session started only after this wall has rendered.\n78:   final LiveWallSession? liveSession;\n79: \n80:   /// Party-scoped TV settings.\n81:   final SettingsPort? settings;\n82: \n83:   /// Restored effect setting for this party.\n84:   final bool initialEffectsDisabled;\n85: \n86:   /// Why configured live playback was disabled, if applicable.\n87:   final String? remoteUnavailableReason;\n88: \n89:   /// Why the wall is unavailable, when it is.\n90:   final String? unavailableReason;\n91: \n92:   /// Whether a wall can be rendered.\n93:   bool get isReady => plugin != null && manifest != null;\n94: }\n95: \n96: /// Builds the channel registry; injectable so tests can simulate a registry\n97: /// without the haunted-surveillance channel.\n98: typedef WallRegistryFactory = ChannelRegistry Function();\n99: \n100: /// Builds the offline fallback manifest (legacy sync override, tests only).\n101: typedef WallManifestFixture =\n102:     PlaybackManifest Function({\n103:       required String partyId,\n104:       required String channelId,\n105:     });\n106: \n107: /// Loads the bundled fixture manifest JSON text (injected in tests so a\n108: /// missing bundle file does not need the real asset pipeline).\n109: typedef WallBundleLoader = Future<String> Function(String assetKey);\n110: \n111: /// Loads raw bytes for a bundled asset path (injected in tests).\n112: typedef WallAssetBytesLoader = Future<List<int>> Function(String assetPath);\n113: \n114: /// Async fallback-manifest loader (bundled `fixture_manifest.json`).\n115: typedef WallFixtureLoader =\n116:     Future<PlaybackManifest> Function({\n117:       required String partyId,\n118:       required String channelId,\n119:     });\n120: \n121: /// Default registry: haunted surveillance (active) + retro horror (stub that\n122: /// is registered so the kernel can list it, but never resolved/activated).\n123: ChannelRegistry defaultWallRegistry() {\n124:   final ChannelRegistry registry = ChannelRegistry();\n125:   registry.register(const HauntedSurveillancePlugin());\n126:   registry.register(const RetroHorrorPlugin());\n127:   return registry;\n128: }\n129: \n130: /// Default bundle text loader: the real Flutter asset pipeline.\n131: Future<String> defaultBundleLoader(String assetKey) =>\n132:     rootBundle.loadString(assetKey);\n133: \n134: /// Default asset-bytes loader: the real Flutter asset pipeline.\n135: Future<List<int>> defaultAssetBytesLoader(String assetPath) async {\n136:   final ByteData data = await rootBundle.load(assetPath);\n137:   return data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes);\n138: }\n139: \n140: /// Parses a bundled fixture-manifest JSON document.\n141: ///\n142: /// Accepts two shapes:\n143: ///  * full manifest JSON (as produced by `manifest.toJson()` / consumed by\n144: ///    `parseManifest`), and\n145: ///  * the `gen_fixtures.sh` offline shape\n146: ///    `{clips: [{cameraId, sha256, sizeBytes, durationMs, asset}]}`.\n147: ///    In the latter case [partyId]/[channelId] are supplied by the caller,\n148: ///    clip `id` defaults to the camera id, `storageObjectId` to `asset`,\n149: ///    and `mimeType` to `video/mp4`.\n150: PlaybackManifest parseFixtureManifestJson(\n151:   Map<String, Object?> json, {\n152:   required String partyId,\n153:   required String channelId,\n154: }) {\n155:   final Object? rawClips = json['clips'];\n156:   final bool looksLikeFixtureShape =\n157:       rawClips is List &&\n158:       rawClips.isNotEmpty &&\n159:       rawClips.first is Map &&\n160:       (rawClips.first as Map).containsKey('cameraId') &&\n161:       !(rawClips.first as Map).containsKey('id');\n162:   if (!looksLikeFixtureShape) {\n163:     return parseManifest(json);\n164:   }\n165:   final List<ClipDescriptor> clips = <ClipDescriptor>[\n166:     for (final Object? entry in rawClips as List<Object?>)\n167:       _clipFromFixtureEntry(\n168:         Map<String, Object?>.from(entry! as Map<Object?, Object?>),\n169:       ),\n170:   ];\n171:   final int version = (json['version'] as num?)?.toInt() ?? 1;\n172:   final Object? published = json['publishedAt'];\n173:   final DateTime publishedAt = published is String\n174:       ? DateTime.parse(published)\n175:       : DateTime.utc(2026, 10, 31, 20);\n176:   return PlaybackManifest(\n177:     partyId: partyId,\n178:     channelId: channelId,\n179:     version: version,\n180:     clips: clips,\n181:     publishedAt: publishedAt,\n182:   );\n183: }\n184: \n185: ClipDescriptor _clipFromFixtureEntry(Map<String, Object?> entry) {\n186:   final String cameraId = entry['cameraId']! as String;\n187:   final String asset = entry['asset']! as String;\n188:   // Clip ids follow the wall convention `clip-01` for `CAM-01` (the HUD\n189:   // renders `CAM-01 · clip-01`); fall back to the camera id when the\n190:   // suffix is not a plain number.\n191:   final String suffix = cameraId.startsWith('CAM-')\n192:       ? cameraId.substring(4)\n193:       : cameraId;\n194:   final String id = RegExp(r'^\\d+$').hasMatch(suffix)\n195:       ? 'clip-$suffix'\n196:       : cameraId;\n197:   return ClipDescriptor(\n198:     id: id,\n199:     cameraId: cameraId,\n200:     storageObjectId: asset,\n201:     sha256: entry['sha256']! as String,\n202:     sizeBytes: (entry['sizeBytes']! as num).toInt(),\n203:     duration: Duration(milliseconds: (entry['durationMs']! as num).toInt()),\n204:     mimeType: (entry['mimeType'] as String?) ?? 'video/mp4',\n205:   );\n206: }\n207: \n208: /// Loads the bundled offline fallback manifest (zero network).\n209: Future<PlaybackManifest> loadBundledFixtureManifest({\n210:   required String partyId,\n211:   required String channelId,\n212:   WallBundleLoader loader = defaultBundleLoader,\n213:   String assetKey = kBundledFixtureManifestKey,\n214: }) async {\n215:   final String raw = await loader(assetKey);\n216:   final Object? decoded = jsonDecode(raw);\n217:   if (decoded is! Map<Object?, Object?>) {\n218:     throw const FormatException('fixture manifest must be a JSON object');\n219:   }\n220:   return parseFixtureManifestJson(\n221:     Map<String, Object?>.from(decoded),\n222:     partyId: partyId,\n223:     channelId: channelId,\n224:   );\n225: }\n226: \n227: /// Resolves the bundled asset path for [clip].\n228: ///\n229: /// Prefers an explicit `assets/…` storage reference (the shape emitted by\n230: /// `gen_fixtures.sh`); otherwise falls back to the camera catalog.\n231: String? assetPathForClip(ClipDescriptor clip) {\n232:   if (clip.storageObjectId.startsWith('assets/')) {\n233:     return clip.storageObjectId;\n234:   }\n235:   return kCameraAssetPaths[clip.cameraId];\n236: }\n237: \n238: /// Boots the microkernel and restores the wall manifest.\n239: final class WallBoot {\n240:   /// Creates the boot sequence.\n241:   const WallBoot({\n242:     this.store = const PrefsManifestStore(),\n243:     this.partyId = 'local-party',\n244:     this.tvDeviceId = '',\n245:     this.guestCodeClient,\n246:     this.registryFactory = defaultWallRegistry,\n247:     this.fixture,\n248:     this.fixtureLoader,\n249:     this.assetBytesLoader,\n250:     this.bundleLoader = defaultBundleLoader,\n251:     this.preparePlayback,\n252:     this.liveSession,\n253:     this.settings,\n254:     this.manifestIndexStore,\n255:     this.cacheStore,\n256:     this.remoteUnavailableReason,\n257:   });\n258: \n259:   /// Last-known-good manifest persistence.\n260:   final WallManifestStore store;\n261: \n262:   /// Party the wall belongs to.\n263:   final String partyId;\n264: \n265:   /// TV's own device code, shown on the host guest-code page.\n266:   final String tvDeviceId;\n267: \n268:   /// Host guest-code reader; null keeps the recovery panel offline-only.\n269:   final GuestCodeClient? guestCodeClient;\n270: \n271:   /// Registry factory (channel registration).\n272:   final WallRegistryFactory registryFactory;\n273: \n274:   /// Legacy sync fallback override (tests only; takes precedence when set).\n275:   final WallManifestFixture? fixture;\n276: \n277:   /// Async bundled-fixture loader (defaults to `fixture_manifest.json`).\n278:   final WallFixtureLoader? fixtureLoader;\n279: \n280:   /// Bundled asset-bytes loader (defaults to `rootBundle`).\n281:   final WallAssetBytesLoader? assetBytesLoader;\n282: \n283:   /// Bundle text loader for the fixture manifest (injected in tests).\n284:   final WallBundleLoader bundleLoader;\n285: \n286:   /// Offline-first remote playback coordinator (remote work is not started).\n287:   final PreparePlayback? preparePlayback;\n288: \n289:   /// Live subscription starts from WallScreen after a verified boot.\n290:   final LiveWallSession? liveSession;\n291: \n292:   /// Party-scoped effects persistence.\n293:   final SettingsPort? settings;\n294: \n295:   /// Durable remote index and cache used by recovery and offline boot.\n296:   final ManifestIndexStore? manifestIndexStore;\n297:   final CacheStore? cacheStore;\n298: \n299:   /// Diagnostic detail for a disabled/incomplete live configuration.\n300:   final String? remoteUnavailableReason;\n301: \n302:   Future<bool> _readEffectsDisabled() async {\n303:     final SettingsPort? port = settings;\n304:     if (port == null) return false;\n305:     try {\n306:       return await port.getBool(\n307:             partyId: PartyId(partyId),\n308:             key: CctvWallSettingsKeys.effectsDisabled,\n309:           ) ??\n310:           false;\n311:     } on Object {\n312:       return false;\n313:     }\n314:   }\n315: \n316:   WallBootResult _ready({\n317:     required ChannelRegistry registry,\n318:     required ChannelPlugin plugin,\n319:     required PlaybackManifest manifest,\n320:     required bool usedCachedManifest,\n321:     Map<String, CachedMedia> mediaByClipId = const <String, CachedMedia>{},\n322:     bool effectsDisabled = false,\n323:   }) => WallBootResult.ready(\n324:     registry: registry,\n325:     plugin: plugin,\n326:     manifest: manifest,\n327:     usedCachedManifest: usedCachedManifest,\n328:     mediaByClipId: mediaByClipId,\n329:     liveSession: liveSession,\n330:     settings: settings,\n331:     initialEffectsDisabled: effectsDisabled,\n332:     remoteUnavailableReason: remoteUnavailableReason,\n333:   );\n334: \n335:   Future<PlaybackManifest> _loadFallback() {\n336:     if (fixture != null) {\n337:       return Future<PlaybackManifest>.value(\n338:         fixture!(partyId: partyId, channelId: hauntedSurveillanceChannelId),\n339:       );\n340:     }\n341:     if (fixtureLoader != null) {\n342:       return fixtureLoader!(\n343:         partyId: partyId,\n344:         channelId: hauntedSurveillanceChannelId,\n345:       );\n346:     }\n347:     return loadBundledFixtureManifest(\n348:       partyId: partyId,\n349:       channelId: hauntedSurveillanceChannelId,\n350:       loader: bundleLoader,\n351:     );\n352:   }\n353: \n354:   /// Verifies every clip's sha256 + size against the bundled asset bytes.\n355:   /// Any mismatch, unknown asset, or load failure fails closed (false).\n356:   ///\n357:   /// Fail-closed verified/played-byte identity: tiles play\n358:   /// `assetPathForCamera(cameraId)` ([WallScreen]), so a manifest whose\n359:   /// `assetPathForClip` resolves anywhere else (e.g. a swapped-asset\n360:   /// manifest where CAM-01 names cam04's bytes with cam04's sha) is\n361:   /// rejected even when its digests match the named file. Both [boot] and\n362:   /// [readCached] go through this check.\n363:   Future<bool> _verifyManifestBytes(PlaybackManifest manifest) async {\n364:     final WallAssetBytesLoader load =\n365:         assetBytesLoader ?? defaultAssetBytesLoader;\n366:     for (final ClipDescriptor clip in manifest.clips) {\n367:       final String? assetPath = assetPathForClip(clip);\n368:       if (assetPath == null) {\n369:         return false;\n370:       }\n371:       final String playedPath;\n372:       try {\n373:         playedPath = assetPathForCamera(clip.cameraId);\n374:       } on ArgumentError {\n375:         return false;\n376:       }\n377:       if (assetPath != playedPath) {\n378:         return false;\n379:       }\n380:       late final List<int> bytes;\n381:       try {\n382:         bytes = await load(assetPath);\n383:       } catch (_) {\n384:         return false;\n385:       }\n386:       if (bytes.length != clip.sizeBytes) {\n387:         return false;\n388:       }\n389:       if (sha256Hex(bytes).toLowerCase() != clip.sha256.toLowerCase()) {\n390:         return false;\n391:       }\n392:     }\n393:     return true;\n394:   }\n395: \n396:   /// Runs the boot sequence. Never throws: failures become\n397:   /// [WallBootResult.unavailable] so the app can show a status screen.\n398:   Future<WallBootResult> boot() async {\n399:     final ChannelRegistry registry;\n400:     try {\n401:       registry = registryFactory();\n402:     } catch (error) {\n403:       return WallBootResult.unavailable('CHANNEL REGISTRY FAILED · $error');\n404:     }\n405: \n406:     final ChannelPlugin? plugin = registry.resolve(\n407:       hauntedSurveillanceChannelId,\n408:     );\n409:     if (plugin == null) {\n410:       return const WallBootResult.unavailable(\n411:         'NO WALL · channel \"$hauntedSurveillanceChannelId\" is not registered',\n412:       );\n413:     }\n414: \n415:     // The durable remote index is distinct from PrefsManifestStore and the\n416:     // bundled fixture. In particular, a bundled v1 can never reserve backend\n417:     // v1 or cause a same-version remote conflict.\n418:     final PreparePlayback? preparation = preparePlayback;\n419:     if (preparation != null) {\n420:       final PlaybackSyncSnapshot offline = await preparation.bootOffline(\n421:         partyId: partyId,\n422:         channelId: hauntedSurveillanceChannelId,\n423:       );\n424:       if (offline.state == PlaybackSyncState.usingCache &&\n425:           offline.hasCompleteMedia &&\n426:           offline.manifest != null) {\n427:         return _ready(\n428:           registry: registry,\n429:           plugin: plugin,\n430:           manifest: offline.manifest!,\n431:           usedCachedManifest: true,\n432:           mediaByClipId: offline.mediaByClipId,\n433:           effectsDisabled: await _readEffectsDisabled(),\n434:         );\n435:       }\n436:     }\n437: \n438:     PlaybackManifest? cached;\n439:     try {\n440:       cached = await store.read();\n441:     } catch (_) {\n442:       cached = null;\n443:     }\n444: \n445:     // Prefer the last known good manifest, but only when it belongs to this\n446:     // party + channel and its bytes still verify; a corrupt cache falls back\n447:     // to the bundled fixture instead of blacking out the TV.\n448:     if (cached != null &&\n449:         cached.partyId == partyId &&\n450:         cached.channelId == hauntedSurveillanceChannelId) {\n451:       final Result<PlaybackManifest> cachedCheck = validateCctvManifest(cached);\n452:       if (cachedCheck is Ok<PlaybackManifest> &&\n453:           await _verifyManifestBytes(cachedCheck.value)) {\n454:         return _ready(\n455:           registry: registry,\n456:           plugin: plugin,\n457:           manifest: cachedCheck.value,\n458:           usedCachedManifest: true,\n459:           effectsDisabled: await _readEffectsDisabled(),\n460:         );\n461:       }\n462:       // A cached manifest for another party/channel, or one whose bytes no\n463:       // longer verify, is treated as a miss (falls through to the bundle).\n464:     }\n465: \n466:     late final PlaybackManifest fallback;\n467:     try {\n468:       fallback = await _loadFallback();\n469:     } catch (error) {\n470:       return WallBootResult.unavailable(\n471:         'WALL UNAVAILABLE · bundled fixture failed: $error',\n472:       );\n473:     }\n474:     final Result<PlaybackManifest> fallbackCheck = validateCctvManifest(\n475:       fallback,\n476:     );\n477:     if (fallbackCheck is Err<PlaybackManifest>) {\n478:       return WallBootResult.unavailable(\n479:         'WALL UNAVAILABLE · ${fallbackCheck.message}',\n480:       );\n481:     }\n482:     final PlaybackManifest manifest =\n483:         (fallbackCheck as Ok<PlaybackManifest>).value;\n484:     if (!await _verifyManifestBytes(manifest)) {\n485:       return const WallBootResult.unavailable(\n486:         'WALL UNAVAILABLE · bundled clip hash mismatch',\n487:       );\n488:     }\n489: \n490:     // First boot (or repaired cache): persist the fixture so the next start\n491:     // restores a wall even if the fixture pipeline changes.\n492:     try {\n493:       await store.write(manifest);\n494:     } catch (_) {\n495:       // Non-fatal: the wall still plays, it just will not be cached.\n496:     }\n497: \n498:     return _ready(\n499:       registry: registry,\n500:       plugin: plugin,\n501:       manifest: manifest,\n502:       usedCachedManifest: false,\n503:       effectsDisabled: await _readEffectsDisabled(),\n504:     );\n505:   }\n506: \n507:   /// Reads the durable committed version for the recovery action without\n508:   /// disturbing an in-flight live preparation.\n509:   Future<VerifiedWallPlayback?> readCommittedPlayback() async {\n510:     final ManifestIndexStore? indexStore = manifestIndexStore;\n511:     final CacheStore? cache = cacheStore;\n512:     if (indexStore == null || cache == null) return null;\n513:     try {\n514:       final CommittedManifestIndex? index = await indexStore.readCommitted(\n515:         partyId: partyId,\n516:         channelId: hauntedSurveillanceChannelId,\n517:       );\n518:       if (index == null) return null;\n519:       final Map<String, CachedMedia> media = <String, CachedMedia>{};\n520:       for (final ClipDescriptor clip in index.manifest.clips) {\n521:         final CachedMedia? cached = await cache.findVerified(clip);\n522:         if (cached == null ||\n523:             cached.localRef != index.localRefFor(clip) ||\n524:             cached.clipId != clip.id ||\n525:             cached.sha256.toLowerCase() != clip.sha256.toLowerCase()) {\n526:           return null;\n527:         }\n528:         media[clip.id] = cached;\n529:       }\n530:       return VerifiedWallPlayback(index.manifest, media);\n531:     } on Object {\n532:       return null;\n533:     }\n534:   }\n535: \n536:   /// Reads + validates the cached manifest (recovery \"retry cached wall\").\n537:   /// Returns null when nothing valid is stored.\n538:   Future<PlaybackManifest?> readCached() async {\n539:     try {\n540:       final PlaybackManifest? cached = await store.read();\n541:       if (cached == null) {\n542:         return null;\n543:       }\n544:       if (cached.partyId != partyId ||\n545:           cached.channelId != hauntedSurveillanceChannelId) {\n546:         return null;\n547:       }\n548:       final Result<PlaybackManifest> checked = validateCctvManifest(cached);\n549:       if (checked is! Ok<PlaybackManifest>) {\n550:         return null;\n551:       }\n552:       if (!await _verifyManifestBytes(checked.value)) {\n553:         return null;\n554:       }\n555:       return checked.value;\n556:     } catch (_) {\n557:       return null;\n558:     }\n559:   }\n560: }\n561: \n562: /// A complete, re-verified remote version available for manual recovery.\n563: final class VerifiedWallPlayback {\n564:   VerifiedWallPlayback(this.manifest, Map<String, CachedMedia> mediaByClipId)\n565:     : mediaByClipId = Map<String, CachedMedia>.unmodifiable(mediaByClipId);\n566: \n567:   final PlaybackManifest manifest;\n568:   final Map<String, CachedMedia> mediaByClipId;\n569: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5916970138886ba1da0295696"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_boot.dart\"}"},"time":{"start":1793461686717,"end":1793461687460}}}}
{"type":"tool_use","timestamp":1793461687461,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a5901b0015ASpa2wEbGWcgL","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a58a4c001esd1e160zU527e","type":"tool","id":"call_01a192a58fc8738e8f96a1966259bab8","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_screen.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_screen.dart, lines 1-714\n1: /// Hosts the haunted-surveillance channel wall for one party.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:io';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_cache/core_cache.dart';\n9: import 'package:core_effects/core_effects.dart';\n10: import 'package:core_foundation/core_foundation.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: import 'package:core_ui/core_ui.dart';\n13: import 'package:flutter/material.dart';\n14: import 'package:flutter/services.dart';\n15: import 'package:kernel_app/kernel_app.dart';\n16: import 'package:tv_app/src/media/feed_assets.dart';\n17: import 'package:tv_app/src/playback/camera_tile.dart';\n18: import 'package:tv_app/src/playback/tile_video_controller.dart';\n19: import 'package:tv_app/src/wall/guest_code_panel.dart';\n20: import 'package:tv_app/src/wall/guest_codes.dart';\n21: import 'package:tv_app/src/wall/live_wall_session.dart';\n22: import 'package:tv_app/src/wall/playback_handle.dart';\n23: import 'package:tv_app/src/wall/recovery_overlay.dart';\n24: import 'package:tv_app/src/wall/wall_boot.dart';\n25: import 'package:tv_app/src/wall/wall_focus.dart';\n26: \n27: /// Key of the status banner shown above the wall after recovery actions.\n28: const Key kWallStatusBannerKey = ValueKey<String>('wall-status-banner');\n29: \n30: /// Key of the hidden recovery panel.\n31: const Key kRecoveryOverlayKey = ValueKey<String>('recovery-overlay');\n32: \n33: /// Resolved channel + manifest rendered full-screen on the TV.\n34: ///\n35: /// Responsibilities kept in the app (design s4/s13):\n36: ///  * owns one [CameraTile] (hence one video decoder) per wall slot,\n37: ///  * D-pad focus traversal between the four tiles,\n38: ///  * hidden recovery panel (OK long-press / MENU) with \"retry cached wall\"\n39: ///    and \"disable effects\",\n40: ///  * overscan-safe padding and an app-level status line.\n41: ///\n42: /// Channel chrome (HUD, scanlines/vignette, glitch, SIGNAL LOST frame) comes\n43: /// from `channel_cctv` + `core_ui` + `core_effects`; the app supplies the\n44: /// video surfaces through [HauntedSurveillancePlugin.tileBuilder].\n45: class WallScreen extends StatefulWidget {\n46:   /// Creates the wall host.\n47:   const WallScreen({\n48:     super.key,\n49:     required this.plugin,\n50:     required this.manifest,\n51:     required this.tileControllerFactory,\n52:     required this.clock,\n53:     this.mediaByClipId = const <String, CachedMedia>{},\n54:     this.liveSession,\n55:     this.settings,\n56:     this.profile,\n57:     this.partyId = 'local-party',\n58:     this.tvDeviceId = '',\n59:     this.channelId = hauntedSurveillanceChannelId,\n60:     this.guestCodeClient,\n61:     this.glitchSeed = 0x4A11,\n62:     this.onRetryCached,\n63:     this.onRetryCachedPlayback,\n64:     this.fileExists,\n65:     this.recoveryEnabled = true,\n66:     this.initialEffectsDisabled = false,\n67:     this.overscanPadding = const EdgeInsets.symmetric(\n68:       horizontal: 28,\n69:       vertical: 18,\n70:     ),\n71:     this.longPressDuration = const Duration(milliseconds: 600),\n72:     this.sourceSettleTimeout = const Duration(seconds: 15),\n73:   });\n74: \n75:   /// Channel plugin resolved from the kernel registry.\n76:   final ChannelPlugin plugin;\n77: \n78:   /// Wall manifest driving camera slots.\n79:   final PlaybackManifest manifest;\n80: \n81:   /// Builds one decoder per tile.\n82:   final TileVideoControllerFactory tileControllerFactory;\n83: \n84:   /// Clock used by the tile HUDs (injectable for deterministic tests).\n85:   final Clock clock;\n86: \n87:   /// Verified committed files keyed by manifest clip id.\n88:   final Map<String, CachedMedia> mediaByClipId;\n89: \n90:   /// Live subscription started after offline rendering.\n91:   final LiveWallSession? liveSession;\n92: \n93:   /// Party-scoped persistent settings.\n94:   final SettingsPort? settings;\n95: \n96:   /// Effect profile for tile overlays; defaults to [cctvProfile].\n97:   final EffectProfile? profile;\n98: \n99:   /// Party this wall belongs to.\n100:   final String partyId;\n101: \n102:   /// TV's own device code, shown on the host guest-code page.\n103:   final String tvDeviceId;\n104: \n105:   /// Active channel for the guest-code join payload.\n106:   final String channelId;\n107: \n108:   /// Host guest-code reader; null keeps the recovery panel on its actions\n109:   /// only (offline builds never list codes).\n110:   final GuestCodeClient? guestCodeClient;\n111: \n112:   /// Seed for the wall's deterministic glitch bursts.\n113:   final int glitchSeed;\n114: \n115:   /// Reloads the last cached manifest; null result means \"nothing cached\".\n116:   final Future<PlaybackManifest?> Function()? onRetryCached;\n117: \n118:   /// Re-verifies the durable remote index without interrupting live work.\n119:   final Future<VerifiedWallPlayback?> Function()? onRetryCachedPlayback;\n120: \n121:   /// Existence check for verified local files.\n122:   ///\n123:   /// Defaults to real `File(path).exists()`. Injectable because `testWidgets`\n124:   /// bodies run in a FakeAsync zone where real dart:io never completes;\n125:   /// production passes nothing and keeps the real filesystem check.\n126:   final Future<bool> Function(String path)? fileExists;\n127: \n128:   /// Whether OK long-press / MENU reveals the recovery panel.\n129:   final bool recoveryEnabled;\n130: \n131:   /// Starts with effect overlays dropped.\n132:   final bool initialEffectsDisabled;\n133: \n134:   /// Extra padding keeping HUD text inside the TV's overscan-safe area.\n135:   final EdgeInsets overscanPadding;\n136: \n137:   /// How long OK must be held to reveal the recovery panel.\n138:   final Duration longPressDuration;\n139: \n140:   /// Bound for one tile source replacement to settle.\n141:   ///\n142:   /// Defaults to 15s. Injectable so tests do not stall real seconds on\n143:   /// decoder failure and prod can tune it alongside other timeouts.\n144:   final Duration sourceSettleTimeout;\n145: \n146:   @override\n147:   State<WallScreen> createState() => _WallScreenState();\n148: }\n149: \n150: class _WallScreenState extends State<WallScreen> {\n151:   late final WallFocusController _focus;\n152:   late final WallPlaybackHandle _handle;\n153: \n154:   late PlaybackManifest _manifest;\n155:   late Map<String, CachedMedia> _mediaByClipId;\n156:   late Map<String, TileMediaSource> _tileSources;\n157:   final Map<String, Completer<bool>> _sourceSettles =\n158:       <String, Completer<bool>>{};\n159:   final Set<String> _initialSettledCameras = <String>{};\n160:   bool _liveStarted = false;\n161:   late bool _effectsDisabled;\n162:   bool _recoveryVisible = false;\n163:   bool _guestCodesVisible = false;\n164:   bool _okHeld = false;\n165:   bool _activatedHandle = false;\n166:   String? _status;\n167:   String? _recoveryStatus;\n168:   Timer? _okHoldTimer;\n169:   final FocusNode _recoveryFocus = FocusNode(debugLabel: 'recovery-primary');\n170: \n171:   @override\n172:   void initState() {\n173:     super.initState();\n174:     _focus = WallFocusController();\n175:     _manifest = widget.manifest;\n176:     _mediaByClipId = Map<String, CachedMedia>.of(widget.mediaByClipId);\n177:     _tileSources = _sourcesFor(_manifest, _mediaByClipId);\n178:     _effectsDisabled = widget.initialEffectsDisabled;\n179:     _handle = WallPlaybackHandle(\n180:       prepareAction: _prepareCurrentVersion,\n181:       activateAction: _activateCurrentVersion,\n182:     );\n183:     WidgetsBinding.instance.addPostFrameCallback((_) {\n184:       if (!mounted || _activatedHandle) {\n185:         return;\n186:       }\n187:       _activatedHandle = true;\n188:       unawaited(_bootHandle());\n189:     });\n190:   }\n191: \n192:   @override\n193:   void dispose() {\n194:     _okHoldTimer?.cancel();\n195:     _recoveryFocus.dispose();\n196:     _focus.dispose();\n197:     for (final Completer<bool> settle in _sourceSettles.values) {\n198:       if (!settle.isCompleted) settle.complete(false);\n199:     }\n200:     final LiveWallSession? session = widget.liveSession;\n201:     if (session != null) unawaited(session.dispose());\n202:     super.dispose();\n203:   }\n204: \n205:   /// Wall slot builder: app-owned player lifecycle per tile.\n206:   Widget _buildTile(\n207:     BuildContext context,\n208:     int index,\n209:     String label,\n210:     String cameraId,\n211:   ) {\n212:     return CameraTile(\n213:       key: ValueKey<String>('camera-tile-$cameraId'),\n214:       index: index,\n215:       cameraId: cameraId,\n216:       source: _tileSources[cameraId]!,\n217:       focusNode: _focus.nodeAt(index),\n218:       controllerFactory: widget.tileControllerFactory,\n219:       onSourceSettled: (bool success) {\n220:         final Completer<bool>? settle = _sourceSettles[cameraId];\n221:         if (settle != null && !settle.isCompleted) settle.complete(success);\n222:       },\n223:       onInitialSettled: () => _onInitialTileSettled(cameraId),\n224:       autofocus: index == 0,\n225:       onFocusChange: (bool hasFocus) {\n226:         if (hasFocus) {\n227:           _focus.markFocused(index);\n228:         }\n229:       },\n230:     );\n231:   }\n232: \n233:   void _onInitialTileSettled(String cameraId) {\n234:     _initialSettledCameras.add(cameraId);\n235:     if (!_liveStarted &&\n236:         _initialSettledCameras.length == cctvCameraIds.length) {\n237:       _liveStarted = true;\n238:       widget.liveSession?.start(activate: _activateLiveVersion);\n239:     }\n240:   }\n241: \n242:   Future<void> _bootHandle() async {\n243:     try {\n244:       await _handle.prepare();\n245:     } on Object catch (error) {\n246:       if (!mounted) return;\n247:       setState(() {\n248:         _status = 'OFFLINE VERIFY FAILED · KEEPING CURRENT FEED';\n249:         _recoveryStatus = error.toString();\n250:       });\n251:       return;\n252:     }\n253:     if (!mounted) return;\n254:     try {\n255:       await _handle.activate();\n256:     } on Object catch (error) {\n257:       if (!mounted) return;\n258:       setState(() {\n259:         _status = 'WALL ACTIVATE FAILED · KEEPING CURRENT FEED';\n260:         _recoveryStatus = error.toString();\n261:       });\n262:     }\n263:   }\n264: \n265:   Future<void> _prepareCurrentVersion() =>\n266:       _verifyPlayableSources(_manifest, _mediaByClipId);\n267: \n268:   Future<void> _activateCurrentVersion() async {\n269:     if (!mounted) throw StateError('wall has been disposed');\n270:     _restoreTileFocus();\n271:   }\n272: \n273:   Future<void> _activateLiveVersion(PlaybackSyncSnapshot snapshot) async {\n274:     final PlaybackManifest? manifest = snapshot.manifest;\n275:     if (manifest == null || !snapshot.hasCompleteMedia) {\n276:       throw StateError('live activation requires complete verified media');\n277:     }\n278:     final WallPlaybackHandle staged = WallPlaybackHandle(\n279:       prepareAction: () =>\n280:           _verifyPlayableSources(manifest, snapshot.mediaByClipId),\n281:       activateAction: () =>\n282:           _applyVerifiedVersion(manifest, snapshot.mediaByClipId),\n283:     );\n284:     await staged.prepare();\n285:     await staged.activate();\n286:   }\n287: \n288:   Future<void> _verifyPlayableSources(\n289:     PlaybackManifest manifest,\n290:     Map<String, CachedMedia> mediaByClipId,\n291:   ) async {\n292:     final Future<bool> Function(String path) exists =\n293:         widget.fileExists ?? _realFileExists;\n294:     for (final TileMediaSource source in _sourcesFor(\n295:       manifest,\n296:       mediaByClipId,\n297:     ).values) {\n298:       if (source case LocalFileSource(:final path)) {\n299:         if (!await exists(path)) {\n300:           throw FileSystemException('verified playback file is missing', path);\n301:         }\n302:       }\n303:     }\n304:   }\n305: \n306:   static Future<bool> _realFileExists(String path) =>\n307:       File(path).exists();\n308: \n309: \n310:   Map<String, TileMediaSource> _sourcesFor(\n311:     PlaybackManifest manifest,\n312:     Map<String, CachedMedia> mediaByClipId,\n313:   ) {\n314:     final Map<String, TileMediaSource> sources = <String, TileMediaSource>{};\n315:     for (final String cameraId in cctvCameraIds) {\n316:       final ClipDescriptor clip = manifest.clips.firstWhere(\n317:         (ClipDescriptor value) => value.cameraId == cameraId,\n318:       );\n319:       final CachedMedia? cached = mediaByClipId[clip.id];\n320:       if (cached != null) {\n321:         if (cached.clipId != clip.id ||\n322:             cached.sha256.toLowerCase() != clip.sha256.toLowerCase() ||\n323:             cached.localRef.trim().isEmpty) {\n324:           throw StateError('verified media entry does not match ${clip.id}');\n325:         }\n326:         sources[cameraId] = LocalFileSource(cached.localRef);\n327:         continue;\n328:       }\n329:       if (mediaByClipId.isNotEmpty) {\n330:         throw StateError('committed media is missing ${clip.id}');\n331:       }\n332:       final String? assetPath = assetPathForClip(clip);\n333:       sources[cameraId] = BundledAssetSource(\n334:         assetPath ?? assetPathForCamera(cameraId),\n335:       );\n336:     }\n337:     return sources;\n338:   }\n339: \n340:   Future<void> _applyVerifiedVersion(\n341:     PlaybackManifest manifest,\n342:     Map<String, CachedMedia> mediaByClipId,\n343:   ) async {\n344:     if (!mounted) throw StateError('wall has been disposed');\n345:     final Map<String, TileMediaSource> oldSources =\n346:         Map<String, TileMediaSource>.of(_tileSources);\n347:     final Map<String, TileMediaSource> targetSources = _sourcesFor(\n348:       manifest,\n349:       mediaByClipId,\n350:     );\n351:     final List<String> switched = <String>[];\n352:     try {\n353:       for (final String cameraId in cctvCameraIds) {\n354:         final TileMediaSource target = targetSources[cameraId]!;\n355:         if (oldSources[cameraId] == target) continue;\n356:         if (!await _replaceTileSource(cameraId, target)) {\n357:           throw StateError('decoder rejected replacement for $cameraId');\n358:         }\n359:         switched.add(cameraId);\n360:       }\n361:     } on Object {\n362:       for (final String cameraId in switched.reversed) {\n363:         await _replaceTileSource(cameraId, oldSources[cameraId]!);\n364:       }\n365:       if (mounted) setState(() => _tileSources = oldSources);\n366:       rethrow;\n367:     }\n368:     if (!mounted) throw StateError('wall was disposed during activation');\n369:     setState(() {\n370:       _manifest = manifest;\n371:       _mediaByClipId = Map<String, CachedMedia>.of(mediaByClipId);\n372:       _tileSources = targetSources;\n373:       _status = 'WALL UPDATED · v${manifest.version}';\n374:     });\n375:   }\n376: \n377:   Future<bool> _replaceTileSource(\n378:     String cameraId,\n379:     TileMediaSource source,\n380:   ) async {\n381:     if (_tileSources[cameraId] == source) return true;\n382:     final Completer<bool> settled = Completer<bool>();\n383:     _sourceSettles[cameraId] = settled;\n384:     setState(() => _tileSources[cameraId] = source);\n385:     await WidgetsBinding.instance.endOfFrame;\n386:     try {\n387:       return await settled.future.timeout(widget.sourceSettleTimeout);\n388:     } finally {\n389:       if (identical(_sourceSettles[cameraId], settled)) {\n390:         _sourceSettles.remove(cameraId);\n391:       }\n392:     }\n393:   }\n394: \n395:   /// Builds the resolved channel with this app's surfaces.\n396:   ///\n397:   /// The registry owns the channel (descriptor, profile, clock, glitch\n398:   /// configuration); the app must inject its decoder surfaces\n399:   /// ([CctvTileBuilder]), so a shallow copy preserving the registry\n400:   /// object's configuration is built. Live wall state (effects flag,\n401:   /// manifest version, overscan safety) additionally travels via\n402:   /// [ChannelContext.settings], which [HauntedSurveillancePlugin.build]\n403:   /// honors — registry object and copy can never diverge on wall config.\n404:   /// Tile widgets keep stable cameraId-based keys and swap feeds in place\n405:   /// ([CameraTile.didUpdateWidget] disposes before creating), so a cached\n406:   /// retry never transiently doubles the decoder count.\n407:   ChannelPlugin _configuredChannel() {\n408:     final ChannelPlugin resolved = widget.plugin;\n409:     if (resolved is HauntedSurveillancePlugin) {\n410:       return HauntedSurveillancePlugin(\n411:         tileBuilder: _buildTile,\n412:         profile: widget.profile ?? resolved.profile,\n413:         manifest: _manifest,\n414:         clock: widget.clock,\n415:         disableEffects: _effectsDisabled,\n416:         glitchSeed: widget.glitchSeed,\n417:       );\n418:     }\n419:     return resolved;\n420:   }\n421: \n422:   void _openRecovery() {\n423:     if (!mounted || _recoveryVisible) {\n424:       return;\n425:     }\n426:     setState(() {\n427:       _recoveryVisible = true;\n428:       _recoveryStatus = null;\n429:     });\n430:     // The wall's focus exclusion hands focus back to the scope; pull it onto\n431:     // the first recovery action so a D-pad lands inside the panel.\n432:     WidgetsBinding.instance.addPostFrameCallback((_) {\n433:       if (mounted && _recoveryVisible) {\n434:         _recoveryFocus.requestFocus();\n435:       }\n436:     });\n437:   }\n438: \n439:   /// Opens the host guest-code page.\n440:   ///\n441:   /// Offline builds never reach here (no GUEST CODES button without a\n442:   /// [GuestCodeClient]). The panel owns its authoritative listing refresh\n443:   /// (immediate fetch plus bounded interval); the wall only shows/hides it.\n444:   void _openGuestCodes() {\n445:     final GuestCodeClient? client = widget.guestCodeClient;\n446:     if (!mounted || _guestCodesVisible || client == null) {\n447:       return;\n448:     }\n449:     setState(() {\n450:       _guestCodesVisible = true;\n451:     });\n452:     WidgetsBinding.instance.addPostFrameCallback((_) {\n453:       if (mounted && _guestCodesVisible) {\n454:         _recoveryFocus.requestFocus();\n455:       }\n456:     });\n457:   }\n458: \n459:   /// Returns from the guest-code page to the recovery actions.\n460:   void _closeGuestCodes() {\n461:     setState(() {\n462:       _guestCodesVisible = false;\n463:     });\n464:     WidgetsBinding.instance.addPostFrameCallback((_) {\n465:       if (mounted && _recoveryVisible) {\n466:         _recoveryFocus.requestFocus();\n467:       }\n468:     });\n469:   }\n470: \n471:   void _closeRecovery() {\n472:     setState(() {\n473:       _recoveryVisible = false;\n474:       _guestCodesVisible = false;\n475:       _recoveryStatus = null;\n476:     });\n477:     // D-pad focus returns to the tile the user was watching. Deferred to a\n478:     // post-frame callback: while the overlay is still mounted this frame,\n479:     // ExcludeFocus(excluding: true) rejects a synchronous requestFocus on\n480:     // the wall tiles, so the request must run after the rebuild flips\n481:     // excluding back to false (same path as _restoreTileFocus).\n482:     _restoreTileFocus();\n483:   }\n484: \n485:   Future<void> _retryCached() async {\n486:     final Future<VerifiedWallPlayback?> Function()? retryPlayback =\n487:         widget.onRetryCachedPlayback;\n488:     if (retryPlayback != null) {\n489:       VerifiedWallPlayback? restored;\n490:       try {\n491:         restored = await retryPlayback();\n492:       } on Object {\n493:         restored = null;\n494:       }\n495:       if (restored != null) {\n496:         try {\n497:           await _activateLiveVersion(\n498:             PlaybackSyncSnapshot(\n499:               state: PlaybackSyncState.ready,\n500:               manifest: restored.manifest,\n501:               mediaByClipId: restored.mediaByClipId,\n502:             ),\n503:           );\n504:         } on Object {\n505:           if (mounted) {\n506:             setState(() {\n507:               _recoveryStatus = 'Cached media could not be activated.';\n508:               _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n509:             });\n510:           }\n511:           return;\n512:         }\n513:         if (!mounted) return;\n514:         setState(() {\n515:           _recoveryVisible = false;\n516:           _recoveryStatus = null;\n517:         });\n518:         _restoreTileFocus();\n519:         return;\n520:       }\n521:     }\n522:     final Future<PlaybackManifest?> Function()? retry = widget.onRetryCached;\n523:     PlaybackManifest? reloaded;\n524:     if (retry != null) {\n525:       try {\n526:         reloaded = await retry();\n527:       } catch (_) {\n528:         reloaded = null;\n529:       }\n530:     }\n531:     if (!mounted) {\n532:       return;\n533:     }\n534:     if (reloaded == null) {\n535:       setState(() {\n536:         _recoveryStatus = 'No cached wall stored yet.';\n537:         _status = 'NO CACHED WALL · KEEPING CURRENT FEED';\n538:       });\n539:       return;\n540:     }\n541:     final PlaybackManifest restored = reloaded;\n542:     try {\n543:       await _applyVerifiedVersion(restored, const <String, CachedMedia>{});\n544:     } on Object {\n545:       if (mounted) {\n546:         setState(() {\n547:           _recoveryStatus = 'Cached wall could not be activated.';\n548:           _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n549:         });\n550:       }\n551:       return;\n552:     }\n553:     if (mounted) {\n554:       setState(() {\n555:         _recoveryVisible = false;\n556:         _recoveryStatus = null;\n557:         _status = 'WALL RESTORED · v${restored.version}';\n558:       });\n559:       _restoreTileFocus();\n560:     }\n561:   }\n562: \n563:   void _toggleEffects() {\n564:     final bool value = !_effectsDisabled;\n565:     setState(() {\n566:       _effectsDisabled = value;\n567:       _status = _effectsDisabled ? 'EFFECTS DISABLED' : 'EFFECTS ENABLED';\n568:     });\n569:     final SettingsPort? settings = widget.settings;\n570:     if (settings != null) {\n571:       unawaited(\n572:         settings.setBool(\n573:           partyId: PartyId(widget.partyId),\n574:           key: CctvWallSettingsKeys.effectsDisabled,\n575:           value: value,\n576:         ),\n577:       );\n578:     }\n579:   }\n580: \n581:   void _restoreTileFocus() {\n582:     WidgetsBinding.instance.addPostFrameCallback((_) {\n583:       if (!mounted) {\n584:         return;\n585:       }\n586:       final int index = _focus.focusedIndex;\n587:       _focus.focusTile(index < 0 ? 0 : index);\n588:     });\n589:   }\n590: \n591:   bool _isSelectKey(LogicalKeyboardKey key) =>\n592:       key == LogicalKeyboardKey.select ||\n593:       key == LogicalKeyboardKey.enter ||\n594:       key == LogicalKeyboardKey.gameButtonA ||\n595:       key == LogicalKeyboardKey.space;\n596: \n597:   KeyEventResult _onWallKey(FocusNode node, KeyEvent event) {\n598:     if (event is KeyDownEvent) {\n599:       if (event.logicalKey == LogicalKeyboardKey.contextMenu ||\n600:           event.logicalKey == LogicalKeyboardKey.gameButtonStart) {\n601:         if (widget.recoveryEnabled) {\n602:           _openRecovery();\n603:         }\n604:         return KeyEventResult.handled;\n605:       }\n606:       if (widget.recoveryEnabled && _isSelectKey(event.logicalKey)) {\n607:         if (!_okHeld) {\n608:           _okHeld = true;\n609:           _okHoldTimer?.cancel();\n610:           _okHoldTimer = Timer(widget.longPressDuration, _openRecovery);\n611:         }\n612:         return KeyEventResult.handled;\n613:       }\n614:       if (_focus.handleArrow(event.logicalKey)) {\n615:         return KeyEventResult.handled;\n616:       }\n617:       return KeyEventResult.ignored;\n618:     }\n619:     if (event is KeyUpEvent && _isSelectKey(event.logicalKey)) {\n620:       _okHeld = false;\n621:       _okHoldTimer?.cancel();\n622:       _okHoldTimer = null;\n623:       return KeyEventResult.handled;\n624:     }\n625:     return KeyEventResult.ignored;\n626:   }\n627: \n628:   @override\n629:   Widget build(BuildContext context) {\n630:     final ChannelPlugin channel = _configuredChannel();\n631:     final ChannelContext channelContext = ChannelContext(\n632:       partyId: PartyId(widget.partyId),\n633:       playbackHandle: _handle,\n634:       // Wall config travels through the channel contract so\n635:       // HauntedSurveillancePlugin.build applies it without the host\n636:       // discarding the registry object.\n637:       settings: ChannelSettings(<String, Object?>{\n638:         CctvWallSettingsKeys.effectsDisabled: _effectsDisabled,\n639:         CctvWallSettingsKeys.manifestVersion: _manifest.version,\n640:         CctvWallSettingsKeys.overscanSafe: true,\n641:       }),\n642:     );\n643: \n644:     return FocusTraversalGroup(\n645:       child: Stack(\n646:         fit: StackFit.expand,\n647:         children: <Widget>[\n648:           // Key gate: arrows move tile focus, OK long-press / MENU opens\n649:           // recovery. `canRequestFocus: false` keeps tile 0 the entry point.\n650:           ExcludeFocus(\n651:             excluding: _recoveryVisible,\n652:             child: Focus(\n653:               canRequestFocus: false,\n654:               skipTraversal: true,\n655:               onKeyEvent: _onWallKey,\n656:               child: SafeArea(\n657:                 minimum: widget.overscanPadding,\n658:                 // Stable key: tiles keep cameraId-based keys across retries\n659:                 // and swap feeds in place instead of remounting (which would\n660:                 // transiently double the decoder count).\n661:                 child: KeyedSubtree(\n662:                   key: ValueKey<String>('wall-${widget.partyId}'),\n663:                   child: channel.build(channelContext),\n664:                 ),\n665:               ),\n666:             ),\n667:           ),\n668:           if (_status != null)\n669:             Positioned(\n670:               left: 24,\n671:               right: 24,\n672:               bottom: 20,\n673:               child: IgnorePointer(\n674:                 child: Container(\n675:                   key: kWallStatusBannerKey,\n676:                   padding: const EdgeInsets.symmetric(\n677:                     horizontal: 16,\n678:                     vertical: 10,\n679:                   ),\n680:                   color: const Color(0xCC000000),\n681:                   child: Text(_status!, style: CctvTheme.badgeStyle),\n682:                 ),\n683:               ),\n684:             ),\n685:           if (_recoveryVisible)\n686:             Positioned.fill(\n687:               child: KeyedSubtree(\n688:                 key: kRecoveryOverlayKey,\n689:                 child: _guestCodesVisible\n690:                   ? GuestCodePanel(\n691:                       client: widget.guestCodeClient!,\n692:                       tvDeviceId: widget.tvDeviceId,\n693:                       primaryFocusNode: _recoveryFocus,\n694:                       onBack: _closeGuestCodes,\n695:                       onClose: _closeRecovery,\n696:                     )\n697:                   : RecoveryOverlay(\n698:                       effectsDisabled: _effectsDisabled,\n699:                       statusMessage: _recoveryStatus,\n700:                       primaryFocusNode: _recoveryFocus,\n701:                       onRetryCached: () => unawaited(_retryCached()),\n702:                       onToggleEffects: _toggleEffects,\n703:                       onClose: _closeRecovery,\n704:                       onShowGuestCodes: widget.guestCodeClient == null\n705:                           ? null\n706:                           : _openGuestCodes,\n707:                     ),\n708:               ),\n709:             ),\n710:         ],\n711:       ),\n712:     );\n713:   }\n714: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_screen.dart, lines 1-714\n1: /// Hosts the haunted-surveillance channel wall for one party.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:io';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_cache/core_cache.dart';\n9: import 'package:core_effects/core_effects.dart';\n10: import 'package:core_foundation/core_foundation.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: import 'package:core_ui/core_ui.dart';\n13: import 'package:flutter/material.dart';\n14: import 'package:flutter/services.dart';\n15: import 'package:kernel_app/kernel_app.dart';\n16: import 'package:tv_app/src/media/feed_assets.dart';\n17: import 'package:tv_app/src/playback/camera_tile.dart';\n18: import 'package:tv_app/src/playback/tile_video_controller.dart';\n19: import 'package:tv_app/src/wall/guest_code_panel.dart';\n20: import 'package:tv_app/src/wall/guest_codes.dart';\n21: import 'package:tv_app/src/wall/live_wall_session.dart';\n22: import 'package:tv_app/src/wall/playback_handle.dart';\n23: import 'package:tv_app/src/wall/recovery_overlay.dart';\n24: import 'package:tv_app/src/wall/wall_boot.dart';\n25: import 'package:tv_app/src/wall/wall_focus.dart';\n26: \n27: /// Key of the status banner shown above the wall after recovery actions.\n28: const Key kWallStatusBannerKey = ValueKey<String>('wall-status-banner');\n29: \n30: /// Key of the hidden recovery panel.\n31: const Key kRecoveryOverlayKey = ValueKey<String>('recovery-overlay');\n32: \n33: /// Resolved channel + manifest rendered full-screen on the TV.\n34: ///\n35: /// Responsibilities kept in the app (design s4/s13):\n36: ///  * owns one [CameraTile] (hence one video decoder) per wall slot,\n37: ///  * D-pad focus traversal between the four tiles,\n38: ///  * hidden recovery panel (OK long-press / MENU) with \"retry cached wall\"\n39: ///    and \"disable effects\",\n40: ///  * overscan-safe padding and an app-level status line.\n41: ///\n42: /// Channel chrome (HUD, scanlines/vignette, glitch, SIGNAL LOST frame) comes\n43: /// from `channel_cctv` + `core_ui` + `core_effects`; the app supplies the\n44: /// video surfaces through [HauntedSurveillancePlugin.tileBuilder].\n45: class WallScreen extends StatefulWidget {\n46:   /// Creates the wall host.\n47:   const WallScreen({\n48:     super.key,\n49:     required this.plugin,\n50:     required this.manifest,\n51:     required this.tileControllerFactory,\n52:     required this.clock,\n53:     this.mediaByClipId = const <String, CachedMedia>{},\n54:     this.liveSession,\n55:     this.settings,\n56:     this.profile,\n57:     this.partyId = 'local-party',\n58:     this.tvDeviceId = '',\n59:     this.channelId = hauntedSurveillanceChannelId,\n60:     this.guestCodeClient,\n61:     this.glitchSeed = 0x4A11,\n62:     this.onRetryCached,\n63:     this.onRetryCachedPlayback,\n64:     this.fileExists,\n65:     this.recoveryEnabled = true,\n66:     this.initialEffectsDisabled = false,\n67:     this.overscanPadding = const EdgeInsets.symmetric(\n68:       horizontal: 28,\n69:       vertical: 18,\n70:     ),\n71:     this.longPressDuration = const Duration(milliseconds: 600),\n72:     this.sourceSettleTimeout = const Duration(seconds: 15),\n73:   });\n74: \n75:   /// Channel plugin resolved from the kernel registry.\n76:   final ChannelPlugin plugin;\n77: \n78:   /// Wall manifest driving camera slots.\n79:   final PlaybackManifest manifest;\n80: \n81:   /// Builds one decoder per tile.\n82:   final TileVideoControllerFactory tileControllerFactory;\n83: \n84:   /// Clock used by the tile HUDs (injectable for deterministic tests).\n85:   final Clock clock;\n86: \n87:   /// Verified committed files keyed by manifest clip id.\n88:   final Map<String, CachedMedia> mediaByClipId;\n89: \n90:   /// Live subscription started after offline rendering.\n91:   final LiveWallSession? liveSession;\n92: \n93:   /// Party-scoped persistent settings.\n94:   final SettingsPort? settings;\n95: \n96:   /// Effect profile for tile overlays; defaults to [cctvProfile].\n97:   final EffectProfile? profile;\n98: \n99:   /// Party this wall belongs to.\n100:   final String partyId;\n101: \n102:   /// TV's own device code, shown on the host guest-code page.\n103:   final String tvDeviceId;\n104: \n105:   /// Active channel for the guest-code join payload.\n106:   final String channelId;\n107: \n108:   /// Host guest-code reader; null keeps the recovery panel on its actions\n109:   /// only (offline builds never list codes).\n110:   final GuestCodeClient? guestCodeClient;\n111: \n112:   /// Seed for the wall's deterministic glitch bursts.\n113:   final int glitchSeed;\n114: \n115:   /// Reloads the last cached manifest; null result means \"nothing cached\".\n116:   final Future<PlaybackManifest?> Function()? onRetryCached;\n117: \n118:   /// Re-verifies the durable remote index without interrupting live work.\n119:   final Future<VerifiedWallPlayback?> Function()? onRetryCachedPlayback;\n120: \n121:   /// Existence check for verified local files.\n122:   ///\n123:   /// Defaults to real `File(path).exists()`. Injectable because `testWidgets`\n124:   /// bodies run in a FakeAsync zone where real dart:io never completes;\n125:   /// production passes nothing and keeps the real filesystem check.\n126:   final Future<bool> Function(String path)? fileExists;\n127: \n128:   /// Whether OK long-press / MENU reveals the recovery panel.\n129:   final bool recoveryEnabled;\n130: \n131:   /// Starts with effect overlays dropped.\n132:   final bool initialEffectsDisabled;\n133: \n134:   /// Extra padding keeping HUD text inside the TV's overscan-safe area.\n135:   final EdgeInsets overscanPadding;\n136: \n137:   /// How long OK must be held to reveal the recovery panel.\n138:   final Duration longPressDuration;\n139: \n140:   /// Bound for one tile source replacement to settle.\n141:   ///\n142:   /// Defaults to 15s. Injectable so tests do not stall real seconds on\n143:   /// decoder failure and prod can tune it alongside other timeouts.\n144:   final Duration sourceSettleTimeout;\n145: \n146:   @override\n147:   State<WallScreen> createState() => _WallScreenState();\n148: }\n149: \n150: class _WallScreenState extends State<WallScreen> {\n151:   late final WallFocusController _focus;\n152:   late final WallPlaybackHandle _handle;\n153: \n154:   late PlaybackManifest _manifest;\n155:   late Map<String, CachedMedia> _mediaByClipId;\n156:   late Map<String, TileMediaSource> _tileSources;\n157:   final Map<String, Completer<bool>> _sourceSettles =\n158:       <String, Completer<bool>>{};\n159:   final Set<String> _initialSettledCameras = <String>{};\n160:   bool _liveStarted = false;\n161:   late bool _effectsDisabled;\n162:   bool _recoveryVisible = false;\n163:   bool _guestCodesVisible = false;\n164:   bool _okHeld = false;\n165:   bool _activatedHandle = false;\n166:   String? _status;\n167:   String? _recoveryStatus;\n168:   Timer? _okHoldTimer;\n169:   final FocusNode _recoveryFocus = FocusNode(debugLabel: 'recovery-primary');\n170: \n171:   @override\n172:   void initState() {\n173:     super.initState();\n174:     _focus = WallFocusController();\n175:     _manifest = widget.manifest;\n176:     _mediaByClipId = Map<String, CachedMedia>.of(widget.mediaByClipId);\n177:     _tileSources = _sourcesFor(_manifest, _mediaByClipId);\n178:     _effectsDisabled = widget.initialEffectsDisabled;\n179:     _handle = WallPlaybackHandle(\n180:       prepareAction: _prepareCurrentVersion,\n181:       activateAction: _activateCurrentVersion,\n182:     );\n183:     WidgetsBinding.instance.addPostFrameCallback((_) {\n184:       if (!mounted || _activatedHandle) {\n185:         return;\n186:       }\n187:       _activatedHandle = true;\n188:       unawaited(_bootHandle());\n189:     });\n190:   }\n191: \n192:   @override\n193:   void dispose() {\n194:     _okHoldTimer?.cancel();\n195:     _recoveryFocus.dispose();\n196:     _focus.dispose();\n197:     for (final Completer<bool> settle in _sourceSettles.values) {\n198:       if (!settle.isCompleted) settle.complete(false);\n199:     }\n200:     final LiveWallSession? session = widget.liveSession;\n201:     if (session != null) unawaited(session.dispose());\n202:     super.dispose();\n203:   }\n204: \n205:   /// Wall slot builder: app-owned player lifecycle per tile.\n206:   Widget _buildTile(\n207:     BuildContext context,\n208:     int index,\n209:     String label,\n210:     String cameraId,\n211:   ) {\n212:     return CameraTile(\n213:       key: ValueKey<String>('camera-tile-$cameraId'),\n214:       index: index,\n215:       cameraId: cameraId,\n216:       source: _tileSources[cameraId]!,\n217:       focusNode: _focus.nodeAt(index),\n218:       controllerFactory: widget.tileControllerFactory,\n219:       onSourceSettled: (bool success) {\n220:         final Completer<bool>? settle = _sourceSettles[cameraId];\n221:         if (settle != null && !settle.isCompleted) settle.complete(success);\n222:       },\n223:       onInitialSettled: () => _onInitialTileSettled(cameraId),\n224:       autofocus: index == 0,\n225:       onFocusChange: (bool hasFocus) {\n226:         if (hasFocus) {\n227:           _focus.markFocused(index);\n228:         }\n229:       },\n230:     );\n231:   }\n232: \n233:   void _onInitialTileSettled(String cameraId) {\n234:     _initialSettledCameras.add(cameraId);\n235:     if (!_liveStarted &&\n236:         _initialSettledCameras.length == cctvCameraIds.length) {\n237:       _liveStarted = true;\n238:       widget.liveSession?.start(activate: _activateLiveVersion);\n239:     }\n240:   }\n241: \n242:   Future<void> _bootHandle() async {\n243:     try {\n244:       await _handle.prepare();\n245:     } on Object catch (error) {\n246:       if (!mounted) return;\n247:       setState(() {\n248:         _status = 'OFFLINE VERIFY FAILED · KEEPING CURRENT FEED';\n249:         _recoveryStatus = error.toString();\n250:       });\n251:       return;\n252:     }\n253:     if (!mounted) return;\n254:     try {\n255:       await _handle.activate();\n256:     } on Object catch (error) {\n257:       if (!mounted) return;\n258:       setState(() {\n259:         _status = 'WALL ACTIVATE FAILED · KEEPING CURRENT FEED';\n260:         _recoveryStatus = error.toString();\n261:       });\n262:     }\n263:   }\n264: \n265:   Future<void> _prepareCurrentVersion() =>\n266:       _verifyPlayableSources(_manifest, _mediaByClipId);\n267: \n268:   Future<void> _activateCurrentVersion() async {\n269:     if (!mounted) throw StateError('wall has been disposed');\n270:     _restoreTileFocus();\n271:   }\n272: \n273:   Future<void> _activateLiveVersion(PlaybackSyncSnapshot snapshot) async {\n274:     final PlaybackManifest? manifest = snapshot.manifest;\n275:     if (manifest == null || !snapshot.hasCompleteMedia) {\n276:       throw StateError('live activation requires complete verified media');\n277:     }\n278:     final WallPlaybackHandle staged = WallPlaybackHandle(\n279:       prepareAction: () =>\n280:           _verifyPlayableSources(manifest, snapshot.mediaByClipId),\n281:       activateAction: () =>\n282:           _applyVerifiedVersion(manifest, snapshot.mediaByClipId),\n283:     );\n284:     await staged.prepare();\n285:     await staged.activate();\n286:   }\n287: \n288:   Future<void> _verifyPlayableSources(\n289:     PlaybackManifest manifest,\n290:     Map<String, CachedMedia> mediaByClipId,\n291:   ) async {\n292:     final Future<bool> Function(String path) exists =\n293:         widget.fileExists ?? _realFileExists;\n294:     for (final TileMediaSource source in _sourcesFor(\n295:       manifest,\n296:       mediaByClipId,\n297:     ).values) {\n298:       if (source case LocalFileSource(:final path)) {\n299:         if (!await exists(path)) {\n300:           throw FileSystemException('verified playback file is missing', path);\n301:         }\n302:       }\n303:     }\n304:   }\n305: \n306:   static Future<bool> _realFileExists(String path) =>\n307:       File(path).exists();\n308: \n309: \n310:   Map<String, TileMediaSource> _sourcesFor(\n311:     PlaybackManifest manifest,\n312:     Map<String, CachedMedia> mediaByClipId,\n313:   ) {\n314:     final Map<String, TileMediaSource> sources = <String, TileMediaSource>{};\n315:     for (final String cameraId in cctvCameraIds) {\n316:       final ClipDescriptor clip = manifest.clips.firstWhere(\n317:         (ClipDescriptor value) => value.cameraId == cameraId,\n318:       );\n319:       final CachedMedia? cached = mediaByClipId[clip.id];\n320:       if (cached != null) {\n321:         if (cached.clipId != clip.id ||\n322:             cached.sha256.toLowerCase() != clip.sha256.toLowerCase() ||\n323:             cached.localRef.trim().isEmpty) {\n324:           throw StateError('verified media entry does not match ${clip.id}');\n325:         }\n326:         sources[cameraId] = LocalFileSource(cached.localRef);\n327:         continue;\n328:       }\n329:       if (mediaByClipId.isNotEmpty) {\n330:         throw StateError('committed media is missing ${clip.id}');\n331:       }\n332:       final String? assetPath = assetPathForClip(clip);\n333:       sources[cameraId] = BundledAssetSource(\n334:         assetPath ?? assetPathForCamera(cameraId),\n335:       );\n336:     }\n337:     return sources;\n338:   }\n339: \n340:   Future<void> _applyVerifiedVersion(\n341:     PlaybackManifest manifest,\n342:     Map<String, CachedMedia> mediaByClipId,\n343:   ) async {\n344:     if (!mounted) throw StateError('wall has been disposed');\n345:     final Map<String, TileMediaSource> oldSources =\n346:         Map<String, TileMediaSource>.of(_tileSources);\n347:     final Map<String, TileMediaSource> targetSources = _sourcesFor(\n348:       manifest,\n349:       mediaByClipId,\n350:     );\n351:     final List<String> switched = <String>[];\n352:     try {\n353:       for (final String cameraId in cctvCameraIds) {\n354:         final TileMediaSource target = targetSources[cameraId]!;\n355:         if (oldSources[cameraId] == target) continue;\n356:         if (!await _replaceTileSource(cameraId, target)) {\n357:           throw StateError('decoder rejected replacement for $cameraId');\n358:         }\n359:         switched.add(cameraId);\n360:       }\n361:     } on Object {\n362:       for (final String cameraId in switched.reversed) {\n363:         await _replaceTileSource(cameraId, oldSources[cameraId]!);\n364:       }\n365:       if (mounted) setState(() => _tileSources = oldSources);\n366:       rethrow;\n367:     }\n368:     if (!mounted) throw StateError('wall was disposed during activation');\n369:     setState(() {\n370:       _manifest = manifest;\n371:       _mediaByClipId = Map<String, CachedMedia>.of(mediaByClipId);\n372:       _tileSources = targetSources;\n373:       _status = 'WALL UPDATED · v${manifest.version}';\n374:     });\n375:   }\n376: \n377:   Future<bool> _replaceTileSource(\n378:     String cameraId,\n379:     TileMediaSource source,\n380:   ) async {\n381:     if (_tileSources[cameraId] == source) return true;\n382:     final Completer<bool> settled = Completer<bool>();\n383:     _sourceSettles[cameraId] = settled;\n384:     setState(() => _tileSources[cameraId] = source);\n385:     await WidgetsBinding.instance.endOfFrame;\n386:     try {\n387:       return await settled.future.timeout(widget.sourceSettleTimeout);\n388:     } finally {\n389:       if (identical(_sourceSettles[cameraId], settled)) {\n390:         _sourceSettles.remove(cameraId);\n391:       }\n392:     }\n393:   }\n394: \n395:   /// Builds the resolved channel with this app's surfaces.\n396:   ///\n397:   /// The registry owns the channel (descriptor, profile, clock, glitch\n398:   /// configuration); the app must inject its decoder surfaces\n399:   /// ([CctvTileBuilder]), so a shallow copy preserving the registry\n400:   /// object's configuration is built. Live wall state (effects flag,\n401:   /// manifest version, overscan safety) additionally travels via\n402:   /// [ChannelContext.settings], which [HauntedSurveillancePlugin.build]\n403:   /// honors — registry object and copy can never diverge on wall config.\n404:   /// Tile widgets keep stable cameraId-based keys and swap feeds in place\n405:   /// ([CameraTile.didUpdateWidget] disposes before creating), so a cached\n406:   /// retry never transiently doubles the decoder count.\n407:   ChannelPlugin _configuredChannel() {\n408:     final ChannelPlugin resolved = widget.plugin;\n409:     if (resolved is HauntedSurveillancePlugin) {\n410:       return HauntedSurveillancePlugin(\n411:         tileBuilder: _buildTile,\n412:         profile: widget.profile ?? resolved.profile,\n413:         manifest: _manifest,\n414:         clock: widget.clock,\n415:         disableEffects: _effectsDisabled,\n416:         glitchSeed: widget.glitchSeed,\n417:       );\n418:     }\n419:     return resolved;\n420:   }\n421: \n422:   void _openRecovery() {\n423:     if (!mounted || _recoveryVisible) {\n424:       return;\n425:     }\n426:     setState(() {\n427:       _recoveryVisible = true;\n428:       _recoveryStatus = null;\n429:     });\n430:     // The wall's focus exclusion hands focus back to the scope; pull it