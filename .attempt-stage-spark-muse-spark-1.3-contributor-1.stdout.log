st newClips = clipsFor(nextVersion, \"2026-11-29T16:00:00.000Z\");\n200:   let failedOnce = false;\n201:   const failingPath = oldClips[0].objectPath;\n202:   try {\n203:     await seedParty(db, partyId, deviceId, channelId);\n204:     await Promise.all(oldClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n205:     await Promise.all(newClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n206:     const currentRef = db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n207:     await currentRef.set({\n208:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: oldExpiry,\n209:       cameraClips: oldClips.map(({ bytes: _bytes, ...clip }) => clip),\n210:     });\n211:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({ jobId, partyId, deviceId, channelId, state: \"ready\" });\n212:     const services = createDeliveryServices({\n213:       db,\n214:       bucket,\n215:       now: () => new Date(now.value),\n216:       deleteDeliveryObject: async (file) => {\n217:         if (file.name === failingPath && !failedOnce) {\n218:           failedOnce = true;\n219:           throw new Error(\"injected partial purge failure\");\n220:         }\n221:         await file.delete({ ignoreNotFound: true });\n222:       },\n223:     });\n224:     const clipHashes = Object.fromEntries(oldClips.map((clip) => [clip.cameraId, clip.sha256]));\n225:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes }));\n226:     assert.equal((await bucket.file(failingPath).exists())[0], true);\n227:     assert.equal((await bucket.file(oldClips[1].objectPath).exists())[0], false);\n228:     const ackId = (await db.collection(`parties/${partyId}/deliveryAcks`).get()).docs[0]?.id;\n229:     assert.ok(ackId);\n230: \n231:     await currentRef.set({\n232:       partyId, channelId, version: nextVersion, schemaVersion: SCHEMA_VERSION, jobId: \"job-new-version\",\n233:       expiresAt: \"2026-11-29T16:00:00.000Z\",\n234:       cameraClips: newClips.map(({ bytes: _bytes, ...clip }) => clip),\n235:     });\n236:     now.value = Date.parse(\"2026-10-30T17:00:00.000Z\");\n237:     const conflictingHashes = { ...clipHashes, \"CAM-01\": \"f\".repeat(64) };\n238:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes: conflictingHashes }),\n239:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n240: \n241:     const repeated = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n242:     assert.equal(repeated.ackId, ackId);\n243:     for (const clip of oldClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n244:     for (const clip of newClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], true);\n245:   } finally {\n246:     await clearParty(db, bucket, partyId);\n247:     await disposeEmulatorContext(app);\n248:   }\n249: });\n250: \n251: test(\"a manifest bound to withdrawn consent yields no delivery URLs even while it lingers\", {\n252:   skip: !HAS_FIRESTORE_EMULATOR,\n253: }, async () => {\n254:   const { app, db, bucket } = await createEmulatorContext();\n255:   const partyId = randomPartyId();\n256:   const deviceId = \"tv-1\";\n257:   const channelId = \"main\";\n258:   const version = 1;\n259:   const jobId = \"job-revoked-consent\";\n260:   const submissionId = \"gsub-revoked000000000000000001\";\n261:   const expiry = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n262:   const cameraClips = REQUIRED_CAMERA_IDS.map((cameraId) => {\n263:     const bytes = Buffer.from(`revoked-${cameraId}`);\n264:     return { cameraId, objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`, sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"), sizeBytes: bytes.length, durationMs: 2000, expiresAt: expiry, bytes };\n265:   });\n266:   try {\n267:     await seedParty(db, partyId, deviceId, channelId);\n268:     await Promise.all(cameraClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n269:     // Guest-bound job whose consent was withdrawn after publication; the\n270:     // manifest document itself has not been collected yet.\n271:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n272:       jobId, partyId, deviceId, channelId, manifestVersion: version, idempotencyKey: jobId, state: \"failed\",\n273:       guestMedia: { submissionId, objectPath: `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`, sourceHash: \"a\".repeat(64), consentRevision: \"v1:revoked\", deviceId, channelId },\n274:     });\n275:     await db.doc(`parties/${partyId}/guestMedia/${submissionId}`).set({\n276:       submissionId, partyId, deviceId, channelId, status: \"withdrawn\", tombstone: true,\n277:       consentRevision: \"v1:revoked\", objectPath: `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`,\n278:     });\n279:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n280:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: expiry,\n281:       createdAt: FieldValue.serverTimestamp(),\n282:       cameraClips: cameraClips.map(({ bytes: _bytes, ...clip }) => clip),\n283:     });\n284:     const services = createDeliveryServices({ db, bucket, signReadUrl: async () => \"https://unused.invalid\" });\n285:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n286:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n287:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n288:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n289:     // Control: the same manifest shape without a guest binding still serves.\n290:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({ guestMedia: FieldValue.delete() });\n291:     const delivery = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n292:     assert.equal(delivery.manifestVersion, version);\n293:     assert.equal(delivery.clips.length, 4);\n294:   } finally {\n295:     await clearParty(db, bucket, partyId);\n296:     await disposeEmulatorContext(app);\n297:   }\n298: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/delivery.test.ts, lines 1-298\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import test from \"node:test\";\n4: import { FieldValue } from \"firebase-admin/firestore\";\n5: import { createDeliveryServices } from \"../src/delivery\";\n6: import { REQUIRED_CAMERA_IDS, SCHEMA_VERSION } from \"../src/config\";\n7: import { BackendError } from \"../src/contracts\";\n8: import { HAS_FIRESTORE_EMULATOR, createEmulatorContext, clearParty, randomPartyId, seedParty, disposeEmulatorContext } from \"./support/emulators\";\n9: \n10: test(\"delivery URLs stay inside active party scope; canonical ACK purges clips idempotently\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n11:   const { app, db, bucket } = await createEmulatorContext();\n12:   const partyId = randomPartyId();\n13:   const deviceId = \"tv-1\";\n14:   const channelId = \"main\";\n15:   const version = 4;\n16:   const jobId = \"job-delivery\";\n17:   const expiry = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n18:   const cameraClips = REQUIRED_CAMERA_IDS.map((cameraId) => {\n19:     const bytes = Buffer.from(`fixture-${cameraId}`);\n20:     return { cameraId, objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`, sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"), sizeBytes: bytes.length, durationMs: 2000, expiresAt: expiry, bytes };\n21:   });\n22:   try {\n23:     await seedParty(db, partyId, deviceId, channelId);\n24:     await Promise.all(cameraClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes, {\n25:       metadata: { contentType: \"video/mp4\", metadata: { expiresAt: expiry, jobId, partyId } },\n26:     })));\n27:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n28:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: expiry,\n29:       createdAt: FieldValue.serverTimestamp(),\n30:       cameraClips: cameraClips.map(({ bytes: _bytes, ...clip }) => clip),\n31:     });\n32:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({ jobId, partyId, deviceId, channelId, manifestVersion: version, idempotencyKey: jobId, state: \"ready\", deliveryPaths: cameraClips.map((clip) => clip.objectPath) });\n33: \n34:     const signedPaths: string[] = [];\n35:     const services = createDeliveryServices({\n36:       db,\n37:       bucket,\n38:       signReadUrl: async (file) => { signedPaths.push(file.name); return `https://signed.invalid/${encodeURIComponent(file.name)}`; },\n39:     });\n40:     const delivery = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n41:     assert.equal(delivery.manifestVersion, version);\n42:     assert.deepEqual(signedPaths.sort(), cameraClips.map((clip) => clip.objectPath).sort());\n43:     assert.ok(delivery.clips.every((clip) => clip.url.includes(encodeURIComponent(`parties/${partyId}/`))));\n44:     const currentManifest = await services.getCurrentManifest({ partyId, deviceId, channelId });\n45:     const repeatedManifest = await services.getCurrentManifest({ partyId, deviceId, channelId });\n46:     assert.equal(currentManifest.createdAt, repeatedManifest.createdAt);\n47:     assert.equal(typeof currentManifest.createdAt, \"string\");\n48:     assert.deepEqual(currentManifest.cameraClips.map((clip) => clip.cameraId), [...REQUIRED_CAMERA_IDS]);\n49:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId: \"not-registered\", channelId }),\n50:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n51:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId: \"not-registered\", channelId }),\n52:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n53:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId: \"other-channel\" }),\n54:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n55:     await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ status: \"disabled\" });\n56:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n57:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n58:     await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ status: \"active\" });\n59:     await db.doc(`parties/${partyId}`).update({ status: \"inactive\" });\n60:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n61:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n62:     await db.doc(`parties/${partyId}`).update({ status: \"active\" });\n63:     await db.doc(`parties/${partyId}/channels/${channelId}`).update({ status: \"inactive\" });\n64:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n65:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n66:     await db.doc(`parties/${partyId}/channels/${channelId}`).update({ status: \"active\" });\n67: \n68:     const invalidHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n69:     invalidHashes[\"CAM-01\"] = \"f\".repeat(64);\n70:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes: invalidHashes }),\n71:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n72: \n73:     const clipHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n74:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version - 1, clipHashes }),\n75:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n76:     const ack = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n77:     assert.equal(ack.purged, true);\n78:     assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.state, \"purged\");\n79:     for (const clip of cameraClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n80:     const repeated = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n81:     assert.equal(repeated.ackId, ack.ackId);\n82:   } finally {\n83:     await clearParty(db, bucket, partyId);\n84:     await disposeEmulatorContext(app);\n85:   }\n86: });\n87: \n88: test(\"two-camera manifest delivers, ACKs exactly, and rejects extra hashes\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n89:   const { app, db, bucket } = await createEmulatorContext();\n90:   const partyId = randomPartyId();\n91:   const deviceId = \"tv-2cam\";\n92:   const channelId = \"main\";\n93:   const version = 2;\n94:   const jobId = \"job-two-cam\";\n95:   const expiry = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n96:   const cameraIds = [\"CAM-01\", \"CAM-02\"] as const;\n97:   const cameraClips = cameraIds.map((cameraId) => {\n98:     const bytes = Buffer.from(`two-cam-${cameraId}`);\n99:     return { cameraId, objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`, sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"), sizeBytes: bytes.length, durationMs: 2000, expiresAt: expiry, bytes };\n100:   });\n101:   try {\n102:     await seedParty(db, partyId, deviceId, channelId);\n103:     await Promise.all(cameraClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n104:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n105:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: expiry,\n106:       createdAt: FieldValue.serverTimestamp(),\n107:       cameraClips: cameraClips.map(({ bytes: _bytes, ...clip }) => clip),\n108:     });\n109:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({ jobId, partyId, deviceId, channelId, manifestVersion: version, idempotencyKey: jobId, state: \"ready\" });\n110:     const services = createDeliveryServices({\n111:       db,\n112:       bucket,\n113:       signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n114:     });\n115:     const delivery = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n116:     assert.equal(delivery.manifestVersion, version);\n117:     assert.deepEqual(delivery.clips.map((clip) => clip.cameraId).sort(), [\"CAM-01\", \"CAM-02\"]);\n118:     const current = await services.getCurrentManifest({ partyId, deviceId, channelId });\n119:     assert.equal(current.cameraClips.length, 2);\n120:     const clipHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n121:     // Extra hashes beyond the received prefix are rejected, nothing purged.\n122:     await assert.rejects(services.acknowledgeDelivery({\n123:       partyId, deviceId, channelId, manifestVersion: version,\n124:       clipHashes: { ...clipHashes, \"CAM-03\": \"c\".repeat(64) },\n125:     }), (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n126:     assert.equal((await bucket.file(cameraClips[0].objectPath).exists())[0], true);\n127:     const ack = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n128:     assert.equal(ack.purged, true);\n129:     for (const clip of cameraClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n130:     // Legacy four-camera ACK shape against a two-camera manifest is rejected.\n131:     await assert.rejects(services.acknowledgeDelivery({\n132:       partyId, deviceId, channelId, manifestVersion: version,\n133:       clipHashes: { ...clipHashes, \"CAM-03\": \"c\".repeat(64), \"CAM-04\": \"d\".repeat(64) },\n134:     }), (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n135:     const repeated = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n136:     assert.equal(repeated.ackId, ack.ackId);\n137:   } finally {\n138:     await clearParty(db, bucket, partyId);\n139:     await disposeEmulatorContext(app);\n140:   }\n141: });\n142: \n143: test(\"expired canonical clip does not receive a signed URL\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n144:   const { app, db, bucket } = await createEmulatorContext();\n145:   const partyId = randomPartyId();\n146:   const deviceId = \"tv-1\";\n147:   const channelId = \"main\";\n148:   const version = 1;\n149:   const jobId = \"job-expired\";\n150:   const expired = new Date(Date.now() - 1000).toISOString();\n151:   const cameraClips = REQUIRED_CAMERA_IDS.map((cameraId) => ({\n152:     cameraId,\n153:     objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`,\n154:     sha256: createHash(\"sha256\").update(cameraId).digest(\"hex\"),\n155:     sizeBytes: 1,\n156:     durationMs: 2000,\n157:     expiresAt: expired,\n158:   }));\n159:   try {\n160:     await seedParty(db, partyId, deviceId, channelId);\n161:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({ partyId, channelId, version, schemaVersion: 1, jobId, expiresAt: expired, cameraClips });\n162:     const services = createDeliveryServices({ db, bucket, signReadUrl: async () => \"https://unused.invalid\" });\n163:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n164:       (error: unknown) => error instanceof BackendError && error.errorCode === \"CLIP_EXPIRED\");\n165:     const clipHashes = Object.fromEntries(cameraClips.map((clip) => [clip.cameraId, clip.sha256]));\n166:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes }),\n167:       (error: unknown) => error instanceof BackendError && error.errorCode === \"CLIP_EXPIRED\");\n168:   } finally {\n169:     await clearParty(db, bucket, partyId);\n170:     await disposeEmulatorContext(app);\n171:   }\n172: });\n173: \n174: test(\"accepted ACK retries its bounded version after partial purge, expiry, and publication advances\", {\n175:   skip: !HAS_FIRESTORE_EMULATOR,\n176: }, async () => {\n177:   const { app, db, bucket } = await createEmulatorContext();\n178:   const partyId = randomPartyId();\n179:   const deviceId = \"tv-ack-retry\";\n180:   const channelId = \"main\";\n181:   const version = 1;\n182:   const nextVersion = 2;\n183:   const jobId = \"job-ack-retry\";\n184:   const oldExpiry = \"2026-10-29T16:00:00.000Z\";\n185:   const now = { value: Date.parse(\"2026-10-29T15:00:00.000Z\") };\n186:   const clipsFor = (clipVersion: number, expiresAt: string) => REQUIRED_CAMERA_IDS.map((cameraId) => {\n187:     const bytes = Buffer.from(`${clipVersion}-${cameraId}`);\n188:     return {\n189:       cameraId,\n190:       objectPath: `parties/${partyId}/channels/${channelId}/delivery/${clipVersion}/${cameraId}.mp4`,\n191:       sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"),\n192:       sizeBytes: bytes.length,\n193:       durationMs: 2000,\n194:       expiresAt,\n195:       bytes,\n196:     };\n197:   });\n198:   const oldClips = clipsFor(version, oldExpiry);\n199:   const newClips = clipsFor(nextVersion, \"2026-11-29T16:00:00.000Z\");\n200:   let failedOnce = false;\n201:   const failingPath = oldClips[0].objectPath;\n202:   try {\n203:     await seedParty(db, partyId, deviceId, channelId);\n204:     await Promise.all(oldClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n205:     await Promise.all(newClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n206:     const currentRef = db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n207:     await currentRef.set({\n208:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: oldExpiry,\n209:       cameraClips: oldClips.map(({ bytes: _bytes, ...clip }) => clip),\n210:     });\n211:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({ jobId, partyId, deviceId, channelId, state: \"ready\" });\n212:     const services = createDeliveryServices({\n213:       db,\n214:       bucket,\n215:       now: () => new Date(now.value),\n216:       deleteDeliveryObject: async (file) => {\n217:         if (file.name === failingPath && !failedOnce) {\n218:           failedOnce = true;\n219:           throw new Error(\"injected partial purge failure\");\n220:         }\n221:         await file.delete({ ignoreNotFound: true });\n222:       },\n223:     });\n224:     const clipHashes = Object.fromEntries(oldClips.map((clip) => [clip.cameraId, clip.sha256]));\n225:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes }));\n226:     assert.equal((await bucket.file(failingPath).exists())[0], true);\n227:     assert.equal((await bucket.file(oldClips[1].objectPath).exists())[0], false);\n228:     const ackId = (await db.collection(`parties/${partyId}/deliveryAcks`).get()).docs[0]?.id;\n229:     assert.ok(ackId);\n230: \n231:     await currentRef.set({\n232:       partyId, channelId, version: nextVersion, schemaVersion: SCHEMA_VERSION, jobId: \"job-new-version\",\n233:       expiresAt: \"2026-11-29T16:00:00.000Z\",\n234:       cameraClips: newClips.map(({ bytes: _bytes, ...clip }) => clip),\n235:     });\n236:     now.value = Date.parse(\"2026-10-30T17:00:00.000Z\");\n237:     const conflictingHashes = { ...clipHashes, \"CAM-01\": \"f\".repeat(64) };\n238:     await assert.rejects(services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes: conflictingHashes }),\n239:       (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\");\n240: \n241:     const repeated = await services.acknowledgeDelivery({ partyId, deviceId, channelId, manifestVersion: version, clipHashes });\n242:     assert.equal(repeated.ackId, ackId);\n243:     for (const clip of oldClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], false);\n244:     for (const clip of newClips) assert.equal((await bucket.file(clip.objectPath).exists())[0], true);\n245:   } finally {\n246:     await clearParty(db, bucket, partyId);\n247:     await disposeEmulatorContext(app);\n248:   }\n249: });\n250: \n251: test(\"a manifest bound to withdrawn consent yields no delivery URLs even while it lingers\", {\n252:   skip: !HAS_FIRESTORE_EMULATOR,\n253: }, async () => {\n254:   const { app, db, bucket } = await createEmulatorContext();\n255:   const partyId = randomPartyId();\n256:   const deviceId = \"tv-1\";\n257:   const channelId = \"main\";\n258:   const version = 1;\n259:   const jobId = \"job-revoked-consent\";\n260:   const submissionId = \"gsub-revoked000000000000000001\";\n261:   const expiry = new Date(Date.now() + 60 * 60 * 1000).toISOString();\n262:   const cameraClips = REQUIRED_CAMERA_IDS.map((cameraId) => {\n263:     const bytes = Buffer.from(`revoked-${cameraId}`);\n264:     return { cameraId, objectPath: `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`, sha256: createHash(\"sha256\").update(bytes).digest(\"hex\"), sizeBytes: bytes.length, durationMs: 2000, expiresAt: expiry, bytes };\n265:   });\n266:   try {\n267:     await seedParty(db, partyId, deviceId, channelId);\n268:     await Promise.all(cameraClips.map(({ objectPath, bytes }) => bucket.file(objectPath).save(bytes)));\n269:     // Guest-bound job whose consent was withdrawn after publication; the\n270:     // manifest document itself has not been collected yet.\n271:     await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n272:       jobId, partyId, deviceId, channelId, manifestVersion: version, idempotencyKey: jobId, state: \"failed\",\n273:       guestMedia: { submissionId, objectPath: `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`, sourceHash: \"a\".repeat(64), consentRevision: \"v1:revoked\", deviceId, channelId },\n274:     });\n275:     await db.doc(`parties/${partyId}/guestMedia/${submissionId}`).set({\n276:       submissionId, partyId, deviceId, channelId, status: \"withdrawn\", tombstone: true,\n277:       consentRevision: \"v1:revoked\", objectPath: `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`,\n278:     });\n279:     await db.doc(`parties/${partyId}/manifests/current_${channelId}`).set({\n280:       partyId, channelId, version, schemaVersion: SCHEMA_VERSION, jobId, expiresAt: expiry,\n281:       createdAt: FieldValue.serverTimestamp(),\n282:       cameraClips: cameraClips.map(({ bytes: _bytes, ...clip }) => clip),\n283:     });\n284:     const services = createDeliveryServices({ db, bucket, signReadUrl: async () => \"https://unused.invalid\" });\n285:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n286:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n287:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n288:       (error: unknown) => error instanceof BackendError && error.errorCode === \"FORBIDDEN\");\n289:     // Control: the same manifest shape without a guest binding still serves.\n290:     await db.doc(`parties/${partyId}/jobs/${jobId}`).update({ guestMedia: FieldValue.delete() });\n291:     const delivery = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n292:     assert.equal(delivery.manifestVersion, version);\n293:     assert.equal(delivery.clips.length, 4);\n294:   } finally {\n295:     await clearParty(db, bucket, partyId);\n296:     await disposeEmulatorContext(app);\n297:   }\n298: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c34e2873c183c425fdbd3c2ea9"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/delivery.test.ts\"}"},"time":{"start":1793463635475,"end":1793463636093}}}}
