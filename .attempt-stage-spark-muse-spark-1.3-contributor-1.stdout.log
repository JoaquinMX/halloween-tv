{"type":"tool_use","timestamp":1793463633472,"sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","part":{"partID":"prt_192c343c0001EVPTUP8gkBgx3E","sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","messageID":"msg_192c33aae001TfheM1vjFS4J9O","type":"tool","id":"call_01a192c343ee747fb34ea3d6d6f26d03","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/host_join.test.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/host_join.test.ts, lines 1-154\n1: import assert from \"node:assert/strict\";\n2: import test from \"node:test\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import { Timestamp } from \"firebase-admin/firestore\";\n6: import { BackendError } from \"../src/contracts\";\n7: import { createHostJoinService, hashHostInviteToken } from \"../src/host_join\";\n8: import { createJoinPartyService } from \"../src/join_party\";\n9: import {\n10:   HAS_FIRESTORE_EMULATOR,\n11:   clearParty,\n12:   createEmulatorContext,\n13:   disposeEmulatorContext,\n14:   randomPartyId,\n15:   seedParty,\n16: } from \"./support/emulators\";\n17: \n18: async function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\n19:   await seedParty(db, partyId, deviceId, channelId);\n20:   await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \"tv\" });\n21: }\n22: \n23: test(\"join_roles fixture matches the enforced guest/host role boundary\", async () => {\n24:   const content = await readFile(resolve(__dirname, \"../../../test/fixtures/join_roles_v1.json\"), \"utf8\");\n25:   const roles = JSON.parse(content) as {\n26:     callables: string[];\n27:     guestJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\n28:     hostJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\n29:   };\n30:   assert.deepEqual(roles.callables, [\"createHostInvite\", \"joinHost\", \"listHostVideos\", \"generateHostVideo\", \"getHostVideoPreview\", \"deleteHostVideo\"]);\n31:   // The guest route and the host route produce disjoint server-assigned roles.\n32:   assert.equal(roles.guestJoin.response.role, \"guest\");\n33:   assert.equal(roles.hostJoin.response.role, \"host\");\n34:   assert.notEqual(roles.guestJoin.response.role, roles.hostJoin.response.role);\n35:   // The guest fixture carries a six-digit PIN (redeemed via joinParty); the\n36:   // host fixture carries a server-minted capability (never a PIN shape).\n37:   assert.match(String((roles.guestJoin.request as Record<string, unknown>).joinPin), /^[0-9]{6}$/);\n38:   assert.ok(String((roles.hostJoin.request as Record<string, unknown>).inviteToken).length > 0);\n39:   // A host token is never a bare guest PIN: PIN-shaped strings are rejected\n40:   // as invite tokens by the parser (covered behaviorally above).\n41:   assert.ok(!/^[0-9]{6}$/.test(String((roles.hostJoin.request as Record<string, unknown>).inviteToken)));\n42: });\n43: \n44: test(\"only a registered TV may mint a host invite; invites bind party/channel/expiry\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n45:   const { app, db, bucket } = await createEmulatorContext();\n46:   const partyId = randomPartyId();\n47:   try {\n48:     await seedTv(db, partyId, \"tv-1\", \"main\");\n49:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n50:     const services = createHostJoinService({ db });\n51:     const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n52:     assert.equal(invite.partyId, partyId);\n53:     assert.equal(invite.channelId, \"main\");\n54:     assert.ok(invite.inviteToken.startsWith(\"hi-\"));\n55:     assert.ok(Date.parse(invite.expiresAt) > Date.now());\n56:     // Only the token hash is stored, bound to party/channel/expiry.\n57:     const tokenHash = hashHostInviteToken(invite.inviteToken);\n58:     const stored = (await db.doc(`parties/${partyId}/hostInvites/${tokenHash.slice(0, 32)}`).get()).data()!;\n59:     assert.equal(stored.tokenHash, tokenHash);\n60:     assert.equal(stored.partyId, partyId);\n61:     assert.equal(stored.channelId, \"main\");\n62:     assert.equal(stored.status, \"pending\");\n63:     assert.ok(!(\"inviteToken\" in stored) && !JSON.stringify(stored).includes(invite.inviteToken));\n64:     // Guests, unknown devices, and wrong channels cannot mint invites.\n65:     await assert.rejects(services.createHostInvite({ partyId, deviceId: \"p-guest-1\", channelId: \"main\" }),\n66:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n67:     await assert.rejects(services.createHostInvite({ partyId, deviceId: \"nope\", channelId: \"main\" }),\n68:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n69:     await assert.rejects(services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"other\" }),\n70:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n71:   } finally {\n72:     await clearParty(db, bucket, partyId);\n73:     await disposeEmulatorContext(app);\n74:   }\n75: });\n76: \n77: test(\"host redemption is transactional: idempotent retry, replay/expiry/PIN/role forgery denied\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n78:   const { app, db } = await createEmulatorContext();\n79:   const partyId = randomPartyId();\n80:   try {\n81:     await seedTv(db, partyId, \"tv-1\", \"main\");\n82:     const services = createHostJoinService({ db });\n83:     const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n84: \n85:     const joined = await services.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n86:     assert.deepEqual(joined, { partyId, deviceId: \"p-host-1\", channelId: \"main\", role: \"host\", status: \"active\", created: