{"type":"tool_use","timestamp":1793462336858,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192af4eb10017PoIbv5FnRJsii","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192af497000135l0pgIniICArp","type":"tool","id":"call_01a192af4e6375ea81aec16e6a2a4fb7","tool":"write","state":{"status":"completed","input":{"content":"/// Host invite QR data (TV settings panel, separately labelled HOST QR).\n///\n/// The TV mints a short-lived host invite through the host-only\n/// `createHostInvite` callable and presents it as exactly one QR encoding\n/// the scoped invite capability. The companion redeems it on its dedicated\n/// host entry screen (Scan Host QR + an explicit Join-as-guest route), so\n/// host administration is never reachable through the guest PIN or a\n/// client-supplied role string.\n///\n/// Host QR JSON (TV display, companion parse) contains exactly `partyId` +\n/// `channelId` + `inviteToken` + `role` (`'host'`). It never carries a\n/// deviceId (in particular never the TV device identity), URL, or secret.\n/// Role examples live in `test/fixtures/join_roles_v1.json`.\nlibrary;\n\nimport 'dart:convert';\n\nimport 'package:cloud_functions/cloud_functions.dart';\n\n/// True when [value] looks like a server-minted host invite token.\n///\n/// Tokens are non-empty and never six ASCII digits: a guest PIN presented\n/// where a token belongs is shape-rejected before it can cross the wire.\nbool isValidHostInviteToken(String value) =>\n    value.isNotEmpty && !RegExp(r'^[0-9]{6}$').hasMatch(value);\n\n/// Builds the host invite QR payload as a JSON object.\n///\n/// Contains exactly `partyId` + `channelId` + `inviteToken` + `role`\n/// (`'host'`). Never includes a deviceId. Throws [ArgumentError] when\n/// [inviteToken] is not a plausible server-minted token (see\n/// [isValidHostInviteToken]).\nString buildHostJoinPayload({\n  required String partyId,\n  required String channelId,\n  required String inviteToken,\n}) {\n  if (!isValidHostInviteToken(inviteToken)) {\n    throw ArgumentError.value(\n      inviteToken,\n      'inviteToken',\n      'must be a server-minted host invite token',\n    );\n  }\n  return jsonEncode(<String, String>{\n    'partyId': partyId,\n    'channelId': channelId,\n    'inviteToken': inviteToken,\n    'role': 'host',\n  });\n}\n\n/// Failure minting or validating a host invite.\nfinal class HostInviteException implements Exception {\n  /// Creates a host-invite failure.\n  const HostInviteException(this.message);\n\n  /// Human-readable reason shown on the TV panel.\n  final String message;\n\n  @override\n  String toString() => 'HostInviteException: $message';\n}\n\n/// A server-minted, short-lived host invite for this party + channel.\nfinal class HostInvite {\n  /// Creates an invite.\n  const HostInvite({\n    required this.partyId,\n    required this.channelId,\n    required this.inviteToken,\n    required this.expiresAt,\n  });\n\n  /// Party the invite is bound to.\n  final String partyId;\n\n  /// Channel the invite is bound to.\n  final String channelId;\n\n  /// Opaque invite capability (presented once as the QR payload).\n  final String inviteToken;\n\n  /// Server-stated expiry; the panel stops presenting the QR past it.\n  final DateTime expiresAt;\n\n  /// True when [now] is at or past [expiresAt].\n  bool isExpired(DateTime now) => !now.isBefore(expiresAt);\n\n  /// Validates a raw `createHostInvite` response against the requesting\n  /// client's scope. Throws [HostInviteException] on any malformed field.\n  factory HostInvite.fromResponse(\n    Map<String, Object?> data, {\n    required String expectedPartyId,\n    required String expectedChannelId,\n  }) {\n    final Object? partyId = data['partyId'];\n    final Object? channelId = data['channelId'];\n    final Object? inviteToken = data['inviteToken'];\n    final Object? expiresAt = data['expiresAt'];\n    if (partyId is! String || partyId.isEmpty) {\n      throw const HostInviteException('Host invite response has no party.');\n    }\n    if (channelId is! String || channelId.isEmpty) {\n      throw const HostInviteException('Host invite response has no channel.');\n    }\n    if (inviteToken is! String || !isValidHostInviteToken(inviteToken)) {\n      throw const HostInviteException('Host invite token is malformed.');\n    }\n    if (partyId != expectedPartyId) {\n      throw const HostInviteException('Host invite party mismatch.');\n    }\n    if (channelId != expectedChannelId) {\n      throw const HostInviteException('Host invite channel mismatch.');\n    }\n    DateTime? expiry;\n    if (expiresAt is String) {\n      expiry = DateTime.tryParse(expiresAt);\n    }\n    if (expiry == null) {\n      throw const HostInviteException('Host invite expiry is malformed.');\n    }\n    return HostInvite(\n      partyId: partyId,\n      channelId: channelId,\n      inviteToken: inviteToken,\n      expiresAt: expiry,\n    );\n  }\n}\n\n/// Reads the host-only `createHostInvite` callable (TV device only).\nfinal class HostInviteClient {\n  /// Creates a client over an invoker seam.\n  const HostInviteClient({\n    required this.invoker,\n    required this.partyId,\n    required this.deviceId,\n    required this.channelId,\n  });\n\n  /// Builds a client over real Cloud Functions.\n  factory HostInviteClient.cloudFunctions({\n    required FirebaseFunctions functions,\n    required String partyId,\n    required String deviceId,\n    required String channelId,\n  }) => HostInviteClient(\n    invoker: (String name, Map<String, Object?> payload) async {\n      final HttpsCallableResult<Object?> result = await functions\n          .httpsCallable(name)\n          .call(payload);\n      final Object? data = result.data;\n      if (data is! Map) {\n        throw const HostInviteException(\n          'Host invite response was not an object.',\n        );\n      }\n      return Map<String, Object?>.from(data);\n    },\n    partyId: partyId,\n    deviceId: deviceId,\n    channelId: channelId,\n  );\n\n  /// Invoker seam (Cloud Functions in production, fake in tests).\n  final CallableInvoker invoker;\n\n  /// Party the TV belongs to.\n  final String partyId;\n\n  /// TV's own device code (the authorized host-invite minter).\n  ///\n  /// Authorization travels in the request only; the session QR never\n  /// carries it.\n  final String deviceId;\n\n  /// Active channel.\n  final String channelId;\n\n  /// Mints a validated host invite bound to this party + channel.\n  ///\n  /// Throws [HostInviteException] when the response is malformed.\n  /// Authorization failures surface as the caller's error.\n  Future<HostInvite> createInvite() async {\n    final Map<String, Object?> data = await invoker('createHostInvite', <\n      String,\n      Object?\n    >{\n      'partyId': partyId,\n      'deviceId': deviceId,\n      'channelId': channelId,\n    });\n    return HostInvite.fromResponse(\n      data,\n      expectedPartyId: partyId,\n      expectedChannelId: channelId,\n    );\n  }\n}\n\n/// Callable invoker seam shared with the guest-code client shape.\n///\n/// Kept local (rather than importing the guest-code typedef) so the host\n/// route stays greppable as its own capability boundary.\ntypedef CallableInvoker =\n    Future<Map<String, Object?>> Function(\n      String name,\n      Map<String, Object?> payload,\n    );\n","path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/host_codes.dart"},"output":"Created file successfully: apps/tv_app/lib/src/wall/host_codes.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/tv_app/lib/src/wall/host_codes.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192af4e6375ea81aec16e6a2a4fb7"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Host invite QR data (TV settings panel, separately labelled HOST QR).\\n///\\n/// The TV mints a short-lived host invite through the host-only\\n/// `createHostInvite` callable and presents it as exactly one QR encoding\\n/// the scoped invite capability. The companion redeems it on its dedicated\\n/// host entry screen (Scan Host QR + an explicit Join-as-guest route), so\\n/// host administration is never reachable through the guest PIN or a\\n/// client-supplied role string.\\n///\\n/// Host QR JSON (TV display, companion parse) contains exactly `partyId` +\\n/// `channelId` + `inviteToken` + `role` (`'host'`). It never carries a\\n/// deviceId (in particular never the TV device identity), URL, or secret.\\n/// Role examples live in `test/fixtures/join_roles_v1.json`.\\nlibrary;\\n\\nimport 'dart:convert';\\n\\nimport 'package:cloud_functions/cloud_functions.dart';\\n\\n/// True when [value] looks like a server-minted host invite token.\\n///\\n/// Tokens are non-empty and never six ASCII digits: a guest PIN presented\\n/// where a token belongs is shape-rejected before it can cross the wire.\\nbool isValidHostInviteToken(String value) =>\\n    value.isNotEmpty && !RegExp(r'^[0-9]{6}$').hasMatch(value);\\n\\n/// Builds the host invite QR payload as a JSON object.\\n///\\n/// Contains exactly `partyId` + `channelId` + `inviteToken` + `role`\\n/// (`'host'`). Never includes a deviceId. Throws [ArgumentError] when\\n/// [inviteToken] is not a plausible server-minted token (see\\n/// [isValidHostInviteToken]).\\nString buildHostJoinPayload({\\n  required String partyId,\\n  required String channelId,\\n  required String inviteToken,\\n}) {\\n  if (!isValidHostInviteToken(inviteToken)) {\\n    throw ArgumentError.value(\\n      inviteToken,\\n      'inviteToken',\\n      'must be a server-minted host invite token',\\n    );\\n  }\\n  return jsonEncode(<String, String>{\\n    'partyId': partyId,\\n    'channelId': channelId,\\n    'inviteToken': inviteToken,\\n    'role': 'host',\\n  });\\n}\\n\\n/// Failure minting or validating a host invite.\\nfinal class HostInviteException implements Exception {\\n  /// Creates a host-invite failure.\\n  const HostInviteException(this.message);\\n\\n  /// Human-readable reason shown on the TV panel.\\n  final String message;\\n\\n  @override\\n  String toString() => 'HostInviteException: $message';\\n}\\n\\n/// A server-minted, short-lived host invite for this party + channel.\\nfinal class HostInvite {\\n  /// Creates an invite.\\n  const HostInvite({\\n    required this.partyId,\\n    required this.channelId,\\n    required this.inviteToken,\\n    required this.expiresAt,\\n  });\\n\\n  /// Party the invite is bound to.\\n  final String partyId;\\n\\n  /// Channel the invite is bound to.\\n  final String channelId;\\n\\n  /// Opaque invite capability (presented once as the QR payload).\\n  final String inviteToken;\\n\\n  /// Server-stated expiry; the panel stops presenting the QR past it.\\n  final DateTime expiresAt;\\n\\n  /// True when [now] is at or past [expiresAt].\\n  bool isExpired(DateTime now) => !now.isBefore(expiresAt);\\n\\n  /// Validates a raw `createHostInvite` response against the requesting\\n  /// client's scope. Throws [HostInviteException] on any malformed field.\\n  factory HostInvite.fromResponse(\\n    Map<String, Object?> data, {\\n    required String expectedPartyId,\\n    required String expectedChannelId,\\n  }) {\\n    final Object? partyId = data['partyId'];\\n    final Object? channelId = data['channelId'];\\n    final Object? inviteToken = data['inviteToken'];\\n    final Object? expiresAt = data['expiresAt'];\\n    if (partyId is! String || partyId.isEmpty) {\\n      throw const HostInviteException('Host invite response has no party.');\\n    }\\n    if (channelId is! String || channelId.isEmpty) {\\n      throw const HostInviteException('Host invite response has no channel.');\\n    }\\n    if (inviteToken is! String || !isValidHostInviteToken(inviteToken)) {\\n      throw const HostInviteException('Host invite token is malformed.');\\n    }\\n    if (partyId != expectedPartyId) {\\n      throw const HostInviteException('Host invite party mismatch.');\\n    }\\n    if (channelId != expectedChannelId) {\\n      throw const HostInviteException('Host invite channel mismatch.');\\n    }\\n    DateTime? expiry;\\n    if (expiresAt is String) {\\n      expiry = DateTime.tryParse(expiresAt);\\n    }\\n    if (expiry == null) {\\n      throw const HostInviteException('Host invite expiry is malformed.');\\n    }\\n    return HostInvite(\\n      partyId: partyId,\\n      channelId: channelId,\\n      inviteToken: inviteToken,\\n      expiresAt: expiry,\\n    );\\n  }\\n}\\n\\n/// Reads the host-only `createHostInvite` callable (TV device only).\\nfinal class HostInviteClient {\\n  /// Creates a client over an invoker seam.\\n  const HostInviteClient({\\n    required this.invoker,\\n    required this.partyId,\\n    required this.deviceId,\\n    required this.channelId,\\n  });\\n\\n  /// Builds a client over real Cloud Functions.\\n  factory HostInviteClient.cloudFunctions({\\n    required FirebaseFunctions functions,\\n    required String partyId,\\n    required String deviceId,\\n    required String channelId,\\n  }) => HostInviteClient(\\n    invoker: (String name, Map<String, Object?> payload) async {\\n      final HttpsCallableResult<Object?> result = await functions\\n          .httpsCallable(name)\\n          .call(payload);\\n      final Object? data = result.data;\\n      if (data is! Map) {\\n        throw const HostInviteException(\\n          'Host invite response was not an object.',\\n        );\\n      }\\n      return Map<String, Object?>.from(data);\\n    },\\n    partyId: partyId,\\n    deviceId: deviceId,\\n    channelId: channelId,\\n  );\\n\\n  /// Invoker seam (Cloud Functions in production, fake in tests).\\n  final CallableInvoker invoker;\\n\\n  /// Party the TV belongs to.\\n  final String partyId;\\n\\n  /// TV's own device code (the authorized host-invite minter).\\n  ///\\n  /// Authorization travels in the request only; the session QR never\\n  /// carries it.\\n  final String deviceId;\\n\\n  /// Active channel.\\n  final String channelId;\\n\\n  /// Mints a validated host invite bound to this party + channel.\\n  ///\\n  /// Throws [HostInviteException] when the response is malformed.\\n  /// Authorization failures surface as the caller's error.\\n  Future<HostInvite> createInvite() async {\\n    final Map<String, Object?> data = await invoker('createHostInvite', <\\n      String,\\n      Object?\\n    >{\\n      'partyId': partyId,\\n      'deviceId': deviceId,\\n      'channelId': channelId,\\n    });\\n    return HostInvite.fromResponse(\\n      data,\\n      expectedPartyId: partyId,\\n      expectedChannelId: channelId,\\n    );\\n  }\\n}\\n\\n/// Callable invoker seam shared with the guest-code client shape.\\n///\\n/// Kept local (rather than importing the guest-code typedef) so the host\\n/// route stays greppable as its own capability boundary.\\ntypedef CallableInvoker =\\n    Future<Map<String, Object?>> Function(\\n      String name,\\n      Map<String, Object?> payload,\\n    );\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/host_codes.dart\"}"},"time":{"start":1793462324913,"end":1793462336858}}}}
