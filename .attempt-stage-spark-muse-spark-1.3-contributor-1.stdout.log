_replacing = false;\n47:   bool _focused = false;\n48:   String? _error;\n49: \n50:   @override\n51:   void initState() {\n52:     super.initState();\n53:     _activeSource = widget.source;\n54:     final TileVideoController controller = _create(widget.source);\n55:     _controller = controller;\n56:     controller.addListener(_onControllerUpdate);\n57:     unawaited(_start(controller, _generation));\n58:     if (widget.autofocus) {\n59:       WidgetsBinding.instance.addPostFrameCallback((_) {\n60:         if (mounted && widget.focusNode.context != null) {\n61:           widget.focusNode.requestFocus();\n62:         }\n63:       });\n64:     }\n65:   }\n66: \n67:   @override\n68:   void didUpdateWidget(CameraTile oldWidget) {\n69:     super.didUpdateWidget(oldWidget);\n70:     if (widget.source != _activeSource) {\n71:       unawaited(_replaceSource(widget.source));\n72:     }\n73:   }\n74: \n75:   TileVideoController _create(TileMediaSource source) =>\n76:       widget.controllerFactory(cameraId: widget.cameraId, source: source);\n77: \n78:   Future<void> _replaceSource(TileMediaSource target) async {\n79:     final int generation = ++_generation;\n80:     final TileMediaSource previous = _activeSource;\n81:     final TileVideoController? old = _controller;\n82:     _controller = null;\n83:     if (mounted) {\n84:       setState(() {\n85:         _initialized = false;\n86:         _failed = false;\n87:         _replacing = true;\n88:         _error = null;\n89:       });\n90:     }\n91:     await _disposeController(old);\n92:     if (!mounted || generation != _generation) return;\n93: \n94:     final TileVideoController replacement = _create(target);\n95:     _controller = replacement;\n96:     replacement.addListener(_onControllerUpdate);\n97:     if (await _configure(replacement, generation)) {\n98:       if (!mounted || generation != _generation) return;\n99:       _activeSource = target;\n100:       setState(() {\n101:         _initialized = true;\n102:         _failed = false;\n103:         _replacing = false;\n104:       });\n105:       widget.onSourceSettled?.call(true);\n106:       return;\n107:     }\n108: \n109:     if (!mounted || generation != _generation) return;\n110:     final TileVideoController? failed = _controller;\n111:     _controller = null;\n112:     await _disposeController(failed);\n113:     if (!mounted || generation != _generation) return;\n114: \n115:     // One tile at a time is replaced, and the old source is recreated if the\n116:     // new decoder fails. This stays within four decoders and keeps the other\n117:     // wall slots running while this slot rolls back.\n118:     final TileVideoController rollback = _create(previous);\n119:     _controller = rollback;\n120:     rollback.addListener(_onControllerUpdate);\n121:     final bool restored = await _configure(rollback, generation);\n122:     if (!mounted || generation != _generation) return;\n123:     setState(() {\n124:       _activeSource = previous;\n125:       _initialized = restored;\n126:       _failed = !restored;\n127:       _replacing = false;\n128:       _error = restored ? null : 'replacement and rollback failed';\n129:     });\n130:     widget.onSourceSettled?.call(false);\n131:   }\n132: \n133:   Future<bool> _configure(\n134:     TileVideoController controller,\n135:     int generation,\n136:   ) async {\n137:     try {\n138:       await controller.initialize();\n139:       if (!mounted || generation != _generation) return false;\n140:       await controller.setLooping(true);\n141:       await controller.setVolume(0);\n142:       await controller.play();\n143:       return mounted && generation == _generation && !controller.hasError;\n144:     } on Object catch (error) {\n145:       if (mounted && generation == _generation) _error = error.toString();\n146:       return false;\n147:     }\n148:   }\n149: \n150:   Future<void> _start(TileVideoController controller, int generation) async {\n151:     final bool success = await _co