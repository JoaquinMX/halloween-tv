unawaited(\n708:         settings.setString(\n709:           partyId: PartyId(widget.partyId),\n710:           key: CctvWallSettingsKeys.cameraCount,\n711:           value: '$count',\n712:         ),\n713:       );\n714:     }\n715:   }\n716: \n717:   /// Toggles the decoder-preserving camera hero for the focused tile.\n718:   ///\n719:   /// Opening animates the selected EXISTING tile to the viewport rectangle\n720:   /// and fades its siblings; every CameraTile stays mounted, so no decoder\n721:   /// is created or disposed during the zoom.\n722:   void _toggleHero() {\n723:     if (_heroCameraId != null) {\n724:       _closeHero();\n725:       return;\n726:     }\n727:     final List<String> active = _activeCameraIds();\n728:     if (active.isEmpty) {\n729:       return;\n730:     }\n731:     int index = _focus.focusedIndex;\n732:     if (index < 0 || index >= active.length) {\n733:       index = 0;\n734:     }\n735:     setState(() {\n736:       _heroCameraId = active[index];\n737:       _heroOriginIndex = index;\n738:     });\n739:   }\n740: \n741:   /// Exits the hero and restores the originating focus.\n742:   void _closeHero() {\n743:     if (_heroCameraId == null) {\n744:       return;\n745:     }\n746:     final int origin = _heroOriginIndex;\n747:     setState(() {\n748:       _heroCameraId = null;\n749:     });\n750:     // Restore the ORIGIN explicitly (not just \"current focus\"): nothing\n751:     // traverses in hero, but this guards against any stale focus index.\n752:     _focus.markFocused(origin);\n753:     _restoreTileFocus();\n754:   }\n755: \n756:   Future<void> _retryCached() async {\n757:     final Future<VerifiedWallPlayback?> Function()? retryPlayback =\n758:         widget.onRetryCachedPlayback;\n759:     // A count change or newer activation supersedes this retry: its failure\n760:     // UI must not clobber the newer wall state.\n761:     final int generation = _wallGeneration;\n762:     if (retryPlayback != null) {\n763:       Verified