nment('HOST_INVITE_PAYLOAD');\n27: \n28: void main() {\n29:   IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n30: \n31:   testWidgets('emulator: Host QR joins and loads scoped administration', (\n32:     tester,\n33:   ) async {\n34:     if (_hostInvitePayload.isEmpty) {\n35:       // ignore: avoid_print\n36:       print(\n37:         'SKIP host admin: supply HOST_INVITE_PAYLOAD (fresh Host QR JSON).',\n38:       );\n39:       return;\n40:     }\n41:     SharedPreferences.setMockInitialValues(<String, Object>{\n42:       DeviceIdentityStore.hostStorageKey: 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb',\n43:     });\n44:     await tester.pumpWidget(const CompanionApp());\n45:     for (int i = 0; i < 12; i++) {\n46:       await tester.pump(const Duration(milliseconds: 250));\n47:     }\n48:     expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\n49:     await tester.enterText(\n50:       find.byKey(HostEntryScreen.payloadFieldKey),\n51:       _hostInvitePayload,\n52:     );\n53:     await tester.ensureVisible(find.byKey(HostEntryScreen.submitKey));\n54:     await tester.tap(find.byKey(HostEntryScreen.submitKey));\n55:     for (int i = 0; i < 20; i++) {\n56:       await tester.pump(const Duration(milliseconds: 250));\n57:     }\n58:     expect(find.byKey(HostPanelScreen.listKey), findsOneWidget);\n59:     expect(tester.takeException(), isNull);\n60:   });\n61: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/host_admin_emulator_test.dart, lines 1-61\n1: // Emulator-backed host administration smoke test.\n2: //\n3: // Run from apps/companion_app after starting the Firebase emulators and\n4: // supplying HOST_INVITE_PAYLOAD (a fresh Host QR JSON from createHostInvite):\n5: //\n6: //   flutter test integration_test/host_admin_emulator_test.dart \\\n7: //     --dart-define=HOST_INVITE_PAYLOAD='{\"partyId\":\"...\",...}' \\\n8: //     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n9: //     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n10: //     --dart-define=COMPANION_FIREBASE_PROJECT_ID=demo-halloween-tv \\\n11: //     --dart-define=COMPANION_USE_EMULATOR=true\n12: //\n13: // The one-use invite is deliberately provisioned out of band (the companion\n14: // cannot mint host invitations). This drives real parsing, identity binding,\n15: // joinHost response validation, and the scoped seed-list callable.\n16: library;\n17: \n18: import 'package:companion_app/src/companion_app.dart';\n19: import 'package:companion_app/src/join/device_identity_store.dart';\n20: import 'package:companion_app/src/ui/host_entry_screen.dart';\n21: import 'package:companion_app/src/ui/host_panel_screen.dart';\n22: import 'package:flutter_test/flutter_test.dart';\n23: import 'package:integration_test/integration_test.dart';\n24: import 'package:shared_preferences/shared_preferences.dart';\n25: \n26: const String _hostInvitePayload = String.fromEnvironment('HOST_INVITE_PAYLOAD');\n27: \n28: void main() {\n29:   IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n30: \n31:   testWidgets('emulator: Host QR joins and loads scoped administration', (\n32:     tester,\n33:   ) async {\n34:     if (_hostInvitePayload.isEmpty) {\n35:       // ignore: avoid_print\n36:       print(\n37:         'SKIP host admin: supply HOST_INVITE_PAYLOAD (fresh Host QR JSON).',\n38:       );\n39:       return;\n40:     }\n41:     SharedPreferences.setMockInitialValues(<String, Object>{\n42:       DeviceIdentityStore.hostStorageKey: 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb',\n43:     });\n44:     await tester.pumpWidget(const CompanionApp());\n45:     for (int i = 0; i < 12; i++) {\n46:       await tester.pump(const Duration(milliseconds: 250));\n47:     }\n48:     expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\n49:     await tester.enterText(\n50:       find.byKey(HostEntryScreen.payloadFieldKey),\n51:      