{"type":"step_start","timestamp":1793461055602,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"id":"prt_1929bf0720018Ya1UcG0uZRpgS","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929bea3d001BvwnRdb57PXpR6","type":"step-start","snapshot":"e1dac75c20bbbf39e0f70fc365e6773c2d769632"}}
{"type":"tool_use","timestamp":1793461066298,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929c0294001rMqPNLtJt1ZaLu","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929bea3d001BvwnRdb57PXpR6","type":"tool","id":"call_01a1929c0298769a946ee714093571e4","tool":"write","state":{"status":"completed","input":{"content":"import { Bucket, File } from \"@google-cloud/storage\";\nimport { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\nimport {\n  BackendError,\n  DeleteHostVideoResult,\n  GenerateHostVideoResult,\n  GetHostVideoPreviewResult,\n  HostSeedEntry,\n  HostSeedStatus,\n  parseDeleteHostVideoInput,\n  parseGenerateHostVideoInput,\n  parseGetHostVideoPreviewInput,\n  parseListHostVideosInput,\n} from \"./contracts\";\nimport {\n  DELIVERY_URL_TTL_SECONDS,\n  HOST_PREVIEW_TTL_MS,\n  REQUIRED_CAMERA_IDS,\n  hostPreviewObjectPath,\n} from \"./config\";\nimport { assertRegisteredHostDevice } from \"./auth\";\nimport { FirestoreGenerationStore } from \"./generation_store\";\n\nexport interface HostMediaServiceOptions {\n  db: Firestore;\n  bucket: Bucket;\n  now?: () => Date;\n  signPreviewUrl?: (file: File, expiresAt: Date) => Promise<string>;\n  deleteObject?: (file: File) => Promise<void>;\n}\n\n/**\n * Server-backed seed catalog (cycle-12 host administration).\n *\n * Catalog entries live at `parties/{partyId}/seedVideos/{seedId}` and carry\n * generation status plus the camera video references. Deletion granularity:\n * `deleteHostVideo` removes selected seed entries and their associated\n * preview + delivery objects, revokes an affected current manifest whose\n * jobId matches a deleted seed, and preserves accounting records (costLogs\n * / usage ledger rows are never deleted). Expiry: each seed carries\n * `expiresAt` (creation + HOST_PREVIEW_TTL_MS); the retention sweep expires\n * due seeds and deletes their preview objects, while live seeds protect\n * their preview paths from the orphan pass. Direct client access remains\n * denied: callable-only Firestore docs (catch-all deny in firestore.rules)\n * and callable-only Storage objects (catch-all deny in storage.rules);\n * preview URLs are signed on demand and never persisted.\n *\n * Previews are separately referenced (`hostPreviews/{seedId}/…`) from\n * delivery objects (`channels/{channel}/delivery/…`) and are materialized\n * before delivery objects can be ACK-purged (eagerly after the job is\n * ready, retried lazily on list/preview reads), so an ACK purge of delivery\n * bytes never removes preview bytes.\n */\nexport function jobIdForHostSeed(seedId: string): string {\n  return `hv-${seedId}`;\n}\n\nfunction seedIdForHostJob(jobId: string): string | undefined {\n  return jobId.startsWith(\"hv-\") ? jobId.slice(\"hv-\".length) : undefined;\n}\n\nfunction seedRef(db: Firestore, partyId: string, seedId: string) {\n  return db.doc(`parties/${partyId}/seedVideos/${seedId}`);\n}\n\nfunction jobRef(db: Firestore, partyId: string, jobId: string) {\n  return db.doc(`parties/${partyId}/jobs/${jobId}`);\n}\n\nexport function createHostMediaService(options: HostMediaServiceOptions): {\n  listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }>;\n  generateHostVideo(value: unknown): Promise<GenerateHostVideoResult>;\n  getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult>;\n  deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult>;\n} {\n  const { db, bucket } = options;\n  const now = options.now ?? (() => new Date());\n  const signPreviewUrl =\n    options.signPreviewUrl ??\n    (async (file, expiresAt) => {\n      const [url] = await file.getSignedUrl({ action: \"read\", expires: expiresAt, version: \"v4\" });\n      return url;\n    });\n  const deleteObject =\n    options.deleteObject ??\n    (async (file) => {\n      await file.delete({ ignoreNotFound: true });\n    });\n  const store = new FirestoreGenerationStore({ db, bucket, now });\n\n  function exposedIso(value: unknown): string {\n    if (value instanceof Timestamp) return value.toDate().toISOString();\n    if (value instanceof Date) return value.toISOString();\n    if (typeof value === \"string\") return value;\n    return now().toISOString();\n  }\n\n  async function syncSeedStatus(\n    partyId: string,\n    seedSnap: FirebaseFirestore.DocumentSnapshot,\n  ): Promise<FirebaseFirestore.DocumentData | undefined> {\n    const seed = seedSnap.data();\n    if (!seed || seed.status === \"deleted\") return seed ?? undefined;\n    try {\n      const jobSnap = await jobRef(db, partyId, String(seed.jobId)).get();\n      if (!jobSnap.exists) return seed;\n      const job = jobSnap.data()!;\n      const state = String(job.state);\n      const next: HostSeedStatus | undefined =\n        state === \"ready\" || state === \"delivering\" || state === \"purged\"\n          ? \"ready\"\n          : state === \"failed\" || state === \"expired\"\n            ? \"failed\"\n            : state === \"running\"\n              ? \"running\"\n              : undefined;\n      if (next && next !== seed.status) {\n        await seedSnap.ref.update({ status: next, updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n        return { ...seed, status: next };\n      }\n      return seed;\n    } catch {\n      return seed;\n    }\n  }\n\n  /** Copies delivery bytes to separately referenced preview objects (idempotent). */\n  async function ensurePreviewCopies(\n    partyId: string,\n    seedId: string,\n    clips: Array<{ cameraId: string; objectPath: string; sha256: string }>,\n    previewExpiresAt: Date,\n  ): Promise<string[]> {\n    const paths: string[] = [];\n    for (const clip of clips) {\n      const previewPath = hostPreviewObjectPath(partyId, seedId, clip.cameraId);\n      const preview = bucket.file(previewPath);\n      const [exists] = await preview.exists().catch(() => [false] as unknown as [boolean]);\n      if (!exists) {\n        // Deleted seeds must never recreate previews: the caller checks the\n        // seed status inside a transaction first; this copy is the\n        // materialization step only for live seeds.\n        await bucket.file(clip.objectPath).copy(preview);\n        await preview\n          .setMetadata({\n            contentType: \"video/mp4\",\n            customTime: previewExpiresAt.toISOString(),\n            metadata: {\n              expiresAt: previewExpiresAt.toISOString(),\n              partyId,\n              seedId,\n              jobId: jobIdForHostSeed(seedId),\n              cameraId: clip.cameraId,\n              purpose: \"host-preview\",\n              sha256: clip.sha256,\n            },\n          })\n          .catch(() => undefined);\n      }\n      paths.push(previewPath);\n    }\n    return paths;\n  }\n\n  async function deliveryClipsForJob(\n    partyId: string,\n    channelId: string,\n    jobId: string,\n  ): Promise<Array<{ cameraId: string; objectPath: string; sha256: string }>> {\n    const jobSnap = await jobRef(db, partyId, jobId).get();\n    if (!jobSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n    const job = jobSnap.data()!;\n    const staged = (job.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown; sha256?: unknown; cameraId?: unknown }>;\n    const fromStaged = Object.values(staged).filter(\n      (clip): clip is { cameraId: string; objectPath: string; sha256: string } =>\n        !!clip && typeof clip.objectPath === \"string\" && typeof clip.sha256 === \"string\" && typeof clip.cameraId === \"string\",\n    );\n    if (fromStaged.length > 0) return fromStaged;\n    // Fall back to the published current manifest when it belongs to this job.\n    const current = await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get();\n    if (current.exists) {\n      const manifest = current.data() as { jobId?: unknown; cameraClips?: unknown };\n      if (manifest.jobId === jobId && Array.isArray(manifest.cameraClips)) {\n        return (manifest.cameraClips as Array<Record<string, unknown>>)\n          .filter((clip) => typeof clip.cameraId === \"string\" && typeof clip.objectPath === \"string\" && typeof clip.sha256 === \"string\")\n          .map((clip) => ({ cameraId: clip.cameraId as string, objectPath: clip.objectPath as string, sha256: clip.sha256 as string }));\n      }\n    }\n    throw new BackendError(\"NOT_FOUND\", \"Seed video preview is not ready yet.\");\n  }\n\n  async function listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }> {\n    const input = parseListHostVideosInput(value);\n    const host = await assertRegisteredHostDevice(db, input);\n    const snapshot = await db.collection(`parties/${host.partyId}/seedVideos`).get();\n    const videos: HostSeedEntry[] = [];\n    for (const doc of snapshot.docs) {\n      const seed = doc.data();\n      if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) continue;\n      const synced = await syncSeedStatus(host.partyId, doc);\n      const current = synced ?? seed;\n      videos.push({\n        seedId: String(seed.seedId),\n        partyId: host.partyId,\n        channelId: host.channelId,\n        status: current.status as HostSeedStatus,\n        jobId: String(seed.jobId),\n        createdAt: exposedIso(seed.createdAt),\n        expiresAt: exposedIso(seed.expiresAt),\n        previewAvailable: Array.isArray(seed.previewPaths) && seed.previewPaths.length > 0,\n        cameraIds: Array.isArray(seed.cameraIds) ? (seed.cameraIds as string[]) : [...REQUIRED_CAMERA_IDS],\n      });\n    }\n    videos.sort((a, b) => a.createdAt.localeCompare(b.createdAt));\n    return { videos };\n  }\n\n  async function generateHostVideo(value: unknown): Promise<GenerateHostVideoResult> {\n    const input = parseGenerateHostVideoInput(value);\n    const host = await assertRegisteredHostDevice(db, input);\n    const jobId = jobIdForHostSeed(input.seedId);\n    const ref = seedRef(db, host.partyId, input.seedId);\n    const existing = await ref.get();\n    if (existing.exists) {\n      const old = existing.data()!;\n      if (\n        old.partyId !== host.partyId ||\n        old.channelId !== host.channelId ||\n        old.jobId !== jobId ||\n        old.idempotencyKey !== input.idempotencyKey ||\n        old.deviceId !== host.deviceId ||\n        (old.guestMediaId ?? undefined) !== (input.guestMediaId ?? undefined) ||\n        old.presetId !== input.presetId\n      ) {\n        throw new BackendError(\"FORBIDDEN\", \"seedId is already bound to a different request.\");\n      }\n      const synced = await syncSeedStatus(host.partyId, existing);\n      const jobSnap = await jobRef(db, host.partyId, jobId).get();\n      return {\n        seedId: input.seedId,\n        jobId,\n        state: jobSnap.exists ? String(jobSnap.data()?.state ?? synced?.status ?? \"queued\") : String(synced?.status ?? \"queued\"),\n        created: false,\n      };\n    }\n    // Deletion/withdrawal races: a seed id bound to a deleted seed can never\n    // be resurrected through generate (tombstone check below is best-effort;\n    // the publish path rechecks transactionally).\n    const createdAt = now();\n    const expiresAt = new Date(createdAt.getTime() + HOST_PREVIEW_TTL_MS);\n    await ref.create({\n      seedId: input.seedId,\n      partyId: host.partyId,\n      deviceId: host.deviceId,\n      channelId: host.channelId,\n      jobId,\n      idempotencyKey: input.idempotencyKey,\n      presetId: input.presetId,\n      ...(input.guestMediaId ? { guestMediaId: input.guestMediaId } : {}),\n      status: \"queued\",\n      cameraIds: [...REQUIRED_CAMERA_IDS],\n      previewPaths: [],\n      createdAt: FieldValue.serverTimestamp(),\n      updatedAt: FieldValue.serverTimestamp(),\n      expiresAt: Timestamp.fromDate(expiresAt),\n    });\n    // Fixed-preset queue with the existing idempotency, budget, and consent\n    // checks: host generation is a scoped entry point to the same pipeline,\n    // never a parallel one.\n    try {\n      const request = await store.requestGeneration({\n        partyId: host.partyId,\n        deviceId: host.deviceId,\n        channelId: host.channelId,\n        jobId,\n        idempotencyKey: input.idempotencyKey,\n        presetId: input.presetId,\n        ...(input.guestMediaId ? { guestMediaId: input.guestMediaId } : {}),\n      });\n      await ref.update({ status: request.state === \"queued\" ? \"queued\" : request.state, updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n      return { seedId: input.seedId, jobId, state: request.state, created: request.created };\n    } catch (error) {\n      await ref.update({ status: \"failed\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n      throw error;\n    }\n  }\n\n  async function getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult> {\n    const input = parseGetHostVideoPreviewInput(value);\n    const host = await assertRegisteredHostDevice(db, input);\n    const ref = seedRef(db, host.partyId, input.seedId);\n    const seedSnap = await ref.get();\n    if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n    const seed = seedSnap.data()!;\n    if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n      throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n    }\n    // A deleted seed never recreates previews.\n    if (seed.status === \"deleted\") throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n    const jobSnap = await jobRef(db, host.partyId, String(seed.jobId)).get();\n    if (!jobSnap.exists) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n    if (jobSnap.data()?.hostDeleted === true) throw new BackendError(\"NOT_FOUND\", \"Seed video does not exist.\");\n    const clips = await deliveryClipsForJob(host.partyId, host.channelId, String(seed.jobId));\n    const previewExpiry = seed.expiresAt instanceof Timestamp\n      ? seed.expiresAt.toDate()\n      : new Date(Date.parse(String(seed.expiresAt)));\n    const previewExpiresAt = Number.isFinite(previewExpiry.getTime())\n      ? previewExpiry\n      : new Date(now().getTime() + HOST_PREVIEW_TTL_MS);\n    const previewPaths = await ensurePreviewCopies(host.partyId, input.seedId, clips, previewExpiresAt);\n    await ref.update({ previewPaths, status: \"ready\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\n    const nowMs = now().getTime();\n    const signed TTL is capped at the preview's own expiry (same pattern as delivery URLs).\n    const clipsOut = await Promise.all(\n      clips.map(async (clip) => {\n        const previewPath = hostPreviewObjectPath(host.partyId, input.seedId, clip.cameraId);\n        const expiresAt = new Date(Math.min(nowMs + DELIVERY_URL_TTL_SECONDS * 1000, previewExpiresAt.getTime()));\n        return {\n          cameraId: clip.cameraId,\n          sha256: clip.sha256,\n          url: await signPreviewUrl(bucket.file(previewPath), expiresAt),\n          expiresAt: expiresAt.toISOString(),\n        };\n      }),\n    );\n    return { seedId: input.seedId, expiresAt: previewExpiresAt.toISOString(), clips: clipsOut };\n  }\n\n  async function deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult> {\n    const input = parseDeleteHostVideoInput(value);\n    const host = await assertRegisteredHostDevice(db, input);\n    const deletedSeedIds: string[] = [];\n    const doomedObjects = new Set<string>();\n    const doomedJobs: string[] = [];\n    let revokedManifest = false;\n    for (const seedId of input.seedIds) {\n      const ref = seedRef(db, host.partyId, seedId);\n      const outcome = await db.runTransaction(async (transaction) => {\n        const seedSnap = await transaction.get(ref);\n        if (!seedSnap.exists) throw new BackendError(\"NOT_FOUND\", `Seed video ${seedId} does not exist.`);\n        const seed = seedSnap.data()!;\n        if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\n          throw new BackendError(\"FORBIDDEN\", \"Seed video is outside the registered party and channel.\");\n        }\n        if (seed.status === \"deleted\") return { already: true as const, jobId: String(seed.jobId), previews: seed.previewPaths };\n        const jobId = String(seed.jobId);\n        const jobSnap = await transaction.get(jobRef(db, host.partyId, jobId));\n        const job = jobSnap.exists ? jobSnap.data()! : undefined;\n        const staged = ((job?.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown }>) ?? {};\n        const previews = Array.isArray(seed.previewPaths) ? (seed.previewPaths as unknown[]) : [];\n        transaction.update(ref, {\n          status: \"deleted\",\n          deletedAt: FieldValue.serverTimestamp(),\n          updatedAt: FieldValue.serverTimestamp(),\n        });\n        if (jobSnap.exists) {\n          // Tombstone the job so a deletion/withdrawal racing the worker can\n          // never republish it (publish.ts rechecks this flag\n          // transactionally) and so no preview is recreated afterwards.\n          transaction.update(jobRef(db, host.partyId, jobId), {\n            hostDeleted: true,\n            deletedSeedId: seedId,\n            timestamp: FieldValue.serverTimestamp(),\n          });\n        }\n        // Revoke an affected current manifest whose job matches this seed.\n        return { already: false as const, jobId, previews, staged, seed };\n      });\n      if (outcome.already) {\n        deletedSeedIds.push(seedId);\n        for (const path of (outcome.previews ?? []) as unknown[]) {\n          if (typeof path === \"string\" && path.startsWith(\"parties/\")) doomedObjects.add(path);\n        }\n        continue;\n      }\n      deletedSeedIds.push(seedId);\n      doomedJobs.push(outcome.jobId);\n      for (const preview of (outcome.previews ?? []) as unknown[]) {\n        if (typeof preview === \"string\" && preview.startsWith(\"parties/\")) doomedObjects.add(preview);\n      }\n      for (const clip of Object.values((outcome as { staged: Record<string, { objectPath?: unknown }> }).staged ?? {})) {\n        if (clip && typeof clip.objectPath === \"string\" && clip.objectPath.startsWith(\"parties/\")) {\n          doomedObjects.add(clip.objectPath);\n        }\n      }\n      const jobSnap = await jobRef(db, host.partyId, outcome.jobId).get().catch(() => undefined);\n      const job = jobSnap?.exists ? jobSnap.data()! : undefined;\n      for (const key of [\"deliveryPaths\", \"generatedPaths\"] as const) {\n        const list = job?.[key];\n        if (Array.isArray(list)) {\n          for (const item of list) if (typeof item === \"string\" && item.startsWith(\"parties/\")) doomedObjects.add(item);\n        }\n      }\n    }\n    // Revoke affected manifests after the tombstones are durable.\n    if (doomedJobs.length > 0) {\n      const currentRef = db.doc(`parties/${host.partyId}/manifests/current_${host.channelId}`);\n      const current = await currentRef.get().catch(() => undefined);\n      if (current?.exists) {\n        const manifest = current.data() as Record<string, unknown>;\n        if (typeof manifest.jobId === \"string\" && doomedJobs.includes(manifest.jobId)) {\n          const clips = manifest.cameraClips;\n          if (Array.isArray(clips)) {\n            for (const clip of clips) {\n              if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n                const path = (clip as Record<string, unknown>).objectPath as string;\n                if (path.startsWith(\"parties/\")) doomedObjects.add(path);\n              }\n            }\n          }\n          await currentRef.delete().catch(() => undefined);\n          revokedManifest = true;\n        }\n      }\n    }\n    const deletedObjects: string[] = [];\n    for (const path of doomedObjects) {\n      try {\n        await deleteObject(bucket.file(path));\n        deletedObjects.push(path);\n      } catch {\n        // Left for the retention sweeper; never counted as deleted.\n      }\n    }\n    deletedObjects.sort();\n    // Accounting records (costLogs / usage ledger rows) are intentionally\n    // never deleted here.\n    return { deletedSeedIds, deletedObjects, revokedManifest };\n  }\n\n  return { listHostVideos, generateHostVideo, getHostVideoPreview, deleteHostVideo };\n}\n\n/** Publish-gate helper: a tombstoned host job must never publish or re-preview. */\nexport function isHostDeletedJob(job: FirebaseFirestore.DocumentData): boolean {\n  return (job as Record<string, unknown>).hostDeleted === true;\n}\n\nexport { seedIdForHostJob };\n","path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/host_media.ts"},"output":"Created file successfully: backend/functions/src/host_media.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: backend/functions/src/host_media.ts"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929c0298769a946ee714093571e4"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import { Bucket, File } from \\\"@google-cloud/storage\\\";\\nimport { FieldValue, Firestore, Timestamp } from \\\"firebase-admin/firestore\\\";\\nimport {\\n  BackendError,\\n  DeleteHostVideoResult,\\n  GenerateHostVideoResult,\\n  GetHostVideoPreviewResult,\\n  HostSeedEntry,\\n  HostSeedStatus,\\n  parseDeleteHostVideoInput,\\n  parseGenerateHostVideoInput,\\n  parseGetHostVideoPreviewInput,\\n  parseListHostVideosInput,\\n} from \\\"./contracts\\\";\\nimport {\\n  DELIVERY_URL_TTL_SECONDS,\\n  HOST_PREVIEW_TTL_MS,\\n  REQUIRED_CAMERA_IDS,\\n  hostPreviewObjectPath,\\n} from \\\"./config\\\";\\nimport { assertRegisteredHostDevice } from \\\"./auth\\\";\\nimport { FirestoreGenerationStore } from \\\"./generation_store\\\";\\n\\nexport interface HostMediaServiceOptions {\\n  db: Firestore;\\n  bucket: Bucket;\\n  now?: () => Date;\\n  signPreviewUrl?: (file: File, expiresAt: Date) => Promise<string>;\\n  deleteObject?: (file: File) => Promise<void>;\\n}\\n\\n/**\\n * Server-backed seed catalog (cycle-12 host administration).\\n *\\n * Catalog entries live at `parties/{partyId}/seedVideos/{seedId}` and carry\\n * generation status plus the camera video references. Deletion granularity:\\n * `deleteHostVideo` removes selected seed entries and their associated\\n * preview + delivery objects, revokes an affected current manifest whose\\n * jobId matches a deleted seed, and preserves accounting records (costLogs\\n * / usage ledger rows are never deleted). Expiry: each seed carries\\n * `expiresAt` (creation + HOST_PREVIEW_TTL_MS); the retention sweep expires\\n * due seeds and deletes their preview objects, while live seeds protect\\n * their preview paths from the orphan pass. Direct client access remains\\n * denied: callable-only Firestore docs (catch-all deny in firestore.rules)\\n * and callable-only Storage objects (catch-all deny in storage.rules);\\n * preview URLs are signed on demand and never persisted.\\n *\\n * Previews are separately referenced (`hostPreviews/{seedId}/…`) from\\n * delivery objects (`channels/{channel}/delivery/…`) and are materialized\\n * before delivery objects can be ACK-purged (eagerly after the job is\\n * ready, retried lazily on list/preview reads), so an ACK purge of delivery\\n * bytes never removes preview bytes.\\n */\\nexport function jobIdForHostSeed(seedId: string): string {\\n  return `hv-${seedId}`;\\n}\\n\\nfunction seedIdForHostJob(jobId: string): string | undefined {\\n  return jobId.startsWith(\\\"hv-\\\") ? jobId.slice(\\\"hv-\\\".length) : undefined;\\n}\\n\\nfunction seedRef(db: Firestore, partyId: string, seedId: string) {\\n  return db.doc(`parties/${partyId}/seedVideos/${seedId}`);\\n}\\n\\nfunction jobRef(db: Firestore, partyId: string, jobId: string) {\\n  return db.doc(`parties/${partyId}/jobs/${jobId}`);\\n}\\n\\nexport function createHostMediaService(options: HostMediaServiceOptions): {\\n  listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }>;\\n  generateHostVideo(value: unknown): Promise<GenerateHostVideoResult>;\\n  getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult>;\\n  deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult>;\\n} {\\n  const { db, bucket } = options;\\n  const now = options.now ?? (() => new Date());\\n  const signPreviewUrl =\\n    options.signPreviewUrl ??\\n    (async (file, expiresAt) => {\\n      const [url] = await file.getSignedUrl({ action: \\\"read\\\", expires: expiresAt, version: \\\"v4\\\" });\\n      return url;\\n    });\\n  const deleteObject =\\n    options.deleteObject ??\\n    (async (file) => {\\n      await file.delete({ ignoreNotFound: true });\\n    });\\n  const store = new FirestoreGenerationStore({ db, bucket, now });\\n\\n  function exposedIso(value: unknown): string {\\n    if (value instanceof Timestamp) return value.toDate().toISOString();\\n    if (value instanceof Date) return value.toISOString();\\n    if (typeof value === \\\"string\\\") return value;\\n    return now().toISOString();\\n  }\\n\\n  async function syncSeedStatus(\\n    partyId: string,\\n    seedSnap: FirebaseFirestore.DocumentSnapshot,\\n  ): Promise<FirebaseFirestore.DocumentData | undefined> {\\n    const seed = seedSnap.data();\\n    if (!seed || seed.status === \\\"deleted\\\") return seed ?? undefined;\\n    try {\\n      const jobSnap = await jobRef(db, partyId, String(seed.jobId)).get();\\n      if (!jobSnap.exists) return seed;\\n      const job = jobSnap.data()!;\\n      const state = String(job.state);\\n      const next: HostSeedStatus | undefined =\\n        state === \\\"ready\\\" || state === \\\"delivering\\\" || state === \\\"purged\\\"\\n          ? \\\"ready\\\"\\n          : state === \\\"failed\\\" || state === \\\"expired\\\"\\n            ? \\\"failed\\\"\\n            : state === \\\"running\\\"\\n              ? \\\"running\\\"\\n              : undefined;\\n      if (next && next !== seed.status) {\\n        await seedSnap.ref.update({ status: next, updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\\n        return { ...seed, status: next };\\n      }\\n      return seed;\\n    } catch {\\n      return seed;\\n    }\\n  }\\n\\n  /** Copies delivery bytes to separately referenced preview objects (idempotent). */\\n  async function ensurePreviewCopies(\\n    partyId: string,\\n    seedId: string,\\n    clips: Array<{ cameraId: string; objectPath: string; sha256: string }>,\\n    previewExpiresAt: Date,\\n  ): Promise<string[]> {\\n    const paths: string[] = [];\\n    for (const clip of clips) {\\n      const previewPath = hostPreviewObjectPath(partyId, seedId, clip.cameraId);\\n      const preview = bucket.file(previewPath);\\n      const [exists] = await preview.exists().catch(() => [false] as unknown as [boolean]);\\n      if (!exists) {\\n        // Deleted seeds must never recreate previews: the caller checks the\\n        // seed status inside a transaction first; this copy is the\\n        // materialization step only for live seeds.\\n        await bucket.file(clip.objectPath).copy(preview);\\n        await preview\\n          .setMetadata({\\n            contentType: \\\"video/mp4\\\",\\n            customTime: previewExpiresAt.toISOString(),\\n            metadata: {\\n              expiresAt: previewExpiresAt.toISOString(),\\n              partyId,\\n              seedId,\\n              jobId: jobIdForHostSeed(seedId),\\n              cameraId: clip.cameraId,\\n              purpose: \\\"host-preview\\\",\\n              sha256: clip.sha256,\\n            },\\n          })\\n          .catch(() => undefined);\\n      }\\n      paths.push(previewPath);\\n    }\\n    return paths;\\n  }\\n\\n  async function deliveryClipsForJob(\\n    partyId: string,\\n    channelId: string,\\n    jobId: string,\\n  ): Promise<Array<{ cameraId: string; objectPath: string; sha256: string }>> {\\n    const jobSnap = await jobRef(db, partyId, jobId).get();\\n    if (!jobSnap.exists) throw new BackendError(\\\"NOT_FOUND\\\", \\\"Seed video does not exist.\\\");\\n    const job = jobSnap.data()!;\\n    const staged = (job.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown; sha256?: unknown; cameraId?: unknown }>;\\n    const fromStaged = Object.values(staged).filter(\\n      (clip): clip is { cameraId: string; objectPath: string; sha256: string } =>\\n        !!clip && typeof clip.objectPath === \\\"string\\\" && typeof clip.sha256 === \\\"string\\\" && typeof clip.cameraId === \\\"string\\\",\\n    );\\n    if (fromStaged.length > 0) return fromStaged;\\n    // Fall back to the published current manifest when it belongs to this job.\\n    const current = await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get();\\n    if (current.exists) {\\n      const manifest = current.data() as { jobId?: unknown; cameraClips?: unknown };\\n      if (manifest.jobId === jobId && Array.isArray(manifest.cameraClips)) {\\n        return (manifest.cameraClips as Array<Record<string, unknown>>)\\n          .filter((clip) => typeof clip.cameraId === \\\"string\\\" && typeof clip.objectPath === \\\"string\\\" && typeof clip.sha256 === \\\"string\\\")\\n          .map((clip) => ({ cameraId: clip.cameraId as string, objectPath: clip.objectPath as string, sha256: clip.sha256 as string }));\\n      }\\n    }\\n    throw new BackendError(\\\"NOT_FOUND\\\", \\\"Seed video preview is not ready yet.\\\");\\n  }\\n\\n  async function listHostVideos(value: unknown): Promise<{ videos: HostSeedEntry[] }> {\\n    const input = parseListHostVideosInput(value);\\n    const host = await assertRegisteredHostDevice(db, input);\\n    const snapshot = await db.collection(`parties/${host.partyId}/seedVideos`).get();\\n    const videos: HostSeedEntry[] = [];\\n    for (const doc of snapshot.docs) {\\n      const seed = doc.data();\\n      if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) continue;\\n      const synced = await syncSeedStatus(host.partyId, doc);\\n      const current = synced ?? seed;\\n      videos.push({\\n        seedId: String(seed.seedId),\\n        partyId: host.partyId,\\n        channelId: host.channelId,\\n        status: current.status as HostSeedStatus,\\n        jobId: String(seed.jobId),\\n        createdAt: exposedIso(seed.createdAt),\\n        expiresAt: exposedIso(seed.expiresAt),\\n        previewAvailable: Array.isArray(seed.previewPaths) && seed.previewPaths.length > 0,\\n        cameraIds: Array.isArray(seed.cameraIds) ? (seed.cameraIds as string[]) : [...REQUIRED_CAMERA_IDS],\\n      });\\n    }\\n    videos.sort((a, b) => a.createdAt.localeCompare(b.createdAt));\\n    return { videos };\\n  }\\n\\n  async function generateHostVideo(value: unknown): Promise<GenerateHostVideoResult> {\\n    const input = parseGenerateHostVideoInput(value);\\n    const host = await assertRegisteredHostDevice(db, input);\\n    const jobId = jobIdForHostSeed(input.seedId);\\n    const ref = seedRef(db, host.partyId, input.seedId);\\n    const existing = await ref.get();\\n    if (existing.exists) {\\n      const old = existing.data()!;\\n      if (\\n        old.partyId !== host.partyId ||\\n        old.channelId !== host.channelId ||\\n        old.jobId !== jobId ||\\n        old.idempotencyKey !== input.idempotencyKey ||\\n        old.deviceId !== host.deviceId ||\\n        (old.guestMediaId ?? undefined) !== (input.guestMediaId ?? undefined) ||\\n        old.presetId !== input.presetId\\n      ) {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"seedId is already bound to a different request.\\\");\\n      }\\n      const synced = await syncSeedStatus(host.partyId, existing);\\n      const jobSnap = await jobRef(db, host.partyId, jobId).get();\\n      return {\\n        seedId: input.seedId,\\n        jobId,\\n        state: jobSnap.exists ? String(jobSnap.data()?.state ?? synced?.status ?? \\\"queued\\\") : String(synced?.status ?? \\\"queued\\\"),\\n        created: false,\\n      };\\n    }\\n    // Deletion/withdrawal races: a seed id bound to a deleted seed can never\\n    // be resurrected through generate (tombstone check below is best-effort;\\n    // the publish path rechecks transactionally).\\n    const createdAt = now();\\n    const expiresAt = new Date(createdAt.getTime() + HOST_PREVIEW_TTL_MS);\\n    await ref.create({\\n      seedId: input.seedId,\\n      partyId: host.partyId,\\n      deviceId: host.deviceId,\\n      channelId: host.channelId,\\n      jobId,\\n      idempotencyKey: input.idempotencyKey,\\n      presetId: input.presetId,\\n      ...(input.guestMediaId ? { guestMediaId: input.guestMediaId } : {}),\\n      status: \\\"queued\\\",\\n      cameraIds: [...REQUIRED_CAMERA_IDS],\\n      previewPaths: [],\\n      createdAt: FieldValue.serverTimestamp(),\\n      updatedAt: FieldValue.serverTimestamp(),\\n      expiresAt: Timestamp.fromDate(expiresAt),\\n    });\\n    // Fixed-preset queue with the existing idempotency, budget, and consent\\n    // checks: host generation is a scoped entry point to the same pipeline,\\n    // never a parallel one.\\n    try {\\n      const request = await store.requestGeneration({\\n        partyId: host.partyId,\\n        deviceId: host.deviceId,\\n        channelId: host.channelId,\\n        jobId,\\n        idempotencyKey: input.idempotencyKey,\\n        presetId: input.presetId,\\n        ...(input.guestMediaId ? { guestMediaId: input.guestMediaId } : {}),\\n      });\\n      await ref.update({ status: request.state === \\\"queued\\\" ? \\\"queued\\\" : request.state, updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\\n      return { seedId: input.seedId, jobId, state: request.state, created: request.created };\\n    } catch (error) {\\n      await ref.update({ status: \\\"failed\\\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\\n      throw error;\\n    }\\n  }\\n\\n  async function getHostVideoPreview(value: unknown): Promise<GetHostVideoPreviewResult> {\\n    const input = parseGetHostVideoPreviewInput(value);\\n    const host = await assertRegisteredHostDevice(db, input);\\n    const ref = seedRef(db, host.partyId, input.seedId);\\n    const seedSnap = await ref.get();\\n    if (!seedSnap.exists) throw new BackendError(\\\"NOT_FOUND\\\", \\\"Seed video does not exist.\\\");\\n    const seed = seedSnap.data()!;\\n    if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\\n      throw new BackendError(\\\"FORBIDDEN\\\", \\\"Seed video is outside the registered party and channel.\\\");\\n    }\\n    // A deleted seed never recreates previews.\\n    if (seed.status === \\\"deleted\\\") throw new BackendError(\\\"NOT_FOUND\\\", \\\"Seed video does not exist.\\\");\\n    const jobSnap = await jobRef(db, host.partyId, String(seed.jobId)).get();\\n    if (!jobSnap.exists) throw new BackendError(\\\"NOT_FOUND\\\", \\\"Seed video does not exist.\\\");\\n    if (jobSnap.data()?.hostDeleted === true) throw new BackendError(\\\"NOT_FOUND\\\", \\\"Seed video does not exist.\\\");\\n    const clips = await deliveryClipsForJob(host.partyId, host.channelId, String(seed.jobId));\\n    const previewExpiry = seed.expiresAt instanceof Timestamp\\n      ? seed.expiresAt.toDate()\\n      : new Date(Date.parse(String(seed.expiresAt)));\\n    const previewExpiresAt = Number.isFinite(previewExpiry.getTime())\\n      ? previewExpiry\\n      : new Date(now().getTime() + HOST_PREVIEW_TTL_MS);\\n    const previewPaths = await ensurePreviewCopies(host.partyId, input.seedId, clips, previewExpiresAt);\\n    await ref.update({ previewPaths, status: \\\"ready\\\", updatedAt: FieldValue.serverTimestamp() }).catch(() => undefined);\\n    const nowMs = now().getTime();\\n    const signed TTL is capped at the preview's own expiry (same pattern as delivery URLs).\\n    const clipsOut = await Promise.all(\\n      clips.map(async (clip) => {\\n        const previewPath = hostPreviewObjectPath(host.partyId, input.seedId, clip.cameraId);\\n        const expiresAt = new Date(Math.min(nowMs + DELIVERY_URL_TTL_SECONDS * 1000, previewExpiresAt.getTime()));\\n        return {\\n          cameraId: clip.cameraId,\\n          sha256: clip.sha256,\\n          url: await signPreviewUrl(bucket.file(previewPath), expiresAt),\\n          expiresAt: expiresAt.toISOString(),\\n        };\\n      }),\\n    );\\n    return { seedId: input.seedId, expiresAt: previewExpiresAt.toISOString(), clips: clipsOut };\\n  }\\n\\n  async function deleteHostVideo(value: unknown): Promise<DeleteHostVideoResult> {\\n    const input = parseDeleteHostVideoInput(value);\\n    const host = await assertRegisteredHostDevice(db, input);\\n    const deletedSeedIds: string[] = [];\\n    const doomedObjects = new Set<string>();\\n    const doomedJobs: string[] = [];\\n    let revokedManifest = false;\\n    for (const seedId of input.seedIds) {\\n      const ref = seedRef(db, host.partyId, seedId);\\n      const outcome = await db.runTransaction(async (transaction) => {\\n        const seedSnap = await transaction.get(ref);\\n        if (!seedSnap.exists) throw new BackendError(\\\"NOT_FOUND\\\", `Seed video ${seedId} does not exist.`);\\n        const seed = seedSnap.data()!;\\n        if (seed.partyId !== host.partyId || seed.channelId !== host.channelId) {\\n          throw new BackendError(\\\"FORBIDDEN\\\", \\\"Seed video is outside the registered party and channel.\\\");\\n        }\\n        if (seed.status === \\\"deleted\\\") return { already: true as const, jobId: String(seed.jobId), previews: seed.previewPaths };\\n        const jobId = String(seed.jobId);\\n        const jobSnap = await transaction.get(jobRef(db, host.partyId, jobId));\\n        const job = jobSnap.exists ? jobSnap.data()! : undefined;\\n        const staged = ((job?.stagedOutputs ?? {}) as Record<string, { objectPath?: unknown }>) ?? {};\\n        const previews = Array.isArray(seed.previewPaths) ? (seed.previewPaths as unknown[]) : [];\\n        transaction.update(ref, {\\n          status: \\\"deleted\\\",\\n          deletedAt: FieldValue.serverTimestamp(),\\n          updatedAt: FieldValue.serverTimestamp(),\\n        });\\n        if (jobSnap.exists) {\\n          // Tombstone the job so a deletion/withdrawal racing the worker can\\n          // never republish it (publish.ts rechecks this flag\\n          // transactionally) and so no preview is recreated afterwards.\\n          transaction.update(jobRef(db, host.partyId, jobId), {\\n            hostDeleted: true,\\n            deletedSeedId: seedId,\\n            timestamp: FieldValue.serverTimestamp(),\\n          });\\n        }\\n        // Revoke an affected current manifest whose job matches this seed.\\n        return { already: false as const, jobId, previews, staged, seed };\\n      });\\n      if (outcome.already) {\\n        deletedSeedIds.push(seedId);\\n        for (const path of (outcome.previews ?? []) as unknown[]) {\\n          if (typeof path === \\\"string\\\" && path.startsWith(\\\"parties/\\\")) doomedObjects.add(path);\\n        }\\n        continue;\\n      }\\n      deletedSeedIds.push(seedId);\\n      doomedJobs.push(outcome.jobId);\\n      for (const preview of (outcome.previews ?? []) as unknown[]) {\\n        if (typeof preview === \\\"string\\\" && preview.startsWith(\\\"parties/\\\")) doomedObjects.add(preview);\\n      }\\n      for (const clip of Object.values((outcome as { staged: Record<string, { objectPath?: unknown }> }).staged ?? {})) {\\n        if (clip && typeof clip.objectPath === \\\"string\\\" && clip.objectPath.startsWith(\\\"parties/\\\")) {\\n          doomedObjects.add(clip.objectPath);\\n        }\\n      }\\n      const jobSnap = await jobRef(db, host.partyId, outcome.jobId).get().catch(() => undefined);\\n      const job = jobSnap?.exists ? jobSnap.data()! : undefined;\\n      for (const key of [\\\"deliveryPaths\\\", \\\"generatedPaths\\\"] as const) {\\n        const list = job?.[key];\\n        if (Array.isArray(list)) {\\n          for (const item of list) if (typeof item === \\\"string\\\" && item.startsWith(\\\"parties/\\\")) doomedObjects.add(item);\\n        }\\n      }\\n    }\\n    // Revoke affected manifests after the tombstones are durable.\\n    if (doomedJobs.length > 0) {\\n      const currentRef = db.doc(`parties/${host.partyId}/manifests/current_${host.channelId}`);\\n      const current = await currentRef.get().catch(() => undefined);\\n      if (current?.exists) {\\n        const manifest = current.data() as Record<string, unknown>;\\n        if (typeof manifest.jobId === \\\"string\\\" && doomedJobs.includes(manifest.jobId)) {\\n          const clips = manifest.cameraClips;\\n          if (Array.isArray(clips)) {\\n            for (const clip of clips) {\\n              if (clip && typeof clip === \\\"object\\\" && typeof (clip as Record<string, unknown>).objectPath === \\\"string\\\") {\\n                const path = (clip as Record<string, unknown>).objectPath as string;\\n                if (path.startsWith(\\\"parties/\\\")) doomedObjects.add(path);\\n              }\\n            }\\n          }\\n          await currentRef.delete().catch(() => undefined);\\n          revokedManifest = true;\\n        }\\n      }\\n    }\\n    const deletedObjects: string[] = [];\\n    for (const path of doomedObjects) {\\n      try {\\n        await deleteObject(bucket.file(path));\\n        deletedObjects.push(path);\\n      } catch {\\n        // Left for the retention sweeper; never counted as deleted.\\n      }\\n    }\\n    deletedObjects.sort();\\n    // Accounting records (costLogs / usage ledger rows) are intentionally\\n    // never deleted here.\\n    return { deletedSeedIds, deletedObjects, revokedManifest };\\n  }\\n\\n  return { listHostVideos, generateHostVideo, getHostVideoPreview, deleteHostVideo };\\n}\\n\\n/** Publish-gate helper: a tombstoned host job must never publish or re-preview. */\\nexport function isHostDeletedJob(job: FirebaseFirestore.DocumentData): boolean {\\n  return (job as Record<string, unknown>).hostDeleted === true;\\n}\\n\\nexport { seedIdForHostJob };\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/host_media.ts\"}"},"time":{"start":1793461060244,"end":1793461066298}}}}
