nal Map<String, Object?> payload = <String, Object?>{\n39:       'partyId': partyId,\n40:       'deviceId': deviceId,\n41:       'channelId': channelId,\n42:       'inviteToken': inviteToken,\n43:     };\n44:     try {\n45:       final Object? raw = await _invoker\n46:           .call(kJoinHostCallable, payload)\n47:           .timeout(timeout);\n48:       if (raw is! Map ||\n49:           raw['partyId'] != partyId ||\n50:           raw['deviceId'] != deviceId ||\n51:           raw['channelId'] != channelId ||\n52:           raw['role'] != 'host' ||\n53:           raw['status'] != 'active' ||\n54:           raw['created'] is! bool) {\n55:         throw const FormatException(\n56:           'joinHost response did not match the requested host scope',\n57:         );\n58:       }\n59:     } on TimeoutException catch (error) {\n60:       throw ManifestTransportException('joinHost timed out', error);\n61:     } on FirebaseFunctionsException catch (error) {\n62:       throw ManifestTransportException('joinHost callable failed', error);\n63:     }\n64:   }\n65: }\n66: \n67: /// SDK-backed joinHost invoker, intentionally unable to make other calls.\n68: final class CallableHostJoinInvoker implements HostJoinCallableInvoker {\n69:   CallableHostJoinInvoker({required FirebaseFunctions functions})\n70:     : _functions = functions;\n71:   final FirebaseFunctions _functions;\n72: \n73:   @override\n74:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n75:     if (name != kJoinHostCallable) throw ArgumentError.value(name, 'name');\n76:     return (await _functions\n77:             .httpsCallable(kJoinHostCallable)\n78:             .call<Object?>(payload))\n79:         .data;\n80:   }\n81: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/data/host_join_client.dart, lines 1-81\n1: /// Host invite redemption callable used before host administration.\n2: library;\n3: \n4: import 'dart:async';\n5: \n6: import 'package:cloud_functions/cloud_functions.dart';\n7: import 'package:infra_firestore/infra_firestore.dart'\n8:     show ManifestTransportException;\n9: \n10: const String kJoinHostCallable = 'joinHost';\n11: \n12: /// Callable boundary kept separate from the guest `joinParty` boundary.\n13: ///\n14: /// Guest entry must never register a host payload through `joinParty`, and\n15: /// host entry must never redeem through it either: the two routes use\n16: /// disjoint callables, disjoint device identities, and server-assigned\n17: /// roles (see `backend/functions/src/host_join.ts`).\n18: abstract interface class HostJoinCallableInvoker {\n19:   Future<Object?> call(String name, Map<String, Object?> payload);\n20: }\n21: \n22: /// Redeems a host invite and validates the server's scoped host response.\n23: final class HostJoinClient {\n24:   HostJoinClient({\n25:     required HostJoinCallableInvoker invoker,\n26:     this.timeout = const Duration(seconds: 10),\n27:   }) : _invoker = invoker;\n28: \n29:   final HostJoinCallableInvoker _invoker;\n30:   final Duration timeout;\n31: \n32:   Future<void> redeem({\n33:     required String partyId,\n34:     required String deviceId,\n35:     required String channelId,\n36:     required String inviteToken,\n37:   }) async {\n38:     final Map<String, Object?> payload = <String, Object?>{\n39:       'partyId': partyId,\n40:       'deviceId': deviceId,\n41:       'channelId': channelId,\n42:       'inviteToken': inviteToken,\n43:     };\n44:     try {\n45:       final Object? raw = await _invoker\n46:           .call(kJoinHostCallable, payload)\n47:           .timeout(timeout);\n48:       if (raw is! Map ||\n49:           raw['partyId'] != partyId ||\n50:           raw['deviceId'] != deviceId ||\n51:           raw['channelId'] != channelId ||\n52:           raw['role'] != 'host' ||\n53:           raw['status'] != 'active' ||\n54:           raw['created'] is! bool) {\n55:         throw const FormatException(\n56:           'joinHost response did not match the requested host scope',\n57:         );\n58:       }\n59:     } on TimeoutException catch (error) {\n60:       throw ManifestTransportException('joinHost timed out', error);\n61:     } on FirebaseFunctionsException catch (error) {\n62:       throw ManifestTransportException('joinHost callable failed', error);\n63:     }\n64:   }\n65: }\n66: \n67: /// SDK-backed joinHost invoker, intentionally unable to make other calls.\n68: final class CallableHostJoinInvoker implements HostJoinCallableInvoker {\n69:   CallableHostJoinInvoker({required FirebaseFunctions functions})\n70:     : _functions = functions;\n71:   final FirebaseFunctions _functions;\n72: \n73:   @override\n74:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n75:     if (name != kJoinHostCallable) throw ArgumentError.value(name, 'name');\n76:     return (await _functions\n77:             .httpsCallable(kJoinHostCallable)\n78:             .call<Object?>(payload))\n79:         .data;\n80:   }\n81: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3349270b982387baa7bf27e66"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/data/host_join_client.dart\"}"},"time":{"start":1793463629661,"end":1793463630972}}}}
{"type":"tool_use","timestamp":1793463630973,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c33761001usw4ua9vmaXzA5","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c32c310015WHeKtnpYJKzMt","type":"tool","id":"call_01a192c3361170afa5fe348bf8fa5257","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/data/host_media_client.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/data/host_media_client.dart, lines 1-364\n1: /// Scoped host administration callables (seed catalog + previews).\n2: ///\n3: /// Every operation revalidates the registered host role and party/channel\n4: /// scope server-side (`assertRegisteredHostDevice`); guests get `FORBIDDEN`.\n5: /// Payload/response shapes mirror `backend/functions/src/contracts.ts`.\n6: ///\n7: /// Deletion granularity (pinned): `deleteHostVideo` deletes per selected\n8: /// seed id — the seed entries and their associated preview + delivery\n9: /// objects are removed, an affected current manifest whose jobId matches a\n10: /// deleted seed is revoked, and accounting records (costLogs / usage ledger\n11: /// rows) are never deleted. The list is reconciled only after authoritative\n12: /// success; failures leave local state untouched so they stay retryable.\n13: library;\n14: \n15: import 'dart:async';\n16: \n17: import 'package:cloud_functions/cloud_functions.dart';\n18: import 'package:infra_firestore/infra_firestore.dart'\n19:     show ManifestTransportException;\n20: \n21: const String kListHostVideos = 'listHostVideos';\n22: const String kGenerateHostVideo = 'generateHostVideo';\n23: const String kGetHostVideoPreview = 'getHostVideoPreview';\n24: const String kDeleteHostVideo = 'deleteHostVideo';\n25: \n26: /// Fixed generation presets supported by host administration.\n27: ///\n28: /// Pinned to `backend/functions/src/config.ts` (`CHEAP_DEMO_PRESET` /\n29: /// `CAMEO_DEMO_PRESET`). Generation presets keep producing 4 clips; the\n30: /// preset value is never caller-tunable beyond this fixed set.\n31: const String kCheapDemoPresetId = 'cheap_demo';\n32: const String kCameoDemoPresetId = 'cameo_demo';\n33: \n34: /// Callable boundary for host administration, separate from guest callables.\n35: abstract interface class HostMediaCallableInvoker {\n36:   Future<Object?> call(String name, Map<String, Object?> payload);\n37: }\n38: \n39: /// One server-backed seed catalog entry.\n40: final class HostSeedVideo {\n41:   const HostSeedVideo({\n42:     required this.seedId,\n43:     required this.partyId,\n44:     required this.channelId,\n45:     required this.status,\n46:     required this.jobId,\n47:     required this.createdAt,\n48:     required this.expiresAt,\n49:     required this.previewAvailable,\n50:     required this.cameraIds,\n51:   });\n52: \n53:   final String seedId;\n54:   final String partyId;\n55:   final String channelId;\n56: \n57:   /// Backend seed status: `queued`, `running`, `ready`, `failed`,\n58:   /// `deleted` (expiry surfaces through the same status sync).\n59:   final String status;\n60:   final String jobId;\n61:   final String createdAt;\n62:   final String expiresAt;\n63:   final bool previewAvailable;\n64:   final List<String> cameraIds;\n65: \n66:   @override\n67:   bool operator ==(Object other) =>\n68:       other is HostSeedVideo &&\n69:       other.seedId == seedId &&\n70:       other.partyId == partyId &&\n71:       other.channelId == channelId &&\n72:       other.status == status &&\n73:       other.jobId == jobId &&\n74:       other.previewAvailable == previewAvailable;\n75: \n76:   @override\n77:   int get hashCode =>\n78:       Object.hash(seedId, partyId, channelId, status, jobId, previewAvailable);\n79: \n80:   @override\n81:   String toString() => 'HostSeedVideo($seedId status=$status)';\n82: }\n83: \n84: /// One signed preview clip reference (signed on demand, never persisted).\n85: final class HostVideoPreviewClip {\n86:   const HostVideoPreviewClip({\n87:     required this.cameraId,\n88:     required this.sha256,\n89:     required this.url,\n90:     required this.expiresAt,\n91:   });\n92: \n93:   final String cameraId;\n94:   final String sha256;\n95:   final Uri url;\n96:   final String expiresAt;\n97: }\n98: \n99: /// Fresh scoped preview capability for one seed video.\n100: final class HostVideoPreview {\n101:   const HostVideoPreview({\n102:     required this.seedId,\n103:     required this.expiresAt,\n104:     required this.clips,\n105:   });\n106: \n107:   final String seedId;\n108:   final String expiresAt;\n109:   final List<HostVideoPreviewClip> clips;\n110: }\n111: \n112: /// Scoped host media client: list / generate / preview / delete.\n113: final class HostMediaClient {\n114:   HostMediaClient({\n115:     required HostMediaCallableInvoker invoker,\n116:     this.timeout = const Duration(seconds: 15),\n117:   }) : _invoker = invoker;\n118: \n119:   final HostMediaCallableInvoker _invoker;\n120:   final Duration timeout;\n121: \n122:   Map<String, Object?> _scope(\n123:     String partyId,\n124:     String deviceId,\n125:     String channelId,\n126:   ) => <String, Object?>{\n127:     'partyId': partyId,\n128:     'deviceId': deviceId,\n129:     'channelId': channelId,\n130:   };\n131: \n132:   Future<Object?> _call(String name, Map<String, Object?> payload) async {\n133:     try {\n134:       return await _invoker.call(name, payload).timeout(timeout);\n135:     } on TimeoutException catch (error) {\n136:       throw ManifestTransportException('$name timed out', error);\n137:     }\n138:   }\n139: \n140:   /// Lists the server-backed seed catalog for the registered host scope.\n141:   Future<List<HostSeedVideo>> listVideos({\n142:     required String partyId,\n143:     required String deviceId,\n144:     required String channelId,\n145:   }) async {\n146:     final Object? raw;\n147:     try {\n148:       raw = await _call(kListHostVideos, _scope(partyId, deviceId, channelId));\n149:     } on FirebaseFunctionsException catch (error) {\n150:       throw ManifestTransportException('listHostVideos callable failed', error);\n151:     }\n152:     if (raw is! Map || raw['videos'] is! List) {\n153:       throw const FormatException('Host video list response is malformed');\n154:     }\n155:     final List<HostSeedVideo> videos = <HostSeedVideo>[];\n156:     for (final Object? entry in raw['videos'] as List) {\n157:       videos.add(_parseSeed(entry, partyId: partyId, channelId: channelId));\n158:     }\n159:     return videos;\n160:   }\n161: \n162:   HostSeedVideo _parseSeed(\n163:     Object? entry, {\n164:     required String partyId,\n165:     required String channelId,\n166:   }) {\n167:     if (entry is! Map) {\n168:       throw const FormatException('Host seed entry is malformed');\n169:     }\n170:     String requiredString(String key) {\n171:       final Object? value = entry[key];\n172:       if (value is! String || value.isEmpty) {\n173:         throw FormatException('Host seed entry field \"$key\" is malformed');\n174:       }\n175:       return value;\n176:     }\n177: \n178:     final String seedParty = requiredString('partyId');\n179:     final String seedChannel = requiredString('channelId');\n180:     if (seedParty != partyId || seedChannel != channelId) {\n181:       throw const FormatException(\n182:         'Host seed entry is outside the registered party and channel',\n183:       );\n184:     }\n185:     final Object? cameras = entry['cameraIds'];\n186:     if (entry['previewAvailable'] is! bool || cameras is! List) {\n187:       throw const FormatException('Host seed entry fields are malformed');\n188:     }\n189:     return HostSeedVideo(\n190:       seedId: requiredString('seedId'),\n191:       partyId: seedParty,\n192:       channelId: seedChannel,\n193:       status: requiredString('status'),\n194:       jobId: requiredString('jobId'),\n195:       createdAt: requiredString('createdAt'),\n196:       expiresAt: requiredString('expiresAt'),\n197:       previewAvailable: entry['previewAvailable'] as bool,\n198:       cameraIds: <String>[for (final Object? c in cameras) c.toString()],\n199:     );\n200:   }\n201: \n202:   /// Enqueues fixed-preset generation for [seedId].\n203:   ///\n204:   /// [idempotencyKey] must be stable per seed id across retries so a retry\n205:   /// reuses the queued job (`created: false`) instead of enqueueing another\n206:   /// task. [presetId] defaults to the supported `cheap_demo` preset.\n207:   Future<Map<String, Object?>> generateVideo({\n208:     required String partyId,\n209:     required String deviceId,\n210:     required String channelId,\n211:     required String seedId,\n212:     required String idempotencyKey,\n213:     String presetId = kCheapDemoPresetId,\n214:     String? guestMediaId,\n215:   }) async {\n216:     if (presetId != kCheapDemoPresetId && presetId != kCameoDemoPresetId) {\n217:       throw ArgumentError.value(\n218:         presetId,\n219:         'presetId',\n220:         'Only the fixed generation presets are supported',\n221:       );\n222:     }\n223:     final Object? raw;\n224:     try {\n225:       raw = await _call(kGenerateHostVideo, <String, Object?>{\n226:         ..._scope(partyId, deviceId, channelId),\n227:         'seedId': seedId,\n228:         'idempotencyKey': idempotencyKey,\n229:         'presetId': presetId,\n230:         if (guestMediaId != null) 'guestMediaId': guestMediaId,\n231:       });\n232:     } on FirebaseFunctionsException catch (error) {\n233:       throw ManifestTransportException(\n234:         'generateHostVideo callable failed',\n235:         error,\n236:       );\n237:     }\n238:     if (raw is! Map ||\n239:         raw['seedId'] != seedId ||\n240:         raw['jobId'] is! String ||\n241:         raw['state'] is! String ||\n242:         raw['created'] is! bool) {\n243:       throw const FormatException(\n244:         'generateHostVideo response did not match the requested seed',\n245:       );\n246:     }\n247:     return Map<String, Object?>.from(raw);\n248:   }\n249: \n250:   /// Obtains a fresh scoped preview capability for [seedId].\n251:   ///\n252:   /// Callers must request a new capability per view: signed URLs are\n253:   /// short-lived and never persisted server-side.\n254:   Future<HostVideoPreview> getPreview({\n255:     required String partyId,\n256:     required String deviceId,\n257:     required String channelId,\n258:     required String seedId,\n259:   }) async {\n260:     final Object? raw;\n261:     try {\n262:       raw = await _call(kGetHostVideoPreview, <String, Object?>{\n263:         ..._scope(partyId, deviceId, channelId),\n264:         'seedId': seedId,\n265:       });\n266:     } on FirebaseFunctionsException catch (error) {\n267:       throw ManifestTransportException(\n268:         'getHostVideoPreview callable failed',\n269:         error,\n270:       );\n271:     }\n272:     if (raw is! Map ||\n273:         raw['seedId'] != seedId ||\n274:         raw['expiresAt'] is! String ||\n275:         raw['clips'] is! List) {\n276:       throw const FormatException(\n277:         'getHostVideoPreview response did not match the requested seed',\n278:       );\n279:     }\n280:     final List<HostVideoPreviewClip> clips = <HostVideoPreviewClip>[];\n281:     for (final Object? entry in raw['clips'] as List) {\n282:       if (entry is! Map ||\n283:           entry['cameraId'] is! String ||\n284:           entry['sha256'] is! String ||\n285:           entry['url'] is! String ||\n286:           entry['expiresAt'] is! String) {\n287:         throw const FormatException('Host preview clip is malformed');\n288:       }\n289:       final Uri? uri = Uri.tryParse(entry['url'] as String);\n290:       if (uri == null ||\n291:           uri.scheme != 'https' ||\n292:           uri.host.isEmpty ||\n293:           uri.userInfo.isNotEmpty) {\n294:         throw const FormatException('Host preview URL is invalid');\n295:       }\n296:       clips.add(\n297:         HostVideoPreviewClip(\n298:           cameraId: entry['cameraId'] as String,\n299:           sha256: entry['sha256'] as String,\n300:           url: uri,\n301:           expiresAt: entry['expiresAt'] as String,\n302:         ),\n303:       );\n304:     }\n305:     return HostVideoPreview(\n306:       seedId: seedId,\n307:       expiresAt: raw['expiresAt'] as String,\n308:       clips: clips,\n309:     );\n310:   }\n311: \n312:   /// Deletes the selected seed ids.\n313:   ///\n314:   /// Deletion is per selected seed id (see the library doc): preview +\n315:   /// delivery objects for those seeds are removed, an affected current\n316:   /// manifest is revoked, and accounting records are preserved. Only call\n317:   /// after the caller reconciles on authoritative success.\n318:   Future<Map<String, Object?>> deleteVideos({\n319:     required String partyId,\n320:     required String deviceId,\n321:     required String channelId,\n322:     required List<String> seedIds,\n323:   }) async {\n324:     final Object? raw;\n325:     try {\n326:       raw = await _call(kDeleteHostVideo, <String, Object?>{\n327:         ..._scope(partyId, deviceId, channelId),\n328:         'seedIds': seedIds,\n329:       });\n330:     } on FirebaseFunctionsException catch (error) {\n331:       throw ManifestTransportException(\n332:         'deleteHostVideo callable failed',\n333:         error,\n334:       );\n335:     }\n336:     if (raw is! Map ||\n337:         raw['deletedSeedIds'] is! List ||\n338:         raw['deletedObjects'] is! List ||\n339:         raw['revokedManifest'] is! bool) {\n340:       throw const FormatException('deleteHostVideo response is malformed');\n341:     }\n342:     return Map<String, Object?>.from(raw);\n343:   }\n344: }\n345: \n346: /// SDK-backed host media invoker, scoped to the four host callables.\n347: final class CallableHostMediaInvoker implements HostMediaCallableInvoker {\n348:   CallableHostMediaInvoker({required FirebaseFunctions functions})\n349:     : _functions = functions;\n350:   final FirebaseFunctions _functions;\n351: \n352:   static const Set<String> _allowed = <String>{\n353:     kListHostVideos,\n354:     kGenerateHostVideo,\n355:     kGetHostVideoPreview,\n356:     kDeleteHostVideo,\n357:   };\n358: \n359:   @override\n360:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n361:     if (!_allowed.contains(name)) throw ArgumentError.value(name, 'name');\n362:     return (await _functions.httpsCallable(name).call<Object?>(payload)).data;\n363:   }\n364: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/data/host_media_client.dart, lines 1-364\n1: /// Scoped host administration callables (seed catalog + previews).\n2: ///\n3: /// Every operation revalidates the registered host role and party/channel\n4: /// scope server-side (`assertRegisteredHostDevice`); guests get `FORBIDDEN`.\n5: /// Payload/response shapes mirror `backend/functions/src/contracts.ts`.\n6: ///\n7: /// Deletion granularity (pinned): `deleteHostVideo` deletes per selected\n8: /// seed id — the seed entries and their associated preview + delivery\n9: /// objects are removed, an affected current manifest whose jobId matches a\n10: /// deleted seed is revoked, and accounting records (costLogs / usage ledger\n11: /// rows) are never deleted. The list is reconciled only after authoritative\n12: /// success; failures leave local state untouched so they stay retryable.\n13: library;\n14: \n15: import 'dart:async';\n16: \n17: import 'package:cloud_functions/cloud_functions.dart';\n18: import 'package:infra_firestore/infra_firestore.dart'\n19:     show ManifestTransportException;\n20: \n21: const String kListHostVideos = 'listHostVideos';\n22: const String kGenerateHostVideo = 'generateHostVideo';\n23: const String kGetHostVideoPreview = 'getHostVideoPreview';\n24: const String kDeleteHostVideo = 'deleteHostVideo';\n25: \n26: /// Fixed generation presets supported by host administration.\n27: ///\n28: /// Pinned to `backend/functions/src/config.ts` (`CHEAP_DEMO_PRESET` /\n29: /// `CAMEO_DEMO_PRESET`). Generation presets keep producing 4 clips; the\n30: /// preset value is never caller-tunable beyond this fixed set.\n31: const String kCheapDemoPresetId = 'cheap_demo';\n32: const String kCameoDemoPresetId = 'cameo_demo';\n33: \n34: /// Callable boundary for host administration, separate from guest callables.\n35: abstract interface class HostMediaCallableInvoker {\n36:   Future<Object?> call(String name, Map<String, Object?> payload);\n37: }\n38: \n39: /// One server-backed seed catalog entry.\n40: final class HostSeedVideo {\n41:   const HostSeedVideo({\n42:     required this.seedId,\n43:     required this.partyId,\n44:     required this.channelId,\n45:     required this.status,\n46:     required this.jobId,\n47:     required this.createdAt,\n48:     required this.expiresAt,\n49:     required this.previewAvailable,\n50:     required this.cameraIds,\n51:   });\n52: \n53:   final String seedId;\n54:   final String partyId;\n55:   final String channelId;\n56: \n57:   /// Backend seed status: `queued`, `running`, `ready`, `failed`,\n58:   /// `deleted` (expiry surfaces through the same status sync).\n59:   final String status;\n60:   final String jobId;\n61:   final String createdAt;\n62:   final String expiresAt;\n63:   final bool previewAvailable;\n64:   final List<String> cameraIds;\n65: \n66:   @override\n67:   bool operator ==(Object other) =>\n68:       other is HostSeedVideo &&\n69:       other.seedId == seedId &&\n70:       other.partyId == partyId &&\n71:       other.channelId == channelId &&\n72:       other.status == status &&\n73:       other.jobId == jobId &&\n74:       other.previewAvailable == previewAvailable;\n75: \n76:   @override\n77:   int get hashCode =>\n78:       Object.hash(seedId, partyId, channelId, status, jobId, previewAvailable);\n79: \n80:   @override\n81:   String toString() => 'HostSeedVideo($seedId status=$status)';\n82: }\n83: \n84: /// One signed preview clip reference (signed on demand, never persisted).\n85: final class HostVideoPreviewClip {\n86:   const HostVideoPreviewClip({\n87:     required this.cameraId,\n88:     required this.sha256,\n89:     required this.url,\n90:     required this.expiresAt,\n91:   });\n92: \n93:   final String cameraId;\n94:   final String sha256;\n95:   final Uri url;\n96:   final String expiresAt;\n97: }\n98: \n99: /// Fresh scoped preview capability for one seed video.\n100: final class HostVideoPreview {\n101:   const HostVideoPreview({\n102:     required this.seedId,\n103:     required this.expiresAt,\n104:     required this.clips,\n105:   });\n106: \n107:   final String seedId;\n108:   final String expiresAt;\n109:   final List<HostVideoPreviewClip> clips;\n110: }\n111: \n112: /// Scoped host media client: list / generate / preview / delete.\n113: final class HostMediaClient {\n114:   HostMediaClient({\n115:     required HostMediaCallableInvoker invoker,\n116:     this.timeout = const Duration(seconds: 15),\n117:   }) : _invoker = invoker;\n118: \n119:   final HostMediaCallableInvoker _invoker;\n120:   final Duration timeout;\n121: \n122:   Map<String, Object?> _scope(\n123:     String partyId,\n124:     String deviceId,\n125:     String channelId,\n126:   ) => <String, Object?>{\n127:     'partyId': partyId,\n128:     'deviceId': deviceId,\n129:     'channelId': channelId,\n130:   };\n131: \n132:   Future<Object?> _call(String name, Map<String, Object?> payload) async {\n133:     try {\n134:       return await _invoker.call(name, payload).timeout(timeout);\n135:     } on TimeoutException catch (error) {\n136:       throw ManifestTransportException('$name timed out', error);\n137:     }\n138:   }\n139: \n140:   /// Lists the server-backed seed catalog for the registered host scope.\n141:   Future<List<HostSeedVideo>> listVideos({\n142:     required String partyId,\n143:     required String deviceId,\n144:     required String channelId,\n145:   }) async {\n146:     final Object? raw;\n147:     try {\n148:       raw = await _call(kListHostVideos, _scope(partyId, deviceId, channelId));\n149:     } on FirebaseFunctionsException catch (error) {\n150:       throw ManifestTransportException('listHostVideos callable failed', error);\n151:     }\n152:     if (raw is! Map || raw['videos'] is! List) {\n153:       throw const FormatException('Host video list response is malformed');\n154:     }\n155:     final List<HostSeedVideo> videos = <HostSeedVideo>[];\n156:     for (final Object? entry in raw['videos'] as List) {\n157:       videos.add(_parseSeed(entry, partyId: partyId, channelId: channelId));\n158:     }\n159:     return videos;\n160:   }\n161: \n162:   HostSeedVideo _parseSeed(\n163:     Object? entry, {\n164:     required String partyId,\n165:     required String channelId,\n166:   }) {\n167:     if (entry is! Map) {\n168:       throw const FormatException('Host seed entry is malformed');\n169:     }\n170:     String requiredString(String key) {\n171:       final Object? value = entry[key];\n172:       if (value is! String || value.isEmpty) {\n173:         throw FormatException('Host seed entry field \"$key\" is malformed');\n174:       }\n175:       return value;\n176:     }\n177: \n178:     final String seedParty = requiredString('partyId');\n179:     final String seedChannel = requiredString('channelId');\n180:     if (seedParty != partyId || seedChannel != channelId) {\n181:       throw const FormatException(\n182:         'Host seed entry is outside the registered party and channel',\n183:       );\n184:     }\n185:     final Object? cameras = entry['cameraIds'];\n186:     if (entry['previewAvailable'] is! bool || cameras is! List) {\n187:       throw const FormatException('Host seed entry fields are malformed');\n188:     }\n189:     return HostSeedVideo(\n190:       seedId: requiredString('seedId'),\n191:       partyId: seedParty,\n192:       channelId: seedChannel,\n193:       status: requiredString('status'),\n194:       jobId: requiredString('jobId'),\n195:       createdAt: requiredString('createdAt'),\n196:       expiresAt: requiredString('expiresAt'),\n197:       previewAvailable: entry['previewAvailable'] as bool,\n198:       cameraIds: <String>[for (final Object? c in cameras) c.toString()],\n199:     );\n200:   }\n201: \n202:   /// Enqueues fixed-preset generation for [seedId].\n203:   ///\n204:   /// [idempotencyKey] must be stable per seed id across retries so a retry\n205:   /// reuses the queued job (`created: false`) instead of enqueueing another\n206:   /// task. [presetId] defaults to the supported `cheap_demo` preset.\n207:   Future<Map<String, Object?>> generateVideo({\n208:     required String partyId,\n209:     required String deviceId,\n210:     required String channelId,\n211:     required String seedId,\n212:     required String idempotencyKey,\n213:     String presetId = kCheapDemoPresetId,\n214:     String? guestMediaId,\n215:   }) async {\n216:     if (presetId != kCheapDemoPresetId && presetId != kCameoDemoPresetId) {\n217:       throw ArgumentError.value(\n218:         presetId,\n219:         'presetId',\n220:         'Only the fixed generation presets are supported',\n221:       );\n222:     }\n223:     final Object? raw;\n224:     try {\n225:       raw = await _call(kGenerateHostVideo, <String, Object?>{\n226:         ..._scope(partyId, deviceId, channelId),\n227:         'seedId': seedId,\n228:         'idempotencyKey': idempotencyKey,\n229:         'presetId': presetId,\n230:         if (guestMediaId != null) 'guestMediaId': guestMediaId,\n231:       });\n232:     } on FirebaseFunctionsException catch (error) {\n233:       throw ManifestTransportException(\n234:         'generateHostVideo callable failed',\n235:         error,\n236:       );\n237:     }\n238:     if (raw is! Map ||\n239:         raw['seedId'] != seedId ||\n240:         raw['jobId'] is! String ||\n241:         raw['state'] is! String ||\n242:         raw['created'] is! bool) {\n243:       throw const FormatException(\n244:         'generateHostVideo response did not match the requested seed',\n245:       );\n246:     }\n247:     return Map<String, Object?>.from(raw);\n248:   }\n249: \n250:   /// Obtains a fresh scoped preview capability for [seedId].\n251:   ///\n252:   /// Callers must request a new capability per view: signed URLs are\n253:   /// short-lived and never persisted server-side.\n254:   Future<HostVideoPreview> getPreview({\n255:     required String partyId,\n256:     required String deviceId,\n257:     required String channelId,\n258:     required String seedId,\n259:   }) async {\n260:     final Object? raw;\n261:     try {\n262:       raw = await _call(kGetHostVideoPreview, <String, Object?>{\n263:         ..._scope(partyId, deviceId, channelId),\n264:         'seedId': seedId,\n265:       });\n266:     } on FirebaseFunctionsException catch (error) {\n267:       throw ManifestTransportException(\n268:         'getHostVideoPreview callable failed',\n269:         error,\n270:       );\n271:     }\n272:     if (raw is! Map ||\n273:         raw['seedId'] != seedId ||\n274:         raw['expiresAt'] is! String ||\n275:         raw['clips'] is! List) {\n276:       throw const FormatException(\n277:         'getHostVideoPreview response did not match the requested seed',\n278:       );\n279:     }\n280:     final List<HostVideoPreviewClip> clips = <HostVideoPreviewClip>[];\n281:     for (final Object? entry in raw['clips'] as List) {\n282:       if (entry is! Map ||\n283:           entry['cameraId'] is! String ||\n284:           entry['sha256'] is! String ||\n285:           entry['url'] is! String ||\n286:           entry['expiresAt'] is! String) {\n287:         throw const FormatException('Host preview clip is malformed');\n288:       }\n289:       final Uri? uri = Uri.tryParse(entry['url'] as String);\n290:       if (uri == null ||\n291:           uri.scheme != 'https' ||\n292:           uri.host.isEmpty ||\n293:           uri.userInfo.isNotEmpty) {\n294:         throw const FormatException('Host preview URL is invalid');\n295:       }\n296:       clips.add(\n297:         HostVideoPreviewClip(\n298:           cameraId: entry['cameraId'] as String,\n299:           sha256: entry['sha256'] as String,\n300:           url: uri,\n301:           expiresAt: entry['expiresAt'] as String,\n302:         ),\n303:       );\n304:     }\n305:     return HostVideoPreview(\n306:       seedId: seedId,\n307:       expiresAt: raw['expiresAt'] as String,\n308:       clips: clips,\n309:     );\n310:   }\n311: \n312:   /// Deletes the selected seed ids.\n313:   ///\n314:   /// Deletion is per selected seed id (see the library doc): preview +\n315:   /// delivery objects for those seeds are removed, an affected current\n316:   /// manifest is revoked, and accounting records are preserved. Only call\n317:   /// after the caller reconciles on authoritative success.\n318:   Future<Map<String, Object?>> deleteVideos({\n319:     required String partyId,\n320:     required String deviceId,\n321:     required String channelId,\n322:     required List<String> seedIds,\n323:   }) async {\n324:     final Object? raw;\n325:     try {\n326:       raw = await _call(kDeleteHostVideo, <String, Object?>{\n327:         ..._scope(partyId, deviceId, channelId),\n328:         'seedIds': seedIds,\n329:       });\n330:     } on FirebaseFunctionsException catch (error) {\n331:       throw ManifestTransportException(\n332:         'deleteHostVideo callable failed',\n333:         error,\n334:       );\n335:     }\n336:     if (raw is! Map ||\n337:         raw['deletedSeedIds'] is! List ||\n338:         raw['deletedObjects'] is! List ||\n339:         raw['revokedManifest'] is! bool) {\n340:       throw const FormatException('deleteHostVideo response is malformed');\n341:     }\n342:     return Map<String, Object?>.from(raw);\n343:   }\n344: }\n345: \n346: /// SDK-backed host media invoker, scoped to the four host callables.\n347: final class CallableHostMediaInvoker implements HostMediaCallableInvoker {\n348:   CallableHostMediaInvoker({required FirebaseFunctions functions})\n349:     : _functions = functions;\n350:   final FirebaseFunctions _functions;\n351: \n352:   static const Set<String> _allowed = <String>{\n353:     kListHostVideos,\n354:     kGenerateHostVideo,\n355:     kGetHostVideoPreview,\n356:     kDeleteHostVideo,\n357:   };\n358: \n359:   @override\n360:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n361:     if (!_allowed.contains(name)) throw ArgumentError.value(name, 'name');\n362:     return (await _functions.httpsCallable(name).call<Object?>(payload)).data;\n363:   }\n364: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3361170afa5fe348bf8fa5257"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/data/host_media_client.dart\"}"},"time":{"start":1793463629665,"end":1793463630973}}}}
