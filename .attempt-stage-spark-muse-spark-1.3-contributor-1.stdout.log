l get hasError;\n54: \n55:   /// Human-readable error, when [hasError] is true.\n56:   String? get errorDescription;\n57: \n58:   /// Video surface for this tile (already sized/covered by the caller).\n59:   Widget buildSurface(BuildContext context);\n60: \n61:   /// Loop playback (the wall loops every clip).\n62:   Future<void> setLooping(bool looping);\n63: \n64:   /// Volume in `0..1`; the wall is always muted (`0`).\n65:   Future<void> setVolume(double volume);\n66: \n67:   /// Start playback.\n68:   Future<void> play();\n69: \n70:   /// Registers a change listener (exposed so the tile can react to async\n71:   /// decoder errors that arrive after initialization).\n72:   void addListener(VoidCallback listener);\n73: \n74:   /// Removes a previously added listener.\n75:   void removeListener(VoidCallback listener);\n76: \n77:   /// Releases the decoder. Called exactly once by the owning tile.\n78:   Future<void> dispose();\n79: }\n80: \n81: /// Builds a [TileVideoController] for one wall tile.\n82: ///\n83: /// Injected so widget tests can substitute a fake decoder while the tile,\n84: /// wall chrome, focus handling and error fallback stay on their real paths.\n85: typedef TileVideoControllerFactory =\n86:     TileVideoController Function({\n87:       required String cameraId,\n88:       required TileMediaSource source,\n89:     });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192aab76e76c3b5709e4bd09d5d90"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/playback/tile_video_controller.dart\"}"},"time":{"start":1793462024129,"end":1793462025152}}}}
