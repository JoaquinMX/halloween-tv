EN\", \"Only a registered TV may mint a host invite.\");\n35:   }\n36:   return registered;\n37: }\n38: export async function assertRegisteredPartyDevice(\n39:   db: Firestore,\n40:   identity: Identity,\n41: ): Promise<RegisteredContext> {\n42:   const partyRef = db.doc(`parties/${identity.partyId}`);\n43:   const deviceRef = partyRef.collection(\"devices\").doc(identity.deviceId);\n44:   const [partySnap, deviceSnap] = await Promise.all([partyRef.get(), deviceRef.get()]);\n45:   if (!partySnap.exists || !deviceSnap.exists) {\n46:     throw new BackendError(\"FORBIDDEN\", \"Party/device pair is not registered.\");\n47:   }\n48:   const party = partySnap.data()!;\n49:   const device = deviceSnap.data()!;\n50:   if (party.status !== \"active\" || device.status !== \"active\" || device.partyId !== identity.partyId) {\n51:     throw new BackendError(\"FORBIDDEN\", \"Party/device pair is not active.\");\n52:   }\n53:   const channelId = identity.channelId || String(party.activeChannelId ?? \"\");\n54:   if (!channelId || party.activeChannelId !== channelId) {\n55:     throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n56:   }\n57:   const channelRef = partyRef.collection(\"channels\").doc(channelId);\n58:   const channelSnap = await channelRef.get();\n59:   if (!channelSnap.exists || channelSnap.data()?.partyId !== identity.partyId || channelSnap.data()?.status !== \"active\") {\n60:     throw new BackendError(\"FORBIDDEN\", \"Channel is not registered for this party.\");\n61:   }\n62:   return {\n63:     partyId: identity.partyId,\n64:     deviceId: identity.deviceId,\n65:     channelId,\n66:     party,\n67:     device,\n68:     channel: channelSnap.data()!,\n69:   };\n70: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/auth.ts, lines 1-70\n1: import { Firestore } from \"firebase-admin/firestore\";\n2: import { Backend