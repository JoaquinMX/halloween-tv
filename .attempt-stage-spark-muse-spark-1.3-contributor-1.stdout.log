t = 2,\n475:   ): Promise<void> {\n476:     const ref = jobRef(this.db, partyId, jobId);\n477:     await this.db.runTransaction(async (transaction) => {\n478:       const snapshot = await transaction.get(ref);\n479:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n480:       const job = snapshot.data()!;\n481:       transaction.update(ref, {\n482:         stagedOutputs: { ...(job.stagedOutputs ?? {}), [cameraId]: staged },\n483:         cameraResults: {\n484:           ...(job.cameraResults ?? {}),\n485:           [cameraId]: { secondsOut, secondsIn: 0, creditsCharged: null, providerState: \"FIXTURE\" },\n486:         },\n487:         timestamp: FieldValue.serverTimestamp(),\n488:       });\n489:     });\n490:   }\n491: \n492:   /** Consent withdrawal fails the bound job closed and releases the party budget. */\n493:   async failForWithdrawnConsent(partyId: string, jobId: string): Promise<void> {\n494:     const ref = jobRef(this.db, partyId, jobId);\n495:     const budget = budgetRef(this.db, partyId);\n496:     await this.db.runTransaction(async (transaction) => {\n497:       const [snapshot, budgetSnapshot] = await Promise.all([transaction.get(ref), transaction.get(budget)]);\n498:       if (!snapshot.exists) return;\n499:       transaction.update(ref, {\n500:         state: \"failed\",\n501:         status: \"failed\",\n502:         errorCode: \"FORBIDDEN\",\n503:         reconciliationReason: \"GUEST_CONSENT_WITHDRAWN\",\n504:         failedAt: FieldValue.serverTimestamp(),\n505:         timestamp: FieldValue.serverTimestamp(),\n506:         workerLeaseUntilMs: 0,\n507:       });\n508:       if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === jobId) {\n509:         transaction.update(budget, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n510:       }\n511:     });\n512:   }\n513: \n514:   async recordProviderFailure(input: RequestGenerationInput, cameraId: