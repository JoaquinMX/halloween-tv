his.message,\n85:   );\n86: \n87:   @override\n88:   bool operator ==(Object other) =>\n89:       other is HostSessionState &&\n90:       other.status == status &&\n91:       other.binding == binding &&\n92:       other.message == message &&\n93:       _videoIds(other.videos).join(',') == _videoIds(videos).join(',');\n94: \n95:   @override\n96:   int get hashCode => Object.hash(status, binding, message, videos.length);\n97: \n98:   @override\n99:   String toString() => 'HostSessionState($status, videos: ${videos.length})';\n100: \n101:   static List<String> _videoIds(List<HostSeedVideo> videos) => <String>[\n102:     for (final HostSeedVideo v in videos) '${v.seedId}:${v.status}',\n103:   ];\n104: }\n105: \n106: /// Sanitized host-join failure for the entry screen.\n107: ///\n108: /// Carries only the fixed user-presentable message (never raw backend\n109: /// detail); [toString] returns the message itself.\n110: final class HostJoinException implements Exception {\n111:   const HostJoinException(this.message);\n112:   final String message;\n113: \n114:   @override\n115:   String toString() => message;\n116: }\n117: \n118: /// Host administration session bound to one party/device/channel at a time.\n119: final class HostSession {\n120:   HostSession({\n121:     required HostJoinClient joinClient,\n122:     required HostMediaClient mediaClient,\n123:     Duration pollInterval = const Duration(seconds: 15),\n124:     Random? random,\n125:   }) : _joinClient = joinClient,\n126:        _mediaClient = mediaClient,\n127:        _pollInterval = pollInterval,\n128:        _random = random ?? Random.secure();\n129: \n130:   final HostJoinClient _joinClient;\n131:   final HostMediaClient _mediaClient;\n132:   final Duration _pollInterval;\n133:   final Random _random;\n134: \n135:   final StreamController<HostSessionState> _states =\n136:       StreamController<HostSessionState>.broadcast();\n137: \n138:   HostSessionState _state = const HostSessionState.idle();\n139: \n140:   /// Current immutable snapshot.\n141:   HostSessionState get state => _state;\n142: \n143:   /// Broadcast of state snapshots.\n144:   Stream<HostSessionState> get states => _states.stream;\n145: \n146:   /// Bound host identity, or `null` when idle.\n147:   GuestJoinData? get binding => _state.binding;\n148: \n149:   /// Current or last-known seed catalog.\n150:   List<HostSeedVideo> get videos =>\n151:       List<HostSeedVideo>.unmodifiable(_state.videos);\n152: \n153:   int _generation = 0;\n154:   bool _disposed = false;\n155:   bool _busy = false;\n156:   Timer? _pollTimer;\n157: \n158:   /// Stable idempotency keys per seed id (retries reuse the queued job).\n159:   final Map<String, String> _idempotencyKeys = <String, String>{};\n160: \n161:   void _emit(HostSessionState next) {\n162:     _state = next;\n163:     if (!_states.isClosed) {\n164:       _states.add(next);\n165:     }\n166:   }\n167: \n168:   String _mintIdempotencyKey() {\n169:     final List<int> bytes = List<int>.generate(16, (_) => _random.nextInt(256));\n170:     return bytes.map((int b) => b.toRadixString(16).padLeft(2, '0')).join();\n171:   }\n172: \n173:   /// Joins as a host [data], replacing any previous session.\n174:   ///\n175:   /// Throws a sanitized [HostJoinException] when the invite cannot be\n176:   /// redeemed (the emitted state carries the same fixed message). Guest\n177:   /// payloads are rejected before any network call.\n178:   Future<void> join(GuestJoinData data) async {\n179:     if (_disposed) return;\n180:     if (data.role != JoinRole.host || data.inviteToken == null) {\n181:       throw const HostJoinException(\n182:         'This host entry needs a host invitation. Join as a guest instead.',\n183:       );\n184:     }\n185:     _generation++;\n186:     final int generation = _generation;\n187:     _stopPolling();\n188:     _busy = false;\n189:     _emit(\n190:       HostSessionState(\n191:         status: HostSessionStatus.loading,\n192:         binding: data,\n193:         message: 'Redeeming host invite for ${data.partyId.value}',\n194:       ),\n195:     );\n196:     try {\n197:       await _joinClient.redeem(\n198:         partyId: data.partyId.value,\n199:         deviceId: data.deviceId.value,\n200:         channelId: data.channelId,\n201:         inviteToken: data.inviteToken!,\n202:       );\n203:     } on Object catch (error) {\n204:       if (generation == _generation && !_disposed) {\n205:         final ManifestFailure failure = error is ManifestFailure\n206:             ? error\n207:             : ManifestFailure.classify(error);\n208:         developer.log(\n209:           'HostSession join failed: $error',\n210:           name: 'companion.host_session',\n211:         );\n212:         final HostSessionStatus status = switch (failure.kind) {\n213:           ManifestFailureKind.forbidden ||\n214:           ManifestFailureKind.unauthenticated => HostSessionStatus.denied,\n215:           ManifestFailureKind.invalidArgument ||\n216:           ManifestFailureKind.malformed ||\n217:           ManifestFailureKind.configuration => HostSessionStatus.invalidData,\n218:           _ => HostSessionStatus.unavailable,\n219:         };\n220:         _emit(\n221:           HostSessionState(\n222:             status: status,\n223:             binding: data,\n224:             message: failure.message,\n225:           ),\n226:         );\n227:         throw HostJoinException(failure.message);\n228:       }\n229:       throw const HostJoinException('Could not reach the backend.');\n230:     }\n231:     if (generation != _generation || _disposed) return;\n232:     await _loadCatalog(data, generation);\n233:     if (generation != _generation || _disposed) return;\n234:     _startPolling();\n235:   }\n236: \n237:   Future<void> _loadCatalog(GuestJoinData data, int generation) async {\n238:     try {\n239:       final List<HostSeedVideo> listed = await _mediaClient.listVideos(\n240:         partyId: data.partyId.value,\n241:         deviceId: data.deviceId.value,\n242:         channelId: data.channelId,\n243:       );\n244:       if (generation != _generation || _disposed) return;\n245:       _emit(\n246:         HostSessionState(\n247:           status: HostSessionStatus.ready,\n248:           binding: data,\n249:           videos: listed,\n250:         ),\n251:       );\n252:     } on Object catch (error) {\n253:       if (generation != _generation || _disposed) return;\n254:       developer.log(\n255:         'HostSession catalog load failed: $error',\n256:         name: 'companion.host_session',\n257:       );\n258:       final ManifestFailure failure = ManifestFailure.classify(error);\n259:       if (_state.videos.isNotEmpty) {\n260:         _emit(\n261:           HostSessionState(\n262:             status: HostSessionStatus.stale,\n263:             binding: data,\n264:             videos: _state.videos,\n265:             message: failure.message,\n266:           ),\n267:         );\n268:         return;\n269:       }\n270:       _emit(\n271:         HostSessionState(\n272:           status: HostSessionStatus.unavailable,\n273:           binding: data,\n274:           message: failure.message,\n275:         ),\n276:       );\n277:     }\n278:   }\n279: \n280:   /// Refreshes the seed catalog without overlapping in-flight work.\n281:   Future<void> refresh() async {\n282:     if (_disposed || _busy) return;\n283:     final GuestJoinData? bound = _state.binding;\n284:     if (bound == null || _state.status == HostSessionStatus.idle) return;\n285:     _busy = true;\n286:     _generation++;\n287:     final int generation = _generation;\n288:     try {\n289:       await _loadCatalog(bound, generation);\n290:     } finally {\n291:       _busy = false;\n292:     }\n293:   }\n294: \n295:   /// Enqueues fixed-preset generation for [seedId].\n296:   ///\n297:   /// The idempotency key is stable per seed id: retries reuse the queued\n298:   /// job (`created: false`) instead of enqueueing another task. Returns the\n299:   /// server result. Failures throw and leave local state untouched.\n300:   Future<Map<String, Object?>> generate(\n301:     String seedId, {\n302:     String presetId = kCheapDemoPresetId,\n303:     String? guestMediaId,\n304:   }) async {\n305:     final GuestJoinData? bound = _state.binding;\n306:     if (bound == null || _disposed) {\n307:       throw StateError('Join as host before generating video');\n308:     }\n309:     final String key = _idempotencyKeys.putIfAbsent(\n310:       seedId,\n311:       _mintIdempotencyKey,\n312:     );\n313:     final Map<String, Object?> result = await _mediaClient.generateVideo(\n314:       partyId: bound.partyId.value,\n315:       deviceId: bound.deviceId.value,\n316:       channelId: bound.channelId,\n317:       seedId: seedId,\n318:       idempotencyKey: key,\n319:       presetId: presetId,\n320:       guestMediaId: guestMediaId,\n321:     );\n322:     await refresh();\n323:     return result;\n324:   }\n325: \n326:   /// Obtains a fresh scoped preview capability for [seedId].\n327:   ///\n328:   /// Every view requests a new capability: signed URLs are short-lived and\n329:   /// never persisted.\n330:   Future<HostVideoPreview> preview(String seedId) {\n331:     final GuestJoinData? bound = _state.binding;\n332:     if (bound == null || _disposed) {\n333:       throw StateError('Join as host before previewing video');\n334:     }\n335:     return _mediaClient.getPreview(\n336:       partyId: bound.partyId.value,\n337:       deviceId: bound.deviceId.value,\n338:       channelId: bound.channelId,\n339:       seedId: seedId,\n340:     );\n341:   }\n342: \n343:   /// Deletes [seedIds] and reconciles the list after authoritative success.\n344:   ///\n345:   /// Failures throw and leave the local list untouched so they stay\n346:   /// retryable.\n347:   Future<Map<String, Object?>> deleteVideos(List<String> seedIds) async {\n348:     final GuestJoinData? bound = _state.binding;\n349:     if (bound == null || _disposed) {\n350:       throw StateError('Join as host before deleting video');\n351:     }\n352:     final Map<String, Object?> result = await _mediaClient.deleteVideos(\n353:       partyId: bound.partyId.value,\n354:       deviceId: bound.deviceId.value,\n355:       channelId: bound.channelId,\n356:       seedIds: seedIds,\n357:     );\n358:     await refresh();\n359:     return result;\n360:   }\n361: \n362:   void _startPolling() {\n363:     _stopPolling();\n364:     if (_disposed) return;\n365:     _pollTimer = Timer.periodic(_pollInterval, (_) {\n366:       unawaited(refresh());\n367:     });\n368:   }\n369: \n370:   void _stopPolling() {\n371:     _pollTimer?.cancel();\n372:     _pollTimer = null;\n373:   }\n374: \n375:   /// Suspends polling for backgrounding; the retained catalog stays\n376:   /// readable as the current snapshot.\n377:   Future<void> suspend() async {\n378:     if (_disposed) return;\n379:     _generation++;\n380:     _stopPolling();\n381:     _busy = false;\n382:     final GuestJoinData? bound = _state.binding;\n383:     if (bound == null) return;\n384:     if (_state.videos.isNotEmpty && _state.status == HostSessionStatus.ready) {\n385:       _emit(\n386:         HostSessionState(\n387:           status: HostSessionStatus.stale,\n388:           binding: bound,\n389:           videos: _state.videos,\n390:           message: 'Suspended; showing last-known catalog',\n391:         ),\n392:       );\n393:     }\n394:   }\n395: \n396:   /// Resumes polling with a fresh catalog read after [suspend].\n397:   Future<void> resume() async {\n398:     if (_disposed) return;\n399:     final GuestJoinData? bound = _state.binding;\n400:     if (bound == null || _state.status == HostSessionStatus.idle) return;\n401:     _startPolling();\n402:     await refresh();\n403:   }\n404: \n405:   /// Leaves the host session: stops polling and clears identity + catalog.\n406:   Future<void> leave() async {\n407:     _generation++;\n408:     _stopPolling();\n409:     _busy = false;\n410:     _idempotencyKeys.clear();\n411:     if (_disposed) return;\n412:     _emit(const HostSessionState.idle());\n413:   }\n414: \n415:   /// Releases polling and the state broadcast.\n416:   Future<void> dispose() async {\n417:     if (_disposed) return;\n418:     _disposed = true;\n419:     _generation++;\n420:     _stopPolling();\n421:     if (!_states.isClosed) {\n422:       await _states.close();\n423:     }\n424:   }\n425: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c38f5570ea8935de9a33e98aee"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/lib/src/session/host_session.dart\"}"},"time":{"start":1793463652221,"end":1793463653066}}}}
