eldValue.serverTimestamp() });\n551:   }\n552: \n553:   currentManifestRef(partyId: string, channelId: string) {\n554:     return currentManifestRef(this.db, partyId, channelId);\n555:   }\n556: \n557:   jobDocumentRef(partyId: string, jobId: string) {\n558:     return jobRef(this.db, partyId, jobId);\n559:   }\n560: \n561:   plannedObjectPath(partyId: string, channelId: string, version: number, cameraId: CameraId): string {\n562:     return deliveryObjectPath(partyId, channelId, version, cameraId);\n563:   }\n564: }\n565: "}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3d452769da10bf32dbf9f65e0"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/generation_store.ts\"}"},"time":{"start":1793463669797,"end":1793463670158}}}}
