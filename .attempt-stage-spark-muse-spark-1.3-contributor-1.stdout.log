:     return min;\n154:   }\n155:   if (value > max) {\n156:     return max;\n157:   }\n158:   return value;\n159: }\n[Output truncated. Continue reading with offset: 160]"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a6e869732094dbbbce1e0eb5d5"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/packages/core_playlist/lib/core_playlist.dart\",\"offset\":50,\"limit\":110}"},"time":{"start":1793461774527,"end":1793461775741}}}}
