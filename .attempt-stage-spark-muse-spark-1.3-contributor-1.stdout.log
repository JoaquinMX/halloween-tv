 leadingZeros = parseJoinPartyInput({ partyId: \"party\", deviceId: \"p-x\", channelId: \"main\", joinPin: \"004201\" });\n93:   assert.equal(leadingZeros.joinPin, \"004201\");\n94: });\n95: \n96: test(\"registered callable enforces one in-flight job, idempotency, sanitized errors and zero retries\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n97:   const { app, db, bucket } = await createEmulatorContext();\n98:   const partyId = randomPartyId();\n99:   const deviceId = \"tv-living-room\";\n100:   const channelId = \"main\";\n101:   let enqueued = 0;\n102:   try {\n103:     await seedParty(db, partyId, deviceId, channelId);\n104:     const services = createDeliveryServices({ db, bucket, enqueueGeneration: async () => { enqueued += 1; } });\n105:     const input = { partyId, deviceId, channelId, jobId: \"job-1\", idempotencyKey: \"job-1\", presetId: \"cheap_demo\" };\n106:     const created = await services.requestGeneration(input);\n107:     assert.equal(created.state, \"queued\");\n108:     assert.equal(created.created, true);\n109:     const duplicate = await services.requestGeneration(input);\n110:     assert.equal(duplicate.created, false);\n111:     assert.equal(enqueued, 1);\n112: \n113:     await assert.rejects(\n114:       services.requestGeneration({ ...input, jobId: \"job-2\", idempotencyKey: \"job-2\" }),\n115:       (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\",\n116:     );\n117:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId: \"job-1\", idempotencyKey: \"job-1\" }),\n118:       (error: unknown) => error instanceof BackendError && error.errorCode === \"PROVIDER_UNAVAILABLE\");\n119:     const job = (await db.doc(`parties/${partyId}/jobs/job-1`).get()).data();\n120:     const cost = (await db.doc(`parties/${partyId}/costLogs/job-1`).get()).data();\n121:     assert.equal(job?.state, \"failed\");\n122:     assert.equal(job?.errorCode, \"PROVIDER_UNAVAILABLE\");\n123:     assert.equal(job?.modelId, \"wan3.0-video\");\n124:     assert.equal(cost?.credits_charged, 0);\n125:     assert.equal(cost?.success, false);\n126:     assert.equal(cost?.partyId, partyId);\n127:   } finally {\n128:     await clearParty(db, bucket, partyId);\n129:     await disposeEmulatorContext(app);\n130:   }\n131: });\n132: \n133: test(\"guest-bound generation contracts keep cheap_demo locked with a validated image reference\", () => {\n134:   const reference = {\n135:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n136:     sha256: \"a\".repeat(64),\n137:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n138:   };\n139:   const parsed = parseRequestGeneration({\n140:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\",\n141:     idempotencyKey: \"job-1\", presetId: \"cheap_demo\", guestMediaId: \"gsub-1\",\n142:   });\n143:   assert.equal(parsed.guestMediaId, \"gsub-1\");\n144:   expectCode(() => parseRequestGeneration({\n145:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\",\n146:     idempotencyKey: \"job-1\", presetId: \"cheap_demo\", guestMediaId: \"\",\n147:   }), \"INVALID_ARGUMENT\");\n148:   const request = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", reference);\n149:   assert.equal(request.modelId, \"wan3.0-video\");\n150:   assert.equal(request.resolution, \"480P\");\n151:   assert.equal(request.secondsOut, 2);\n152:   assert.equal(request.audio, false);\n153:   assert.equal(request.outputs, 1);\n154:   assert.deepEqual(request.referenceImage, reference);\n155:   const textOnly = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\");\n156:   assert.equal(textOnly.referenceImage, undefined);\n157:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", resolution: \"720P\" }), \"INVALID_ARGUMENT\");\n158:   expectCode(() => validateGuestImageReference({ ...reference, objectPath: \"parties/other/photo.jpg\" }), \"INVALID_ARGUMENT\");\n159:   expectCode(() => validateGuestImageReference({ ...reference, sha256: \"zzz\" }), \"INVALID_ARGUMENT\");\n160:   expectCode(() => validateGuestImageReference({ ...reference, consentRevision: \"\" }), \"INVALID_ARGUMENT\");\n161: });\n162: \n163: test(\"a supplied fixture directory never silently forces fake mode over alibaba\", () => {\n164:   const previous = process.env.VIDEO_GENERATION_PROVIDER;\n165:   try {\n166:     process.env.VIDEO_GENERATION_PROVIDER = \"alibaba\";\n167:     process.env.ALIBABA_API_KEY = \"fixture-key\";\n168:     process.env.ALIBABA_WORKSPACE_ID = \"workspace\";\n169:     const alibaba = createVideoGenerationProviderFromEnvironment(\"/packaged/runtime/fixtures\");\n170:     assert.ok(alibaba instanceof AlibabaVideoGenerationPort);\n171:     process.env.VIDEO_GENERATION_PROVIDER = \"fake\";\n172:     const fake = createVideoGenerationProviderFromEnvironment(\"/packaged/runtime/fixtures\");\n173:     assert.ok(fake instanceof FakeVideoGenerationPort);\n174:   } finally {\n175:     if (previous === undefined) delete process.env.VIDEO_GENERATION_PROVIDER;\n176:     else process.env.VIDEO_GENERATION_PROVIDER = previous;\n177:     delete process.env.ALIBABA_API_KEY;\n178:     delete process.env.ALIBABA_WORKSPACE_ID;\n179:   }\n180: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c355837294aba26bf60601eb6a"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/contracts.test.ts\"}"},"time":{"start":1793463637455,"end":1793463637705}}}}
