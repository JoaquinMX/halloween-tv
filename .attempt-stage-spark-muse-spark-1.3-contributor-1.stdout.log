{"type":"tool_use","timestamp":1793462826106,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192b6d1b2001wp0RA0ImJbWAdE","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192b6cb2b001h9BMhlxyw8qDJI","type":"tool","id":"call_01a192b6d0137276a9b49010a1595ccf","tool":"write","state":{"status":"completed","input":{"content":"/// Adaptive focus traversal tests: 1/2/4 layouts share four stable nodes.\nlibrary;\n\nimport 'package:flutter/services.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:tv_app/src/wall/wall_focus.dart';\n\nvoid main() {\n  group('WallMove.targetFor', () {\n    test('four-grid blocks edges instead of wrapping', () {\n      expect(WallMove.targetFor(0, WallMove.left), -1);\n      expect(WallMove.targetFor(0, WallMove.up), -1);\n      expect(WallMove.targetFor(1, WallMove.right), -1);\n      expect(WallMove.targetFor(2, WallMove.left), -1);\n      expect(WallMove.targetFor(3, WallMove.right), -1);\n      expect(WallMove.targetFor(3, WallMove.down), -1);\n      expect(\n        WallMove.targetFor(0, WallMove.right, columns: 2, tiles: 4),\n        1,\n      );\n      expect(\n        WallMove.targetFor(1, WallMove.down, columns: 2, tiles: 4),\n        3,\n      );\n    });\n\n    test('two-tile row moves horizontally only', () {\n      expect(\n        WallMove.targetFor(0, WallMove.right, columns: 2, tiles: 2),\n        1,\n      );\n      expect(\n        WallMove.targetFor(1, WallMove.left, columns: 2, tiles: 2),\n        0,\n      );\n      expect(\n        WallMove.targetFor(0, WallMove.left, columns: 2, tiles: 2),\n        -1,\n      );\n      expect(\n        WallMove.targetFor(1, WallMove.right, columns: 2, tiles: 2),\n        -1,\n      );\n      expect(\n        WallMove.targetFor(0, WallMove.down, columns: 2, tiles: 2),\n        -1,\n      );\n      expect(\n        WallMove.targetFor(1, WallMove.up, columns: 2, tiles: 2),\n        -1,\n      );\n    });\n\n    test('a single tile blocks every move', () {\n      for (final WallMove move in WallMove.values) {\n        expect(\n          WallMove.targetFor(0, move, columns: 1, tiles: 1),\n          -1,\n          reason: '$move must be blocked for a single tile',\n        );\n      }\n      expect(WallMove.targetFor(3, WallMove.left, columns: 1, tiles: 1), -1);\n    });\n  });\n\n  group('WallFocusController active layouts', () {\n    test('defaults to the full 2x2 grid', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      expect(focus.activeTiles, 4);\n      expect(focus.activeColumns, 2);\n      expect(focus.nodes, hasLength(4));\n    });\n\n    test('two-tile layout traverses one row and ignores the rest', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      focus.setActiveLayout(tiles: 2, columns: 2);\n      expect(focus.activeTiles, 2);\n\n      focus.markFocused(0);\n      expect(focus.moveFrom(0, WallMove.right), 1);\n      expect(focus.moveFrom(1, WallMove.right), -1);\n      expect(focus.moveFrom(1, WallMove.down), -1);\n      expect(focus.moveFrom(0, WallMove.up), -1);\n\n      // Out-of-active-range slots are ignored, not focused.\n      focus.focusTile(3);\n      expect(focus.focusedIndex, 1);\n    });\n\n    test('single-tile layout blocks everything', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      focus.setActiveLayout(tiles: 1, columns: 1);\n\n      focus.markFocused(0);\n      for (final WallMove move in WallMove.values) {\n        expect(focus.moveFrom(0, move), -1);\n      }\n      focus.focusTile(2);\n      expect(focus.focusedIndex, 0);\n    });\n\n    test('shrinking clamps removed focus to a valid remaining tile', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      focus.markFocused(3);\n      focus.setActiveLayout(tiles: 2, columns: 2);\n      expect(focus.focusedIndex, 1);\n\n      focus.markFocused(1);\n      focus.setActiveLayout(tiles: 1, columns: 1);\n      expect(focus.focusedIndex, 0);\n    });\n\n    test('growing keeps the current focus and restores traversal', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      focus.setActiveLayout(tiles: 1, columns: 1);\n      focus.markFocused(0);\n      focus.setActiveLayout(tiles: 4, columns: 2);\n      expect(focus.focusedIndex, 0);\n      expect(focus.moveFrom(0, WallMove.right), 1);\n      expect(focus.moveFrom(1, WallMove.down), 3);\n    });\n\n    test('invalid layouts fall back to the full grid', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      focus.setActiveLayout(tiles: 3, columns: 0);\n      expect(focus.activeTiles, 4);\n      expect(focus.activeColumns, 2);\n    });\n\n    test('arrow keys follow the active layout', () {\n      final WallFocusController focus = WallFocusController();\n      addTearDown(focus.dispose);\n      focus.setActiveLayout(tiles: 2, columns: 2);\n      focus.markFocused(0);\n      expect(focus.handleArrow(LogicalKeyboardKey.arrowRight), isTrue);\n      expect(focus.handleArrow(LogicalKeyboardKey.arrowDown), isTrue);\n      // Down was blocked: the controller reports the key consumed but the\n      // focused index never left the active set.\n      expect(focus.focusedIndex, 1);\n      expect(focus.handleArrow(LogicalKeyboardKey.enter), isFalse);\n    });\n  });\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_focus_test.dart"},"output":"Created file successfully: apps/tv_app/test/wall_focus_test.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/tv_app/test/wall_focus_test.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192b6d0137276a9b49010a1595ccf"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Adaptive focus traversal tests: 1/2/4 layouts share four stable nodes.\\nlibrary;\\n\\nimport 'package:flutter/services.dart';\\nimport 'package:flutter_test/flutter_test.dart';\\nimport 'package:tv_app/src/wall/wall_focus.dart';\\n\\nvoid main() {\\n  group('WallMove.targetFor', () {\\n    test('four-grid blocks edges instead of wrapping', () {\\n      expect(WallMove.targetFor(0, WallMove.left), -1);\\n      expect(WallMove.targetFor(0, WallMove.up), -1);\\n      expect(WallMove.targetFor(1, WallMove.right), -1);\\n      expect(WallMove.targetFor(2, WallMove.left), -1);\\n      expect(WallMove.targetFor(3, WallMove.right), -1);\\n      expect(WallMove.targetFor(3, WallMove.down), -1);\\n      expect(\\n        WallMove.targetFor(0, WallMove.right, columns: 2, tiles: 4),\\n        1,\\n      );\\n      expect(\\n        WallMove.targetFor(1, WallMove.down, columns: 2, tiles: 4),\\n        3,\\n      );\\n    });\\n\\n    test('two-tile row moves horizontally only', () {\\n      expect(\\n        WallMove.targetFor(0, WallMove.right, columns: 2, tiles: 2),\\n        1,\\n      );\\n      expect(\\n        WallMove.targetFor(1, WallMove.left, columns: 2, tiles: 2),\\n        0,\\n      );\\n      expect(\\n        WallMove.targetFor(0, WallMove.left, columns: 2, tiles: 2),\\n        -1,\\n      );\\n      expect(\\n        WallMove.targetFor(1, WallMove.right, columns: 2, tiles: 2),\\n        -1,\\n      );\\n      expect(\\n        WallMove.targetFor(0, WallMove.down, columns: 2, tiles: 2),\\n        -1,\\n      );\\n      expect(\\n        WallMove.targetFor(1, WallMove.up, columns: 2, tiles: 2),\\n        -1,\\n      );\\n    });\\n\\n    test('a single tile blocks every move', () {\\n      for (final WallMove move in WallMove.values) {\\n        expect(\\n          WallMove.targetFor(0, move, columns: 1, tiles: 1),\\n          -1,\\n          reason: '$move must be blocked for a single tile',\\n        );\\n      }\\n      expect(WallMove.targetFor(3, WallMove.left, columns: 1, tiles: 1), -1);\\n    });\\n  });\\n\\n  group('WallFocusController active layouts', () {\\n    test('defaults to the full 2x2 grid', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      expect(focus.activeTiles, 4);\\n      expect(focus.activeColumns, 2);\\n      expect(focus.nodes, hasLength(4));\\n    });\\n\\n    test('two-tile layout traverses one row and ignores the rest', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      focus.setActiveLayout(tiles: 2, columns: 2);\\n      expect(focus.activeTiles, 2);\\n\\n      focus.markFocused(0);\\n      expect(focus.moveFrom(0, WallMove.right), 1);\\n      expect(focus.moveFrom(1, WallMove.right), -1);\\n      expect(focus.moveFrom(1, WallMove.down), -1);\\n      expect(focus.moveFrom(0, WallMove.up), -1);\\n\\n      // Out-of-active-range slots are ignored, not focused.\\n      focus.focusTile(3);\\n      expect(focus.focusedIndex, 1);\\n    });\\n\\n    test('single-tile layout blocks everything', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      focus.setActiveLayout(tiles: 1, columns: 1);\\n\\n      focus.markFocused(0);\\n      for (final WallMove move in WallMove.values) {\\n        expect(focus.moveFrom(0, move), -1);\\n      }\\n      focus.focusTile(2);\\n      expect(focus.focusedIndex, 0);\\n    });\\n\\n    test('shrinking clamps removed focus to a valid remaining tile', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      focus.markFocused(3);\\n      focus.setActiveLayout(tiles: 2, columns: 2);\\n      expect(focus.focusedIndex, 1);\\n\\n      focus.markFocused(1);\\n      focus.setActiveLayout(tiles: 1, columns: 1);\\n      expect(focus.focusedIndex, 0);\\n    });\\n\\n    test('growing keeps the current focus and restores traversal', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      focus.setActiveLayout(tiles: 1, columns: 1);\\n      focus.markFocused(0);\\n      focus.setActiveLayout(tiles: 4, columns: 2);\\n      expect(focus.focusedIndex, 0);\\n      expect(focus.moveFrom(0, WallMove.right), 1);\\n      expect(focus.moveFrom(1, WallMove.down), 3);\\n    });\\n\\n    test('invalid layouts fall back to the full grid', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      focus.setActiveLayout(tiles: 3, columns: 0);\\n      expect(focus.activeTiles, 4);\\n      expect(focus.activeColumns, 2);\\n    });\\n\\n    test('arrow keys follow the active layout', () {\\n      final WallFocusController focus = WallFocusController();\\n      addTearDown(focus.dispose);\\n      focus.setActiveLayout(tiles: 2, columns: 2);\\n      focus.markFocused(0);\\n      expect(focus.handleArrow(LogicalKeyboardKey.arrowRight), isTrue);\\n      expect(focus.handleArrow(LogicalKeyboardKey.arrowDown), isTrue);\\n      // Down was blocked: the controller reports the key consumed but the\\n      // focused index never left the active set.\\n      expect(focus.focusedIndex, 1);\\n      expect(focus.handleArrow(LogicalKeyboardKey.enter), isFalse);\\n    });\\n  });\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/wall_focus_test.dart\"}"},"time":{"start":1793462817202,"end":1793462826106}}}}
