await db.doc(`parties/${partyId}/seedVideos/seed-bound`).get()).data()?.status, \\\"failed\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.hostDeleted, true);\\n  } finally {\\n    await clearParty(db, bucket, partyId);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\nEOF\\n./node_modules/.bin/tsc -p tsconfig.json 2>&1 | head -n 20\",\"workdir\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions\"}"},"time":{"start":1793461312727,"end":1793461313978}}}}
