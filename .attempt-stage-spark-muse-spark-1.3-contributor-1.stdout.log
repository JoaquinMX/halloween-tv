er2\",\"joinPin\":\"000007\",\"extra\":true}', localDeviceId: id);\n20:     final value = (result as Ok<GuestJoinData>).value;\n21:     expect(value.deviceId.value, id); expect(value.joinPin, '000007');\n22:   });\n23:   test('rejects URLs, malformed, nonobjects, and invalid identifier shapes', () {\n24:     for (final input in ['https://example.org', '{bad', '[]', '42']) { expect(parseGuestJoinPayload(input, localDeviceId: id), isA<Err<GuestJoinData>>()); }\n25:     expect(parseGuestJoinPayload('{\"partyId\":\"p\",\"channelId\":\"c\",\"joinPin\":\"12x456\"}', localDeviceId: id), isA<Err<GuestJoinData>>());\n26:   });\n27:   test('trims identifiers and accepts snake_case keys', () {\n28:     final fields = parseGuestJoinFields(partyId: '  party-a  ', localDeviceId: id, channelId: '  cctv ', joinPin: ' 004201 ');\n29:     expect(fields, isA<Ok<GuestJoinData>>());\n30:     final bound = (fields as Ok<GuestJoinData>).value;\n31:     expect(bound.partyId.value, 'party-a');\n32:     expect(bound.channelId, 'cctv');\n33:     expect(bound.joinPin, '004201');\n34:     final payload = parseGuestJoinPayload('{\"party_id\":\"p\",\"channel_id\":\"c\",\"join_pin\":\"000007\"}', localDeviceId: id);\n35:     expect(payload, isA<Ok<GuestJoinData>>());\n36:     final pasted = (payload as Ok<GuestJoinData>).value;\n37:     expect(pasted.partyId.value, 'p');\n38:     expect(pasted.channelId, 'c');\n39:     expect(pasted.joinPin, '000007');\n40:   });\n41:   test('rejects empty, overlong, and missing identifiers', () {\n42:     expect(parseGuestJoinFields(partyId: '', localDeviceId: id, channelId: 'c'), isA<Err<GuestJoinData>>());\n43:     expect(parseGuestJoinFields(partyId: '   ', localDeviceId: id, channelId: 'c'), isA<Err<GuestJoinData>>());\n44:     expect(parseGuestJoinFields(partyId: 'p', localDeviceId: id, channelId: ''), isA<Err<GuestJoinData>>());\n45:     expect(parseGuestJoinFields(partyId: longId(129), localDeviceId: id, channelId: 'c'), isA<Err<GuestJoinData>>());\n46:   