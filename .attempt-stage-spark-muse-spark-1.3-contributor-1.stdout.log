eption(\n482:       errorCode: MobileScannerErrorCode.unsupported,\n483:     );\n484:     GuestJoinData? received;\n485:     await _pumpJoin(\n486:       tester,\n487:       CameraJoinPayloadScanner(\n488:         permissions: _FakePermissions(\n489:           checkResult: CameraPermissionState.granted,\n490:         ),\n491:       ),\n492:       (data) => received = data,\n493:     );\n494: \n495:     await _tapScan(tester);\n496:     await tester.pumpAndSettle();\n497: \n498:     expect(find.byKey(QrScanScreen.errorKey), findsOneWidget);\n499:     expect(find.byKey(QrScanScreen.retryKey), findsOneWidget);\n500: \n501:     // Retry with a working camera recovers the preview.\n502:     camera.startError = null;\n503:     await tester.tap(find.byKey(QrScanScreen.retryKey));\n504:     await tester.pumpAndSettle();\n505:     expect(find.byKey(const Key('fake-camera-view')), findsOneWidget);\n506: \n507:     // A later failure (here: resume with a dead camera) resurfaces the\n508:     // error screen, whose manual-entry fallback pops back to the usable\n509:     // paste path.\n510:     camera.startError = const MobileScannerException(\n511:       errorCode: MobileScannerErrorCode.unsupported,\n512:     );\n513:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.inactive);\n514:     await tester.pump();\n515:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);\n516:     await tester.pump();\n517:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.paused);\n518:     await tester.pump();\n519:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.hidden);\n520:     await tester.pump();\n521:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.inactive);\n522:     await tester.pump();\n523:     tester.binding.handleAppLifecycleStateChanged(AppLifecycleState.resumed);\n524:     await tester.pumpAndSettle();\n525:     expect(find.byKey(QrScanScreen.errorKey), findsOneWidget);\n526:     await tester.tap(find.byKey(QrScanScreen.manualEntryKey));\n527:     await tester.pumpAndSettle();\n528:     expect(find.byType(QrScanScreen), findsNothing);\n529:     expect(find.text('Scanner is unavailable on this device.'), findsOneWidget);\n530: \n531:     await _enterPayload(tester, '{\"partyId\":\"paste\",\"channelId\":\"cctv\"}');\n532:     await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n533:     await tester.pumpAndSettle();\n534:     await tester.tap(find.byKey(JoinScreen.submitKey));\n535:     await tester.pumpAndSettle();\n536:     expect(received?.partyId.value, 'paste');\n537:     expect(tester.takeException(), isNull);\n538:   });\n539: \n540:   testWidgets('disposing the join screen while permission is pending is safe', (\n541:     tester,\n542:   ) async {\n543:     final Completer<CameraPermissionState> gate =\n544:         Completer<CameraPermissionState>();\n545:     await _pumpJoin(\n546:       tester,\n547:       CameraJoinPayloadScanner(\n548:         permissions: _FakePermissions(\n549:           checkResult: CameraPermissionState.denied,\n550:           requestGate: gate,\n551:         ),\n552:       ),\n553:       (_) {},\n554:     );\n555: \n556:     await _tapScan(tester);\n557:     await tester.pump();\n558: \n559:     // Tear down the whole tree while the OS permission prompt is \"up\".\n560:     await tester.pumpWidget(const SizedBox());\n561:     await tester.pump();\n562:     gate.complete(CameraPermissionState.granted);\n563:     await tester.pumpAndSettle();\n564: \n565:     expect(tester.takeException(), isNull);\n566:   });\n567: \n568:   testWidgets('camera denial is graceful and keeps the paste path usable', (\n569:     tester,\n570:   ) async {\n571:     GuestJoinData? received;\n572:     await _pumpJoin(\n573:       tester,\n574:       _FakeScanner(const JoinPayloadPermissionDenied()),\n575:       (data) => received = data,\n576:     );\n577:     await _tapScan(tester);\n578:     await tester.pumpAndSettle();\n5