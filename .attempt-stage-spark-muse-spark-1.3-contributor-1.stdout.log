\n414:   if (m.channelId.trim().isEmpty) {\n415:     return const Err<PlaybackManifest>('channelId must be non-empty');\n416:   }\n417:   if (m.version <= 0) {\n418:     return const Err<PlaybackManifest>('version must be > 0');\n419:   }\n420:   if (m.clips.length != 4) {\n421:     return Err<PlaybackManifest>(\n422:       'cctv manifest must have exactly 4 clips, got ${m.clips.length}',\n423:     );\n424:   }\n425:   final seenCameras = <String>{};\n426:   final seenClipIds = <String>{};\n427:   for (final clip in m.clips) {\n428:     if (clip.id.trim().isEmpty) {\n429:       return const Err<PlaybackManifest>('clip id must be non-empty');\n430:     }\n431:     if (clip.id.length > kMaxClipIdLength) {\n432:       return Err<PlaybackManifest>(\n433:         'clip id ${clip.id} exceeds $kMaxClipIdLength characters',\n434:       );\n435:     }\n436:     if (!seenClipIds.add(clip.id)) {\n437:       return Err<PlaybackManifest>('duplicate clip id ${clip.id}');\n438:     }\n439:     if (!kCctvCameraIds.contains(clip.cameraId)) {\n440:       return Err<PlaybackManifest>(\n441:         'unknown cameraId ${clip.cameraId}; expected one of $kCctvCameraIds',\n442:       );\n443:     }\n444:     if (!seenCameras.add(clip.cameraId)) {\n445:       return Err<PlaybackManifest>('duplicate cameraId ${clip.cameraId}');\n446:     }\n447:     if (clip.storageObjectId.trim().isEmpty) {\n448:       return const Err<PlaybackManifest>('storageObjectId must be non-empty');\n449:     }\n450:     if (!isValidSha256Hex(clip.sha256)) {\n451:       return Err<PlaybackManifest>('invalid sha256 for clip ${clip.id}');\n452:     }\n453:     if (clip.sizeBytes <= 0) {\n454:       return Err<PlaybackManifest>('sizeBytes must be > 0 for clip ${clip.id}');\n455:     }\n456:     if (clip.duration.inMilliseconds <= 0) {\n457:       return Err<PlaybackManifest>('duration must be > 0 for clip ${clip.id}');\n458:     }\n459:     if (clip.mimeType.trim().isEmpty) {\n460:       return const Err<PlaybackManifest>('mimeType must be non-empty');\n461:     }\n462:   }\n463:   return Ok<PlaybackManifest>(m);\n464: }\n465: \n466: /// Validates that [candidate] advances beyond [committedVersion].\n467: ///\n468: /// A manifest with the same version is not a new publication: callers may\n469: /// treat an identical, already committed manifest as an idempotent cache hit,\n470: /// but must reject it as an update. This keeps version ordering explicit at\n471: /// the point where persisted state is available.\n472: Result<PlaybackManifest> validateManifestVersion(\n473:   PlaybackManifest candidate,\n474:   int? committedVersion,\n475: ) {\n476:   if (candidate.version <= 0) {\n477:     return const Err<PlaybackManifest>('version must be > 0');\n478:   }\n479:   if (committedVersion != null && candidate.version <= committedVersion) {\n480:     return Err<PlaybackManifest>(\n481:       'manifest version ${candidate.version} must be newer than '\n482:       'committed version $committedVersion',\n483:     );\n484:   }\n485:   return Ok<PlaybackManifest>(candidate);\n486: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/core_playlist/lib/core_playlist.dart, lines 1-486\n1: /// Playback manifest model (Technical Design v1.0, section 8).\n2: ///\n3: /// Camera identity (owner Q3 — labels are config-driven, never hardcoded):\n4: /// [CctvSlot]/[cctvSlots] is the single source of truth for CCTV camera\n5: /// identity — canonical wall order, camera ids, and default room labels.\n6: /// The `channel_cctv` tile map, the tv_app asset catalog, and wall-slot\n7: /// label resolution all derive from it; no `CAM-0x` literals are duplicated\n8: /// in other layers.\n9: ///\n10: /// Port direction (finding D-08 — recorded exception): the control-plane\n11: /// ports (`ManifestSource`, `SettingsPort`) are owned by the contracts\n12: /// layer in `package:channel_api/channel_api.dart`, so channels can consume\n13: /// them without importing `infra_*`. The `infra_*` packages ship only the\n14: /// adapters bound to those contracts; their barrels keep re-exporting the\n15: /// port names so existing importers keep compiling.\n16: library;\n17: \n18: import 'package:core_foundation/core_foundation.dart';\n19: \n20: /// One CCTV wall slot: camera identity plus its default presentation.\n21: ///\n22: /// Wall order is the order of `cctvSlots` (top-left reading order).\n23: final class CctvSlot {\n24:   /// Camera id (e.g. `CAM-01`).\n25:   final String id;\n26: \n27:   /// Wall slot index (`0..3`; matches the position in [cctvSlots]).\n28:   final int index;\n29: \n30:   /// Default room name shown on the tile HUD.\n31:   ///\n32:   /// Replaceable per clip by the manifest `label` field (see\n33:   /// [ClipDescriptor.label] and [resolveCctvLabel]).\n34:   final String room;\n35: \n36:   /// Creates a slot binding [id] to wall position [index] with default\n37:   /// room [room].\n38:   const CctvSlot({required this.id, required this.index, required this.room});\n39: \n40:   /// Default tile label (`'$id · $room'`), used when the manifest clip\n41:   /// carries no custom label.\n42:   String get defaultLabel => '$id · $room';\n43: \n44:   @override\n45:   String toString() => 'CctvSlot($id, slot $index, $room)';\n46: }\n47: \n48: /// Canonical CCTV wall slots in wall order (top-left reading order).\n49: ///\n50: /// Single source of truth for camera identity: id, slot index, and default\n51: /// room label travel together so `channel_cctv`, the tv_app asset catalog,\n52: /// and manifest validation can never drift apart. Add a camera here — never\n53: /// by scattering new `CAM-0x` literals across layers.\n54: const List<CctvSlot> cctvSlots = <CctvSlot>[\n55:   CctvSlot(id: 'CAM-01', index: 0, room: 'hallway'),\n56:   CctvSlot(id: 'CAM-02', index: 1, room: 'kitchen'),\n57:   CctvSlot(id: 'CAM-03', index: 2, room: 'staircase'),\n58:   CctvSlot(id: 'CAM-04', index: 3, room: 'storage room'),\n59: ];\n60: \n61: /// Valid CCTV camera ids, derived from [cctvSlots].\n62: ///\n63: /// Kept for callers that only need the id set; prefer [cctvSlots] (or\n64: /// [slotForCameraId]) when order, index, or default labels matter.\n65: final Set<String> kCctvCameraIds = Set<String>.unmodifiable(\n66:   <String>{for (final CctvSlot slot in cctvSlots) slot.id},\n67: );\n68: \n69: /// Slot for [cameraId], or `null` when it is not a known camera.\n70: CctvSlot? slotForCameraId(String cameraId) {\n71:   for (final CctvSlot slot in cctvSlots) {\n72:     if (slot.id == cameraId) {\n73:       return slot;\n74:     }\n75:   }\n76:   return null;\n77: }\n78: \n79: /// Maximum manifest clip id length.\n80: ///\n81: /// The tile HUD ellipsizes long labels (p5 owns the HUD), but ids longer\n82: /// than this are rejected by [validateCctvManifest] so oversized\n83: /// control-plane payloads never reach the wall.\n84: const int kMaxClipIdLength = 64;\n85: \n86: /// Resolves the wall-slot label for [clip].\n87: ///\n88: /// The manifest clip `label` field wins when present and non-blank (owner\n89: /// Q3: labels are config-driven and replaceable); otherwise the\n90: /// [CctvSlot.defaultLabel] for the clip's camera applies. Unknown cameras\n91: /// fall back to the raw camera id — validation rejects those separately.\n92: String resolveCctvLabel(ClipDescriptor clip) {\n93:   final String? custom = clip.label;\n94:   if (custom != null && custom.trim().isNotEmpty) {\n95:     return custom;\n96:   }\n97:   final CctvSlot? slot = slotForCameraId(clip.cameraId);\n98:   if (slot != null) {\n99:     return slot.defaultLabel;\n100:   }\n101:   return clip.cameraId;\n102: }\n103: \n104: final RegExp _sha256Pattern = RegExp(r'^[0-9a-fA-F]{64}$');\n105: \n106: /// True when [value] is a 64 character hex sha256 digest.\n107: ///\n108: /// Digests are compared and stored as lowercase hex elsewhere; this helper\n109: /// only checks well-formedness so callers ca