us: \"redeemed\" }));\n121:     await assertFails(getDoc(doc(client, \"parties/host-party/seedVideos/seed-1\")));\n122:     await assertFails(setDoc(doc(client, \"parties/host-party/seedVideos/seed-1\"), { status: \"deleted\" }));\n123:     await assertFails(setDoc(doc(client, \"parties/host-party/seedVideos/forged\"), { status: \"ready\" }));\n124:   } finally {\n125:     await env.cleanup();\n126:   }\n127: });\n128: \n129: test(\"storage rules keep the host-preview prefix denied for direct access\", async () => {\n130:   const rules = await readFile(resolve(__dirname, \"../../storage.rules\"), \"utf8\");\n131:   // Host previews ride the catch-all deny: no direct client reads/writes.\n132:   // Signed preview URLs bypass rules with backend validation, exactly like\n133:   // delivery URLs; the backend never persists them.\n134:   assert.ok(rules.includes(\"allow read, write: if false\"), \"storage rules deny direct access by default\");\n135: });\n136: \n137: test(\"storage rules keep the guest-ingest prefix denied for direct access\", async () => {\n138:   const rules = await readFile(resolve(__dirname, \"../../storage.rules\"), \"utf8\");\n139:   assert.ok(rules.includes(\"guests/{deviceId}/ingest\"), \"storage rules carry an explicit guest-ingest section\");\n140:   const guestSection = rules.slice(rules.indexOf(\"guests/{deviceId}/ingest\"));\n141:   assert.ok(guestSection.includes(\"allow read, write: if false\"), \"guest ingest stays denied for direct reads/writes/deletes\");\n142: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/security_rules.test.ts, lines 1-142\n1: import assert from \"node:assert/strict\";\n2: import { readFile } from \"node:fs/promises\";\n3: import { resolve } from \"node:path\";\n4: import test from \"node:test\";\n5: import { assertFails, assertSucceeds, initializeTestEnvironment, RulesTestEnvironment } from \"@