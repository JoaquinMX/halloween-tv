{"type":"tool_use","timestamp":1793464371469,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192ce7843001l9sY07recE76IQ","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192ce6e7c00104E4aMHY5hezAc","type":"tool","id":"call_01a192ce77f2734d88868261ed642a06","tool":"write","state":{"status":"completed","input":{"content":"// Emulator-backed host administration smoke test.\n//\n// Run from apps/companion_app after starting the Firebase emulators and\n// supplying HOST_INVITE_PAYLOAD (a fresh Host QR JSON from createHostInvite):\n//\n//   flutter test integration_test/host_admin_emulator_test.dart \\\n//     --dart-define=HOST_INVITE_PAYLOAD='{\"partyId\":\"...\",...}' \\\n//     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n//     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n//     --dart-define=COMPANION_FIREBASE_PROJECT_ID=demo-halloween-tv \\\n//     --dart-define=COMPANION_USE_EMULATOR=true\n//\n// The one-use invite is deliberately provisioned out of band (the companion\n// cannot mint host invitations). This drives real parsing, identity binding,\n// joinHost response validation, and the scoped seed-list callable.\nlibrary;\n\nimport 'package:companion_app/src/companion_app.dart';\nimport 'package:companion_app/src/join/device_identity_store.dart';\nimport 'package:companion_app/src/ui/host_entry_screen.dart';\nimport 'package:companion_app/src/ui/host_panel_screen.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:integration_test/integration_test.dart';\nimport 'package:shared_preferences/shared_preferences.dart';\n\nconst String _hostInvitePayload = String.fromEnvironment('HOST_INVITE_PAYLOAD');\n\nvoid main() {\n  IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n\n  testWidgets('emulator: Host QR joins and loads scoped administration', (\n    tester,\n  ) async {\n    if (_hostInvitePayload.isEmpty) {\n      markTestSkipped(\n        'Provide HOST_INVITE_PAYLOAD (a fresh Host QR JSON from '\n        'createHostInvite) to run the emulator host-admin smoke test.',\n      );\n    }\n    SharedPreferences.setMockInitialValues(<String, Object>{\n      DeviceIdentityStore.hostStorageKey: 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb',\n    });\n    await tester.pumpWidget(const CompanionApp());\n    for (int i = 0; i < 12; i++) {\n      await tester.pump(const Duration(milliseconds: 250));\n    }\n    expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\n    await tester.enterText(\n      find.byKey(HostEntryScreen.payloadFieldKey),\n      _hostInvitePayload,\n    );\n    await tester.ensureVisible(find.byKey(HostEntryScreen.submitKey));\n    await tester.tap(find.byKey(HostEntryScreen.submitKey));\n    for (int i = 0; i < 20; i++) {\n      await tester.pump(const Duration(milliseconds: 250));\n    }\n    expect(find.byKey(HostPanelScreen.listKey), findsOneWidget);\n    expect(tester.takeException(), isNull);\n  });\n}\n","path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/host_admin_emulator_test.dart"},"output":"Wrote file successfully: apps/companion_app/integration_test/host_admin_emulator_test.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: apps/companion_app/integration_test/host_admin_emulator_test.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192ce77f2734d88868261ed642a06"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"// Emulator-backed host administration smoke test.\\n//\\n// Run from apps/companion_app after starting the Firebase emulators and\\n// supplying HOST_INVITE_PAYLOAD (a fresh Host QR JSON from createHostInvite):\\n//\\n//   flutter test integration_test/host_admin_emulator_test.dart \\\\\\n//     --dart-define=HOST_INVITE_PAYLOAD='{\\\"partyId\\\":\\\"...\\\",...}' \\\\\\n//     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\\\\n//     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\\\\n//     --dart-define=COMPANION_FIREBASE_PROJECT_ID=demo-halloween-tv \\\\\\n//     --dart-define=COMPANION_USE_EMULATOR=true\\n//\\n// The one-use invite is deliberately provisioned out of band (the companion\\n// cannot mint host invitations). This drives real parsing, identity binding,\\n// joinHost response validation, and the scoped seed-list callable.\\nlibrary;\\n\\nimport 'package:companion_app/src/companion_app.dart';\\nimport 'package:companion_app/src/join/device_identity_store.dart';\\nimport 'package:companion_app/src/ui/host_entry_screen.dart';\\nimport 'package:companion_app/src/ui/host_panel_screen.dart';\\nimport 'package:flutter_test/flutter_test.dart';\\nimport 'package:integration_test/integration_test.dart';\\nimport 'package:shared_preferences/shared_preferences.dart';\\n\\nconst String _hostInvitePayload = String.fromEnvironment('HOST_INVITE_PAYLOAD');\\n\\nvoid main() {\\n  IntegrationTestWidgetsFlutterBinding.ensureInitialized();\\n\\n  testWidgets('emulator: Host QR joins and loads scoped administration', (\\n    tester,\\n  ) async {\\n    if (_hostInvitePayload.isEmpty) {\\n      markTestSkipped(\\n        'Provide HOST_INVITE_PAYLOAD (a fresh Host QR JSON from '\\n        'createHostInvite) to run the emulator host-admin smoke test.',\\n      );\\n    }\\n    SharedPreferences.setMockInitialValues(<String, Object>{\\n      DeviceIdentityStore.hostStorageKey: 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb',\\n    });\\n    await tester.pumpWidget(const CompanionApp());\\n    for (int i = 0; i < 12; i++) {\\n      await tester.pump(const Duration(milliseconds: 250));\\n    }\\n    expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\\n    await tester.enterText(\\n      find.byKey(HostEntryScreen.payloadFieldKey),\\n      _hostInvitePayload,\\n    );\\n    await tester.ensureVisible(find.byKey(HostEntryScreen.submitKey));\\n    await tester.tap(find.byKey(HostEntryScreen.submitKey));\\n    for (int i = 0; i < 20; i++) {\\n      await tester.pump(const Duration(milliseconds: 250));\\n    }\\n    expect(find.byKey(HostPanelScreen.listKey), findsOneWidget);\\n    expect(tester.takeException(), isNull);\\n  });\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/host_admin_emulator_test.dart\"}"},"time":{"start":1793464367171,"end":1793464371469}}}}
