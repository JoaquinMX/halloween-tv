{"type":"tool_use","timestamp":1793461311055,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929fd0cf001FOozbuOgqQZSdG","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929fc911001f2cVH77JBpeijr","type":"tool","id":"call_01a1929fcd1675aa802090671994a6a1","tool":"shell","state":{"status":"completed","input":{"command":"cat >> backend/functions/test/guest_upload.test.ts << 'EOF'\n\ntest(\"withdrawal deletes retained host previews and fails the bound seed closed\", {\n  skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n}, async () => {\n  const { app, db, bucket } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedParty(db, partyId, \"p-guest-1\", \"main\");\n    const services = servicesFor(db, bucket);\n    const requested = await services.requestGuestUpload({\n      partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n    });\n    await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n    await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n    // A host seed bound to this submission with retained preview copies.\n    const jobId = \"hv-seed-bound\";\n    const stagedPath = `parties/${partyId}/channels/main/delivery/9/CAM-01.mp4`;\n    const previewPath = `parties/${partyId}/hostPreviews/seed-bound/CAM-01.mp4`;\n    await bucket.file(stagedPath).save(Buffer.from(\"staged\"));\n    await bucket.file(previewPath).save(Buffer.from(\"preview\"));\n    await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\n      jobId, partyId, deviceId: \"p-guest-1\", channelId: \"main\", state: \"running\",\n      manifestVersion: 9, idempotencyKey: \"idem-bound\",\n      guestMedia: { submissionId: requested.submissionId },\n      stagedOutputs: { \"CAM-01\": { cameraId: \"CAM-01\", objectPath: stagedPath, sha256: \"a\".repeat(64) } },\n    });\n    await db.doc(`parties/${partyId}/seedVideos/seed-bound`).set({\n      seedId: \"seed-bound\", partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n      jobId, status: \"running\", previewPaths: [previewPath],\n    });\n    const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n    assert.ok(withdrawn.deletedObjects.includes(previewPath), \"retained host preview must be deleted at withdrawal\");\n    assert.ok(withdrawn.deletedObjects.includes(stagedPath), \"staged host derivative must be deleted at withdrawal\");\n    assert.equal((await bucket.file(previewPath).exists())[0], false);\n    assert.equal((await db.doc(`parties/${partyId}/seedVideos/seed-bound`).get()).data()?.status, \"failed\");\n    assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.hostDeleted, true);\n  } finally {\n    await clearParty(db, bucket, partyId);\n    await disposeEmulatorContext(app);\n  }\n});\nEOF\n./node_modules/.bin/tsc -p tsconfig.json 2>&1 | head -n 20","workdir":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions"},"output":"zsh:1: no such file or directory: backend/functions/test/guest_upload.test.ts\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"zsh:1: no such file or directory: backend/functions/test/guest_upload.test.ts\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929fcd1675aa802090671994a6a1"}},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cat >> backend/functions/test/guest_upload.test.ts << 'EOF'\\n\\ntest(\\\"withdrawal deletes retained host previews and fails the bound seed closed\\\", {\\n  skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\\n}, async () => {\\n  const { app, db, bucket } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedParty(db, partyId, \\\"p-guest-1\\\", \\\"main\\\");\\n    const services = servicesFor(db, bucket);\\n    const requested = await services.requestGuestUpload({\\n      partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\", consent: CONSENT, contentType: \\\"image/jpeg\\\",\\n    });\\n    await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \\\"image/jpeg\\\" });\\n    await services.completeGuestUpload({ partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\", submissionId: requested.submissionId });\\n    // A host seed bound to this submission with retained preview copies.\\n    const jobId = \\\"hv-seed-bound\\\";\\n    const stagedPath = `parties/${partyId}/channels/main/delivery/9/CAM-01.mp4`;\\n    const previewPath = `parties/${partyId}/hostPreviews/seed-bound/CAM-01.mp4`;\\n    await bucket.file(stagedPath).save(Buffer.from(\\\"staged\\\"));\\n    await bucket.file(previewPath).save(Buffer.from(\\\"preview\\\"));\\n    await db.doc(`parties/${partyId}/jobs/${jobId}`).set({\\n      jobId, partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\", state: \\\"running\\\",\\n      manifestVersion: 9, idempotencyKey: \\\"idem-bound\\\",\\n      guestMedia: { submissionId: requested.submissionId },\\n      stagedOutputs: { \\\"CAM-01\\\": { cameraId: \\\"CAM-01\\\", objectPath: stagedPath, sha256: \\\"a\\\".repeat(64) } },\\n    });\\n    await db.doc(`parties/${partyId}/seedVideos/seed-bound`).set({\\n      seedId: \\\"seed-bound\\\", partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\",\\n      jobId, status: \\\"running\\\", previewPaths: [previewPath],\\n    });\\n    const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\", submissionId: requested.submissionId });\\n    assert.ok(withdrawn.deletedObjects.includes(previewPath), \\\"retained host preview must be deleted at withdrawal\\\");\\n    assert.ok(withdrawn.deletedObjects.includes(stagedPath), \\\"staged host derivative must be deleted at withdrawal\\\");\\n    assert.equal((await bucket.file(previewPath).exists())[0], false);\\n    assert.equal((await db.doc(`parties/${partyId}/seedVideos/seed-bound`).get()).data()?.status, \\\"failed\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()?.hostDeleted, true);\\n  } finally {\\n    await clearParty(db, bucket, partyId);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\nEOF\\n./node_modules/.bin/tsc -p tsconfig.json 2>&1 | head -n 20\",\"workdir\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions\"}"},"time":{"start":1793461309647,"end":1793461311055}}}}
