{"type":"tool_use","timestamp":1793463796454,"sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","part":{"partID":"prt_192c5baf000136BXae6cyuqFtD","sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","messageID":"msg_192c5b4860016FpKn1mglkBGUI","type":"tool","id":"call_01a192c5ba307245a5f425e3db4a8222","tool":"edit","state":{"status":"completed","input":{"newString":"  // Host-invite expiry: docs carry `expiresAt` for the Firestore TTL policy\n  // (console-configured TTL on expiresAt deletes the doc outright); this\n  // sweep is the defense-in-depth pass that marks lapsed pending invites\n  // expired so a stale invite can never redeem after its window, even where\n  // no TTL policy is configured.\n  try {\n    const dueInvites = await db.collectionGroup(\"hostInvites\")\n      .where(\"expiresAt\", \"<=\", Timestamp.fromDate(now))\n      .get();\n    for (const inviteDoc of dueInvites.docs) {\n      await db.runTransaction(async (transaction) => {\n        const current = await transaction.get(inviteDoc.ref);\n        if (!current.exists) return;\n        if (current.data()?.status === \"pending\") {\n          transaction.update(inviteDoc.ref, {\n            status: \"expired\",\n            expiredAt: FieldValue.serverTimestamp(),\n            updatedAt: FieldValue.serverTimestamp(),\n          });\n        }\n      }).catch(() => undefined);\n    }\n  } catch {\n    // Best-effort: redemption rechecks expiry transactionally regardless.\n  }\n\n  const references = new Set<string>();","oldString":"  const references = new Set<string>();","path":"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/retention.ts"},"output":"Edited backend/functions/src/retention.ts (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":"backend/functions/src/retention.ts","patch":"Index: backend/functions/src/retention.ts\n===================================================================\n--- backend/functions/src/retention.ts\n+++ backend/functions/src/retention.