ry {\n543:       await _applyVerifiedVersion(restored, const <String, CachedMedia>{});\n544:     } on Object {\n545:       if (mounted) {\n546:         setState(() {\n547:           _recoveryStatus = 'Cached wall could not be activated.';\n548:           _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n549:         });\n550:       }\n551:       return;\n552:     }\n553:     if (mounted) {\n554:       setState(() {\n555:         _recoveryVisible = false;\n556:         _recoveryStatus = null;\n557:         _status = 'WALL RESTORED · v${restored.version}';\n558:       });\n559:       _restoreTileFocus();\n560:     }\n561:   }\n562: \n563:   void _toggleEffects() {\n564:     final bool value = !_effectsDisabled;\n565:     setState(() {\n566:       _effectsDisabled = value;\n567:       _status = _effectsDisabled ? 'EFFECTS DISABLED' : 'EFFECTS ENABLED';\n568:     });\n569:     final SettingsPort? settings = widget.settings;\n570:     if (settings != null) {\n571:       unawaited(\n572:         settings.setBool(\n573:           partyId: PartyId(widget.partyId),\n574:           key: CctvWallSettingsKeys.effectsDisabled,\n575:           value: value,\n576:         ),\n577:       );\n578:     }\n579:   }\n580: \n581:   void _restoreTileFocus() {\n582:     WidgetsBinding.instance.addPostFrameCallback((_) {\n583:       if (!mounted) {\n584:         return;\n585:       }\n586:       final int index = _focus.focusedIndex;\n587:       _focus.focusTile(index < 0 ? 0 : index);\n588:     });\n589:   }\n590: \n591:   bool _isSelectKey(LogicalKeyboardKey key) =>\n592:       key == LogicalKeyboardKey.select ||\n593:       key == LogicalKeyboardKey.enter ||\n594:       key == LogicalKeyboardKey.gameButtonA ||\n595:       key == LogicalKeyboardKey.space;\n596: \n597:   KeyEventResult _onWallKey(FocusNode node, KeyEvent event) {\n598:     if (event is KeyDownEvent) {\n599:       if (event.logicalKey == LogicalKeyboardKey.contextMenu ||\n600:           event.logicalKey == LogicalK