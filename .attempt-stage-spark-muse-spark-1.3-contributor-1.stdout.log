estCodeClient slow = GuestCodeClient(\n354:         invoker: (_, __) => gate.future,\n355:         partyId: 'party-1',\n356:         deviceId: 'tv-abc',\n357:         channelId: hauntedSurveillanceChannelId,\n358:       );\n359:       await pumpPanel(tester, slow);\n360:       await tester.pump();\n361:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n362:       expect(find.byType(QrImageView), findsNothing);\n363:       expect(find.text('tv-abc'), findsOneWidget);\n364:       gate.completeError(const GuestCodeException('denied'));\n365:       await tester.pump();\n366:       await tester.pump();\n367:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n368:       expect(find.textContaining('denied'), findsOneWidget);\n369:       expect(find.byType(QrImageView), findsNothing);\n370:       await disposePanel(tester);\n371:     });\n372: \n373:     testWidgets('empty list states no seed instructions',\n374:         (WidgetTester tester) async {\n375:       final GuestCodeClient client = listingClient(listingResponse());\n376:       await pumpPanel(tester, client);\n377:       await tester.pump();\n378:       await tester.pump();\n379:       expect(find.byKey(kGuestCodeEmptyKey), findsOneWidget);\n380:       expect(find.textContaining('seed_guests'), findsNothing);\n381:       expect(find.byType(QrImageView), findsOneWidget);\n382:       await disposePanel(tester);\n383:     });\n384: \n385:     testWidgets('type-or-paste instructions with camera-deferred status',\n386:         (WidgetTester tester) async {\n387:       final GuestCodeClient client = listingClient(listingResponse());\n388:       await pumpPanel(tester, client);\n389:       await tester.pump();\n390:       await tester.pump();\n391:       expect(find.textContaining('type or paste'), findsOneWidget);\n392:       expect(find.textContaining('Camera QR scanning'), findsOneWidget);\n393:       expect(find.textContaining('reads codes aloud'), findsNothing);\n394:       expect(find.textContaining('later slice'), findsNothing);\n395:       await disposePanel(tester);\n396:     });\n397: \n398:     testWidgets('refresh after new joins updates rows + retains QR on failure',\n399:         (WidgetTester tester) async {\n400:       int calls = 0;\n401:       final GuestCodeClient client = GuestCodeClient(\n402:         invoker: (String name, Map<String, Object?> payload) async {\n403:           calls++;\n404:           if (calls == 1) {\n405:             return listingResponse(\n406:               devices: <Object?>[\n407:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n408:               ],\n409:             );\n410:           }\n411:           if (calls == 2) {\n412:             return listingResponse(\n413:               devices: <Object?>[\n414:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n415:                 <String, Object?>{'deviceId': 'g-2'},\n416:               ],\n417:             );\n418:           }\n419:           throw const GuestCodeException('flaky');\n420:         },\n421:         partyId: 'party-1',\n422:         deviceId: 'tv-abc',\n423:         channelId: hauntedSurveillanceChannelId,\n424:       );\n425:       await pumpPanel(\n426:         tester,\n427:         client,\n428:         refreshInterval: const Duration(milliseconds: 50),\n429:       );\n430:       await tester.pump();\n431:       await tester.pump();\n432:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n433:       final String firstQr = qrDataOf(tester);\n434: \n435:       await tester.pump(const Duration(milliseconds: 60));\n436:       await tester.pump();\n437:       await tester.pump();\n438:       expect(find.text('Guest device: g-2'), findsOneWidget);\n439: \n440:       await tester.pump(const Duration(milliseconds: 60));\n441:       await tester.pump();\n442:       await tester.pump();\n443:       // Last valid session retained through the refresh failure.\n444:       expect(find.byType(QrImageView), findsOneWidget);\n445:       expect(qrDataOf(tester), firstQr);\n446:       expect(find.text('Guest device: g-2'), findsOneWidget);\n447:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n448:       expect(calls, greaterThanOrEqualTo(3));\n449:       await disposePanel(tester);\n450:     });\n451: \n452:     testWidgets('overlapping refreshes never run concurrently',\n453:         (WidgetTester tester) async {\n454:       int calls = 0;\n455:       final Completer<Map<String, Object?>> gate =\n456:           Completer<Map<String, Object?>>();\n457:       final GuestCodeClient client = GuestCodeClient(\n458:         invoker: (_, __) {\n459:           calls++;\n460:           if (calls == 1) {\n461:             return gate.future;\n462:           }\n463:           return Future.value(listingResponse());\n464:         },\n465:         partyId: 'party-1',\n466:         deviceId: 'tv-abc',\n467:         channelId: hauntedSurveillanceChannelId,\n468:       );\n469:       await pumpPanel(\n470:         tester,\n471:         client,\n472:         refreshInterval: const Duration(milliseconds: 20),\n473:       );\n474:       await tester.pump();\n475:       expect(calls, 1);\n476:       // Periodic ticks while the first fetch is still in flight are skipped.\n477:       await tester.pump(const Duration(milliseconds: 60));\n478:       await tester.pump();\n479:       expect(calls, 1);\n480:       gate.complete(listingResponse());\n481:       await tester.pump();\n482:       await tester.pump();\n483:       expect(find.byType(QrImageView), findsOneWidget);\n484:       // The next tick after the in-flight fetch settled runs normally.\n485:       await tester.pump(const Duration(milliseconds: 40));\n486:       await tester.pump();\n487:       await tester.pump();\n488:       expect(calls, greaterThanOrEqualTo(2));\n489:       await disposePanel(tester);\n490:     });\n491: \n492:     testWidgets('hung fetch times out and the panel retries to recovery',\n493:         (WidgetTester tester) async {\n494:       int calls = 0;\n495:       final GuestCodeClient client = GuestCodeClient(\n496:         invoker: (_, __) {\n497:           calls++;\n498:           if (calls <= 2) {\n499:             // Never completes: without the fetch timeout these would hold\n500:             // `_fetching` true forever and wedge the panel.\n501:             return Completer<Map<String, Object?>>().future;\n502:           }\n503:           return Future.value(\n504:             listingResponse(\n505:               joinPin: '004201',\n506:               devices: <Object?>[\n507:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n508:               ],\n509:             ),\n510:           );\n511:         },\n512:         partyId: 'party-1',\n513:         deviceId: 'tv-abc',\n514:         channelId: hauntedSurveillanceChannelId,\n515:       );\n516:       await pumpPanel(\n517:         tester,\n518:         client,\n519:         refreshInterval: const Duration(seconds: 5),\n520:       );\n521:       await tester.pump();\n522:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n523:       expect(calls, 1);\n524: \n525:       // The periodic tick while the first fetch hangs is skipped.\n526:       await tester.pump(const Duration(seconds: 5));\n527:       await tester.pump();\n528:       expect(calls, 1);\n529: \n530:       // The hung fetch times out: error state, no fabricated QR. The next\n531:       // tick retries (the in-flight guard was released by the timeout), and\n532:       // that retry hangs too — the error state persists across the tick.\n533:       await tester.pump(const Duration(seconds: 6));\n534:       await tester.pump();\n535:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n536:       expect(find.textContaining('timed out'), findsOneWidget);\n537:       expect(find.byType(QrImageView), findsNothing);\n538:       expect(calls, 2);\n539: \n540:       await tester.pump(const Duration(seconds: 4));\n541:       await tester.pump();\n542:       expect(calls, 2);\n543:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n544:       expect(find.byType(QrImageView), findsNothing);\n545: \n546:       // The second hung fetch times out as well; the following tick retries\n547:       // and the panel recovers with the authoritative session.\n548:       await tester.pump(const Duration(seconds: 6));\n549:       await tester.pump();\n550:       await tester.pump();\n551:       await tester.pump(const Duration(seconds: 5));\n552:       await tester.pump();\n553:       await tester.pump();\n554:       expect(calls, greaterThanOrEqualTo(3));\n555:       expect(find.byType(QrImageView), findsOneWidget);\n556:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n557:       await disposePanel(tester);\n558:     });\n559: \n560:     testWidgets('dispose cancels timer and ignores late responses',\n561:         (WidgetTester tester) async {\n562:       int calls = 0;\n563:       final Completer<Map<String, Object?>> late =\n564:           Completer<Map<String, Object?>>();\n565:       final GuestCodeClient client = GuestCodeClient(\n566:         invoker: (_, __) {\n567:           calls++;\n568:           if (calls == 1) {\n569:             return late.future;\n570:           }\n571:           return Future.value(listingResponse());\n572:         },\n573:         partyId: 'party-1',\n574:         deviceId: 'tv-abc',\n575:         channelId: hauntedSurveillanceChannelId,\n576:       );\n577:       await pumpPanel(\n578:         tester,\n579:         client,\n580:         refreshInterval: const Duration(milliseconds: 20),\n581:       );\n582:       await tester.pump();\n583:       final int callsAtOpen = calls;\n584:       expect(callsAtOpen, 1);\n585:       await tester.pumpWidget(const SizedBox.shrink());\n586:       await tester.pump();\n587:       late.complete(listingResponse());\n588:       await tester.pump(const Duration(milliseconds: 100));\n589:       await tester.pump();\n590:       expect(calls, callsAtOpen);\n591:       expect(tester.takeException(), isNull);\n592:       // Already disposed; nothing further to tear down.\n593:     });\n594: \n595:     testWidgets('D-pad back/close keys invoke callbacks',\n596:         (WidgetTester tester) async {\n597:       bool backed = false;\n598:       bool closed = false;\n599:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n600:       addTearDown(primary.dispose);\n601:       final GuestCodeClient client = listingClient(listingResponse());\n602:       await pumpPanel(\n603:         tester,\n604:         client,\n605:         onBack: () => backed = true,\n606:         onClose: () => closed = true,\n607:         primaryFocusNode: primary,\n608:       );\n609:       await tester.pump();\n610:       await tester.pump();\n611:       primary.requestFocus();\n612:       await tester.pump();\n613:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n614:       await tester.pump();\n615:       expect(backed, isTrue);\n616:       expect(closed, isFalse);\n617:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n618:       await tester.pump();\n619:       expect(closed, isTrue);\n620:       primary.unfocus();\n621:       await disposePanel(tester);\n622:     });\n623: \n624:     testWidgets('escape falls back to onClose when no onBack',\n625:         (WidgetTester tester) async {\n626:       bool closed = false;\n627:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n628:       addTearDown(primary.dispose);\n629:       final GuestCodeClient client = listingClient(listingResponse());\n630:       await pumpPanel(\n631:         tester,\n632:         client,\n633:         onClose: () => closed = true,\n634:         primaryFocusNode: primary,\n635:       );\n636:       await tester.pump();\n637:       await tester.pump();\n638:       expect(find.byKey(kGuestCodeBackKey), findsNothing);\n639:       primary.requestFocus();\n640:       await tester.pump();\n641:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n642:       await tester.pump();\n643:       expect(closed, isTrue);\n644:       primary.unfocus();\n645:       await disposePanel(tester);\n646:     });\n647: \n648:     testWidgets('1920x1080 layout smoke: no overflow, one QR',\n649:         (WidgetTester tester) async {\n650:       addTearDown(tester.view.resetPhysicalSize);\n651:       addTearDown(tester.view.resetDevicePixelRatio);\n652:       tester.view.physicalSize = const Size(1920, 1080);\n653:       tester.view.devicePixelRatio = 1.0;\n654:       final GuestCodeClient client = listingClient(\n655:         listingResponse(\n656:           joinPin: '123456',\n657:           devices: <Object?>[\n658:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n659:           ],\n660:         ),\n661:       );\n662:       await pumpPanel(tester, client, onBack: () {});\n663:       await tester.pump();\n664:       await tester.pump();\n665:       expect(find.byType(QrImageView), findsOneWidget);\n666:       expect(find.text('tv-abc'), findsOneWidget);\n667:       expect(tester.takeException(), isNull);\n668:       await disposePanel(tester);\n669:     });\n670:   });\n671: \n672:   group('WallScreen guest-code flow', () {\n673:     GuestCodeClient fakeClient({bool fail = false, String? pin}) =>\n674:         GuestCodeClient(\n675:           invoker: (_, __) async {\n676:             if (fail) {\n677:               throw const GuestCodeException('denied');\n678:             }\n679:             return listingResponse(\n680:               joinPin: pin ?? const _Absent(),\n681:               devices: <Object?>[\n682:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n683:               ],\n684:             );\n685:           },\n686:           partyId: 'party-1',\n687:           deviceId: 'tv-abc',\n688:           channelId: hauntedSurveillanceChannelId,\n689:         );\n690: \n691:     testWidgets('no client means no GUEST CODES button',\n692:         (WidgetTester tester) async {\n693:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n694:       await tester.pumpWidget(\n695:         wallHarness(\n696:           manifest: wallManifest(),\n697:           clock: clock,\n698:           factory: fakeControllerFactory(),\n699:         ),\n700:       );\n701:       await pumpWall(tester);\n702: \n703:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n704:       await tester.pump();\n705:       await tester.pump();\n706:       expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n707:       expect(find.text('GUEST CODES'), findsNothing);\n708: \n709:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n710:       await tester.pump();\n711:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n712: \n713:       await teardownWall(tester);\n714:     });\n715: \n716:     testWidgets('GUEST CODES opens session QR panel, BACK returns',\n717:         (WidgetTester tester) async {\n718:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n719:       await tester.pumpWidget(\n720:         wallHarness(\n721:           manifest: wallManifest(),\n722:           clock: clock,\n723:           factory: fakeControllerFactory(),\n724:           guestCodeClient: fakeClient(pin: '004201'),\n725:           partyId: 'party-1',\n726:           tvDeviceId: 'tv-abc',\n727:         ),\n728:       );\n729:       await pumpWall(tester);\n730: \n731:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n732:       await tester.pump();\n733:       await tester.pump();\n734:       await tester.tap(\n735:         find.byKey(const ValueKey<String>('recovery-guest-codes')),\n736:       );\n737:       await tester.pump();\n738:       await tester.pump();\n739: \n740:       expect(find.byKey(kGuestCodePanelKey), findsOneWidget);\n741:       expect(find.text('tv-abc'), findsOneWidget);\n742:       expect(find.byType(QrImageView), findsOneWidget);\n743:       final QrImageView qr = tester.widget<QrImageView>(\n744:         find.byKey(kGuestCodeQrKey),\n745:       );\n746:       expect(\n747:         Map<String, Object?>.from(jsonDecode(qr.semanticsLabel) as Map),\n748:         <String, Object?>{\n749:           'partyId': 'party-1',\n750:           'channelId': hauntedSurveillanceChannelId,\n751:           'joinPin': '004201',\n752:         },\n753:       );\n754:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n755: \n756:       await tester.tap(find.byKey(kGuestCodeBackKey));\n757:       await tester.pump();\n758:       expect(find.byKey(kGuestCodePanelKey), findsNothing);\n759:       expect(find.text('RETRY CACHED WALL'), findsOneWidget);\n760: \n761:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n762:       await tester.pump();\n763:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n764: \n765:       await teardownWall(tester);\n766:     });\n767: \n768:     testWidgets('guest list failure shows error with no QR, TV code stays',\n769:         (WidgetTester tester) async {\n770:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n771:       await tester.pumpWidget(\n772:         wallHarness(\n773:           manifest: wallManifest(),\n774:           clock: clock,\n775:           factory: fakeControllerFactory(),\n776:           guestCodeClient: fakeClient(fail: true),\n777:           partyId: 'party-1',\n778:           tvDeviceId: 'tv-abc',\n779:         ),\n780:       );\n781:       await pumpWall(tester);\n782: \n783:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n784:       await tester.pump();\n785:       await tester.pump();\n786:       await tester.tap(\n787:         find.byKey(const ValueKey<String>('recovery-guest-codes')),\n788:       );\n789:       await tester.pump();\n790:       await tester.pump();\n791: \n792:       expect(find.text('tv-abc'), findsOneWidget);\n793:       expect(find.textContaining('denied'), findsOneWidget);\n794:       expect(find.byType(QrImageView), findsNothing);\n795: \n796:       await teardownWall(tester);\n797:     });\n798:   });\n799: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/test/guest_code_panel_test.dart, lines 1-799\n1: /// P2: TV session QR + refreshed anonymous guest listing.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:convert';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_ui/core_ui.dart';\n9: import 'package:flutter/material.dart';\n10: import 'package:flutter/services.dart';\n11: import 'package:flutter_test/flutter_test.dart';\n12: import 'package:qr_flutter/qr_flutter.dart';\n13: import 'package:testing_toolkit/testing_toolkit.dart';\n14: import 'package:tv_app/src/wall/guest_code_panel.dart';\n15: import 'package:tv_app/src/wall/guest_codes.dart';\n16: import 'package:tv_app/src/wall/wall_screen.dart';\n17: \n18: import 'support/fakes.dart';\n19: import 'wall_test.dart'\n20:     show pumpWall, teardownWall, wallHarness, wallManifest;\n21: \n22: Map<String, Object?> listingResponse({\n23:   String partyId = 'party-1',\n24:   String channelId = hauntedSurveillanceChannelId,\n25:   String tvDeviceId = 'tv-abc',\n26:   Object? joinPin = const _Absent(),\n27:   List<Object?> devices = const <Object?>[],\n28: }) {\n29:   final Map<String, Object?> map = <String, Object?>{\n30:     'partyId': partyId,\n31:     'channelId': channelId,\n32:     'tvDeviceId': tvDeviceId,\n33:     'devices': devices,\n34:   };\n35:   if (joinPin is! _Absent) {\n36:     map['joinPin'] = joinPin;\n37:   }\n38:   return map;\n39: }\n40: \n41: class _Absent {\n42:   const _Absent();\n43: }\n44: \n45: GuestCodeClient listingClient(\n46:   Map<String, Object?> response, {\n47:   List<Map<String, Object?>>? seenPayloads,\n48:   String partyId = 'party-1',\n49:   String tvDeviceId = 'tv-abc',\n50:   String channelId = hauntedSurveillanceChannelId,\n51:   Future<Map<String, Object?>> Function()? next,\n52:   int callsBeforeNext = 0,\n53: }) {\n54:   int calls = 0;\n55:   return GuestCodeClient(\n56:     invoker: (String name, Map<String, Object?> payload) async {\n57:       expect(name, 'listPartyDevices');\n58:       seenPayloads?.add(Map<String, Object?>.of(payload));\n59:       calls++;\n60:       if (next != null && calls > callsBeforeNext) {\n61:         return next();\n62:       }\n63:       return response;\n64:     },\n65:     partyId: partyId,\n66:     deviceId: tvDeviceId,\n67:     channelId: channelId,\n68:   );\n69: }\n70: \n71: Future<void> pumpPanel(\n72:   WidgetTester tester,\n73:   GuestCodeClient client, {\n74:   String tvDeviceId = 'tv-abc',\n75:   Duration refreshInterval = const Duration(minutes: 5),\n76:   VoidCallback? onBack,\n77:   VoidCallback? onClose,\n78:   FocusNode? primaryFocusNode,\n79: }) async {\n80:   await tester.pumpWidget(\n81:     MaterialApp(\n82:       theme: CctvTheme.dark(),\n83:       home: Scaffold(\n84:         body: GuestCodePanel(\n85:           client: client,\n86:           tvDeviceId: tvDeviceId,\n87:           refreshInterval: refreshInterval,\n88:           onBack: onBack,\n89:           onClose: onClose ?? () {},\n90:           primaryFocusNode: primaryFocusNode,\n91:         ),\n92:       ),\n93:     ),\n94:   );\n95: }\n96: \n97: Future<void> disposePanel(WidgetTester tester) async {\n98:   await tester.pumpWidget(const SizedBox.shrink());\n99:   await tester.pump();\n100: }\n101: \n102: String qrDataOf(WidgetTester tester) {\n103:   final QrImageView qr = tester.widget<QrImageView>(\n104:     find.byKey(kGuestCodeQrKey),\n105:   );\n106:   return qr.semanticsLabel;\n107: }\n108: \n109: void main() {\n110:   group('buildJoinPayload', () {\n111:     test('omits absent PIN and contains exactly session keys', () {\n112:       final String payload = buildJoinPayload(\n113:         partyId: 'party-1',\n114:         channelId: 'haunted_surveillance',\n115:       );\n116:       final Map<String, Object?> decoded =\n117:           Map<String, Object?>.from(jsonDecode(payload) as Map);\n118:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId'});\n119:       expect(decoded['partyId'], 'party-1');\n120:       expect(payload.contains('http'), isFalse);\n121:       expect(payload.contains('deviceId'), isFalse);\n122:     });\n123: \n124:     test('includes six-digit PIN with leading zeros significant', () {\n125:       final String payload = buildJoinPayload(\n126:         partyId: 'party-1',\n127:         channelId: 'c',\n128:         joinPin: '004201',\n129:       );\n130:       final Map<String, Object?> decoded =\n131:           Map<String, Object?>.from(jsonDecode(payload) as Map);\n132:       expect(\n133:         decoded,\n134:         <String, Object?>{\n135:           'partyId': 'party-1',\n136:           'channelId': 'c',\n137:           'joinPin': '004201',\n138:         },\n139:       );\n140:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId', 'joinPin'});\n141:     });\n142: \n143:     test('rejects malformed PIN shapes', () {\n144:       expect(\n145:         () => buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: '12345'),\n146:         throwsArgumentError,\n147:       );\n148:       expect(\n149:         () => buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: 'abcdef'),\n150:         throwsArgumentError,\n151:       );\n152:       expect(\n153:         () =>\n154:             buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: '1234567'),\n155:         throwsArgumentError,\n156:       );\n157:     });\n158: \n159:     test('no caller uses the removed deviceId argument', () {\n160:       // Compile-time proof: the old signature no longer exists. A dynamic\n161:       // call with deviceId must fail.\n162:       expect(\n163:         () => (buildJoinPayload as dynamic)(\n164:           partyId: 'p',\n165:           deviceId: 'tv',\n166:           channelId: 'c',\n167:         ),\n168:         throwsA(isA<NoSuchMethodError>()),\n169:       );\n170:     });\n171:   });\n172: \n173:   group('GuestCodeClient.fetchListing', () {\n174:     test('parses scope + PIN + entries; request carries TV deviceId', () async {\n175:       final List<Map<String, Object?>> seen = <Map<String, Object?>>[];\n176:       final GuestCodeClient client = listingClient(\n177:         listingResponse(\n178:           joinPin: '004201',\n179:           devices: <Object?>[\n180:             <String, Object?>{\n181:               'deviceId': 'g-1',\n182:               'label': 'Guest 1',\n183:               'role': 'guest',\n184:               'status': 'active',\n185:             },\n186:             <String, Object?>{'deviceId': 'g-2'},\n187:           ],\n188:         ),\n189:         seenPayloads: seen,\n190:       );\n191:       final GuestCodeListing listing = await client.fetchListing();\n192:       expect(seen.single['deviceId'], 'tv-abc');\n193:       expect(seen.single['partyId'], 'party-1');\n194:       expect(listing.partyId, 'party-1');\n195:       expect(listing.channelId, hauntedSurveillanceChannelId);\n196:       expect(listing.tvDeviceId, 'tv-abc');\n197:       expect(listing.joinPin, '004201');\n198:       expect(listing.devices, hasLength(2));\n199:       expect(listing.devices[0].label, 'Guest 1');\n200:       expect(listing.devices[1].label, isNull);\n201:       expect(listing.devices[1].displayLabel, 'Guest device');\n202:       // Back-compat path still works.\n203:       expect(await client.fetchGuestCodes(), listing.devices);\n204:     });\n205: \n206:     test('absent PIN means no PIN required', () async {\n207:       final GuestCodeClient client = listingClient(listingResponse());\n208:       final GuestCodeListing listing = await client.fetchListing();\n209:       expect(listing.joinPin, isNull);\n210:     });\n211: \n212:     test('tolerates empty-string labels', () async {\n213:       final GuestCodeClient client = listingClient(\n214:         listingResponse(\n215:           devices: <Object?>[\n216:             <String, Object?>{'deviceId': 'g-1', 'label': ''},\n217:             <String, Object?>{'deviceId': 'g-2', 'label': '   '},\n218:           ],\n219:         ),\n220:       );\n221:       final GuestCodeListing listing = await client.fetchListing();\n222:       expect(listing.devices[0].label, isNull);\n223:       expect(listing.devices[1].label, isNull);\n224:     });\n225: \n226:     test('rejects malformed scope/PIN/entries', () async {\n227:       Future<void> expectBad(Map<String, Object?> response) async {\n228:         await expectLater(\n229:           listingClient(response).fetchListing(),\n230:           throwsA(isA<GuestCodeException>()),\n231:         );\n232:       }\n233: \n234:       await expectBad(<String, Object?>{'devices': <Object?>[]});\n235:       await expectBad(\n236:         listingResponse(devices: const <Object?>[], partyId: ''),\n237:       );\n238:       await expectBad(\n239:         listingResponse(partyId: 'other-party'),\n240:       );\n241:       await expectBad(\n242:         listingResponse(channelId: 'other-channel'),\n243:       );\n244:       await expectBad(\n245:         listingResponse(tvDeviceId: 'tv-other'),\n246:       );\n247:       await expectBad(listingResponse(joinPin: '12345'));\n248:       await expectBad(listingResponse(joinPin: 'abcdef'));\n249:       await expectBad(listingResponse(joinPin: 123456));\n250:       await expectBad(\n251:         listingResponse(devices: <Object?>['nope']),\n252:       );\n253:       await expectBad(\n254:         listingResponse(\n255:           devices: <Object?>[\n256:             <String, Object?>{'deviceId': '', 'label': 'x'},\n257:           ],\n258:         ),\n259:       );\n260:       await expectBad(\n261:         listingResponse(\n262:           devices: <Object?>[\n263:             <String, Object?>{'label': 'x'},\n264:           ],\n265:         ),\n266:       );\n267:       await expectBad(\n268:         listingResponse(\n269:           devices: <Object?>[\n270:             <String, Object?>{'deviceId': 'g-1', 'label': 42},\n271:           ],\n272:         ),\n273:       );\n274:       await expectBad(<String, Object?>{'nope': true});\n275:     });\n276:   });\n277: \n278:   group('GuestCodePanel widget', () {\n279:     testWidgets('shows TV code large with exactly one QR from session',\n280:         (WidgetTester tester) async {\n281:       final GuestCodeClient client = listingClient(\n282:         listingResponse(\n283:           joinPin: '004201',\n284:           devices: <Object?>[\n285:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n286:           ],\n287:         ),\n288:       );\n289:       await pumpPanel(tester, client, onBack: () {});\n290:       await tester.pump();\n291:       await tester.pump();\n292:       expect(find.text('GUEST CODES'), findsOneWidget);\n293:       expect(find.text('tv-abc'), findsOneWidget);\n294:       expect(find.byType(QrImageView), findsOneWidget);\n295:       final Map<String, Object?> decoded =\n296:           Map<String, Object?>.from(jsonDecode(qrDataOf(tester)) as Map);\n297:       expect(\n298:         decoded,\n299:         <String, Object?>{\n300:           'partyId': 'party-1',\n301:           'channelId': hauntedSurveillanceChannelId,\n302:           'joinPin': '004201',\n303:         },\n304:       );\n305:       expect(find.textContaining('004201'), findsWidgets);\n306:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n307:       expect(find.byKey(kGuestCodeCloseKey), findsOneWidget);\n308:       expect(find.byKey(kGuestCodeBackKey), findsOneWidget);\n309:       await disposePanel(tester);\n310:     });\n311: \n312:     testWidgets('PIN-free session yields exact two-key QR + no-PIN text',\n313:         (WidgetTester tester) async {\n314:       final GuestCodeClient client = listingClient(listingResponse());\n315:       await pumpPanel(tester, client);\n316:       await tester.pump();\n317:       await tester.pump();\n318:       expect(find.byType(QrImageView), findsOneWidget);\n319:       final Map<String, Object?> decoded =\n320:           Map<String, Object?>.from(jsonDecode(qrDataOf(tester)) as Map);\n321:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId'});\n322:       expect(find.textContaining('no PIN required'), findsOneWidget);\n323:       await disposePanel(tester);\n324:     });\n325: \n326:     testWidgets('label-absent rows use neutral fallback, id shown once',\n327:         (WidgetTester tester) async {\n328:       final GuestCodeClient client = listingClient(\n329:         listingResponse(\n330:           devices: <Object?>[\n331:             <String, Object?>{'deviceId': 'g-9'},\n332:             <String, Object?>{'deviceId': 'g-10', 'label': ''},\n333:           ],\n334:         ),\n335:       );\n336:       await pumpPanel(tester, client);\n337:       await tester.pump();\n338:       await tester.pump();\n339:       expect(find.text('Guest device: g-9'), findsOneWidget);\n340:       expect(find.text('Guest device: g-10'), findsOneWidget);\n341:       // Never renders the id as both label and value.\n342:       expect(find.text('g-9: g-9'), findsNothing);\n343:       expect(find.text('g-10: g-10'), findsNothing);\n344:       expect(find.textContaining('type them in'), findsNothing);\n345:       expect(find.textContaining('dictat'), findsNothing);\n346:       await disposePanel(tester);\n347:     });\n348: \n349:     testWidgets('loading shows no fabricated QR; error shows no QR',\n350:         (WidgetTester tester) async {\n351:       final Completer<Map<String, Object?>> gate =\n352:           Completer<Map<String, Object?>>();\n353:       final GuestCodeClient slow = GuestCodeClient(\n354:         invoker: (_, __) => gate.future,\n355:         partyId: 'party-1',\n356:         deviceId: 'tv-abc',\n357:         channelId: hauntedSurveillanceChannelId,\n358:       );\n359:       await pumpPanel(tester, slow);\n360:       await tester.pump();\n361:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n362:       expect(find.byType(QrImageView), findsNothing);\n363:       expect(find.text('tv-abc'), findsOneWidget);\n364:       gate.completeError(const GuestCodeException('denied'));\n365:       await tester.pump();\n366:       await tester.pump();\n367:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n368:       expect(find.textContaining('denied'), findsOneWidget);\n369:       expect(find.byType(QrImageView), findsNothing);\n370:       await disposePanel(tester);\n371:     });\n372: \n373:     testWidgets('empty list states no seed instructions',\n374:         (WidgetTester tester) async {\n375:       final GuestCodeClient client = listingClient(listingResponse());\n376:       await pumpPanel(tester, client);\n377:       await tester.pump();\n378:       await tester.pump();\n379:       expect(find.byKey(kGuestCodeEmptyKey), findsOneWidget);\n380:       expect(find.textContaining('seed_guests'), findsNothing);\n381:       expect(find.byType(QrImageView), findsOneWidget);\n382:       await disposePanel(tester);\n383:     });\n384: \n385:     testWidgets('type-or-paste instructions with camera-deferred status',\n386:         (WidgetTester tester) async {\n387:       final GuestCodeClient client = listingClient(listingResponse());\n388:       await pumpPanel(tester, client);\n389:       await tester.pump();\n390:       await tester.pump();\n391:       expect(find.textContaining('type or paste'), findsOneWidget);\n392:       expect(find.textContaining('Camera QR scanning'), findsOneWidget);\n393:       expect(find.textContaining('reads codes aloud'), findsNothing);\n394:       expect(find.textContaining('later slice'), findsNothing);\n395:       await disposePanel(tester);\n396:     });\n397: \n398:     testWidgets('refresh after new joins updates rows + retains QR on failure',\n399:         (WidgetTester tester) async {\n400:       int calls = 0;\n401:       final GuestCodeClient client = GuestCodeClient(\n402:         invoker: (String name, Map<String, Object?> payload) async {\n403:           calls++;\n404:           if (calls == 1) {\n405:             return listingResponse(\n406:               devices: <Object?>[\n407:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n408:               ],\n409:             );\n410:           }\n411:           if (calls == 2) {\n412:             return listingResponse(\n413:               devices: <Object?>[\n414:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n415:                 <String, Object?>{'deviceId': 'g-2'},\n416:               ],\n417:             );\n418:           }\n419:           throw const GuestCodeException('flaky');\n420:         },\n421:         partyId: 'party-1',\n422:         deviceId: 'tv-abc',\n423:         channelId: hauntedSurveillanceChannelId,\n424:       );\n425:       await pumpPanel(\n426:         tester,\n427:         client,\n428:         refreshInterval: const Duration(milliseconds: 50),\n429:       );\n430:       await tester.pump();\n431:       await tester.pump();\n432:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n433:       final String firstQr = qrDataOf(tester);\n434: \n435:       await tester.pump(const Duration(milliseconds: 60));\n436:       await tester.pump();\n437:       await tester.pump();\n438:       expect(find.text('Guest device: g-2'), findsOneWidget);\n439: \n440:       await tester.pump(const Duration(milliseconds: 60));\n441:       await tester.pump();\n442:       await tester.pump();\n443:       // Last valid session retained through the refresh failure.\n444:       expect(find.byType(QrImageView), findsOneWidget);\n445:       expect(qrDataOf(tester), firstQr);\n446:       expect(find.text('Guest device: g-2'), findsOneWidget);\n447:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n448:       expect(calls, greaterThanOrEqualTo(3));\n449:       await disposePanel(tester);\n450:     });\n451: \n452:     testWidgets('overlapping refreshes never run concurrently',\n453:         (WidgetTester tester) async {\n454:       int calls = 0;\n455:       final Completer<Map<String, Object?>> gate =\n456:           Completer<Map<String, Object?>>();\n457:       final GuestCodeClient client = GuestCodeClient(\n458:         invoker: (_, __) {\n459:           calls++;\n460:           if (calls == 1) {\n461:             return gate.future;\n462:           }\n463:           return Future.value(listingResponse());\n464:         },\n465:         partyId: 'party-1',\n466:         deviceId: 'tv-abc',\n467:         channelId: hauntedSurveillanceChannelId,\n468:       );\n469:       await pumpPanel(\n470:         tester,\n471:         client,\n472:         refreshInterval: const Duration(milliseconds: 20),\n473:       );\n474:       await tester.pump();\n475:       expect(calls, 1);\n476:       // Periodic ticks while the first fetch is still in flight are skipped.\n477:       await tester.pump(const Duration(milliseconds: 60));\n478:       await tester.pump();\n479:       expect(calls, 1);\n480:       gate.complete(listingResponse());\n481:       await tester.pump();\n482:       await tester.pump();\n483:       expect(find.byType(QrImageView), findsOneWidget);\n484:       // The next tick after the in-flight fetch settled runs normally.\n485:       await tester.pump(const Duration(milliseconds: 40));\n486:       await tester.pump();\n487:       await tester.pump();\n488:       expect(calls, greaterThanOrEqualTo(2));\n489:       await disposePanel(tester);\n490:     });\n491: \n492:     testWidgets('hung fetch times out and the panel retries to recovery',\n493:         (WidgetTester tester) async {\n494:       int calls = 0;\n495:       final GuestCodeClient client = GuestCodeClient(\n496:         invoker: (_, __) {\n497:           calls++;\n498:           if (calls <= 2) {\n499:             // Never completes: without the fetch timeout these would hold\n500:             // `_fetching` true forever and wedge the panel.\n501:             return Completer<Map<String, Object?>>().future;\n502:           }\n503:           return Future.value(\n504:             listingResponse(\n505:               joinPin: '004201',\n506:               devices: <Object?>[\n507:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n508:               ],\n509:             ),\n510:           );\n511:         },\n512:         partyId: 'party-1',\n513:         deviceId: 'tv-abc',\n514:         channelId: hauntedSurveillanceChannelId,\n515:       );\n516:       await pumpPanel(\n517:         tester,\n518:         client,\n519:         refreshInterval: const Duration(seconds: 5),\n520:       );\n521:       await tester.pump();\n522:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n523:       expect(calls, 1);\n524: \n525:       // The periodic tick while the first fetch hangs is skipped.\n526:       await tester.pump(const Duration(seconds: 5));\n527:       await tester.pump();\n528:       expect(calls, 1);\n529: \n530:       // The hung fetch times out: error state, no fabricated QR. The next\n531:       // tick retries (the in-flight guard was released by the timeout), and\n532:       // that retry hangs too — the error state persists across the tick.\n533:       await tester.pump(const Duration(seconds: 6));\n534:       await tester.pump();\n535:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n536:       expect(find.textContaining('timed out'), findsOneWidget);\n537:       expect(find.byType(QrImageView), findsNothing);\n538:       expect(calls, 2);\n539: \n540:       await tester.pump(const Duration(seconds: 4));\n541:       await tester.pump();\n542:       expect(calls, 2);\n543:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n544:       expect(find.byType(QrImageView), findsNothing);\n545: \n546:       // The second hung fetch times out as well; the following tick retries\n547:       // and the panel recovers with the authoritative session.\n548:       await tester.pump(const Duration(seconds: 6));\n549:       await tester.pump();\n550:       await tester.pump();\n551:       await tester.pump(const Duration(seconds: 5));\n552:       await tester.pump();\n553:       await tester.pump();\n554:       expect(calls, greaterThanOrEqualTo(3));\n555:       expect(find.byType(QrImageView), findsOneWidget);\n556:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n557:       await disposePanel(tester);\n558:     });\n559: \n560:     testWidgets('dispose cancels timer and ignores late responses',\n561:         (WidgetTester tester) async {\n562:       int calls = 0;\n563:       final Completer<Map<String, Object?>> late =\n564:           Completer<Map<String, Object?>>();\n565:       final GuestCodeClient client = GuestCodeClient(\n566:         invoker: (_, __) {\n567:           calls++;\n568:           if (calls == 1) {\n569:             return late.future;\n570:           }\n571:           return Future.value(listingResponse());\n572:         },\n573:         partyId: 'party-1',\n574:         deviceId: 'tv-abc',\n575:         channelId: hauntedSurveillanceChannelId,\n576:       );\n577:       await pumpPanel(\n578:         tester,\n579:         client,\n580:         refreshInterval: const Duration(milliseconds: 20),\n581:       );\n582:       await tester.pump();\n583:       final int callsAtOpen = calls;\n584:       expect(callsAtOpen, 1);\n585:       await tester.pumpWidget(const SizedBox.shrink());\n586:       await tester.pump();\n587:       late.complete(listingResponse());\n588:       await tester.pump(const Duration(milliseconds: 100));\n589:       await tester.pump();\n590:       expect(calls, callsAtOpen);\n591:       expect(tester.takeException(), isNull);\n592:       // Already disposed; nothing further to tear down.\n593:     });\n594: \n595:     testWidgets('D-pad back/close keys invoke callbacks',\n596:         (WidgetTester tester) async {\n597:       bool backed = false;\n598:       bool closed = false;\n599:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n600:       addTearDown(primary.dispose);\n601:       final GuestCodeClient client = listingClient(listingResponse());\n602:       await pumpPanel(\n603:         tester,\n604:         client,\n605:         onBack: () => backed = true,\n606:         onClose: () => closed = true,\n607:         primaryFocusNode: primary,\n608:       );\n609:       await tester.pump();\n610:       await tester.pump();\n611:       primary.requestFocus();\n612:       await tester.pump();\n613:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n614:       await tester.pump();\n615:       expect(backed, isTrue);\n616:       expect(closed, isFalse);\n617:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n618:       await tester.pump();\n619:       expect(closed, isTrue);\n620:       primary.unfocus();\n621:       await disposePanel(tester);\n622:     });\n623: \n624:     testWidgets('escape falls back to onClose when no onBack',\n625:         (WidgetTester tester) async {\n626:       bool closed = false;\n627:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n628:       addTearDown(primary.dispose);\n629:       final GuestCodeClient client = listingClient(listingResponse());\n630:       await pumpPanel(\n631:         tester,\n632:         client,\n633:         onClose: () => closed = true,\n634:         primaryFocusNode: primary,\n635:       );\n636:       await tester.pump();\n637:       await tester.pump();\n638:       expect(find.byKey(kGuestCodeBackKey), findsNothing);\n639:       primary.requestFocus();\n640:       await tester.pump();\n641:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n642:       await tester.pump();\n643:       expect(closed, isTrue);\n644:       primary.unfocus();\n645:       await disposePanel(tester);\n646:     });\n647: \n648:     testWidgets('1920x1080 layout smoke: no overflow, one QR',\n649:         (WidgetTester tester) async {\n650:       addTearDown(tester.view.resetPhysicalSize);\n651:       addTearDown(tester.view.resetDevicePixelRatio);\n652:       tester.view.physicalSize = const Size(1920, 1080);\n653:       tester.view.devicePixelRatio = 1.0;\n654:       final GuestCodeClient client = listingClient(\n655:         listingResponse(\n656:           joinPin: '123456',\n657:           devices: <Object?>[\n658:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n659:           ],\n660:         ),\n661:       );\n662:       await pumpPanel(tester, client, onBack: () {});\n663:       await tester.pump();\n664:       await tester.pump();\n665:       expect(find.byType(QrImageView), findsOneWidget);\n666:       expect(find.text('tv-abc'), findsOneWidget);\n667:       expect(tester.takeException(), isNull);\n668:       await disposePanel(tester);\n669:     });\n670:   });\n671: \n672:   group('WallScreen guest-code flow', () {\n673:     GuestCodeClient fakeClient({bool fail = false, String? pin}) =>\n674:         GuestCodeClient(\n675:           invoker: (_, __) async {\n676:             if (fail) {\n677:               throw const GuestCodeException('denied');\n678:             }\n679:             return listingResponse(\n680:               joinPin: pin ?? const _Absent(),\n681:               devices: <Object?>[\n682:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n683:               ],\n684:             );\n685:           },\n686:           partyId: 'party-1',\n687:           deviceId: 'tv-abc',\n688:           channelId: hauntedSurveillanceChannelId,\n689:         );\n690: \n691:     testWidgets('no client means no GUEST CODES button',\n692:         (WidgetTester tester) async {\n693:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n694:       await tester.pumpWidget(\n695:         wallHarness(\n696:           manifest: wallManifest(),\n697:           clock: clock,\n698:           factory: fakeControllerFactory(),\n699:         ),\n700:       );\n701:       await pumpWall(tester);\n702: \n703:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n704:       await tester.pump();\n705:       await tester.pump();\n706:       expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n707:       expect(find.text('GUEST CODES'), findsNothing);\n708: \n709:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n710:       await tester.pump();\n711:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n712: \n713:       await teardownWall(tester);\n714:     });\n715: \n716:     testWidgets('GUEST CODES opens session QR panel, BACK returns',\n717:         (WidgetTester tester) async {\n718:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n719:       await tester.pumpWidget(\n720:         wallHarness(\n721:           manifest: wallManifest(),\n722:           clock: clock,\n723:           factory: fakeControllerFactory(),\n724:           guestCodeClient: fakeClient(pin: '004201'),\n725:           partyId: 'party-1',\n726:           tvDeviceId: 'tv-abc',\n727:         ),\n728:       );\n729:       await pumpWall(tester);\n730: \n731:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n732:       await tester.pump();\n733:       await tester.pump();\n734:       await tester.tap(\n735:         find.byKey(const ValueKey<String>('recovery-guest-codes')),\n736:       );\n737:       await tester.pump();\n738:       await tester.pump();\n739: \n740:       expect(find.byKey(kGuestCodePanelKey), findsOneWidget);\n741:       expect(find.text('tv-abc'), findsOneWidget);\n742:       expect(find.byType(QrImageView), findsOneWidget);\n743:       final QrImageView qr = tester.widget<QrImageView>(\n744:         find.byKey(kGuestCodeQrKey),\n745:       );\n746:       expect(\n747:         Map<String, Object?>.from(jsonDecode(qr.semanticsLabel) as Map),\n748:         <String, Object?>{\n749:           'partyId': 'party-1',\n750:           'channelId': hauntedSurveillanceChannelId,\n751:           'joinPin': '004201',\n752:         },\n753:       );\n754:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n755: \n756:       await tester.tap(find.byKey(kGuestCodeBackKey));\n757:       await tester.pump();\n758:       expect(find.byKey(kGuestCodePanelKey), findsNothing);\n759:       expect(find.text('RETRY CACHED WALL'), findsOneWidget);\n760: \n761:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n762:       await tester.pump();\n763:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n764: \n765:       await teardownWall(tester);\n766:     });\n767: \n768:     testWidgets('guest list failure shows error with no QR, TV code stays',\n769:         (WidgetTester tester) async {\n770:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n771:       await tester.pumpWidget(\n772:         wallHarness(\n773:           manifest: wallManifest(),\n774:           clock: clock,\n775:           factory: fakeControllerFactory(),\n776:           guestCodeClient: fakeClient(fail: true),\n777:           partyId: 'party-1',\n778:           tvDeviceId: 'tv-abc',\n779:         ),\n780:       );\n781:       await pumpWall(tester);\n782: \n783:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n784:       await tester.pump();\n785:       await tester.pump();\n786:       await tester.tap(\n787:         find.byKey(const ValueKey<String>('recovery-guest-codes')),\n788:       );\n789:       await tester.pump();\n790:       await tester.pump();\n791: \n792:       expect(find.text('tv-abc'), findsOneWidget);\n793:       expect(find.textContaining('denied'), findsOneWidget);\n794:       expect(find.byType(Q