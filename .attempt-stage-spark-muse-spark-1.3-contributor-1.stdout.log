4:         : resolveCctvLabel(match);\n175:     return Card(\n176:       key: Key('camera-${slot.id}'),\n177:       margin: const EdgeInsets.symmetric(vertical: 6),\n178:       child: ListTile(\n179:         title: Text(label, style: CctvTheme.labelStyle.copyWith(fontSize: 20)),\n180:         subtitle: Text(\n181:           match == null ? 'No clip published' : 'Clip ${match.id}',\n182:           style: const TextStyle(fontSize: 16),\n183:         ),\n184:       ),\n185:     );\n186:   }\n187: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a5a3fe7121b49ea8470b8fd11a"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/ui/now_playing_screen.dart\"}"},"time":{"start":1793461691470,"end":1793461691977}}}}
