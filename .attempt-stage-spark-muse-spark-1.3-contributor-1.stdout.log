{"type":"tool_use","timestamp":1793464381112,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192ce9575001SAZtCUxH7AzR4x","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192ce8f38001GDGJLAqU534Lko","type":"tool","id":"call_01a192ce929c70d19c727b2a43711d79","tool":"write","state":{"status":"completed","input":{"content":"// On-device camera join regression (physical Pixel, manual run).\n//\n// Run (from apps/companion_app, release + live defines, permission\n// pre-granted so no OS dialog blocks the run, on a camera-capable device):\n//\n//   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n//   flutter test integration_test/camera_join_scan_device_test.dart \\\n//     --dart-define=DEVICE_CAMERA=true \\\n//     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n//     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n//     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\n//     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\n//\n// What it proves on hardware: the shipped join screen pushes the real\n// QrScanScreen and the native camera preview initializes (no black stall\n// after the permission grant), cancellation returns to a usable join form,\n// and the type-or-paste path still joins. Aiming the camera at a real\n// party QR and reaching the lineup is covered by the manual written\n// procedure in docs/COMPANION-CAMERA-PROOF.md (human aims the camera;\n// automation cannot point the lens).\n//\n// Both tests need physical hardware, so they stay skipped with a reason\n// everywhere else (never a vacuous pass). The paste-join additionally\n// requires DEVICE_PARTY_ID/DEVICE_CHANNEL_ID; it registers one guest\n// device against the seeded rehearsal party (same cost class as the typed\n// manual join in rehearsal NOTES — no generation, no spend).\nlibrary;\n\nimport 'package:companion_app/src/companion_app.dart';\nimport 'package:companion_app/src/join/qr_scan_screen.dart';\nimport 'package:companion_app/src/ui/host_entry_screen.dart';\nimport 'package:companion_app/src/ui/join_screen.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:integration_test/integration_test.dart';\nimport 'package:shared_preferences/shared_preferences.dart';\n\nconst String _devicePartyId = String.fromEnvironment('DEVICE_PARTY_ID');\nconst String _deviceChannelId = String.fromEnvironment('DEVICE_CHANNEL_ID');\nconst bool _deviceCamera = bool.fromEnvironment('DEVICE_CAMERA');\n\nFuture<void> _settle(WidgetTester tester) async {\n  for (int i = 0; i < 12; i++) {\n    await tester.pump(const Duration(milliseconds: 250));\n  }\n}\n\n/// Hardware gate: without an explicit on-device opt-in the test is\n/// skipped with a reason, so a missing device never reads as a pass.\nvoid _requireDevice(String what) {\n  if (!_deviceCamera) {\n    markTestSkipped(\n      'Requires physical $what; rerun with '\n      '--dart-define=DEVICE_CAMERA=true on a camera-capable device '\n      '(see docs/COMPANION-CAMERA-PROOF.md).',\n    );\n  }\n}\n\nvoid main() {\n  IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n\n  testWidgets('device: granted camera opens the live scanner', (\n    tester,\n  ) async {\n    _requireDevice('camera hardware');\n    SharedPreferences.setMockInitialValues(<String, Object>{});\n    await tester.pumpWidget(const CompanionApp());\n    await _settle(tester);\n    // Host-first boot: take the explicit guest route before scanning.\n    expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n    await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\n    await _settle(tester);\n    expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n\n    await tester.ensureVisible(find.byKey(JoinScreen.scanKey));\n    await tester.pump(const Duration(milliseconds: 250));\n    await tester.tap(find.byKey(JoinScreen.scanKey));\n    await _settle(tester);\n\n    // The real scan screen is up (camera preview initializes on device;\n    // a post-grant stall would leave the join screen showing instead).\n    expect(find.byType(QrScanScreen), findsOneWidget);\n    expect(find.byKey(QrScanScreen.scannerKey), findsOneWidget);\n\n    await tester.tap(find.byKey(QrScanScreen.closeKey));\n    await _settle(tester);\n    expect(find.byType(QrScanScreen), findsNothing);\n    expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n  });\n\n  testWidgets('device: pasted join data joins the seeded party', (\n    tester,\n  ) async {\n    _requireDevice('device backend access');\n    if (_devicePartyId.isEmpty || _deviceChannelId.isEmpty) {\n      markTestSkipped(\n        'Pass --dart-define=DEVICE_PARTY_ID=... DEVICE_CHANNEL_ID=... '\n        '(see docs/COMPANION-CAMERA-PROOF.md).',\n      );\n    }\n    SharedPreferences.setMockInitialValues(<String, Object>{});\n    await tester.pumpWidget(const CompanionApp());\n    await _settle(tester);\n    await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\n    await _settle(tester);\n\n    await tester.enterText(\n      find.byKey(JoinScreen.payloadFieldKey),\n      '{\"partyId\":\"$_devicePartyId\",\"channelId\":\"$_deviceChannelId\"}',\n    );\n    await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n    await tester.pump(const Duration(milliseconds: 250));\n    await tester.tap(find.byKey(JoinScreen.submitKey));\n    await _settle(tester);\n\n    expect(find.textContaining('Manifest version'), findsOneWidget);\n  });\n}\n","path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart"},"output":"Wrote file successfully: apps/companion_app/integration_test/camera_join_scan_device_test.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: apps/companion_app/integration_test/camera_join_scan_device_test.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192ce929c70d19c727b2a43711d79"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"// On-device camera join regression (physical Pixel, manual run).\\n//\\n// Run (from apps/companion_app, release + live defines, permission\\n// pre-granted so no OS dialog blocks the run, on a camera-capable device):\\n//\\n//   adb -s <serial> shell pm grant <package> android.permission.CAMERA\\n//   flutter test integration_test/camera_join_scan_device_test.dart \\\\\\n//     --dart-define=DEVICE_CAMERA=true \\\\\\n//     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\\\\n//     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\\\\n//     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\\\\n//     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\\n//\\n// What it proves on hardware: the shipped join screen pushes the real\\n// QrScanScreen and the native camera preview initializes (no black stall\\n// after the permission grant), cancellation returns to a usable join form,\\n// and the type-or-paste path still joins. Aiming the camera at a real\\n// party QR and reaching the lineup is covered by the manual written\\n// procedure in docs/COMPANION-CAMERA-PROOF.md (human aims the camera;\\n// automation cannot point the lens).\\n//\\n// Both tests need physical hardware, so they stay skipped with a reason\\n// everywhere else (never a vacuous pass). The paste-join additionally\\n// requires DEVICE_PARTY_ID/DEVICE_CHANNEL_ID; it registers one guest\\n// device against the seeded rehearsal party (same cost class as the typed\\n// manual join in rehearsal NOTES — no generation, no spend).\\nlibrary;\\n\\nimport 'package:companion_app/src/companion_app.dart';\\nimport 'package:companion_app/src/join/qr_scan_screen.dart';\\nimport 'package:companion_app/src/ui/host_entry_screen.dart';\\nimport 'package:companion_app/src/ui/join_screen.dart';\\nimport 'package:flutter_test/flutter_test.dart';\\nimport 'package:integration_test/integration_test.dart';\\nimport 'package:shared_preferences/shared_preferences.dart';\\n\\nconst String _devicePartyId = String.fromEnvironment('DEVICE_PARTY_ID');\\nconst String _deviceChannelId = String.fromEnvironment('DEVICE_CHANNEL_ID');\\nconst bool _deviceCamera = bool.fromEnvironment('DEVICE_CAMERA');\\n\\nFuture<void> _settle(WidgetTester tester) async {\\n  for (int i = 0; i < 12; i++) {\\n    await tester.pump(const Duration(milliseconds: 250));\\n  }\\n}\\n\\n/// Hardware gate: without an explicit on-device opt-in the test is\\n/// skipped with a reason, so a missing device never reads as a pass.\\nvoid _requireDevice(String what) {\\n  if (!_deviceCamera) {\\n    markTestSkipped(\\n      'Requires physical $what; rerun with '\\n      '--dart-define=DEVICE_CAMERA=true on a camera-capable device '\\n      '(see docs/COMPANION-CAMERA-PROOF.md).',\\n    );\\n  }\\n}\\n\\nvoid main() {\\n  IntegrationTestWidgetsFlutterBinding.ensureInitialized();\\n\\n  testWidgets('device: granted camera opens the live scanner', (\\n    tester,\\n  ) async {\\n    _requireDevice('camera hardware');\\n    SharedPreferences.setMockInitialValues(<String, Object>{});\\n    await tester.pumpWidget(const CompanionApp());\\n    await _settle(tester);\\n    // Host-first boot: take the explicit guest route before scanning.\\n    expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\\n    await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\\n    await _settle(tester);\\n    expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\\n\\n    await tester.ensureVisible(find.byKey(JoinScreen.scanKey));\\n    await tester.pump(const Duration(milliseconds: 250));\\n    await tester.tap(find.byKey(JoinScreen.scanKey));\\n    await _settle(tester);\\n\\n    // The real scan screen is up (camera preview initializes on device;\\n    // a post-grant stall would leave the join screen showing instead).\\n    expect(find.byType(QrScanScreen), findsOneWidget);\\n    expect(find.byKey(QrScanScreen.scannerKey), findsOneWidget);\\n\\n    await tester.tap(find.byKey(QrScanScreen.closeKey));\\n    await _settle(tester);\\n    expect(find.byType(QrScanScreen), findsNothing);\\n    expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\\n  });\\n\\n  testWidgets('device: pasted join data joins the seeded party', (\\n    tester,\\n  ) async {\\n    _requireDevice('device backend access');\\n    if (_devicePartyId.isEmpty || _deviceChannelId.isEmpty) {\\n      markTestSkipped(\\n        'Pass --dart-define=DEVICE_PARTY_ID=... DEVICE_CHANNEL_ID=... '\\n        '(see docs/COMPANION-CAMERA-PROOF.md).',\\n      );\\n    }\\n    SharedPreferences.setMockInitialValues(<String, Object>{});\\n    await tester.pumpWidget(const CompanionApp());\\n    await _settle(tester);\\n    await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\\n    await _settle(tester);\\n\\n    await tester.enterText(\\n      find.byKey(JoinScreen.payloadFieldKey),\\n      '{\\\"partyId\\\":\\\"$_devicePartyId\\\",\\\"channelId\\\":\\\"$_deviceChannelId\\\"}',\\n    );\\n    await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\\n    await tester.pump(const Duration(milliseconds: 250));\\n    await tester.tap(find.byKey(JoinScreen.submitKey));\\n    await _settle(tester);\\n\\n    expect(find.textContaining('Manifest version'), findsOneWidget);\\n  });\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart\"}"},"time":{"start":1793464374645,"end":1793464381112}}}}
