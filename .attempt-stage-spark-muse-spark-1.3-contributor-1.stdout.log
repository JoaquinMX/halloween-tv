:     if (devices is! List) {\n196:       throw const GuestCodeException('Guest list response has no device list.');\n197:     }\n198:     final List<GuestCodeEntry> entries = <GuestCodeEntry>[];\n199:     for (final Object? item in devices) {\n200:       if (item is! Map) {\n201:         throw const GuestCodeException('Guest list entry was not an object.');\n202:       }\n203:       final Map<String, Object?> row = Map<String, Object?>.from(item);\n204:       final Object? deviceId = row['deviceId'];\n205:       if (deviceId is! String || deviceId.isEmpty) {\n206:         throw const GuestCodeException('Guest list entry is missing fields.');\n207:       }\n208:       String? label;\n209:       if (row.containsKey('label')) {\n210:         final Object? rawLabel = row['label'];\n211:         if (rawLabel == null) {\n212:           label = null;\n213:         } else if (rawLabel is String) {\n214:           label = rawLabel.trim().isEmpty ? null : rawLabel.trim();\n215:         } else {\n216:           throw const GuestCodeException('Guest list entry is missing fields.');\n217:         }\n218:       }\n219:       String? role;\n220:       if (row.containsKey('role')) {\n221:         final Object? rawRole = row['role'];\n222:         if (rawRole == null) {\n223:           role = null;\n224:         } else if (rawRole is String && rawRole.isNotEmpty) {\n225:           role = rawRole;\n226:         } else {\n227:           throw const GuestCodeException('Guest list entry is missing fields.');\n228:         }\n229:       }\n230:       String? status;\n231:       if (row.containsKey('status')) {\n232:         final Object? rawStatus = row['status'];\n233:         if (rawStatus == null) {\n234:           status = null;\n235:         } else if (rawStatus is String && rawStatus.isNotEmpty) {\n236:           status = rawStatus;\n237:         } else {\n238:           throw const GuestCodeException('Guest list entry is missing fields.');\n239:         }\n240:       }\n241:       entries.add(\n242:         GuestCodeEntry(\n243:           deviceId: deviceId,\n244:           label: label,\n245:           role: role,\n246:           status: status,\n247:         ),\n248:       );\n249:     }\n250:     return GuestCodeListing(\n251:       partyId: partyId,\n252:       channelId: channelId,\n253:       tvDeviceId: tvDeviceId,\n254:       joinPin: joinPin,\n255:       devices: List<GuestCodeEntry>.unmodifiable(entries),\n256:     );\n257:   }\n258: }\n259: \n260: /// Reads the host-only `listPartyDevices` callable (TV device only).\n261: final class GuestCodeClient {\n262:   /// Creates a client over an invoker seam.\n263:   const GuestCodeClient({\n264:     required this.invoker,\n265:     required this.partyId,\n266:     required this.deviceId,\n267:     required this.channelId,\n268:   });\n269: \n270:   /// Builds a client over real Cloud Functions.\n271:   factory GuestCodeClient.cloudFunctions({\n272:     required FirebaseFunctions functions,\n273:     required String partyId,\n274:     required String deviceId,\n275:     required String channelId,\n276:   }) => GuestCodeClient(\n277:     invoker: (String name, Map<String, Object?> payload) async {\n278:       final HttpsCallableResult<Object?> result = await functions\n279:           .httpsCallable(name)\n280:           .call(payload);\n281:       final Object? data = result.data;\n282:       if (data is! Map) {\n283:         throw const GuestCodeException(\n284:           'Guest list response was not an object.',\n285:         );\n286:       }\n287:       return Map<String, Object?>.from(data);\n288:     },\n289:     partyId: partyId,\n290:     deviceId: deviceId,\n291:     channelId: channelId,\n292:   );\n293: \n294:   /// Invoker seam (Cloud Functions in production, fake in tests).\n295:   final CallableInvoker invoker;\n296: \n297:   /// Party the TV belongs to.\n298:   final String partyId;\n299: \n300:   /// TV's own device code (the authorized host caller).\n301:   final String deviceId;\n302: \n303:   /// Active channel.\n304:   final String channelId;\n305: \n306:   /// Fetches the validated host listing (scope + optional PIN + devices).\n307:   ///\n308:   /// Authorization still travels in the request as the TV's own `deviceId`;\n309:   /// the session QR never carries it. Throws [GuestCodeException] when the\n310:   /// response is malformed. Authorization failures surface as the caller's\n311:   /// error.\n312:   Future<GuestCodeListing> fetchListing() async {\n313:     final Map<String, Object?> data = await invoker(\n314:       'listPartyDevices',\n315:       <String, Object?>{\n316:         'partyId': partyId,\n317:         'deviceId': deviceId,\n318:         'channelId': channelId,\n319:       },\n320:     );\n321:     return GuestCodeListing.fromResponse(\n322:       data,\n323:       expectedPartyId: partyId,\n324:       expectedChannelId: channelId,\n325:       expectedTvDeviceId: deviceId,\n326:     );\n327:   }\n328: \n329:   /// Fetches guest codes; throws [GuestCodeException] when the response is\n330:   /// malformed. Authorization failures surface as the caller's error.\n331:   Future<List<GuestCodeEntry>> fetchGuestCodes() async {\n332:     final GuestCodeListing listing = await fetchListing();\n333:     return listing.devices;\n334:   }\n335: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c32a65769e8cf53561467c7288"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/guest_codes.dart\"}"},"time":{"start":1793463626376,"end":1793463626774}}}}
