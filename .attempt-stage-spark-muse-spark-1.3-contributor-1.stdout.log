turn `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`;\n45: }\n46: \n47: export function parseGuestObjectPath(objectPath: string): { partyId: string; deviceId: string; submissionId: string } | undefined {\n48:   const match = OBJECT_RE.exec(objectPath);\n49:   if (!match) return undefined;\n50:   return { partyId: match[1], deviceId: match[2], submissionId: match[3] };\n51: }\n52: \n53: export function guestMediaRef(db: Firestore, partyId: string, submissionId: string) {\n54:   return db.doc(`parties/${partyId}/${GUEST_MEDIA_COLLECTION}/${submissionId}`);\n55: }\n56: \n57: export function consentRevisionFor(acceptedAtIso: string): string {\n58:   return `${GUEST_CONSENT_TEXT_VERSION}:${acceptedAtIso}`;\n59: }\n60: \n61: function expiryMs(value: unknown): number | undefined {\n62:   if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n63:     return (value as { toDate: () => Date }).toDate().getTime();\n64:   }\n65:   if (value instanceof Date) return value.getTime();\n66:   if (typeof value === \"string\") {\n67:     const parsed = Date.parse(value);\n68:     return Number.isFinite(parsed) ? parsed : undefined;\n69:   }\n70:   return undefined;\n71: }\n72: \n73: /**\n74:  * Consent-bound eligibility gate shared by request, worker-submission, and\n75:  * transactional publication paths. Throws FORBIDDEN when consent was\n76:  * withdrawn or the binding does not match the caller, CLIP_EXPIRED when the\n77:  * input window lapsed, NOT_FOUND for unknown submissions.\n78:  */\n79: export async function assertGuestEligible(\n80:   db: Firestore,\n81:   identity: Identity,\n82:   submissionId: string,\n83:   nowMs: number,\n84: ): Promise<GuestMediaDoc> {\n85:   const snapshot = await guestMediaRef(db, identity.partyId, submissionId).get();\n86:   if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Guest media does not exist.\");\n87:   const doc = snapshot.da