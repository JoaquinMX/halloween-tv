3: \n34: export interface RetentionResult {\n35:   expiredJobs: number;\n36:   deletedExpiredObjects: number;\n37:   deletedOrphanObjects: number;\n38:   expiredGuestInputs: number;\n39: }\n40: \n41: /** Scheduled TTL transition plus orphan cleanup; object deletion is idempotent. */\n42: export async function sweepExpiredMedia(\n43:   db: Firestore,\n44:   bucket: Bucket,\n45:   now = new Date(),\n46: ): Promise<RetentionResult> {\n47:   const expiredSnapshot = await db.collectionGroup(\"jobs\")\n48:     .where(\"expiresAt\", \"<=\", Timestamp.fromDate(now))\n49:     .get();\n50:   let expiredJobs = 0;\n51:   for (const snapshot of expiredSnapshot.docs) {\n52:     const job = snapshot.data();\n53:     const paths = new Set<string>();\n54:     addPaths(paths, job.deliveryPaths);\n55:     addPaths(paths, job.generatedPaths);\n56:     // Staged camera outputs of a dead job are temporary: purge them here so\n57:     // they do not linger past expiry (live staged outputs are protected by\n58:     // the references set below, never by this block).\n59:     const staged = job.stagedOutputs;\n60:     if (staged && typeof staged === \"object\") {\n61:       for (const clip of Object.values(staged as Record<string, unknown>)) {\n62:         if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\" &&\n63:             ((clip as Record<string, unknown>).objectPath as string).startsWith(\"parties/\")) {\n64:           paths.add((clip as Record<string, unknown>).objectPath as string);\n65:         }\n66:       }\n67:     }\n68:     await db.runTransaction(async (transaction) => {\n69:       const current = await transaction.get(snapshot.ref);\n70:       if (!current.exists) return;\n71:       const data = current.data()!;\n72:       if (data.state !== \"purged\" && data.state !== \"expired\") {\n73:         transaction.update(snapshot.ref, {\n74:           state: \"expired\",\n75:           errorCode: \"CLIP_EXPIRED\",\n76:      