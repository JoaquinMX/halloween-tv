327:       final List<int> activatedVersions = <int>[];\n328:       final LiveWallSession session = LiveWallSession(\n329:         partyId: _party,\n330:         channelId: _channel,\n331:         manifestSource: source,\n332:         preparation: composition.prepare,\n333:       );\n334:       session.start(\n335:         activate: (PlaybackSyncSnapshot snapshot) async {\n336:           activatedVersions.add(snapshot.manifest!.version);\n337:         },\n338:       );\n339:       final PlaybackManifest one = _manifest(\n340:         1,\n341:         (int camera) => _liveBytes(camera, 1),\n342:       );\n343:       source.controller.add(one);\n344:       await _waitFor(() => activatedVersions.length == 1);\n345: \n346:       source.controller.add(\n347:         _manifest(1, (int camera) => _liveBytes(camera, 9)),\n348:       );\n349:       source.controller.add(\n350:         _manifest(3, (int camera) => _liveBytes(camera, 3)),\n351:       );\n352:       source.controller.add(\n353:         _manifest(2, (int camera) => _liveBytes(camera, 2)),\n354:       );\n355:       await _waitFor(\n356:         () => activatedVersions.isNotEmpty && activatedVersions.last == 3,\n357:       );\n358:       await Future<void>.delayed(const Duration(milliseconds: 30));\n359:       expect(activatedVersions, contains(3));\n360:       expect(activatedVersions.last, 3);\n361: \n362:       final CommittedManifestIndex? committed = await FileManifestIndexStore(\n363:         Directory('${root.path}/index'),\n364:       ).readCommitted(partyId: _party, channelId: _channel);\n365:       expect(committed?.manifest.version, 3);\n366:       expect(\n367:         committed!.manifest.clips.first.sha256,\n368:         sha256Hex(_liveBytes(1, 3)),\n369:         reason: 'conflicting v1 and a late v2 cannot replace v3',\n370:       );\n371:       await session.dispose();\n372:       expect(source.cancelled, isTrue);\n373:     },\n374:   );\n375: \n376:   test(\n377:     'decoder activation failure is not retried against the same bytes',\n378:     () async {\n379:       final Directory root = await Directory.systemTemp.createTemp(\n380:         'tv-live-decoder-failure-',\n381:       );\n382:       addTearDown(() => root.delete(recursive: true));\n383:       final _ManifestStream source = _ManifestStream();\n384:       final composition = await _composition(\n385:         root: root,\n386:         source: source,\n387:         payloadFor: (ClipDescriptor clip) =>\n388:             _liveBytes(int.parse(clip.cameraId.substring(4)), 4),\n389:       );\n390:       var activationAttempts = 0;\n391:       final LiveWallSession session = LiveWallSession(\n392:         partyId: _party,\n393:         channelId: _channel,\n394:         manifestSource: source,\n395:         preparation: composition.prepare,\n396:       );\n397:       session.start(\n398:         activate: (PlaybackSyncSnapshot snapshot) async {\n399:           activationAttempts++;\n400:           throw StateError('decoder failed and WallScreen rolled back');\n401:         },\n402:       );\n403:       source.controller.add(\n404:         _manifest(4, (int camera) => _liveBytes(camera, 4)),\n405:       );\n406:       await _waitFor(() => activationAttempts == 1);\n407:       // No extra sleep: the decoder-failure path records _lastFailedFingerprint\n408:       // and schedules no retry timer, so the same bytes can never activate\n409:       // again without a new observation (of which there are none). The\n410:       // pre-change fixed 30ms sleep guarded nothing; quiescence here is\n411:       // structural, verified by downloader.calls staying at 4 below.\n412: \n413:       expect(activationAttempts, 1);\n414:       expect(composition.downloader.calls, 4);\n415:       expect(\n416:         composition.prepare.snapshot.state,\n417:         PlaybackSyncState.errorRecoverable,\n418:       );\n419:       await session.dispose();\n420:     },\n421:   );\n422: }"}],"providerCall":{"executed":false,"state":{"it