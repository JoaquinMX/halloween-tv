{"type":"step_start","timestamp":1793461053395,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"id":"prt_1929be7d3001erfYIFnEE0Izzj","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929bde37001uIt7SJVZ26qZof","type":"step-start","snapshot":"40461a114fa4603ed8c438d2d3be02a9089fe278"}}
{"type":"tool_use","timestamp":1793461053929,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929be7e0001GBtPyJ7LMgvX3a","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929bde37001uIt7SJVZ26qZof","type":"tool","id":"call_01a1929be203711cb347dfb4bb7b849c","tool":"write","state":{"status":"completed","input":{"content":"import { createHash, randomBytes } from \"node:crypto\";\nimport { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\nimport {\n  BackendError,\n  CreateHostInviteResult,\n  JoinHostResult,\n  parseCreateHostInviteInput,\n  parseJoinHostInput,\n} from \"./contracts\";\nimport { HOST_INVITE_TTL_MS } from \"./config\";\nimport { assertRegisteredTvDevice } from \"./auth\";\n\nexport interface HostJoinServiceOptions {\n  db: Firestore;\n  now?: () => Date;\n}\n\nfunction inviteTokenHash(token: string): string {\n  return createHash(\"sha256\").update(token).digest(\"hex\");\n}\n\nfunction inviteRef(db: Firestore, partyId: string, inviteId: string) {\n  return db.doc(`parties/${partyId}/hostInvites/${inviteId}`);\n}\n\n/**\n * Host invite + redemption service.\n *\n * Only a registered TV may mint a short-lived host invite. The token is\n * returned once and only its SHA-256 hash is stored, bound to\n * party/channel/expiry. Redemption is transactional for a separate phone\n * identity with the server-assigned host role: same-device redemption\n * retries are idempotent, while other-device replay, expiry, guest PIN\n * reuse, and client-only role changes can never grant host access. Legacy\n * joinParty remains guest-only (see join_party.ts: non-guest device docs\n * are rejected and the role is always written server-side).\n */\nexport function createHostJoinService(options: HostJoinServiceOptions): {\n  createHostInvite(value: unknown): Promise<CreateHostInviteResult>;\n  joinHost(value: unknown): Promise<JoinHostResult>;\n} {\n  const { db } = options;\n  const now = options.now ?? (() => new Date());\n\n  async function createHostInvite(value: unknown): Promise<CreateHostInviteResult> {\n    const input = parseCreateHostInviteInput(value);\n    const tv = await assertRegisteredTvDevice(db, input);\n    const token = `hi-${randomBytes(24).toString(\"hex\")}`;\n    const tokenHash = inviteTokenHash(token);\n    const inviteId = tokenHash.slice(0, 32);\n    const createdAt = now();\n    const expiresAt = new Date(createdAt.getTime() + HOST_INVITE_TTL_MS);\n    await inviteRef(db, tv.partyId, inviteId).create({\n      inviteId,\n      tokenHash,\n      partyId: tv.partyId,\n      channelId: tv.channelId,\n      status: \"pending\",\n      createdByDevice: tv.deviceId,\n      usedByDevice: null,\n      createdAt: FieldValue.serverTimestamp(),\n      expiresAt: Timestamp.fromDate(expiresAt),\n    });\n    return {\n      partyId: tv.partyId,\n      channelId: tv.channelId,\n      inviteToken: token,\n      expiresAt: expiresAt.toISOString(),\n    };\n  }\n\n  async function joinHost(value: unknown): Promise<JoinHostResult> {\n    const input = parseJoinHostInput(value);\n    const tokenHash = inviteTokenHash(input.inviteToken);\n    const inviteId = tokenHash.slice(0, 32);\n    return db.runTransaction(async (transaction) => {\n      const inviteSnap = await transaction.get(inviteRef(db, input.partyId, inviteId));\n      if (!inviteSnap.exists) {\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      const invite = inviteSnap.data()!;\n      if (\n        invite.tokenHash !== tokenHash ||\n        invite.partyId !== input.partyId ||\n        invite.channelId !== input.channelId\n      ) {\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      const expiresMs =\n        invite.expiresAt instanceof Timestamp\n          ? invite.expiresAt.toDate().getTime()\n          : Date.parse(String(invite.expiresAt));\n      if (!Number.isFinite(expiresMs) || expiresMs <= now().getTime()) {\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      // Cross-party / wrong-channel tokens never redeem: the invite doc lives\n      // under the party path and binds the channel explicitly.\n      const partyRef = db.doc(`parties/${input.partyId}`);\n      const channelRef = partyRef.collection(\"channels\").doc(input.channelId);\n      const deviceRef = partyRef.collection(\"devices\").doc(input.deviceId);\n      const [partySnap, channelSnap, deviceSnap] = await Promise.all([\n        transaction.get(partyRef),\n        transaction.get(channelRef),\n        transaction.get(deviceRef),\n      ]);\n      if (!partySnap.exists || partySnap.data()?.status !== \"active\") {\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      if (\n        !channelSnap.exists ||\n        channelSnap.data()?.partyId !== input.partyId ||\n        channelSnap.data()?.status !== \"active\" ||\n        partySnap.data()?.activeChannelId !== input.channelId\n      ) {\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      // Other-device replay: an invite redeemed by one phone cannot admit\n      // another phone, even with the same token.\n      if (\n        typeof invite.usedByDevice === \"string\" &&\n        invite.usedByDevice !== input.deviceId\n      ) {\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      if (deviceSnap.exists) {\n        const device = deviceSnap.data()!;\n        if (\n          device.partyId !== input.partyId ||\n          device.status !== \"active\" ||\n          (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n        ) {\n          throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n        }\n        // A guest-PIN registration (role guest) or any non-host doc can never\n        // be upgraded by re-presenting the invite for a different device, and\n        // a client-supplied role string is ignored: the role below is always\n        // written server-side.\n        if (device.role === \"host\") {\n          if (invite.status !== \"redeemed\" || invite.usedByDevice !== input.deviceId) {\n            transaction.update(inviteRef(db, input.partyId, inviteId), {\n              status: \"redeemed\",\n              usedByDevice: input.deviceId,\n              redeemedAt: FieldValue.serverTimestamp(),\n            });\n          }\n          return {\n            partyId: input.partyId,\n            deviceId: input.deviceId,\n            channelId: input.channelId,\n            role: \"host\" as const,\n            status: \"active\" as const,\n            created: false,\n          };\n        }\n        throw new BackendError(\"FORBIDDEN\", \"Host invite is invalid or expired.\");\n      }\n      transaction.set(deviceRef, {\n        partyId: input.partyId,\n        deviceId: input.deviceId,\n        role: \"host\",\n        status: \"active\",\n        registeredAt: FieldValue.serverTimestamp(),\n      });\n      transaction.update(inviteRef(db, input.partyId, inviteId), {\n        status: \"redeemed\",\n        usedByDevice: input.deviceId,\n        redeemedAt: FieldValue.serverTimestamp(),\n      });\n      return {\n        partyId: input.partyId,\n        deviceId: input.deviceId,\n        channelId: input.channelId,\n        role: \"host\" as const,\n        status: \"active\" as const,\n        created: true,\n      };\n    });\n  }\n\n  return { createHostInvite, joinHost };\n}\n\n/** Test/ops helper: hash an invite token to locate its stored invite doc. */\nexport function hashHostInviteToken(token: string): string {\n  return inviteTokenHash(token);\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/host_join.ts"},"output":"Created file successfully: backend/functions/src/host_join.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: backend/functions/src/host_join.ts"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929be203711cb347dfb4bb7b849c"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import { createHash, randomBytes } from \\\"node:crypto\\\";\\nimport { FieldValue, Firestore, Timestamp } from \\\"firebase-admin/firestore\\\";\\nimport {\\n  BackendError,\\n  CreateHostInviteResult,\\n  JoinHostResult,\\n  parseCreateHostInviteInput,\\n  parseJoinHostInput,\\n} from \\\"./contracts\\\";\\nimport { HOST_INVITE_TTL_MS } from \\\"./config\\\";\\nimport { assertRegisteredTvDevice } from \\\"./auth\\\";\\n\\nexport interface HostJoinServiceOptions {\\n  db: Firestore;\\n  now?: () => Date;\\n}\\n\\nfunction inviteTokenHash(token: string): string {\\n  return createHash(\\\"sha256\\\").update(token).digest(\\\"hex\\\");\\n}\\n\\nfunction inviteRef(db: Firestore, partyId: string, inviteId: string) {\\n  return db.doc(`parties/${partyId}/hostInvites/${inviteId}`);\\n}\\n\\n/**\\n * Host invite + redemption service.\\n *\\n * Only a registered TV may mint a short-lived host invite. The token is\\n * returned once and only its SHA-256 hash is stored, bound to\\n * party/channel/expiry. Redemption is transactional for a separate phone\\n * identity with the server-assigned host role: same-device redemption\\n * retries are idempotent, while other-device replay, expiry, guest PIN\\n * reuse, and client-only role changes can never grant host access. Legacy\\n * joinParty remains guest-only (see join_party.ts: non-guest device docs\\n * are rejected and the role is always written server-side).\\n */\\nexport function createHostJoinService(options: HostJoinServiceOptions): {\\n  createHostInvite(value: unknown): Promise<CreateHostInviteResult>;\\n  joinHost(value: unknown): Promise<JoinHostResult>;\\n} {\\n  const { db } = options;\\n  const now = options.now ?? (() => new Date());\\n\\n  async function createHostInvite(value: unknown): Promise<CreateHostInviteResult> {\\n    const input = parseCreateHostInviteInput(value);\\n    const tv = await assertRegisteredTvDevice(db, input);\\n    const token = `hi-${randomBytes(24).toString(\\\"hex\\\")}`;\\n    const tokenHash = inviteTokenHash(token);\\n    const inviteId = tokenHash.slice(0, 32);\\n    const createdAt = now();\\n    const expiresAt = new Date(createdAt.getTime() + HOST_INVITE_TTL_MS);\\n    await inviteRef(db, tv.partyId, inviteId).create({\\n      inviteId,\\n      tokenHash,\\n      partyId: tv.partyId,\\n      channelId: tv.channelId,\\n      status: \\\"pending\\\",\\n      createdByDevice: tv.deviceId,\\n      usedByDevice: null,\\n      createdAt: FieldValue.serverTimestamp(),\\n      expiresAt: Timestamp.fromDate(expiresAt),\\n    });\\n    return {\\n      partyId: tv.partyId,\\n      channelId: tv.channelId,\\n      inviteToken: token,\\n      expiresAt: expiresAt.toISOString(),\\n    };\\n  }\\n\\n  async function joinHost(value: unknown): Promise<JoinHostResult> {\\n    const input = parseJoinHostInput(value);\\n    const tokenHash = inviteTokenHash(input.inviteToken);\\n    const inviteId = tokenHash.slice(0, 32);\\n    return db.runTransaction(async (transaction) => {\\n      const inviteSnap = await transaction.get(inviteRef(db, input.partyId, inviteId));\\n      if (!inviteSnap.exists) {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      const invite = inviteSnap.data()!;\\n      if (\\n        invite.tokenHash !== tokenHash ||\\n        invite.partyId !== input.partyId ||\\n        invite.channelId !== input.channelId\\n      ) {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      const expiresMs =\\n        invite.expiresAt instanceof Timestamp\\n          ? invite.expiresAt.toDate().getTime()\\n          : Date.parse(String(invite.expiresAt));\\n      if (!Number.isFinite(expiresMs) || expiresMs <= now().getTime()) {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      // Cross-party / wrong-channel tokens never redeem: the invite doc lives\\n      // under the party path and binds the channel explicitly.\\n      const partyRef = db.doc(`parties/${input.partyId}`);\\n      const channelRef = partyRef.collection(\\\"channels\\\").doc(input.channelId);\\n      const deviceRef = partyRef.collection(\\\"devices\\\").doc(input.deviceId);\\n      const [partySnap, channelSnap, deviceSnap] = await Promise.all([\\n        transaction.get(partyRef),\\n        transaction.get(channelRef),\\n        transaction.get(deviceRef),\\n      ]);\\n      if (!partySnap.exists || partySnap.data()?.status !== \\\"active\\\") {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      if (\\n        !channelSnap.exists ||\\n        channelSnap.data()?.partyId !== input.partyId ||\\n        channelSnap.data()?.status !== \\\"active\\\" ||\\n        partySnap.data()?.activeChannelId !== input.channelId\\n      ) {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      // Other-device replay: an invite redeemed by one phone cannot admit\\n      // another phone, even with the same token.\\n      if (\\n        typeof invite.usedByDevice === \\\"string\\\" &&\\n        invite.usedByDevice !== input.deviceId\\n      ) {\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      if (deviceSnap.exists) {\\n        const device = deviceSnap.data()!;\\n        if (\\n          device.partyId !== input.partyId ||\\n          device.status !== \\\"active\\\" ||\\n          (typeof device.deviceId === \\\"string\\\" && device.deviceId !== input.deviceId)\\n        ) {\\n          throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n        }\\n        // A guest-PIN registration (role guest) or any non-host doc can never\\n        // be upgraded by re-presenting the invite for a different device, and\\n        // a client-supplied role string is ignored: the role below is always\\n        // written server-side.\\n        if (device.role === \\\"host\\\") {\\n          if (invite.status !== \\\"redeemed\\\" || invite.usedByDevice !== input.deviceId) {\\n            transaction.update(inviteRef(db, input.partyId, inviteId), {\\n              status: \\\"redeemed\\\",\\n              usedByDevice: input.deviceId,\\n              redeemedAt: FieldValue.serverTimestamp(),\\n            });\\n          }\\n          return {\\n            partyId: input.partyId,\\n            deviceId: input.deviceId,\\n            channelId: input.channelId,\\n            role: \\\"host\\\" as const,\\n            status: \\\"active\\\" as const,\\n            created: false,\\n          };\\n        }\\n        throw new BackendError(\\\"FORBIDDEN\\\", \\\"Host invite is invalid or expired.\\\");\\n      }\\n      transaction.set(deviceRef, {\\n        partyId: input.partyId,\\n        deviceId: input.deviceId,\\n        role: \\\"host\\\",\\n        status: \\\"active\\\",\\n        registeredAt: FieldValue.serverTimestamp(),\\n      });\\n      transaction.update(inviteRef(db, input.partyId, inviteId), {\\n        status: \\\"redeemed\\\",\\n        usedByDevice: input.deviceId,\\n        redeemedAt: FieldValue.serverTimestamp(),\\n      });\\n      return {\\n        partyId: input.partyId,\\n        deviceId: input.deviceId,\\n        channelId: input.channelId,\\n        role: \\\"host\\\" as const,\\n        status: \\\"active\\\" as const,\\n        created: true,\\n      };\\n    });\\n  }\\n\\n  return { createHostInvite, joinHost };\\n}\\n\\n/** Test/ops helper: hash an invite token to locate its stored invite doc. */\\nexport function hashHostInviteToken(token: string): string {\\n  return inviteTokenHash(token);\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/host_join.ts\"}"},"time":{"start":1793461053408,"end":1793461053929}}}}
