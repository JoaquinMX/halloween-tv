row StateError('Could not save submission receipt');\n187:       }\n188:     }\n189:   }\n190: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/session/guest_media_session.dart, lines 1-190\n1: import 'dart:io';\n2: \n3: import 'package:path_provider/path_provider.dart';\n4: import 'package:shared_preferences/shared_preferences.dart';\n5: \n6: import 'package:companion_app/src/data/guest_media_client.dart';\n7: \n8: /// Consent-gated upload workflow. No capability call exists before submit().\n9: ///\n10: /// Each submit mints a new server-side submission with its own persisted\n11: /// receipt, so outstanding submissions each keep their withdrawal path:\n12: /// withdrawing one submission never strands the others. Receipts are scoped\n13: /// per device via SharedPreferences ([receiptsKey]); the legacy single-slot\n14: /// [receiptKey] is kept in sync with the latest id for backward\n15: /// compatibility with installs that predate multi-receipt support.\n16: final class GuestMediaSession {\n17:   GuestMediaSession({\n18:     required this.client,\n19:     required this.partyId,\n20:     required this.deviceId,\n21:     required this.channelId,\n22:     Future<SharedPreferences> Function()? preferences,\n23:     Future<Directory> Function()? tempDirectory,\n24:   }) : _preferences = preferences ?? SharedPreferences.getInstance,\n25:        _tempDirectory = tempDirectory ?? getTemporaryDirectory;\n26:   final GuestMediaClient client;\n27:   final String partyId, deviceId, channelId;\n28:   final Future<SharedPreferences> Function() _preferences;\n29:   final Future<Directory> Function() _tempDirectory;\n30:   static const receiptKey = 'companion.guest_media_receipt.v1';\n31:   static const receiptsKey = 'companion.guest_media_receipts.v1';\n32: \n33:   /// Outstanding (not yet withdrawn/expired) submission ids, oldest first.\n34:   final List<String> submissionIds = <String>[];\n35: \n36:   /// Last known status per submission id (backend GuestMediaStatus values:\n37:   /// pending_upload | eligible | withdrawn | expired).\n38:   final Map<String, String> statuses = <String, String>{};\n39: \n40:   /// Latest outstanding submission, or null when none is outstanding.\n41:   String? get submissionId =>\n42:       submissionIds.isEmpty ? null : submissionIds.last;\n43: \n44:   /// Last known status of the latest outstanding submission.\n45:   String? get status =>\n46:       submissionId == null ? _terminalStatus : statuses[submissionId];\n47: \n48:   String? _terminalStatus;\n49:   bool busy = false;\n50: \n51:   Future<void> submit(\n52:     File photo, {\n53:     required bool consent,\n54:     required bool confirmed,\n55:     String contentType = 'image/jpeg',\n56:   }) async {\n57:     if (!consent || !confirmed) {\n58:       throw StateError(\n59:         'Affirmative consent and upload confirmation are required',\n60:       );\n61:     }\n62:     if (busy) return;\n63:     busy = true;\n64:     File? staged;\n65:     try {\n66:       final String extension =\n67:           contentType == 'image/png' ? '.png' : '.jpg';\n68:       final directory = await _tempDirectory();\n69:       staged = File(\n70:         '${directory.path}/guest-upload-${DateTime.now().microsecondsSinceEpoch}$extension',\n71:       );\n72:       await photo.copy(staged.path);\n73:       final capability = await client.requestUpload(\n74:         partyId: partyId,\n75:         deviceId: deviceId,\n76:         channelId: channelId,\n77:         contentType: contentType,\n78:         byteSize: await staged.length(),\n79:         affirmativeConsent: consent,\n80:       );\n81:       submissionIds.add(capability.submissionId);\n82:       await _persistReceipts();\n83:       await client.upload(capability, staged);\n84:       await client.complete(\n85:         partyId: partyId,\n86:         deviceId: deviceId,\n87:         channelId: channelId,\n88:         submissionId: capability.submissionId,\n89:       );\n90:       statuses[capability.submissionId] = 'complete';\n91:       _terminalStatus = null;\n92:     } catch (_) {\n93:       if (submissionId != null) {\n94:         statuses.putIfAbsent(submissionId!, () => 'recovery-required');\n95:       } else {\n96:         _terminalStatus ??= 'recovery-required';\n97:       }\n98:       rethrow;\n99:     } finally {\n100:       if (staged != null && await staged.exists()) await staged.delete();\n101:       busy = false;\n102:     }\n103:   }\n104: \n105:   Future<void> recover() async {\n106:     final prefs = await _preferences();\n107:     final List<String> stored =\n108:         prefs.getStringList(receiptsKey) ?? _legacyReceipt(prefs);\n109:     submissionIds\n110:       ..clear()\n111:       ..addAll(stored);\n112:     _terminalStatus = null;\n113:     for (final String id in List<String>.of(submissionIds)) {\n114:       final result = await client.status(\n115:         partyId: partyId,\n116:         deviceId: deviceId,\n117:         channelId: channelId,\n118:         submissionId: id,\n119:       );\n120:       final String known = result['status'] is String\n121:           ? result['status'] as String\n122:           : 'unknown';\n123:       if (known == 'withdrawn' || known == 'expired') {\n124:         submissionIds.remove(id);\n125:         statuses.remove(id);\n126:         _terminalStatus = known;\n127:       } else {\n128:         statuses[id] = known;\n129:       }\n130:     }\n131:     await _persistReceipts();\n132:   }\n133: \n134:   /// Withdraws [submissionId] (defaults to the latest outstanding one) and,\n135:   /// on the backend terminal status `withdrawn`, drops its receipt so it is\n136:   /// never retried. Other outstanding submissions are untouched.\n137:   Future<void> withdraw({String? submissionId}) async {\n138:     final id = submissionId ?? this.submissionId;\n139:     if (id == null || busy) return;\n140:     b