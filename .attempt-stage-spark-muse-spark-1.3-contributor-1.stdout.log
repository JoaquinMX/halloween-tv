turn `parties/${partyId}/guests/${deviceId}/ingest/${submissionId}/photo.jpg`;\n45: }\n46: \n47: export function parseGuestObjectPath(objectPath: string): { partyId: string; deviceId: string; submissionId: string } | undefined {\n48:   const match = OBJECT_RE.exec(objectPath);\n49:   if (!match) return undefined;\n50:   return { partyId: match[1], deviceId: match[2], submissionId: match[3] };\n51: }\n52: \n53: export function guestMediaRef(db: Firestore, partyId: string, submissionId: string) {\n54:   return db.doc(`parties/${partyId}/${GUEST_MEDIA_COLLECTION}/${submissionId}`);\n55: }\n56: \n57: export function consentRevisionFor(acceptedAtIso: string): string {\n58:   return `${GUEST_CONSENT_TEXT_VERSION}:${acceptedAtIso}`;\n59: }\n60: \n61: function expiryMs(value: unknown): number | undefined {\n62:   if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n63:     return (value as { toDate: () => Date }).toDate().getTime();\n64:   }\n65:   if (value instanceof Date) return value.getTime();\n66:   if (typeof value === \"string\") {\n67:     const parsed = Date.parse(value);\n68:     return Number.isFinite(parsed) ? parsed : undefined;\n69:   }\n70:   return undefined;\n71: }\n72: \n73: /**\n74:  * Consent-bound eligibility gate shared by request, worker-submission, and\n75:  * transactional publication paths. Throws FORBIDDEN when consent was\n76:  * withdrawn or the binding does not match the caller, CLIP_EXPIRED when the\n77:  * input window lapsed, NOT_FOUND for unknown submissions.\n78:  */\n79: export async function assertGuestEligible(\n80:   db: Firestore,\n81:   identity: Identity,\n82:   submissionId: string,\n83:   nowMs: number,\n84: ): Promise<GuestMediaDoc> {\n85:   const snapshot = await guestMediaRef(db, identity.partyId, submissionId).get();\n86:   if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Guest media does not exist.\");\n87:   const doc = snapshot.data() as GuestMediaDoc;\n88:   if (\n89:     doc.partyId !== identity.partyId ||\n90:     doc.deviceId !== identity.deviceId ||\n91:     doc.channelId !== identity.channelId ||\n92:     doc.submissionId !== submissionId\n93:   ) {\n94:     throw new BackendError(\"FORBIDDEN\", \"Guest media is not bound to this party, device, and channel.\");\n95:   }\n96:   if (doc.status === \"withdrawn\") throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn.\");\n97:   if (doc.status === \"expired\") throw new BackendError(\"CLIP_EXPIRED\", \"Guest media has expired.\");\n98:   if (doc.status !== \"eligible\") throw new BackendError(\"FORBIDDEN\", \"Guest media is not eligible for generation.\");\n99:   if (!doc.consent || doc.consent.accepted !== true ||\n100:       doc.consent.textVersion !== GUEST_CONSENT_TEXT_VERSION ||\n101:       doc.consent.purpose !== GUEST_CONSENT_PURPOSE ||\n102:       doc.consent.deviceId !== identity.deviceId) {\n103:     throw new BackendError(\"FORBIDDEN\", \"Guest consent is not recorded for this device.\");\n104:   }\n105:   const expiry = expiryMs(doc.expiresAt);\n106:   if (expiry === undefined || expiry <= nowMs) throw new BackendError(\"CLIP_EXPIRED\", \"Guest media has expired.\");\n107:   if (typeof doc.sourceHash !== \"string\" || !/^[a-f0-9]{64}$/.test(doc.sourceHash) ||\n108:       !Number.isSafeInteger(doc.sourceSizeBytes) || Number(doc.sourceSizeBytes) <= 0) {\n109:     throw new BackendError(\"FORBIDDEN\", \"Guest media source is not verified.\");\n110:   }\n111:   return doc;\n112: }\n113: \n114: /** Reads the guest doc for job binding without requiring eligibility (worker cleanup paths). */\n115: export async function readGuestMediaDoc(\n116:   db: Firestore,\n117:   partyId: string,\n118:   submissionId: string,\n119: ): Promise<GuestMediaDoc | undefined> {\n120:   const snapshot = await guestMediaRef(db, partyId, submissionId).get();\n121:   if (!snapshot.exists) return undefined;\n122:   return snapshot.data() as Gue