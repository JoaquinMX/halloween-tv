36:   notFound,\n37: \n38:   /// The request was rejected (`INVALID_ARGUMENT`).\n39:   invalidArgument,\n40: \n41:   /// The published lineup expired (`CLIP_EXPIRED`). Never labeled current.\n42:   expired,\n43: \n44:   /// Transient backend failure (`PROVIDER_UNAVAILABLE`, `BUDGET_EXCEEDED`).\n45:   unavailable,\n46: \n47:   /// Network/transport failure.\n48:   transport,\n49: \n50:   /// The callable exceeded its bounded timeout.\n51:   timeout,\n52: \n53:   /// Valid JSON that failed schema, scope, or camera validation.\n54:   malformed,\n55: }\n56: \n57: /// Sanitized application state for a manifest read failure.\n58: final class ManifestFailure {\n59:   const ManifestFailure._(this.kind, this.message, this.retryable);\n60: \n61:   /// Classifies [error] into a sanitized state.\n62:   ///\n63:   /// Unwraps [ManifestTransportException] cause chains, maps\n64:   /// [FirebaseFunctionsException] `code` (preferring a `details`\n65:   /// `errorCode` contract code when present), and maps schema/scope,\n66:   /// timeout, and format errors. Unknown errors become\n67:   /// [ManifestFailureKind.transport].\n68:   factory ManifestFailure.classify(Object error) {\n69:     Object current = error;\n70:     final List<Object> seen = <Object>[];\n71:     while (current is ManifestTransportException &&\n72:         current.cause != null &&\n73:         !seen.contains(current)) {\n74:       seen.add(current);\n75:       current = current.cause!;\n76:     }\n77:     if (current is ManifestFailure) {\n78:       return current;\n79:     }\n80:     if (current is FirebaseFunctionsException) {\n81:       return _fromCodes(current.code, _detailsErrorCode(current.details));\n82:     }\n83:     if (current is Map) {\n84:       final String? code = _detailsErrorCode(current);\n85:       if (code != null) {\n86:         return _fromCodes('', code);\n87:       }\n88:     }\n89:     if (current is ManifestSchemaException ||\n90:         current is ManifestScopeException) {\n91:       return const ManifestFailure._(\n92:         ManifestFailureKind.malformed,\n93:         'The manifest data was invalid.',\n94:         false,\n95:       );\n96:     }\n97:     if (current is TimeoutException) {\n98:       return const ManifestFailure._(\n99:         ManifestFailureKind.timeout,\n100:         'The request timed out.',\n101:         true,\n102:       );\n103:     }\n104:     if (current is FormatException) {\n105:       return const ManifestFailure._(\n106:         ManifestFailureKind.malformed,\n107:         'The manifest data was invalid.',\n108:         false,\n109:       );\n110:     }\n111:     if (current is ArgumentError) {\n112:       return const ManifestFailure._(\n113:         ManifestFailureKind.configuration,\n114:         'The backend is not configured.',\n115:         false,\n116:       );\n117:     }\n118:     return const ManifestFailure._(\n119:       ManifestFailureKind.transport,\n120:       'Could not reach the backend.',\n121:       true,\n122:     );\n123:   }\n124: \n125:   /// Recoverable configuration state (unconfigured or init failure).\n126:   factory ManifestFailure.configuration([String? reason]) => ManifestFailure._(\n127:     ManifestFailureKind.configuration,\n128:     reason == null || reason.isEmpty\n129:         ? 'The backend is not configured.'\n130:         : 'The backend is not configured: $reason',\n131:     false,\n132:   );\n133: \n134:   final ManifestFailureKind kind;\n135:   final String message;\n136:   final bool retryable;\n137: \n138:   @override\n139:   String toString() => 'ManifestFailure($kind)';\n140: \n141:   static ManifestFailure _fromCodes(String code, String? detailsCode) {\n142:     final String? contract = detailsCode?.toUpperCase();\n143:     switch (contract) {\n144:       case 'UNAUTHENTICATED':\n145:         return const ManifestFailure._(\n146:           ManifestFailureKind.unauthenticated,\n147:           'This device is not provisioned for this party.',\n148:           false,\n149:         );\n150:       case 'FORBIDDEN':\n151:         return const ManifestFailure._(\n152:           ManifestFailureKind.forbidden,\n153:           'Access was denied.',\n154:           false,\n155:         );\n156:       case 'NOT_FOUND':\n157:         return const ManifestFailure._(\n158:           ManifestFailureKind.notFound,\n159:           'No manifest is published yet.',\n160:           false,\n161:         );\n162:       case 'INVALID_ARGUMENT':\n163:         return const ManifestFailure._(\n164:           ManifestFailureKind.invalidArgument,\n165:           'The request was rejected.',\n166:           false,\n167:         );\n168:       case 'PROVIDER_UNAVAILABLE':\n169:       case 'BUDGET_EXCEEDED':\n170:         return const ManifestFailure._(\n171:           ManifestFailureKind.unavailable,\n172:           'The service is temporarily unavailable.',\n173:           true,\n174:         );\n175:       case 'MANIFEST_MISMATCH':\n176:         return const ManifestFailure._(\n177:           ManifestFailureKind.malformed,\n178:           'The manifest data was invalid.',\n179:           false,\n180:         );\n181:       case 'CLIP_EXPIRED':\n182:         return const ManifestFailure._(\n183:           ManifestFailureKind.expired,\n184:           'This lineup has expired.',\n185:           false,\n186:         );\n187:       case 'INTERNAL':\n188:         return const ManifestFailure._(\n189:           ManifestFailureKind.transport,\n190:           'Could not reach the backend.',\n191:           true,\n192:         );\n193:     }\n194:     switch (code.trim().toLowerCase().replaceAll('_', '-')) {\n195:       case 'unauthenticated':\n196:         return const ManifestFailure._(\n197:           ManifestFailureKind.unauthenticated,\n198:           'This device is not provisioned for this party.',\n199:           false,\n200:         );\n201:       case 'permission-denied':\n202:         return const ManifestFailure._(\n203:           ManifestFailureKind.forbidd