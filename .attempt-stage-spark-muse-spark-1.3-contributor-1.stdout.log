AMERA_COUNTS = [1, 2, 4] as const;\n26: export type SupportedCameraCount = (typeof SUPPORTED_CAMERA_COUNTS)[number];\n27: \n28: /** First-N canonical camera ids for a supported count, in wall order. */\n29: export function expectedCameraIds(count: number): readonly string[] {\n30:   if (!(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(count)) {\n31:     throw new Error(`Unsupported camera count ${count}; expected one of ${SUPPORTED_CAMERA_COUNTS.join(\", \")}.`);\n32:   }\n33:   return REQUIRED_CAMERA_IDS.slice(0, count);\n34: }\n35: \n36: /** Short-lived host-invite capability lifetime (TV-minted, phone-redeemed). */\n37: export const HOST_INVITE_TTL_MS = 5 * 60 * 1000;\n38: /** TTL for separately referenced host preview objects (seed catalog). */\n39: export const HOST_PREVIEW_TTL_MS = 24 * 60 * 60 * 1000;\n40: \n41: /** Preview object path: separately referenced from delivery objects so an ACK purge never removes previews. */\n42: export function hostPreviewObjectPath(partyId: string, seedId: string, cameraId: string): string {\n43:   return `parties/${partyId}/hostPreviews/${seedId}/${cameraId}.mp4`;\n44: }\n45: \n46: /** Generation is inert unless an operator explicitly opts in. */\n47: export function isGenerationEnabled(environment: NodeJS.ProcessEnv = process.env): boolean {\n48:   return environment.GENERATION_ENABLED === \"true\";\n49: }\n50: \n51: export const CHEAP_DEMO_PRESET = Object.freeze({\n52:   presetId: \"cheap_demo\" as const,\n53:   modelId: \"wan3.0-video\" as const,\n54:   region: \"singapore\" as const,\n55:   resolution: \"480P\" as const,\n56:   secondsOut: 2 as const,\n57:   aspectRatio: \"16:9\" as const,\n58:   audio: false as const,\n59:   outputs: 1 as const,\n60:   autoUpscale: false as const,\n61: });\n62: \n63: /**\n64:  * Owner-approved STEP 2 cameo batch preset (single approved batch only).\n65:  *\n66:  * Separate from cheap_demo, which is never altered: 5 seconds, 480p, silent,\n67:  * 1 output, exactly ONE provider-generated camera slot (CAM-01) plus three\n68:  * local fixture slots, reference-image input via the validated guest binding.\n69:  * Text-only requests are rejected for this preset; it exists solely for the\n70:  * consented-reference batch.\n71:  *\n72:  * Model choice: happyhorse-1.1-r2v (reference-image-to-video). The checked-in\n73:  * adapter performs no per-model capability validation and the repo carries no\n74:  * offline documentation establishing that wan3.0-video accepts a\n75:  * reference_image input at a 5-second duration, so mapping the 5s\n76:  * reference-bound batch to the r2v (reference-to-video) model is the\n77:  * technically safer call. Verified offline via serialization fixtures only;\n78:  * no provider network call was made.\n79:  *\n80:  * Billing caveat (surfaced, never estimated): reference inputs can bill\n81:  * input duration — the adapter surfaces the provider's realized\n82:  * usage.input_video_duration as secondsIn, and Token Plan Credits may differ\n83:  * from list prices. Only realized console Credits are billable truth.\n84:  */\n85: export const CAMEO_DEMO_PRESET = Object.freeze({\n86:   presetId: \"cameo_demo\" as const,\n87:   modelId: \"happyhorse-1.1-r2v\" as const,\n88:   region: \"singapore\" as const,\n89:   resolution: \"480P\" as const,\n90:   secondsOut: 5 as const,\n91:   aspectRatio: \"16:9\" as const,\n92:   audio: false as const,\n93:   outputs: 1 as const,\n94:   autoUpscale: false as const,\n95: });\n96: \n97: /**\n98:  * Fixed server-side prompt for the STEP 2 cameo batch. Baked in exactly as\n99:  * owner-approved; never caller-supplied, never logged.\n100:  */\n101: export const CAMEO_DEMO_PROMPT =\n102:   \"Create a 5-second, fully 2D animated clip in the style of classic Scooby-Doo. \" +\n103:   \"Use the person in V2 as the character reference, preserving his glasses, hair, beard, and outfit, all fully drawn. \" +\n104:   \"In a spooky mansion hallway with crooked portraits, cobwebs, and flickering lamps, the terrified person runs left to right \" +\n105:   \"while a goofy, lumbering green monster chases close behind. \" +\n106:   \"Use one continuous side-tracking shot, keeping both characters visible. \" +\n107:   \"0-2 seconds: The person sprints with exaggerated cartoon strides while the monster reaches toward him. \" +\n108:   \"2-4 seconds: He glances backward, eyes widening, then accelerates with comically spinning legs. \" +\n109:   \"4-5 seconds: Both race through an open doorway and disappear offscreen. \" +\n110:   \"Bold ink outlines, flat cel shading, hand-painted purple-and-teal backgrounds, expressive faces, \" +\n111:   \"elastic cartoon movement, and playful spooky slapstick. \" +\n112:   \"No photorealism, 3D rendering, gore, text, or changes to the person's identity.\";\n113: \n114: /** Guest upload/consent controls. Server-side only; never trust caller-supplied paths. */\n115: export const GUEST_CONSENT_TEXT_VERSION = \"v1\";\n116: export const GUEST_CONSENT_PURPOSE = \"guest_cameo\";\n117: /** Short-lived upload capability lifetime (signed PUT bound to object + content type). */\n118: export const GUEST_UPLOAD_TTL_MS = 15 * 60 * 1000;\n119: /** Abandoned/expired guest inputs are removed within a capped 24h deadline. */\n120: export const GUEST_INPUT_TTL_MS = 24 * 60 * 60 * 1000;\n121: export const GUEST_MAX_IMAGE_BYTES = 10 * 1024 * 1024;\n122: export const GUEST_ALLOWED_CONTENT_TYPES = [\"image/jpeg\", \"image/png\"] as const;\n123: export type GuestAllowedContentType = (typeof GUEST_ALLOWED_CONTENT_TYPES)[number];\n124: /** Exactly one provider-generated camera in a guest-bound job; the rest are local fixtures. */\n125: export const GUEST_PROVIDER_CAMERA_ID = \"CAM-01\" as const;\n126: \n127: export const ERROR_CODES = [\n128:   \"UNAUTHENTICATED\",\n129:   \"FORBIDDEN\",\n130:   \"MANIFEST_MISMATCH\",\n131:   \"CLIP_EXPIRED\",\n132:   \"PROVIDER_UNAVAILABLE\",\n133:   \"BUDGET_EXCEEDED\",\n134:   \"INVALID_ARGUMENT\",\n135:   \"NOT_FOUND\",\n1