icalClips, parseCreateHostInviteInput, parseJoinHostInput, parseDeleteHostVideoInput, parseRevokeHostDeviceInput } from \"../src/contracts\";\n import { buildCheapDemoRequest, validateCheapDemoControls, validateGuestImageReference } from \"../src/video_generation_port\";\n import { createVideoGenerationProviderFromEnvironment, FakeVideoGenerationPort } from \"../src/providers/fake\";\n import { AlibabaVideoGenerationPort } from \"../src/providers/alibaba\";\n import { createDeliveryServices } from \"../src/delivery\";\n","status":"modified","additions":1,"deletions":1}],"truncated":false},"content":[{"type":"text","text":"Edited backend/functions/test/contracts.test.ts (1 replacement)"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c78343711fbb2d8d555a9ffd74"}},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"import { BackendError, HOST_MAX_DEVICES, HOST_SOURCE_CONSENT_PURPOSE, HOST_SOURCE_CONSENT_TEXT_VERSION, isHostSourceConsent, isSupportedConsent, parseAck, parseJoinPartyInput, parseRequestGeneration, requireIdentity, validateCanonicalClips, parseCreateHostInviteInput, parseJoinHostInput, parseDeleteHostVideoInput, parseRevokeHostDeviceInput } from \\\"../src/contracts\\\";\",\"oldString\":\"import { BackendError, parseAck, parseJoinPartyInput, parseRequestGeneration, requireIdentity, validateCanonicalClips, parseCreateHostInviteInput, parseJoinHostInput, parseDeleteHostVideoInput } from \\\"../src/contracts\\\";\",\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/contracts.test.ts\"}"},"time":{"start":1793463911531,"end":1793463912316}}}}
