{"type":"tool_use","timestamp":1793462155324,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192ac8566001HuU5MyIaCARAZB","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192ac7d7f001WR8diBJ4pK08UT","type":"tool","id":"call_01a192ac80db7324a6d5590f0aea8eac","tool":"write","state":{"status":"completed","input":{"content":"import 'dart:async';\n\nimport 'package:companion_app/src/data/host_media_client.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:infra_firestore/infra_firestore.dart'\n    show ManifestTransportException;\n\n/// Backend-faithful fake: envelopes mirror\n/// backend/functions/src/contracts.ts (list/generate/preview/delete) and the\n/// host_media.ts service paths (scope echo, per-seed deletion, signed\n/// preview URLs that are never persisted).\nclass FakeHostMediaInvoker implements HostMediaCallableInvoker {\n  final List<String> names = <String>[];\n  final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];\n  final List<HostSeedVideo> seeds = <HostSeedVideo>[];\n  Object? failure;\n  int generates = 0;\n\n  Map<String, Object?> seedJson(HostSeedVideo seed) => <String, Object?>{\n    'seedId': seed.seedId,\n    'partyId': seed.partyId,\n    'channelId': seed.channelId,\n    'status': seed.status,\n    'jobId': seed.jobId,\n    'createdAt': seed.createdAt,\n    'expiresAt': seed.expiresAt,\n    'previewAvailable': seed.previewAvailable,\n    'cameraIds': seed.cameraIds,\n  };\n\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\n    names.add(name);\n    payloads.add(Map<String, Object?>.of(payload));\n    final Object? error = failure;\n    if (error != null) throw error;\n    switch (name) {\n      case kListHostVideos:\n        return <String, Object?>{\n          'videos': <Object?>[for (final s in seeds) seedJson(s)],\n        };\n      case kGenerateHostVideo:\n        generates++;\n        return <String, Object?>{\n          'seedId': payload['seedId'],\n          'jobId': 'hv-${payload['seedId']}',\n          'state': 'queued',\n          'created': generates == 1,\n        };\n      case kGetHostVideoPreview:\n        final String seedId = payload['seedId'] as String;\n        return <String, Object?>{\n          'seedId': seedId,\n          'expiresAt': '2030-01-01T00:00:00.000Z',\n          'clips': <Object?>[\n            for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\n              <String, Object?>{\n                'cameraId': camera,\n                'sha256': List.filled(64, 'a').join(),\n                'url': 'https://preview.example/$seedId/$camera.mp4',\n                'expiresAt': '2030-01-01T00:00:00.000Z',\n              },\n          ],\n        };\n      case kDeleteHostVideo:\n        final List<String> ids = <String>[\n          for (final Object? id in payload['seedIds'] as List) id.toString(),\n        ];\n        seeds.removeWhere((s) => ids.contains(s.seedId));\n        return <String, Object?>{\n          'deletedSeedIds': ids,\n          'deletedObjects': <String>[\n            for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\n          ],\n          'revokedManifest': true,\n        };\n    }\n    throw StateError('unexpected callable $name');\n  }\n}\n\nHostSeedVideo seed(String id, String status) => HostSeedVideo(\n  seedId: id,\n  partyId: 'party-1',\n  deviceIdlessParty: 'party-1',\n  channelId: 'cctv',\n  status: status,\n  jobId: 'hv-$id',\n  createdAt: '2026-10-29T14:00:00.000Z',\n  expiresAt: '2030-01-01T00:00:00.000Z',\n  previewAvailable: status == 'ready',\n  cameraIds: const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n);\n\nvoid main() {\n  test('list returns scoped seed entries across lifecycle states', () async {\n    final invoker = FakeHostMediaInvoker()\n      ..seeds.addAll(<HostSeedVideo>[\n        seed('a', 'queued'),\n        seed('b', 'running'),\n        seed('c', 'ready'),\n        seed('d', 'failed'),\n        seed('e', 'deleted'),\n      ]);\n    final videos = await HostMediaClient(invoker: invoker).listVideos(\n      partyId: 'party-1',\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n      channelId: 'cctv',\n    );\n    expect(invoker.names, <String>[kListHostVideos]);\n    expect(\n      invoker.payloads.single,\n      containsPair('channelId', 'cctv'),\n    );\n    expect(videos.map((v) => '${v.seedId}:${v.status}'), <String>[\n      'a:queued',\n      'b:running',\n      'c:ready',\n      'd:failed',\n      'e:deleted',\n    ]);\n    expect(videos[2].previewAvailable, isTrue);\n  });\n\n  test('generate enqueues the fixed preset and rejects other presets', () async {\n    final invoker = FakeHostMediaInvoker();\n    final client = HostMediaClient(invoker: invoker);\n    final result = await client.generateVideo(\n      partyId: 'party-1',\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n      channelId: 'cctv',\n      seedId: 'catalog-1',\n      idempotencyKey: 'idem-1',\n    );\n    expect(result['seedId'], 'catalog-1');\n    expect(result['jobId'], 'hv-catalog-1');\n    expect(invoker.payloads.single['presetId'], kCheapDemoPresetId);\n    await expectLater(\n      client.generateVideo(\n        partyId: 'party-1',\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n        channelId: 'cctv',\n        seedId: 'catalog-2',\n        idempotencyKey: 'idem-2',\n        presetId: 'ultra_cinema',\n      ),\n      throwsArgumentError,\n    );\n    expect(invoker.generates, 1);\n  });\n\n  test('preview returns fresh signed clips with https URLs', () async {\n    final invoker = FakeHostMediaInvoker();\n    final preview = await HostMediaClient(invoker: invoker).getPreview(\n      partyId: 'party-1',\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n      channelId: 'cctv',\n      seedId: 'catalog-1',\n    );\n    expect(preview.seedId, 'catalog-1');\n    expect(preview.clips, hasLength(4));\n    expect(\n      preview.clips.map((c) => c.cameraId),\n      <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n    );\n    for (final clip in preview.clips) {\n      expect(clip.url.scheme, 'https');\n    }\n  });\n\n  test('delete reconciles per selected seed id', () async {\n    final invoker = FakeHostMediaInvoker()\n      ..seeds.addAll(<HostSeedVideo>[seed('a', 'ready'), seed('b', 'ready')]);\n    final client = HostMediaClient(invoker: invoker);\n    final result = await client.deleteVideos(\n      partyId: 'party-1',\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n      channelId: 'cctv',\n      seedIds: const <String>['a'],\n    );\n    expect(result['deletedSeedIds'], <String>['a']);\n    expect(result['revokedManifest'], isTrue);\n    expect(\n      (await client.listVideos(\n        partyId: 'party-1',\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n        channelId: 'cctv',\n      )).map((v) => v.seedId),\n      <String>['b'],\n    );\n  });\n\n  test('rejects cross-party entries and malformed shapes', () async {\n    final invoker = FakeHostMediaInvoker();\n    final client = HostMediaClient(invoker: invoker);\n    invoker.seeds.add(\n      HostSeedVideo(\n        seedId: 'x',\n        partyId: 'other-party',\n        deviceIdlessParty: 'other-party',\n        channelId: 'cctv',\n        status: 'ready',\n        jobId: 'hv-x',\n        createdAt: '2026-10-29T14:00:00.000Z',\n        expiresAt: '2030-01-01T00:00:00.000Z',\n        previewAvailable: true,\n        cameraIds: const <String>['CAM-01'],\n      ),\n    );\n    await expectLater(\n      client.listVideos(\n        partyId: 'party-1',\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n        channelId: 'cctv',\n      ),\n      throwsFormatException,\n    );\n    invoker.seeds.clear();\n    invoker.failure = <String, Object?>{'unexpected': 'shape'};\n    await expectLater(\n      client.listVideos(\n        partyId: 'party-1',\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n        channelId: 'cctv',\n      ),\n      throwsFormatException,\n    );\n  });\n\n  test('bounds a callable that never completes', () async {\n    final client = HostMediaClient(\n      invoker: _PendingInvoker(),\n      timeout: const Duration(milliseconds: 5),\n    );\n    await expectLater(\n      client.listVideos(\n        partyId: 'party-1',\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n        channelId: 'cctv',\n      ),\n      throwsA(isA<ManifestTransportException>()),\n    );\n  });\n}\n\nfinal class _PendingInvoker implements HostMediaCallableInvoker {\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) =>\n      Completer<Object?>().future;\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/host_media_client_test.dart"},"output":"Created file successfully: apps/companion_app/test/host_media_client_test.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/companion_app/test/host_media_client_test.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192ac80db7324a6d5590f0aea8eac"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import 'dart:async';\\n\\nimport 'package:companion_app/src/data/host_media_client.dart';\\nimport 'package:flutter_test/flutter_test.dart';\\nimport 'package:infra_firestore/infra_firestore.dart'\\n    show ManifestTransportException;\\n\\n/// Backend-faithful fake: envelopes mirror\\n/// backend/functions/src/contracts.ts (list/generate/preview/delete) and the\\n/// host_media.ts service paths (scope echo, per-seed deletion, signed\\n/// preview URLs that are never persisted).\\nclass FakeHostMediaInvoker implements HostMediaCallableInvoker {\\n  final List<String> names = <String>[];\\n  final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];\\n  final List<HostSeedVideo> seeds = <HostSeedVideo>[];\\n  Object? failure;\\n  int generates = 0;\\n\\n  Map<String, Object?> seedJson(HostSeedVideo seed) => <String, Object?>{\\n    'seedId': seed.seedId,\\n    'partyId': seed.partyId,\\n    'channelId': seed.channelId,\\n    'status': seed.status,\\n    'jobId': seed.jobId,\\n    'createdAt': seed.createdAt,\\n    'expiresAt': seed.expiresAt,\\n    'previewAvailable': seed.previewAvailable,\\n    'cameraIds': seed.cameraIds,\\n  };\\n\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\\n    names.add(name);\\n    payloads.add(Map<String, Object?>.of(payload));\\n    final Object? error = failure;\\n    if (error != null) throw error;\\n    switch (name) {\\n      case kListHostVideos:\\n        return <String, Object?>{\\n          'videos': <Object?>[for (final s in seeds) seedJson(s)],\\n        };\\n      case kGenerateHostVideo:\\n        generates++;\\n        return <String, Object?>{\\n          'seedId': payload['seedId'],\\n          'jobId': 'hv-${payload['seedId']}',\\n          'state': 'queued',\\n          'created': generates == 1,\\n        };\\n      case kGetHostVideoPreview:\\n        final String seedId = payload['seedId'] as String;\\n        return <String, Object?>{\\n          'seedId': seedId,\\n          'expiresAt': '2030-01-01T00:00:00.000Z',\\n          'clips': <Object?>[\\n            for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\\n              <String, Object?>{\\n                'cameraId': camera,\\n                'sha256': List.filled(64, 'a').join(),\\n                'url': 'https://preview.example/$seedId/$camera.mp4',\\n                'expiresAt': '2030-01-01T00:00:00.000Z',\\n              },\\n          ],\\n        };\\n      case kDeleteHostVideo:\\n        final List<String> ids = <String>[\\n          for (final Object? id in payload['seedIds'] as List) id.toString(),\\n        ];\\n        seeds.removeWhere((s) => ids.contains(s.seedId));\\n        return <String, Object?>{\\n          'deletedSeedIds': ids,\\n          'deletedObjects': <String>[\\n            for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\\n          ],\\n          'revokedManifest': true,\\n        };\\n    }\\n    throw StateError('unexpected callable $name');\\n  }\\n}\\n\\nHostSeedVideo seed(String id, String status) => HostSeedVideo(\\n  seedId: id,\\n  partyId: 'party-1',\\n  deviceIdlessParty: 'party-1',\\n  channelId: 'cctv',\\n  status: status,\\n  jobId: 'hv-$id',\\n  createdAt: '2026-10-29T14:00:00.000Z',\\n  expiresAt: '2030-01-01T00:00:00.000Z',\\n  previewAvailable: status == 'ready',\\n  cameraIds: const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\\n);\\n\\nvoid main() {\\n  test('list returns scoped seed entries across lifecycle states', () async {\\n    final invoker = FakeHostMediaInvoker()\\n      ..seeds.addAll(<HostSeedVideo>[\\n        seed('a', 'queued'),\\n        seed('b', 'running'),\\n        seed('c', 'ready'),\\n        seed('d', 'failed'),\\n        seed('e', 'deleted'),\\n      ]);\\n    final videos = await HostMediaClient(invoker: invoker).listVideos(\\n      partyId: 'party-1',\\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n      channelId: 'cctv',\\n    );\\n    expect(invoker.names, <String>[kListHostVideos]);\\n    expect(\\n      invoker.payloads.single,\\n      containsPair('channelId', 'cctv'),\\n    );\\n    expect(videos.map((v) => '${v.seedId}:${v.status}'), <String>[\\n      'a:queued',\\n      'b:running',\\n      'c:ready',\\n      'd:failed',\\n      'e:deleted',\\n    ]);\\n    expect(videos[2].previewAvailable, isTrue);\\n  });\\n\\n  test('generate enqueues the fixed preset and rejects other presets', () async {\\n    final invoker = FakeHostMediaInvoker();\\n    final client = HostMediaClient(invoker: invoker);\\n    final result = await client.generateVideo(\\n      partyId: 'party-1',\\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n      channelId: 'cctv',\\n      seedId: 'catalog-1',\\n      idempotencyKey: 'idem-1',\\n    );\\n    expect(result['seedId'], 'catalog-1');\\n    expect(result['jobId'], 'hv-catalog-1');\\n    expect(invoker.payloads.single['presetId'], kCheapDemoPresetId);\\n    await expectLater(\\n      client.generateVideo(\\n        partyId: 'party-1',\\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n        channelId: 'cctv',\\n        seedId: 'catalog-2',\\n        idempotencyKey: 'idem-2',\\n        presetId: 'ultra_cinema',\\n      ),\\n      throwsArgumentError,\\n    );\\n    expect(invoker.generates, 1);\\n  });\\n\\n  test('preview returns fresh signed clips with https URLs', () async {\\n    final invoker = FakeHostMediaInvoker();\\n    final preview = await HostMediaClient(invoker: invoker).getPreview(\\n      partyId: 'party-1',\\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n      channelId: 'cctv',\\n      seedId: 'catalog-1',\\n    );\\n    expect(preview.seedId, 'catalog-1');\\n    expect(preview.clips, hasLength(4));\\n    expect(\\n      preview.clips.map((c) => c.cameraId),\\n      <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\\n    );\\n    for (final clip in preview.clips) {\\n      expect(clip.url.scheme, 'https');\\n    }\\n  });\\n\\n  test('delete reconciles per selected seed id', () async {\\n    final invoker = FakeHostMediaInvoker()\\n      ..seeds.addAll(<HostSeedVideo>[seed('a', 'ready'), seed('b', 'ready')]);\\n    final client = HostMediaClient(invoker: invoker);\\n    final result = await client.deleteVideos(\\n      partyId: 'party-1',\\n      deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n      channelId: 'cctv',\\n      seedIds: const <String>['a'],\\n    );\\n    expect(result['deletedSeedIds'], <String>['a']);\\n    expect(result['revokedManifest'], isTrue);\\n    expect(\\n      (await client.listVideos(\\n        partyId: 'party-1',\\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n        channelId: 'cctv',\\n      )).map((v) => v.seedId),\\n      <String>['b'],\\n    );\\n  });\\n\\n  test('rejects cross-party entries and malformed shapes', () async {\\n    final invoker = FakeHostMediaInvoker();\\n    final client = HostMediaClient(invoker: invoker);\\n    invoker.seeds.add(\\n      HostSeedVideo(\\n        seedId: 'x',\\n        partyId: 'other-party',\\n        deviceIdlessParty: 'other-party',\\n        channelId: 'cctv',\\n        status: 'ready',\\n        jobId: 'hv-x',\\n        createdAt: '2026-10-29T14:00:00.000Z',\\n        expiresAt: '2030-01-01T00:00:00.000Z',\\n        previewAvailable: true,\\n        cameraIds: const <String>['CAM-01'],\\n      ),\\n    );\\n    await expectLater(\\n      client.listVideos(\\n        partyId: 'party-1',\\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n        channelId: 'cctv',\\n      ),\\n      throwsFormatException,\\n    );\\n    invoker.seeds.clear();\\n    invoker.failure = <String, Object?>{'unexpected': 'shape'};\\n    await expectLater(\\n      client.listVideos(\\n        partyId: 'party-1',\\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n        channelId: 'cctv',\\n      ),\\n      throwsFormatException,\\n    );\\n  });\\n\\n  test('bounds a callable that never completes', () async {\\n    final client = HostMediaClient(\\n      invoker: _PendingInvoker(),\\n      timeout: const Duration(milliseconds: 5),\\n    );\\n    await expectLater(\\n      client.listVideos(\\n        partyId: 'party-1',\\n        deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\\n        channelId: 'cctv',\\n      ),\\n      throwsA(isA<ManifestTransportException>()),\\n    );\\n  });\\n}\\n\\nfinal class _PendingInvoker implements HostMediaCallableInvoker {\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) =>\\n      Completer<Object?>().future;\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/host_media_client_test.dart\"}"},"time":{"start":1793462142310,"end":1793462155324}}}}
