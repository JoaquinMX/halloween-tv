  if (!_firstFetchDone && listing == null && _error == null) {\n343:       return const Text(\n344:         'Loading guest codes…',\n345:         key: kGuestCodeLoadingKey,\n346:         style: TextStyle(color: Colors.white70, fontSize: 22),\n347:       );\n348:     }\n349:     // First fetch failed with nothing valid to show: error, no QR, no rows.\n350:     if (listing == null && _error != null) {\n351:       return Text(\n352:         'Guest list unavailable: $_error',\n353:         key: kGuestCodeErrorKey,\n354:         style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n355:       );\n356:     }\n357:     final List<GuestCodeEntry> rows = listing?.devices ?? <GuestCodeEntry>[];\n358:     if (rows.isEmpty) {\n359:       return Column(\n360:         crossAxisAlignment: CrossAxisAlignment.start,\n361:         mainAxisSize: MainAxisSize.min,\n362:         children: <Widget>[\n363:           const Text(\n364:             'No guests yet — new joins appear here automatically.',\n365:             key: kGuestCodeEmptyKey,\n366:             style: TextStyle(color: Colors.white70, fontSize: 22),\n367:           ),\n368:           if (_error != null)\n369:             Padding(\n370:               padding: const EdgeInsets.only(top: 8),\n371:               child: Text(\n372:                 'Refresh failed: $_error — showing last session.',\n373:                 key: kGuestCodeErrorKey,\n374:                 style: const TextStyle(\n375:                   color: Color(0xFFFFC107),\n376:                   fontSize: 18,\n377:                 ),\n378:               ),\n379:             ),\n380:         ],\n381:       );\n382:     }\n383:     return Column(\n384:       key: kGuestCodeListKey,\n385:       crossAxisAlignment: CrossAxisAlignment.start,\n386:       mainAxisSize: MainAxisSize.min,\n387:       children: <Widget>[\n388:         for (final GuestCodeEntry entry in rows)\n389:           Padding(\n390:             padding: const EdgeInsets.symmetric(vertical: 4),\n391:             child: Text(\n392:               '${entry.displayLabel}: ${entry.deviceId}',\n393:               style: const TextStyle(color: Colors.white, fontSize: 26),\n394:             ),\n395:           ),\n396:         if (_error != null)\n397:           Padding(\n398:             padding: const EdgeInsets.only(top: 8),\n399:             child: Text(\n400:               'Refresh failed: $_error — showing last session.',\n401:               key: kGuestCodeErrorKey,\n402:               style: const TextStyle(\n403:                 color: Color(0xFFFFC107),\n404:                 fontSize: 18,\n405:               ),\n406:             ),\n407:           ),\n408:       ],\n409:     );\n410:   }\n411: }\n412: \n413: /// Large, TV-focusable panel action.\n414: class _PanelButton extends StatelessWidget {\n415:   const _PanelButton({\n416:     required this.actionKey,\n417:     required this.label,\n418:     required this.onPressed,\n419:     this.focusNode,\n420:   });\n421: \n422:   final Key actionKey;\n423:   final String label;\n424:   final VoidCallback onPressed;\n425:   final FocusNode? focusNode;\n426: \n427:   @override\n428:   Widget build(BuildContext context) {\n429:     return OutlinedButton(\n430:       key: actionKey,\n431:       focusNode: focusNode,\n432:       onPressed: onPressed,\n433:       style: OutlinedButton.styleFrom(\n434:         foregroundColor: Colors.white,\n435:         side: const BorderSide(color: CctvTheme.frameEdge, width: 2),\n436:         padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16),\n437:         textStyle: CctvTheme.badgeStyle,\n438:       ),\n439:       child: Align(alignment: Alignment.centerLeft, child: Text(label)),\n440:     );\n441:   }\n442: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a59c4b76499364bbb5876d677c"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_code_panel.dart\"}"},"time"