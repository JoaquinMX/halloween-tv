f BackendError && error.errorCode === \"MANIFEST_MISMATCH\",\n+      `${key} must be rejected`,\n+    );\n+  }\n+  // ACK hashes must exactly match the actual manifest: extra hashes rejected.\n+  const two = counts.manifests[\"2\"];\n+  assert.throws(\n+    () => parseAck({\n+      partyId: two.partyId, deviceId: \"tv-pilot\", channelId: two.channelId, manifestVersion: two.version,\n+      clipHashes: Object.fromEntries([...two.cameraClips.map((clip) => [clip.cameraId, clip.sha256] as const), [\"CAM-03\", \"c\".repeat(64)] as const]),\n+    }),\n+    (error: unknown) => error instanceof BackendError && error.errorCode === \"MANIFEST_MISMATCH\",\n+  );\n+});\n   const fixture = await readFixture();\n   const { app, db, bucket } = await createEmulatorContext();\n   const partyId = fixture.manifest.partyId;\n   const deviceId = \"tv-pilot\";\n","status":"modified","additions":49,"deletions":1}],"truncated":false},"content":[{"type":"text","text":"Edited backend/functions/test/backend_contract_fixture.test.ts (1 replacement)"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929ef044715e8110ba98861ca964"}},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"test(\\\"camera-count fixture accepts 1/2/4 first-N prefixes with legacy four-camera hashes preserved\\\", async () => {\\n  const content = await readFile(resolve(__dirname, \\\"../../../test/fixtures/cctv_counts_v1.json\\\"), \\\"utf8\\\");\\n  const counts = JSON.parse(content) as {\\n    counts: number[]; defaultCount: number; cameraIds: string[];\\n    manifests: Record<string, DeliveryManifest>;\\n    invalid: Record<string, { cameraClips: unknown }>;\\n  };\\n  assert.deepEqual(counts.counts, [1, 2, 4]);\\n  assert.equal(counts.defaultCount, 4);\\n  assert.deepEqual(counts.cameraIds, [...expectedCameraIds(4)]);\\n  for (const count of [1, 2, 4]) {\\n    const manifest = counts.manifests[String(count)];\\n    validateCanonicalClips(manifest.cameraClips);\\n    assert.equal(manifest.camer