 ClipDescriptor identicalContent = ClipDescriptor(\n159:         id: 'clip-1',\n160:         cameraId: 'CAM-01',\n161:         storageObjectId: 'parties/pilot/old/CAM-01.mp4',\n162:         sha256: hashes['CAM-01']!,\n163:         sizeBytes: 10,\n164:         duration: const Duration(seconds: 2),\n165:         mimeType: 'video/mp4',\n166:       );\n167:       expect(\n168:         await client.refreshUrlFor(channelId: 'main', clip: identicalContent),\n169:         Uri.parse('https://delivery.test/CAM-01.mp4'),\n170:       );\n171: \n172:       final ClipDescriptor changedContent = ClipDescriptor(\n173:         id: 'clip-1',\n174:         cameraId: 'CAM-01',\n175:         storageObjectId: 'parties/pilot/old/CAM-01.mp4',\n176:         sha256: 'e' * 64,\n177:         sizeBytes: 10,\n178:         duration: const Duration(seconds: 2),\n179:         mimeType: 'video/mp4',\n180:       );\n181:       await expectLater(\n182:         client.refreshUrlFor(channelId: 'main', clip: changedContent),\n183:         throwsStateError,\n184:       );\n185:     },\n186:   );\n187: \n188:   test(\n189:     'ACK response must identify the requested version and completed purge',\n190:     () async {\n191:       final Map<String, String> hashes = <String, String>{\n192:         for (final CctvSlot slot in cctvSlots)\n193:           slot.id: String.fromCharCode(96 + slot.index + 1) * 64,\n194:       };\n195:       final List<Object?> responses = <Object?>[\n196:         null,\n197:         <String, Object?>{'manifestVersion': 1, 'purged': true},\n198:         <String, Object?>{'ackId': 'ack', 'purged': true},\n199:         <String, Object?>{\n200:           'ackId': 'ack',\n201:           'manifestVersion': '1',\n202:           'purged': true,\n203:         },\n204:         <String, Object?>{'ackId': 'ack', 'manifestVersion': 2, 'purged': true},\n205:         <String, Object?>{\n206:           'ackId': 'ack',\n207:           'manifestVersion': 1,\n208:           'purged': false,\n209:         },\n210:         <String, Object?>{'ackId': '', 'manifestVersion': 1, 'purged': true},\n211:       ];\n212:       for (final Object? response in responses) {\n213:         await expectLater(\n214:           FirebaseDeliveryClient(\n215:             identity: FirebaseTvIdentity(\n216:               partyId: 'pilot',\n217:               deviceId: 'tv-pilot',\n218:             ),\n219:             callableInvoker: _OneResponseCallable(response),\n220:           ).acknowledge(\n221:             partyId: 'pilot',\n222:             channelId: 'main',\n223:             manifestVersion: 1,\n224:             verifiedClipHashes: hashes,\n225:           ),\n226:           throwsFormatException,\n227:         );\n228:       }\n229: \n230:       final FirebaseDeliveryClient success = FirebaseDeliveryClient(\n231:         identity: FirebaseTvIdentity(partyId: 'pilot', deviceId: 'tv-pilot'),\n232:         callableInvoker: _OneResponseCallable(<String, Object?>{\n233:           'ackId': 'ack-1',\n234:           'manifestVersion': 1,\n235:           'purged': true,\n236:         }),\n237:       );\n238:       await success.acknowledge(\n239:         partyId: 'pilot',\n240:         channelId: 'main',\n241:         manifestVersion: 1,\n242:         verifiedClipHashes: hashes,\n243:       );\n244:     },\n245:   );\n246: }\n247: \n248: final class _OneResponseCallable implements FirebaseCallableInvoker {\n249:   _OneResponseCallable(this.response);\n250: \n251:   final Object? response;\n252: \n253:   @override\n254:   Future<Object?> call(String name, Map<String, Object?> payload) async =>\n255:       response;\n256: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b0cb0748fb20080e03897bb0e"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/packages/infra_signed_urls/test/backend_contract_fixture_test.dart\"}"},"time":{"start":1793460997786,"end":1793460997815}}}}
