nst channel = channelSnap.data()!;\n68:         if (channel.partyId !== input.partyId || channel.status !== \"active\") {\n69:           console.warn(\n70:             `joinParty rejected: channel doc ${input.channelId} is inactive or mismatched for party ${input.partyId}`,\n71:           );\n72:           throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n73:         }\n74:         // Fail closed: ANY present-but-invalid stored PIN (number/boolean/\n75:         // malformed string written via console) counts as configured and\n76:         // rejects every attempt. Only a missing field or an empty string\n77:         // means \"no PIN configured\".\n78:         const storedPin: unknown = party.joinPin;\n79:         const pinUnset = storedPin === undefined || storedPin === \"\";\n80:         if (!pinUnset) {\n81:           if (typeof storedPin !== \"string\" || !JOIN_PIN_RE.test(storedPin)) {\n82:             console.warn(\n83:               `joinParty rejected: party ${input.partyId} has a misconfigured joinPin; re-provision it with seed_join`,\n84:             );\n85:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n86:           }\n87:           if (input.joinPin !== storedPin) {\n88:             console.warn(\n89:               `joinParty rejected: wrong or missing join PIN for party ${input.partyId}`,\n90:             );\n91:             throw new BackendError(\"FORBIDDEN\", JOIN_REJECTED_MESSAGE);\n92:           }\n93:         }\n94:         if (deviceSnap.exists) {\n95:           const device = deviceSnap.data()!;\n96:           if (\n97:             device.partyId !== input.partyId ||\n98:             device.role !== \"guest\" ||\n99:             device.status !== \"active\" ||\n100:             (typeof device.deviceId === \"string\" && device.deviceId !== input.deviceId)\n101:           ) {\n102:             console.warn(\n103:               `joinParty rejected: device ${input.deviceId} is not a valid guest registration 