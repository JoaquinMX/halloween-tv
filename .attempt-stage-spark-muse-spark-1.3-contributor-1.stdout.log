era elements (and their decoders) survive both.\\n    final List<({String label, String cameraId})> slots = _slots();\\n    final String? hero =\\n        widget.heroCameraId != null &&\\n                slots.any(\\n                  (({String label, String cameraId}) slot) =>\\n                      slot.cameraId == widget.heroCameraId,\\n                )\\n            ? widget.heroCameraId\\n            : null;\\n    return Container(\\n      key: kCctvWallKey,\\n      color: CctvTheme.gutter,\\n      child: LayoutBuilder(\\n        builder: (BuildContext context, BoxConstraints constraints) {\\n          final Size size = constraints.biggest;\\n          final List<Rect> rects = _gridRects(size, slots.length);\\n          return Stack(\\n            children: <Widget>[\\n              for (int index = 0; index < slots.length; index++)\\n                AnimatedPositioned(\\n                  key: ValueKey<String>(\\n                    'wall-slot-${slots[index].cameraId}',\\n                  ),\\n                  duration: kWallLayoutDuration,\\n                  left: hero == slots[index].cameraId\\n                      ? 0\\n                      : rects[index].left,\\n                  top: hero == slots[index].cameraId\\n                      ? 0\\n                      : rects[index].top,\\n                  width: hero == slots[index].cameraId\\n                      ? size.width\\n                      : rects[index].width,\\n                  height: hero == slots[index].cameraId\\n                      ? size.height\\n                      : rects[index].height,\\n                  child: AnimatedOpacity(\\n                    duration: kWallLayoutDuration,\\n                    opacity:\\n                        hero == null || hero == slots[index].cameraId ? 1 : 0,\\n                    // Faded siblings stay mounted (decoders alive) but leave\\n                    // hit-testing to the hero tile.\\n                    child: IgnorePointer(\\n    