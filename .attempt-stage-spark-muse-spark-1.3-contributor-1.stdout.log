n466:                 if (path.startsWith(\"parties/\")) {\n467:                   attributable.add(path);\n468:                   revokedManifestPaths.push(path);\n469:                 }\n470:               }\n471:             }\n472:           }\n473:         }\n474:       }\n475:     } catch {\n476:       revokedManifestPaths = [...attributable].filter((p) => p.includes(\"/delivery/\"));\n477:     }\n478:     const deletedObjects: string[] = [];\n479:     const pendingDeletions: string[] = [];\n480:     for (const path of attributable) {\n481:       try {\n482:         await deleteWithRetry(deleteObject, bucket.file(path));\n483:         deletedObjects.push(path);\n484:       } catch {\n485:         // Persisted below for the sweeper; verifiedAbsent stays false until\n486:         // every attributable object is confirmed absent.\n487:         pendingDeletions.push(path);\n488:       }\n489:     }\n490:     // Fail bound jobs closed with budget-pointer release (same semantics as\n491:     // the worker-side failForWithdrawnConsent path).\n492:     const budgetRef = db.doc(`parties/${identity.partyId}/generationBudget/active`);\n493:     for (const jobDoc of jobs.docs) {\n494:       const job = jobDoc.data() as Record<string, unknown>;\n495:       if ([\"failed\", \"purged\", \"expired\"].includes(String(job.state))) {\n496:         await db.runTransaction(async (transaction) => {\n497:           const budget = await transaction.get(budgetRef);\n498:           if (budget.exists && budget.data()?.activeJobId === jobDoc.id) {\n499:             transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n500:           }\n501:         }).catch(() => undefined);\n502:         continue;\n503:       }\n504:       await db.runTransaction(async (transaction) => {\n505:         const [current, budget] = await Promise.all([transaction.get(jobDoc.ref), transaction.get(budgetRef)]);\n506:         if (!current.exists) return;