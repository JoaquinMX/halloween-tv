{"type":"tool_use","timestamp":1793463626770,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c32617001qLkVUUysFMj5Xb","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c32001001B9H3531PH1m3AX","type":"tool","id":"call_01a192c325f4749b82c0f1e70d9a06df","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/host_codes.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/host_codes.dart, lines 1-202\n1: /// Host invite QR data (TV settings panel, separately labelled HOST QR).\n2: ///\n3: /// The TV mints a short-lived host invite through the host-only\n4: /// `createHostInvite` callable and presents it as exactly one QR encoding\n5: /// the scoped invite capability. The companion redeems it on its dedicated\n6: /// host entry screen (Scan Host QR + an explicit Join-as-guest route), so\n7: /// host administration is never reachable through the guest PIN or a\n8: /// client-supplied role string.\n9: ///\n10: /// Host QR JSON (TV display, companion parse) contains exactly `partyId` +\n11: /// `channelId` + `inviteToken` + `role` (`'host'`). It never carries a\n12: /// deviceId (in particular never the TV device identity), URL, or secret.\n13: /// Role examples live in `test/fixtures/join_roles_v1.json`.\n14: library;\n15: \n16: import 'dart:convert';\n17: \n18: import 'package:cloud_functions/cloud_functions.dart';\n19: \n20: import 'package:tv_app/src/wall/guest_codes.dart' show CallableInvoker;\n21: \n22: /// True when [value] looks like a server-minted host invite token.\n23: ///\n24: /// Tokens are non-empty and never six ASCII digits: a guest PIN presented\n25: /// where a token belongs is shape-rejected before it can cross the wire.\n26: bool isValidHostInviteToken(String value) =>\n27:     value.isNotEmpty && !RegExp(r'^[0-9]{6}$').hasMatch(value);\n28: \n29: /// Builds the host invite QR payload as a JSON object.\n30: ///\n31: /// Contains exactly `partyId` + `channelId` + `inviteToken` + `role`\n32: /// (`'host'`). Never includes a deviceId. Throws [ArgumentError] when\n33: /// [inviteToken] is not a plausible server-minted token (see\n34: /// [isValidHostInviteToken]).\n35: String buildHostJoinPayload({\n36:   required String partyId,\n37:   required String channelId,\n38:   required String inviteToken,\n39: }) {\n40:   if (!isValidHostInviteToken(inviteToken)) {\n41:     throw ArgumentError.value(\n42:       inviteToken,\n43:       'inviteToken',\n44:       'must be a server-minted host invite token',\n45:     );\n46:   }\n47:   return jsonEncode(<String, String>{\n48:     'partyId': partyId,\n49:     'channelId': channelId,\n50:     'inviteToken': inviteToken,\n51:     'role': 'host',\n52:   });\n53: }\n54: \n55: /// Failure minting or validating a host invite.\n56: final class HostInviteException implements Exception {\n57:   /// Creates a host-invite failure.\n58:   const HostInviteException(this.message);\n59: \n60:   /// Human-readable reason shown on the TV panel.\n61:   final String message;\n62: \n63:   @override\n64:   String toString() => 'HostInviteException: $message';\n65: }\n66: \n67: /// A server-minted, short-lived host invite for this party + channel.\n68: final class HostInvite {\n69:   /// Creates an invite.\n70:   const HostInvite({\n71:     required this.partyId,\n72:     required this.channelId,\n73:     required this.inviteToken,\n74:     required this.expiresAt,\n75:   });\n76: \n77:   /// Party the invite is bound to.\n78:   final String partyId;\n79: \n80:   /// Channel the invite is bound to.\n81:   final String channelId;\n82: \n83:   /// Opaque invite capability (presented once as the QR payload).\n84:   final String inviteToken;\n85: \n86:   /// Server-stated expiry; the panel stops presenting the QR past it.\n87:   final DateTime expiresAt;\n88: \n89:   /// True when [now] is at or past [expiresAt].\n90:   bool isExpired(DateTime now) => !now.isBefore(expiresAt);\n91: \n92:   /// Validates a raw `createHostInvite` response against the requesting\n93:   /// client's scope. Throws [HostInviteException] on any malformed field.\n94:   factory HostInvite.fromResponse(\n95:     Map<String, Object?> data, {\n96:     required String expectedPartyId,\n97:     required String expectedChannelId,\n98:   }) {\n99:     final Object? partyId = data['partyId'];\n100:     final Object? channelId = data['channelId'];\n101:     final Object? inviteToken = data['inviteToken'];\n102:     final Object? expiresAt = data['expiresAt'];\n103:     if (partyId is! String || partyId.isEmpty) {\n104:       throw const HostInviteException('Host invite response has no party.');\n105:     }\n106:     if (channelId is! String || channelId.isEmpty) {\n107:       throw const HostInviteException('Host invite response has no channel.');\n108:     }\n109:     if (inviteToken is! String || !isValidHostInviteToken(inviteToken)) {\n110:       throw const HostInviteException('Host invite token is malformed.');\n111:     }\n112:     if (partyId != expectedPartyId) {\n113:       throw const HostInviteException('Host invite party mismatch.');\n114:     }\n115:     if (channelId != expectedChannelId) {\n116:       throw const HostInviteException('Host invite channel mismatch.');\n117:     }\n118:     DateTime? expiry;\n119:     if (expiresAt is String) {\n120:       expiry = DateTime.tryParse(expiresAt);\n121:     }\n122:     if (expiry == null) {\n123:       throw const HostInviteException('Host invite expiry is malformed.');\n124:     }\n125:     return HostInvite(\n126:       partyId: partyId,\n127:       channelId: channelId,\n128:       inviteToken: inviteToken,\n129:       expiresAt: expiry,\n130:     );\n131:   }\n132: }\n133: \n134: /// Reads the host-only `createHostInvite` callable (TV device only).\n135: final class HostInviteClient {\n136:   /// Creates a client over an invoker seam.\n137:   const HostInviteClient({\n138:     required this.invoker,\n139:     required this.partyId,\n140:     required this.deviceId,\n141:     required this.channelId,\n142:   });\n143: \n144:   /// Builds a client over real Cloud Functions.\n145:   factory HostInviteClient.cloudFunctions({\n146:     required FirebaseFunctions functions,\n147:     required String partyId,\n148:     required String deviceId,\n149:     required String channelId,\n150:   }) => HostInviteClient(\n151:     invoker: (String name, Map<String, Object?> payload) async {\n152:       final HttpsCallableResult<Object?> result = await functions\n153:           .httpsCallable(name)\n154:           .call(payload);\n155:       final Object? data = result.data;\n156:       if (data is! Map) {\n157:         throw const HostInviteException(\n158:           'Host invite response was not an object.',\n159:         );\n160:       }\n161:       return Map<String, Object?>.from(data);\n162:     },\n163:     partyId: partyId,\n164:     deviceId: deviceId,\n165:     channelId: channelId,\n166:   );\n167: \n168:   /// Invoker seam (Cloud Functions in production, fake in tests).\n169:   final CallableInvoker invoker;\n170: \n171:   /// Party the TV belongs to.\n172:   final String partyId;\n173: \n174:   /// TV's own device code (the authorized host-invite minter).\n175:   ///\n176:   /// Authorization travels in the request only; the session QR never\n177:   /// carries it.\n178:   final String deviceId;\n179: \n180:   /// Active channel.\n181:   final String channelId;\n182: \n183:   /// Mints a validated host invite bound to this party + channel.\n184:   ///\n185:   /// Throws [HostInviteException] when the response is malformed.\n186:   /// Authorization failures surface as the caller's error.\n187:   Future<HostInvite> createInvite() async {\n188:     final Map<String, Object?> data = await invoker(\n189:       'createHostInvite',\n190:       <String, Object?>{\n191:         'partyId': partyId,\n192:         'deviceId': deviceId,\n193:         'channelId': channelId,\n194:       },\n195:     );\n196:     return HostInvite.fromResponse(\n197:       data,\n198:       expectedPartyId: partyId,\n199:       expectedChannelId: channelId,\n200:     );\n201:   }\n202: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/host_codes.dart, lines 1-202\n1: /// Host invite QR data (TV settings panel, separately labelled HOST QR).\n2: ///\n3: /// The TV mints a short-lived host invite through the host-only\n4: /// `createHostInvite` callable and presents it as exactly one QR encoding\n5: /// the scoped invite capability. The companion redeems it on its dedicated\n6: /// host entry screen (Scan Host QR + an explicit Join-as-guest route), so\n7: /// host administration is never reachable through the guest PIN or a\n8: /// client-supplied role string.\n9: ///\n10: /// Host QR JSON (TV display, companion parse) contains exactly `partyId` +\n11: /// `channelId` + `inviteToken` + `role` (`'host'`). It never carries a\n12: /// deviceId (in particular never the TV device identity), URL, or secret.\n13: /// Role examples live in `test/fixtures/join_roles_v1.json`.\n14: library;\n15: \n16: import 'dart:convert';\n17: \n18: import 'package:cloud_functions/cloud_functions.dart';\n19: \n20: import 'package:tv_app/src/wall/guest_codes.dart' show CallableInvoker;\n21: \n22: /// True when [value] looks like a server-minted host invite token.\n23: ///\n24: /// Tokens are non-empty and never six ASCII digits: a guest PIN presented\n25: /// where a token belongs is shape-rejected before it can cross the wire.\n26: bool isValidHostInviteToken(String value) =>\n27:     value.isNotEmpty && !RegExp(r'^[0-9]{6}$').hasMatch(value);\n28: \n29: /// Builds the host invite QR payload as a JSON object.\n30: ///\n31: /// Contains exactly `partyId` + `channelId` + `inviteToken` + `role`\n32: /// (`'host'`). Never includes a deviceId. Throws [ArgumentError] when\n33: /// [inviteToken] is not a plausible server-minted token (see\n34: /// [isValidHostInviteToken]).\n35: String buildHostJoinPayload({\n36:   required String partyId,\n37:   required String channelId,\n38:   required String inviteToken,\n39: }) {\n40:   if (!isValidHostInviteToken(inviteToken)) {\n41:     throw ArgumentError.value(\n42:       inviteToken,\n43:       'inviteToken',\n44:       'must be a server-minted host invite token',\n45:     );\n46:   }\n47:   return jsonEncode(<String, String>{\n48:     'partyId': partyId,\n49:     'channelId': channelId,\n50:     'inviteToken': inviteToken,\n51:     'role': 'host',\n52:   });\n53: }\n54: \n55: /// Failure minting or validating a host invite.\n56: final class HostInviteException implements Exception {\n57:   /// Creates a host-invite failure.\n58:   const HostInviteException(this.message);\n59: \n60:   /// Human-readable reason shown on the TV panel.\n61:   final String message;\n62: \n63:   @override\n64:   String toString() => 'HostInviteException: $message';\n65: }\n66: \n67: /// A server-minted, short-lived host invite for this party + channel.\n68: final class HostInvite {\n69:   /// Creates an invite.\n70:   const HostInvite({\n71:     required this.partyId,\n72:     required this.channelId,\n73:     required this.inviteToken,\n74:     required this.expiresAt,\n75:   });\n76: \n77:   /// Party the invite is bound to.\n78:   final String partyId;\n79: \n80:   /// Channel the invite is bound to.\n81:   final String channelId;\n82: \n83:   /// Opaque invite capability (presented once as the QR payload).\n84:   final String inviteToken;\n85: \n86:   /// Server-stated expiry; the panel stops presenting the QR past it.\n87:   final DateTime expiresAt;\n88: \n89:   /// True when [now] is at or past [expiresAt].\n90:   bool isExpired(DateTime now) => !now.isBefore(expiresAt);\n91: \n92:   /// Validates a raw `createHostInvite` response against the requesting\n93:   /// client's scope. Throws [HostInviteException] on any malformed field.\n94:   factory HostInvite.fromResponse(\n95:     Map<String, Object?> data, {\n96:     required String expectedPartyId,\n97:     required String expectedChannelId,\n98:   }) {\n99:     final Object? partyId = data['partyId'];\n100:     final Object? channelId = data['channelId'];\n101:     final Object? inviteToken = data['inviteToken'];\n102:     final Object? expiresAt = data['expiresAt'];\n103:     if (partyId is! String || partyId.isEmpty) {\n104:       throw const HostInviteException('Host invite response has no party.');\n105:     }\n106:     if (channelId is! String || channelId.isEmpty) {\n107:       throw const HostInviteException('Host invite response has no channel.');\n108:     }\n109:     if (inviteToken is! String || !isValidHostInviteToken(inviteToken)) {\n110:       throw const HostInviteException('Host invite token is malformed.');\n111:     }\n112:     if (partyId != expectedPartyId) {\n113:       throw const HostInviteException('Host invite party mismatch.');\n114:     }\n115:     if (channelId != expectedChannelId) {\n116:       throw const HostInviteException('Host invite channel mismatch.');\n117:     }\n118:     DateTime? expiry;\n119:     if (expiresAt is String) {\n120:       expiry = DateTime.tryParse(expiresAt);\n121:     }\n122:     if (expiry == null) {\n123:       throw const HostInviteException('Host invite expiry is malformed.');\n124:     }\n125:     return HostInvite(\n126:       partyId: partyId,\n127:       channelId: channelId,\n128:       inviteToken: inviteToken,\n129:       expiresAt: expiry,\n130:     );\n131:   }\n132: }\n133: \n134: /// Reads the host-only `createHostInvite` callable (TV device only).\n135: final class HostInviteClient {\n136:   /// Creates a client over an invoker seam.\n137:   const HostInviteClient({\n138:     required this.invoker,\n139:     required this.partyId,\n140:     required this.deviceId,\n141:     required this.channelId,\n142:   });\n143: \n144:   /// Builds a client over real Cloud Functions.\n145:   factory HostInviteClient.cloudFunctions({\n146:     required FirebaseFunctions functions,\n147:     required String partyId,\n148:     required String deviceId,\n149:     required String channelId,\n150:   }) => HostInviteClient(\n151:     invoker: (String name, Map<String, Object?> payload) async {\n152:       final HttpsCallableResult<Object?> result = await functions\n153:           .httpsCallable(name)\n154:           .call(payload);\n155:       final Object? data = result.data;\n156:       if (data is! Map) {\n157:         throw const HostInviteException(\n158:           'Host invite response was not an object.',\n159:         );\n160:       }\n161:       return Map<String, Object?>.from(data);\n162:     },\n163:     partyId: partyId,\n164:     deviceId: deviceId,\n165:     channelId: channelId,\n166:   );\n167: \n168:   /// Invoker seam (Cloud Functions in production, fake in tests).\n169:   final CallableInvoker invoker;\n170: \n171:   /// Party the TV belongs to.\n172:   final String partyId;\n173: \n174:   /// TV's own device code (the authorized host-invite minter).\n175:   ///\n176:   /// Authorization travels in the request only; the session QR never\n177:   /// carries it.\n178:   final String deviceId;\n179: \n180:   /// Active channel.\n181:   final String channelId;\n182: \n183:   /// Mints a validated host invite bound to this party + channel.\n184:   ///\n185:   /// Throws [HostInviteException] when the response is malformed.\n186:   /// Authorization failures surface as the caller's error.\n187:   Future<HostInvite> createInvite() async {\n188:     final Map<String, Object?> data = await invoker(\n189:       'createHostInvite',\n190:       <String, Object?>{\n191:         'partyId': partyId,\n192:         'deviceId': deviceId,\n193:         'channelId': channelId,\n194:       },\n195:     );\n196:     return HostInvite.fromResponse(\n197:       data,\n198:       expectedPartyId: partyId,\n199:       expectedChannelId: channelId,\n200:     );\n201:   }\n202: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c325f4749b82c0f1e70d9a06df"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/host_codes.dart\"}"},"time":{"start":1793463625239,"end":1793463626770}}}}
{"type":"tool_use","timestamp":1793463626772,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c328e6001nTHE55uF5sXAAW","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c32001001B9H3531PH1m3AX","type":"tool","id":"call_01a192c328c570ed8aab2fdc7120db7a","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_screen.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_screen.dart, lines 1-1085\n1: /// Hosts the haunted-surveillance channel wall for one party.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:io';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_cache/core_cache.dart';\n9: import 'package:core_effects/core_effects.dart';\n10: import 'package:core_foundation/core_foundation.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: import 'package:core_ui/core_ui.dart';\n13: import 'package:flutter/material.dart';\n14: import 'package:flutter/services.dart';\n15: import 'package:kernel_app/kernel_app.dart';\n16: import 'package:tv_app/src/media/feed_assets.dart';\n17: import 'package:tv_app/src/playback/camera_tile.dart';\n18: import 'package:tv_app/src/playback/tile_video_controller.dart';\n19: import 'package:tv_app/src/wall/guest_code_panel.dart';\n20: import 'package:tv_app/src/wall/guest_codes.dart';\n21: import 'package:tv_app/src/wall/host_code_panel.dart';\n22: import 'package:tv_app/src/wall/host_codes.dart';\n23: import 'package:tv_app/src/wall/live_wall_session.dart';\n24: import 'package:tv_app/src/wall/playback_handle.dart';\n25: import 'package:tv_app/src/wall/recovery_overlay.dart';\n26: import 'package:tv_app/src/wall/wall_boot.dart';\n27: import 'package:tv_app/src/wall/wall_focus.dart';\n28: \n29: /// Key of the status banner shown above the wall after recovery actions.\n30: const Key kWallStatusBannerKey = ValueKey<String>('wall-status-banner');\n31: \n32: /// Key of the hidden recovery panel.\n33: const Key kRecoveryOverlayKey = ValueKey<String>('recovery-overlay');\n34: \n35: /// Resolved channel + manifest rendered full-screen on the TV.\n36: ///\n37: /// Responsibilities kept in the app (design s4/s13):\n38: ///  * owns one [CameraTile] (hence one video decoder) per ACTIVE wall slot\n39: ///    (the 1/2/4 display cap never filters prepare/verify/ACK, which always\n40: ///    cover the complete received manifest),\n41: ///  * D-pad focus traversal between the active tiles (suppressed in hero),\n42: ///  * decoder-preserving camera hero (short OK release zooms, BACK\n43: ///    restores), available even when recovery is disabled,\n44: ///  * hidden recovery panel (OK long-press / MENU) with \"retry cached wall\",\n45: ///    \"disable effects\", a D-pad-operable 1/2/4 camera selector, and the\n46: ///    separately labelled HOST QR + GUEST CODES destinations,\n47: ///  * overscan-safe padding and an app-level status line.\n48: ///\n49: /// Channel chrome (HUD, scanlines/vignette, glitch, SIGNAL LOST frame) comes\n50: /// from `channel_cctv` + `core_ui` + `core_effects`; the app supplies the\n51: /// video surfaces through [HauntedSurveillancePlugin.tileBuilder]. Wall\n52: /// configuration (effects flag, camera count, hero target, manifest\n53: /// version, overscan safety) travels via [ChannelContext.settings], which\n54: /// [HauntedSurveillancePlugin.build] honors.\n55: class WallScreen extends StatefulWidget {\n56:   /// Creates the wall host.\n57:   const WallScreen({\n58:     super.key,\n59:     required this.plugin,\n60:     required this.manifest,\n61:     required this.tileControllerFactory,\n62:     required this.clock,\n63:     this.mediaByClipId = const <String, CachedMedia>{},\n64:     this.liveSession,\n65:     this.settings,\n66:     this.profile,\n67:     this.partyId = 'local-party',\n68:     this.tvDeviceId = '',\n69:     this.channelId = hauntedSurveillanceChannelId,\n70:     this.guestCodeClient,\n71:     this.glitchSeed = 0x4A11,\n72:     this.onRetryCached,\n73:     this.onRetryCachedPlayback,\n74:     this.fileExists,\n75:     this.recoveryEnabled = true,\n76:     this.initialEffectsDisabled = false,\n77:     this.initialCameraCount = kDefaultCctvClipCount,\n78:     this.hostInviteClient,\n79:     this.overscanPadding = const EdgeInsets.symmetric(\n80:       horizontal: 28,\n81:       vertical: 18,\n82:     ),\n83:     this.longPressDuration = const Duration(milliseconds: 600),\n84:     this.sourceSettleTimeout = const Duration(seconds: 15),\n85:   });\n86: \n87:   /// Channel plugin resolved from the kernel registry.\n88:   final ChannelPlugin plugin;\n89: \n90:   /// Wall manifest driving camera slots.\n91:   final PlaybackManifest manifest;\n92: \n93:   /// Builds one decoder per tile.\n94:   final TileVideoControllerFactory tileControllerFactory;\n95: \n96:   /// Clock used by the tile HUDs (injectable for deterministic tests).\n97:   final Clock clock;\n98: \n99:   /// Verified committed files keyed by manifest clip id.\n100:   final Map<String, CachedMedia> mediaByClipId;\n101: \n102:   /// Live subscription started after offline rendering.\n103:   final LiveWallSession? liveSession;\n104: \n105:   /// Party-scoped persistent settings.\n106:   final SettingsPort? settings;\n107: \n108:   /// Effect profile for tile overlays; defaults to [cctvProfile].\n109:   final EffectProfile? profile;\n110: \n111:   /// Party this wall belongs to.\n112:   final String partyId;\n113: \n114:   /// TV's own device code, shown on the host guest-code page.\n115:   final String tvDeviceId;\n116: \n117:   /// Active channel for the guest-code join payload.\n118:   final String channelId;\n119: \n120:   /// Host guest-code reader; null keeps the recovery panel on its actions\n121:   /// only (offline builds never list codes).\n122:   final GuestCodeClient? guestCodeClient;\n123: \n124:   /// Host-invite minter for the HOST QR destination; null hides the HOST QR\n125:   /// button (offline builds stay on the recovery actions only).\n126:   final HostInviteClient? hostInviteClient;\n127: \n128:   /// Seed for the wall's deterministic glitch bursts.\n129:   final int glitchSeed;\n130: \n131:   /// Reloads the last cached manifest; null result means \"nothing cached\".\n132:   final Future<PlaybackManifest?> Function()? onRetryCached;\n133: \n134:   /// Re-verifies the durable remote index without interrupting live work.\n135:   final Future<VerifiedWallPlayback?> Function()? onRetryCachedPlayback;\n136: \n137:   /// Existence check for verified local files.\n138:   ///\n139:   /// Defaults to real `File(path).exists()`. Injectable because `testWidgets`\n140:   /// bodies run in a FakeAsync zone where real dart:io never completes;\n141:   /// production passes nothing and keeps the real filesystem check.\n142:   final Future<bool> Function(String path)? fileExists;\n143: \n144:   /// Whether OK long-press / MENU reveals the recovery panel.\n145:   final bool recoveryEnabled;\n146: \n147:   /// Starts with effect overlays dropped.\n148:   final bool initialEffectsDisabled;\n149: \n150:   /// Restored party-scoped camera display cap (1, 2, or 4; see\n151:   /// [CctvWallSettingsKeys.cameraCount]). Unsupported values degrade to 4.\n152:   /// Passed through [WallGate] from the boot-time settings restore, before\n153:   /// wall construction.\n154:   final int initialCameraCount;\n155: \n156:   /// Extra padding keeping HUD text inside the TV's overscan-safe area.\n157:   final EdgeInsets overscanPadding;\n158: \n159:   /// How long OK must be held to reveal the recovery panel.\n160:   final Duration longPressDuration;\n161: \n162:   /// Bound for one tile source replacement to settle.\n163:   ///\n164:   /// Defaults to 15s. Injectable so tests do not stall real seconds on\n165:   /// decoder failure and prod can tune it alongside other timeouts.\n166:   final Duration sourceSettleTimeout;\n167: \n168:   @override\n169:   State<WallScreen> createState() => _WallScreenState();\n170: }\n171: \n172: class _WallScreenState extends State<WallScreen> {\n173:   late final WallFocusController _focus;\n174:   late final WallPlaybackHandle _handle;\n175: \n176:   late PlaybackManifest _manifest;\n177:   late Map<String, CachedMedia> _mediaByClipId;\n178:   late Map<String, TileMediaSource> _tileSources;\n179:   final Map<String, Completer<bool>> _sourceSettles =\n180:       <String, Completer<bool>>{};\n181:   final Set<String> _initialSettledCameras = <String>{};\n182:   bool _liveStarted = false;\n183:   late bool _effectsDisabled;\n184:   late int _cameraCount;\n185:   String? _heroCameraId;\n186:   int _heroOriginIndex = 0;\n187:   bool _recoveryVisible = false;\n188:   bool _guestCodesVisible = false;\n189:   bool _hostCodesVisible = false;\n190:   bool _selectHeld = false;\n191:   DateTime? _selectDownAt;\n192:   bool _holdFired = false;\n193:   bool _awaitingSelectRelease = false;\n194:   int _wallGeneration = 0;\n195:   bool _activatedHandle = false;\n196:   String? _status;\n197:   String? _recoveryStatus;\n198:   Timer? _okHoldTimer;\n199:   final FocusNode _recoveryFocus = FocusNode(debugLabel: 'recovery-primary');\n200: \n201:   @override\n202:   void initState() {\n203:     super.initState();\n204:     _focus = WallFocusController();\n205:     _manifest = widget.manifest;\n206:     _mediaByClipId = Map<String, CachedMedia>.of(widget.mediaByClipId);\n207:     _cameraCount = _sanitizeCameraCount(widget.initialCameraCount);\n208:     _focus.setActiveLayout(\n209:       tiles: _effectiveCount,\n210:       columns: _columnsFor(_effectiveCount),\n211:     );\n212:     _tileSources = _activeSources(_sourcesFor(_manifest, _mediaByClipId));\n213:     _effectsDisabled = widget.initialEffectsDisabled;\n214:     _handle = WallPlaybackHandle(\n215:       prepareAction: _prepareCurrentVersion,\n216:       activateAction: _activateCurrentVersion,\n217:     );\n218:     WidgetsBinding.instance.addPostFrameCallback((_) {\n219:       if (!mounted || _activatedHandle) {\n220:         return;\n221:       }\n222:       _activatedHandle = true;\n223:       unawaited(_bootHandle());\n224:     });\n225:   }\n226: \n227:   @override\n228:   void dispose() {\n229:     _okHoldTimer?.cancel();\n230:     _recoveryFocus.dispose();\n231:     _focus.dispose();\n232:     for (final Completer<bool> settle in _sourceSettles.values) {\n233:       if (!settle.isCompleted) settle.complete(false);\n234:     }\n235:     _sourceSettles.clear();\n236:     final LiveWallSession? session = widget.liveSession;\n237:     if (session != null) unawaited(session.dispose());\n238:     super.dispose();\n239:   }\n240: \n241:   /// Sanitizes a restored setting to a supported display cap (1, 2, or 4).\n242:   static int _sanitizeCameraCount(int value) =>\n243:       isSupportedCctvClipCount(value) ? value : kDefaultCctvClipCount;\n244: \n245:   /// Grid width for a tile count: 1 column for a single tile, 2 otherwise\n246:   /// (two side-by-side tiles share one row; four tiles form the 2x2 grid).\n247:   static int _columnsFor(int count) => count == 1 ? 1 : 2;\n248: \n249:   /// Rendered tile count: `min(configuredCount, manifest clips)`.\n250:   ///\n251:   /// The setting is a DISPLAY CAP only — it hides cameras, never filters\n252:   /// prepare/verify/ACK, which always cover the complete received manifest.\n253:   int get _effectiveCount => cctvEffectiveCount(\n254:     configuredCount: _cameraCount,\n255:     manifestClipCount: _manifest.clips.length,\n256:   );\n257: \n258:   /// Active camera ids in canonical wall order (the first-N slots).\n259:   ///\n260:   /// Because supported layouts are always a prefix of the canonical slots,\n261:   /// indices stay stable across count changes and shared cameras keep their\n262:   /// elements, decoders, and focus nodes.\n263:   List<String> _activeCameraIds() => <String>[\n264:     for (final CctvSlot slot in cctvSlots.take(_effectiveCount)) slot.id,\n265:   ];\n266: \n267:   /// Active camera ids for an incoming manifest (used before it is applied).\n268:   List<String> _activeCameraIdsFor(PlaybackManifest manifest) {\n269:     final int effective = cctvEffectiveCount(\n270:       configuredCount: _cameraCount,\n271:       manifestClipCount: manifest.clips.length,\n272:     );\n273:     return <String>[\n274:       for (final CctvSlot slot in cctvSlots.take(effective)) slot.id,\n275:     ];\n276:   }\n277: \n278:   /// Wall slot builder: app-owned player lifecycle per tile.\n279:   Widget _buildTile(\n280:     BuildContext context,\n281:     int index,\n282:     String label,\n283:     String cameraId,\n284:   ) {\n285:     return CameraTile(\n286:       key: ValueKey<String>('camera-tile-$cameraId'),\n287:       index: index,\n288:       cameraId: cameraId,\n289:       source: _tileSources[cameraId]!,\n290:       focusNode: _focus.nodeAt(index),\n291:       controllerFactory: widget.tileControllerFactory,\n292:       onSourceSettled: (bool success) {\n293:         final Completer<bool>? settle = _sourceSettles[cameraId];\n294:         if (settle != null && !settle.isCompleted) settle.complete(success);\n295:       },\n296:       onInitialSettled: () => _onInitialTileSettled(cameraId),\n297:       autofocus: index == 0,\n298:       onFocusChange: (bool hasFocus) {\n299:         if (hasFocus) {\n300:           _focus.markFocused(index);\n301:         }\n302:       },\n303:     );\n304:   }\n305: \n306:   void _onInitialTileSettled(String cameraId) {\n307:     _initialSettledCameras.add(cameraId);\n308:     // Boot gating waits for the ACTIVE tiles only: reduced layouts start\n309:     // live work once their visible tiles settle, without waiting for\n310:     // unmounted cameras. Failed initial decoders count as settled (tiles\n311:     // report unconditionally, including SIGNAL LOST).\n312:     if (!_liveStarted &&\n313:         _activeCameraIds().every(_initialSettledCameras.contains)) {\n314:       _liveStarted = true;\n315:       widget.liveSession?.start(activate: _activateLiveVersion);\n316:     }\n317:   }\n318: \n319:   Future<void> _bootHandle() async {\n320:     try {\n321:       await _handle.prepare();\n322:     } on Object catch (error) {\n323:       if (!mounted) return;\n324:       setState(() {\n325:         _status = 'OFFLINE VERIFY FAILED · KEEPING CURRENT FEED';\n326:         _recoveryStatus = error.toString();\n327:       });\n328:       return;\n329:     }\n330:     if (!mounted) return;\n331:     try {\n332:       await _handle.activate();\n333:     } on Object catch (error) {\n334:       if (!mounted) return;\n335:       setState(() {\n336:         _status = 'WALL ACTIVATE FAILED · KEEPING CURRENT FEED';\n337:         _recoveryStatus = error.toString();\n338:       });\n339:     }\n340:   }\n341: \n342:   Future<void> _prepareCurrentVersion() =>\n343:       _verifyPlayableSources(_manifest, _mediaByClipId);\n344: \n345:   Future<void> _activateCurrentVersion() async {\n346:     if (!mounted) throw StateError('wall has been disposed');\n347:     _restoreTileFocus();\n348:   }\n349: \n350:   Future<void> _activateLiveVersion(PlaybackSyncSnapshot snapshot) async {\n351:     final PlaybackManifest? manifest = snapshot.manifest;\n352:     if (manifest == null || !snapshot.hasCompleteMedia) {\n353:       throw StateError('live activation requires complete verified media');\n354:     }\n355:     final WallPlaybackHandle staged = WallPlaybackHandle(\n356:       prepareAction: () =>\n357:           _verifyPlayableSources(manifest, snapshot.mediaByClipId),\n358:       activateAction: () =>\n359:           _applyVerifiedVersion(manifest, snapshot.mediaByClipId),\n360:     );\n361:     await staged.prepare();\n362:     await staged.activate();\n363:   }\n364: \n365:   Future<void> _verifyPlayableSources(\n366:     PlaybackManifest manifest,\n367:     Map<String, CachedMedia> mediaByClipId,\n368:   ) async {\n369:     final Future<bool> Function(String path) exists =\n370:         widget.fileExists ?? _realFileExists;\n371:     for (final TileMediaSource source in _sourcesFor(\n372:       manifest,\n373:       mediaByClipId,\n374:     ).values) {\n375:       if (source case LocalFileSource(:final path)) {\n376:         if (!await exists(path)) {\n377:           throw FileSystemException('verified playback file is missing', path);\n378:         }\n379:       }\n380:     }\n381:   }\n382: \n383:   static Future<bool> _realFileExists(String path) => File(path).exists();\n384: \n385:   Map<String, TileMediaSource> _sourcesFor(\n386:     PlaybackManifest manifest,\n387:     Map<String, CachedMedia> mediaByClipId,\n388:   ) {\n389:     // Sources for EVERY received clip: prepare + verify always cover the\n390:     // complete received manifest, even when the display cap hides cameras.\n391:     // Tiles (and their decoders) are built for the active subset only (see\n392:     // _activeSources); what the manifest carries is never filtered here.\n393:     final Map<String, TileMediaSource> sources = <String, TileMediaSource>{};\n394:     for (final ClipDescriptor clip in manifest.clips) {\n395:       final String cameraId = clip.cameraId;\n396:       final CachedMedia? cached = mediaByClipId[clip.id];\n397:       if (cached != null) {\n398:         if (cached.clipId != clip.id ||\n399:             cached.sha256.toLowerCase() != clip.sha256.toLowerCase() ||\n400:             cached.localRef.trim().isEmpty) {\n401:           throw StateError('verified media entry does not match ${clip.id}');\n402:         }\n403:         sources[cameraId] = LocalFileSource(cached.localRef);\n404:         continue;\n405:       }\n406:       if (mediaByClipId.isNotEmpty) {\n407:         throw StateError('committed media is missing ${clip.id}');\n408:       }\n409:       final String? assetPath = assetPathForClip(clip);\n410:       sources[cameraId] = BundledAssetSource(\n411:         assetPath ?? assetPathForCamera(cameraId),\n412:       );\n413:     }\n414:     return sources;\n415:   }\n416: \n417:   /// Narrows full-manifest [sources] to the active tile set.\n418:   ///\n419:   /// Throws when an active camera has no source: an activation that cannot\n420:   /// feed a visible tile must fail and retain the previous usable wall\n421:   /// rather than render a hole.\n422:   Map<String, TileMediaSource> _activeSources(\n423:     Map<String, TileMediaSource> sources,\n424:   ) {\n425:     final List<String> active = _activeCameraIds();\n426:     final Map<String, TileMediaSource> narrowed = <String, TileMediaSource>{};\n427:     for (final String cameraId in active) {\n428:       final TileMediaSource? source = sources[cameraId];\n429:       if (source == null) {\n430:         throw StateError('no verified source for active camera $cameraId');\n431:       }\n432:       narrowed[cameraId] = source;\n433:     }\n434:     return narrowed;\n435:   }\n436: \n437:   Future<void> _applyVerifiedVersion(\n438:     PlaybackManifest manifest,\n439:     Map<String, CachedMedia> mediaByClipId,\n440:   ) async {\n441:     // Staging cannot feed the active tiles: fail BEFORE touching wall state\n442:     // so the previous usable wall is retained untouched.\n443:     final Map<String, TileMediaSource> targetSources = _activeSources(\n444:       _sourcesFor(manifest, mediaByClipId),\n445:     );\n446:     if (!mounted) throw StateError('wall has been disposed');\n447:     final int generation = ++_wallGeneration;\n448:     final Map<String, TileMediaSource> oldSources =\n449:         Map<String, TileMediaSource>.of(_tileSources);\n450:     final List<String> active = _activeCameraIdsFor(manifest);\n451:     final List<String> switched = <String>[];\n452:     try {\n453:       // Source replacement runs for ACTIVE cameras only: obsolete callbacks\n454:       // for unmounted tiles are never awaited (see _selectCameraCount,\n455:       // which completes them immediately). Shared cameras keep their\n456:       // elements by stable cameraId keys and swap feeds in place.\n457:       for (final String cameraId in active) {\n458:         if (generation != _wallGeneration) {\n459:           throw StateError('wall version superseded during activation');\n460:         }\n461:         final TileMediaSource target = targetSources[cameraId]!;\n462:         if (oldSources[cameraId] == target) continue;\n463:         if (!await _replaceTileSource(cameraId, target)) {\n464:           throw StateError('decoder rejected replacement for $cameraId');\n465:         }\n466:         switched.add(cameraId);\n467:       }\n468:     } on Object {\n469:       // Roll back only when no newer version took over meanwhile: a\n470:       // superseded activation must not clobber the newer wall state.\n471:       if (generation == _wallGeneration) {\n472:         for (final String cameraId in switched.reversed) {\n473:           await _replaceTileSource(cameraId, oldSources[cameraId]!);\n474:         }\n475:         if (mounted) setState(() => _tileSources = oldSources);\n476:       }\n477:       rethrow;\n478:     }\n479:     if (generation != _wallGeneration) {\n480:       throw StateError('wall version superseded during activation');\n481:     }\n482:     if (!mounted) throw StateError('wall was disposed during activation');\n483:     setState(() {\n484:       _manifest = manifest;\n485:       _mediaByClipId = Map<String, CachedMedia>.of(mediaByClipId);\n486:       _tileSources = targetSources;\n487:       // The active set may have changed (1/2/4 manifests): reconcile hero\n488:       // and focus geometry against the new wall before it renders.\n489:       _reconcileLayout();\n490:       _status = 'WALL UPDATED · v${manifest.version}';\n491:     });\n492:   }\n493: \n494:   Future<bool> _replaceTileSource(\n495:     String cameraId,\n496:     TileMediaSource source,\n497:   ) async {\n498:     if (_tileSources[cameraId] == source) return true;\n499:     // The camera left the active set (count change / new manifest): nothing\n500:     // to swap — its tile is unmounted and the map no longer carries it.\n501:     if (!_activeCameraIds().contains(cameraId)) return true;\n502:     final int generation = _wallGeneration;\n503:     final Completer<bool> settled = Completer<bool>();\n504:     _sourceSettles[cameraId] = settled;\n505:     setState(() => _tileSources[cameraId] = source);\n506:     await WidgetsBinding.instance.endOfFrame;\n507:     if (generation != _wallGeneration || !mounted) return false;\n508:     try {\n509:       return await settled.future.timeout(widget.sourceSettleTimeout);\n510:     } finally {\n511:       if (identical(_sourceSettles[cameraId], settled)) {\n512:         _sourceSettles.remove(cameraId);\n513:       }\n514:     }\n515:   }\n516: \n517:   /// Builds the resolved channel with this app's surfaces.\n518:   ///\n519:   /// The registry owns the channel (descriptor, profile, clock, glitch\n520:   /// configuration); the app must inject its decoder surfaces\n521:   /// ([CctvTileBuilder]), so a shallow copy preserving the registry\n522:   /// object's configuration is built. Live wall state (effects flag,\n523:   /// effective camera count, hero target, manifest version, overscan\n524:   /// safety) additionally travels via [ChannelContext.settings], which\n525:   /// [HauntedSurveillancePlugin.build] honors — registry object and copy\n526:   /// can never diverge on wall config.\n527:   /// Tile widgets keep stable cameraId-based keys and swap feeds in place\n528:   /// ([CameraTile.didUpdateWidget] disposes before creating), so a cached\n529:   /// retry never transiently doubles the decoder count.\n530:   ChannelPlugin _configuredChannel() {\n531:     final ChannelPlugin resolved = widget.plugin;\n532:     if (resolved is HauntedSurveillancePlugin) {\n533:       return HauntedSurveillancePlugin(\n534:         tileBuilder: _buildTile,\n535:         profile: widget.profile ?? resolved.profile,\n536:         manifest: _manifest,\n537:         clock: widget.clock,\n538:         disableEffects: _effectsDisabled,\n539:         glitchSeed: widget.glitchSeed,\n540:       );\n541:     }\n542:     return resolved;\n543:   }\n544: \n545:   void _openRecovery({bool deferFocus = false}) {\n546:     if (!mounted || _recoveryVisible) {\n547:       return;\n548:     }\n549:     setState(() {\n550:       _recoveryVisible = true;\n551:       _recoveryStatus = null;\n552:     });\n553:     if (deferFocus) {\n554:       // The held key keeps tile focus until its release (see _onWallKey):\n555:       // focusing the panel now would hand auto-repeat arrivals to the\n556:       // focused button and fire its action while still held.\n557:       return;\n558:     }\n559:     // The wall's focus exclusion hands focus back to the scope; pull it onto\n560:     // the first recovery action so a D-pad lands inside the panel.\n561:     WidgetsBinding.instance.addPostFrameCallback((_) {\n562:       if (mounted && _recoveryVisible) {\n563:         _recoveryFocus.requestFocus();\n564:       }\n565:     });\n566:   }\n567: \n568:   /// Opens the host guest-code page.\n569:   ///\n570:   /// Offline builds never reach here (no GUEST CODES button without a\n571:   /// [GuestCodeClient]). The panel owns its authoritative listing refresh\n572:   /// (immediate fetch plus bounded interval); the wall only shows/hides it.\n573:   void _openGuestCodes() {\n574:     final GuestCodeClient? client = widget.guestCodeClient;\n575:     if (!mounted || _guestCodesVisible || client == null) {\n576:       return;\n577:     }\n578:     setState(() {\n579:       _guestCodesVisible = true;\n580:     });\n581:     WidgetsBinding.instance.addPostFrameCallback((_) {\n582:       if (mounted && _guestCodesVisible) {\n583:         _recoveryFocus.requestFocus();\n584:       }\n585:     });\n586:   }\n587: \n588:   /// Returns from the guest-code page to the recovery actions.\n589:   void _closeGuestCodes() {\n590:     setState(() {\n591:       _guestCodesVisible = false;\n592:     });\n593:     WidgetsBinding.instance.addPostFrameCallback((_) {\n594:       if (mounted && _recoveryVisible) {\n595:         _recoveryFocus.requestFocus();\n596:       }\n597:     });\n598:   }\n599: \n600:   /// Opens the host invite (HOST QR) page.\n601:   ///\n602:   /// Offline builds never reach here (no HOST QR button without a\n603:   /// [HostInviteClient]). The panel owns its invite mint (immediate fetch\n604:   /// plus manual REFRESH and an expiry ticker); the wall only shows/hides it.\n605:   void _openHostCodes() {\n606:     final HostInviteClient? client = widget.hostInviteClient;\n607:     if (!mounted || _hostCodesVisible || client == null) {\n608:       return;\n609:     }\n610:     setState(() {\n611:       _hostCodesVisible = true;\n612:     });\n613:     WidgetsBinding.instance.addPostFrameCallback((_) {\n614:       if (mounted && _hostCodesVisible) {\n615:         _recoveryFocus.requestFocus();\n616:       }\n617:     });\n618:   }\n619: \n620:   /// Returns from the host invite page to the recovery actions.\n621:   void _closeHostCodes() {\n622:     setState(() {\n623:       _hostCodesVisible = false;\n624:     });\n625:     WidgetsBinding.instance.addPostFrameCallback((_) {\n626:       if (mounted && _recoveryVisible) {\n627:         _recoveryFocus.requestFocus();\n628:       }\n629:     });\n630:   }\n631: \n632:   void _closeRecovery() {\n633:     setState(() {\n634:       _recoveryVisible = false;\n635:       _guestCodesVisible = false;\n636:       _hostCodesVisible = false;\n637:       _awaitingSelectRelease = false;\n638:       _recoveryStatus = null;\n639:     });\n640:     // D-pad focus returns to the tile the user was watching (in hero, the\n641:     // origin tile keeps focus throughout, so this restores it). Deferred to\n642:     // a post-frame callback: while the overlay is still mounted this frame,\n643:     // ExcludeFocus(excluding: true) rejects a synchronous requestFocus on\n644:     // the wall tiles, so the request must run after the rebuild flips\n645:     // excluding back to false (same path as _restoreTileFocus).\n646:     _restoreTileFocus();\n647:   }\n648: \n649:   /// Reconciles hero + focus geometry against the current active set.\n650:   ///\n651:   /// Must run inside setState after a count change or manifest activation:\n652:   /// settles for unmounted tiles are completed immediately (never waited\n653:   /// on), a hero whose origin camera disappeared exits, and removed focus\n654:   /// is clamped to a valid remaining tile.\n655:   void _reconcileLayout() {\n656:     final List<String> active = _activeCameraIds();\n657:     for (final String cameraId in _sourceSettles.keys.toList()) {\n658:       if (!active.contains(cameraId)) {\n659:         _sourceSettles.remove(cameraId)?.complete(false);\n660:       }\n661:     }\n662:     if (_heroCameraId != null && !active.contains(_heroCameraId)) {\n663:       _heroCameraId = null;\n664:     }\n665:     _focus.setActiveLayout(\n666:       tiles: active.length,\n667:       columns: _columnsFor(active.length),\n668:     );\n669:   }\n670: \n671:   /// Selects the camera display cap from the recovery selector.\n672:   ///\n673:   /// Persists through the existing party-scoped `SettingsPort` string key\n674:   /// ([CctvWallSettingsKeys.cameraCount]) without extending its interface.\n675:   /// Added cameras mount fresh tiles; removed cameras unmount (their\n676:   /// decoders dispose) while shared cameras keep their elements, decoders,\n677:   /// and focus nodes by stable cameraId keys and indices.\n678:   Future<void> _selectCameraCount(int count) async {\n679:     if (!isSupportedCctvClipCount(count) || count == _cameraCount) {\n680:       return;\n681:     }\n682:     final int previous = _cameraCount;\n683:     _cameraCount = count;\n684:     late final Map<String, TileMediaSource> nextSources;\n685:     try {\n686:       nextSources = _activeSources(_sourcesFor(_manifest, _mediaByClipId));\n687:     } on Object {\n688:       _cameraCount = previous;\n689:       if (mounted) {\n690:         setState(() {\n691:           _recoveryStatus = 'Camera layout could not be activated.';\n692:         });\n693:       }\n694:       return;\n695:     }\n696:     if (!mounted) {\n697:       _cameraCount = previous;\n698:       return;\n699:     }\n700:     setState(() {\n701:       _wallGeneration++;\n702:       _tileSources = nextSources;\n703:       _reconcileLayout();\n704:     });\n705:     final SettingsPort? settings = widget.settings;\n706:     if (settings != null) {\n707:       unawaited(\n708:         settings.setString(\n709:           partyId: PartyId(widget.partyId),\n710:           key: CctvWallSettingsKeys.cameraCount,\n711:           value: '$count',\n712:         ),\n713:       );\n714:     }\n715:   }\n716: \n717:   /// Toggles the decoder-preserving camera hero for the focused tile.\n718:   ///\n719:   /// Opening animates the selected EXISTING tile to the viewport rectangle\n720:   /// and fades its siblings; every CameraTile stays mounted, so no decoder\n721:   /// is created or disposed during the zoom.\n722:   void _toggleHero() {\n723:     if (_heroCameraId != null) {\n724:       _closeHero();\n725:       return;\n726:     }\n727:     final List<String> active = _activeCameraIds();\n728:     if (active.isEmpty) {\n729:       return;\n730:     }\n731:     int index = _focus.focusedIndex;\n732:     if (index < 0 || index >= active.length) {\n733:       index = 0;\n734:     }\n735:     setState(() {\n736:       _heroCameraId = active[index];\n737:       _heroOriginIndex = index;\n738:     });\n739:   }\n740: \n741:   /// Exits the hero and restores the originating focus.\n742:   void _closeHero() {\n743:     if (_heroCameraId == null) {\n744:       return;\n745:     }\n746:     final int origin = _heroOriginIndex;\n747:     setState(() {\n748:       _heroCameraId = null;\n749:     });\n750:     // Restore the ORIGIN explicitly (not just \"current focus\"): nothing\n751:     // traverses in hero, but this guards against any stale focus index.\n752:     _focus.markFocused(origin);\n753:     _restoreTileFocus();\n754:   }\n755: \n756:   Future<void> _retryCached() async {\n757:     final Future<VerifiedWallPlayback?> Function()? retryPlayback =\n758:         widget.onRetryCachedPlayback;\n759:     // A count change or newer activation supersedes this retry: its failure\n760:     // UI must not clobber the newer wall state.\n761:     final int generation = _wallGeneration;\n762:     if (retryPlayback != null) {\n763:       VerifiedWallPlayback? restored;\n764:       try {\n765:         restored = await retryPlayback();\n766:       } on Object {\n767:         restored = null;\n768:       }\n769:       if (restored != null) {\n770:         try {\n771:           await _activateLiveVersion(\n772:             PlaybackSyncSnapshot(\n773:               state: PlaybackSyncState.ready,\n774:               manifest: restored.manifest,\n775:               mediaByClipId: restored.mediaByClipId,\n776:             ),\n777:           );\n778:         } on Object {\n779:           if (mounted && generation == _wallGeneration) {\n780:             setState(() {\n781:               _recoveryStatus = 'Cached media could not be activated.';\n782:               _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n783:             });\n784:           }\n785:           return;\n786:         }\n787:         if (!mounted) return;\n788:         setState(() {\n789:           _recoveryVisible = false;\n790:           _recoveryStatus = null;\n791:         });\n792:         _restoreTileFocus();\n793:         return;\n794:       }\n795:     }\n796:     final Future<PlaybackManifest?> Function()? retry = widget.onRetryCached;\n797:     PlaybackManifest? reloaded;\n798:     if (retry != null) {\n799:       try {\n800:         reloaded = await retry();\n801:       } catch (_) {\n802:         reloaded = null;\n803:       }\n804:     }\n805:     if (!mounted) {\n806:       return;\n807:     }\n808:     if (reloaded == null) {\n809:       setState(() {\n810:         _recoveryStatus = 'No cached wall stored yet.';\n811:         _status = 'NO CACHED WALL · KEEPING CURRENT FEED';\n812:       });\n813:       return;\n814:     }\n815:     final PlaybackManifest restored = reloaded;\n816:     try {\n817:       await _applyVerifiedVersion(restored, const <String, CachedMedia>{});\n818:     } on Object {\n819:       if (mounted && generation == _wallGeneration) {\n820:         setState(() {\n821:           _recoveryStatus = 'Cached wall could not be activated.';\n822:           _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n823:         });\n824:       }\n825:       return;\n826:     }\n827:     if (mounted) {\n828:       setState(() {\n829:         _recoveryVisible = false;\n830:         _recoveryStatus = null;\n831:         _status = 'WALL RESTORED · v${restored.version}';\n832:       });\n833:       _restoreTileFocus();\n834:     }\n835:   }\n836: \n837:   void _toggleEffects() {\n838:     final bool value = !_effectsDisabled;\n839:     setState(() {\n840:       _effectsDisabled = value;\n841:       _status = _effectsDisabled ? 'EFFECTS DISABLED' : 'EFFECTS ENABLED';\n842:     });\n843:     final SettingsPort? settings = widget.settings;\n844:     if (settings != null) {\n845:       unawaited(\n846:         settings.setBool(\n847:           partyId: PartyId(widget.partyId),\n848:           key: CctvWallSettingsKeys.effectsDisabled,\n849:           value: value,\n850:         ),\n851:       );\n852:     }\n853:   }\n854: \n855:   void _restoreTileFocus() {\n856:     WidgetsBinding.instance.addPostFrameCallback((_) {\n857:       if (!mounted) {\n858:         return;\n859:       }\n860:       final int index = _focus.focusedIndex;\n861:       _focus.focusTile(index < 0 ? 0 : index);\n862:     });\n863:   }\n864: \n865:   bool _isSelectKey(LogicalKeyboardKey key) =>\n866:       key == LogicalKeyboardKey.select ||\n867:       key == LogicalKeyboardKey.enter ||\n868:       key == LogicalKeyboardKey.gameButtonA ||\n869:       key == LogicalKeyboardKey.space;\n870: \n871:   bool _isBackKey(LogicalKeyboardKey key) =>\n872:       key == LogicalKeyboardKey.backspace ||\n873:       key == LogicalKeyboardKey.goBack ||\n874:       key == LogicalKeyboardKey.escape ||\n875:       key == LogicalKeyboardKey.gameButtonB;\n876: \n877:   KeyEventResult _onWallKey(FocusNode node, KeyEvent event) {\n878:     // Short release of select/enter/gameButtonA opens the hero; BACK keys\n879:     // (backspace/escape/gameButtonB) restore the grid and originating focus.\n880:     // A held select opens recovery once (deferred panel focus keeps its\n881:     // release from triggering the hero or a recovery action); hold repeats\n882:     // are swallowed. Grid traversal is suppressed in hero, and hero stays\n883:     // available when recovery is disabled.\n884:     if (event is KeyRepeatEvent) {\n885:       return KeyEventResult.handled;\n886:     }\n887:     if (event is KeyDownEvent) {\n888:       if (event.logicalKey == LogicalKeyboardKey.contextMenu ||\n889:           event.logicalKey == LogicalKeyboardKey.gameButtonStart) {\n890:         if (widget.recoveryEnabled) {\n891:           _openRecovery();\n892:         }\n893:         return KeyEventResult.handled;\n894:       }\n895:       if (_isBackKey(event.logicalKey)) {\n896:         if (_recoveryVisible || _guestCodesVisible || _hostCodesVisible) {\n897:           // A panel owns BACK semantics once visible; tile-side input is\n898:           // vestigial until the held key (if any) is released.\n899:           return KeyEventResult.handled;\n900:         }\n901:         if (_heroCameraId != null) {\n902:           _closeHero();\n903:           return KeyEventResult.handled;\n904:         }\n905:         return KeyEventResult.ignored;\n906:       }\n907:       if (_isSelectKey(event.logicalKey)) {\n908:         if (!_selectHeld) {\n909:           _selectHeld = true;\n910:           _selectDownAt = widget.clock.now();\n911:           _holdFired = false;\n912:           if (widget.recoveryEnabled) {\n913:             _okHoldTimer?.cancel();\n914:             _okHoldTimer = Timer(widget.longPressDuration, () {\n915:               _okHoldTimer = null;\n916:               if (!mounted) {\n917:                 return;\n918:               }\n919:               _holdFired = true;\n920:               final bool wasVisible = _recoveryVisible;\n921:               _openRecovery(deferFocus: true);\n922:               if (_recoveryVisible && !wasVisible) {\n923:                 _awaitingSelectRelease = true;\n924:               }\n925:             });\n926:           }\n927:         }\n928:         return KeyEventResult.handled;\n929:       }\n930:       if (_heroCameraId != null ||\n931:           _recoveryVisible ||\n932:           _guestCodesVisible ||\n933:           _hostCodesVisible) {\n934:         return KeyEventResult.handled;\n935:       }\n936:       if (_focus.handleArrow(event.logicalKey)) {\n937:         return KeyEventResult.handled;\n938:       }\n939:       return KeyEventResult.ignored;\n940:     }\n941:     if (event is KeyUpEvent && _isSelectKey(event.logicalKey)) {\n942:       _selectHeld = false;\n943:       _okHoldTimer?.cancel();\n944:       _okHoldTimer = null;\n945:       if (!mounted) {\n946:         return KeyEventResult.handled;\n947:       }\n948:       if (_awaitingSelectRelease) {\n949:         // Held select that opened recovery: the release focuses the panel\n950:         // and can never trigger the hero or a recovery action.\n951:         _awaitingSelectRelease = false;\n952:         _holdFired = false;\n953:         _selectDownAt = null;\n954:         if (_recoveryVisible) {\n955:           _recoveryFocus.requestFocus();\n956:         }\n957:         return KeyEventResult.handled;\n958:       }\n959:       if (_holdFired) {\n960:         _holdFired = false;\n961:         _selectDownAt = null;\n962:         return KeyEventResult.handled;\n963:       }\n964:       if (_recoveryVisible || _guestCodesVisible || _hostCodesVisible) {\n965:         _selectDownAt = null;\n966:         return KeyEventResult.handled;\n967:       }\n968:       final DateTime? downAt = _selectDownAt;\n969:       _selectDownAt = null;\n970:       // Held past the long-press threshold without recovery (disabled):\n971:       // a held select is never a hero open.\n972:       if (downAt != null &&\n973:           widget.clock.now().difference(downAt) >= widget.longPressDuration) {\n974:         return KeyEventResult.handled;\n975:       }\n976:       _toggleHero();\n977:       return KeyEventResult.handled;\n978:     }\n979:     return KeyEventResult.ignored;\n980:   }\n981: \n982:   @override\n983:   Widget build(BuildContext context) {\n984:     final ChannelPlugin channel = _configuredChannel();\n985:     final ChannelContext channelContext = ChannelContext(\n986:       partyId: PartyId(widget.partyId),\n987:       playbackHandle: _handle,\n988:       // Wall config travels through the channel contract so\n989:       // HauntedSurveillancePlugin.build applies it without the host\n990:       // discarding the registry object. The camera count is the EFFECTIVE\n991:       // display cap (`min(configured, manifest clips)`); the hero target is\n992:       // transient UI state, never persisted.\n993:       settings: ChannelSettings(<String, Object?>{\n994:         CctvWallSettingsKeys.effectsDisabled: _effectsDisabled,\n995:         CctvWallSettingsKeys.manifestVersion: _manifest.version,\n996:         CctvWallSettingsKeys.overscanSafe: true,\n997:         CctvWallSettingsKeys.cameraCount: '$_effectiveCount',\n998:         if (_heroCameraId != null)\n999:           CctvWallSettingsKeys.heroCameraId: _heroCameraId!,\n1000:       }),\n1001:     );\n1002: \n1003:     return FocusTraversalGroup(\n1004:       child: Stack(\n1005:         fit: StackFit.expand,\n1006:         children: <Widget>[\n1007:           // Key gate: arrows move tile focus, OK long-press / MENU opens\n1008:           // recovery. `canRequestFocus: false` keeps tile 0 the entry point.\n1009:           ExcludeFocus(\n1010:             excluding: _recoveryVisible,\n1011:             child: Focus(\n1012:               canRequestFocus: false,\n1013:               skipTraversal: true,\n1014:               onKeyEvent: _onWallKey,\n1015:               child: SafeArea(\n1016:                 minimum: widget.overscanPadding,\n1017:                 // Stable key: tiles keep cameraId-based keys across retries\n1018:                 // and swap feeds in place instead of remounting (which would\n1019:                 // transiently double the decoder count).\n1020:                 child: KeyedSubtree(\n1021:                   key: ValueKey<String>('wall-${widget.partyId}'),\n1022:                   child: channel.build(channelContext),\n1023:                 ),\n1024:               ),\n1025:             ),\n1026:           ),\n1027:           if (_status != null)\n1028:             Positioned(\n1029:               left: 24,\n1030:               right: 24,\n1031:               bottom: 20,\n1032:               child: IgnorePointer(\n1033:                 child: Container(\n1034:                   key: kWallStatusBannerKey,\n1035:                   padding: const EdgeInsets.symmetric(\n1036:                     horizontal: 16,\n1037:                     vertical: 10,\n1038:                   ),\n1039:                   color: const Color(0xCC000000),\n1040:                   child: Text(_status!, style: CctvTheme.badgeStyle),\n1041:                 ),\n1042:               ),\n1043:             ),\n1044:           if (_recoveryVisible)\n1045:             Positioned.fill(\n1046:               child: KeyedSubtree(\n1047:                 key: kRecoveryOverlayKey,\n1048:                 child: _guestCodesVisible\n1049:                     ? GuestCodePanel(\n1050:                         client: widget.guestCodeClient!,\n1051:                         tvDeviceId: widget.tvDeviceId,\n1052:                         primaryFocusNode: _recoveryFocus,\n1053:                         onBack: _closeGuestCodes,\n1054:                         onClose: _closeRecovery,\n1055:                       )\n1056:                     : _hostCodesVisible\n1057:                     ? HostCodePanel(\n1058:                         client: widget.hostInviteClient!,\n1059:                         primaryFocusNode: _recoveryFocus,\n1060:                         onBack: _closeHostCodes,\n1061:                         onClose: _closeRecovery,\n1062:                       )\n1063:                     : RecoveryOverlay(\n1064:                         effectsDisabled: _effectsDisabled,\n1065:                         statusMessage: _recoveryStatus,\n1066:                         primaryFocusNode: _recoveryFocus,\n1067:                         onRetryCached: () => unawaited(_retryCached()),\n1068:                         onToggleEffects: _toggleEffects,\n1069:                         onClose: _closeRecovery,\n1070:                         cameraCount: _cameraCount,\n1071:                         onSelectCameraCount: _selectCameraCount,\n1072:                         onShowGuestCodes: widget.guestCodeClient == null\n1073:                             ? null\n1074:                             : _openGuestCodes,\n1075:                         onShowHostCodes: widget.hostInviteClient == null\n1076:                             ? null\n1077:                             : _openHostCodes,\n1078:                       ),\n1079:               ),\n1080:             ),\n1081:         ],\n1082:       ),\n1083:     );\n1084:   }\n1085: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/wall_screen.dart, lines 1-1085\n1: /// Hosts the haunted-surveillance channel wall for one party.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:io';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_cache/core_cache.dart';\n9: import 'package:core_effects/core_effects.dart';\n10: import 'package:core_foundation/core_foundation.dart';\n11: import 'package:core_playlist/core_playlist.dart';\n12: import 'package:core_ui/core_ui.dart';\n13: import 'package:flutter/material.dart';\n14: import 'package:flutter/services.dart';\n15: import 'package:kernel_app/kernel_app.dart';\n16: import 'package:tv_app/src/media/feed_assets.dart';\n17: import 'package:tv_app/src/playback/camera_tile.dart';\n18: import 'package:tv_app/src/playback/tile_video_controller.dart';\n19: import 'package:tv_app/src/wall/guest_code_panel.dart';\n20: import 'package:tv_app/src/wall/guest_codes.dart';\n21: import 'package:tv_app/src/wall/host_code_panel.dart';\n22: import 'package:tv_app/src/wall/host_codes.dart';\n23: import 'package:tv_app/src/wall/live_wall_session.dart';\n24: import 'package:tv_app/src/wall/playback_handle.dart';\n25: import 'package:tv_app/src/wall/recovery_overlay.dart';\n26: import 'package:tv_app/src/wall/wall_boot.dart';\n27: import 'package:tv_app/src/wall/wall_focus.dart';\n28: \n29: /// Key of the status banner shown above the wall after recovery actions.\n30: const Key kWallStatusBannerKey = ValueKey<String>('wall-status-banner');\n31: \n32: /// Key of the hidden recovery panel.\n33: const Key kRecoveryOverlayKey = ValueKey<String>('recovery-overlay');\n34: \n35: /// Resolved channel + manifest rendered full-screen on the TV.\n36: ///\n37: /// Responsibilities kept in the app (design s4/s13):\n38: ///  * owns one [CameraTile] (hence one video decoder) per ACTIVE wall slot\n39: ///    (the 1/2/4 display cap never filters prepare/verify/ACK, which always\n40: ///    cover the complete received manifest),\n41: ///  * D-pad focus traversal between the active tiles (suppressed in hero),\n42: ///  * decoder-preserving camera hero (short OK release zooms, BACK\n43: ///    restores), available even when recovery is disabled,\n44: ///  * hidden recovery panel (OK long-press / MENU) with \"retry cached wall\",\n45: ///    \"disable effects\", a D-pad-operable 1/2/4 camera selector, and the\n46: ///    separately labelled HOST QR + GUEST CODES destinations,\n47: ///  * overscan-safe padding and an app-level status line.\n48: ///\n49: /// Channel chrome (HUD, scanlines/vignette, glitch, SIGNAL LOST frame) comes\n50: /// from `channel_cctv` + `core_ui` + `core_effects`; the app supplies the\n51: /// video surfaces through [HauntedSurveillancePlugin.tileBuilder]. Wall\n52: /// configuration (effects flag, camera count, hero target, manifest\n53: /// version, overscan safety) travels via [ChannelContext.settings], which\n54: /// [HauntedSurveillancePlugin.build] honors.\n55: class WallScreen extends StatefulWidget {\n56:   /// Creates the wall host.\n57:   const WallScreen({\n58:     super.key,\n59:     required this.plugin,\n60:     required this.manifest,\n61:     required this.tileControllerFactory,\n62:     required this.clock,\n63:     this.mediaByClipId = const <String, CachedMedia>{},\n64:     this.liveSession,\n65:     this.settings,\n66:     this.profile,\n67:     this.partyId = 'local-party',\n68:     this.tvDeviceId = '',\n69:     this.channelId = hauntedSurveillanceChannelId,\n70:     this.guestCodeClient,\n71:     this.glitchSeed = 0x4A11,\n72:     this.onRetryCached,\n73:     this.onRetryCachedPlayback,\n74:     this.fileExists,\n75:     this.recoveryEnabled = true,\n76:     this.initialEffectsDisabled = false,\n77:     this.initialCameraCount = kDefaultCctvClipCount,\n78:     this.hostInviteClient,\n79:     this.overscanPadding = const EdgeInsets.symmetric(\n80:       horizontal: 28,\n81:       vertical: 18,\n82:     ),\n83:     this.longPressDuration = const Duration(milliseconds: 600),\n84:     this.sourceSettleTimeout = const Duration(seconds: 15),\n85:   });\n86: \n87:   /// Channel plugin resolved from the kernel registry.\n88:   final ChannelPlugin plugin;\n89: \n90:   /// Wall manifest driving camera slots.\n91:   final PlaybackManifest manifest;\n92: \n93:   /// Builds one decoder per tile.\n94:   final TileVideoControllerFactory tileControllerFactory;\n95: \n96:   /// Clock used by the tile HUDs (injectable for deterministic tests).\n97:   final Clock clock;\n98: \n99:   /// Verified committed files keyed by manifest clip id.\n100:   final Map<String, CachedMedia> mediaByClipId;\n101: \n102:   /// Live subscription started after offline rendering.\n103:   final LiveWallSession? liveSession;\n104: \n105:   /// Party-scoped persistent settings.\n106:   final SettingsPort? settings;\n107: \n108:   /// Effect profile for tile overlays; defaults to [cctvProfile].\n109:   final EffectProfile? profile;\n110: \n111:   /// Party this wall belongs to.\n112:   final String partyId;\n113: \n114:   /// TV's own device code, shown on the host guest-code page.\n115:   final String tvDeviceId;\n116: \n117:   /// Active channel for the guest-code join payload.\n118:   final String channelId;\n119: \n120:   /// Host guest-code reader; null keeps the recovery panel on its actions\n121:   /// only (offline builds never list codes).\n122:   final GuestCodeClient? guestCodeClient;\n123: \n124:   /// Host-invite minter for the HOST QR destination; null hides the HOST QR\n125:   /// button (offline builds stay on the recovery actions only).\n126:   final HostInviteClient? hostInviteClient;\n127: \n128:   /// Seed for the wall's deterministic glitch bursts.\n129:   final int glitchSeed;\n130: \n131:   /// Reloads the last cached manifest; null result means \"nothing cached\".\n132:   final Future<PlaybackManifest?> Function()? onRetryCached;\n133: \n134:   /// Re-verifies the durable remote index without interrupting live work.\n135:   final Future<VerifiedWallPlayback?> Function()? onRetryCachedPlayback;\n136: \n137:   /// Existence check for verified local files.\n138:   ///\n139:   /// Defaults to real `File(path).exists()`. Injectable because `testWidgets`\n140:   /// bodies run in a FakeAsync zone where real dart:io never completes;\n141:   /// production passes nothing and keeps the real filesystem check.\n142:   final Future<bool> Function(String path)? fileExists;\n143: \n144:   /// Whether OK long-press / MENU reveals the recovery panel.\n145:   final bool recoveryEnabled;\n146: \n147:   /// Starts with effect overlays dropped.\n148:   final bool initialEffectsDisabled;\n149: \n150:   /// Restored party-scoped camera display cap (1, 2, or 4; see\n151:   /// [CctvWallSettingsKeys.cameraCount]). Unsupported values degrade to 4.\n152:   /// Passed through [WallGate] from the boot-time settings restore, before\n153:   /// wall construction.\n154:   final int initialCameraCount;\n155: \n156:   /// Extra padding keeping HUD text inside the TV's overscan-safe area.\n157:   final EdgeInsets overscanPadding;\n158: \n159:   /// How long OK must be held to reveal the recovery panel.\n160:   final Duration longPressDuration;\n161: \n162:   /// Bound for one tile source replacement to settle.\n163:   ///\n164:   /// Defaults to 15s. Injectable so tests do not stall real seconds on\n165:   /// decoder failure and prod can tune it alongside other timeouts.\n166:   final Duration sourceSettleTimeout;\n167: \n168:   @override\n169:   State<WallScreen> createState() => _WallScreenState();\n170: }\n171: \n172: class _WallScreenState extends State<WallScreen> {\n173:   late final WallFocusController _focus;\n174:   late final WallPlaybackHandle _handle;\n175: \n176:   late PlaybackManifest _manifest;\n177:   late Map<String, CachedMedia> _mediaByClipId;\n178:   late Map<String, TileMediaSource> _tileSources;\n179:   final Map<String, Completer<bool>> _sourceSettles =\n180:       <String, Completer<bool>>{};\n181:   final Set<String> _initialSettledCameras = <String>{};\n182:   bool _liveStarted = false;\n183:   late bool _effectsDisabled;\n184:   late int _cameraCount;\n185:   String? _heroCameraId;\n186:   int _heroOriginIndex = 0;\n187:   bool _recoveryVisible = false;\n188:   bool _guestCodesVisible = false;\n189:   bool _hostCodesVisible = false;\n190:   bool _selectHeld = false;\n191:   DateTime? _selectDownAt;\n192:   bool _holdFired = false;\n193:   bool _awaitingSelectRelease = false;\n194:   int _wallGeneration = 0;\n195:   bool _activatedHandle = false;\n196:   String? _status;\n197:   String? _recoveryStatus;\n198:   Timer? _okHoldTimer;\n199:   final FocusNode _recoveryFocus = FocusNode(debugLabel: 'recovery-primary');\n200: \n201:   @override\n202:   void initState() {\n203:     super.initState();\n204:     _focus = WallFocusController();\n205:     _manifest = widget.manifest;\n206:     _mediaByClipId = Map<String, CachedMedia>.of(widget.mediaByClipId);\n207:     _cameraCount = _sanitizeCameraCount(widget.initialCameraCount);\n208:     _focus.setActiveLayout(\n209:       tiles: _effectiveCount,\n210:       columns: _columnsFor(_effectiveCount),\n211:     );\n212:     _tileSources = _activeSources(_sourcesFor(_manifest, _mediaByClipId));\n213:     _effectsDisabled = widget.initialEffectsDisabled;\n214:     _handle = WallPlaybackHandle(\n215:       prepareAction: _prepareCurrentVersion,\n216:       activateAction: _activateCurrentVersion,\n217:     );\n218:     WidgetsBinding.instance.addPostFrameCallback((_) {\n219:       if (!mounted || _activatedHandle) {\n220:         return;\n221:       }\n222:       _activatedHandle = true;\n223:       unawaited(_bootHandle());\n224:     });\n225:   }\n226: \n227:   @override\n228:   void dispose() {\n229:     _okHoldTimer?.cancel();\n230:     _recoveryFocus.dispose();\n231:     _focus.dispose();\n232:     for (final Completer<bool> settle in _sourceSettles.values) {\n233:       if (!settle.isCompleted) settle.complete(false);\n234:     }\n235:     _sourceSettles.clear();\n236:     final LiveWallSession? session = widget.liveSession;\n237:     if (session != null) unawaited(session.dispose());\n238:     super.dispose();\n239:   }\n240: \n241:   /// Sanitizes a restored setting to a supported display cap (1, 2, or 4).\n242:   static int _sanitizeCameraCount(int value) =>\n243:       isSupportedCctvClipCount(value) ? value : kDefaultCctvClipCount;\n244: \n245:   /// Grid width for a tile count: 1 column for a single tile, 2 otherwise\n246:   /// (two side-by-side tiles share one row; four tiles form the 2x2 grid).\n247:   static int _columnsFor(int count) => count == 1 ? 1 : 2;\n248: \n249:   /// Rendered tile count: `min(configuredCount, manifest clips)`.\n250:   ///\n251:   /// The setting is a DISPLAY CAP only — it hides cameras, never filters\n252:   /// prepare/verify/ACK, which always cover the complete received manifest.\n253:   int get _effectiveCount => cctvEffectiveCount(\n254:     configuredCount: _cameraCount,\n255:     manifestClipCount: _manifest.clips.length,\n256:   );\n257: \n258:   /// Active camera ids in canonical wall order (the first-N slots).\n259:   ///\n260:   /// Because supported layouts are always a prefix of the canonical slots,\n261:   /// indices stay stable across count changes and shared cameras keep their\n262:   /// elements, decoders, and focus nodes.\n263:   List<String> _activeCameraIds() => <String>[\n264:     for (final CctvSlot slot in cctvSlots.take(_effectiveCount)) slot.id,\n265:   ];\n266: \n267:   /// Active camera ids for an incoming manifest (used before it is applied).\n268:   List<String> _activeCameraIdsFor(PlaybackManifest manifest) {\n269:     final int effective = cctvEffectiveCount(\n270:       configuredCount: _cameraCount,\n271:       manifestClipCount: manifest.clips.length,\n272:     );\n273:     return <String>[\n274:       for (final CctvSlot slot in cctvSlots.take(effective)) slot.id,\n275:     ];\n276:   }\n277: \n278:   /// Wall slot builder: app-owned player lifecycle per tile.\n279:   Widget _buildTile(\n280:     BuildContext context,\n281:     int index,\n282:     String label,\n283:     String cameraId,\n284:   ) {\n285:     return CameraTile(\n286:       key: ValueKey<String>('camera-tile-$cameraId'),\n287:       index: index,\n288:       cameraId: cameraId,\n289:       source: _tileSources[cameraId]!,\n290:       focusNode: _focus.nodeAt(index),\n291:       controllerFactory: widget.tileControllerFactory,\n292:       onSourceSettled: (bool success) {\n293:         final Completer<bool>? settle = _sourceSettles[cameraId];\n294:         if (settle != null && !settle.isCompleted) settle.complete(success);\n295:       },\n296:       onInitialSettled: () => _onInitialTileSettled(cameraId),\n297:       autofocus: index == 0,\n298:       onFocusChange: (bool hasFocus) {\n299:         if (hasFocus) {\n300:           _focus.markFocused(index);\n301:         }\n302:       },\n303:     );\n304:   }\n305: \n306:   void _onInitialTileSettled(String cameraId) {\n307:     _initialSettledCameras.add(cameraId);\n308:     // Boot gating waits for the ACTIVE tiles only: reduced layouts start\n309:     // live work once their visible tiles settle, without waiting for\n310:     // unmounted cameras. Failed initial decoders count as settled (tiles\n311:     // report unconditionally, including SIGNAL LOST).\n312:     if (!_liveStarted &&\n313:         _activeCameraIds().every(_initialSettledCameras.contains)) {\n314:       _liveStarted = true;\n315:       widget.liveSession?.start(activate: _activateLiveVersion);\n316:     }\n317:   }\n318: \n319:   Future<void> _bootHandle() async {\n320:     try {\n321:       await _handle.prepare();\n322:     } on Object catch (error) {\n323:       if (!mounted) return;\n324:       setState(() {\n325:         _status = 'OFFLINE VERIFY FAILED · KEEPING CURRENT FEED';\n326:         _recoveryStatus = error.toString();\n327:       });\n328:       return;\n329:     }\n330:     if (!mounted) return;\n331:     try {\n332:       await _handle.activate();\n333:     } on Object catch (error) {\n334:       if (!mounted) return;\n335:       setState(() {\n336:         _status = 'WALL ACTIVATE FAILED · KEEPING CURRENT FEED';\n337:         _recoveryStatus = error.toString();\n338:       });\n339:     }\n340:   }\n341: \n342:   Future<void> _prepareCurrentVersion() =>\n343:       _verifyPlayableSources(_manifest, _mediaByClipId);\n344: \n345:   Future<void> _activateCurrentVersion() async {\n346:     if (!mounted) throw StateError('wall has been disposed');\n347:     _restoreTileFocus();\n348:   }\n349: \n350:   Future<void> _activateLiveVersion(PlaybackSyncSnapshot snapshot) async {\n351:     final PlaybackManifest? manifest = snapshot.manifest;\n352:     if (manifest == null || !snapshot.hasCompleteMedia) {\n353:       throw StateError('live activation requires complete verified media');\n354:     }\n355:     final WallPlaybackHandle staged = WallPlaybackHandle(\n356:       prepareAction: () =>\n357:           _verifyPlayableSources(manifest, snapshot.mediaByClipId),\n358:       activateAction: () =>\n359:           _applyVerifiedVersion(manifest, snapshot.mediaByClipId),\n360:     );\n361:     await staged.prepare();\n362:     await staged.activate();\n363:   }\n364: \n365:   Future<void> _verifyPlayableSources(\n366:     PlaybackManifest manifest,\n367:     Map<String, CachedMedia> mediaByClipId,\n368:   ) async {\n369:     final Future<bool> Function(String path) exists =\n370:         widget.fileExists ?? _realFileExists;\n371:     for (final TileMediaSource source in _sourcesFor(\n372:       manifest,\n373:       mediaByClipId,\n374:     ).values) {\n375:       if (source case LocalFileSource(:final path)) {\n376:         if (!await exists(path)) {\n377:           throw FileSystemException('verified playback file is missing', path);\n378:         }\n379:       }\n380:     }\n381:   }\n382: \n383:   static Future<bool> _realFileExists(String path) => File(path).exists();\n384: \n385:   Map<String, TileMediaSource> _sourcesFor(\n386:     PlaybackManifest manifest,\n387:     Map<String, CachedMedia> mediaByClipId,\n388:   ) {\n389:     // Sources for EVERY received clip: prepare + verify always cover the\n390:     // complete received manifest, even when the display cap hides cameras.\n391:     // Tiles (and their decoders) are built for the active subset only (see\n392:     // _activeSources); what the manifest carries is never filtered here.\n393:     final Map<String, TileMediaSource> sources = <String, TileMediaSource>{};\n394:     for (final ClipDescriptor clip in manifest.clips) {\n395:       final String cameraId = clip.cameraId;\n396:       final CachedMedia? cached = mediaByClipId[clip.id];\n397:       if (cached != null) {\n398:         if (cached.clipId != clip.id ||\n399:             cached.sha256.toLowerCase() != clip.sha256.toLowerCase() ||\n400:             cached.localRef.trim().isEmpty) {\n401:           throw StateError('verified media entry does not match ${clip.id}');\n402:         }\n403:         sources[cameraId] = LocalFileSource(cached.localRef);\n404:         continue;\n405:       }\n406:       if (mediaByClipId.isNotEmpty) {\n407:         throw StateError('committed media is missing ${clip.id}');\n408:       }\n409:       final String? assetPath = assetPathForClip(clip);\n410:       sources[cameraId] = BundledAssetSource(\n411:         assetPath ?? assetPathForCamera(cameraId),\n412:       );\n413:     }\n414:     return sources;\n415:   }\n416: \n417:   /// Narrows full-manifest [sources] to the active tile set.\n418:   ///\n419:   /// Throws when an active camera has no source: an activation that cannot\n420:   /// feed a visible tile must fail and retain the previous usable wall\n421:   /// rather than render a hole.\n422:   Map<String, TileMediaSource> _activeSources(\n423:     Map<String, TileMediaSource> sources,\n424:   ) {\n425:     final List<String> active = _activeCameraIds();\n426:     final Map<String, TileMediaSource> narrowed = <String, TileMediaSource>{};\n427:     for (final String cameraId in active) {\n428:       final TileMediaSource? source = sources[cameraId];\n429:       if (source == null) {\n430:         throw StateError('no verified source for active camera $cameraId');\n431:       }\n432:       narrowed[cameraId] = source;\n433:     }\n434:     return narrowed;\n435:   }\n436: \n437:   Future<void> _applyVerifiedVersion(\n438:     PlaybackManifest manifest,\n439:     Map<String, CachedMedia> mediaByClipId,\n440:   ) async {\n441:     // Staging cannot feed the active tiles: fail BEFORE touching wall state\n442:     // so the previous usable wall is retained untouched.\n443:     final Map<String, TileMediaSource> targetSources = _activeSources(\n444:       _sourcesFor(manifest, mediaByClipId),\n445:     );\n446:     if (!mounted) throw StateError('wall has been disposed');\n447:     final int generation = ++_wallGeneration;\n448:     final Map<String, TileMediaSource> oldSources =\n449:         Map<String, TileMediaSource>.of(_tileSources);\n450:     final List<String> active = _activeCameraIdsFor(manifest);\n451:     final List<String> switched = <String>[];\n452:     try {\n453:       // Source replacement runs for ACTIVE cameras only: obsolete callbacks\n454:       // for unmounted tiles are never awaited (see _selectCameraCount,\n455:       // which completes them immediately). Shared cameras keep their\n456:       // elements by stable cameraId keys and swap feeds in place.\n457:       for (final String cameraId in active) {\n458:         if (generation != _wallGeneration) {\n459:           throw StateError('wall version superseded during activation');\n460:         }\n461:         final TileMediaSource target = targetSources[cameraId]!;\n462:         if (oldSources[cameraId] == target) continue;\n463:         if (!await _replaceTileSource(cameraId, target)) {\n464:           throw StateError('decoder rejected replacement for $cameraId');\n465:         }\n466:         switched.add(cameraId);\n467:       }\n468:     } on Object {\n469:       // Roll back only when no newer version took over meanwhile: a\n470:       // superseded activation must not clobber the newer wall state.\n471:       if (generation == _wallGeneration) {\n472:         for (final String cameraId in switched.reversed) {\n473:           await _replaceTileSource(cameraId, oldSources[cameraId]!);\n474:         }\n475:         if (mounted) setState(() => _tileSources = oldSources);\n476:       }\n477:       rethrow;\n478:     }\n479:     if (generation != _wallGeneration) {\n480:       throw StateError('wall version superseded during activation');\n481:     }\n482:     if (!mounted) throw StateError('wall was disposed during activation');\n483:     setState(() {\n484:       _manifest = manifest;\n485:       _mediaByClipId = Map<String, CachedMedia>.of(mediaByClipId);\n486:       _tileSources = targetSources;\n487:       // The active set may have changed (1/2/4 manifests): reconcile hero\n488:       // and focus geometry against the new wall before it renders.\n489:       _reconcileLayout();\n490:       _status = 'WALL UPDATED · v${manifest.version}';\n491:     });\n492:   }\n493: \n494:   Future<bool> _replaceTileSource(\n495:     String cameraId,\n496:     TileMediaSource source,\n497:   ) async {\n498:     if (_tileSources[cameraId] == source) return true;\n499:     // The camera left the active set (count change / new manifest): nothing\n500:     // to swap — its tile is unmounted and the map no longer carries it.\n501:     if (!_activeCameraIds().contains(cameraId)) return true;\n502:     final int generation = _wallGeneration;\n503:     final Completer<bool> settled = Completer<bool>();\n504:     _sourceSettles[cameraId] = settled;\n505:     setState(() => _tileSources[cameraId] = source);\n506:     await WidgetsBinding.instance.endOfFrame;\n507:     if (generation != _wallGeneration || !mounted) return false;\n508:     try {\n509:       return await settled.future.timeout(widget.sourceSettleTimeout);\n510:     } finally {\n511:       if (identical(_sourceSettles[cameraId], settled)) {\n512:         _sourceSettles.remove(cameraId);\n513:       }\n514:     }\n515:   }\n516: \n517:   /// Builds the resolved channel with this app's surfaces.\n518:   ///\n519:   /// The registry owns the channel (descriptor, profile, clock, glitch\n520:   /// configuration); the app must inject its decoder surfaces\n521:   /// ([CctvTileBuilder]), so a shallow copy preserving the registry\n522:   /// object's configuration is built. Live wall state (effects flag,\n523:   /// effective camera count, hero target, manifest version, overscan\n524:   /// safety) additionally travels via [ChannelContext.settings], which\n525:   /// [HauntedSurveillancePlugin.build] honors — registry object and copy\n526:   /// can never diverge on wall config.\n527:   /// Tile widgets keep stable cameraId-based keys and swap feeds in place\n528:   /// ([CameraTile.didUpdateWidget] disposes before creating), so a cached\n529:   /// retry never transiently doubles the decoder count.\n530:   ChannelPlugin _configuredChannel() {\n531:     final ChannelPlugin resolved = widget.plugin;\n532:     if (resolved is HauntedSurveillancePlugin) {\n533:       return HauntedSurveillancePlugin(\n534:         tileBuilder: _buildTile,\n535:         profile: widget.profile ?? resolved.profile,\n536:         manifest: _manifest,\n537:         clock: widget.clock,\n538:         disableEffects: _effectsDisabled,\n539:         glitchSeed: widget.glitchSeed,\n540:       );\n541:     }\n542:     return resolved;\n543:   }\n544: \n545:   void _openRecovery({bool deferFocus = false}) {\n546:     if (!mounted || _recoveryVisible) {\n547:       return;\n548:     }\n549:     setState(() {\n550:       _recoveryVisible = true;\n551:       _recoveryStatus = null;\n552:     });\n553:     if (deferFocus) {\n554:       // The held key keeps tile focus until its release (see _onWallKey):\n555:       // focusing the panel now would hand auto-repeat arrivals to the\n556:       // focused button and fire its action while still held.\n557:       return;\n558:     }\n559:     // The wall's focus exclusion hands focus back to the scope; pull it onto\n560:     // the first recovery action so a D-pad lands inside the panel.\n561:     WidgetsBinding.instance.addPostFrameCallback((_) {\n562:       if (mounted && _recoveryVisible) {\n563:         _recoveryFocus.requestFocus();\n564:       }\n565:     });\n566:   }\n567: \n568:   /// Opens the host guest-code page.\n569:   ///\n570:   /// Offline builds never reach here (no GUEST CODES button without a\n571:   /// [GuestCodeClient]). The panel owns its authoritative listing refresh\n572:   /// (immediate fetch plus bounded interval); the wall only shows/hides it.\n573:   void _openGuestCodes() {\n574:     final GuestCodeClient? client = widget.guestCodeClient;\n575:     if (!mounted || _guestCodesVisible || client == null) {\n576:       return;\n577:     }\n578:     setState(() {\n579:       _guestCodesVisible = true;\n580:     });\n581:     WidgetsBinding.instance.addPostFrameCallback((_) {\n582:       if (mounted && _guestCodesVisible) {\n583:         _recoveryFocus.requestFocus();\n584:       }\n585:     });\n586:   }\n587: \n588:   /// Returns from the guest-code page to the recovery actions.\n589:   void _closeGuestCodes() {\n590:     setState(() {\n591:       _guestCodesVisible = false;\n592:     });\n593:     WidgetsBinding.instance.addPostFrameCallback((_) {\n594:       if (mounted && _recoveryVisible) {\n595:         _recoveryFocus.requestFocus();\n596:       }\n597:     });\n598:   }\n599: \n600:   /// Opens the host invite (HOST QR) page.\n601:   ///\n602:   /// Offline builds never reach here (no HOST QR button without a\n603:   /// [HostInviteClient]). The panel owns its invite mint (immediate fetch\n604:   /// plus manual REFRESH and an expiry ticker); the wall only shows/hides it.\n605:   void _openHostCodes() {\n606:     final HostInviteC