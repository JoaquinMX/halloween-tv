{"type":"tool_use","timestamp":1793461008295,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b3786001mRj4c5wHZAFlEj","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929b300d001pUUofZMfNb9ZeS","type":"tool","id":"call_01a1929b32a372b58ea2418239e75ce1","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/packages/infra_firestore/lib/src/manifest_source.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/infra_firestore/lib/src/manifest_source.dart, lines 1-228\n1: /// Firestore control-plane adapters: manifest source + document mapping.\n2: ///\n3: /// Design authority: Technical Design v1.0 §9 (Firestore control plane).\n4: ///\n5: /// Port direction (finding D-08 — recorded here): the `ManifestSource` port\n6: /// interface is owned by the contracts layer in\n7: /// `package:channel_api/channel_api.dart` (`ManifestSource<T>`); this\n8: /// library declares no port of its own and only ships the\n9: /// `PlaybackManifest`-bound adapter ([StaticManifestSource]) plus the\n10: /// document mapping ([manifestFromFirestore]). Channels therefore bind\n11: /// `ManifestSource<PlaybackManifest>` from `channel_api` and never import\n12: /// `infra_*`.\n13: ///\n14: /// Backwards compatibility: the barrel\n15: /// (`package:infra_firestore/infra_firestore.dart`) still re-exports\n16: /// [ManifestSource] through this library so existing importers compile; the\n17: /// re-export carries an `@Deprecated` annotation recording the move (Dart\n18: /// raises no deprecation diagnostic for export directives, so the\n19: /// deprecation here is documentation-level — new code must import the port\n20: /// from `channel_api`).\n21: ///\n22: /// Every type crossing this boundary belongs to `core_playlist`\n23: /// ([PlaybackManifest], [ClipDescriptor], [OverlaySettings]),\n24: /// `channel_api` (the port), or `core_foundation`; nothing is redefined\n25: /// here.\n26: library;\n27: \n28: import 'package:channel_api/channel_api.dart' show ManifestSource;\n29: import 'package:core_playlist/core_playlist.dart';\n30: \n31: @Deprecated(\n32:   'ManifestSource moved to the contracts layer (finding D-08): import it '\n33:   'from package:channel_api/channel_api.dart. This infra re-export is kept '\n34:   'only so existing importers compile.',\n35: )\n36: export 'package:channel_api/channel_api.dart' show ManifestSource;\n37: \n38: /// Supported Firestore manifest document schema version.\n39: ///\n40: /// Bump when the wire shape changes; [manifestFromFirestore] rejects any\n41: /// other version so a stale client never plays a manifest it cannot parse.\n42: const int kManifestSchemaVersion = 1;\n43: \n44: /// Thrown when a Firestore document cannot be mapped to a manifest, e.g.\n45: /// an unsupported `schemaVersion` or a malformed payload.\n46: class ManifestSchemaException implements Exception {\n47:   /// Creates a schema violation error with a human-readable [message].\n48:   const ManifestSchemaException(this.message);\n49: \n50:   /// Human-readable description of the violation.\n51:   final String message;\n52: \n53:   @override\n54:   String toString() => 'ManifestSchemaException: $message';\n55: }\n56: \n57: /// Fixture-backed `ManifestSource<PlaybackManifest>` that emits [fixture]\n58: /// once per subscription and then closes.\n59: ///\n60: /// Used by tests, previews, and offline playback. In stub mode the fixture\n61: /// is authoritative for every requested party/channel, so callers can wire\n62: /// the port before the control plane exists.\n63: class StaticManifestSource implements ManifestSource<PlaybackManifest> {\n64:   /// Creates a source that emits [fixture] once per subscription.\n65:   const StaticManifestSource(this.fixture);\n66: \n67:   /// The manifest emitted to every subscriber.\n68:   final PlaybackManifest fixture;\n69: \n70:   @override\n71:   Stream<PlaybackManifest> watchCurrent({\n72:     required String partyId,\n73:     required String channelId,\n74:   }) async* {\n75:     yield fixture;\n76:   }\n77: }\n78: \n79: /// Maps a Firestore document snapshot to a [PlaybackManifest].\n80: ///\n81: /// Expected fixture JSON shape (same as `PlaybackManifest.toJson` plus the\n82: /// envelope field `schemaVersion`):\n83: /// ```json\n84: /// {\n85: ///   \"schemaVersion\": 1,\n86: ///   \"partyId\": \"party-1\",\n87: ///   \"channelId\": \"cctv\",\n88: ///   \"version\": 1,\n89: ///   \"publishedAt\": \"2026-10-29T00:00:00.000Z\",\n90: ///   \"overlay\": {\"scanlineOpacity\": 0.5, \"noiseLevel\": 0.2, \"vignette\": 0.6},\n91: ///   \"clips\": [\n92: ///     {\n93: ///       \"id\": \"clip-1\",\n94: ///       \"cameraId\": \"CAM-01\",\n95: ///       \"storageObjectId\": \"cctv/cam-01.mp4\",\n96: ///       \"sha256\": \"<64 hex chars>\",\n97: ///       \"sizeBytes\": 1024,\n98: ///       \"durationMs\": 8000,\n99: ///       \"mimeType\": \"video/mp4\"\n100: ///     }\n101: ///   ]\n102: /// }\n103: /// ```\n104: ///\n105: /// Tolerance rules:\n106: /// - `schemaVersion` accepts `1`, `1.0`, or `\"1\"` (whitespace trimmed);\n107: ///   missing, fractional, or any other value throws\n108: ///   [ManifestSchemaException].\n109: /// - Unknown top-level, overlay, and per-clip fields are ignored\n110: ///   (forward compat) — only the fields above are read.\n111: /// - Structural problems in the remaining payload surface as\n112: ///   [ManifestSchemaException], never as raw `FormatException` /\n113: ///   `TypeError`.\n114: ///\n115: /// Semantic rules (4 CCTV cameras, digests, durations) live in\n116: /// `core_playlist`'s `validateCctvManifest`; mapping stays shape-only so it\n117: /// can also carry manifests for non-CCTV channels.\n118: ///\n119: /// [now] remains accepted for source compatibility. Legacy backend documents\n120: /// without a publication timestamp map to a stable UTC epoch value instead\n121: /// of observation time.\n122: PlaybackManifest manifestFromFirestore(\n123:   Map<String, Object?> doc, {\n124:   DateTime Function()? now,\n125: }) {\n126:   final version = _schemaVersionOf(doc['schemaVersion']);\n127:   if (version != kManifestSchemaVersion) {\n128:     throw ManifestSchemaException(\n129:       'unsupported schemaVersion: $version '\n130:       '(expected $kManifestSchemaVersion)',\n131:     );\n132:   }\n133: \n134:   // The deployed backend v1 shape uses `cameraClips` and storage `objectPath`\n135:   // fields. Translate that envelope into the core_playlist wire model while\n136:   // leaving the legacy PlaybackManifest-shaped fixture path intact.\n137:   final Map<String, Object?> payload;\n138:   try {\n139:     payload =\n140:         doc.containsKey('cameraClips')\n141:               ? _playbackPayloadFromBackend(doc, now: now ?? DateTime.now)\n142:               : <String, Object?>{...doc}\n143:           ..remove('schemaVersion');\n144:   } on ManifestSchemaException {\n145:     rethrow;\n146:   } on Object catch (error) {\n147:     throw ManifestSchemaException('invalid manifest payload: $error');\n148:   }\n149:   if (payload['publishedAt'] is DateTime) {\n150:     payload['publishedAt'] = (payload['publishedAt']! as DateTime)\n151:         .toUtc()\n152:         .toIso8601String();\n153:   }\n154:   try {\n155:     return parseManifest(payload);\n156:   } on FormatException catch (error) {\n157:     throw ManifestSchemaException('invalid manifest payload: ${error.message}');\n158:   }\n159: }\n160: \n161: Map<String, Object?> _playbackPayloadFromBackend(\n162:   Map<String, Object?> doc, {\n163:   required DateTime Function() now,\n164: }) {\n165:   final rawClips = doc['cameraClips'];\n166:   if (rawClips is! List) {\n167:     throw const ManifestSchemaException('cameraClips must be a list');\n168:   }\n169:   final clips = <Map<String, Object?>>[];\n170:   for (final Object? rawClip in rawClips) {\n171:     if (rawClip is! Map) {\n172:       throw const ManifestSchemaException('cameraClips entries must be maps');\n173:     }\n174:     final clip = Map<String, Object?>.from(rawClip);\n175:     clips.add(<String, Object?>{\n176:       'id': clip['cameraId'],\n177:       'cameraId': clip['cameraId'],\n178:       'storageObjectId': clip['objectPath'],\n179:       'sha256': clip['sha256'],\n180:       'sizeBytes': clip['sizeBytes'],\n181:       'durationMs': clip['durationMs'],\n182:       'mimeType': clip['mimeType'] ?? 'video/mp4',\n183:     });\n184:   }\n185: \n186:   // TTL note: neither the document `expiresAt` nor per-clip expiry is mapped\n187:   // into the domain model on purpose. Playback is offline-first last-known-good:\n188:   // the server enforces expiry at getDeliveryUrls/acknowledgeDelivery time\n189:   // (CLIP_EXPIRED) and the sweeper purges cloud objects; the client never\n190:   // discards verified local media on TTL alone. A refresh attempt past expiry\n191:   // surfaces through the existing expired-URL refresh failure path.\n192:   // Published and newly seeded backend manifests carry a stable `createdAt`.\n193:   // For legacy documents without either timestamp, use an epoch sentinel so\n194:   // repeated observations of identical content remain the same manifest.\n195:   final Object? publishedAt = doc['publishedAt'] ?? doc['createdAt'];\n196:   final String timestamp = switch (publishedAt) {\n197:     final DateTime value => value.toUtc().toIso8601String(),\n198:     final String value => value,\n199:     _ => DateTime.utc(1970).toIso8601String(),\n200:   };\n201: \n202:   return <String, Object?>{\n203:     'partyId': doc['partyId'],\n204:     'channelId': doc['channelId'],\n205:     'version': doc['version'],\n206:     'clips': clips,\n207:     'publishedAt': timestamp,\n208:     'overlay': doc['overlay'],\n209:   };\n210: }\n211: \n212: int _schemaVersionOf(Object? raw) {\n213:   if (raw is int) {\n214:     return raw;\n215:   }\n216:   final parsed = switch (raw) {\n217:     final num v when v == v.truncateToDouble() => v.toInt(),\n218:     final String v => int.tryParse(v.trim()),\n219:     _ => null,\n220:   };\n221:   if (parsed == null) {\n222:     throw ManifestSchemaException(\n223:       'missing or invalid schemaVersion: $raw '\n224:       '(expected $kManifestSchemaVersion)',\n225:     );\n226:   }\n227:   return parsed;\n228: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/infra_firestore/lib/src/manifest_source.dart, lines 1-228\n1: /// Firestore control-plane adapters: manifest source + document mapping.\n2: ///\n3: /// Design authority: Technical Design v1.0 §9 (Firestore control plane).\n4: ///\n5: /// Port direction (finding D-08 — recorded here): the `ManifestSource` port\n6: /// interface is owned by the contracts layer in\n7: /// `package:channel_api/channel_api.dart` (`ManifestSource<T>`); this\n8: /// library declares no port of its own and only ships the\n9: /// `PlaybackManifest`-bound adapter ([StaticManifestSource]) plus the\n10: /// document mapping ([manifestFromFirestore]). Channels therefore bind\n11: /// `ManifestSource<PlaybackManifest>` from `channel_api` and never import\n12: /// `infra_*`.\n13: ///\n14: /// Backwards compatibility: the barrel\n15: /// (`package:infra_firestore/infra_firestore.dart`) still re-exports\n16: /// [ManifestSource] through this library so existing importers compile; the\n17: /// re-export carries an `@Deprecated` annotation recording the move (Dart\n18: /// raises no deprecation diagnostic for export directives, so the\n19: /// deprecation here is documentation-level — new code must import the port\n20: /// from `channel_api`).\n21: ///\n22: /// Every type crossing this boundary belongs to `core_playlist`\n23: /// ([PlaybackManifest], [ClipDescriptor], [OverlaySettings]),\n24: /// `channel_api` (the port), or `core_foundation`; nothing is redefined\n25: /// here.\n26: library;\n27: \n28: import 'package:channel_api/channel_api.da