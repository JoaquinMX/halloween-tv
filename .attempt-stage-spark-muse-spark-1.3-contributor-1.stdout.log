ider: new FakeVideoGenerationPort(),\n36:     pollIntervalMs: 1,\n37:     sleep: async () => undefined,\n38:     // Emulator transport substitute: the Storage emulator cannot mint real v4\n39:     // signed URLs, so tests inject a deterministic capability string. This is\n40:     // NOT equivalent to cloud IAM signing; it only proves the backend returns\n41:     // a per-submission capability without persisting it.\n42:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n43:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n44:     ...overrides,\n45:   });\n46: }\n47: \n48: test(\"requestGuestUpload refuses missing consent, bad consent, and caller-supplied paths\", {\n49:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n50: }, async () => {\n51:   const { app, db, bucket } = await createEmulatorContext();\n52:   const partyId = randomPartyId();\n53:   try {\n54:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n55:     const services = servicesFor(db, bucket);\n56:     const base = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", contentType: \"image/jpeg\" };\n57:     await assert.rejects(services.requestGuestUpload({ ...base }),\n58:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n59:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: false, textVersion: \"v1\", purpose: \"guest_cameo\" } }),\n60:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n61:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v9\", purpose: \"guest_cameo\" } }),\n62:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n63:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v1\", purpose: \"other\" } }),\n64:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n65:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, contentType: \"image/gif\" }),\n66:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n67:     await assert.rejects(\n68:       services.requestGuestUpload({ ...base, consent: CONSENT, objectPath: \"parties/x/guests/y/ingest/z/photo.jpg\" }),\n69:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n70:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, deviceId: \"not-registered\" }),\n71:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n72:   } finally {\n73:     await clearParty(db, bucket, partyId);\n74:     await disposeEmulatorContext(app);\n75:   }\n76: });\n77: \n78: test(\"guest upload completes against real bytes and repeats idempotently\", {\n79:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n80: }, async () => {\n81:   const { app, db, bucket } = await createEmulatorContext();\n82:   const partyId = randomPartyId();\n83:   try {\n84:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n85:     const services = servicesFor(db, bucket);\n86:     const requested = await services.requestGuestUpload({\n87:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n88:     });\n89:     assert.ok(requested.submissionId);\n90:     assert.ok(requested.objectPath.startsWith(`parties/${partyId}/guests/p-guest-1/ingest/${requested.submissionId}/`));\n91:     assert.ok(requested.uploadUrl.includes(encodeURIComponent(requested.objectPath)));\n92:     assert.equal(requested.consentRevision, \"v1:\" + (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.consent.acceptedAt);\n93:     // The signed PUT capability is returned, never persisted.\n94:     const stored = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n95:     assert.equal(stored.status, \"pending_upload\");\n96:     assert.ok(!(\"uploadUrl\" in stored) && !JSON.stringify(stored).includes(\"upload.invalid\"));\n97:     // Simulate the PUT through the issued capability with real image bytes.\n98:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n99:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n100:     assert.equal(completed.status, \"eligible\");\n101:     const photo = await photoBytes();\n102:     assert.equal(completed.sha256, createHash(\"sha256\").update(photo).digest(\"hex\"));\n103:     assert.equal(completed.sizeBytes, photo.byteLength);\n104:     assert.ok(/^[a-f0-9]{64}$/.test(completed.sha256!));\n105:     assert.ok((completed.sizeBytes ?? 0) > 0);\n106:     const repeated = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n107:     assert.deepEqual(repeated, completed);\n108:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n109:     assert.equal(status.status, \"eligible\");\n110:     assert.equal(status.sha256, completed.sha256);\n111:     assert.ok(!(\"uploadUrl\" in status));\n112:   } finally {\n113:     await clearParty(db, bucket, partyId);\n114:     await disposeEmulatorContext(app);\n115:   }\n116: });\n117: \n118: test(\"guest media is scoped: cross-device and cross-party access is refused\", {\n119:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n120: }, async () => {\n121:   const { app, db, bucket } = await createEmulatorContext();\n122:   const partyId = randomPartyId();\n123:   try {\n124:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n125:     await seedParty(db, partyId, \"p-guest-2\", \"main\");\n126:     const services = servicesFor(db, bucket);\n127:     const requested = await services.requestGuestUpload({\n128:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n129:     });\n130:     await assert.rejects(services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n131:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n132:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n133:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n134:     await assert.rejects(services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n135:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n136:     await assert.rejects(services.getGuestMediaStatus({ partyId: \"other-party\", deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n137:       (e: unknown) => e instanceof BackendError && (e.errorCode === \"FORBIDDEN\" || e.errorCode === \"NOT_FOUND\"));\n138:   } finally {\n139:     await clearParty(db, bucket, partyId);\n140:     await disposeEmulatorContext(app);\n141:   }\n142: });\n143: \n144: test(\"withdrawal is idempotent, deletes the source, and verifies absence\", {\n145:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n146: }, async () => {\n147:   const { app, db, bucket } = await createEmulatorContext();\n148:   const partyId = randomPartyId();\n149:   try {\n150:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n151:     const services = servicesFor(db, bucket);\n152:     const requested = await services.requestGuestUpload({\n153:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n154:     });\n155:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n156:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n157:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n158:     assert.equal(withdrawn.status, \"withdrawn\");\n159:     assert.equal(withdrawn.verifiedAbsent, true);\n160:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n161:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n162:     const repeated = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n163:     assert.equal(repeated.status, \"withdrawn\");\n164:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n165:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n166:     assert.equal(tombstone.status, \"withdrawn\");\n167:     assert.equal(tombstone.tombstone, true);\n168:     // Withdrawn media can never become eligible again.\n169:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n170:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n171:   } finally {\n172:     await clearParty(db, bucket, partyId);\n173:     await disposeEmulatorContext(app);\n174:   }\n175: });\n176: \n177: test(\"PUT after withdrawal never restores eligibility and is deleted\", {\n178:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n179: }, async () => {\n180:   const { app, db, bucket } = await createEmulatorContext();\n181:   const partyId = randomPartyId();\n182:   try {\n183:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n184:     const services = servicesFor(db, bucket);\n185:     const requested = await services.requestGuestUpload({\n186:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n187:     });\n188:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n189:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n190:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n191:     // Late PUT through the stale capability.\n192:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n193:     assert.equal((await bucket.file(requested.objectPath).exists())[0], true);\n194:     const cleanup = await services.handleGuestIngestFinalized(requested.objectPath);\n195:     assert.deepEqual(cleanup, { handled: true, deleted: true });\n196:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n197:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n198:     assert.equal(status.status, \"withdrawn\");\n199:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n200:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n201:   } finally {\n202:     await clearParty(db, bucket, partyId);\n203:     await disposeEmulatorContext(app);\n204:   }\n205: });\n206: \n207: test(\"withdrawal retries a failed delete and verifies absence\", {\n208:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n209: }, async () => {\n210:   const { app, db, bucket } = await createEmulatorContext();\n211:   const partyId = randomPartyId();\n212:   try {\n213:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n214:     let deletes = 0;\n215:     const services = servicesFor(db, bucket, {\n216:       deleteGuestObject: async (file: { delete: (o?: object) => Promise<unknown> }) => {\n217:         deletes += 1;\n218:         if (deletes === 1) throw new Error(\"injected deletion failure\");\n219:         await file.delete({ ignoreNotFound: true });\n220:       },\n221:     });\n222:     const requested = await services.requestGuestUpload({\n223:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n224:     });\n225:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n226:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n227:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n228:     assert.equal(withdrawn.verifiedAbsent, true);\n229:     assert.ok(deletes >= 2, `expected a retried delete, saw ${deletes}`);\n230:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n231:   } finally {\n232:     await clearParty(db, bucket, partyId);\n233:     await disposeEmulatorContext(app);\n234:   }\n235: });\n236: \n237: test(\"retention protects pending uploads and removes abandoned inputs within 24h\", {\n238:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n239: }, async () => {\n240:   const { app, db, bucket } = await createEmulatorContext();\n241:   const partyId = randomPartyId();\n242:   try {\n243:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n244:     const services = servicesFor(db, bucket);\n245:     const live = await services.requestGuestUpload({\n246:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n247:     });\n248:     await bucket.file(live.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n249:     // Abandoned pending upload whose window lapsed (written directly to set a past expiry).\n250:     const abandonedId = \"gsub-abandoned000000000000000001\";\n251:     const abandonedPath = `parties/${partyId}/guests/p-guest-1/ingest/${abandonedId}/photo.jpg`;\n252:     await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).set({\n253:       submissionId: abandonedId,\n254:       partyId,\n255:       deviceId: \"p-guest-1\",\n256:       channelId: \"main\",\n257:       status: \"pending_upload\",\n258:       consent: { accepted: true, textVersion: \"v1\", purpose: \"guest_cameo\", acceptedAt: new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString(), deviceId: \"p-guest-1\" },\n259:       consentRevision: \"v1:abandoned\",\n260:       objectPath: abandonedPath,\n261:       contentType: \"image/jpeg\",\n262:       expiresAt: new Date(Date.now() - 60 * 1000),\n263:     });\n264:     await bucket.file(abandonedPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n265:     const result = await sweepExpiredMedia(db, bucket, new Date());\n266:     assert.ok(result.expiredGuestInputs >= 1);\n267:     assert.equal((await bucket.file(live.objectPath).exists())[0], true);\n268:     assert.equal((await bucket.file(abandonedPath).exists())[0], false);\n269:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).get()).data()?.status, \"expired\");\n270:   } finally {\n271:     await clearParty(db, bucket, partyId);\n272:     await disposeEmulatorContext(app);\n273:   }\n274: });\n275: \n276: const ASSET_FIXTURE_DIR = resolve(__dirname, \"../../../apps/tv_app/assets\");\n277: \n278: function stubReferenceSigning(bucket: Bucket): void {\n279:   // Emulator transport for the worker's reference-signing step: the Storage\n280:   // emulator cannot mint real v4 signed URLs, so the worker's\n281:   // signReferenceReadUrl (same machinery as delivery signReadUrl, 15-min TTL)\n282:   // is resolved here through a deterministic https capability. Save/download\n283:   // stay on the real file object; only signing is substituted. Idempotent.\n284:   const current = bucket.file as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n285:   if (current.__referenceSigningStubbed) return;\n286:   const originalFile = bucket.file.bind(bucket);\n287:   const stubbed = ((path: string, ...rest: unknown[]) => {\n288:     const ref = (originalFile as (...args: unknown[]) => ReturnType<Bucket[\"file\"]>)(path, ...rest);\n289:     ref.getSignedUrl = (async () => [`https://signed.invalid/${encodeURIComponent(String(path))}`]) as unknown as typeof ref.getSignedUrl;\n290:     return ref;\n291:   }) as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n292:   stubbed.__referenceSigningStubbed = true;\n293:   (bucket as unknown as { file: Bucket[\"file\"] }).file = stubbed;\n294: }\n295: \n296: function fullServices(db: Firestore, bucket: Bucket) {\n297:   // Full pipeline composition with the reference signing transport wired:\n298:   // without the stub the worker's signReferenceReadUrl cannot mint a v4 URL\n299:   // on the Storage emulator and guest-bound runGeneration fails closed with\n300:   // PROVIDER_UNAVAILABLE (\"Guest reference URL could not be signed\"). The\n301:   // fake provider itself keeps the strict fetchability gate (bare object-path\n302:   // references are rejected, exactly like the live adapter).\n303:   stubReferenceSigning(bucket);\n304:   return createRuntimeServices({\n305:     db,\n306:     bucket,\n307:     generationEnabled: true,\n308:     provider: new FakeVideoGenerationPort(ASSET_FIXTURE_DIR),\n309:     fixtureDirectory: ASSET_FIXTURE_DIR,\n310:     enqueueGeneration: async () => undefined,\n311:     pollIntervalMs: 1,\n312:     sleep: async () => undefined,\n313:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n314:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n315:   });\n316: }\n317: \n318: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n319:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n320: }, async () => {\n321:   const { app, db, bucket } = await createEmulatorContext();\n322:   const partyId = randomPartyId();\n323:   const deviceId = \"p-guest-1\";\n324:   const channelId = \"main\";\n325:   try {\n326:     await seedParty(db, partyId, deviceId, channelId);\n327:     const services = fullServices(db, bucket);\n328:     const requested = await services.requestGuestUpload({\n329:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n330:     });\n331:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n332:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n333:     const jobId = \"job-revoke-delivery\";\n334:     const idempotencyKey = \"idem-revoke-delivery\";\n335:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n336:     // The worker resolves the consented photo through the emulator signing\n337:     // transport above; the offline fake then enforces the same signed-https\n338:     // gate as the live adapter before accepting the submit.\n339:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n340:     assert.equal(run.state, \"ready\");\n341:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n342:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n343:     assert.equal(clipPaths.length, 4);\n344:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n345:     assert.equal(baseline.clips.length, 4);\n346:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n347:     assert.equal(withdrawn.verifiedAbsent, true);\n348:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n349:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n350:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n351:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n352:     // The tombstone is irreversible: the withdrawn binding can never back a\n353:     // new generation, so no new delivery can ever be issued from it. (At the\n354:     // merged cycle-11 tip this test additionally asserts the published\n355:     // manifest document is removed and getDeliveryUrls/getCurrentManifest\n356:     // reject afterwards; that revocation lives in the delivery/withdrawal\n357:     // composition outside this partition and is covered tip-side.)\n358:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n359:     assert.equal(tombstone.status, \"withdrawn\");\n360:     assert.equal(tombstone.tombstone, true);\n361:     await assert.rejects(services.requestGeneration({\n362:       partyId, deviceId, channelId, jobId: \"job-revoke-blocked\", idempotencyKey: \"idem-revoke-blocked\",\n363:       presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n364:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n365:   } finally {\n366:     await clearParty(db, bucket, partyId);\n367:     await disposeEmulatorContext(app);\n368:   }\n369: });\n370: \n371: test(\"withdrawn media refuses future generation\", {\n372:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n373: }, async () => {\n374:   const { app, db, bucket } = await createEmulatorContext();\n375:   const partyId = randomPartyId();\n376:   try {\n377:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n378:     const services = servicesFor(db, bucket);\n379:     const requested = await services.requestGuestUpload({\n380:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n381:     });\n382:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n383:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n384:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n385:     await assert.rejects(services.requestGeneration({\n386:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n387:       jobId: \"job-refused\", idempotencyKey: \"idem-refused\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n388:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n389:     await assert.rejects(services.requestGeneration({\n390:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n391:       jobId: \"job-unknown-guest\", idempotencyKey: \"idem-unknown-guest\", presetId: \"cheap_demo\", guestMediaId: \"gsub-doesnotexist00000000000001\",\n392:     }), (e: unknown) => e instanceof BackendError && (e.errorCode === \"NOT_FOUND\" || e.errorCode === \"FORBIDDEN\"));\n393:   } finally {\n394:     await clearParty(db, bucket, partyId);\n395:     await disposeEmulatorContext(app);\n396:   }\n397: });\n398: \n399: \n400: /** Wraps a bucket so object downloads are observable without changing stored bytes. */\n401: function downloadCountingBucket(bucket: Bucket): { bucket: Bucket; downloads: () => number } {\n402:   let count = 0;\n403:   const wrapped = new Proxy(bucket, {\n404:     get(target, prop, receiver) {\n405:       if (prop === \"file\") {\n406:         return (path: string) => {\n407:           const file = (target as Bucket).file(path);\n408:           return new Proxy(file, {\n409:             get(fileTarget, fileProp, fileReceiver) {\n410:               if (fileProp === \"download\") {\n411:                 return async (...args: unknown[]) => {\n412:                   count += 1;\n413:                   return Reflect.apply(\n414:                     (fileTarget as { download: (...a: unknown[]) => Promise<unknown> }).download,\n415:                     fileTarget,\n416:                     args,\n417:                   );\n418:                 };\n419:               }\n420:               const value = Reflect.get(fileTarget as object, fileProp, fileReceiver);\n421:               return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(fileTarget) : value;\n422:             },\n423:           });\n424:         };\n425:       }\n426:       const value = Reflect.get(target as object, prop, receiver);\n427:       return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(target) : value;\n428:     },\n429:   });\n430:   return { bucket: wrapped as unknown as Bucket, downloads: () => count };\n431: }\n432: \n433: test(\"oversized guest bytes are rejected size-first without a full download\", {\n434:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n435: }, async () => {\n436:   const { app, db, bucket } = await createEmulatorContext();\n437:   const partyId = randomPartyId();\n438:   try {\n439:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n440:     const counting = downloadCountingBucket(bucket);\n441:     const services = createRuntimeServices({\n442:       db,\n443:       bucket: counting.bucket,\n444:       generationEnabled: true,\n445:       provider: new FakeVideoGenerationPort(),\n446:       pollIntervalMs: 1,\n447:       sleep: async () => undefined,\n448:       signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n449:       signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n450:     });\n451:     const requested = await services.requestGuestUpload({\n452:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n453:     });\n454:     const oversized = Buffer.alloc(GUEST_MAX_IMAGE_BYTES + 1024, 0);\n455:     oversized[0] = 0xff; oversized[1] = 0xd8; oversized[2] = 0xff;\n456:     await bucket.file(requested.objectPath).save(oversized, { contentType: \"image/jpeg\" });\n457:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n458:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n459:     assert.equal(counting.downloads(), 0, \"size cap must be enforced from metadata before any download\");\n460:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.status, \"pending_upload\");\n461:   } finally {\n462:     await clearParty(db, bucket, partyId);\n463:     await disposeEmulatorContext(app);\n464:   }\n465: });\n466: \n467: test(\"completion never extends the immutable creation-based deletion deadline\", {\n468:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n469: }, async () => {\n470:   const { app, db, bucket } = await createEmulatorContext();\n471:   const partyId = randomPartyId();\n472:   try {\n473:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n474:     const services = servicesFor(db, bucket);\n475:     const requested = await services.requestGuestUpload({\n476:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n477:     });\n478:     const before = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n479:     assert.ok(before.deleteAt, \"request must persist an immutable deletion deadline\");\n480:     const deadlineMs = (before.deleteAt as { toDate: () => Date }).toDate().getTime();\n481:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n482:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n483:     assert.ok(Date.parse(completed.expiresAt) <= deadlineMs, \"completion must not extend retention past the creation-based deadline\");\n484:     const after = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n485:     assert.equal((after.deleteAt as { toDate: () => Date }).toDate().toISOString(), new Date(deadlineMs).toISOString());\n486:   } finally {\n487:     await clearParty(db, bucket, partyId);\n488:     await disposeEmulatorContext(app);\n489:   }\n490: });\n491: \n492: test(\"withdrawal releases the party budget pointer like failForWithdrawnConsent\", {\n493:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n494: }, async () => {\n495:   const { app, db, bucket } = await createEmulatorContext();\n496:   const partyId = randomPartyId();\n497:   try {\n498:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n499:     const services = fullServices(db, bucket);\n500:     const requested = await services.requestGuestUpload({\n501:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n502:     });\n503:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n504:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n505:     const jobId = \"job-budget-release\";\n506:     await services.requestGeneration({\n507:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", jobId, idempotencyKey: \"idem-budget-release\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n508:     });\n509:     assert.equal((await db.doc(`parties/${partyId}/generationBudget/active`).get()).data()?.activeJobId, jobId);\n510:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n511:     assert.equal(withdrawn.verifiedAbsent, true);\n512:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n513:     assert.equal(job.state, \"failed\");\n514:     assert.equal(job.errorCode, \"FORBIDDEN\");\n515:     assert.equal(job.reconciliationReason, \"GUEST_CONSENT_WITHDRAWN\");\n516:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n517:     assert.equal(budget?.activeJobId, null);\n518:     assert.equal(budget?.state, \"idle\");\n519:   } finally {\n520:     await clearParty(db, bucket, partyId);\n521:     await disposeEmulatorContext(app);\n522:   }\n523: });\n524: \n525: test(\"concurrent completion and withdrawal never leaves eligible-on-tombstone\", {\n526:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n527: }, async () => {\n528:   const { app, db, bucket } = await createEmulatorContext();\n529:   const partyId = randomPartyId();\n530:   try {\n531:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n532:     const services = servicesFor(db, bucket);\n533:     const requested = await services.requestGuestUpload({\n534:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n535:     });\n536:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n537:     const identity = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId };\n538:     const [completed, withdrawn] = await Promise.allSettled([\n539:       services.completeGuestUpload(identity),\n540:       services.withdrawGuestMedia(identity),\n541:     ]);\n542:     assert.equal(withdrawn.status, \"fulfilled\", \"withdrawal must settle\");\n543:     // Withdrawal is irreversible: whatever the interleaving, the tombstone wins.\n544:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n545:     assert.equal(tombstone.status, \"withdrawn\");\n546:     assert.equal(tombstone.tombstone, true);\n547:     const finalFields = tombstone as unknown as Record<string, unknown>;\n548:     assert.ok(!(finalFields.status === \"eligible\" && finalFields.tombstone === true), \"eligible-on-tombstone must be impossible\");\n549:     if (completed.status === \"rejected\") {\n550:       assert.ok(completed.reason instanceof BackendError && completed.reason.errorCode === \"FORBIDDEN\");\n551:     }\n552:     await assert.rejects(services.completeGuestUpload(identity),\n553:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n554:   } finally {\n555:     await clearParty(db, bucket, partyId);\n556:     await disposeEmulatorContext(app);\n557:   }\n558: });\n559: \n560: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n561:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n562: }, async () => {\n563:   const { app, db, bucket } = await createEmulatorContext();\n564:   const partyId = randomPartyId();\n565:   const deviceId = \"p-guest-1\";\n566:   const channelId = \"main\";\n567:   try {\n568:     await seedParty(db, partyId, deviceId, channelId);\n569:     const services = fullServices(db, bucket);\n570:     const requested = await services.requestGuestUpload({\n571:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n572:     });\n573:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n574:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n575:     const jobId = \"job-revoke-delivery\";\n576:     const idempotencyKey = \"idem-revoke-delivery\";\n577:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n578:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n579:     assert.equal(run.state, \"ready\");\n580:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n581:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n582:     assert.equal(clipPaths.length, 4);\n583:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n584:     assert.equal(baseline.clips.length, 4);\n585:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n586:     assert.equal(withdrawn.verifiedAbsent, true);\n587:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n588:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n589:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n590:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n591:     assert.equal((await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).exists, false);\n592:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n593:       (e: unknown) => e instanceof BackendError);\n594:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n595:       (e: unknown) => e instanceof BackendError);\n596:   } finally {\n597:     await clearParty(db, bucket, partyId);\n598:     await disposeEmulatorContext(app);\n599:   }\n600: });","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/guest_upload.test.ts, lines 1-600\n1: import assert from \"node:assert/strict\";\n2: import { createHash } from \"node:crypto\";\n3: import { readFile } from \"node:fs/promises\";\n4: import { resolve } from \"node:path\";\n5: import test from \"node:test\";\n6: import type { Bucket, File } from \"@google-cloud/storage\";\n7: import type { Firestore } from \"firebase-admin/firestore\";\n8: import { BackendError } from \"../src/contracts\";\n9: import { GUEST_CONSENT_PURPOSE, GUEST_CONSENT_TEXT_VERSION, GUEST_MAX_IMAGE_BYTES } from \"../src/config\";\n10: import { createRuntimeServices } from \"../src/runtime\";\n11: import { FakeVideoGenerationPort } from \"../src/providers/fake\";\n12: import { sweepExpiredMedia } from \"../src/retention\";\n13: import {\n14:   HAS_FIRESTORE_EMULATOR,\n15:   clearParty,\n16:   createEmulatorContext,\n17:   disposeEmulatorContext,\n18:   randomPartyId,\n19:   seedParty,\n20: } from \"./support/emulators\";\n21: \n22: const CONSENT = { accepted: true, textVersion: GUEST_CONSENT_TEXT_VERSION, purpose: GUEST_CONSENT_PURPOSE };\n23: \n24: async function photoBytes(): Promise<Buffer> {\n25:   return readFile(resolve(__dirname, \"fixtures/guest_photo.jpg\"));\n26: }\n27: \n28: function servicesFor(db: Firestore, bucket: Bucket, overrides: {\n29:   deleteGuestObject?: (file: File) => Promise<void>;\n30: } = {}) {\n31:   return createRuntimeServices({\n32:     db,\n33:     bucket,\n34:     generationEnabled: true,\n35:     provider: new FakeVideoGenerationPort(),\n36:     pollIntervalMs: 1,\n37:     sleep: async () => undefined,\n38:     // Emulator transport substitute: the Storage emulator cannot mint real v4\n39:     // signed URLs, so tests inject a deterministic capability string. This is\n40:     // NOT equivalent to cloud IAM signing; it only proves the backend returns\n41:     // a per-submission capability without persisting it.\n42:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n43:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n44:     ...overrides,\n45:   });\n46: }\n47: \n48: test(\"requestGuestUpload refuses missing consent, bad consent, and caller-supplied paths\", {\n49:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n50: }, async () => {\n51:   const { app, db, bucket } = await createEmulatorContext();\n52:   const partyId = randomPartyId();\n53:   try {\n54:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n55:     const services = servicesFor(db, bucket);\n56:     const base = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", contentType: \"image/jpeg\" };\n57:     await assert.rejects(services.requestGuestUpload({ ...base }),\n58:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n59:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: false, textVersion: \"v1\", purpose: \"guest_cameo\" } }),\n60:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n61:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v9\", purpose: \"guest_cameo\" } }),\n62:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n63:     await assert.rejects(services.requestGuestUpload({ ...base, consent: { accepted: true, textVersion: \"v1\", purpose: \"other\" } }),\n64:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n65:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, contentType: \"image/gif\" }),\n66:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n67:     await assert.rejects(\n68:       services.requestGuestUpload({ ...base, consent: CONSENT, objectPath: \"parties/x/guests/y/ingest/z/photo.jpg\" }),\n69:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n70:     await assert.rejects(services.requestGuestUpload({ ...base, consent: CONSENT, deviceId: \"not-registered\" }),\n71:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n72:   } finally {\n73:     await clearParty(db, bucket, partyId);\n74:     await disposeEmulatorContext(app);\n75:   }\n76: });\n77: \n78: test(\"guest upload completes against real bytes and repeats idempotently\", {\n79:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n80: }, async () => {\n81:   const { app, db, bucket } = await createEmulatorContext();\n82:   const partyId = randomPartyId();\n83:   try {\n84:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n85:     const services = servicesFor(db, bucket);\n86:     const requested = await services.requestGuestUpload({\n87:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n88:     });\n89:     assert.ok(requested.submissionId);\n90:     assert.ok(requested.objectPath.startsWith(`parties/${partyId}/guests/p-guest-1/ingest/${requested.submissionId}/`));\n91:     assert.ok(requested.uploadUrl.includes(encodeURIComponent(requested.objectPath)));\n92:     assert.equal(requested.consentRevision, \"v1:\" + (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.consent.acceptedAt);\n93:     // The signed PUT capability is returned, never persisted.\n94:     const stored = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n95:     assert.equal(stored.status, \"pending_upload\");\n96:     assert.ok(!(\"uploadUrl\" in stored) && !JSON.stringify(stored).includes(\"upload.invalid\"));\n97:     // Simulate the PUT through the issued capability with real image bytes.\n98:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n99:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n100:     assert.equal(completed.status, \"eligible\");\n101:     const photo = await photoBytes();\n102:     assert.equal(completed.sha256, createHash(\"sha256\").update(photo).digest(\"hex\"));\n103:     assert.equal(completed.sizeBytes, photo.byteLength);\n104:     assert.ok(/^[a-f0-9]{64}$/.test(completed.sha256!));\n105:     assert.ok((completed.sizeBytes ?? 0) > 0);\n106:     const repeated = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n107:     assert.deepEqual(repeated, completed);\n108:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n109:     assert.equal(status.status, \"eligible\");\n110:     assert.equal(status.sha256, completed.sha256);\n111:     assert.ok(!(\"uploadUrl\" in status));\n112:   } finally {\n113:     await clearParty(db, bucket, partyId);\n114:     await disposeEmulatorContext(app);\n115:   }\n116: });\n117: \n118: test(\"guest media is scoped: cross-device and cross-party access is refused\", {\n119:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n120: }, async () => {\n121:   const { app, db, bucket } = await createEmulatorContext();\n122:   const partyId = randomPartyId();\n123:   try {\n124:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n125:     await seedParty(db, partyId, \"p-guest-2\", \"main\");\n126:     const services = servicesFor(db, bucket);\n127:     const requested = await services.requestGuestUpload({\n128:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n129:     });\n130:     await assert.rejects(services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n131:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n132:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n133:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n134:     await assert.rejects(services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-2\", channelId: \"main\", submissionId: requested.submissionId }),\n135:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n136:     await assert.rejects(services.getGuestMediaStatus({ partyId: \"other-party\", deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n137:       (e: unknown) => e instanceof BackendError && (e.errorCode === \"FORBIDDEN\" || e.errorCode === \"NOT_FOUND\"));\n138:   } finally {\n139:     await clearParty(db, bucket, partyId);\n140:     await disposeEmulatorContext(app);\n141:   }\n142: });\n143: \n144: test(\"withdrawal is idempotent, deletes the source, and verifies absence\", {\n145:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n146: }, async () => {\n147:   const { app, db, bucket } = await createEmulatorContext();\n148:   const partyId = randomPartyId();\n149:   try {\n150:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n151:     const services = servicesFor(db, bucket);\n152:     const requested = await services.requestGuestUpload({\n153:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n154:     });\n155:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n156:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n157:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n158:     assert.equal(withdrawn.status, \"withdrawn\");\n159:     assert.equal(withdrawn.verifiedAbsent, true);\n160:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n161:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n162:     const repeated = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n163:     assert.equal(repeated.status, \"withdrawn\");\n164:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n165:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n166:     assert.equal(tombstone.status, \"withdrawn\");\n167:     assert.equal(tombstone.tombstone, true);\n168:     // Withdrawn media can never become eligible again.\n169:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n170:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n171:   } finally {\n172:     await clearParty(db, bucket, partyId);\n173:     await disposeEmulatorContext(app);\n174:   }\n175: });\n176: \n177: test(\"PUT after withdrawal never restores eligibility and is deleted\", {\n178:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n179: }, async () => {\n180:   const { app, db, bucket } = await createEmulatorContext();\n181:   const partyId = randomPartyId();\n182:   try {\n183:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n184:     const services = servicesFor(db, bucket);\n185:     const requested = await services.requestGuestUpload({\n186:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n187:     });\n188:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n189:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n190:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n191:     // Late PUT through the stale capability.\n192:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n193:     assert.equal((await bucket.file(requested.objectPath).exists())[0], true);\n194:     const cleanup = await services.handleGuestIngestFinalized(requested.objectPath);\n195:     assert.deepEqual(cleanup, { handled: true, deleted: true });\n196:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n197:     const status = await services.getGuestMediaStatus({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n198:     assert.equal(status.status, \"withdrawn\");\n199:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n200:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n201:   } finally {\n202:     await clearParty(db, bucket, partyId);\n203:     await disposeEmulatorContext(app);\n204:   }\n205: });\n206: \n207: test(\"withdrawal retries a failed delete and verifies absence\", {\n208:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n209: }, async () => {\n210:   const { app, db, bucket } = await createEmulatorContext();\n211:   const partyId = randomPartyId();\n212:   try {\n213:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n214:     let deletes = 0;\n215:     const services = servicesFor(db, bucket, {\n216:       deleteGuestObject: async (file: { delete: (o?: object) => Promise<unknown> }) => {\n217:         deletes += 1;\n218:         if (deletes === 1) throw new Error(\"injected deletion failure\");\n219:         await file.delete({ ignoreNotFound: true });\n220:       },\n221:     });\n222:     const requested = await services.requestGuestUpload({\n223:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n224:     });\n225:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n226:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n227:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n228:     assert.equal(withdrawn.verifiedAbsent, true);\n229:     assert.ok(deletes >= 2, `expected a retried delete, saw ${deletes}`);\n230:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n231:   } finally {\n232:     await clearParty(db, bucket, partyId);\n233:     await disposeEmulatorContext(app);\n234:   }\n235: });\n236: \n237: test(\"retention protects pending uploads and removes abandoned inputs within 24h\", {\n238:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n239: }, async () => {\n240:   const { app, db, bucket } = await createEmulatorContext();\n241:   const partyId = randomPartyId();\n242:   try {\n243:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n244:     const services = servicesFor(db, bucket);\n245:     const live = await services.requestGuestUpload({\n246:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n247:     });\n248:     await bucket.file(live.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n249:     // Abandoned pending upload whose window lapsed (written directly to set a past expiry).\n250:     const abandonedId = \"gsub-abandoned000000000000000001\";\n251:     const abandonedPath = `parties/${partyId}/guests/p-guest-1/ingest/${abandonedId}/photo.jpg`;\n252:     await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).set({\n253:       submissionId: abandonedId,\n254:       partyId,\n255:       deviceId: \"p-guest-1\",\n256:       channelId: \"main\",\n257:       status: \"pending_upload\",\n258:       consent: { accepted: true, textVersion: \"v1\", purpose: \"guest_cameo\", acceptedAt: new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString(), deviceId: \"p-guest-1\" },\n259:       consentRevision: \"v1:abandoned\",\n260:       objectPath: abandonedPath,\n261:       contentType: \"image/jpeg\",\n262:       expiresAt: new Date(Date.now() - 60 * 1000),\n263:     });\n264:     await bucket.file(abandonedPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n265:     const result = await sweepExpiredMedia(db, bucket, new Date());\n266:     assert.ok(result.expiredGuestInputs >= 1);\n267:     assert.equal((await bucket.file(live.objectPath).exists())[0], true);\n268:     assert.equal((await bucket.file(abandonedPath).exists())[0], false);\n269:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${abandonedId}`).get()).data()?.status, \"expired\");\n270:   } finally {\n271:     await clearParty(db, bucket, partyId);\n272:     await disposeEmulatorContext(app);\n273:   }\n274: });\n275: \n276: const ASSET_FIXTURE_DIR = resolve(__dirname, \"../../../apps/tv_app/assets\");\n277: \n278: function stubReferenceSigning(bucket: Bucket): void {\n279:   // Emulator transport for the worker's reference-signing step: the Storage\n280:   // emulator cannot mint real v4 signed URLs, so the worker's\n281:   // signReferenceReadUrl (same machinery as delivery signReadUrl, 15-min TTL)\n282:   // is resolved here through a deterministic https capability. Save/download\n283:   // stay on the real file object; only signing is substituted. Idempotent.\n284:   const current = bucket.file as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n285:   if (current.__referenceSigningStubbed) return;\n286:   const originalFile = bucket.file.bind(bucket);\n287:   const stubbed = ((path: string, ...rest: unknown[]) => {\n288:     const ref = (originalFile as (...args: unknown[]) => ReturnType<Bucket[\"file\"]>)(path, ...rest);\n289:     ref.getSignedUrl = (async () => [`https://signed.invalid/${encodeURIComponent(String(path))}`]) as unknown as typeof ref.getSignedUrl;\n290:     return ref;\n291:   }) as Bucket[\"file\"] & { __referenceSigningStubbed?: boolean };\n292:   stubbed.__referenceSigningStubbed = true;\n293:   (bucket as unknown as { file: Bucket[\"file\"] }).file = stubbed;\n294: }\n295: \n296: function fullServices(db: Firestore, bucket: Bucket) {\n297:   // Full pipeline composition with the reference signing transport wired:\n298:   // without the stub the worker's signReferenceReadUrl cannot mint a v4 URL\n299:   // on the Storage emulator and guest-bound runGeneration fails closed with\n300:   // PROVIDER_UNAVAILABLE (\"Guest reference URL could not be signed\"). The\n301:   // fake provider itself keeps the strict fetchability gate (bare object-path\n302:   // references are rejected, exactly like the live adapter).\n303:   stubReferenceSigning(bucket);\n304:   return createRuntimeServices({\n305:     db,\n306:     bucket,\n307:     generationEnabled: true,\n308:     provider: new FakeVideoGenerationPort(ASSET_FIXTURE_DIR),\n309:     fixtureDirectory: ASSET_FIXTURE_DIR,\n310:     enqueueGeneration: async () => undefined,\n311:     pollIntervalMs: 1,\n312:     sleep: async () => undefined,\n313:     signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n314:     signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n315:   });\n316: }\n317: \n318: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n319:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n320: }, async () => {\n321:   const { app, db, bucket } = await createEmulatorContext();\n322:   const partyId = randomPartyId();\n323:   const deviceId = \"p-guest-1\";\n324:   const channelId = \"main\";\n325:   try {\n326:     await seedParty(db, partyId, deviceId, channelId);\n327:     const services = fullServices(db, bucket);\n328:     const requested = await services.requestGuestUpload({\n329:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n330:     });\n331:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n332:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n333:     const jobId = \"job-revoke-delivery\";\n334:     const idempotencyKey = \"idem-revoke-delivery\";\n335:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n336:     // The worker resolves the consented photo through the emulator signing\n337:     // transport above; the offline fake then enforces the same signed-https\n338:     // gate as the live adapter before accepting the submit.\n339:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n340:     assert.equal(run.state, \"ready\");\n341:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n342:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n343:     assert.equal(clipPaths.length, 4);\n344:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n345:     assert.equal(baseline.clips.length, 4);\n346:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n347:     assert.equal(withdrawn.verifiedAbsent, true);\n348:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n349:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n350:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n351:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n352:     // The tombstone is irreversible: the withdrawn binding can never back a\n353:     // new generation, so no new delivery can ever be issued from it. (At the\n354:     // merged cycle-11 tip this test additionally asserts the published\n355:     // manifest document is removed and getDeliveryUrls/getCurrentManifest\n356:     // reject afterwards; that revocation lives in the delivery/withdrawal\n357:     // composition outside this partition and is covered tip-side.)\n358:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n359:     assert.equal(tombstone.status, \"withdrawn\");\n360:     assert.equal(tombstone.tombstone, true);\n361:     await assert.rejects(services.requestGeneration({\n362:       partyId, deviceId, channelId, jobId: \"job-revoke-blocked\", idempotencyKey: \"idem-revoke-blocked\",\n363:       presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n364:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n365:   } finally {\n366:     await clearParty(db, bucket, partyId);\n367:     await disposeEmulatorContext(app);\n368:   }\n369: });\n370: \n371: test(\"withdrawn media refuses future generation\", {\n372:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n373: }, async () => {\n374:   const { app, db, bucket } = await createEmulatorContext();\n375:   const partyId = randomPartyId();\n376:   try {\n377:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n378:     const services = servicesFor(db, bucket);\n379:     const requested = await services.requestGuestUpload({\n380:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n381:     });\n382:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n383:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n384:     await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n385:     await assert.rejects(services.requestGeneration({\n386:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n387:       jobId: \"job-refused\", idempotencyKey: \"idem-refused\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n388:     }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n389:     await assert.rejects(services.requestGeneration({\n390:       partyId, deviceId: \"p-guest-1\", channelId: \"main\",\n391:       jobId: \"job-unknown-guest\", idempotencyKey: \"idem-unknown-guest\", presetId: \"cheap_demo\", guestMediaId: \"gsub-doesnotexist00000000000001\",\n392:     }), (e: unknown) => e instanceof BackendError && (e.errorCode === \"NOT_FOUND\" || e.errorCode === \"FORBIDDEN\"));\n393:   } finally {\n394:     await clearParty(db, bucket, partyId);\n395:     await disposeEmulatorContext(app);\n396:   }\n397: });\n398: \n399: \n400: /** Wraps a bucket so object downloads are observable without changing stored bytes. */\n401: function downloadCountingBucket(bucket: Bucket): { bucket: Bucket; downloads: () => number } {\n402:   let count = 0;\n403:   const wrapped = new Proxy(bucket, {\n404:     get(target, prop, receiver) {\n405:       if (prop === \"file\") {\n406:         return (path: string) => {\n407:           const file = (target as Bucket).file(path);\n408:           return new Proxy(file, {\n409:             get(fileTarget, fileProp, fileReceiver) {\n410:               if (fileProp === \"download\") {\n411:                 return async (...args: unknown[]) => {\n412:                   count += 1;\n413:                   return Reflect.apply(\n414:                     (fileTarget as { download: (...a: unknown[]) => Promise<unknown> }).download,\n415:                     fileTarget,\n416:                     args,\n417:                   );\n418:                 };\n419:               }\n420:               const value = Reflect.get(fileTarget as object, fileProp, fileReceiver);\n421:               return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(fileTarget) : value;\n422:             },\n423:           });\n424:         };\n425:       }\n426:       const value = Reflect.get(target as object, prop, receiver);\n427:       return typeof value === \"function\" ? (value as (...a: unknown[]) => unknown).bind(target) : value;\n428:     },\n429:   });\n430:   return { bucket: wrapped as unknown as Bucket, downloads: () => count };\n431: }\n432: \n433: test(\"oversized guest bytes are rejected size-first without a full download\", {\n434:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n435: }, async () => {\n436:   const { app, db, bucket } = await createEmulatorContext();\n437:   const partyId = randomPartyId();\n438:   try {\n439:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n440:     const counting = downloadCountingBucket(bucket);\n441:     const services = createRuntimeServices({\n442:       db,\n443:       bucket: counting.bucket,\n444:       generationEnabled: true,\n445:       provider: new FakeVideoGenerationPort(),\n446:       pollIntervalMs: 1,\n447:       sleep: async () => undefined,\n448:       signGuestUploadUrl: async (file) => `https://upload.invalid/${encodeURIComponent(file.name)}`,\n449:       signReadUrl: async (file) => `https://signed.invalid/${encodeURIComponent(file.name)}`,\n450:     });\n451:     const requested = await services.requestGuestUpload({\n452:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n453:     });\n454:     const oversized = Buffer.alloc(GUEST_MAX_IMAGE_BYTES + 1024, 0);\n455:     oversized[0] = 0xff; oversized[1] = 0xd8; oversized[2] = 0xff;\n456:     await bucket.file(requested.objectPath).save(oversized, { contentType: \"image/jpeg\" });\n457:     await assert.rejects(services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId }),\n458:       (e: unknown) => e instanceof BackendError && e.errorCode === \"INVALID_ARGUMENT\");\n459:     assert.equal(counting.downloads(), 0, \"size cap must be enforced from metadata before any download\");\n460:     assert.equal((await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()?.status, \"pending_upload\");\n461:   } finally {\n462:     await clearParty(db, bucket, partyId);\n463:     await disposeEmulatorContext(app);\n464:   }\n465: });\n466: \n467: test(\"completion never extends the immutable creation-based deletion deadline\", {\n468:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n469: }, async () => {\n470:   const { app, db, bucket } = await createEmulatorContext();\n471:   const partyId = randomPartyId();\n472:   try {\n473:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n474:     const services = servicesFor(db, bucket);\n475:     const requested = await services.requestGuestUpload({\n476:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n477:     });\n478:     const before = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n479:     assert.ok(before.deleteAt, \"request must persist an immutable deletion deadline\");\n480:     const deadlineMs = (before.deleteAt as { toDate: () => Date }).toDate().getTime();\n481:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n482:     const completed = await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n483:     assert.ok(Date.parse(completed.expiresAt) <= deadlineMs, \"completion must not extend retention past the creation-based deadline\");\n484:     const after = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n485:     assert.equal((after.deleteAt as { toDate: () => Date }).toDate().toISOString(), new Date(deadlineMs).toISOString());\n486:   } finally {\n487:     await clearParty(db, bucket, partyId);\n488:     await disposeEmulatorContext(app);\n489:   }\n490: });\n491: \n492: test(\"withdrawal releases the party budget pointer like failForWithdrawnConsent\", {\n493:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n494: }, async () => {\n495:   const { app, db, bucket } = await createEmulatorContext();\n496:   const partyId = randomPartyId();\n497:   try {\n498:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n499:     const services = fullServices(db, bucket);\n500:     const requested = await services.requestGuestUpload({\n501:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n502:     });\n503:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n504:     await services.completeGuestUpload({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n505:     const jobId = \"job-budget-release\";\n506:     await services.requestGeneration({\n507:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", jobId, idempotencyKey: \"idem-budget-release\", presetId: \"cheap_demo\", guestMediaId: requested.submissionId,\n508:     });\n509:     assert.equal((await db.doc(`parties/${partyId}/generationBudget/active`).get()).data()?.activeJobId, jobId);\n510:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId });\n511:     assert.equal(withdrawn.verifiedAbsent, true);\n512:     const job = (await db.doc(`parties/${partyId}/jobs/${jobId}`).get()).data()!;\n513:     assert.equal(job.state, \"failed\");\n514:     assert.equal(job.errorCode, \"FORBIDDEN\");\n515:     assert.equal(job.reconciliationReason, \"GUEST_CONSENT_WITHDRAWN\");\n516:     const budget = (await db.doc(`parties/${partyId}/generationBudget/active`).get()).data();\n517:     assert.equal(budget?.activeJobId, null);\n518:     assert.equal(budget?.state, \"idle\");\n519:   } finally {\n520:     await clearParty(db, bucket, partyId);\n521:     await disposeEmulatorContext(app);\n522:   }\n523: });\n524: \n525: test(\"concurrent completion and withdrawal never leaves eligible-on-tombstone\", {\n526:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n527: }, async () => {\n528:   const { app, db, bucket } = await createEmulatorContext();\n529:   const partyId = randomPartyId();\n530:   try {\n531:     await seedParty(db, partyId, \"p-guest-1\", \"main\");\n532:     const services = servicesFor(db, bucket);\n533:     const requested = await services.requestGuestUpload({\n534:       partyId, deviceId: \"p-guest-1\", channelId: \"main\", consent: CONSENT, contentType: \"image/jpeg\",\n535:     });\n536:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n537:     const identity = { partyId, deviceId: \"p-guest-1\", channelId: \"main\", submissionId: requested.submissionId };\n538:     const [completed, withdrawn] = await Promise.allSettled([\n539:       services.completeGuestUpload(identity),\n540:       services.withdrawGuestMedia(identity),\n541:     ]);\n542:     assert.equal(withdrawn.status, \"fulfilled\", \"withdrawal must settle\");\n543:     // Withdrawal is irreversible: whatever the interleaving, the tombstone wins.\n544:     const tombstone = (await db.doc(`parties/${partyId}/guestMedia/${requested.submissionId}`).get()).data()!;\n545:     assert.equal(tombstone.status, \"withdrawn\");\n546:     assert.equal(tombstone.tombstone, true);\n547:     const finalFields = tombstone as unknown as Record<string, unknown>;\n548:     assert.ok(!(finalFields.status === \"eligible\" && finalFields.tombstone === true), \"eligible-on-tombstone must be impossible\");\n549:     if (completed.status === \"rejected\") {\n550:       assert.ok(completed.reason instanceof BackendError && completed.reason.errorCode === \"FORBIDDEN\");\n551:     }\n552:     await assert.rejects(services.completeGuestUpload(identity),\n553:       (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n554:   } finally {\n555:     await clearParty(db, bucket, partyId);\n556:     await disposeEmulatorContext(app);\n557:   }\n558: });\n559: \n560: test(\"withdrawal revokes delivery: absent everywhere and no new URLs issuable\", {\n561:   skip: !HAS_FIRESTORE_EMULATOR || !process.env.STORAGE_EMULATOR_HOST,\n562: }, async () => {\n563:   const { app, db, bucket } = await createEmulatorContext();\n564:   const partyId = randomPartyId();\n565:   const deviceId = \"p-guest-1\";\n566:   const channelId = \"main\";\n567:   try {\n568:     await seedParty(db, partyId, deviceId, channelId);\n569:     const services = fullServices(db, bucket);\n570:     const requested = await services.requestGuestUpload({\n571:       partyId, deviceId, channelId, consent: CONSENT, contentType: \"image/jpeg\",\n572:     });\n573:     await bucket.file(requested.objectPath).save(await photoBytes(), { contentType: \"image/jpeg\" });\n574:     await services.completeGuestUpload({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n575:     const jobId = \"job-revoke-delivery\";\n576:     const idempotencyKey = \"idem-revoke-delivery\";\n577:     await services.requestGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey, presetId: \"cheap_demo\", guestMediaId: requested.submissionId });\n578:     const run = await services.runGeneration({ partyId, deviceId, channelId, jobId, idempotencyKey });\n579:     assert.equal(run.state, \"ready\");\n580:     const manifest = (await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).data()!;\n581:     const clipPaths = (manifest.cameraClips as Array<{ objectPath: string }>).map((clip) => clip.objectPath);\n582:     assert.equal(clipPaths.length, 4);\n583:     const baseline = await services.getDeliveryUrls({ partyId, deviceId, channelId });\n584:     assert.equal(baseline.clips.length, 4);\n585:     const withdrawn = await services.withdrawGuestMedia({ partyId, deviceId, channelId, submissionId: requested.submissionId });\n586:     assert.equal(withdrawn.verifiedAbsent, true);\n587:     assert.ok(withdrawn.deletedObjects.includes(requested.objectPath));\n588:     for (const path of clipPaths) assert.ok(withdrawn.deletedObjects.includes(path), `derivative ${path} must be deleted at withdrawal`);\n589:     assert.equal((await bucket.file(requested.objectPath).exists())[0], false);\n590:     for (const path of clipPaths) assert.equal((await bucket.file(path).exists())[0], false, `${path} must be absent after withdrawal`);\n591:     assert.equal((await db.doc(`parties/${partyId}/manifests/current_${channelId}`).get()).exists, false);\n592:     await assert.rejects(services.getDeliveryUrls({ partyId, deviceId, channelId }),\n593:       (e: unknown) => e instanceof BackendError);\n594:     await assert.rejects(services.getCurrentManifest({ partyId, deviceId, channelId }),\n595:       (e: unknown) => e instanceof BackendError);\n596:   } finally {\n597:     await clearParty(db, bucket, partyId);\n598:     await disposeEmulatorContext(app);\n599:   }\n600: });"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b295b732eb4ef5288b5e829d9"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/guest_upload.test.ts\"}"},"time":{"start":1793461004658,"end":1793461004765}}}}
