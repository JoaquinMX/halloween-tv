"004201\");\n\n  Line 125:     assert.equal(stored.joinPin, \"004201\", \"leading zeros must be preserved verbatim as a string\");\n\n  Line 133:     const repeat = runTool([...base, \"--join-pin=004201\", \"--apply\"], emulatorEnv());\n\n  Line 141:     assert.equal(lastJson(omitted.stdout).joinPin, \"004201\", \"omitting --join-pin leaves the stored PIN untouched\");\n\n  Line 142:     assert.equal((await db.doc(`parties/${partyId}`).get()).data()?.joinPin, \"004201\");\n\n  Line 169:       \"--channel=haunted_surveillance\", \"--tv-device=tv-host\", \"--join-pin=004201\", \"--apply\"], emulatorEnv());\n\n  Line 191:       \"--channel=haunted_surveillance\", \"--tv-device=tv-host\", \"--join-pin=004201\", \"--apply\"], emulatorEnv());\n\n\n/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/join_party.test.ts:\n  Line 85:     await seedHost(db, partyId, \"tv-host\", channelId, { joinPin: \"004201\" });\n\n  Line 88:     const ok = await services.joinParty({ partyId, deviceId: \"p-pined\", channelId, joinPin: \"004201\" });\n\n  Line 114:       services.joinParty({ partyId, deviceId: \"p-pined\", channelId, joinPin: \"004201\" }),\n\n\n/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/security_rules.test.ts:\n  Line 52:         joinPin: \"004201\",\n\n\n/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/qr_join_e2e.test.ts:\n  Line 85: const JOIN_PIN = \"004201\";\n\n\n/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/guest_list.test.ts:\n  Line 53:     await db.doc(`parties/${partyId}`).set({ ownerUid: null, status: \"active\", activeChannelId: channelId, joinPin: \"004201\" });\n\n  Line 64:     assert.equal(listing.joinPin, \"004201\");\n"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c6589970009c159ee28505e3af"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1\",\"pattern\":\"join_roles_v1|004201\"}"},"time":{"start":1793463834778,"end":179