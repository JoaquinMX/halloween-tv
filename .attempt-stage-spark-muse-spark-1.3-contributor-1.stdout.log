{"type":"step_start","timestamp":1793461843410,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"id":"prt_192a7f5d2001aK6Ixra02iexlU","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a7ee7d001eD55et1SG03hL2","type":"step-start","snapshot":"7371b4767be128309ee05787c81dad772f99abee"}}
{"type":"tool_use","timestamp":1793461857413,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a7f5db0014oVKVexD6edCEq","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a7ee7d001eD55et1SG03hL2","type":"tool","id":"call_01a192a7f39375a19b3be8d572017b7d","tool":"write","state":{"status":"completed","input":{"content":"/// Anonymous join payload parsing with a validated host/guest role.\n///\n/// The TV renders two distinct QR capabilities, and the companion boots to a\n/// dedicated host entry screen ([HostEntryScreen]) precisely so the two can\n/// never be confused:\n///\n/// - Guest route (legacy-compatible): `{partyId, channelId, joinPin?}` with\n///   NO `role` key. An absent role means **guest** so every payload printed\n///   before roles existed keeps working.\n/// - Host route: `{partyId, channelId, role: \"host\", inviteToken: \"hi-…\"}`\n///   carrying the server-minted invite capability. The token is never a\n///   six-digit guest PIN (PIN-shaped tokens are rejected, mirroring the\n///   backend `parseJoinHostInput` gate) and a host payload never carries a\n///   `joinPin`.\n///\n/// Any other `role` value (or a non-string role) fails visibly instead of\n/// guessing, and malformed host capabilities (host without a valid invite\n/// token, guest carrying an invite token) fail visibly too. Guest entry\n/// must never register a host payload through `joinParty`: the join screens\n/// route on [JoinRole] before any callable is invoked.\nlibrary;\n\nimport 'dart:convert';\nimport 'package:core_foundation/core_foundation.dart';\n\nconst int kMaxBindingIdLength = 128;\nfinal RegExp kBindingIdPattern = RegExp(r'^[A-Za-z0-9][A-Za-z0-9._-]*$');\nfinal RegExp _phoneId = RegExp(r'^p-[0-9a-f]{32}$');\nfinal RegExp _pin = RegExp(r'^[0-9]{6}$');\n\n/// Server-assigned device role carried by a join payload.\n///\n/// Clients can never self-assign privilege: this only selects which\n/// redemption callable (`joinParty` vs `joinHost`) the payload is routed to,\n/// and the backend assigns the actual role server-side.\nenum JoinRole { guest, host }\n\nfinal class GuestJoinData {\n  final PartyId partyId;\n  final DeviceId deviceId;\n  final String channelId;\n  final String? joinPin;\n  final JoinRole role;\n  final String? inviteToken;\n  const GuestJoinData({\n    required this.partyId,\n    required this.deviceId,\n    required this.channelId,\n    this.joinPin,\n    this.role = JoinRole.guest,\n    this.inviteToken,\n  });\n  @override\n  bool operator ==(Object other) =>\n      other is GuestJoinData &&\n      other.partyId == partyId &&\n      other.deviceId == deviceId &&\n      other.channelId == channelId &&\n      other.joinPin == joinPin &&\n      other.role == role &&\n      other.inviteToken == inviteToken;\n  @override\n  int get hashCode =>\n      Object.hash(partyId, deviceId, channelId, joinPin, role, inviteToken);\n  @override\n  String toString() =>\n      'GuestJoinData($partyId/$channelId@$deviceId role=$role)';\n}\n\nResult<String> _validate(String field, String raw) {\n  final String value = raw.trim();\n  if (value.isEmpty) return Err<String>('$field must be non-empty');\n  if (value.length > kMaxBindingIdLength ||\n      !kBindingIdPattern.hasMatch(value)) {\n    return Err<String>('$field is malformed');\n  }\n  return Ok<String>(value);\n}\n\n/// Validates a host invite capability (never a guest PIN).\n///\n/// Mirrors the backend `parseJoinHostInput` gate: the token is a\n/// server-minted capability, so a six-digit PIN shape is rejected here\n/// instead of consuming a host redemption attempt.\nResult<String> _validateInviteToken(String? raw) {\n  if (raw == null || raw.trim().isEmpty) {\n    return const Err<String>('host inviteToken is required');\n  }\n  final String value = raw.trim();\n  if (value.length > 256) {\n    return const Err<String>('host inviteToken is invalid');\n  }\n  if (_pin.hasMatch(value)) {\n    return const Err<String>(\n      'inviteToken must be a host invite, not a guest PIN',\n    );\n  }\n  return Ok<String>(value);\n}\n\nResult<GuestJoinData> parseGuestJoinFields({\n  required String partyId,\n  required String localDeviceId,\n  required String channelId,\n  String? joinPin,\n  JoinRole role = JoinRole.guest,\n  String? inviteToken,\n}) {\n  if (!_phoneId.hasMatch(localDeviceId)) {\n    return const Err<GuestJoinData>(\n      'local device identity is malformed',\n    );\n  }\n  final party = _validate('partyId', partyId);\n  if (party is Err<String>) return Err<GuestJoinData>(party.message);\n  final channel = _validate('channelId', channelId);\n  if (channel is Err<String>) return Err<GuestJoinData>(channel.message);\n  if (role == JoinRole.host) {\n    if (joinPin != null && joinPin.trim().isNotEmpty) {\n      return const Err<GuestJoinData>(\n        'host join must carry an inviteToken, not a joinPin',\n      );\n    }\n    final token = _validateInviteToken(inviteToken);\n    if (token is Err<String>) return Err<GuestJoinData>(token.message);\n    return Ok<GuestJoinData>(\n      GuestJoinData(\n        partyId: PartyId((party as Ok<String>).value),\n        deviceId: DeviceId(localDeviceId),\n        channelId: (channel as Ok<String>).value,\n        role: JoinRole.host,\n        inviteToken: (token as Ok<String>).value,\n      ),\n    );\n  }\n  if (inviteToken != null && inviteToken.trim().isNotEmpty) {\n    return const Err<GuestJoinData>(\n      'guest join must not carry a host inviteToken',\n    );\n  }\n  final String? normalizedPin =\n      joinPin?.trim().isEmpty ?? true ? null : joinPin!.trim();\n  if (normalizedPin != null && !_pin.hasMatch(normalizedPin)) {\n    return const Err<GuestJoinData>(\n      'joinPin must contain exactly six digits',\n    );\n  }\n  return Ok<GuestJoinData>(\n    GuestJoinData(\n      partyId: PartyId((party as Ok<String>).value),\n      deviceId: DeviceId(localDeviceId),\n      channelId: (channel as Ok<String>).value,\n      joinPin: normalizedPin,\n    ),\n  );\n}\n\n/// Convenience for the host entry form: a host-typed field set.\nResult<GuestJoinData> parseHostJoinFields({\n  required String partyId,\n  required String localDeviceId,\n  required String channelId,\n  required String inviteToken,\n}) => parseGuestJoinFields(\n  partyId: partyId,\n  localDeviceId: localDeviceId,\n  channelId: channelId,\n  role: JoinRole.host,\n  inviteToken: inviteToken,\n);\n\n/// Parses a scanned or pasted join payload through the shared validator.\n///\n/// Scan and paste stay in parity: both funnel here. An absent `role` means\n/// guest (legacy payloads); `role: \"guest\"` is explicit guest;\n/// `role: \"host\"` requires a valid `inviteToken`. Unknown roles, non-string\n/// roles, and malformed host capabilities fail visibly.\nResult<GuestJoinData> parseGuestJoinPayload(\n  String raw, {\n  required String localDeviceId,\n}) {\n  final String trimmed = raw.trim();\n  if (trimmed.isEmpty ||\n      RegExp(\n        r'^(https?|javascript|data):',\n        caseSensitive: false,\n      ).hasMatch(trimmed)) {\n    return const Err<GuestJoinData>(\n      'join payload must be identifier data, not a URL',\n    );\n  }\n  late final Object? decoded;\n  try {\n    decoded = jsonDecode(trimmed);\n  } on FormatException {\n    return const Err<GuestJoinData>('join payload is not valid JSON');\n  }\n  if (decoded is! Map) {\n    return const Err<GuestJoinData>('join payload must be a JSON object');\n  }\n  final Map<String, Object?> json = Map<String, Object?>.from(\n    decoded.map((Object? k, Object? v) => MapEntry(k.toString(), v)),\n  );\n  String? field(String key, String snake) {\n    final value = json[key] ?? json[snake];\n    return value is String ? value : null;\n  }\n\n  JoinRole role = JoinRole.guest;\n  if (json.containsKey('role')) {\n    final Object? rawRole = json['role'];\n    if (rawRole is! String) {\n      return const Err<GuestJoinData>(\n        'join payload role must be \"guest\" or \"host\"',\n      );\n    }\n    switch (rawRole.trim()) {\n      case 'guest':\n        role = JoinRole.guest;\n      case 'host':\n        role = JoinRole.host;\n      default:\n        return Err<GuestJoinData>(\n          'join payload has unknown role \"${rawRole.trim()}\"',\n        );\n    }\n  }\n\n  final party = field('partyId', 'party_id');\n  final channel = field('channelId', 'channel_id');\n  final pinValue = json['joinPin'] ?? json['join_pin'];\n  // A present-but-non-string PIN is a PIN error, not an identifier error.\n  if (pinValue != null && pinValue is! String) {\n    return const Err<GuestJoinData>(\n      'joinPin must contain exactly six digits',\n    );\n  }\n  if (party == null || channel == null) {\n    return const Err<GuestJoinData>(\n      'join payload must contain string partyId and channelId',\n    );\n  }\n  String? inviteToken;\n  if (json.containsKey('inviteToken') ||\n      json.containsKey('invite_token')) {\n    final Object? rawToken =\n        json['inviteToken'] ?? json['invite_token'];\n    if (rawToken is! String) {\n      return const Err<GuestJoinData>('host inviteToken must be a string');\n    }\n    inviteToken = rawToken;\n  }\n  return parseGuestJoinFields(\n    partyId: party,\n    localDeviceId: localDeviceId,\n    channelId: channel,\n    joinPin: pinValue as String?,\n    role: role,\n    inviteToken: inviteToken,\n  );\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/join/guest_join_data.dart"},"output":"Wrote file successfully: apps/companion_app/lib/src/join/guest_join_data.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: apps/companion_app/lib/src/join/guest_join_data.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a7f39375a19b3be8d572017b7d"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Anonymous join payload parsing with a validated host/guest role.\\n///\\n/// The TV renders two distinct QR capabilities, and the companion boots to a\\n/// dedicated host entry screen ([HostEntryScreen]) precisely so the two can\\n/// never be confused:\\n///\\n/// - Guest route (legacy-compatible): `{partyId, channelId, joinPin?}` with\\n///   NO `role` key. An absent role means **guest** so every payload printed\\n///   before roles existed keeps working.\\n/// - Host route: `{partyId, channelId, role: \\\"host\\\", inviteToken: \\\"hi-…\\\"}`\\n///   carrying the server-minted invite capability. The token is never a\\n///   six-digit guest PIN (PIN-shaped tokens are rejected, mirroring the\\n///   backend `parseJoinHostInput` gate) and a host payload never carries a\\n///   `joinPin`.\\n///\\n/// Any other `role` value (or a non-string role) fails visibly instead of\\n/// guessing, and malformed host capabilities (host without a valid invite\\n/// token, guest carrying an invite token) fail visibly too. Guest entry\\n/// must never register a host payload through `joinParty`: the join screens\\n/// route on [JoinRole] before any callable is invoked.\\nlibrary;\\n\\nimport 'dart:convert';\\nimport 'package:core_foundation/core_foundation.dart';\\n\\nconst int kMaxBindingIdLength = 128;\\nfinal RegExp kBindingIdPattern = RegExp(r'^[A-Za-z0-9][A-Za-z0-9._-]*$');\\nfinal RegExp _phoneId = RegExp(r'^p-[0-9a-f]{32}$');\\nfinal RegExp _pin = RegExp(r'^[0-9]{6}$');\\n\\n/// Server-assigned device role carried by a join payload.\\n///\\n/// Clients can never self-assign privilege: this only selects which\\n/// redemption callable (`joinParty` vs `joinHost`) the payload is routed to,\\n/// and the backend assigns the actual role server-side.\\nenum JoinRole { guest, host }\\n\\nfinal class GuestJoinData {\\n  final PartyId partyId;\\n  final DeviceId deviceId;\\n  final String channelId;\\n  final String? joinPin;\\n  final JoinRole role;\\n  final String? inviteToken;\\n  const GuestJoinData({\\n    required this.partyId,\\n    required this.deviceId,\\n    required this.channelId,\\n    this.joinPin,\\n    this.role = JoinRole.guest,\\n    this.inviteToken,\\n  });\\n  @override\\n  bool operator ==(Object other) =>\\n      other is GuestJoinData &&\\n      other.partyId == partyId &&\\n      other.deviceId == deviceId &&\\n      other.channelId == channelId &&\\n      other.joinPin == joinPin &&\\n      other.role == role &&\\n      other.inviteToken == inviteToken;\\n  @override\\n  int get hashCode =>\\n      Object.hash(partyId, deviceId, channelId, joinPin, role, inviteToken);\\n  @override\\n  String toString() =>\\n      'GuestJoinData($partyId/$channelId@$deviceId role=$role)';\\n}\\n\\nResult<String> _validate(String field, String raw) {\\n  final String value = raw.trim();\\n  if (value.isEmpty) return Err<String>('$field must be non-empty');\\n  if (value.length > kMaxBindingIdLength ||\\n      !kBindingIdPattern.hasMatch(value)) {\\n    return Err<String>('$field is malformed');\\n  }\\n  return Ok<String>(value);\\n}\\n\\n/// Validates a host invite capability (never a guest PIN).\\n///\\n/// Mirrors the backend `parseJoinHostInput` gate: the token is a\\n/// server-minted capability, so a six-digit PIN shape is rejected here\\n/// instead of consuming a host redemption attempt.\\nResult<String> _validateInviteToken(String? raw) {\\n  if (raw == null || raw.trim().isEmpty) {\\n    return const Err<String>('host inviteToken is required');\\n  }\\n  final String value = raw.trim();\\n  if (value.length > 256) {\\n    return const Err<String>('host inviteToken is invalid');\\n  }\\n  if (_pin.hasMatch(value)) {\\n    return const Err<String>(\\n      'inviteToken must be a host invite, not a guest PIN',\\n    );\\n  }\\n  return Ok<String>(value);\\n}\\n\\nResult<GuestJoinData> parseGuestJoinFields({\\n  required String partyId,\\n  required String localDeviceId,\\n  required String channelId,\\n  String? joinPin,\\n  JoinRole role = JoinRole.guest,\\n  String? inviteToken,\\n}) {\\n  if (!_phoneId.hasMatch(localDeviceId)) {\\n    return const Err<GuestJoinData>(\\n      'local device identity is malformed',\\n    );\\n  }\\n  final party = _validate('partyId', partyId);\\n  if (party is Err<String>) return Err<GuestJoinData>(party.message);\\n  final channel = _validate('channelId', channelId);\\n  if (channel is Err<String>) return Err<GuestJoinData>(channel.message);\\n  if (role == JoinRole.host) {\\n    if (joinPin != null && joinPin.trim().isNotEmpty) {\\n      return const Err<GuestJoinData>(\\n        'host join must carry an inviteToken, not a joinPin',\\n      );\\n    }\\n    final token = _validateInviteToken(inviteToken);\\n    if (token is Err<String>) return Err<GuestJoinData>(token.message);\\n    return Ok<GuestJoinData>(\\n      GuestJoinData(\\n        partyId: PartyId((party as Ok<String>).value),\\n        deviceId: DeviceId(localDeviceId),\\n        channelId: (channel as Ok<String>).value,\\n        role: JoinRole.host,\\n        inviteToken: (token as Ok<String>).value,\\n      ),\\n    );\\n  }\\n  if (inviteToken != null && inviteToken.trim().isNotEmpty) {\\n    return const Err<GuestJoinData>(\\n      'guest join must not carry a host inviteToken',\\n    );\\n  }\\n  final String? normalizedPin =\\n      joinPin?.trim().isEmpty ?? true ? null : joinPin!.trim();\\n  if (normalizedPin != null && !_pin.hasMatch(normalizedPin)) {\\n    return const Err<GuestJoinData>(\\n      'joinPin must contain exactly six digits',\\n    );\\n  }\\n  return Ok<GuestJoinData>(\\n    GuestJoinData(\\n      partyId: PartyId((party as Ok<String>).value),\\n      deviceId: DeviceId(localDeviceId),\\n      channelId: (channel as Ok<String>).value,\\n      joinPin: normalizedPin,\\n    ),\\n  );\\n}\\n\\n/// Convenience for the host entry form: a host-typed field set.\\nResult<GuestJoinData> parseHostJoinFields({\\n  required String partyId,\\n  required String localDeviceId,\\n  required String channelId,\\n  required String inviteToken,\\n}) => parseGuestJoinFields(\\n  partyId: partyId,\\n  localDeviceId: localDeviceId,\\n  channelId: channelId,\\n  role: JoinRole.host,\\n  inviteToken: inviteToken,\\n);\\n\\n/// Parses a scanned or pasted join payload through the shared validator.\\n///\\n/// Scan and paste stay in parity: both funnel here. An absent `role` means\\n/// guest (legacy payloads); `role: \\\"guest\\\"` is explicit guest;\\n/// `role: \\\"host\\\"` requires a valid `inviteToken`. Unknown roles, non-string\\n/// roles, and malformed host capabilities fail visibly.\\nResult<GuestJoinData> parseGuestJoinPayload(\\n  String raw, {\\n  required String localDeviceId,\\n}) {\\n  final String trimmed = raw.trim();\\n  if (trimmed.isEmpty ||\\n      RegExp(\\n        r'^(https?|javascript|data):',\\n        caseSensitive: false,\\n      ).hasMatch(trimmed)) {\\n    return const Err<GuestJoinData>(\\n      'join payload must be identifier data, not a URL',\\n    );\\n  }\\n  late final Object? decoded;\\n  try {\\n    decoded = jsonDecode(trimmed);\\n  } on FormatException {\\n    return const Err<GuestJoinData>('join payload is not valid JSON');\\n  }\\n  if (decoded is! Map) {\\n    return const Err<GuestJoinData>('join payload must be a JSON object');\\n  }\\n  final Map<String, Object?> json = Map<String, Object?>.from(\\n    decoded.map((Object? k, Object? v) => MapEntry(k.toString(), v)),\\n  );\\n  String? field(String key, String snake) {\\n    final value = json[key] ?? json[snake];\\n    return value is String ? value : null;\\n  }\\n\\n  JoinRole role = JoinRole.guest;\\n  if (json.containsKey('role')) {\\n    final Object? rawRole = json['role'];\\n    if (rawRole is! String) {\\n      return const Err<GuestJoinData>(\\n        'join payload role must be \\\"guest\\\" or \\\"host\\\"',\\n      );\\n    }\\n    switch (rawRole.trim()) {\\n      case 'guest':\\n        role = JoinRole.guest;\\n      case 'host':\\n        role = JoinRole.host;\\n      default:\\n        return Err<GuestJoinData>(\\n          'join payload has unknown role \\\"${rawRole.trim()}\\\"',\\n        );\\n    }\\n  }\\n\\n  final party = field('partyId', 'party_id');\\n  final channel = field('channelId', 'channel_id');\\n  final pinValue = json['joinPin'] ?? json['join_pin'];\\n  // A present-but-non-string PIN is a PIN error, not an identifier error.\\n  if (pinValue != null && pinValue is! String) {\\n    return const Err<GuestJoinData>(\\n      'joinPin must contain exactly six digits',\\n    );\\n  }\\n  if (party == null || channel == null) {\\n    return const Err<GuestJoinData>(\\n      'join payload must contain string partyId and channelId',\\n    );\\n  }\\n  String? inviteToken;\\n  if (json.containsKey('inviteToken') ||\\n      json.containsKey('invite_token')) {\\n    final Object? rawToken =\\n        json['inviteToken'] ?? json['invite_token'];\\n    if (rawToken is! String) {\\n      return const Err<GuestJoinData>('host inviteToken must be a string');\\n    }\\n    inviteToken = rawToken;\\n  }\\n  return parseGuestJoinFields(\\n    partyId: party,\\n    localDeviceId: localDeviceId,\\n    channelId: channel,\\n    joinPin: pinValue as String?,\\n    role: role,\\n    inviteToken: inviteToken,\\n  );\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/join/guest_join_data.dart\"}"},"time":{"start":1793461843419,"end":1793461857413}}}}
