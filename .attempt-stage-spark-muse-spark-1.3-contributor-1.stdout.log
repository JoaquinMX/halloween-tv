rentManifestRef(db: Firestore, partyId: string, channelId: string) {\n41:   return db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n42: }\n43: \n44: function budgetRef(db: Firestore, partyId: string) {\n45:   return db.doc(`parties/${partyId}/generationBudget/active`);\n46: }\n47: \n48: function deliveryObjectPath(partyId: string, channelId: string, version: number, cameraId: CameraId): string {\n49:   return `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`;\n50: }\n51: \n52: /**\n53:  * Persistence guard: signed reference URLs are in-flight only and must never\n54:  * reach Firestore job docs. The guest binding stores server-side state\n55:  * (objectPath + sourceHash + consentRevision) exclusively.\n56:  */\n57: function assertNoSignedReferenceUrl(value: unknown): void {\n58:   const serialized = JSON.stringify(value ?? null);\n59:   if (/https?:\\/\\//.test(serialized) && /signed/.test(serialized)) {\n60:     throw new BackendError(\"INTERNAL\", \"Signed reference URLs must never be persisted.\");\n61:   }\n62: }\n63: \n64: function exposedTimestamp(value: unknown): unknown {\n65:   if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n66:     return ((value as { toDate: () => Date }).toDate()).toISOString();\n67:   }\n68:   if (value instanceof Date) return value.toISOString();\n69:   return value;\n70: }\n71: \n72: /**\n73:  * Fake-only rehearsal marker. The operator rehearsal tool always sends\n74:  * `rehearsalOnly: true`; the marker is persisted on the job document and the\n75:  * worker resolves ONLY the offline fake provider for marked jobs, regardless\n76:  * of the deployed provider configuration. Requests without the marker take\n77:  * the unchanged default path. Any other marker value is rejected fail-closed\n78:  * so the flag can never be weakened into a live-looking request.\n79:  */\n80: function extractRehearsalOnly(value: unknown): boolean {\n81:   if (value && typeof value === \"object\" && !Array.isArray(value) && \"rehearsalOnly\" in value) {\n82:     if ((value as Record<string, unknown>).rehearsalOnly !== true) {\n83:       throw new BackendError(\"INVALID_ARGUMENT\", \"rehearsalOnly must be true when present.\");\n84:     }\n85:     return true;\n86:   }\n87:   return false;\n88: }\n89: \n90: /**\n91:  * Strips the rehearsal marker before shared cheap_demo control validation and\n92:  * request parsing, which only accept the fixed preset fields. The marker is\n93:  * handled (validated, bound, persisted) by the store itself.\n94:  */\n95: function stripRehearsalOnly(value: unknown): unknown {\n96:   if (value && typeof value === \"object\" && !Array.isArray(value) && \"rehearsalOnly\" in value) {\n97:     const { rehearsalOnly: _ignored, ...rest } = value as Record<string, unknown>;\n98:     return rest;\n99:   }\n100:   return value;\n101: }\n102: \n103: export class FirestoreGenerationStore {\n104:   readonly db: Firestore;\n105:   readonly bucket: Bucket;\n106:   private readonly now: () => Date;\n107: \n108:   constructor(options: GenerationStoreOptions) {\n109:     this.db = options.db;\n110:     this.bucket = options.bucket;\n111:     this.now = options.now ?? (() => new Date());\n112:   }\n113: \n114:   async requestGeneration(value: unknown): Promise<RequestGenerationResult> {\n115:     const rehearsalOnly = extractRehearsalOnly(value);\n116:     const sanitized = stripRehearsalOnly(value);\n117:     validatePresetControls(sanitized);\n118:     if (sanitized && typeof sanitized === \"object\" && !Array.isArray(sanitized) && \"prompt\" in sanitized) {\n119:       const presetId = (sanitized as Record<string, unknown>).presetId === CAMEO_DEMO_PRESET.presetId ? \"cameo_demo\" : \"cheap_demo\";\n120:       throw new BackendError(\"INVALID_ARGUMENT\", `Generation prompts are fixed server-side for ${presetId}.`);\n121:     }\n122:     const input = parseRequestGeneration(sanitized);\n123:     const registered = await assertRegisteredPartyDevice(this.db, input);\n124:     if (registered.channel.status !== \"active\") throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n125:     // Consent-bound request gate: the guest photo must be eligible right now.\n126:     // The worker and the publication transaction recheck before submitting and\n127:     // before publishing, so a withdrawal races fail closed.\n128:     let guest: GuestMediaDoc | undefined;\n129:     if (input.guestMediaId) {\n130:       guest = await assertGuestEligible(this.db, input, input.guestMediaId, this.now().getTime());\n131:     }\n132:     const ref = jobRef(this.db, input.partyId, input.jobId);\n133:     const result = await this.db.runTransaction(async (transaction) => {\n134:       const existing = await transaction.get(ref);\n135:       if (existing.exists) {\n136:         const old = existing.data()!;\n137:         if (old.idempotencyKey !== input.idempotencyKey || old.deviceId !== input.deviceId || old.channelId !== input.channelId ||\n138:             (old.guestMediaId ?? undefined) !== (input.guestMediaId ?? undefined) ||\n139:             (old.rehearsalOnly === true) !== rehearsalOnly) {\n140:           throw new BackendError(\"FORBIDDEN\", \"jobId is already bound to a different request.\");\n141:         }\n142:         return {\n143:           state: String(old.state),\n144:           created: false,\n145:           manifestVersion: Number(old.manifestVersion),\n146:           timestamp: old.timestamp,\n147:         };\n148:       }\n149:       const inFlight = await transaction.get(\n150:         this.db.collection(`parties/${input.partyId}/jobs`).where(\"state\", \"in\", [\"queued\", \"running\"]).limit(1),\n151:       );\n152:       if (!inFlight.empty) throw new BackendError(\"BUDGET_EXCEEDED\", \"One generation is already in flight for this party.\");\n153:       await transaction.get(budgetRef(this.db, input.partyId));\n154:       const current = await transaction.get(currentManifestRef(this.db, input.partyId, input.channelId));\n155:       const sourceManifestVersion = current.exists ? Number(current.data()?.version ?? 0) : 0;\n156:       if (!Number.isSafeInteger(sourceManifestVersion) || sourceManifestVersion < 0 || (current.exists && sourceManifestVersion < 1)) {\n157:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest version is invalid.\");\n158:       }\n159:       const manifestVersion = sourceManifestVersion + 1;\n160:       if (!Number.isSafeInteger(manifestVersion)) throw new BackendError(\"MANIFEST_MISMATCH\", \"Next manifest version is invalid.\");\n161:       const timestamp = FieldValue.serverTimestamp();\n162:       const cameraAttempts = Object.fromEntries(REQUIRED_CAMERA_IDS.map((cameraId) => [cameraId, {\n163:         consumedAttempt: false,\n164:         submissionState: \"not_started\",\n165:       }]));\n166:       // Re-verify consent inside the creation transaction so a withdrawal that\n167:       // lands between the pre-check and the job write fails the request.\n168:       let guestBinding: Record<string, unknown> | undefined;\n169:       if (input.guestMediaId && guest) {\n170:         const guestSnap = await transaction.get(\n171:           this.db.doc(`parties/${input.partyId}/guestMedia/${input.guestMediaId}`),\n172:         );\n173:         const current = guestSnap.exists ? (guestSnap.data() as GuestMediaDoc) : undefined;\n174:         if (!current || current.status !== \"eligible\" ||\n175:             current.sourceHash !== guest.sourceHash ||\n176:             current.consentRevision !== guest.consentRevision ||\n177:             current.deviceId !== input.deviceId || current.channelId !== input.channelId) {\n178:           throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for generation.\");\n179:         }\n180:         guestBinding = {\n181:           submissionId: input.guestMediaId,\n182:         