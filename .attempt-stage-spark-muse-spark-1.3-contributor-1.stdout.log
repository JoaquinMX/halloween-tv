{"type":"text","timestamp":1793463873491,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"id":"prt_192c6efce001MJcJ0EAnOTbAdc","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c6d93e001RBaQJsvB7Rrygm","type":"text","text":"Host invite contract done. Now the host panel with pairing display and host management.","time":{"start":1793463873486,"end":1793463873491}}}
{"type":"tool_use","timestamp":1793463903769,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c6efd5001flCdGjcxhyzZlZ","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c6d93e001RBaQJsvB7Rrygm","type":"tool","id":"call_01a192c6ef6a76929dc30f8a12f38cc0","tool":"write","state":{"status":"completed","input":{"content":"/// Host invite panel (TV settings panel, separately labelled HOST QR).\n///\n/// Shows exactly one QR encoding the scoped host invite capability\n/// ([buildHostJoinPayload]: `partyId` + `channelId` + `inviteToken` +\n/// `role: 'host'` + `pairingCode` — never the TV device identity), the\n/// 6-digit pairing code next to the QR (refreshed with every mint), the\n/// session scope, and the server-stated expiry. The invite always comes\n/// from the host-only `createHostInvite` response via [HostInviteClient];\n/// nothing is fabricated from build-time config.\n///\n/// Below the invite, the panel lists active host devices as LABELS ONLY\n/// (via [HostDeviceClient]) plus a revoke action per row. Device ids are\n/// never rendered; they travel only inside the `revokeHostDevice` request.\n/// Revocation is confirmed through a dialog naming the host label and\n/// stating that previews + the live manifest entry are removed; the row\n/// stays until the server confirms.\n///\n/// States: loading (no fabricated QR), ready (QR + pairing code + REFRESH\n/// re-mint), expired (stale capability hidden, refresh offered),\n/// denial/error (reason shown, last valid session retained when one\n/// exists), and unavailable (no [HostInviteClient] — the wall never opens\n/// this destination, like the offline guest-codes path).\n///\n/// Refresh is manual (REFRESH re-mints and re-lists) plus a 1s expiry\n/// ticker that hides the QR the moment the invite lapses. Overlapping\n/// mints are skipped, timers are cancelled on disposal, and late responses\n/// after disposal are ignored.\nlibrary;\n\nimport 'dart:async';\n\nimport 'package:core_foundation/core_foundation.dart';\nimport 'package:core_ui/core_ui.dart';\nimport 'package:flutter/material.dart';\nimport 'package:flutter/services.dart';\nimport 'package:qr_flutter/qr_flutter.dart';\n\nimport 'package:tv_app/src/wall/host_codes.dart';\n\n/// Key of the host code panel.\nconst Key kHostCodePanelKey = ValueKey<String>('host-code-panel');\n\n/// Key of the host-code close button.\nconst Key kHostCodeCloseKey = ValueKey<String>('host-code-close');\n\n/// Key of the host-code back button (returns to the recovery actions).\nconst Key kHostCodeBackKey = ValueKey<String>('host-code-back');\n\n/// Key of the single invite QR (present only with a live, unexpired invite).\nconst Key kHostCodeQrKey = ValueKey<String>('host-code-qr');\n\n/// Key of the session scope/expiry line.\nconst Key kHostCodeSessionKey = ValueKey<String>('host-code-session');\n\n/// Key of the pairing-code line shown next to the HOST QR.\nconst Key kHostPairingCodeKey = ValueKey<String>('host-pairing-code');\n\n/// Key of the manual refresh button.\nconst Key kHostCodeRefreshKey = ValueKey<String>('host-code-refresh');\n\n/// Key of the loading indicator text.\nconst Key kHostCodeLoadingKey = ValueKey<String>('host-code-loading');\n\n/// Key of the error text.\nconst Key kHostCodeErrorKey = ValueKey<String>('host-code-error');\n\n/// Key of the expired-invite text.\nconst Key kHostCodeExpiryKey = ValueKey<String>('host-code-expiry');\n\n/// Key of the active-host list body.\nconst Key kHostDeviceListKey = ValueKey<String>('host-device-list');\n\n/// Key of the empty-host-list text.\nconst Key kHostDeviceEmptyKey = ValueKey<String>('host-device-empty');\n\n/// Key of the host-list error text.\nconst Key kHostDeviceErrorKey = ValueKey<String>('host-device-error');\n\n/// Key of the revoke confirmation dialog.\nconst Key kHostRevokeDialogKey = ValueKey<String>('host-revoke-dialog');\n\n/// Key of the revoke confirmation button.\nconst Key kHostRevokeConfirmKey = ValueKey<String>('host-revoke-confirm');\n\n/// Key of the revoke cancellation button.\nconst Key kHostRevokeCancelKey = ValueKey<String>('host-revoke-cancel');\n\n/// Bounds a single invite mint: without this, a hung callable would hold\n/// `_fetching` true forever and wedge the panel (no retries, stale QR).\nconst Duration kHostInviteFetchTimeout = Duration(seconds: 10);\n\n/// Host panel: scoped invite QR + pairing code + host list + revoke.\n///\n/// Owns its mint: fetches immediately on open and re-evaluates expiry on a\n/// 1s ticker while mounted. Pass a fake [HostInviteClient.invoker] in widget\n/// tests; production passes the real Cloud Functions client. Pass a fake\n/// [HostDeviceClient.invoker] (or null) for the host-management section;\n/// null hides the list (offline builds stay on invite-only).\nclass HostCodePanel extends StatefulWidget {\n  /// Creates the host code panel.\n  const HostCodePanel({\n    super.key,\n    required this.client,\n    required this.onClose,\n    this.devicesClient,\n    this.onBack,\n    this.primaryFocusNode,\n    this.clock = const SystemClock(),\n  });\n\n  /// Host-only invite minter (authorization carries the TV's device id).\n  final HostInviteClient client;\n\n  /// Closes the whole overlay.\n  final VoidCallback onClose;\n\n  /// Host-management reader/revoker; null hides the host list section.\n  final HostDeviceClient? devicesClient;\n\n  /// Returns to the recovery actions; null hides the back button.\n  final VoidCallback? onBack;\n\n  /// Focus node for the first action, so the D-pad lands inside the panel.\n  final FocusNode? primaryFocusNode;\n\n  /// Clock for expiry evaluation (injectable for deterministic tests).\n  final Clock clock;\n\n  /// Revoke-button key for the row labelled [label] (labels only; the\n  /// device id never appears in the widget tree).\n  static Key revokeKeyFor(String label) =>\n      ValueKey<String>('host-device-revoke-$label');\n\n  @override\n  State<HostCodePanel> createState() => _HostCodePanelState();\n}\n\nclass _HostCodePanelState extends State<HostCodePanel> {\n  HostInvite? _invite;\n  String? _error;\n  bool _firstFetchDone = false;\n  bool _fetching = false;\n  int _generation = 0;\n  Timer? _expiryTimer;\n\n  List<HostManagedDevice> _devices = const <HostManagedDevice>[];\n  String? _devicesError;\n  bool _devicesLoading = false;\n  final Set<String> _revoking = <String>{};\n\n  @override\n  void initState() {\n    super.initState();\n    unawaited(_refresh());\n    // Re-evaluates expiry only; never re-mints on its own (invites are\n    // server-minted capabilities, not pollable state).\n    _expiryTimer = Timer.periodic(const Duration(seconds: 1), (_) {\n      if (!mounted) {\n        return;\n      }\n      final HostInvite? invite = _invite;\n      if (invite != null && invite.isExpired(widget.clock.now())) {\n        setState(() {});\n      }\n    });\n  }\n\n  @override\n  void dispose() {\n    _generation++;\n    _expiryTimer?.cancel();\n    _expiryTimer = null;\n    super.dispose();\n  }\n\n  bool get _expired {\n    final HostInvite? invite = _invite;\n    return invite != null && invite.isExpired(widget.clock.now());\n  }\n\n  Future<void> _refresh() async {\n    if (_fetching || !mounted) {\n      return;\n    }\n    _fetching = true;\n    final int generation = _generation;\n    try {\n      final HostInvite invite = await widget.client.createInvite().timeout(\n        kHostInviteFetchTimeout,\n      );\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _invite = invite;\n        _error = null;\n        _firstFetchDone = true;\n      });\n    } on TimeoutException {\n      // A hung mint releases the in-flight guard so the next REFRESH\n      // retries; the last valid invite (if any) is retained behind an\n      // inline error.\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _error = 'host invite refresh timed out';\n        _firstFetchDone = true;\n      });\n    } on Object catch (error) {\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _error = error is HostInviteException\n            ? error.message\n            : 'unexpected host invite failure';\n        _firstFetchDone = true;\n      });\n    } finally {\n      _fetching = false;\n    }\n    await _refreshDevices(generation: generation);\n  }\n\n  Future<void> _refreshDevices({required int generation}) async {\n    final HostDeviceClient? devices = widget.devicesClient;\n    if (devices == null || !mounted || generation != _generation) {\n      return;\n    }\n    if (_devicesLoading) {\n      return;\n    }\n    setState(() {\n      _devicesLoading = true;\n    });\n    try {\n      final List<HostManagedDevice> hosts = await devices\n          .listHosts()\n          .timeout(kHostInviteFetchTimeout);\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _devices = hosts;\n        _devicesError = null;\n        _devicesLoading = false;\n      });\n    } on TimeoutException {\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _devicesError = 'host list refresh timed out';\n        _devicesLoading = false;\n      });\n    } on Object catch (error) {\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _devicesError = error is HostDeviceException\n            ? error.message\n            : 'unexpected host list failure';\n        _devicesLoading = false;\n      });\n    }\n  }\n\n  Future<void> _confirmAndRevoke(HostManagedDevice target) async {\n    final bool? confirmed = await showDialog<bool>(\n      context: context,\n      builder: (BuildContext context) => AlertDialog(\n        key: kHostRevokeDialogKey,\n        title: const Text('Revoke host access?'),\n        content: Text(\n          'Remove host \"${target.displayLabel}\"? Their previews and live '\n          'manifest entry are removed immediately. This cannot be undone — '\n          'they must scan a fresh Host QR with a new pairing code to rejoin.',\n        ),\n        actions: <Widget>[\n          TextButton(\n            key: kHostRevokeCancelKey,\n            onPressed: () => Navigator.of(context).pop(false),\n            child: const Text('CANCEL'),\n          ),\n          TextButton(\n            key: kHostRevokeConfirmKey,\n            onPressed: () => Navigator.of(context).pop(true),\n            child: const Text('REVOKE'),\n          ),\n        ],\n      ),\n    );\n    if (confirmed != true || !mounted) {\n      return;\n    }\n    final HostDeviceClient? devices = widget.devicesClient;\n    if (devices == null || _revoking.contains(target.deviceId)) {\n      return;\n    }\n    // The row stays until the server confirms: selection is never cleared\n    // optimistically, so a failure stays retryable in place.\n    setState(() {\n      _revoking.add(target.deviceId);\n      _devicesError = null;\n    });\n    final int generation = _generation;\n    try {\n      await devices.revokeHost(target.deviceId);\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _revoking.remove(target.deviceId);\n      });\n      await _refreshDevices(generation: generation);\n    } on Object catch (error) {\n      if (!mounted || generation != _generation) {\n        return;\n      }\n      setState(() {\n        _revoking.remove(target.deviceId);\n        _devicesError = error is HostDeviceException\n            ? error.message\n            : 'unexpected host revoke failure';\n      });\n    }\n  }\n\n  KeyEventResult _onKey(FocusNode node, KeyEvent event) {\n    if (event is KeyDownEvent) {\n      if (event.logicalKey == LogicalKeyboardKey.contextMenu) {\n        widget.onClose();\n        return KeyEventResult.handled;\n      }\n      if (event.logicalKey == LogicalKeyboardKey.goBack ||\n          event.logicalKey == LogicalKeyboardKey.escape) {\n        (widget.onBack ?? widget.onClose)();\n        return KeyEventResult.handled;\n      }\n    }\n    return KeyEventResult.ignored;\n  }\n\n  @override\n  Widget build(BuildContext context) {\n    return Focus(\n      canRequestFocus: false,\n      skipTraversal: true,\n      onKeyEvent: _onKey,\n      child: ColoredBox(\n        color: const Color(0xE6000000),\n        child: Center(\n          child: ConstrainedBox(\n            constraints: const BoxConstraints(maxWidth: 720),\n            child: Container(\n              key: kHostCodePanelKey,\n              padding: const EdgeInsets.all(28),\n              decoration: BoxDecoration(\n                color: const Color(0xFF101410),\n                border: Border.all(color: CctvTheme.frameEdge, width: 2),\n              ),\n              child: SingleChildScrollView(\n                child: Column(\n                  mainAxisSize: MainAxisSize.min,\n                  crossAxisAlignment: CrossAxisAlignment.start,\n                  children: <Widget>[\n                    const Text('HOST QR', style: CctvTheme.labelStyle),\n                    const SizedBox(height: 8),\n                    const Text(\n                      'On the companion app, open the host entry and scan '\n                      'this code, then type the pairing code shown beside it. '\n                      'Guests use GUEST CODES instead — the guest '\n                      'PIN can never grant host access.',\n                      style: TextStyle(color: Colors.white70, fontSize: 18),\n                    ),\n                    const SizedBox(height: 20),\n                    Row(\n                      crossAxisAlignment: CrossAxisAlignment.start,\n                      children: <Widget>[\n                        Expanded(\n                          child: Column(\n                            crossAxisAlignment: CrossAxisAlignment.start,\n                            children: <Widget>[\n                              const Text(\n                                'HOST INVITE',\n                                style: TextStyle(\n                                  color: Color(0xFFFFC107),\n                                  fontSize: 20,\n                                ),\n                              ),\n                              const SizedBox(height: 4),\n                              _sessionLine(),\n                              const SizedBox(height: 12),\n                              _pairingLine(),\n                            ],\n                          ),\n                        ),\n                        _qrBox(),\n                      ],\n                    ),\n                    const SizedBox(height: 8),\n                    _stateLine(),\n                    if (widget.devicesClient != null) ...<Widget>[\n                      const SizedBox(height: 20),\n                      const Text(\n                        'ACTIVE HOSTS',\n                        style: TextStyle(\n                          color: Color(0xFFFFC107),\n                          fontSize: 20,\n                        ),\n                      ),\n                      const SizedBox(height: 8),\n                      _hostListBody(),\n                    ],\n                    const SizedBox(height: 20),\n                    FocusTraversalGroup(\n                      child: Column(\n                        mainAxisSize: MainAxisSize.min,\n                        crossAxisAlignment: CrossAxisAlignment.stretch,\n                        children: <Widget>[\n                          if (widget.onBack != null)\n                            _PanelButton(\n                              actionKey: kHostCodeBackKey,\n                              label: 'BACK',\n                              focusNode: widget.primaryFocusNode,\n                              onPressed: widget.onBack!,\n                            ),\n                          if (widget.onBack != null) const SizedBox(height: 10),\n                          _PanelButton(\n                            actionKey: kHostCodeRefreshKey,\n                            label: 'REFRESH',\n                            focusNode: widget.onBack == null\n                                ? widget.primaryFocusNode\n                                : null,\n                            onPressed: () => unawaited(_refresh()),\n                          ),\n                          const SizedBox(height: 10),\n                          _PanelButton(\n                            actionKey: kHostCodeCloseKey,\n                            label: 'CLOSE',\n                            onPressed: widget.onClose,\n                          ),\n                        ],\n                      ),\n                    ),\n                  ],\n                ),\n              ),\n            ),\n          ),\n        ),\n      ),\n    );\n  }\n\n  Widget _sessionLine() {\n    final HostInvite? invite = _invite;\n    if (invite == null) {\n      return Text(\n        'party ${widget.client.partyId} · ${widget.client.channelId}',\n        key: kHostCodeSessionKey,\n        style: const TextStyle(color: Colors.white70, fontSize: 18),\n      );\n    }\n    return Text(\n      'party ${invite.partyId} · ${invite.channelId} · '\n      'expires ${invite.expiresAt.toUtc().toIso8601String()}',\n      key: kHostCodeSessionKey,\n      style: const TextStyle(color: Colors.white70, fontSize: 18),\n    );\n  }\n\n  /// The 6-digit pairing code beside the HOST QR, refreshed with every\n  /// mint. Hidden while no live, unexpired invite exists.\n  Widget _pairingLine() {\n    final HostInvite? invite = _invite;\n    if (invite == null || _expired) {\n      return const SizedBox.shrink();\n    }\n    return Column(\n      crossAxisAlignment: CrossAxisAlignment.start,\n      mainAxisSize: MainAxisSize.min,\n      children: <Widget>[\n        const Text(\n          'PAIRING CODE',\n          style: TextStyle(color: Color(0xFFFFC107), fontSize: 20),\n        ),\n        const SizedBox(height: 4),\n        Text(\n          invite.pairingCode,\n          key: kHostPairingCodeKey,\n          style: const TextStyle(\n            color: Colors.white,\n            fontSize: 44,\n            fontWeight: FontWeight.bold,\n          ),\n        ),\n      ],\n    );\n  }\n\n  /// Exactly one QR while a live, unexpired invite exists; no fabricated\n  /// QR before the first successful mint, and the stale capability is\n  /// hidden the moment it lapses.\n  Widget _qrBox() {\n    final HostInvite? invite = _invite;\n    if (invite == null || _expired) {\n      return Container(\n        width: 204,\n        height: 204,\n        alignment: Alignment.center,\n        decoration: BoxDecoration(\n          border: Border.all(color: CctvTheme.frameEdge),\n        ),\n        child: Text(\n          _expired ? 'Invite expired — refresh.' : 'Waiting for invite…',\n          textAlign: TextAlign.center,\n          style: const TextStyle(color: Colors.white70, fontSize: 16),\n        ),\n      );\n    }\n    final String payload = buildHostJoinPayload(\n      partyId: invite.partyId,\n      channelId: invite.channelId,\n      inviteToken: invite.inviteToken,\n      pairingCode: invite.pairingCode,\n    );\n    return Container(\n      padding: const EdgeInsets.all(12),\n      color: Colors.white,\n      child: QrImageView(\n        key: kHostCodeQrKey,\n        data: payload,\n        semanticsLabel: payload,\n        size: 180,\n        backgroundColor: Colors.white,\n      ),\n    );\n  }\n\n  Widget _stateLine() {\n    if (!_firstFetchDone && _invite == null && _error == null) {\n      return const Text(\n        'Minting host invite…',\n        key: kHostCodeLoadingKey,\n        style: TextStyle(color: Colors.white70, fontSize: 22),\n      );\n    }\n    // First mint failed with nothing valid to show: error, no QR.\n    if (_invite == null && _error != null) {\n      return Text(\n        'Host invite unavailable: $_error',\n        key: kHostCodeErrorKey,\n        style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n      );\n    }\n    if (_expired) {\n      return Column(\n        crossAxisAlignment: CrossAxisAlignment.start,\n        mainAxisSize: MainAxisSize.min,\n        children: <Widget>[\n          const Text(\n            'Invite expired — refresh for a new code.',\n            key: kHostCodeExpiryKey,\n            style: TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n          ),\n          if (_error != null)\n            Padding(\n              padding: const EdgeInsets.only(top: 8),\n              child: Text(\n                'Refresh failed: $_error — showing last invite.',\n                key: kHostCodeErrorKey,\n                style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n              ),\n            ),\n        ],\n      );\n    }\n    if (_error != null) {\n      return Text(\n        'Refresh failed: $_error — showing last invite.',\n        key: kHostCodeErrorKey,\n        style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n      );\n    }\n    return const SizedBox.shrink();\n  }\n\n  /// Active hosts as labels only (device ids never rendered), each with a\n  /// revoke action behind a confirmation dialog.\n  Widget _hostListBody() {\n    if (_devicesLoading && _devices.isEmpty && _devicesError == null) {\n      return const Text(\n        'Loading hosts…',\n        style: TextStyle(color: Colors.white70, fontSize: 22),\n      );\n    }\n    if (_devices.isEmpty && _devicesError != null) {\n      return Text(\n        'Host list unavailable: $_devicesError',\n        key: kHostDeviceErrorKey,\n        style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n      );\n    }\n    if (_devices.isEmpty) {\n      return Column(\n        crossAxisAlignment: CrossAxisAlignment.start,\n        mainAxisSize: MainAxisSize.min,\n        children: <Widget>[\n          const Text(\n            'No other hosts yet — new hosts appear here automatically.',\n            key: kHostDeviceEmptyKey,\n            style: TextStyle(color: Colors.white70, fontSize: 22),\n          ),\n          if (_devicesError != null)\n            Padding(\n              padding: const EdgeInsets.only(top: 8),\n              child: Text(\n                'Refresh failed: $_devicesError — showing last list.',\n                key: kHostDeviceErrorKey,\n                style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n              ),\n            ),\n        ],\n      );\n    }\n    return Column(\n      key: kHostDeviceListKey,\n      crossAxisAlignment: CrossAxisAlignment.start,\n      mainAxisSize: MainAxisSize.min,\n      children: <Widget>[\n        for (final HostManagedDevice entry in _devices)\n          Padding(\n            padding: const EdgeInsets.symmetric(vertical: 4),\n            child: Row(\n              children: <Widget>[\n                Expanded(\n                  child: Text(\n                    entry.displayLabel,\n                    style: const TextStyle(\n                      color: Colors.white,\n                      fontSize: 26,\n                    ),\n                  ),\n                ),\n                if (_revoking.contains(entry.deviceId))\n                  const SizedBox(\n                    width: 24,\n                    height: 24,\n                    child: CircularProgressIndicator(strokeWidth: 2),\n                  )\n                else\n                  TextButton(\n                    key: HostCodePanel.revokeKeyFor(entry.displayLabel),\n                    onPressed: () => unawaited(_confirmAndRevoke(entry)),\n                    child: const Text('REVOKE'),\n                  ),\n              ],\n            ),\n          ),\n        if (_devicesError != null)\n          Padding(\n            padding: const EdgeInsets.only(top: 8),\n            child: Text(\n              'Refresh failed: $_devicesError — showing last list.',\n              key: kHostDeviceErrorKey,\n              style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n            ),\n          ),\n      ],\n    );\n  }\n}\n\n/// Large, TV-focusable panel action.\nclass _PanelButton extends StatelessWidget {\n  const _PanelButton({\n    required this.actionKey,\n    required this.label,\n    required this.onPressed,\n    this.focusNode,\n  });\n\n  final Key actionKey;\n  final String label;\n  final VoidCallback onPressed;\n  final FocusNode? focusNode;\n\n  @override\n  Widget build(BuildContext context) {\n    return OutlinedButton(\n      key: actionKey,\n      focusNode: focusNode,\n      onPressed: onPressed,\n      style: OutlinedButton.styleFrom(\n        foregroundColor: Colors.white,\n        side: const BorderSide(color: CctvTheme.frameEdge, width: 2),\n        padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16),\n        textStyle: CctvTheme.badgeStyle,\n      ),\n      child: Align(alignment: Alignment.centerLeft, child: Text(label)),\n    );\n  }\n}\n","path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/host_code_panel.dart"},"output":"Wrote file successfully: apps/tv_app/lib/src/wall/host_code_panel.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: apps/tv_app/lib/src/wall/host_code_panel.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c6ef6a76929dc30f8a12f38cc0"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"/// Host invite panel (TV settings panel, separately labelled HOST QR).\\n///\\n/// Shows exactly one QR encoding the scoped host invite capability\\n/// ([buildHostJoinPayload]: `partyId` + `channelId` + `inviteToken` +\\n/// `role: 'host'` + `pairingCode` — never the TV device identity), the\\n/// 6-digit pairing code next to the QR (refreshed with every mint), the\\n/// session scope, and the server-stated expiry. The invite always comes\\n/// from the host-only `createHostInvite` response via [HostInviteClient];\\n/// nothing is fabricated from build-time config.\\n///\\n/// Below the invite, the panel lists active host devices as LABELS ONLY\\n/// (via [HostDeviceClient]) plus a revoke action per row. Device ids are\\n/// never rendered; they travel only inside the `revokeHostDevice` request.\\n/// Revocation is confirmed through a dialog naming the host label and\\n/// stating that previews + the live manifest entry are removed; the row\\n/// stays until the server confirms.\\n///\\n/// States: loading (no fabricated QR), ready (QR + pairing code + REFRESH\\n/// re-mint), expired (stale capability hidden, refresh offered),\\n/// denial/error (reason shown, last valid session retained when one\\n/// exists), and unavailable (no [HostInviteClient] — the wall never opens\\n/// this destination, like the offline guest-codes path).\\n///\\n/// Refresh is manual (REFRESH re-mints and re-lists) plus a 1s expiry\\n/// ticker that hides the QR the moment the invite lapses. Overlapping\\n/// mints are skipped, timers are cancelled on disposal, and late responses\\n/// after disposal are ignored.\\nlibrary;\\n\\nimport 'dart:async';\\n\\nimport 'package:core_foundation/core_foundation.dart';\\nimport 'package:core_ui/core_ui.dart';\\nimport 'package:flutter/material.dart';\\nimport 'package:flutter/services.dart';\\nimport 'package:qr_flutter/qr_flutter.dart';\\n\\nimport 'package:tv_app/src/wall/host_codes.dart';\\n\\n/// Key of the host code panel.\\nconst Key kHostCodePanelKey = ValueKey<String>('host-code-panel');\\n\\n/// Key of the host-code close button.\\nconst Key kHostCodeCloseKey = ValueKey<String>('host-code-close');\\n\\n/// Key of the host-code back button (returns to the recovery actions).\\nconst Key kHostCodeBackKey = ValueKey<String>('host-code-back');\\n\\n/// Key of the single invite QR (present only with a live, unexpired invite).\\nconst Key kHostCodeQrKey = ValueKey<String>('host-code-qr');\\n\\n/// Key of the session scope/expiry line.\\nconst Key kHostCodeSessionKey = ValueKey<String>('host-code-session');\\n\\n/// Key of the pairing-code line shown next to the HOST QR.\\nconst Key kHostPairingCodeKey = ValueKey<String>('host-pairing-code');\\n\\n/// Key of the manual refresh button.\\nconst Key kHostCodeRefreshKey = ValueKey<String>('host-code-refresh');\\n\\n/// Key of the loading indicator text.\\nconst Key kHostCodeLoadingKey = ValueKey<String>('host-code-loading');\\n\\n/// Key of the error text.\\nconst Key kHostCodeErrorKey = ValueKey<String>('host-code-error');\\n\\n/// Key of the expired-invite text.\\nconst Key kHostCodeExpiryKey = ValueKey<String>('host-code-expiry');\\n\\n/// Key of the active-host list body.\\nconst Key kHostDeviceListKey = ValueKey<String>('host-device-list');\\n\\n/// Key of the empty-host-list text.\\nconst Key kHostDeviceEmptyKey = ValueKey<String>('host-device-empty');\\n\\n/// Key of the host-list error text.\\nconst Key kHostDeviceErrorKey = ValueKey<String>('host-device-error');\\n\\n/// Key of the revoke confirmation dialog.\\nconst Key kHostRevokeDialogKey = ValueKey<String>('host-revoke-dialog');\\n\\n/// Key of the revoke confirmation button.\\nconst Key kHostRevokeConfirmKey = ValueKey<String>('host-revoke-confirm');\\n\\n/// Key of the revoke cancellation button.\\nconst Key kHostRevokeCancelKey = ValueKey<String>('host-revoke-cancel');\\n\\n/// Bounds a single invite mint: without this, a hung callable would hold\\n/// `_fetching` true forever and wedge the panel (no retries, stale QR).\\nconst Duration kHostInviteFetchTimeout = Duration(seconds: 10);\\n\\n/// Host panel: scoped invite QR + pairing code + host list + revoke.\\n///\\n/// Owns its mint: fetches immediately on open and re-evaluates expiry on a\\n/// 1s ticker while mounted. Pass a fake [HostInviteClient.invoker] in widget\\n/// tests; production passes the real Cloud Functions client. Pass a fake\\n/// [HostDeviceClient.invoker] (or null) for the host-management section;\\n/// null hides the list (offline builds stay on invite-only).\\nclass HostCodePanel extends StatefulWidget {\\n  /// Creates the host code panel.\\n  const HostCodePanel({\\n    super.key,\\n    required this.client,\\n    required this.onClose,\\n    this.devicesClient,\\n    this.onBack,\\n    this.primaryFocusNode,\\n    this.clock = const SystemClock(),\\n  });\\n\\n  /// Host-only invite minter (authorization carries the TV's device id).\\n  final HostInviteClient client;\\n\\n  /// Closes the whole overlay.\\n  final VoidCallback onClose;\\n\\n  /// Host-management reader/revoker; null hides the host list section.\\n  final HostDeviceClient? devicesClient;\\n\\n  /// Returns to the recovery actions; null hides the back button.\\n  final VoidCallback? onBack;\\n\\n  /// Focus node for the first action, so the D-pad lands inside the panel.\\n  final FocusNode? primaryFocusNode;\\n\\n  /// Clock for expiry evaluation (injectable for deterministic tests).\\n  final Clock clock;\\n\\n  /// Revoke-button key for the row labelled [label] (labels only; the\\n  /// device id never appears in the widget tree).\\n  static Key revokeKeyFor(String label) =>\\n      ValueKey<String>('host-device-revoke-$label');\\n\\n  @override\\n  State<HostCodePanel> createState() => _HostCodePanelState();\\n}\\n\\nclass _HostCodePanelState extends State<HostCodePanel> {\\n  HostInvite? _invite;\\n  String? _error;\\n  bool _firstFetchDone = false;\\n  bool _fetching = false;\\n  int _generation = 0;\\n  Timer? _expiryTimer;\\n\\n  List<HostManagedDevice> _devices = const <HostManagedDevice>[];\\n  String? _devicesError;\\n  bool _devicesLoading = false;\\n  final Set<String> _revoking = <String>{};\\n\\n  @override\\n  void initState() {\\n    super.initState();\\n    unawaited(_refresh());\\n    // Re-evaluates expiry only; never re-mints on its own (invites are\\n    // server-minted capabilities, not pollable state).\\n    _expiryTimer = Timer.periodic(const Duration(seconds: 1), (_) {\\n      if (!mounted) {\\n        return;\\n      }\\n      final HostInvite? invite = _invite;\\n      if (invite != null && invite.isExpired(widget.clock.now())) {\\n        setState(() {});\\n      }\\n    });\\n  }\\n\\n  @override\\n  void dispose() {\\n    _generation++;\\n    _expiryTimer?.cancel();\\n    _expiryTimer = null;\\n    super.dispose();\\n  }\\n\\n  bool get _expired {\\n    final HostInvite? invite = _invite;\\n    return invite != null && invite.isExpired(widget.clock.now());\\n  }\\n\\n  Future<void> _refresh() async {\\n    if (_fetching || !mounted) {\\n      return;\\n    }\\n    _fetching = true;\\n    final int generation = _generation;\\n    try {\\n      final HostInvite invite = await widget.client.createInvite().timeout(\\n        kHostInviteFetchTimeout,\\n      );\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _invite = invite;\\n        _error = null;\\n        _firstFetchDone = true;\\n      });\\n    } on TimeoutException {\\n      // A hung mint releases the in-flight guard so the next REFRESH\\n      // retries; the last valid invite (if any) is retained behind an\\n      // inline error.\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _error = 'host invite refresh timed out';\\n        _firstFetchDone = true;\\n      });\\n    } on Object catch (error) {\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _error = error is HostInviteException\\n            ? error.message\\n            : 'unexpected host invite failure';\\n        _firstFetchDone = true;\\n      });\\n    } finally {\\n      _fetching = false;\\n    }\\n    await _refreshDevices(generation: generation);\\n  }\\n\\n  Future<void> _refreshDevices({required int generation}) async {\\n    final HostDeviceClient? devices = widget.devicesClient;\\n    if (devices == null || !mounted || generation != _generation) {\\n      return;\\n    }\\n    if (_devicesLoading) {\\n      return;\\n    }\\n    setState(() {\\n      _devicesLoading = true;\\n    });\\n    try {\\n      final List<HostManagedDevice> hosts = await devices\\n          .listHosts()\\n          .timeout(kHostInviteFetchTimeout);\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _devices = hosts;\\n        _devicesError = null;\\n        _devicesLoading = false;\\n      });\\n    } on TimeoutException {\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _devicesError = 'host list refresh timed out';\\n        _devicesLoading = false;\\n      });\\n    } on Object catch (error) {\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _devicesError = error is HostDeviceException\\n            ? error.message\\n            : 'unexpected host list failure';\\n        _devicesLoading = false;\\n      });\\n    }\\n  }\\n\\n  Future<void> _confirmAndRevoke(HostManagedDevice target) async {\\n    final bool? confirmed = await showDialog<bool>(\\n      context: context,\\n      builder: (BuildContext context) => AlertDialog(\\n        key: kHostRevokeDialogKey,\\n        title: const Text('Revoke host access?'),\\n        content: Text(\\n          'Remove host \\\"${target.displayLabel}\\\"? Their previews and live '\\n          'manifest entry are removed immediately. This cannot be undone — '\\n          'they must scan a fresh Host QR with a new pairing code to rejoin.',\\n        ),\\n        actions: <Widget>[\\n          TextButton(\\n            key: kHostRevokeCancelKey,\\n            onPressed: () => Navigator.of(context).pop(false),\\n            child: const Text('CANCEL'),\\n          ),\\n          TextButton(\\n            key: kHostRevokeConfirmKey,\\n            onPressed: () => Navigator.of(context).pop(true),\\n            child: const Text('REVOKE'),\\n          ),\\n        ],\\n      ),\\n    );\\n    if (confirmed != true || !mounted) {\\n      return;\\n    }\\n    final HostDeviceClient? devices = widget.devicesClient;\\n    if (devices == null || _revoking.contains(target.deviceId)) {\\n      return;\\n    }\\n    // The row stays until the server confirms: selection is never cleared\\n    // optimistically, so a failure stays retryable in place.\\n    setState(() {\\n      _revoking.add(target.deviceId);\\n      _devicesError = null;\\n    });\\n    final int generation = _generation;\\n    try {\\n      await devices.revokeHost(target.deviceId);\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _revoking.remove(target.deviceId);\\n      });\\n      await _refreshDevices(generation: generation);\\n    } on Object catch (error) {\\n      if (!mounted || generation != _generation) {\\n        return;\\n      }\\n      setState(() {\\n        _revoking.remove(target.deviceId);\\n        _devicesError = error is HostDeviceException\\n            ? error.message\\n            : 'unexpected host revoke failure';\\n      });\\n    }\\n  }\\n\\n  KeyEventResult _onKey(FocusNode node, KeyEvent event) {\\n    if (event is KeyDownEvent) {\\n      if (event.logicalKey == LogicalKeyboardKey.contextMenu) {\\n        widget.onClose();\\n        return KeyEventResult.handled;\\n      }\\n      if (event.logicalKey == LogicalKeyboardKey.goBack ||\\n          event.logicalKey == LogicalKeyboardKey.escape) {\\n        (widget.onBack ?? widget.onClose)();\\n        return KeyEventResult.handled;\\n      }\\n    }\\n    return KeyEventResult.ignored;\\n  }\\n\\n  @override\\n  Widget build(BuildContext context) {\\n    return Focus(\\n      canRequestFocus: false,\\n      skipTraversal: true,\\n      onKeyEvent: _onKey,\\n      child: ColoredBox(\\n        color: const Color(0xE6000000),\\n        child: Center(\\n          child: ConstrainedBox(\\n            constraints: const BoxConstraints(maxWidth: 720),\\n            child: Container(\\n              key: kHostCodePanelKey,\\n              padding: const EdgeInsets.all(28),\\n              decoration: BoxDecoration(\\n                color: const Color(0xFF101410),\\n                border: Border.all(color: CctvTheme.frameEdge, width: 2),\\n              ),\\n              child: SingleChildScrollView(\\n                child: Column(\\n                  mainAxisSize: MainAxisSize.min,\\n                  crossAxisAlignment: CrossAxisAlignment.start,\\n                  children: <Widget>[\\n                    const Text('HOST QR', style: CctvTheme.labelStyle),\\n                    const SizedBox(height: 8),\\n                    const Text(\\n                      'On the companion app, open the host entry and scan '\\n                      'this code, then type the pairing code shown beside it. '\\n                      'Guests use GUEST CODES instead — the guest '\\n                      'PIN can never grant host access.',\\n                      style: TextStyle(color: Colors.white70, fontSize: 18),\\n                    ),\\n                    const SizedBox(height: 20),\\n                    Row(\\n                      crossAxisAlignment: CrossAxisAlignment.start,\\n                      children: <Widget>[\\n                        Expanded(\\n                          child: Column(\\n                            crossAxisAlignment: CrossAxisAlignment.start,\\n                            children: <Widget>[\\n                              const Text(\\n                                'HOST INVITE',\\n                                style: TextStyle(\\n                                  color: Color(0xFFFFC107),\\n                                  fontSize: 20,\\n                                ),\\n                              ),\\n                              const SizedBox(height: 4),\\n                              _sessionLine(),\\n                              const SizedBox(height: 12),\\n                              _pairingLine(),\\n                            ],\\n                          ),\\n                        ),\\n                        _qrBox(),\\n                      ],\\n                    ),\\n                    const SizedBox(height: 8),\\n                    _stateLine(),\\n                    if (widget.devicesClient != null) ...<Widget>[\\n                      const SizedBox(height: 20),\\n                      const Text(\\n                        'ACTIVE HOSTS',\\n                        style: TextStyle(\\n                          color: Color(0xFFFFC107),\\n                          fontSize: 20,\\n                        ),\\n                      ),\\n                      const SizedBox(height: 8),\\n                      _hostListBody(),\\n                    ],\\n                    const SizedBox(height: 20),\\n                    FocusTraversalGroup(\\n                      child: Column(\\n                        mainAxisSize: MainAxisSize.min,\\n                        crossAxisAlignment: CrossAxisAlignment.stretch,\\n                        children: <Widget>[\\n                          if (widget.onBack != null)\\n                            _PanelButton(\\n                              actionKey: kHostCodeBackKey,\\n                              label: 'BACK',\\n                              focusNode: widget.primaryFocusNode,\\n                              onPressed: widget.onBack!,\\n                            ),\\n                          if (widget.onBack != null) const SizedBox(height: 10),\\n                          _PanelButton(\\n                            actionKey: kHostCodeRefreshKey,\\n                            label: 'REFRESH',\\n                            focusNode: widget.onBack == null\\n                                ? widget.primaryFocusNode\\n                                : null,\\n                            onPressed: () => unawaited(_refresh()),\\n                          ),\\n                          const SizedBox(height: 10),\\n                          _PanelButton(\\n                            actionKey: kHostCodeCloseKey,\\n                            label: 'CLOSE',\\n                            onPressed: widget.onClose,\\n                          ),\\n                        ],\\n                      ),\\n                    ),\\n                  ],\\n                ),\\n              ),\\n            ),\\n          ),\\n        ),\\n      ),\\n    );\\n  }\\n\\n  Widget _sessionLine() {\\n    final HostInvite? invite = _invite;\\n    if (invite == null) {\\n      return Text(\\n        'party ${widget.client.partyId} · ${widget.client.channelId}',\\n        key: kHostCodeSessionKey,\\n        style: const TextStyle(color: Colors.white70, fontSize: 18),\\n      );\\n    }\\n    return Text(\\n      'party ${invite.partyId} · ${invite.channelId} · '\\n      'expires ${invite.expiresAt.toUtc().toIso8601String()}',\\n      key: kHostCodeSessionKey,\\n      style: const TextStyle(color: Colors.white70, fontSize: 18),\\n    );\\n  }\\n\\n  /// The 6-digit pairing code beside the HOST QR, refreshed with every\\n  /// mint. Hidden while no live, unexpired invite exists.\\n  Widget _pairingLine() {\\n    final HostInvite? invite = _invite;\\n    if (invite == null || _expired) {\\n      return const SizedBox.shrink();\\n    }\\n    return Column(\\n      crossAxisAlignment: CrossAxisAlignment.start,\\n      mainAxisSize: MainAxisSize.min,\\n      children: <Widget>[\\n        const Text(\\n          'PAIRING CODE',\\n          style: TextStyle(color: Color(0xFFFFC107), fontSize: 20),\\n        ),\\n        const SizedBox(height: 4),\\n        Text(\\n          invite.pairingCode,\\n          key: kHostPairingCodeKey,\\n          style: const TextStyle(\\n            color: Colors.white,\\n            fontSize: 44,\\n            fontWeight: FontWeight.bold,\\n          ),\\n        ),\\n      ],\\n    );\\n  }\\n\\n  /// Exactly one QR while a live, unexpired invite exists; no fabricated\\n  /// QR before the first successful mint, and the stale capability is\\n  /// hidden the moment it lapses.\\n  Widget _qrBox() {\\n    final HostInvite? invite = _invite;\\n    if (invite == null || _expired) {\\n      return Container(\\n        width: 204,\\n        height: 204,\\n        alignment: Alignment.center,\\n        decoration: BoxDecoration(\\n          border: Border.all(color: CctvTheme.frameEdge),\\n        ),\\n        child: Text(\\n          _expired ? 'Invite expired — refresh.' : 'Waiting for invite…',\\n          textAlign: TextAlign.center,\\n          style: const TextStyle(color: Colors.white70, fontSize: 16),\\n        ),\\n      );\\n    }\\n    final String payload = buildHostJoinPayload(\\n      partyId: invite.partyId,\\n      channelId: invite.channelId,\\n      inviteToken: invite.inviteToken,\\n      pairingCode: invite.pairingCode,\\n    );\\n    return Container(\\n      padding: const EdgeInsets.all(12),\\n      color: Colors.white,\\n      child: QrImageView(\\n        key: kHostCodeQrKey,\\n        data: payload,\\n        semanticsLabel: payload,\\n        size: 180,\\n        backgroundColor: Colors.white,\\n      ),\\n    );\\n  }\\n\\n  Widget _stateLine() {\\n    if (!_firstFetchDone && _invite == null && _error == null) {\\n      return const Text(\\n        'Minting host invite…',\\n        key: kHostCodeLoadingKey,\\n        style: TextStyle(color: Colors.white70, fontSize: 22),\\n      );\\n    }\\n    // First mint failed with nothing valid to show: error, no QR.\\n    if (_invite == null && _error != null) {\\n      return Text(\\n        'Host invite unavailable: $_error',\\n        key: kHostCodeErrorKey,\\n        style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\\n      );\\n    }\\n    if (_expired) {\\n      return Column(\\n        crossAxisAlignment: CrossAxisAlignment.start,\\n        mainAxisSize: MainAxisSize.min,\\n        children: <Widget>[\\n          const Text(\\n            'Invite expired — refresh for a new code.',\\n            key: kHostCodeExpiryKey,\\n            style: TextStyle(color: Color(0xFFFFC107), fontSize: 22),\\n          ),\\n          if (_error != null)\\n            Padding(\\n              padding: const EdgeInsets.only(top: 8),\\n              child: Text(\\n                'Refresh failed: $_error — showing last invite.',\\n                key: kHostCodeErrorKey,\\n                style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\\n              ),\\n            ),\\n        ],\\n      );\\n    }\\n    if (_error != null) {\\n      return Text(\\n        'Refresh failed: $_error — showing last invite.',\\n        key: kHostCodeErrorKey,\\n        style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\\n      );\\n    }\\n    return const SizedBox.shrink();\\n  }\\n\\n  /// Active hosts as labels only (device ids never rendered), each with a\\n  /// revoke action behind a confirmation dialog.\\n  Widget _hostListBody() {\\n    if (_devicesLoading && _devices.isEmpty && _devicesError == null) {\\n      return const Text(\\n        'Loading hosts…',\\n        style: TextStyle(color: Colors.white70, fontSize: 22),\\n      );\\n    }\\n    if (_devices.isEmpty && _devicesError != null) {\\n      return Text(\\n        'Host list unavailable: $_devicesError',\\n        key: kHostDeviceErrorKey,\\n        style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\\n      );\\n    }\\n    if (_devices.isEmpty) {\\n      return Column(\\n        crossAxisAlignment: CrossAxisAlignment.start,\\n        mainAxisSize: MainAxisSize.min,\\n        children: <Widget>[\\n          const Text(\\n            'No other hosts yet — new hosts appear here automatically.',\\n            key: kHostDeviceEmptyKey,\\n            style: TextStyle(color: Colors.white70, fontSize: 22),\\n          ),\\n          if (_devicesError != null)\\n            Padding(\\n              padding: const EdgeInsets.only(top: 8),\\n              child: Text(\\n                'Refresh failed: $_devicesError — showing last list.',\\n                key: kHostDeviceErrorKey,\\n                style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\\n              ),\\n            ),\\n        ],\\n      );\\n    }\\n    return Column(\\n      key: kHostDeviceListKey,\\n      crossAxisAlignment: CrossAxisAlignment.start,\\n      mainAxisSize: MainAxisSize.min,\\n      children: <Widget>[\\n        for (final HostManagedDevice entry in _devices)\\n          Padding(\\n            padding: const EdgeInsets.symmetric(vertical: 4),\\n            child: Row(\\n              children: <Widget>[\\n                Expanded(\\n                  child: Text(\\n                    entry.displayLabel,\\n                    style: const TextStyle(\\n                      color: Colors.white,\\n                      fontSize: 26,\\n                    ),\\n                  ),\\n                ),\\n                if (_revoking.contains(entry.deviceId))\\n                  const SizedBox(\\n                    width: 24,\\n                    height: 24,\\n                    child: CircularProgressIndicator(strokeWidth: 2),\\n                  )\\n                else\\n                  TextButton(\\n                    key: HostCodePanel.revokeKeyFor(entry.displayLabel),\\n                    onPressed: () => unawaited(_confirmAndRevoke(entry)),\\n                    child: const Text('REVOKE'),\\n                  ),\\n              ],\\n            ),\\n          ),\\n        if (_devicesError != null)\\n          Padding(\\n            padding: const EdgeInsets.only(top: 8),\\n            child: Text(\\n              'Refresh failed: $_devicesError — showing last list.',\\n              key: kHostDeviceErrorKey,\\n              style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\\n            ),\\n          ),\\n      ],\\n    );\\n  }\\n}\\n\\n/// Large, TV-focusable panel action.\\nclass _PanelButton extends StatelessWidget {\\n  const _PanelButton({\\n    required this.actionKey,\\n    required this.label,\\n    required this.onPressed,\\n    this.focusNode,\\n  });\\n\\n  final Key actionKey;\\n  final String label;\\n  final VoidCallback onPressed;\\n  final FocusNode? focusNode;\\n\\n  @override\\n  Widget build(BuildContext context) {\\n    return OutlinedButton(\\n      key: actionKey,\\n      focusNode: focusNode,\\n      onPressed: onPressed,\\n      style: OutlinedButton.styleFrom(\\n        foregroundColor: Colors.white,\\n        side: const BorderSide(color: CctvTheme.frameEdge, width: 2),\\n        padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16),\\n        textStyle: CctvTheme.badgeStyle,\\n      ),\\n      child: Align(alignment: Alignment.centerLeft, child: Text(label)),\\n    );\\n  }\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/lib/src/wall/host_code_panel.dart\"}"},"time":{"start":1793463873493,"end":1793463903769}}}}
