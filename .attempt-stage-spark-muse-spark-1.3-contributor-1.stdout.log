{"type":"tool_use","timestamp":1793463628351,"sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","part":{"partID":"prt_192c32f51001Ulb54xLRK7zbOo","sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","messageID":"msg_192c32afd001ZnFDDRaZ9w87Gb","type":"tool","id":"call_01a192c32eb97477a7a6f8760506e239","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/delivery.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/delivery.ts, lines 1-551\n1: import { createHash } from \"node:crypto\";\n2: import { Bucket, File } from \"@google-cloud/storage\";\n3: import { FieldValue, Firestore, Timestamp } from \"firebase-admin/firestore\";\n4: import {\n5:   AckInput,\n6:   ackIdempotencyKey,\n7:   BackendError,\n8:   CanonicalClip,\n9:   CurrentManifestInput,\n10:   DeliveryManifest,\n11:   Identity,\n12:   canonicalManifestHash,\n13:   parseAck,\n14:   parseCurrentManifestInput,\n15:   parseRequestGeneration,\n16:   RequestGenerationInput,\n17:   requireIdentity,\n18:   validateCanonicalClips,\n19: } from \"./contracts\";\n20: import {\n21:   CHEAP_DEMO_PRESET,\n22:   DELIVERY_URL_TTL_SECONDS,\n23:   MEDIA_RETENTION_MS,\n24:   REQUIRED_CAMERA_IDS,\n25:   SUPPORTED_CAMERA_COUNTS,\n26:   SCHEMA_VERSION,\n27:   expectedCameraIds,\n28: } from \"./config\";\n29: import { assertRegisteredPartyDevice } from \"./auth\";\n30: \n31: export interface GeneratedClipInput {\n32:   cameraId: string;\n33:   sourcePath: string;\n34:   sha256: string;\n35:   durationMs: number;\n36:   sizeBytes: number;\n37: }\n38: \n39: export interface GenerationTask {\n40:   partyId: string;\n41:   deviceId: string;\n42:   channelId: string;\n43:   jobId: string;\n44:   idempotencyKey: string;\n45: }\n46: \n47: export interface DeliveryServiceOptions {\n48:   db: Firestore;\n49:   bucket: Bucket;\n50:   enqueueGeneration?: (task: GenerationTask) => Promise<void>;\n51:   generationRunner?: (job: FirebaseFirestore.DocumentData) => Promise<void>;\n52:   signReadUrl?: (file: File, expiresAt: Date) => Promise<string>;\n53:   deleteDeliveryObject?: (file: File) => Promise<void>;\n54:   now?: () => Date;\n55: }\n56: \n57: export interface DeliveryServices {\n58:   requestGeneration(value: unknown): Promise<{ jobId: string; state: string; created: boolean }>;\n59:   runGeneration(task: GenerationTask): Promise<{ jobId: string; state: string }>;\n60:   normalizeAndStage(jobId: string, clips: GeneratedClipInput[]): Promise<DeliveryManifest>;\n61:   publishManifest(jobId: string, idempotencyKey: string): Promise<DeliveryManifest>;\n62:   getCurrentManifest(value: unknown): Promise<SerializedDeliveryManifest>;\n63:   getDeliveryUrls(value: unknown): Promise<{ manifestVersion: number; manifestHash: string; clips: Array<{ cameraId: string; sha256: string; url: string; expiresAt: string }> }>;\n64:   acknowledgeDelivery(value: unknown): Promise<{ ackId: string; manifestVersion: number; purged: boolean }>;\n65: }\n66: \n67: export interface SerializedDeliveryManifest extends Omit<DeliveryManifest, \"cameraClips\" | \"createdAt\"> {\n68:   cameraClips: Array<Pick<CanonicalClip, \"cameraId\" | \"objectPath\" | \"sha256\" | \"sizeBytes\" | \"durationMs\" | \"expiresAt\">>;\n69:   createdAt: string;\n70: }\n71: \n72: const defaultRunner = async (): Promise<void> => {\n73:   // p4 supplies the billable generation adapter. p1 must never make that call.\n74:   throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation provider is not configured.\");\n75: };\n76: \n77: function manifestRef(db: Firestore, partyId: string, channelId: string) {\n78:   return db.doc(`parties/${partyId}/manifests/current_${channelId}`);\n79: }\n80: \n81: function jobRef(db: Firestore, partyId: string, jobId: string) {\n82:   return db.doc(`parties/${partyId}/jobs/${jobId}`);\n83: }\n84: \n85: function costLogRef(db: Firestore, partyId: string, jobId: string) {\n86:   return db.doc(`parties/${partyId}/costLogs/${jobId}`);\n87: }\n88: \n89: function deliveryObjectPath(partyId: string, channelId: string, version: number, cameraId: string): string {\n90:   return `parties/${partyId}/channels/${channelId}/delivery/${version}/${cameraId}.mp4`;\n91: }\n92: \n93: function validateDeliveryPath(clip: CanonicalClip, partyId: string, channelId: string, version: number): void {\n94:   if (clip.objectPath !== deliveryObjectPath(partyId, channelId, version, clip.cameraId)) {\n95:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Manifest media path is outside its delivery scope.\");\n96:   }\n97: }\n98: \n99: function manifestFrom(data: FirebaseFirestore.DocumentData | undefined): DeliveryManifest {\n100:   if (!data || !Number.isSafeInteger(data.version) || data.version < 1 ||\n101:       typeof data.partyId !== \"string\" || typeof data.channelId !== \"string\" || typeof data.jobId !== \"string\" ||\n102:       !Number.isSafeInteger(data.schemaVersion) || Number(data.schemaVersion) !== SCHEMA_VERSION ||\n103:       typeof data.expiresAt !== \"string\" || !Number.isFinite(Date.parse(data.expiresAt))) {\n104:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest is missing or malformed.\");\n105:   }\n106:   validateCanonicalClips(data.cameraClips);\n107:   return data as DeliveryManifest;\n108: }\n109: \n110: function timestampIso(value: unknown): string {\n111:   let date: Date | undefined;\n112:   if (value instanceof Date) date = value;\n113:   else if (value && typeof value === \"object\" && \"toDate\" in value && typeof (value as { toDate?: unknown }).toDate === \"function\") {\n114:     date = (value as { toDate: () => Date }).toDate();\n115:   } else if (typeof value === \"string\") {\n116:     const milliseconds = Date.parse(value);\n117:     if (Number.isFinite(milliseconds)) date = new Date(milliseconds);\n118:   }\n119:   if (!date || !Number.isFinite(date.getTime())) {\n120:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Published manifest timestamp is missing or malformed.\");\n121:   }\n122:   return date.toISOString();\n123: }\n124: \n125: function serializeManifest(manifest: DeliveryManifest): SerializedDeliveryManifest {\n126:   for (const clip of manifest.cameraClips) validateDeliveryPath(clip, manifest.partyId, manifest.channelId, manifest.version);\n127:   return {\n128:     partyId: manifest.partyId,\n129:     channelId: manifest.channelId,\n130:     version: manifest.version,\n131:     schemaVersion: manifest.schemaVersion,\n132:     jobId: manifest.jobId,\n133:     cameraClips: manifest.cameraClips.map((clip) => ({\n134:       cameraId: clip.cameraId,\n135:       objectPath: clip.objectPath,\n136:       sha256: clip.sha256,\n137:       sizeBytes: clip.sizeBytes,\n138:       durationMs: clip.durationMs,\n139:       expiresAt: new Date(Date.parse(clip.expiresAt)).toISOString(),\n140:     })),\n141:     createdAt: timestampIso(manifest.createdAt),\n142:     expiresAt: new Date(Date.parse(manifest.expiresAt)).toISOString(),\n143:   };\n144: }\n145: \n146: function canonicalClipsMatch(manifest: DeliveryManifest, ack: AckInput): void {\n147:   if (manifest.version !== ack.manifestVersion || manifest.partyId !== ack.partyId || manifest.channelId !== ack.channelId) {\n148:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK does not match the current party, channel, and manifest version.\");\n149:   }\n150:   // Exact match: same clip count, same first-N camera set, same hashes.\n151:   // Extra hashes beyond the manifest's prefix are rejected here (parseAck\n152:   // only checks the shape is a supported prefix, not that it is THIS prefix).\n153:   const manifestCameras = manifest.cameraClips.map((clip) => clip.cameraId).sort();\n154:   const ackCameras = Object.keys(ack.clipHashes).sort();\n155:   if (manifestCameras.length !== ackCameras.length || manifestCameras.join(\",\") !== ackCameras.join(\",\")) {\n156:     throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hash set does not match the canonical manifest cameras.\");\n157:   }\n158:   for (const clip of manifest.cameraClips) {\n159:     if (ack.clipHashes[clip.cameraId] !== clip.sha256) {\n160:       throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK hash does not match the canonical manifest.\");\n161:     }\n162:     validateDeliveryPath(clip, manifest.partyId, manifest.channelId, manifest.version);\n163:   }\n164: }\n165: \n166: /**\n167:  * Delivery-time consent revocation: a manifest produced from a guest-bound\n168:  * job whose consent was withdrawn (or whose binding is gone) must not yield\n169:  * new signed URLs, even if the manifest document itself has not been\n170:  * collected yet. Text-only jobs (no guest binding) are unaffected.\n171:  */\n172: async function assertManifestConsentLive(db: Firestore, partyId: string, jobId: string): Promise<void> {\n173:   let job: FirebaseFirestore.DocumentData | undefined;\n174:   try {\n175:     const snapshot = await db.doc(`parties/${partyId}/jobs/${jobId}`).get();\n176:     if (!snapshot.exists) return;\n177:     job = snapshot.data();\n178:   } catch {\n179:     return;\n180:   }\n181:   const guest = job?.guestMedia as Record<string, unknown> | undefined;\n182:   const submissionId = guest && typeof guest.submissionId === \"string\" ? guest.submissionId : undefined;\n183:   if (!submissionId) return;\n184:   let current: FirebaseFirestore.DocumentData | undefined;\n185:   try {\n186:     const snapshot = await db.doc(`parties/${partyId}/guestMedia/${submissionId}`).get();\n187:     if (!snapshot.exists) throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for delivery.\");\n188:     current = snapshot.data();\n189:   } catch (error) {\n190:     if (error instanceof BackendError) throw error;\n191:     return;\n192:   }\n193:   if (!current || current.status !== \"eligible\" || (current as Record<string, unknown>).tombstone === true) {\n194:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn; this manifest is revoked.\");\n195:   }\n196: }\n197: \n198: export function createDeliveryServices(options: DeliveryServiceOptions): DeliveryServices {\n199:   const { db, bucket } = options;\n200:   const now = options.now ?? (() => new Date());\n201:   const enqueueGeneration = options.enqueueGeneration ?? (async () => undefined);\n202:   const generationRunner = options.generationRunner ?? defaultRunner;\n203:   const signReadUrl = options.signReadUrl ?? (async (file, expiresAt) => {\n204:     const [url] = await file.getSignedUrl({ action: \"read\", expires: expiresAt, version: \"v4\" });\n205:     return url;\n206:   });\n207:   const deleteDeliveryObject = options.deleteDeliveryObject ?? (async (file) => {\n208:     await file.delete({ ignoreNotFound: true });\n209:   });\n210: \n211:   async function requestGeneration(value: unknown) {\n212:     const input: RequestGenerationInput = parseRequestGeneration(value);\n213:     const registered = await assertRegisteredPartyDevice(db, input);\n214:     const ref = jobRef(db, input.partyId, input.jobId);\n215:     const result = await db.runTransaction(async (transaction) => {\n216:       const existing = await transaction.get(ref);\n217:       if (existing.exists) {\n218:         const old = existing.data()!;\n219:         if (old.idempotencyKey !== input.idempotencyKey || old.deviceId !== input.deviceId || old.channelId !== input.channelId) {\n220:           throw new BackendError(\"FORBIDDEN\", \"jobId is already bound to a different request.\");\n221:         }\n222:         return { state: String(old.state), created: false };\n223:       }\n224:       const inFlight = await transaction.get(\n225:         db.collection(`parties/${input.partyId}/jobs`).where(\"state\", \"in\", [\"queued\", \"running\"]),\n226:       );\n227:       if (!inFlight.empty) throw new BackendError(\"BUDGET_EXCEEDED\", \"One generation is already in flight for this party.\");\n228:       const currentManifest = await transaction.get(manifestRef(db, input.partyId, input.channelId));\n229:       const sourceManifestVersion = currentManifest.exists ? Number(currentManifest.data()?.version ?? 0) : 0;\n230:       const timestamp = FieldValue.serverTimestamp();\n231:       const expiresAt = Timestamp.fromDate(new Date(now().getTime() + MEDIA_RETENTION_MS));\n232:       transaction.create(ref, {\n233:         jobId: input.jobId,\n234:         partyId: input.partyId,\n235:         deviceId: input.deviceId,\n236:         channelId: input.channelId,\n237:         manifestVersion: sourceManifestVersion,\n238:         state: \"queued\",\n239:         timestamp,\n240:         createdAt: timestamp,\n241:         idempotencyKey: input.idempotencyKey,\n242:         presetId: CHEAP_DEMO_PRESET.presetId,\n243:         modelId: CHEAP_DEMO_PRESET.modelId,\n244:         costEstimate: { modelId: CHEAP_DEMO_PRESET.modelId, presetId: CHEAP_DEMO_PRESET.presetId, secondsOut: 2 },\n245:         expiresAt,\n246:       });\n247:       transaction.create(costLogRef(db, input.partyId, input.jobId), {\n248:         model_id: CHEAP_DEMO_PRESET.modelId,\n249:         preset_id: CHEAP_DEMO_PRESET.presetId,\n250:         seconds_out: CHEAP_DEMO_PRESET.secondsOut,\n251:         seconds_in: 0,\n252:         credits_charged: 0,\n253:         provider_task_id: null,\n254:         created_at: timestamp,\n255:         success: false,\n256:         partyId: input.partyId,\n257:         deviceId: input.deviceId,\n258:         channelId: input.channelId,\n259:         manifestVersion: sourceManifestVersion,\n260:         timestamp,\n261:         idempotencyKey: input.idempotencyKey,\n262:       });\n263:       return { state: \"queued\", created: true };\n264:     });\n265:     if (result.created) {\n266:       try {\n267:         await enqueueGeneration({\n268:           partyId: input.partyId,\n269:           deviceId: input.deviceId,\n270:           channelId: input.channelId,\n271:           jobId: input.jobId,\n272:           idempotencyKey: input.idempotencyKey,\n273:         });\n274:       } catch {\n275:         await db.runTransaction(async (transaction) => {\n276:           transaction.update(ref, { state: \"failed\", errorCode: \"PROVIDER_UNAVAILABLE\", updatedAt: FieldValue.serverTimestamp() });\n277:           transaction.update(costLogRef(db, input.partyId, input.jobId), { success: false });\n278:         });\n279:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Generation task could not be queued.\");\n280:       }\n281:     }\n282:     return { jobId: input.jobId, state: result.state, created: result.created };\n283:   }\n284: \n285:   async function runGeneration(task: GenerationTask) {\n286:     const identity: Identity = { partyId: task.partyId, deviceId: task.deviceId, channelId: task.channelId };\n287:     await assertRegisteredPartyDevice(db, identity);\n288:     const ref = jobRef(db, task.partyId, task.jobId);\n289:     const claimed = await db.runTransaction(async (transaction) => {\n290:       const snapshot = await transaction.get(ref);\n291:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n292:       const job = snapshot.data()!;\n293:       if (job.idempotencyKey !== task.idempotencyKey || job.deviceId !== task.deviceId || job.channelId !== task.channelId) {\n294:         throw new BackendError(\"FORBIDDEN\", \"Task identity does not match the job.\");\n295:       }\n296:       if (job.state !== \"queued\") return { run: false, state: String(job.state), job };\n297:       transaction.update(ref, { state: \"running\", startedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });\n298:       return { run: true, state: \"running\", job };\n299:     });\n300:     if (!claimed.run) return { jobId: task.jobId, state: claimed.state };\n301:     try {\n302:       await generationRunner(claimed.job);\n303:     } catch (error) {\n304:       const errorCode = error instanceof BackendError ? error.errorCode : \"PROVIDER_UNAVAILABLE\";\n305:       await db.runTransaction(async (transaction) => {\n306:         transaction.update(ref, { state: \"failed\", errorCode, failedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });\n307:         transaction.update(costLogRef(db, task.partyId, task.jobId), { success: false, errorCode });\n308:       });\n309:       throw new BackendError(errorCode, \"Generation did not complete.\");\n310:     }\n311:     return { jobId: task.jobId, state: \"running\" };\n312:   }\n313: \n314:   async function normalizeAndStage(jobId: string, inputs: GeneratedClipInput[]): Promise<DeliveryManifest> {\n315:     const validJobId = jobId;\n316:     const matching = await db.collectionGroup(\"jobs\").where(\"jobId\", \"==\", validJobId).limit(1).get();\n317:     if (matching.empty) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n318:     const jobDocument = matching.docs[0];\n319:     const job = jobDocument.data();\n320:     if (job.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running job can stage generated media.\");\n321:     const { partyId, channelId } = job as { partyId: string; channelId: string };\n322:     if (!Array.isArray(inputs) || !(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(inputs.length)) {\n323:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staging requires 1, 2, or 4 canonical camera clips.\");\n324:     }\n325:     const expectedStaging = [...expectedCameraIds(inputs.length)];\n326:     const byCamera = new Map(inputs.map((clip) => [clip.cameraId, clip]));\n327:     if (byCamera.size !== inputs.length || expectedStaging.some((id) => !byCamera.has(id))) {\n328:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staging camera set is invalid.\");\n329:     }\n330:     const version = Number(job.manifestVersion ?? 0) + 1;\n331:     const expiresAt = new Date(now().getTime() + MEDIA_RETENTION_MS).toISOString();\n332:     const canonical: CanonicalClip[] = [];\n333:     for (const cameraId of expectedStaging as CanonicalClip[\"cameraId\"][]) {\n334:       const input = byCamera.get(cameraId)!;\n335:       const generatedPrefix = `parties/${partyId}/generated/${validJobId}/`;\n336:       if (!input.sourcePath.startsWith(generatedPrefix) || input.sourcePath.includes(\"..\") || input.sourcePath.includes(\"\\\\\")) {\n337:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Generated media source path is outside its job scope.\");\n338:       }\n339:       if (input.durationMs !== 2000 || !/^[a-f0-9]{64}$/.test(input.sha256)) {\n340:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Generated clip metadata is invalid.\");\n341:       }\n342:       const source = bucket.file(input.sourcePath);\n343:       const [contents] = await source.download();\n344:       const actualHash = createHash(\"sha256\").update(contents).digest(\"hex\");\n345:       if (actualHash !== input.sha256 || contents.byteLength !== input.sizeBytes) {\n346:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Generated clip content does not match its metadata.\");\n347:       }\n348:       const objectPath = deliveryObjectPath(partyId, channelId, version, cameraId);\n349:       const destination = bucket.file(objectPath);\n350:       await source.copy(destination);\n351:       await destination.setMetadata({\n352:         contentType: \"video/mp4\",\n353:         customTime: expiresAt,\n354:         metadata: { expiresAt, jobId: validJobId, partyId, channelId, cameraId, purpose: \"delivery\" },\n355:       });\n356:       canonical.push({ cameraId, objectPath, sha256: actualHash, sizeBytes: contents.byteLength, durationMs: 2000, expiresAt });\n357:     }\n358:     const staged: DeliveryManifest = {\n359:       partyId,\n360:       channelId,\n361:       version,\n362:       schemaVersion: SCHEMA_VERSION,\n363:       jobId: validJobId,\n364:       cameraClips: canonical,\n365:       expiresAt,\n366:     };\n367:     validateCanonicalClips(staged.cameraClips);\n368:     await jobDocument.ref.update({ stagedManifest: staged, deliveryPaths: canonical.map((clip) => clip.objectPath), stagedAt: FieldValue.serverTimestamp() });\n369:     return staged;\n370:   }\n371: \n372:   async function publishManifest(jobId: string, idempotencyKey: string): Promise<DeliveryManifest> {\n373:     const matching = await db.collectionGroup(\"jobs\").where(\"jobId\", \"==\", jobId).limit(1).get();\n374:     if (matching.empty) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n375:     const ref = matching.docs[0].ref;\n376:     return db.runTransaction(async (transaction) => {\n377:       const jobSnapshot = await transaction.get(ref);\n378:       const job = jobSnapshot.data();\n379:       if (!job || job.idempotencyKey !== idempotencyKey) throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n380:       if (job.publishedManifest) return job.publishedManifest as DeliveryManifest;\n381:       const staged = manifestFrom(job.stagedManifest);\n382:       const currentRef = manifestRef(db, job.partyId, job.channelId);\n383:       const currentSnapshot = await transaction.get(currentRef);\n384:       const currentVersion = currentSnapshot.exists ? Number(currentSnapshot.data()?.version ?? 0) : 0;\n385:       if (currentVersion !== Number(job.manifestVersion ?? 0)) {\n386:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest changed while this job was running.\");\n387:       }\n388:       const published: DeliveryManifest = { ...staged, createdAt: FieldValue.serverTimestamp() };\n389:       transaction.set(currentRef, published);\n390:       transaction.update(ref, {\n391:         state: \"ready\",\n392:         manifestVersion: staged.version,\n393:         publishedManifest: staged,\n394:         readyAt: FieldValue.serverTimestamp(),\n395:         timestamp: FieldValue.serverTimestamp(),\n396:       });\n397:       transaction.update(costLogRef(db, job.partyId, jobId), { manifestVersion: staged.version });\n398:       return published;\n399:     });\n400:   }\n401: \n402:   async function getDeliveryUrls(value: unknown) {\n403:     const identity = requireIdentity(value);\n404:     if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n405:     const registered = await assertRegisteredPartyDevice(db, identity);\n406:     const snapshot = await manifestRef(db, registered.partyId, registered.channelId).get();\n407:     const manifest = manifestFrom(snapshot.data());\n408:     await assertManifestConsentLive(db, registered.partyId, manifest.jobId);\n409:     const nowMs = now().getTime();\n410:     const manifestExpiry = Date.parse(manifest.expiresAt);\n411:     if (!Number.isFinite(manifestExpiry) || manifestExpiry <= nowMs) throw new BackendError(\"CLIP_EXPIRED\", \"Current manifest has expired.\");\n412:     const manifestHash = canonicalManifestHash(manifest);\n413:     const clips = await Promise.all(manifest.cameraClips.map(async (clip) => {\n414:       validateDeliveryPath(clip, manifest.partyId, manifest.channelId, manifest.version);\n415:       const clipExpiry = Date.parse(clip.expiresAt);\n416:       if (!Number.isFinite(clipExpiry) || clipExpiry <= nowMs) throw new BackendError(\"CLIP_EXPIRED\", \"A canonical camera clip has expired.\");\n417:       const expiresAt = new Date(Math.min(nowMs + DELIVERY_URL_TTL_SECONDS * 1000, clipExpiry));\n418:       return {\n419:         cameraId: clip.cameraId,\n420:         sha256: clip.sha256,\n421:         url: await signReadUrl(bucket.file(clip.objectPath), expiresAt),\n422:         expiresAt: expiresAt.toISOString(),\n423:       };\n424:     }));\n425:     return { manifestVersion: manifest.version, manifestHash, clips };\n426:   }\n427: \n428:   async function getCurrentManifest(value: unknown): Promise<SerializedDeliveryManifest> {\n429:     const input: CurrentManifestInput = parseCurrentManifestInput(value);\n430:     const registered = await assertRegisteredPartyDevice(db, input);\n431:     if (registered.channel.status !== \"active\") throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n432:     const snapshot = await manifestRef(db, registered.partyId, registered.channelId).get();\n433:     if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Current manifest does not exist.\");\n434:     const manifest = manifestFrom(snapshot.data());\n435:     await assertManifestConsentLive(db, registered.partyId, manifest.jobId);\n436:     if (manifest.partyId !== registered.partyId || manifest.channelId !== registered.channelId) {\n437:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest is outside the registered party and channel.\");\n438:     }\n439:     const currentTimeMs = now().getTime();\n440:     if (Date.parse(manifest.expiresAt) <= currentTimeMs ||\n441:         manifest.cameraClips.some((clip) => Date.parse(clip.expiresAt) <= currentTimeMs)) {\n442:       throw new BackendError(\"CLIP_EXPIRED\", \"Current manifest has expired.\");\n443:     }\n444:     return serializeManifest(manifest);\n445:   }\n446: \n447:   async function acknowledgeDelivery(value: unknown) {\n448:     const ack = parseAck(value);\n449:     await assertRegisteredPartyDevice(db, ack);\n450:     const mRef = manifestRef(db, ack.partyId, ack.channelId);\n451:     const idem = ackIdempotencyKey(ack.deviceId, ack.channelId, ack.manifestVersion);\n452:     const ackId = idem;\n453:     const ackRef = db.doc(`parties/${ack.partyId}/deliveryAcks/${ackId}`);\n454:     const accepted = await db.runTransaction(async (transaction) => {\n455:       const existing = await transaction.get(ackRef);\n456:       if (existing.exists) return validateAcceptedAck(existing.data(), ack, ackId, idem);\n457: \n458:       const current = await transaction.get(mRef);\n459:       const manifest = manifestFrom(current.data());\n460:       canonicalClipsMatch(manifest, ack);\n461:       const currentTime = now().getTime();\n462:       if (Date.parse(manifest.expiresAt) <= currentTime || manifest.cameraClips.some((clip) => Date.parse(clip.expiresAt) <= currentTime)) {\n463:         throw new BackendError(\"CLIP_EXPIRED\", \"Cannot acknowledge an expired manifest.\");\n464:       }\n465:       const relatedJobRef = jobRef(db, ack.partyId, manifest.jobId);\n466:       const relatedJob = await transaction.get(relatedJobRef);\n467:       const acceptedAck = {\n468:         ackId,\n469:         partyId: ack.partyId,\n470:         deviceId: ack.deviceId,\n471:         channelId: ack.channelId,\n472:         manifestVersion: ack.manifestVersion,\n473:         manifestHash: canonicalManifestHash(manifest),\n474:         clipHashes: ack.clipHashes,\n475:         jobId: manifest.jobId,\n476:         clips: manifest.cameraClips.map(({ cameraId, objectPath, sha256 }) => ({ cameraId, objectPath, sha256 })),\n477:         timestamp: FieldValue.serverTimestamp(),\n478:         idempotencyKey: idem,\n479:       };\n480:       transaction.create(ackRef, acceptedAck);\n481:       if (relatedJob.exists && [\"ready\", \"delivering\"].includes(String(relatedJob.data()?.state))) {\n482:         transaction.update(relatedJobRef, { state: \"delivering\", deliveryAckId: ackId, timestamp: FieldValue.serverTimestamp() });\n483:       }\n484:       return validateAcceptedAck(acceptedAck, ack, ackId, idem);\n485:     });\n486:     const relatedJobRef = jobRef(db, ack.partyId, accepted.jobId);\n487:     // ACK is idempotent. Repeating it safely retries object deletion after partial failures.\n488:     await Promise.all(accepted.clips.map((clip) => deleteDeliveryObject(bucket.file(clip.objectPath))));\n489:     await db.runTransaction(async (transaction) => {\n490:       const relatedJob = await transaction.get(relatedJobRef);\n491:       if (relatedJob.exists && relatedJob.data()?.deliveryAckId === ackId) {\n492:         transaction.update(relatedJobRef, { state: \"purged\", purgedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });\n493:       }\n494:     });\n495:     return { ackId, manifestVersion: ack.manifestVersion, purged: true };\n496:   }\n497: \n498:   return { requestGeneration, runGeneration, normalizeAndStage, publishManifest, getCurrentManifest, getDeliveryUrls, acknowledgeDelivery };\n499: }\n500: \n501: interface AcceptedAckClip {\n502:   cameraId: string;\n503:   objectPath: string;\n504:   sha256: string;\n505: }\n506: \n507: interface ValidatedAcceptedAck {\n508:   jobId: string;\n509:   clips: AcceptedAckClip[];\n510: }\n511: \n512: function validateAcceptedAck(\n513:   value: FirebaseFirestore.DocumentData | Record<string, unknown> | undefined,\n514:   ack: AckInput,\n515:   ackId: string,\n516:   idempotencyKey: string,\n517: ): ValidatedAcceptedAck {\n518:   const mismatch = (): never => { throw new BackendError(\"MANIFEST_MISMATCH\", \"ACK conflicts with the previously accepted delivery ACK.\"); };\n519:   // Accepted-ACK replay validation supports the 1/2/4 prefixes: the stored\n520:   // clip set must exactly equal one first-N prefix, and the replayed hashes\n521:   // must equal the stored ones (extra hashes rejected).\n522:   const clipCount = Array.isArray(value?.clips) ? (value as Record<string, unknown>).clips as unknown[] : [];\n523:   if (!(SUPPORTED_CAMERA_COUNTS as readonly number[]).includes(clipCount.length)) return mismatch();\n524:   const expectedKeys = [...expectedCameraIds(clipCount.length)].sort().join(\",\");\n525:   if (!value || value.ackId !== ackId || value.partyId !== ack.partyId || value.deviceId !== ack.deviceId ||\n526:       value.channelId !== ack.channelId || value.manifestVersion !== ack.manifestVersion ||\n527:       value.idempotencyKey !== idempotencyKey || !/^[a-f0-9]{64}$/.test(String(value.manifestHash ?? \"\")) ||\n528:       typeof value.jobId !== \"string\" || !Array.isArray(value.clips) ||\n529:       !value.clipHashes || typeof value.clipHashes !== \"object\" || Array.isArray(value.clipHashes) ||\n530:       Object.keys(value.clipHashes).sort().join(\",\") !== expectedKeys ||\n531:       Object.keys(ack.clipHashes).sort().join(\",\") !== expectedKeys ||\n532:       !/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(value.jobId)) return mismatch();\n533:   for (const cameraId of expectedCameraIds(clipCount.length)) {\n534:     if ((value.clipHashes as Record<string, unknown>)[cameraId] !== ack.clipHashes[cameraId]) return mismatch();\n535:   }\n536:   const byCamera = new Map<string, AcceptedAckClip>();\n537:   for (const raw of value.clips) {\n538:     if (!raw || typeof raw !== \"object\") return mismatch();\n539:     const clip = raw as Record<string, unknown>;\n540:     if (typeof clip.cameraId !== \"string\" || !(expectedCameraIds(clipCount.length) as readonly string[]).includes(clip.cameraId) ||\n541:         typeof clip.objectPath !== \"string\" || typeof clip.sha256 !== \"string\" || !/^[a-f0-9]{64}$/.test(clip.sha256) ||\n542:         byCamera.has(clip.cameraId)) return mismatch();\n543:     const cameraId = clip.cameraId;\n544:     if (clip.objectPath !== deliveryObjectPath(ack.partyId, ack.channelId, ack.manifestVersion, cameraId) ||\n545:         clip.sha256 !== ack.clipHashes[cameraId]) return mismatch();\n546:     byCamera.set(cameraId, { cameraId, objectPath: clip.objectPath, sha256: clip.sha256 });\n547:   }\n548:   if ((expectedCameraIds(clipCount.length) as readonly string[]).some((cameraId) => !byCamera.has(cameraId))) return mismatch();\n549:   return { jobId: String(value.jobId), clips: [...expectedCameraIds(clipCount.length)].map((cameraId) => byCamera.get(cameraId)!) };\n550: }\n551: ","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/delivery.ts, lines 1-551\n1: import { createHash } from \"node:crypto\";\n2: import { Bucket, File } from \"@google