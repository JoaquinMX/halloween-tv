{"type":"text","timestamp":1793461275139,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"id":"prt_1929f4a000012rkG2PIvKJkmMh","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929f43b90013RVgkY1LN9Wszw","type":"text","text":"Delivery fixed — now writing host invite tests.","time":{"start":1793461275136,"end":1793461275139}}}
{"type":"tool_use","timestamp":1793461276769,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929f4a07001FRMe9EDxI0XvpD","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929f43b90013RVgkY1LN9Wszw","type":"tool","id":"call_01a1929f479372da98781ebeeff0e00d","tool":"write","state":{"status":"completed","input":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { Timestamp } from \"firebase-admin/firestore\";\nimport { BackendError } from \"../src/contracts\";\nimport { createHostJoinService, hashHostInviteToken } from \"../src/host_join\";\nimport { createJoinPartyService } from \"../src/join_party\";\nimport {\n  HAS_FIRESTORE_EMULATOR,\n  clearParty,\n  createEmulatorContext,\n  disposeEmulatorContext,\n  randomPartyId,\n  seedParty,\n} from \"./support/emulators\";\n\nasync function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\n  await seedParty(db, partyId, deviceId, channelId);\n  await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \"tv\" });\n}\n\ntest(\"only a registered TV may mint a host invite; invites bind party/channel/expiry\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    await seedParty(db, partyId, \"p-guest-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    assert.equal(invite.partyId, partyId);\n    assert.equal(invite.channelId, \"main\");\n    assert.ok(invite.inviteToken.startsWith(\"hi-\"));\n    assert.ok(Date.parse(invite.expiresAt) > Date.now());\n    // Only the token hash is stored, bound to party/channel/expiry.\n    const tokenHash = hashHostInviteToken(invite.inviteToken);\n    const stored = (await db.doc(`parties/${partyId}/hostInvites/${tokenHash.slice(0, 32)}`).get()).data()!;\n    assert.equal(stored.tokenHash, tokenHash);\n    assert.equal(stored.partyId, partyId);\n    assert.equal(stored.channelId, \"main\");\n    assert.equal(stored.status, \"pending\");\n    assert.ok(!(\"inviteToken\" in stored) && !JSON.stringify(stored).includes(invite.inviteToken));\n    // Guests, unknown devices, and wrong channels cannot mint invites.\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \"p-guest-1\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \"nope\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"other\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n  } finally {\n    await clearParty(db, (await import(\"firebase-admin/storage\").then(() => undefined as never).catch(() => undefined as never)) as never, partyId).catch(() => undefined);\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"host redemption is transactional: idempotent retry, replay/expiry/PIN/role forgery denied\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n\n    const joined = await services.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n    assert.deepEqual(joined, { partyId, deviceId: \"p-host-1\", channelId: \"main\", role: \"host\", status: \"active\", created: true });\n    const device = (await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()!;\n    assert.equal(device.role, \"host\");\n    assert.equal(device.status, \"active\");\n\n    // Same-device redemption retries are idempotent.\n    const retried = await services.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n    assert.equal(retried.created, false);\n    assert.equal(retried.role, \"host\");\n\n    // Other-device replay of the same token cannot grant host access.\n    await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-2\", channelId: \"main\", inviteToken: invite.inviteToken }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).exists, false);\n\n    // Guest PIN reuse cannot grant host access (shape-rejected, never redeemed).\n    await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-3\", channelId: \"main\", inviteToken: \"004201\" }),\n      (e: unknown) => e instanceof BackendError);\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-3`).get()).exists, false);\n\n    // Client-only role changes cannot grant host access: a forged role field\n    // is ignored and a guest-PIN registration stays a guest.\n    const joinParty = createJoinPartyService({ db });\n    const guest = await joinParty.joinParty({ partyId, deviceId: \"p-guest-9\", channelId: \"main\", role: \"host\" } as unknown as Record<string, unknown>);\n    assert.equal(guest.role, \"guest\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-9`).get()).data()?.role, \"guest\");\n    await assert.rejects(services.joinHost({ partyId, deviceId: \"p-guest-9\", channelId: \"main\", inviteToken: invite.inviteToken }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n\n    // Expired invites are refused.\n    const invite2 = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    const tokenHash2 = hashHostInviteToken(invite2.inviteToken);\n    await db.doc(`parties/${partyId}/hostInvites/${tokenHash2.slice(0, 32)}`).update({ expiresAt: Timestamp.fromDate(new Date(Date.now() - 1000)) });\n    await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-4\", channelId: \"main\", inviteToken: invite2.inviteToken }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n\n    // Cross-party token reuse is refused.\n    const otherParty = randomPartyId();\n    await seedTv(db, otherParty, \"tv-9\", \"main\");\n    await assert.rejects(services.joinHost({ partyId: otherParty, deviceId: \"p-host-5\", channelId: \"main\", inviteToken: invite.inviteToken }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await db.recursiveDelete(db.doc(`parties/${otherParty}`)).catch(() => undefined);\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"legacy joinParty remains guest-only and never upgrades host devices\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const hosts = createHostJoinService({ db });\n    const joinParty = createJoinPartyService({ db });\n    const invite = await hosts.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    await hosts.joinHost({ partyId, deviceId: \"p-host-1\", channelId: \"main\", inviteToken: invite.inviteToken });\n    // A host device rejoining through the legacy path is rejected, not downgraded.\n    await assert.rejects(joinParty.joinParty({ partyId, deviceId: \"p-host-1\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \"host\");\n    // Fresh legacy joins are still guests.\n    const guest = await joinParty.joinParty({ partyId, deviceId: \"p-new-guest\", channelId: \"main\" });\n    assert.equal(guest.role, \"guest\");\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n","path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/host_join.test.ts"},"output":"Created file successfully: backend/functions/test/host_join.test.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: backend/functions/test/host_join.test.ts"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929f479372da98781ebeeff0e00d"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import assert from \\\"node:assert/strict\\\";\\nimport test from \\\"node:test\\\";\\nimport { Timestamp } from \\\"firebase-admin/firestore\\\";\\nimport { BackendError } from \\\"../src/contracts\\\";\\nimport { createHostJoinService, hashHostInviteToken } from \\\"../src/host_join\\\";\\nimport { createJoinPartyService } from \\\"../src/join_party\\\";\\nimport {\\n  HAS_FIRESTORE_EMULATOR,\\n  clearParty,\\n  createEmulatorContext,\\n  disposeEmulatorContext,\\n  randomPartyId,\\n  seedParty,\\n} from \\\"./support/emulators\\\";\\n\\nasync function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\\n  await seedParty(db, partyId, deviceId, channelId);\\n  await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \\\"tv\\\" });\\n}\\n\\ntest(\\\"only a registered TV may mint a host invite; invites bind party/channel/expiry\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    await seedParty(db, partyId, \\\"p-guest-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const invite = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    assert.equal(invite.partyId, partyId);\\n    assert.equal(invite.channelId, \\\"main\\\");\\n    assert.ok(invite.inviteToken.startsWith(\\\"hi-\\\"));\\n    assert.ok(Date.parse(invite.expiresAt) > Date.now());\\n    // Only the token hash is stored, bound to party/channel/expiry.\\n    const tokenHash = hashHostInviteToken(invite.inviteToken);\\n    const stored = (await db.doc(`parties/${partyId}/hostInvites/${tokenHash.slice(0, 32)}`).get()).data()!;\\n    assert.equal(stored.tokenHash, tokenHash);\\n    assert.equal(stored.partyId, partyId);\\n    assert.equal(stored.channelId, \\\"main\\\");\\n    assert.equal(stored.status, \\\"pending\\\");\\n    assert.ok(!(\\\"inviteToken\\\" in stored) && !JSON.stringify(stored).includes(invite.inviteToken));\\n    // Guests, unknown devices, and wrong channels cannot mint invites.\\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \\\"nope\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"other\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n  } finally {\\n    await clearParty(db, (await import(\\\"firebase-admin/storage\\\").then(() => undefined as never).catch(() => undefined as never)) as never, partyId).catch(() => undefined);\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"host redemption is transactional: idempotent retry, replay/expiry/PIN/role forgery denied\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const invite = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n\\n    const joined = await services.joinHost({ partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken });\\n    assert.deepEqual(joined, { partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\", role: \\\"host\\\", status: \\\"active\\\", created: true });\\n    const device = (await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()!;\\n    assert.equal(device.role, \\\"host\\\");\\n    assert.equal(device.status, \\\"active\\\");\\n\\n    // Same-device redemption retries are idempotent.\\n    const retried = await services.joinHost({ partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken });\\n    assert.equal(retried.created, false);\\n    assert.equal(retried.role, \\\"host\\\");\\n\\n    // Other-device replay of the same token cannot grant host access.\\n    await assert.rejects(services.joinHost({ partyId, deviceId: \\\"p-host-2\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).exists, false);\\n\\n    // Guest PIN reuse cannot grant host access (shape-rejected, never redeemed).\\n    await assert.rejects(services.joinHost({ partyId, deviceId: \\\"p-host-3\\\", channelId: \\\"main\\\", inviteToken: \\\"004201\\\" }),\\n      (e: unknown) => e instanceof BackendError);\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-3`).get()).exists, false);\\n\\n    // Client-only role changes cannot grant host access: a forged role field\\n    // is ignored and a guest-PIN registration stays a guest.\\n    const joinParty = createJoinPartyService({ db });\\n    const guest = await joinParty.joinParty({ partyId, deviceId: \\\"p-guest-9\\\", channelId: \\\"main\\\", role: \\\"host\\\" } as unknown as Record<string, unknown>);\\n    assert.equal(guest.role, \\\"guest\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-9`).get()).data()?.role, \\\"guest\\\");\\n    await assert.rejects(services.joinHost({ partyId, deviceId: \\\"p-guest-9\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n\\n    // Expired invites are refused.\\n    const invite2 = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    const tokenHash2 = hashHostInviteToken(invite2.inviteToken);\\n    await db.doc(`parties/${partyId}/hostInvites/${tokenHash2.slice(0, 32)}`).update({ expiresAt: Timestamp.fromDate(new Date(Date.now() - 1000)) });\\n    await assert.rejects(services.joinHost({ partyId, deviceId: \\\"p-host-4\\\", channelId: \\\"main\\\", inviteToken: invite2.inviteToken }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n\\n    // Cross-party token reuse is refused.\\n    const otherParty = randomPartyId();\\n    await seedTv(db, otherParty, \\\"tv-9\\\", \\\"main\\\");\\n    await assert.rejects(services.joinHost({ partyId: otherParty, deviceId: \\\"p-host-5\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await db.recursiveDelete(db.doc(`parties/${otherParty}`)).catch(() => undefined);\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"legacy joinParty remains guest-only and never upgrades host devices\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const hosts = createHostJoinService({ db });\\n    const joinParty = createJoinPartyService({ db });\\n    const invite = await hosts.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    await hosts.joinHost({ partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken });\\n    // A host device rejoining through the legacy path is rejected, not downgraded.\\n    await assert.rejects(joinParty.joinParty({ partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \\\"host\\\");\\n    // Fresh legacy joins are still guests.\\n    const guest = await joinParty.joinParty({ partyId, deviceId: \\\"p-new-guest\\\", channelId: \\\"main\\\" });\\n    assert.equal(guest.role, \\\"guest\\\");\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/host_join.test.ts\"}"},"time":{"start":1793461275143,"end":1793461276769}}}}
