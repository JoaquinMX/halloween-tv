{"type":"tool_use","timestamp":1793461862599,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192a8330a001fuwDjdNK240Wy3","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192a82cd4001iqeL9yCPlx4BOs","type":"tool","id":"call_01a192a82fa57661b8344d90be85be5c","tool":"write","state":{"status":"completed","input":{"content":"import 'dart:math';\nimport 'package:shared_preferences/shared_preferences.dart';\n\n/// Installation identities persisted app-wide, one per role.\n///\n/// The guest phone identity ([storageKey]) authorizes `joinParty`; the host\n/// phone identity ([hostStorageKey]) redeems `joinHost`. The keys are\n/// separate so switching roles can never overwrite or promote an existing\n/// guest registration: joining as host leaves the guest device doc (and its\n/// receipts) untouched, and vice versa. Persistence is required before an\n/// id is returned.\nfinal class DeviceIdentityStore {\n  DeviceIdentityStore({\n    Future<SharedPreferences> Function()? preferences,\n    Random? random,\n  }) : _preferences = preferences ?? SharedPreferences.getInstance,\n       _random = random ?? Random.secure();\n  static const String storageKey = 'companion.phone_device_id.v1';\n\n  /// Separate host phone identity for `joinHost` redemption.\n  ///\n  /// A guest-PIN registration (role guest) can never be upgraded by\n  /// re-presenting a host invite for the same device id — the backend\n  /// rejects guest docs at redemption — so the host flow mints and persists\n  /// its own installation id under this key.\n  static const String hostStorageKey = 'companion.host_phone_device_id.v1';\n\n  final Future<SharedPreferences> Function() _preferences;\n  final Random _random;\n  final Map<String, Future<String>> _pending = <String, Future<String>>{};\n\n  Future<String> getDeviceId() => _pending.putIfAbsent(\n    storageKey,\n    () => _loadOrCreate(\n      storageKey,\n    ).then((id) => id).catchError((Object error) {\n      _pending.remove(storageKey);\n      throw error;\n    }),\n  );\n\n  Future<String> getHostDeviceId() => _pending.putIfAbsent(\n    hostStorageKey,\n    () => _loadOrCreate(\n      hostStorageKey,\n    ).then((id) => id).catchError((Object error) {\n      _pending.remove(hostStorageKey);\n      throw error;\n    }),\n  );\n\n  Future<String> _loadOrCreate(String key) async {\n    final prefs = await _preferences();\n    final stored = prefs.getString(key);\n    if (stored != null && RegExp(r'^p-[0-9a-f]{32}$').hasMatch(stored)) {\n      return stored;\n    }\n    final bytes = List<int>.generate(16, (_) => _random.nextInt(256));\n    final id = 'p-${bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join()}';\n    if (!await prefs.setString(key, id)) {\n      throw StateError('Unable to persist phone identity');\n    }\n    return id;\n  }\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/join/device_identity_store.dart"},"output":"Wrote file successfully: apps/companion_app/lib/src/join/device_identity_store.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: apps/companion_app/lib/src/join/device_identity_store.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192a82fa57661b8344d90be85be5c"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import 'dart:math';\\nimport 'package:shared_preferences/shared_preferences.dart';\\n\\n/// Installation identities persisted app-wide, one per role.\\n///\\n/// The guest phone identity ([storageKey]) authorizes `joinParty`; the host\\n/// phone identity ([hostStorageKey]) redeems `joinHost`. The keys are\\n/// separate so switching roles can never overwrite or promote an existing\\n/// guest registration: joining as host leaves the guest device doc (and its\\n/// receipts) untouched, and vice versa. Persistence is required before an\\n/// id is returned.\\nfinal class DeviceIdentityStore {\\n  DeviceIdentityStore({\\n    Future<SharedPreferences> Function()? preferences,\\n    Random? random,\\n  }) : _preferences = preferences ?? SharedPreferences.getInstance,\\n       _random = random ?? Random.secure();\\n  static const String storageKey = 'companion.phone_device_id.v1';\\n\\n  /// Separate host phone identity for `joinHost` redemption.\\n  ///\\n  /// A guest-PIN registration (role guest) can never be upgraded by\\n  /// re-presenting a host invite for the same device id — the backend\\n  /// rejects guest docs at redemption — so the host flow mints and persists\\n  /// its own installation id under this key.\\n  static const String hostStorageKey = 'companion.host_phone_device_id.v1';\\n\\n  final Future<SharedPreferences> Function() _preferences;\\n  final Random _random;\\n  final Map<String, Future<String>> _pending = <String, Future<String>>{};\\n\\n  Future<String> getDeviceId() => _pending.putIfAbsent(\\n    storageKey,\\n    () => _loadOrCreate(\\n      storageKey,\\n    ).then((id) => id).catchError((Object error) {\\n      _pending.remove(storageKey);\\n      throw error;\\n    }),\\n  );\\n\\n  Future<String> getHostDeviceId() => _pending.putIfAbsent(\\n    hostStorageKey,\\n    () => _loadOrCreate(\\n      hostStorageKey,\\n    ).then((id) => id).catchError((Object error) {\\n      _pending.remove(hostStorageKey);\\n      throw error;\\n    }),\\n  );\\n\\n  Future<String> _loadOrCreate(String key) async {\\n    final prefs = await _preferences();\\n    final stored = prefs.getString(key);\\n    if (stored != null && RegExp(r'^p-[0-9a-f]{32}$').hasMatch(stored)) {\\n      return stored;\\n    }\\n    final bytes = List<int>.generate(16, (_) => _random.nextInt(256));\\n    final id = 'p-${bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join()}';\\n    if (!await prefs.setString(key, id)) {\\n      throw StateError('Unable to persist phone identity');\\n    }\\n    return id;\\n  }\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/join/device_identity_store.dart\"}"},"time":{"start":1793461859082,"end":1793461862599}}}}
