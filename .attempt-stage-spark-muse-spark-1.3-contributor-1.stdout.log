{"type":"tool_use","timestamp":1793463642616,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c36591001adPVF2QFUZdt6t","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c3523e001pqao4OVUt0Gpa2","type":"tool","id":"call_01a192c3656576d481287e1d3d017388","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/test/host_flow_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/test/host_flow_test.dart, lines 1-1002\n1: // Host-first navigation, role-aware joining, and video administration.\n2: //\n3: // Exercises the REAL parser (guest_join_data role validation), the REAL\n4: // HostEntryScreen/JoinScreen routing, the REAL HostSession state machine,\n5: // and REAL response validation (HostJoinClient/HostMediaClient). ONLY the\n6: // platform/network boundaries are substituted: fake callable invokers\n7: // (never the clients, never the session) and fake scanners. No Firebase\n8: // initialization, no network traffic.\n9: \n10: import 'dart:async';\n11: \n12: import 'package:channel_api/channel_api.dart';\n13: import 'package:cloud_functions/cloud_functions.dart' as cloud_functions;\n14: import 'package:companion_app/src/companion_app.dart';\n15: import 'package:companion_app/src/config/backend_config.dart';\n16: import 'package:companion_app/src/data/host_join_client.dart';\n17: import 'package:companion_app/src/data/host_media_client.dart';\n18: import 'package:companion_app/src/data/party_join_client.dart';\n19: import 'package:companion_app/src/join/device_identity_store.dart';\n20: import 'package:companion_app/src/join/guest_join_data.dart';\n21: import 'package:companion_app/src/join/join_payload_scanner.dart';\n22: import 'package:companion_app/src/session/host_session.dart';\n23: import 'package:companion_app/src/ui/host_entry_screen.dart';\n24: import 'package:companion_app/src/ui/host_panel_screen.dart';\n25: import 'package:companion_app/src/ui/host_video_preview_screen.dart';\n26: import 'package:companion_app/src/ui/join_screen.dart';\n27: import 'package:core_foundation/core_foundation.dart'\n28:     show Ok, Result, SystemClock;\n29: import 'package:core_playlist/core_playlist.dart';\n30: import 'package:flutter/material.dart';\n31: import 'package:flutter_test/flutter_test.dart';\n32: import 'package:infra_firestore/infra_firestore.dart'\n33:     show FirebaseManifestCallableInvoker, ManifestTransportException;\n34: import 'package:shared_preferences/shared_preferences.dart';\n35: \n36: const String kGuestDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n37: const String kHostDeviceId = 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';\n38: const String kHostToken =\n39:     'hi-0123456789abcdef0123456789abcdef0123456789abcdef01';\n40: \n41: String hostPayload({\n42:   String party = 'party-1',\n43:   String channel = 'cctv',\n44:   String token = kHostToken,\n45: }) =>\n46:     '{\"partyId\":\"$party\",\"channelId\":\"$channel\",\"role\":\"host\",'\n47:     '\"inviteToken\":\"$token\"}';\n48: \n49: GuestJoinData hostData({\n50:   String party = 'party-1',\n51:   String channel = 'cctv',\n52:   String device = kHostDeviceId,\n53:   String token = kHostToken,\n54: }) {\n55:   final Result<GuestJoinData> result = parseGuestJoinFields(\n56:     partyId: party,\n57:     localDeviceId: device,\n58:     channelId: channel,\n59:     role: JoinRole.host,\n60:     inviteToken: token,\n61:   );\n62:   return (result as Ok<GuestJoinData>).value;\n63: }\n64: \n65: /// Fake joinHost boundary: echoes the requested scope into a valid host\n66: /// registration, or throws [failure] to script denial paths.\n67: final class FakeHostJoinInvoker implements HostJoinCallableInvoker {\n68:   int calls = 0;\n69:   Map<String, Object?>? lastPayload;\n70:   Object? failure;\n71:   Object? nextResponse;\n72:   bool createdFirst = true;\n73:   bool _created = false;\n74: \n75:   @override\n76:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n77:     calls++;\n78:     lastPayload = Map<String, Object?>.of(payload);\n79:     final Object? error = failure;\n80:     if (error != null) throw error;\n81:     if (name != kJoinHostCallable) throw StateError('unexpected $name');\n82:     final Object? override = nextResponse;\n83:     if (override != null) {\n84:       nextResponse = null;\n85:       return override;\n86:     }\n87:     final bool created = createdFirst && !_created;\n88:     _created = true;\n89:     return <String, Object?>{\n90:       'partyId': payload['partyId'],\n91:       'deviceId': payload['deviceId'],\n92:       'channelId': payload['channelId'],\n93:       'role': 'host',\n94:       'status': 'active',\n95:       'created': created,\n96:     };\n97:   }\n98: }\n99: \n100: /// Fake host-media boundary: backend-faithful seed catalog behavior.\n101: final class FakeHostMediaInvoker implements HostMediaCallableInvoker {\n102:   final List<String> names = <String>[];\n103:   final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];\n104:   final List<Map<String, Object?>> seeds = <Map<String, Object?>>[];\n105:   Object? failure;\n106:   int previews = 0;\n107: \n108:   static Map<String, Object?> seedJson(String id, String status) =>\n109:       <String, Object?>{\n110:         'seedId': id,\n111:         'partyId': 'party-1',\n112:         'channelId': 'cctv',\n113:         'status': status,\n114:         'jobId': 'hv-$id',\n115:         'createdAt': '2026-10-29T14:00:00.000Z',\n116:         'expiresAt': '2030-01-01T00:00:00.000Z',\n117:         'previewAvailable': status == 'ready',\n118:         'cameraIds': const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n119:       };\n120: \n121:   @override\n122:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n123:     names.add(name);\n124:     payloads.add(Map<String, Object?>.of(payload));\n125:     final Object? error = failure;\n126:     if (error != null) throw error;\n127:     switch (name) {\n128:       case kListHostVideos:\n129:         return <String, Object?>{\n130:           'videos': <Object?>[\n131:             for (final s in seeds) Map<String, Object?>.of(s),\n132:           ],\n133:         };\n134:       case kGenerateHostVideo:\n135:         final String seedId = payload['seedId'] as String;\n136:         final bool exists = seeds.any((s) => s['seedId'] == seedId);\n137:         if (!exists) {\n138:           seeds.add(seedJson(seedId, 'queued'));\n139:           return <String, Object?>{\n140:             'seedId': seedId,\n141:             'jobId': 'hv-$seedId',\n142:             'state': 'queued',\n143:             'created': true,\n144:           };\n145:         }\n146:         return <String, Object?>{\n147:           'seedId': seedId,\n148:           'jobId': 'hv-$seedId',\n149:           'state': 'queued',\n150:           'created': false,\n151:         };\n152:       case kGetHostVideoPreview:\n153:         previews++;\n154:         final String seedId = payload['seedId'] as String;\n155:         return <String, Object?>{\n156:           'seedId': seedId,\n157:           'expiresAt': '2030-01-01T00:00:00.000Z',\n158:           'clips': <Object?>[\n159:             for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\n160:               <String, Object?>{\n161:                 'cameraId': camera,\n162:                 'sha256': List.filled(64, 'a').join(),\n163:                 'url': 'https://preview.example/$seedId/$camera.mp4',\n164:                 'expiresAt': '2030-01-01T00:00:00.000Z',\n165:               },\n166:           ],\n167:         };\n168:       case kDeleteHostVideo:\n169:         final List<String> ids = <String>[\n170:           for (final Object? id in payload['seedIds'] as List) id.toString(),\n171:         ];\n172:         seeds.removeWhere((s) => ids.contains(s['seedId']));\n173:         return <String, Object?>{\n174:           'deletedSeedIds': ids,\n175:           'deletedObjects': <String>[\n176:             for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\n177:           ],\n178:           'revokedManifest': true,\n179:         };\n180:     }\n181:     throw StateError('unexpected callable $name');\n182:   }\n183: }\n184: \n185: final class FakeJoinInvoker implements PartyJoinCallableInvoker {\n186:   int calls = 0;\n187:   @override\n188:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n189:     calls++;\n190:     return <String, Object?>{\n191:       'partyId': payload['partyId'],\n192:       'deviceId': payload['deviceId'],\n193:       'channelId': payload['channelId'],\n194:       'role': 'guest',\n195:       'status': 'active',\n196:       'created': true,\n197:     };\n198:   }\n199: }\n200: \n201: final class FakeManifestInvoker implements FirebaseManifestCallableInvoker {\n202:   @override\n203:   Future<Object?> call(String name, Map<String, Object?> payload) async =>\n204:       throw UnimplementedError();\n205: }\n206: \n207: final class FakeManifestSource implements ManifestSource<PlaybackManifest> {\n208:   @override\n209:   Stream<PlaybackManifest> watchCurrent({\n210:     required String partyId,\n211:     required String channelId,\n212:   }) => const Stream<PlaybackManifest>.empty();\n213: }\n214: \n215: final class FakeScanner implements JoinPayloadScanner {\n216:   FakeScanner(this.result);\n217:   final JoinPayloadScanResult result;\n218:   @override\n219:   Future<JoinPayloadScanResult> scan([BuildContext? context]) async => result;\n220: }\n221: \n222: Future<void> flush(WidgetTester tester) async {\n223:   for (int i = 0; i < 6; i++) {\n224:     await tester.pump(const Duration(milliseconds: 50));\n225:   }\n226: }\n227: \n228: Future<void> enterVisible(\n229:   WidgetTester tester,\n230:   Finder finder,\n231:   String text,\n232: ) async {\n233:   await tester.ensureVisible(finder);\n234:   await tester.pump(const Duration(milliseconds: 50));\n235:   await tester.enterText(finder, text);\n236: }\n237: \n238: Future<void> tapVisible(WidgetTester tester, Finder finder) async {\n239:   await tester.ensureVisible(finder);\n240:   await tester.pump(const Duration(milliseconds: 50));\n241:   await tester.tap(finder);\n242: }\n243: \n244: void main() {\n245:   TestWidgetsFlutterBinding.ensureInitialized();\n246: \n247:   group('host session (real session, fake invoker boundary)', () {\n248:     late FakeHostJoinInvoker joinInvoker;\n249:     late FakeHostMediaInvoker mediaInvoker;\n250:     final List<HostSession> sessions = <HostSession>[];\n251: \n252:     HostSession openSession() {\n253:       final HostSession session = HostSession(\n254:         joinClient: HostJoinClient(invoker: joinInvoker),\n255:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n256:       );\n257:       sessions.add(session);\n258:       return session;\n259:     }\n260: \n261:     setUp(() {\n262:       joinInvoker = FakeHostJoinInvoker();\n263:       mediaInvoker = FakeHostMediaInvoker()\n264:         ..seeds.addAll(<Map<String, Object?>>[\n265:           FakeHostMediaInvoker.seedJson('catalog-1', 'ready'),\n266:           FakeHostMediaInvoker.seedJson('catalog-2', 'queued'),\n267:         ]);\n268:     });\n269: \n270:     tearDown(() async {\n271:       for (final HostSession session in sessions) {\n272:         await session.dispose();\n273:       }\n274:       sessions.clear();\n275:     });\n276: \n277:     test('join validates scope and loads the catalog', () async {\n278:       final HostSession session = openSession();\n279:       await session.join(hostData());\n280:       expect(session.state.status, HostSessionStatus.ready);\n281:       expect(session.state.binding?.deviceId.value, kHostDeviceId);\n282:       expect(session.videos.map((v) => '${v.seedId}:${v.status}'), <String>[\n283:         'catalog-1:ready',\n284:         'catalog-2:queued',\n285:       ]);\n286:       expect(joinInvoker.lastPayload, <String, Object?>{\n287:         'partyId': 'party-1',\n288:         'deviceId': kHostDeviceId,\n289:         'channelId': 'cctv',\n290:         'inviteToken': kHostToken,\n291:       });\n292:       expect(joinInvoker.lastPayload, isNot(contains('role')));\n293:     });\n294: \n295:     test('guest payloads never reach joinHost', () async {\n296:       final HostSession session = openSession();\n297:       final Result<GuestJoinData> parsed = parseGuestJoinPayload(\n298:         '{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}',\n299:         localDeviceId: kGuestDeviceId,\n300:       );\n301:       final GuestJoinData guest = (parsed as Ok<GuestJoinData>).value;\n302:       await expectLater(session.join(guest), throwsA(isA<HostJoinException>()));\n303:       expect(joinInvoker.calls, 0);\n304:       expect(session.state.status, HostSessionStatus.idle);\n305:     });\n306: \n307:     test(\n308:       'host denial surfaces the denied state with a sanitized message',\n309:       () async {\n310:         joinInvoker.failure = cloud_functions.FirebaseFunctionsException(\n311:           code: 'permission-denied',\n312:           message: 'raw backend detail must never surface',\n313:           details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n314:         );\n315:         final HostSession session = openSession();\n316:         await expectLater(\n317:           session.join(hostData()),\n318:           throwsA(\n319:             predicate<HostJoinException>(\n320:               (e) =>\n321:                   e.message == 'Access was denied.' &&\n322:                   !e.message.contains('raw backend'),\n323:             ),\n324:           ),\n325:         );\n326:         expect(session.state.status, HostSessionStatus.denied);\n327:         expect(session.state.message, 'Access was denied.');\n328:       },\n329:     );\n330: \n331:     test('scope mismatch fails visibly as invalid data', () async {\n332:       joinInvoker.nextResponse = <String, Object?>{\n333:         'partyId': 'other-party',\n334:         'deviceId': kHostDeviceId,\n335:         'channelId': 'cctv',\n336:         'role': 'host',\n337:         'status': 'active',\n338:         'created': true,\n339:       };\n340:       final HostSession session = openSession();\n341:       await expectLater(\n342:         session.join(hostData()),\n343:         throwsA(isA<HostJoinException>()),\n344:       );\n345:       expect(session.state.status, HostSessionStatus.invalidData);\n346:     });\n347: \n348:     test('generation retries reuse a stable idempotency key', () async {\n349:       final HostSession session = openSession();\n350:       await session.join(hostData());\n351:       mediaInvoker.names.clear();\n352:       mediaInvoker.payloads.clear();\n353:       await session.generate('catalog-9');\n354:       await session.generate('catalog-9');\n355:       final List<String> keys = <String>[\n356:         for (int i = 0; i < mediaInvoker.names.length; i++)\n357:           if (mediaInvoker.names[i] == kGenerateHostVideo)\n358:             mediaInvoker.payloads[i]['idempotencyKey'].toString(),\n359:       ];\n360:       expect(keys, hasLength(2));\n361:       expect(keys[0], isNotEmpty);\n362:       expect(keys[1], keys[0]);\n363:     });\n364: \n365:     test('delete reconciles only after authoritative success', () async {\n366:       final HostSession session = openSession();\n367:       await session.join(hostData());\n368:       expect(session.videos.map((v) => v.seedId), <String>[\n369:         'catalog-1',\n370:         'catalog-2',\n371:       ]);\n372:       await session.deleteVideos(const <String>['catalog-1']);\n373:       expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\n374:       mediaInvoker.failure = cloud_functions.FirebaseFunctionsException(\n375:         code: 'permission-denied',\n376:         message: 'denied',\n377:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n378:       );\n379:       await expectLater(\n380:         session.deleteVideos(const <String>['catalog-2']),\n381:         throwsA(isA<ManifestTransportException>()),\n382:       );\n383:       // Failure leaves the list untouched: still retryable.\n384:       expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\n385:     });\n386: \n387:     test('leaving drops late responses from a superseded refresh', () async {\n388:       final List<Completer<Map<String, Object?>>> gates =\n389:           <Completer<Map<String, Object?>>>[\n390:             Completer<Map<String, Object?>>(),\n391:             Completer<Map<String, Object?>>(),\n392:           ];\n393:       int lists = 0;\n394:       final HostSession session = HostSession(\n395:         joinClient: HostJoinClient(invoker: joinInvoker),\n396:         mediaClient: HostMediaClient(\n397:           invoker: _QueuedListInvoker(mediaInvoker, gates, () => lists++),\n398:         ),\n399:       );\n400:       sessions.add(session);\n401:       final Future<void> joining = session.join(hostData());\n402:       await Future<void>.delayed(Duration.zero);\n403:       gates[0].complete(<String, Object?>{\n404:         'videos': <Object?>[FakeHostMediaInvoker.seedJson('a', 'ready')],\n405:       });\n406:       await joining;\n407:       expect(session.state.status, HostSessionStatus.ready);\n408:       expect(session.videos.map((v) => v.seedId), <String>['a']);\n409:       final Future<void> pending = session.refresh();\n410:       await session.leave();\n411:       gates[1].complete(<String, Object?>{'videos': <Object?>[]});\n412:       await pending;\n413:       await Future<void>.delayed(Duration.zero);\n414:       expect(session.state.status, HostSessionStatus.idle);\n415:       expect(session.videos, isEmpty);\n416:       await session.dispose();\n417:     });\n418: \n419:     test('suspend stops polling and resume refreshes', () async {\n420:       final HostSession session = openSession();\n421:       await session.join(hostData());\n422:       final int lists = mediaInvoker.names\n423:           .where((n) => n == kListHostVideos)\n424:           .length;\n425:       await session.suspend();\n426:       expect(session.state.status, HostSessionStatus.stale);\n427:       expect(session.videos, hasLength(2));\n428:       await session.resume();\n429:       expect(\n430:         mediaInvoker.names.where((n) => n == kListHostVideos).length,\n431:         lists + 1,\n432:       );\n433:       expect(session.state.status, HostSessionStatus.ready);\n434:     });\n435:   });\n436: \n437:   group('host entry screen (real parser, fake scanner boundary)', () {\n438:     Future<void> pumpEntry(\n439:       WidgetTester tester, {\n440:       required void Function(GuestJoinData data) onHostJoin,\n441:       JoinPayloadScanner scanner = const UnavailableJoinPayloadScanner(),\n442:     }) async {\n443:       SharedPreferences.setMockInitialValues(<String, Object>{\n444:         DeviceIdentityStore.hostStorageKey: kHostDeviceId,\n445:         DeviceIdentityStore.storageKey: kGuestDeviceId,\n446:       });\n447:       await tester.pumpWidget(\n448:         MaterialApp(\n449:           home: HostEntryScreen(\n450:             onHostJoin: (data) async => onHostJoin(data),\n451:             onJoinAsGuest: () {},\n452:             scanner: scanner,\n453:           ),\n454:         ),\n455:       );\n456:       await tester.pumpAndSettle();\n457:     }\n458: \n459:     testWidgets('boot offers scan, paste, retry, and a guest route', (\n460:       tester,\n461:     ) async {\n462:       GuestJoinData? received;\n463:       await pumpEntry(tester, onHostJoin: (data) => received = data);\n464:       expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n465:       expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\n466:       expect(find.byKey(HostEntryScreen.submitKey), findsOneWidget);\n467:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n468:       expect(received, isNull);\n469:       expect(tester.takeException(), isNull);\n470:     });\n471: \n472:     testWidgets('scan and paste reach the same host payload (parity)', (\n473:       tester,\n474:     ) async {\n475:       GuestJoinData? scanned;\n476:       await pumpEntry(\n477:         tester,\n478:         onHostJoin: (data) => scanned = data,\n479:         scanner: FakeScanner(JoinPayloadText(hostPayload())),\n480:       );\n481:       await tester.tap(find.byKey(HostEntryScreen.scanKey));\n482:       await tester.pumpAndSettle();\n483: \n484:       GuestJoinData? pasted;\n485:       await pumpEntry(tester, onHostJoin: (data) => pasted = data);\n486:       await tester.enterText(\n487:         find.byKey(HostEntryScreen.payloadFieldKey),\n488:         hostPayload(),\n489:       );\n490:       await tester.tap(find.byKey(HostEntryScreen.submitKey));\n491:       await tester.pumpAndSettle();\n492: \n493:       expect(scanned, isNotNull);\n494:       expect(pasted, isNotNull);\n495:       expect(scanned, pasted);\n496:       expect(scanned?.role, JoinRole.host);\n497:       expect(scanned?.inviteToken, kHostToken);\n498:       // The host phone identity is separate from the guest identity.\n499:       expect(scanned?.deviceId.value, kHostDeviceId);\n500:       expect(scanned?.deviceId.value, isNot(kGuestDeviceId));\n501:       expect(tester.takeException(), isNull);\n502:     });\n503: \n504:     testWidgets('guest payloads fail visibly without network', (tester) async {\n505:       var joined = false;\n506:       await pumpEntry(\n507:         tester,\n508:         onHostJoin: (_) => joined = true,\n509:         scanner: FakeScanner(\n510:           const JoinPayloadText('{\"partyId\":\"p\",\"channelId\":\"c\"}'),\n511:         ),\n512:       );\n513:       await tester.tap(find.byKey(HostEntryScreen.scanKey));\n514:       await tester.pumpAndSettle();\n515:       expect(joined, isFalse);\n516:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n517:       expect(find.textContaining('Join as guest'), findsWidgets);\n518:     });\n519: \n520:     testWidgets('unknown roles fail visibly', (tester) async {\n521:       var joined = false;\n522:       await pumpEntry(tester, onHostJoin: (_) => joined = true);\n523:       await tester.enterText(\n524:         find.byKey(HostEntryScreen.payloadFieldKey),\n525:         '{\"partyId\":\"p\",\"channelId\":\"c\",\"role\":\"admin\"}',\n526:       );\n527:       await tester.tap(find.byKey(HostEntryScreen.submitKey));\n528:       await tester.pumpAndSettle();\n529:       expect(joined, isFalse);\n530:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n531:       expect(\n532:         tester.widget<Text>(find.byKey(HostEntryScreen.errorKey)).data,\n533:         contains('unknown role'),\n534:       );\n535:     });\n536: \n537:     testWidgets('legacy guest payloads route to the guest form, not host', (\n538:       tester,\n539:     ) async {\n540:       GuestJoinData? received;\n541:       SharedPreferences.setMockInitialValues(<String, Object>{\n542:         DeviceIdentityStore.storageKey: kGuestDeviceId,\n543:       });\n544:       await tester.pumpWidget(\n545:         MaterialApp(home: JoinScreen(onJoin: (data) async => received = data)),\n546:       );\n547:       await tester.pumpAndSettle();\n548:       await tester.enterText(\n549:         find.byKey(JoinScreen.payloadFieldKey),\n550:         '{\"partyId\":\"legacy\",\"channelId\":\"cctv\"}',\n551:       );\n552:       await tester.tap(find.byKey(JoinScreen.submitKey));\n553:       await tester.pumpAndSettle();\n554:       expect(received?.role, JoinRole.guest);\n555:       expect(received?.partyId.value, 'legacy');\n556:     });\n557:   });\n558: \n559:   group('host panel screen (real session, fake invoker boundary)', () {\n560:     late FakeHostJoinInvoker joinInvoker;\n561:     late FakeHostMediaInvoker mediaInvoker;\n562: \n563:     Future<HostSession> joinedSession() async {\n564:       final HostSession session = HostSession(\n565:         joinClient: HostJoinClient(invoker: joinInvoker),\n566:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n567:       );\n568:       addTearDown(session.dispose);\n569:       await session.join(hostData());\n570:       return session;\n571:     }\n572: \n573:     Future<void> pumpPanel(\n574:       WidgetTester tester,\n575:       HostSession session, {\n576:       void Function(String seedId)? onPreview,\n577:     }) async {\n578:       await tester.pumpWidget(\n579:         MaterialApp(\n580:           home: HostPanelScreen(\n581:             session: session,\n582:             onLeave: () async {},\n583:             onPreview: onPreview ?? (_) {},\n584:           ),\n585:         ),\n586:       );\n587:       await flush(tester);\n588:     }\n589: \n590:     setUp(() {\n591:       joinInvoker = FakeHostJoinInvoker();\n592:       mediaInvoker = FakeHostMediaInvoker();\n593:     });\n594: \n595:     testWidgets('lists empty, queued, ready, failed, and deleted states', (\n596:       tester,\n597:     ) async {\n598:       mediaInvoker.seeds.addAll(<Map<String, Object?>>[\n599:         FakeHostMediaInvoker.seedJson('q', 'queued'),\n600:         FakeHostMediaInvoker.seedJson('r', 'ready'),\n601:         FakeHostMediaInvoker.seedJson('f', 'failed'),\n602:         FakeHostMediaInvoker.seedJson('d', 'deleted'),\n603:       ]);\n604:       final HostSession session = await joinedSession();\n605:       await pumpPanel(tester, session);\n606:       expect(find.textContaining('q · Queued'), findsOneWidget);\n607:       expect(find.textContaining('r · Ready'), findsOneWidget);\n608:       expect(find.textContaining('f · Failed'), findsOneWidget);\n609:       expect(find.textContaining('d · Deleted'), findsOneWidget);\n610:       // Deleted seeds offer no actions; live ones offer view + delete.\n611:       expect(find.byKey(HostPanelScreen.viewKey('d')), findsNothing);\n612:       expect(find.byKey(HostPanelScreen.deleteKey('d')), findsNothing);\n613:       expect(find.byKey(HostPanelScreen.viewKey('r')), findsOneWidget);\n614:       expect(find.byKey(HostPanelScreen.deleteKey('r')), findsOneWidget);\n615:       await session.dispose();\n616:       await flush(tester);\n617:       expect(tester.takeException(), isNull);\n618:     });\n619: \n620:     testWidgets('empty catalog explains itself and generates', (tester) async {\n621:       final HostSession session = await joinedSession();\n622:       await pumpPanel(tester, session);\n623:       expect(find.byKey(HostPanelScreen.emptyKey), findsOneWidget);\n624:       await enterVisible(\n625:         tester,\n626:         find.byKey(HostPanelScreen.generateSeedKey),\n627:         'catalog-new',\n628:       );\n629:       await tapVisible(tester, find.byKey(HostPanelScreen.generateKey));\n630:       await flush(tester);\n631:       expect(find.textContaining('catalog-new · Queued'), findsOneWidget);\n632:       expect(\n633:         mediaInvoker.payloads\n634:             .where((p) => p['seedId'] == 'catalog-new')\n635:             .map((p) => p['presetId']),\n636:         <String>[kCheapDemoPresetId],\n637:       );\n638:       await session.dispose();\n639:       await flush(tester);\n640:     });\n641: \n642:     testWidgets('delete success reconciles; failure stays retryable', (\n643:       tester,\n644:     ) async {\n645:       mediaInvoker.seeds.addAll(<Map<String, Object?>>[\n646:         FakeHostMediaInvoker.seedJson('a', 'ready'),\n647:         FakeHostMediaInvoker.seedJson('b', 'ready'),\n648:       ]);\n649:       final HostSession session = await joinedSession();\n650:       await pumpPanel(tester, session);\n651:       await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('a')));\n652:       await flush(tester);\n653:       expect(find.textContaining('a · Ready'), findsNothing);\n654:       expect(find.textContaining('b · Ready'), findsOneWidget);\n655:       mediaInvoker.failure = cloud_functions.FirebaseFunctionsException(\n656:         code: 'permission-denied',\n657:         message: 'denied',\n658:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n659:       );\n660:       await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('b')));\n661:       await flush(tester);\n662:       expect(find.byKey(HostPanelScreen.messageKey), findsOneWidget);\n663:       expect(find.textContaining('b · Ready'), findsOneWidget);\n664:       await session.dispose();\n665:       await flush(tester);\n666:     });\n667: \n668:     testWidgets('view opens the preview callback per seed', (tester) async {\n669:       mediaInvoker.seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n670:       String? viewed;\n671:       final HostSession session = await joinedSession();\n672:       await pumpPanel(tester, session, onPreview: (seedId) => viewed = seedId);\n673:       await tapVisible(tester, find.byKey(HostPanelScreen.viewKey('v')));\n674:       await flush(tester);\n675:       expect(viewed, 'v');\n676:       await session.dispose();\n677:       await flush(tester);\n678:     });\n679:   });\n680: \n681:   group('host preview screen (real session, fake media boundary)', () {\n682:     testWidgets('obtains a fresh capability and disposes playback resources', (\n683:       tester,\n684:     ) async {\n685:       final FakeHostJoinInvoker joinInvoker = FakeHostJoinInvoker();\n686:       final FakeHostMediaInvoker mediaInvoker = FakeHostMediaInvoker()\n687:         ..seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n688:       final HostSession session = HostSession(\n689:         joinClient: HostJoinClient(invoker: joinInvoker),\n690:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n691:       );\n692:       addTearDown(session.dispose);\n693:       await session.join(hostData());\n694:       final List<FakePreviewPlayer> players = <FakePreviewPlayer>[];\n695: \n696:       await tester.pumpWidget(\n697:         MaterialApp(\n698:           home: HostVideoPreviewScreen(\n699:             session: session,\n700:             seedId: 'v',\n701:             playerFactory: (url) {\n702:               final FakePreviewPlayer player = FakePreviewPlayer(url);\n703:               players.add(player);\n704:               return player;\n705:             },\n706:           ),\n707:         ),\n708:       );\n709:       await flush(tester);\n710:       // Fresh scoped capability per view: exactly one preview call.\n711:       expect(mediaInvoker.previews, 1);\n712:       for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04']) {\n713:         expect(\n714:           find.byKey(HostVideoPreviewScreen.playKey(camera)),\n715:           findsOneWidget,\n716:         );\n717:       }\n718:       // Playing wires the real lifecycle: initialize -> play -> show.\n719:       await tapVisible(\n720:         tester,\n721:         find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n722:       );\n723:       await flush(tester);\n724:       expect(players, hasLength(1));\n725:       expect(players.single.initialized, isTrue);\n726:       expect(players.single.playing, isTrue);\n727:       expect(find.byKey(HostVideoPreviewScreen.videoKey), findsOneWidget);\n728:       // Switching cameras disposes the previous player.\n729:       await tapVisible(\n730:         tester,\n731:         find.byKey(HostVideoPreviewScreen.playKey('CAM-02')),\n732:       );\n733:       await flush(tester);\n734:       expect(players, hasLength(2));\n735:       expect(players.first.disposed, isTrue);\n736:       expect(find.text('Playing'), findsOneWidget);\n737:       // Leaving disposes playback resources without exceptions.\n738:       await session.dispose();\n739:       await tester.pumpWidget(const SizedBox());\n740:       await flush(tester);\n741:       expect(players.last.disposed, isTrue);\n742:       expect(tester.takeException(), isNull);\n743:       expect(mediaInvoker.previews, 1);\n744:     });\n745: \n746:     testWidgets('playback failure surfaces visibly and stays retryable', (\n747:       tester,\n748:     ) async {\n749:       final FakeHostJoinInvoker joinInvoker = FakeHostJoinInvoker();\n750:       final FakeHostMediaInvoker mediaInvoker = FakeHostMediaInvoker()\n751:         ..seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n752:       final HostSession session = HostSession(\n753:         joinClient: HostJoinClient(invoker: joinInvoker),\n754:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n755:       );\n756:       addTearDown(session.dispose);\n757:       await session.join(hostData());\n758: \n759:       await tester.pumpWidget(\n760:         MaterialApp(\n761:           home: HostVideoPreviewScreen(\n762:             session: session,\n763:             seedId: 'v',\n764:             playerFactory: (_) => _FailingPreviewPlayer(),\n765:           ),\n766:         ),\n767:       );\n768:       await flush(tester);\n769:       await tapVisible(\n770:         tester,\n771:         find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n772:       );\n773:       await flush(tester);\n774:       expect(find.byKey(HostVideoPreviewScreen.errorKey), findsOneWidget);\n775:       expect(find.byKey(HostVideoPreviewScreen.videoKey), findsNothing);\n776:       // Retryable: the camera row is still present.\n777:       expect(\n778:         find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n779:         findsOneWidget,\n780:       );\n781:       await session.dispose();\n782:       await tester.pumpWidget(const SizedBox());\n783:       await flush(tester);\n784:       expect(tester.takeException(), isNull);\n785:     });\n786:   });\n787: \n788:   group('companion app host flow (production-path routing)', () {\n789:     late FakeHostJoinInvoker joinInvoker;\n790:     late FakeHostMediaInvoker mediaInvoker;\n791:     late FakeJoinInvoker guestJoinInvoker;\n792:     late FakeManifestInvoker manifestInvoker;\n793: \n794:     Future<void> pumpHostApp(WidgetTester tester) async {\n795:       SharedPreferences.setMockInitialValues(<String, Object>{\n796:         DeviceIdentityStore.storageKey: kGuestDeviceId,\n797:         DeviceIdentityStore.hostStorageKey: kHostDeviceId,\n798:       });\n799:       await tester.pumpWidget(\n800:         CompanionApp(\n801:           config: BackendConfig.parse(<String, Object?>{\n802:             'apiKey': 'test-api-key',\n803:             'appId': '1:123:android:abc',\n804:             'projectId': 'test-project',\n805:           }),\n806:           firebaseBootstrap: (_) async {},\n807:           invokerOverride: manifestInvoker,\n808:           partyJoinInvokerOverride: guestJoinInvoker,\n809:           hostJoinInvokerOverride: joinInvoker,\n810:           hostMediaInvokerOverride: mediaInvoker,\n811:           clock: const SystemClock(),\n812:         ),\n813:       );\n814:       await flush(tester);\n815:     }\n816: \n817:     setUp(() {\n818:       joinInvoker = FakeHostJoinInvoker();\n819:       mediaInvoker = FakeHostMediaInvoker()\n820:         ..seeds.add(FakeHostMediaInvoker.seedJson('catalog-1', 'ready'));\n821:       guestJoinInvoker = FakeJoinInvoker();\n822:       manifestInvoker = FakeManifestInvoker();\n823:     });\n824: \n825:     testWidgets('host invite redeems into the panel only after validation', (\n826:       tester,\n827:     ) async {\n828:       await pumpHostApp(tester);\n829:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n830:       await enterVisible(\n831:         tester,\n832:         find.byKey(HostEntryScreen.payloadFieldKey),\n833:         hostPayload(),\n834:       );\n835:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n836:       await flush(tester);\n837:       // Scope validated -> panel with the server-backed catalog.\n838:       expect(find.byType(HostPanelScreen), findsOneWidget);\n839:       expect(find.textContaining('catalog-1 · Ready'), findsOneWidget);\n840:       expect(guestJoinInvoker.calls, 0);\n841:       expect(tester.takeException(), isNull);\n842:     });\n843: \n844:     testWidgets('host denial fails visibly on the entry screen', (\n845:       tester,\n846:     ) async {\n847:       joinInvoker.failure = cloud_functions.FirebaseFunctionsException(\n848:         code: 'permission-denied',\n849:         message: 'raw detail must never surface',\n850:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n851:       );\n852:       await pumpHostApp(tester);\n853:       await enterVisible(\n854:         tester,\n855:         find.byKey(HostEntryScreen.payloadFieldKey),\n856:         hostPayload(),\n857:       );\n858:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n859:       await flush(tester);\n860:       expect(find.byType(HostPanelScreen), findsNothing);\n861:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n862:       expect(find.text('Access was denied.'), findsOneWidget);\n863:       expect(find.textContaining('raw detail'), findsNothing);\n864:     });\n865: \n866:     testWidgets('guest payload on host entry never touches joinHost', (\n867:       tester,\n868:     ) async {\n869:       await pumpHostApp(tester);\n870:       await enterVisible(\n871:         tester,\n872:         find.byKey(HostEntryScreen.payloadFieldKey),\n873:         '{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}',\n874:       );\n875:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n876:       await flush(tester);\n877:       expect(joinInvoker.calls, 0);\n878:       expect(find.byType(HostPanelScreen), findsNothing);\n879:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n880:     });\n881: \n882:     testWidgets('leave returns to the dedicated entry', (tester) async {\n883:       await pumpHostApp(tester);\n884:       await enterVisible(\n885:         tester,\n886:         find.byKey(HostEntryScreen.payloadFieldKey),\n887:         hostPayload(),\n888:       );\n889:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n890:       await flush(tester);\n891:       expect(find.byType(HostPanelScreen), findsOneWidget);\n892:       await tapVisible(tester, find.byKey(HostPanelScreen.leaveKey));\n893:       await flush(tester);\n894:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n895:       expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n896:     });\n897: \n898:     testWidgets('offline boot stays usable without network calls', (\n899:       tester,\n900:     ) async {\n901:       SharedPreferences.setMockInitialValues(<String, Object>{});\n902:       await tester.pumpWidget(const CompanionApp());\n903:       await flush(tester);\n904:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n905:       expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n906:       // Submitting a host payload offline fails visibly, with no invoker\n907:       // available and no network attempted.\n908:       await enterVisible(\n909:         tester,\n910:         find.byKey(HostEntryScreen.payloadFieldKey),\n911:         hostPayload(),\n912:       );\n913:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n914:       await flush(tester);\n915:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n916:       expect(find.byType(HostPanelScreen), findsNothing);\n917:     });\n918:   });\n919: }\n920: \n921: /// Fake platform player: substitutes ONLY the video_player boundary.\n922: final class FakePreviewPlayer implements HostPreviewPlayer {\n923:   FakePreviewPlayer(this.url);\n924:   final Uri url;\n925:   bool initialized = false;\n926:   bool playing = false;\n927:   bool disposed = false;\n928: \n929:   @override\n930:   Future<void> initialize() async {\n931:     initialized = true;\n932:   }\n933: \n934:   @override\n935:   Future<void> play() async {\n936:     playing = true;\n937:   }\n938: \n939:   @override\n940:   Future<void> pause() async {\n941:     playing = false;\n942:   }\n943: \n944:   @override\n945:   Future<void> dispose() async {\n946:     disposed = true;\n947:   }\n948: \n949:   @override\n950:   bool get isInitialized => initialized && !disposed;\n951: \n952:   @override\n953:   double get aspectRatio => 16 / 9;\n954: \n955:   @override\n956:   Widget buildView() => const SizedBox();\n957: }\n958: \n959: /// Player whose platform initialization always fails.\n960: final class _FailingPreviewPlayer implements HostPreviewPlayer {\n961:   @override\n962:   Future<void> initialize() async {\n963:     throw StateError('platform player unavailable');\n964:   }\n965: \n966:   @override\n967:   Future<void> play() async {}\n968: \n969:   @override\n970:   Future<void> pause() async {}\n971: \n972:   @override\n973:   Future<void> dispose() async {}\n974: \n975:   @override\n976:   bool get isInitialized => false;\n977: \n978:   @override\n979:   double get aspectRatio => 16 / 9;\n980: \n981:   @override\n982:   Widget buildView() => const SizedBox();\n983: }\n984: \n985: /// Forwards list calls to queued gates so tests can interleave leave/refresh\n986: /// and prove stale responses are dropped; every other callable delegates.\n987: final class _QueuedListInvoker implements HostMediaCallableInvoker {\n988:   _QueuedListInvoker(this._inner, this._gates, this._onList);\n989:   final FakeHostMediaInvoker _inner;\n990:   final List<Completer<Map<String, Object?>>> _gates;\n991:   final void Function() _onList;\n992:   int _lists = 0;\n993: \n994:   @override\n995:   Future<Object?> call(String name, Map<String, Object?> payload) {\n996:     if (name == kListHostVideos) {\n997:       _onList();\n998:       return _gates[_lists++].future;\n999:     }\n1000:     return _inner.call(name, payload);\n1001:   }\n1002: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/test/host_flow_test.dart, lines 1-1002\n1: // Host-first navigation, role-aware joining, and video administration.\n2: //\n3: // Exercises the REAL parser (guest_join_data role validation), the REAL\n4: // HostEntryScreen/JoinScreen routing, the REAL HostSession state machine,\n5: // and REAL response validation (HostJoinClient/HostMediaClient). ONLY the\n6: // platform/network boundaries are substituted: fake callable invokers\n7: // (never the clients, never the session) and fake scanners. No Firebase\n8: // initialization, no network traffic.\n9: \n10: import 'dart:async';\n11: \n12: import 'package:channel_api/channel_api.dart';\n13: import 'package:cloud_functions/cloud_functions.dart' as cloud_functions;\n14: import 'package:companion_app/src/companion_app.dart';\n15: import 'package:companion_app/src/config/backend_config.dart';\n16: import 'package:companion_app/src/data/host_join_client.dart';\n17: import 'package:companion_app/src/data/host_media_client.dart';\n18: import 'package:companion_app/src/data/party_join_client.dart';\n19: import 'package:companion_app/src/join/device_identity_store.dart';\n20: import 'package:companion_app/src/join/guest_join_data.dart';\n21: import 'package:companion_app/src/join/join_payload_scanner.dart';\n22: import 'package:companion_app/src/session/host_session.dart';\n23: import 'package:companion_app/src/ui/host_entry_screen.dart';\n24: import 'package:companion_app/src/ui/host_panel_screen.dart';\n25: import 'package:companion_app/src/ui/host_video_preview_screen.dart';\n26: import 'package:companion_app/src/ui/join_screen.dart';\n27: import 'package:core_foundation/core_foundation.dart'\n28:     show Ok, Result, SystemClock;\n29: import 'package:core_playlist/core_playlist.dart';\n30: import 'package:flutter/material.dart';\n31: import 'package:flutter_test/flutter_test.dart';\n32: import 'package:infra_firestore/infra_firestore.dart'\n33:     show FirebaseManifestCallableInvoker, ManifestTransportException;\n34: import 'package:shared_preferences/shared_preferences.dart';\n35: \n36: const String kGuestDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\n37: const String kHostDeviceId = 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';\n38: const String kHostToken =\n39:     'hi-0123456789abcdef0123456789abcdef0123456789abcdef01';\n40: \n41: String hostPayload({\n42:   String party = 'party-1',\n43:   String channel = 'cctv',\n44:   String token = kHostToken,\n45: }) =>\n46:     '{\"partyId\":\"$party\",\"channelId\":\"$channel\",\"role\":\"host\",'\n47:     '\"inviteToken\":\"$token\"}';\n48: \n49: GuestJoinData hostData({\n50:   String party = 'party-1',\n51:   String channel = 'cctv',\n52:   String device = kHostDeviceId,\n53:   String token = kHostToken,\n54: }) {\n55:   final Result<GuestJoinData> result = parseGuestJoinFields(\n56:     partyId: party,\n57:     localDeviceId: device,\n58:     channelId: channel,\n59:     role: JoinRole.host,\n60:     inviteToken: token,\n61:   );\n62:   return (result as Ok<GuestJoinData>).value;\n63: }\n64: \n65: /// Fake joinHost boundary: echoes the requested scope into a valid host\n66: /// registration, or throws [failure] to script denial paths.\n67: final class FakeHostJoinInvoker implements HostJoinCallableInvoker {\n68:   int calls = 0;\n69:   Map<String, Object?>? lastPayload;\n70:   Object? failure;\n71:   Object? nextResponse;\n72:   bool createdFirst = true;\n73:   bool _created = false;\n74: \n75:   @override\n76:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n77:     calls++;\n78:     lastPayload = Map<String, Object?>.of(payload);\n79:     final Object? error = failure;\n80:     if (error != null) throw error;\n81:     if (name != kJoinHostCallable) throw StateError('unexpected $name');\n82:     final Object? override = nextResponse;\n83:     if (override != null) {\n84:       nextResponse = null;\n85:       return override;\n86:     }\n87:     final bool created = createdFirst && !_created;\n88:     _created = true;\n89:     return <String, Object?>{\n90:       'partyId': payload['partyId'],\n91:       'deviceId': payload['deviceId'],\n92:       'channelId': payload['channelId'],\n93:       'role': 'host',\n94:       'status': 'active',\n95:       'created': created,\n96:     };\n97:   }\n98: }\n99: \n100: /// Fake host-media boundary: backend-faithful seed catalog behavior.\n101: final class FakeHostMediaInvoker implements HostMediaCallableInvoker {\n102:   final List<String> names = <String>[];\n103:   final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];\n104:   final List<Map<String, Object?>> seeds = <Map<String, Object?>>[];\n105:   Object? failure;\n106:   int previews = 0;\n107: \n108:   static Map<String, Object?> seedJson(String id, String status) =>\n109:       <String, Object?>{\n110:         'seedId': id,\n111:         'partyId': 'party-1',\n112:         'channelId': 'cctv',\n113:         'status': status,\n114:         'jobId': 'hv-$id',\n115:         'createdAt': '2026-10-29T14:00:00.000Z',\n116:         'expiresAt': '2030-01-01T00:00:00.000Z',\n117:         'previewAvailable': status == 'ready',\n118:         'cameraIds': const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n119:       };\n120: \n121:   @override\n122:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n123:     names.add(name);\n124:     payloads.add(Map<String, Object?>.of(payload));\n125:     final Object? error = failure;\n126:     if (error != null) throw error;\n127:     switch (name) {\n128:       case kListHostVideos:\n129:         return <String, Object?>{\n130:           'videos': <Object?>[\n131:             for (final s in seeds) Map<String, Object?>.of(s),\n132:           ],\n133:         };\n134:       case kGenerateHostVideo:\n135:         final String seedId = payload['seedId'] as String;\n136:         final bool exists = seeds.any((s) => s['seedId'] == seedId);\n137:         if (!exists) {\n138:           seeds.add(seedJson(seedId, 'queued'));\n139:           return <String, Object?>{\n140:             'seedId': seedId,\n141:             'jobId': 'hv-$seedId',\n142:             'state': 'queued',\n143:             'created': true,\n144:           };\n145:         }\n146:         return <String, Object?>{\n147:           'seedId': seedId,\n148:           'jobId': 'hv-$seedId',\n149:           'state': 'queued',\n150:           'created': false,\n151:         };\n152:       case kGetHostVideoPreview:\n153:         previews++;\n154:         final String seedId = payload['seedId'] as String;\n155:         return <String, Object?>{\n156:           'seedId': seedId,\n157:           'expiresAt': '2030-01-01T00:00:00.000Z',\n158:           'clips': <Object?>[\n159:             for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\n160:               <String, Object?>{\n161:                 'cameraId': camera,\n162:                 'sha256': List.filled(64, 'a').join(),\n163:                 'url': 'https://preview.example/$seedId/$camera.mp4',\n164:                 'expiresAt': '2030-01-01T00:00:00.000Z',\n165:               },\n166:           ],\n167:         };\n168:       case kDeleteHostVideo:\n169:         final List<String> ids = <String>[\n170:           for (final Object? id in payload['seedIds'] as List) id.toString(),\n171:         ];\n172:         seeds.removeWhere((s) => ids.contains(s['seedId']));\n173:         return <String, Object?>{\n174:           'deletedSeedIds': ids,\n175:           'deletedObjects': <String>[\n176:             for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\n177:           ],\n178:           'revokedManifest': true,\n179:         };\n180:     }\n181:     throw StateError('unexpected callable $name');\n182:   }\n183: }\n184: \n185: final class FakeJoinInvoker implements PartyJoinCallableInvoker {\n186:   int calls = 0;\n187:   @override\n188:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n189:     calls++;\n190:     return <String, Object?>{\n191:       'partyId': payload['partyId'],\n192:       'deviceId': payload['deviceId'],\n193:       'channelId': payload['channelId'],\n194:       'role': 'guest',\n195:       'status': 'active',\n196:       'created': true,\n197:     };\n198:   }\n199: }\n200: \n201: final class FakeManifestInvoker implements FirebaseManifestCallableInvoker {\n202:   @override\n203:   Future<Object?> call(String name, Map<String, Object?> payload) async =>\n204:       throw UnimplementedError();\n205: }\n206: \n207: final class FakeManifestSource implements ManifestSource<PlaybackManifest> {\n208:   @override\n209:   Stream<PlaybackManifest> watchCurrent({\n210:     required String partyId,\n211:     required String channelId,\n212:   }) => const Stream<PlaybackManifest>.empty();\n213: }\n214: \n215: final class FakeScanner implements JoinPayloadScanner {\n216:   FakeScanner(this.result);\n217:   final JoinPayloadScanResult result;\n218:   @override\n219:   Future<JoinPayloadScanResult> scan([BuildContext? context]) async => result;\n220: }\n221: \n222: Future<void> flush(WidgetTester tester) async {\n223:   for (int i = 0; i < 6; i++) {\n224:     await tester.pump(const Duration(milliseconds: 50));\n225:   }\n226: }\n227: \n228: Future<void> enterVisible(\n229:   WidgetTester tester,\n230:   Finder finder,\n231:   String text,\n232: ) async {\n233:   await tester.ensureVisible(finder);\n234:   await tester.pump(const Duration(milliseconds: 50));\n235:   await tester.enterText(finder, text);\n236: }\n237: \n238: Future<void> tapVisible(WidgetTester tester, Finder finder) async {\n239:   await tester.ensureVisible(finder);\n240:   await tester.pump(const Duration(milliseconds: 50));\n241:   await tester.tap(finder);\n242: }\n243: \n244: void main() {\n245:   TestWidgetsFlutterBinding.ensureInitialized();\n246: \n247:   group('host session (real session, fake invoker boundary)', () {\n248:     late FakeHostJoinInvoker joinInvoker;\n249:     late FakeHostMediaInvoker mediaInvoker;\n250:     final List<HostSession> sessions = <HostSession>[];\n251: \n252:     HostSession openSession() {\n253:       final HostSession session = HostSession(\n254:         joinClient: HostJoinClient(invoker: joinInvoker),\n255:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n256:       );\n257:       sessions.add(session);\n258:       return session;\n259:     }\n260: \n261:     setUp(() {\n262:       joinInvoker = FakeHostJoinInvoker();\n263:       mediaInvoker = FakeHostMediaInvoker()\n264:         ..seeds.addAll(<Map<String, Object?>>[\n265:           FakeHostMediaInvoker.seedJson('catalog-1', 'ready'),\n266:           FakeHostMediaInvoker.seedJson('catalog-2', 'queued'),\n267:         ]);\n268:     });\n269: \n270:     tearDown(() async {\n271:       for (final HostSession session in sessions) {\n272:         await session.dispose();\n273:       }\n274:       sessions.clear();\n275:     });\n276: \n277:     test('join validates scope and loads the catalog', () async {\n278:       final HostSession session = openSession();\n279:       await session.join(hostData());\n280:       expect(session.state.status, HostSessionStatus.ready);\n281:       expect(session.state.binding?.deviceId.value, kHostDeviceId);\n282:       expect(session.videos.map((v) => '${v.seedId}:${v.status}'), <String>[\n283:         'catalog-1:ready',\n284:         'catalog-2:queued',\n285:       ]);\n286:       expect(joinInvoker.lastPayload, <String, Object?>{\n287:         'partyId': 'party-1',\n288:         'deviceId': kHostDeviceId,\n289:         'channelId': 'cctv',\n290:         'inviteToken': kHostToken,\n291:       });\n292:       expect(joinInvoker.lastPayload, isNot(contains('role')));\n293:     });\n294: \n295:     test('guest payloads never reach joinHost', () async {\n296:       final HostSession session = openSession();\n297:       final Result<GuestJoinData> parsed = parseGuestJoinPayload(\n298:         '{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}',\n299:         localDeviceId: kGuestDeviceId,\n300:       );\n301:       final GuestJoinData guest = (parsed as Ok<GuestJoinData>).value;\n302:       await expectLater(session.join(guest), throwsA(isA<HostJoinException>()));\n303:       expect(joinInvoker.calls, 0);\n304:       expect(session.state.status, HostSessionStatus.idle);\n305:     });\n306: \n307:     test(\n308:       'host denial surfaces the denied state with a sanitized message',\n309:       () async {\n310:         joinInvoker.failure = cloud_functions.FirebaseFunctionsException(\n311:           code: 'permission-denied',\n312:           message: 'raw backend detail must never surface',\n313:           details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n314:         );\n315:         final HostSession session = openSession();\n316:         await expectLater(\n317:           session.join(hostData()),\n318:           throwsA(\n319:             predicate<HostJoinException>(\n320:               (e) =>\n321:                   e.message == 'Access was denied.' &&\n322:                   !e.message.contains('raw backend'),\n323:             ),\n324:           ),\n325:         );\n326:         expect(session.state.status, HostSessionStatus.denied);\n327:         expect(session.state.message, 'Access was denied.');\n328:       },\n329:     );\n330: \n331:     test('scope mismatch fails visibly as invalid data', () async {\n332:       joinInvoker.nextResponse = <String, Object?>{\n333:         'partyId': 'other-party',\n334:         'deviceId': kHostDeviceId,\n335:         'channelId': 'cctv',\n336:         'role': 'host',\n337:         'status': 'active',\n338:         'created': true,\n339:       };\n340:       final HostSession session = openSession();\n341:       await expectLater(\n342:         session.join(hostData()),\n343:         throwsA(isA<HostJoinException>()),\n344:       );\n345:       expect(session.state.status, HostSessionStatus.invalidData);\n346:     });\n347: \n348:     test('generation retries reuse a stable idempotency key', () async {\n349:       final HostSession session = openSession();\n350:       await session.join(hostData());\n351:       mediaInvoker.names.clear();\n352:       mediaInvoker.payloads.clear();\n353:       await session.generate('catalog-9');\n354:       await session.generate('catalog-9');\n355:       final List<String> keys = <String>[\n356:         for (int i = 0; i < mediaInvoker.names.length; i++)\n357:           if (mediaInvoker.names[i] == kGenerateHostVideo)\n358:             mediaInvoker.payloads[i]['idempotencyKey'].toString(),\n359:       ];\n360:       expect(keys, hasLength(2));\n361:       expect(keys[0], isNotEmpty);\n362:       expect(keys[1], keys[0]);\n363:     });\n364: \n365:     test('delete reconciles only after authoritative success', () async {\n366:       final HostSession session = openSession();\n367:       await session.join(hostData());\n368:       expect(session.videos.map((v) => v.seedId), <String>[\n369:         'catalog-1',\n370:         'catalog-2',\n371:       ]);\n372:       await session.deleteVideos(const <String>['catalog-1']);\n373:       expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\n374:       mediaInvoker.failure = cloud_functions.FirebaseFunctionsException(\n375:         code: 'permission-denied',\n376:         message: 'denied',\n377:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n378:       );\n379:       await expectLater(\n380:         session.deleteVideos(const <String>['catalog-2']),\n381:         throwsA(isA<ManifestTransportException>()),\n382:       );\n383:       // Failure leaves the list untouched: still retryable.\n384:       expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\n385:     });\n386: \n387:     test('leaving drops late responses from a superseded refresh', () async {\n388:       final List<Completer<Map<String, Object?>>> gates =\n389:           <Completer<Map<String, Object?>>>[\n390:             Completer<Map<String, Object?>>(),\n391:             Completer<Map<String, Object?>>(),\n392:           ];\n393:       int lists = 0;\n394:       final HostSession session = HostSession(\n395:         joinClient: HostJoinClient(invoker: joinInvoker),\n396:         mediaClient: HostMediaClient(\n397:           invoker: _QueuedListInvoker(mediaInvoker, gates, () => lists++),\n398:         ),\n399:       );\n400:       sessions.add(session);\n401:       final Future<void> joining = session.join(hostData());\n402:       await Future<void>.delayed(Duration.zero);\n403:       gates[0].complete(<String, Object?>{\n404:         'videos': <Object?>[FakeHostMediaInvoker.seedJson('a', 'ready')],\n405:       });\n406:       await joining;\n407:       expect(session.state.status, HostSessionStatus.ready);\n408:       expect(session.videos.map((v) => v.seedId), <String>['a']);\n409:       final Future<void> pending = session.refresh();\n410:       await session.leave();\n411:       gates[1].complete(<String, Object?>{'videos': <Object?>[]});\n412:       await pending;\n413:       await Future<void>.delayed(Duration.zero);\n414:       expect(session.state.status, HostSessionStatus.idle);\n415:       expect(session.videos, isEmpty);\n416:       await session.dispose();\n417:     });\n418: \n419:     test('suspend stops polling and resume refreshes', () async {\n420:       final HostSession session = openSession();\n421:       await session.join(hostData());\n422:       final int lists = mediaInvoker.names\n423:           .where((n) => n == kListHostVideos)\n424:           .length;\n425:       await session.suspend();\n426:       expect(session.state.status, HostSessionStatus.stale);\n427:       expect(session.videos, hasLength(2));\n428:       await session.resume();\n429:       expect(\n430:         mediaInvoker.names.where((n) => n == kListHostVideos).length,\n431:         lists + 1,\n432:       );\n433:       expect(session.state.status, HostSessionStatus.ready);\n434:     });\n435:   });\n436: \n437:   group('host entry screen (real parser, fake scanner boundary)', () {\n438:     Future<void> pumpEntry(\n439:       WidgetTester tester, {\n440:       required void Function(GuestJoinData data) onHostJoin,\n441:       JoinPayloadScanner scanner = const UnavailableJoinPayloadScanner(),\n442:     }) async {\n443:       SharedPreferences.setMockInitialValues(<String, Object>{\n444:         DeviceIdentityStore.hostStorageKey: kHostDeviceId,\n445:         DeviceIdentityStore.storageKey: kGuestDeviceId,\n446:       });\n447:       await tester.pumpWidget(\n448:         MaterialApp(\n449:           home: HostEntryScreen(\n450:             onHostJoin: (data) async => onHostJoin(data),\n451:             onJoinAsGuest: () {},\n452:             scanner: scanner,\n453:           ),\n454:         ),\n455:       );\n456:       await tester.pumpAndSettle();\n457:     }\n458: \n459:     testWidgets('boot offers scan, paste, retry, and a guest route', (\n460:       tester,\n461:     ) async {\n462:       GuestJoinData? received;\n463:       await pumpEntry(tester, onHostJoin: (data) => received = data);\n464:       expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n465:       expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\n466:       expect(find.byKey(HostEntryScreen.submitKey), findsOneWidget);\n467:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n468:       expect(received, isNull);\n469:       expect(tester.takeException(), isNull);\n470:     });\n471: \n472:     testWidgets('scan and paste reach the same host payload (parity)', (\n473:       tester,\n474:     ) async {\n475:       GuestJoinData? scanned;\n476:       await pumpEntry(\n477:         tester,\n478:         onHostJoin: (data) => scanned = data,\n479:         scanner: FakeScanner(JoinPayloadText(hostPayload())),\n480:       );\n481:       await tester.tap(find.byKey(HostEntryScreen.scanKey));\n482:       await tester.pumpAndSettle();\n483: \n484:       GuestJoinData? pasted;\n485:       await pumpEntry(tester, onHostJoin: (data) => pasted = data);\n486:       await tester.enterText(\n487:         find.byKey(HostEntryScreen.payloadFieldKey),\n488:         hostPayload(),\n489:       );\n490:       await tester.tap(find.byKey(HostEntryScreen.submitKey));\n491:       await tester.pumpAndSettle();\n492: \n493:       expect(scanned, isNotNull);\n494:       expect(pasted, isNotNull);\n495:       expect(scanned, pasted);\n496:       expect(scanned?.role, JoinRole.host);\n497:       expect(scanned?.inviteToken, kHostToken);\n498:       // The host phone identity is separate from the guest identity.\n499:       expect(scanned?.deviceId.value, kHostDeviceId);\n500:       expect(scanned?.deviceId.value, isNot(kGuestDeviceId));\n501:       expect(tester.takeException(), isNull);\n502:     });\n503: \n504:     testWidgets('guest payloads fail visibly without network', (tester) async {\n505:       var joined = false;\n506:       await pumpEntry(\n507:         tester,\n508:         onHostJoin: (_) => joined = true,\n509:         scanner: FakeScanner(\n510:           const JoinPayloadText('{\"partyId\":\"p\",\"channelId\":\"c\"}'),\n511:         ),\n512:       );\n513:       await tester.tap(find.byKey(HostEntryScreen.scanKey));\n514:       await tester.pumpAndSettle();\n515:       expect(joined, isFalse);\n516:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n517:       expect(find.textContaining('Join as guest'), findsWidgets);\n518:     });\n519: \n520:     testWidgets('unknown roles fail visibly', (tester) async {\n521:       var joined = false;\n522:       await pumpEntry(tester, onHostJoin: (_) => joined = true);\n523:       await tester.enterText(\n524:         find.byKey(HostEntryScreen.payloadFieldKey),\n525:         '{\"partyId\":\"p\",\"channelId\":\"c\",\"role\":\"admin\"}',\n526:       );\n527:       await tester.tap(find.byKey(HostEntryScreen.submitKey));\n528:       await tester.pumpAndSettle();\n529:       expect(joined, isFalse);\n530:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n531:       expect(\n532:         tester.widget<Text>(find.byKey(HostEntryScreen.errorKey)).data,\n533:         contains('unknown role'),\n534:       );\n535:     });\n536: \n537:     testWidgets('legacy guest payloads route to the guest form, not host', (\n538:       tester,\n539:     ) async {\n540:       GuestJoinData? received;\n541:       SharedPreferences.setMockInitialValues(<String, Object>{\n542:         DeviceIdentityStore.storageKey: kGuestDeviceId,\n543:       });\n544:       await tester.pumpWidget(\n545:         MaterialApp(home: JoinScreen(onJoin: (data) async => received = data)),\n546:       );\n547:       await tester.pumpAndSettle();\n548:       await tester.enterText(\n549:         find.byKey(JoinScreen.payloadFieldKey),\n550:         '{\"partyId\":\"legacy\",\"channelId\":\"cctv\"}',\n551:       );\n552:       await tester.tap(find.byKey(JoinScreen.submitKey));\n553:       await tester.pumpAndSettle();\n554:       expect(received?.role, JoinRole.guest);\n555:       expect(received?.partyId.value, 'legacy');\n556:     });\n557:   });\n558: \n559:   group('host panel screen (real session, fake invoker boundary)', () {\n560:     late FakeHostJoinInvoker joinInvoker;\n561:     late FakeHostMediaInvoker mediaInvoker;\n562: \n563:     Future<HostSession> joinedSession() async {\n564:       final HostSession session = HostSession(\n565:         joinClient: HostJoinClient(invoker: joinInvoker),\n566:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n567:       );\n568:       addTearDown(session.dispose);\n569:       await session.join(hostData());\n570:       return session;\n571:     }\n572: \n573:     Future<void> pumpPanel(\n574:       WidgetTester tester,\n575:       HostSession session, {\n576:       void Function(String seedId)? onPreview,\n577:     }) async {\n578:       await tester.pumpWidget(\n579:         MaterialApp(\n580:           home: HostPanelScreen(\n581:             session: session,\n582:             onLeave: () async {},\n583:             onPreview: onPreview ?? (_) {},\n584:           ),\n585:         ),\n586:       );\n587:       await flush(tester);\n588:     }\n589: \n590:     setUp(() {\n591:       joinInvoker = FakeHostJoinInvoker();\n592:       mediaInvoker = FakeHostMediaInvoker();\n593:     });\n594: \n595:     testWidgets('lists empty, queued, ready, failed, and deleted states', (\n596:       tester,\n597:     ) async {\n598:       mediaInvoker.seeds.addAll(<Map<String, Object?>>[\n599:         FakeHostMediaInvoker.seedJson('q', 'queued'),\n600:         FakeHostMediaInvoker.seedJson('r', 'ready'),\n601:         FakeHostMediaInvoker.seedJson('f', 'failed'),\n602:         FakeHostMediaInvoker.seedJson('d', 'deleted'),\n603:       ]);\n604:       final HostSession session = await joinedSession();\n605:       await pumpPanel(tester, session);\n606:       expect(find.textContaining('q · Queued'), findsOneWidget);\n607:       expect(find.textContaining('r · Ready'), findsOneWidget);\n608:       expect(find.textContaining('f · Failed'), findsOneWidget);\n609:       expect(find.textContaining('d · Deleted'), findsOneWidget);\n610:       // Deleted seeds offer no actions; live ones offer view + delete.\n611:       expect(find.byKey(HostPanelScreen.viewKey('d')), findsNothing);\n612:       expect(find.byKey(HostPanelScreen.deleteKey('d')), findsNothing);\n613:       expect(find.byKey(HostPanelScreen.viewKey('r')), findsOneWidget);\n614:       expect(find.byKey(HostPanelScreen.deleteKey('r')), findsOneWidget);\n615:       await session.dispose();\n616:       await flush(tester);\n617:       expect(tester.takeException(), isNull);\n618:     });\n619: \n620:     testWidgets('empty catalog explains itself and generates', (tester) async {\n621:       final HostSession session = await joinedSession();\n622:       await pumpPanel(tester, session);\n623:       expect(find.byKey(HostPanelScreen.emptyKey), findsOneWidget);\n624:       await enterVisible(\n625:         tester,\n626:         find.byKey(HostPanelScreen.generateSeedKey),\n627:         'catalog-new',\n628:       );\n629:       await tapVisible(tester, find.byKey(HostPanelScreen.generateKey));\n630:       await flush(tester);\n631:       expect(find.textContaining('catalog-new · Queued'), findsOneWidget);\n632:       expect(\n633:         mediaInvoker.payloads\n634:             .where((p) => p['seedId'] == 'catalog-new')\n635:             .map((p) => p['presetId']),\n636:         <String>[kCheapDemoPresetId],\n637:       );\n638:       await session.dispose();\n639:       await flush(tester);\n640:     });\n641: \n642:     testWidgets('delete success reconciles; failure stays retryable', (\n643:       tester,\n644:     ) async {\n645:       mediaInvoker.seeds.addAll(<Map<String, Object?>>[\n646:         FakeHostMediaInvoker.seedJson('a', 'ready'),\n647:         FakeHostMediaInvoker.seedJson('b', 'ready'),\n648:       ]);\n649:       final HostSession session = await joinedSession();\n650:       await pumpPanel(tester, session);\n651:       await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('a')));\n652:       await flush(tester);\n653:       expect(find.textContaining('a · Ready'), findsNothing);\n654:       expect(find.textContaining('b · Ready'), findsOneWidget);\n655:       mediaInvoker.failure = cloud_functions.FirebaseFunctionsException(\n656:         code: 'permission-denied',\n657:         message: 'denied',\n658:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n659:       );\n660:       await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('b')));\n661:       await flush(tester);\n662:       expect(find.byKey(HostPanelScreen.messageKey), findsOneWidget);\n663:       expect(find.textContaining('b · Ready'), findsOneWidget);\n664:       await session.dispose();\n665:       await flush(tester);\n666:     });\n667: \n668:     testWidgets('view opens the preview callback per seed', (tester) async {\n669:       mediaInvoker.seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n670:       String? viewed;\n671:       final HostSession session = await joinedSession();\n672:       await pumpPanel(tester, session, onPreview: (seedId) => viewed = seedId);\n673:       await tapVisible(tester, find.byKey(HostPanelScreen.viewKey('v')));\n674:       await flush(tester);\n675:       expect(viewed, 'v');\n676:       await session.dispose();\n677:       await flush(tester);\n678:     });\n679:   });\n680: \n681:   group('host preview screen (real session, fake media boundary)', () {\n682:     testWidgets('obtains a fresh capability and disposes playback resources', (\n683:       tester,\n684:     ) async {\n685:       final FakeHostJoinInvoker joinInvoker = FakeHostJoinInvoker();\n686:       final FakeHostMediaInvoker mediaInvoker = FakeHostMediaInvoker()\n687:         ..seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n688:       final HostSession session = HostSession(\n689:         joinClient: HostJoinClient(invoker: joinInvoker),\n690:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n691:       );\n692:       addTearDown(session.dispose);\n693:       await session.join(hostData());\n694:       final List<FakePreviewPlayer> players = <FakePreviewPlayer>[];\n695: \n696:       await tester.pumpWidget(\n697:         MaterialApp(\n698:           home: HostVideoPreviewScreen(\n699:             session: session,\n700:             seedId: 'v',\n701:             playerFactory: (url) {\n702:               final FakePreviewPlayer player = FakePreviewPlayer(url);\n703:               players.add(player);\n704:               return player;\n705:             },\n706:           ),\n707:         ),\n708:       );\n709:       await flush(tester);\n710:       // Fresh scoped capability per view: exactly one preview call.\n711:       expect(mediaInvoker.previews, 1);\n712:       for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04']) {\n713:         expect(\n714:           find.byKey(HostVideoPreviewScreen.playKey(camera)),\n715:           findsOneWidget,\n716:         );\n717:       }\n718:       // Playing wires the real lifecycle: initialize -> play -> show.\n719:       await tapVisible(\n720:         tester,\n721:         find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n722:       );\n723:       await flush(tester);\n724:       expect(players, hasLength(1));\n725:       expect(players.single.initialized, isTrue);\n726:       expect(players.single.playing, isTrue);\n727:       expect(find.byKey(HostVideoPreviewScreen.videoKey), findsOneWidget);\n728:       // Switching cameras disposes the previous player.\n729:       await tapVisible(\n730:         tester,\n731:         find.byKey(HostVideoPreviewScreen.playKey('CAM-02')),\n732:       );\n733:       await flush(tester);\n734:       expect(players, hasLength(2));\n735:       expect(players.first.disposed, isTrue);\n736:       expect(find.text('Playing'), findsOneWidget);\n737:       // Leaving disposes playback resources without exceptions.\n738:       await session.dispose();\n739:       await tester.pumpWidget(const SizedBox());\n740:       await flush(tester);\n741:       expect(players.last.disposed, isTrue);\n742:       expect(tester.takeException(), isNull);\n743:       expect(mediaInvoker.previews, 1);\n744:     });\n745: \n746:     testWidgets('playback failure surfaces visibly and stays retryable', (\n747:       tester,\n748:     ) async {\n749:       final FakeHostJoinInvoker joinInvoker = FakeHostJoinInvoker();\n750:       final FakeHostMediaInvoker mediaInvoker = FakeHostMediaInvoker()\n751:         ..seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n752:       final HostSession session = HostSession(\n753:         joinClient: HostJoinClient(invoker: joinInvoker),\n754:         mediaClient: HostMediaClient(invoker: mediaInvoker),\n755:       );\n756:       addTearDown(session.dispose);\n757:       await session.join(hostData());\n758: \n759:       await tester.pumpWidget(\n760:         MaterialApp(\n761:           home: HostVideoPreviewScreen(\n762:             session: session,\n763:             seedId: 'v',\n764:             playerFactory: (_) => _FailingPreviewPlayer(),\n765:           ),\n766:         ),\n767:       );\n768:       await flush(tester);\n769:       await tapVisible(\n770:         tester,\n771:         find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n772:       );\n773:       await flush(tester);\n774:       expect(find.byKey(HostVideoPreviewScreen.errorKey), findsOneWidget);\n775:       expect(find.byKey(HostVideoPreviewScreen.videoKey), findsNothing);\n776:       // Retryable: the camera row is still present.\n777:       expect(\n778:         find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n779:         findsOneWidget,\n780:       );\n781:       await session.dispose();\n782:       await tester.pumpWidget(const SizedBox());\n783:       await flush(tester);\n784:       expect(tester.takeException(), isNull);\n785:     });\n786:   });\n787: \n788:   group('companion app host flow (production-path routing)', () {\n789:     late FakeHostJoinInvoker joinInvoker;\n790:     late FakeHostMediaInvoker mediaInvoker;\n791:     late FakeJoinInvoker guestJoinInvoker;\n792:     late FakeManifestInvoker manifestInvoker;\n793: \n794:     Future<void> pumpHostApp(WidgetTester tester) async {\n795:       SharedPreferences.setMockInitialValues(<String, Object>{\n796:         DeviceIdentityStore.storageKey: kGuestDeviceId,\n797:         DeviceIdentityStore.hostStorageKey: kHostDeviceId,\n798:       });\n799:       await tester.pumpWidget(\n800:         CompanionApp(\n801:           config: BackendConfig.parse(<String, Object?>{\n802:             'apiKey': 'test-api-key',\n803:             'appId': '1:123:android:abc',\n804:             'projectId': 'test-project',\n805:           }),\n806:           firebaseBootstrap: (_) async {},\n807:           invokerOverride: manifestInvoker,\n808:           partyJoinInvokerOverride: guestJoinInvoker,\n809:           hostJoinInvokerOverride: joinInvoker,\n810:           hostMediaInvokerOverride: mediaInvoker,\n811:           clock: const SystemClock(),\n812:         ),\n813:       );\n814:       await flush(tester);\n815:     }\n816: \n817:     setUp(() {\n818:       joinInvoker = FakeHostJoinInvoker();\n819:       mediaInvoker = FakeHostMediaInvoker()\n820:         ..seeds.add(FakeHostMediaInvoker.seedJson('catalog-1', 'ready'));\n821:       guestJoinInvoker = FakeJoinInvoker();\n822:       manifestInvoker = FakeManifestInvoker();\n823:     });\n824: \n825:     testWidgets('host invite redeems into the panel only after validation', (\n826:       tester,\n827:     ) async {\n828:       await pumpHostApp(tester);\n829:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n830:       await enterVisible(\n831:         tester,\n832:         find.byKey(HostEntryScreen.payloadFieldKey),\n833:         hostPayload(),\n834:       );\n835:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n836:       await flush(tester);\n837:       // Scope validated -> panel with the server-backed catalog.\n838:       expect(find.byType(HostPanelScreen), findsOneWidget);\n839:       expect(find.textContaining('catalog-1 · Ready'), findsOneWidget);\n840:       expect(guestJoinInvoker.calls, 0);\n841:       expect(tester.takeException(), isNull);\n842:     });\n843: \n844:     testWidgets('host denial fails visibly on the entry screen', (\n845:       tester,\n846:     ) async {\n847:       joinInvoker.failure = cloud_functions.FirebaseFunctionsException(\n848:         code: 'permission-denied',\n849:         message: 'raw detail must never surface',\n850:         details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n851:       );\n852:       await pumpHostApp(tester);\n853:       await enterVisible(\n854:         tester,\n855:         find.byKey(HostEntryScreen.payloadFieldKey),\n856:         hostPayload(),\n857:       );\n858:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n859:       await flush(tester);\n860:       expect(find.byType(HostPanelScreen), findsNothing);\n861:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n862:       expect(find.text('Access was denied.'), findsOneWidget);\n863:       expect(find.textContaining('raw detail'), findsNothing);\n864:     });\n865: \n866:     testWidgets('guest payload on host entry never touches joinHost', (\n867:       tester,\n868:     ) async {\n869:       await pumpHostApp(tester);\n870:       await enterVisible(\n871:         tester,\n872:         find.byKey(HostEntryScreen.payloadFieldKey),\n873:         '{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}',\n874:       );\n875:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n876:       await flush(tester);\n877:       expect(joinInvoker.calls, 0);\n878:       expect(find.byType(HostPanelScreen), findsNothing);\n879:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n880:     });\n881: \n882:     testWidgets('leave returns to the dedicated entry', (tester) async {\n883:       await pumpHostApp(tester);\n884:       await enterVisible(\n885:         tester,\n886:         find.byKey(HostEntryScreen.payloadFieldKey),\n887:         hostPayload(),\n888:       );\n889:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n890:       await flush(tester);\n891:       expect(find.byType(HostPanelScreen), findsOneWidget);\n892:       await tapVisible(tester, find.byKey(HostPanelScreen.leaveKey));\n893:       await flush(tester);\n894:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n895:       expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n896:     });\n897: \n898:     testWidgets('offline boot stays usable without network calls', (\n899:       tester,\n900:     ) async {\n901:       SharedPreferences.setMockInitialValues(<String, Object>{});\n902:       await tester.pumpWidget(const CompanionApp());\n903:       await flush(tester);\n904:       expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n905:       expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n906:       // Submitting a host payload offline fails visibly, with no invoker\n907:       // available and no network attempted.\n908:       await enterVisible(\n909:         tester,\n910:         find.byKey(HostEntryScreen.payloadFieldKey),\n911:         hostPayload(),\n912:       );\n913:       await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n914:       await flush(tester);\n915:       expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n916:       expect(find.byType(HostPanelScreen), findsNothing);\n917:     });\n918:   });\n919: }\n920: \n921: /// Fake platform player: substitutes ONLY the video_player boundary.\n922: final class FakePreviewPlayer implements HostPreviewPlayer {\n923:   FakePreviewPlayer(this.url);\n924:   final Uri url;\n925:   bool initialized = false;\n926:   bool playing = false;\n927:   bool disposed = false;\n928: \n929:   @override\n930:   Future<void> initialize() async {\n931:     initialized = true;\n932:   }\n933: \n934:   @override\n935:   Future<void> play() async {\n936:     playing = true;\n937:   }\n938: \n939:   @override\n940:   Future<void> pause() async {\n941:     playing = false;\n942:   }\n943: \n944:   @override\n945:   Future<void> dispose() async {\n946:     disposed = true;\n947:   }\n948: \n949:   @override\n950:   bool get isInitialized => initialized && !disposed;\n951: \n952:   @override\n953:   double get aspectRatio => 16 / 9;\n954: \n955:   @override\n956:   Widget buildView() => const SizedBox();\n957: }\n958: \n959: /// Player whose platform initialization always fails.\n960: final class _FailingPreviewPlayer implements HostPreviewPlayer {\n961:   @override\n962:   Future<void> initialize() async {\n963:     throw StateError('platform player unavailable');\n964:   }\n965: \n966:   @override\n967:   Future<void> play() async {}\n968: \n969:   @override\n970:   Future<void> pause() async {}\n971: \n972:   @override\n973:   Future<void> dispose() async {}\n974: \n975:   @override\n976:   bool get isInitialized => false;\n977: \n978:   @override\n979:   double get aspectRatio => 16 / 9;\n980: \n981:   @override\n982:   Widget buildView() => const SizedBox();\n983: }\n984: \n985: /// Forwards list calls to queued gates so tests can interleave leave/refresh\n986: /// and prove stale responses are dropped; every other callable delegates.\n987: final class _QueuedListInvoker implements HostMediaCallableInvoker {\n988:   _QueuedListInvoker(this._inner, this._gates, this._onList);\n989:   final FakeHostMediaInvoker _inner;\n990:   final List<Completer<Map<String, Object?>>> _gates;\n991:   final void Function() _onList;\n992:   int _lists = 0;\n993: \n994:   @override\n995:   Future<Object?> call(String name, Map<String, Object?> payload) {\n996:     if (name == kListHostVideos) {\n997:       _onList();\n998:       return _gates[_lists++].future;\n999:     }\n1000:     return _inner.call(name, payload);\n1001:   }\n1002: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3656576d481287e1d3d017388"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/test/host_flow_test.dart\"}"},"time":{"start":1793463641490,"end":1793463642616}}}}
