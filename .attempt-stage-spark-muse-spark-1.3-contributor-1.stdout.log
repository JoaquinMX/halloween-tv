profile,\n530:         manifest: _manifest,\n531:         clock: widget.clock,\n532:         disableEffects: _effectsDisabled,\n533:         glitchSeed: widget.glitchSeed,\n534:       );\n535:     }\n536:     return resolved;\n537:   }\n538: \n539:   void _openRecovery() {\n540:     if (!mounted || _recoveryVisible) {\n541:       return;\n542:     }\n543:     setState(() {\n544:       _recoveryVisible = true;\n545:       _recoveryStatus = null;\n546:     });\n547:     // The wall's focus exclusion hands focus back to the scope; pull it onto\n548:     // the first recovery action so a D-pad lands inside the panel.\n549:     WidgetsBinding.instance.addPostFrameCallback((_) {\n550:       if (mounted && _recoveryVisible) {\n551:         _recoveryFocus.requestFocus();\n552:       }\n553:     });\n554:   }\n555: \n556:   /// Opens the host guest-code page.\n557:   ///\n558:   /// Offline builds never reach here (no GUEST CODES button without a\n559:   /// [GuestCodeClient]). The panel owns its authoritative listing refresh\n560:   /// (immediate fetch plus bounded interval); the wall only shows/hides it.\n561:   void _openGuestCodes() {\n562:     final GuestCodeClient? client = widget.guestCodeClient;\n563:     if (!mounted || _guestCodesVisible || client == null) {\n564:       return;\n565:     }\n566:     setState(() {\n567:       _guestCodesVisible = true;\n568:     });\n569:     WidgetsBinding.instance.addPostFrameCallback((_) {\n570:       if (mounted && _guestCodesVisible) {\n571:         _recoveryFocus.requestFocus();\n572:       }\n573:     });\n574:   }\n575: \n576:   /// Returns from the guest-code page to the recovery actions.\n577:   void _closeGuestCodes() {\n578:     setState(() {\n579:       _guestCodesVisible = false;\n580:     });\n581:     WidgetsBinding.instance.addPostFrameCallback((_) {\n582:       if (mounted && _recoveryVisible) {\n583:         _recoveryFocus.requestFocus();\n584:       }\n585:     });\n586:   }\n587: \n588:   void _closeRecovery() {\n589:     setState(() {\n590:       _recoveryVisible = false;\n591:       _guestCodesVisible = false;\n592:       _recoveryStatus = null;\n593:     });\n594:     // D-pad focus returns to the tile the user was watching. Deferred to a\n595:     // post-frame callback: while the overlay is still mounted this frame,\n596:     // ExcludeFocus(excluding: true) rejects a synchronous requestFocus on\n597:     // the wall tiles, so the request must run after the rebuild flips\n598:     // excluding back to false (same path as _restoreTileFocus).\n599:     _restoreTileFocus();\n600:   }\n601: \n602:   Future<void> _retryCached() async {\n603:     final Future<VerifiedWallPlayback?> Function()? retryPlayback =\n604:         widget.onRetryCachedPlayback;\n605:     if (retryPlayback != null) {\n606:       VerifiedWallPlayback? restored;\n607:       try {\n608:         restored = await retryPlayback();\n609:       } on Object {\n610:         restored = null;\n611:       }\n612:       if (restored != null) {\n613:         try {\n614:           await _activateLiveVersion(\n615:             PlaybackSyncSnapshot(\n616:               state: PlaybackSyncState.ready,\n617:               manifest: restored.manifest,\n618:               mediaByClipId: restored.mediaByClipId,\n619:             ),\n620:           );\n621:         } on Object {\n622:           if (mounted) {\n623:             setState(() {\n624:               _recoveryStatus = 'Cached media could not be activated.';\n625:               _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n626:             });\n627:           }\n628:           return;\n629:         }\n630:         if (!mounted) return;\n631:         setState(() {\n632:           _recoveryVisible = false;\n633:           _recoveryStatus = null;\n634:         });\n635:         _restoreTileFocus();\n636:         return;\n637:       }\n638:     }\n639:     final Future<PlaybackManifest?> Function()? retry = widget.onRetryCached;\n640:     PlaybackManifest? reloaded;\n641:     if (retry != null) {\n642:       try {\n643:         reloaded = await retry();\n644:       } catch (_) {\n645:         reloaded = null;\n646:       }\n647:     }\n648:     if (!mounted) {\n649:       return;\n650:     }\n651:     if (reloaded == null) {\n652:       setState(() {\n653:         _recoveryStatus = 'No cached wall stored yet.';\n654:         _status = 'NO CACHED WALL · KEEPING CURRENT FEED';\n655:       });\n656:       return;\n657:     }\n658:     final PlaybackManifest restored = reloaded;\n659:     try {\n660:       await _applyVerifiedVersion(restored, const <String, CachedMedia>{});\n661:     } on Object {\n662:       if (mounted) {\n663:         setState(() {\n664:           _recoveryStatus = 'Cached wall could not be activated.';\n665:           _status = 'CACHE RESTORE FAILED · KEEPING CURRENT FEED';\n666:         });\n667:       }\n668:       return;\n669:     }\n670:     if (mounted) {\n671:       setState(() {\n672:         _recoveryVisible = false;\n673:         _recoveryStatus = null;\n674:         _status = 'WALL RESTORED · v${restored.version}';\n675:       });\n676:       _restoreTileFocus();\n677:     }\n678:   }\n679: \n680:   void _toggleEffects() {\n681:     final bool value = !_effectsDisabled;\n682:     setState(() {\n683:       _effectsDisabled = value;\n684:       _status = _effectsDisabled ? 'EFFECTS DISABLED' : 'EFFECTS ENABLED';\n685:     });\n686:     final SettingsPort? settings = widget.settings;\n687:     if (settings != null) {\n688:       unawaited(\n689:         settings.setBool(\n690:           partyId: PartyId(widget.partyId),\n691:           key: CctvWallSettingsKeys.effectsDisabled,\n692:           value: value,\n693:         ),\n694:       );\n695:     }\n696:   }\n697: \n698:   void _restoreTileFocus() {\n699:     WidgetsBinding.instance.addPostFrameCallback((_) {\n700:       if (!mounted) {\n701:         return;\n702:       }\n703:       final int index = _focus.focusedIndex;\n704:       _focus.focusTile(index < 0 ? 0 : index);\n705:     });\n706:   }\n707: \n708:   bool _isSelectKey(LogicalKeyboardKey key) =>\n709:       key == LogicalKeyboardKey.select ||\n710:       key == LogicalKeyboardKey.enter ||\n711:       key == LogicalKeyboardKey.gameButtonA ||\n712:       key == LogicalKeyboardKey.space;\n713: \n714:   KeyEventResult _onWallKey(FocusNode node, KeyEvent event) {\n715:     if (event is KeyDownEvent) {\n716:       if (event.logicalKey == LogicalKeyboardKey.contextMenu ||\n717:           event.logicalKey == LogicalKeyboardKey.gameButtonStart) {\n718:         if (widget.recoveryEnabled) {\n719:           _openRecovery();\n720:         }\n721:         return KeyEventResult.handled;\n722:       }\n723:       if (widget.recoveryEnabled && _isSelectKey(event.logicalKey)) {\n724:         if (!_okHeld) {\n725:           _okHeld = true;\n726:           _okHoldTimer?.cancel();\n727:           _okHoldTimer = Timer(widget.longPressDuration, _openRecovery);\n728:         }\n729:         return KeyEventResult.handled;\n730:       }\n731:       if (_focus.handleArrow(event.logicalKey)) {\n732:         return KeyEventResult.handled;\n733:       }\n734:       return KeyEventResult.ignored;\n735:     }\n736:     if (event is KeyUpEvent && _isSelectKey(event.logicalKey)) {\n737:       _okHeld = false;\n738:       _okHoldTimer?.cancel();\n739:       _okHoldTimer = null;\n740:       return KeyEventResult.handled;\n741:     }\n742:     return KeyEventResult.ignored;\n743:   }\n744: \n745:   @override\n746:   Widget build(BuildContext context) {\n747:     final ChannelPlugin channel = _configuredChannel();\n748:     final ChannelContext channelContext = ChannelContext(\n749:       partyId: PartyId(widget.partyId),\n750:       playbackHandle: _handle,\n751:       // Wall config travels through the channel contract so\n752:       // HauntedSurveillancePlugin.build applies it without the host\n753:       // discarding the registry object.\n754:       settings: ChannelSettings(<String, Object?>{\n755:         CctvWallSettingsKeys.effectsDisabled: _effectsDisabled,\n756:         CctvWallSettingsKeys.manifestVersion: _manifest.version,\n757:         CctvWallSettingsKeys.overscanSafe: true,\n758:       }),\n759:     );\n760: \n761:     return FocusTraversalGroup(\n762:       child: Stack(\n763:         fit: StackFit.expand,\n764:         children: <Widget>[\n765:           // Key gate: arrows move tile focus, OK long-press / MENU opens\n766:           // recovery. `canRequestFocus: false` keeps tile 0 the entry point.\n767:           ExcludeFocus(\n768:             excluding: _recoveryVisible,\n769:             child: Focus(\n770:               canRequestFocus: false,\n771:               skipTraversal: true,\n772:               onKeyEvent: _onWallKey,\n773:               child: SafeArea(\n774:                 minimum: widget.overscanPadding,\n775:                 // Stable key: tiles keep cameraId-based keys across retries\n776:                 // and swap feeds in place instead of remounting (which would\n777:                 // transiently double the decoder count).\n[Output truncated. Continue reading with offset: 778]"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192b1f73472dcb3284c8b63d26e37"}},"providerResult":{"executed":false},"rawInput":"{\"limit\":330,\"offset\":448,\"path\":\"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/wall_screen.dart\"}"},"time":{"start":1793462499210,"end":1793462499850}}}}
