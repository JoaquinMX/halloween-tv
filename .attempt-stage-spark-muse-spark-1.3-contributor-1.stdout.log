 cameraId})>[\n444:       for (final CctvSlot slot in cctvSlots)\n445:         if (byCamera[slot.id] case final ClipDescriptor clip)\n446:           tileForClip(clip)\n447:         else\n448:           tileFor(slot.index),\n449:     ];\n450:     if (widget.labelOverrides.isEmpty) {\n451:       return base;\n452:     }\n453:     return <({String label, String cameraId})>[\n454:       for (final ({String label, String cameraId}) slot in base)\n455:         (\n456:           label: widget.labelOverrides[slot.cameraId] ?? slot.label,\n457:           cameraId: slot.cameraId,\n458:         ),\n459:     ];\n460:   }\n461: \n462:   @override\n463:   Widget build(BuildContext context) {\n464:     if (!_ready) {\n465:       return const Center(child: CircularProgressIndicator());\n466:     }\n467:     // 2x2 wall sized by the viewport: Column/Row of Expanded cells fills\n468:     // exactly the incoming constraints (720p through 1080p, including the\n469:     // host's overscan-safe padding) with no scrollable and no overflow.\n470:     // A fixed GridView cross-axis layout cannot guarantee this: without a\n471:     // viewport-derived childAspectRatio the bottom row renders off-screen.\n472:     final List<({String label, String cameraId})> slots = _slots();\n473:     Widget cell(int index) => Expanded(\n474:           child: Padding(\n475:             padding: const EdgeInsets.all(2),\n476:             child: _WallTile(\n477:               index: index,\n478:               label: slots[index].label,\n479:               cameraId: slots[index].cameraId,\n480:               tileBuilder: widget.tileBuilder,\n481:               profile: widget.profile,\n482:               clock: widget.clock,\n483:               disableEffects: widget.disableEffects,\n484:               glitch: _glitch,\n485:               bootFailed: _bootFailed,\n486:             ),\n487:           ),\n488:         );\n489:     return Container(\n490:       color: CctvTheme.gutter,\n491:       padding: const E