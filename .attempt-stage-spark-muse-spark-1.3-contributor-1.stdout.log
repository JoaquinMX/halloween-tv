{"type":"tool_use","timestamp":1793460999758,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b1632001kGFjInD4HORf3l","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929b0ee60016oSh7xFKkIwnhF","type":"tool","id":"call_01a1929b129f71cf89b9cfb2c6226a20","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/contracts.test.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/test/contracts.test.ts, lines 1-131\n1: import assert from \"node:assert/strict\";\n2: import test from \"node:test\";\n3: import { BackendError, parseAck, parseJoinPartyInput, parseRequestGeneration, requireIdentity } from \"../src/contracts\";\n4: import { buildCheapDemoRequest, validateCheapDemoControls, validateGuestImageReference } from \"../src/video_generation_port\";\n5: import { createVideoGenerationProviderFromEnvironment, FakeVideoGenerationPort } from \"../src/providers/fake\";\n6: import { AlibabaVideoGenerationPort } from \"../src/providers/alibaba\";\n7: import { createDeliveryServices } from \"../src/delivery\";\n8: import { createEmulatorContext, clearParty, HAS_FIRESTORE_EMULATOR, randomPartyId, seedParty, disposeEmulatorContext } from \"./support/emulators\";\n9: \n10: function expectCode(work: () => unknown, code: string): void {\n11:   assert.throws(work, (error: unknown) => error instanceof BackendError && error.errorCode === code);\n12: }\n13: \n14: test(\"payload contracts reject missing identity, unsupported models, and noncanonical ACKs\", () => {\n15:   expectCode(() => requireIdentity({}), \"UNAUTHENTICATED\");\n16:   expectCode(() => parseRequestGeneration({\n17:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\", idempotencyKey: \"job-1\", presetId: \"cheap_demo\", modelId: \"other-model\",\n18:   }), \"INVALID_ARGUMENT\");\n19:   expectCode(() => parseRequestGeneration({\n20:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\", idempotencyKey: \"job-1\", presetId: \"premium\",\n21:   }), \"INVALID_ARGUMENT\");\n22:   expectCode(() => parseAck({\n23:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", manifestVersion: 1, clipHashes: { \"CAM-01\": \"0\".repeat(64) },\n24:   }), \"MANIFEST_MISMATCH\");\n25:   const parsed = parseRequestGeneration({\n26:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\", idempotencyKey: \"job-1\", presetId: \"cheap_demo\",\n27:   });\n28:   assert.equal(parsed.presetId, \"cheap_demo\");\n29: });\n30: \n31: test(\"joinParty parser enforces identity, channel, and six-digit PIN shape\", () => {\n32:   expectCode(() => parseJoinPartyInput({}), \"UNAUTHENTICATED\");\n33:   expectCode(() => parseJoinPartyInput({ partyId: \"party\", channelId: \"main\" }), \"UNAUTHENTICATED\");\n34:   expectCode(() => parseJoinPartyInput({ deviceId: \"p-x\", channelId: \"main\" }), \"UNAUTHENTICATED\");\n35:   expectCode(() => parseJoinPartyInput({ partyId: \"party\", deviceId: \"p-x\" }), \"INVALID_ARGUMENT\");\n36:   expectCode(() => parseJoinPartyInput({ partyId: \"party\", deviceId: \"p-x\", channelId: \"\" }), \"INVALID_ARGUMENT\");\n37:   expectCode(() => parseJoinPartyInput({ partyId: \"bad id!\", deviceId: \"p-x\", channelId: \"main\" }), \"INVALID_ARGUMENT\");\n38:   for (const joinPin of [\"123\", \"1234567\", \"abcdef\", \"12 456\", \"\", 4201, null, \"１２３４５６\"]) {\n39:     expectCode(() => parseJoinPartyInput({ partyId: \"party\", deviceId: \"p-x\", channelId: \"main\", joinPin }), \"INVALID_ARGUMENT\");\n40:   }\n41:   const noPin = parseJoinPartyInput({ partyId: \"party\", deviceId: \"p-x\", channelId: \"main\" });\n42:   assert.ok(!(\"joinPin\" in noPin));\n43:   const leadingZeros = parseJoinPartyInput({ partyId: \"party\", deviceId: \"p-x\", channelId: \"main\", joinPin: \"004201\" });\n44:   assert.equal(leadingZeros.joinPin, \"004201\");\n45: });\n46: \n47: test(\"registered callable enforces one in-flight job, idempotency, sanitized errors and zero retries\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n48:   const { app, db, bucket } = await createEmulatorContext();\n49:   const partyId = randomPartyId();\n50:   const deviceId = \"tv-living-room\";\n51:   const channelId = \"main\";\n52:   let enqueued = 0;\n53:   try {\n54:     await seedParty(db, partyId, deviceId, channelId);\n55:     const services = createDeliveryServices({ db, bucket, enqueueGeneration: async () => { enqueued += 1; } });\n56:     const input = { partyId, deviceId, channelId, jobId: \"job-1\", idempotencyKey: \"job-1\", presetId: \"cheap_demo\" };\n57:     const created = await services.requestGeneration(input);\n58:     assert.equal(created.state, \"queued\");\n59:     assert.equal(created.created, true);\n60:     const duplicate = await services.requestGeneration(input);\n61:     assert.equal(duplicate.created, false);\n62:     assert.equal(enqueued, 1);\n63: \n64:     await assert.rejects(\n65:       services.requestGeneration({ ...input, jobId: \"job-2\", idempotencyKey: \"job-2\" }),\n66:       (error: unknown) => error instanceof BackendError && error.errorCode === \"BUDGET_EXCEEDED\",\n67:     );\n68:     await assert.rejects(services.runGeneration({ partyId, deviceId, channelId, jobId: \"job-1\", idempotencyKey: \"job-1\" }),\n69:       (error: unknown) => error instanceof BackendError && error.errorCode === \"PROVIDER_UNAVAILABLE\");\n70:     const job = (await db.doc(`parties/${partyId}/jobs/job-1`).get()).data();\n71:     const cost = (await db.doc(`parties/${partyId}/costLogs/job-1`).get()).data();\n72:     assert.equal(job?.state, \"failed\");\n73:     assert.equal(job?.errorCode, \"PROVIDER_UNAVAILABLE\");\n74:     assert.equal(job?.modelId, \"wan3.0-video\");\n75:     assert.equal(cost?.credits_charged, 0);\n76:     assert.equal(cost?.success, false);\n77:     assert.equal(cost?.partyId, partyId);\n78:   } finally {\n79:     await clearParty(db, bucket, partyId);\n80:     await disposeEmulatorContext(app);\n81:   }\n82: });\n83: \n84: test(\"guest-bound generation contracts keep cheap_demo locked with a validated image reference\", () => {\n85:   const reference = {\n86:     objectPath: \"parties/pilot/guests/p-1/ingest/gsub-1/photo.jpg\",\n87:     sha256: \"a\".repeat(64),\n88:     consentRevision: \"v1:2026-10-30T00:00:00.000Z\",\n89:   };\n90:   const parsed = parseRequestGeneration({\n91:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\",\n92:     idempotencyKey: \"job-1\", presetId: \"cheap_demo\", guestMediaId: \"gsub-1\",\n93:   });\n94:   assert.equal(parsed.guestMediaId, \"gsub-1\");\n95:   expectCode(() => parseRequestGeneration({\n96:     partyId: \"party\", deviceId: \"tv\", channelId: \"main\", jobId: \"job-1\",\n97:     idempotencyKey: \"job-1\", presetId: \"cheap_demo\", guestMediaId: \"\",\n98:   }), \"INVALID_ARGUMENT\");\n99:   const request = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\", reference);\n100:   assert.equal(request.modelId, \"wan3.0-video\");\n101:   assert.equal(request.resolution, \"480P\");\n102:   assert.equal(request.secondsOut, 2);\n103:   assert.equal(request.audio, false);\n104:   assert.equal(request.outputs, 1);\n105:   assert.deepEqual(request.referenceImage, reference);\n106:   const textOnly = buildCheapDemoRequest(\"job-1\", \"idem-1\", \"CAM-01\");\n107:   assert.equal(textOnly.referenceImage, undefined);\n108:   expectCode(() => validateCheapDemoControls({ presetId: \"cheap_demo\", resolution: \"720P\" }), \"INVALID_ARGUMENT\");\n109:   expectCode(() => validateGuestImageReference({ ...reference, objectPath: \"parties/other/photo.jpg\" }), \"INVALID_ARGUMENT\");\n110:   expectCode(() => validateGuestImageReference({ ...reference, sha256: \"zzz\" }), \"INVALID_ARGUMENT\");\n111:   expectCode(() => validateGuestImageReference({ ...reference, consentRevision: \"\" }), \"INVALID_ARGUMENT\");\n112: });\n113: \n114: t