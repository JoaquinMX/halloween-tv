lerFactory: tileControllerFactory,\n42:         clock: clock,\n43:       ),\n44:     );\n45:   }\n46: }\n47: \n48: /// Boots the wall and renders loading / unavailable / wall states.\n49: class WallGate extends StatefulWidget {\n50:   /// Creates the gate.\n51:   const WallGate({\n52:     super.key,\n53:     required this.boot,\n54:     required this.tileControllerFactory,\n55:     required this.clock,\n56:   });\n57: \n58:   /// Boot sequence.\n59:   final WallBoot boot;\n60: \n61:   /// Decoder factory passed through to the wall.\n62:   final TileVideoControllerFactory tileControllerFactory;\n63: \n64:   /// Clock passed through to the wall.\n65:   final Clock clock;\n66: \n67:   @override\n68:   State<WallGate> createState() => _WallGateState();\n69: }\n70: \n71: class _WallGateState extends State<WallGate> {\n72:   late Future<WallBootResult> _bootFuture;\n73: \n74:   @override\n75:   void initState() {\n76:     super.initState();\n77:     _bootFuture = widget.boot.boot();\n78:   }\n79: \n80:   void _retryBoot() {\n81:     setState(() {\n82:       _bootFuture = widget.boot.boot();\n83:     });\n84:   }\n85: \n86:   @override\n87:   Widget build(BuildContext context) {\n88:     return FutureBuilder<WallBootResult>(\n89:       future: _bootFuture,\n90:       builder: (BuildContext context, AsyncSnapshot<WallBootResult> snapshot) {\n91:         if (snapshot.connectionState != ConnectionState.done) {\n92:           return const _WallLoading();\n93:         }\n94:         final WallBootResult? result = snapshot.data;\n95:         if (result == null || !result.isReady) {\n96:           final String reason =\n97:               result?.unavailableReason ??\n98:               snapshot.error?.toString() ??\n99:               'unknown boot failure';\n100:           return _WallUnavailable(reason: reason, onRetry: _retryBoot);\n101:         }\n102:         return WallScreen(\n103:           plugin: result.plugin!,\n104:           manifest: result.manifest!,\n105:           partyId: widget.boot.partyId,\n106:           tvDeviceId: widget.boot.tvDeviceId,\n107:           guestCodeClient: widget.boot.guestCodeClient,\n108:           clock: widget.clock,\n109:           tileControllerFactory: widget.tileControllerFactory,\n110:           onRetryCached: widget.boot.readCached,\n111:           onRetryCachedPlayback: widget.boot.readCommittedPlayback,\n112:           mediaByClipId: result.mediaByClipId,\n113:           liveSession: result.liveSession,\n114:           settings: result.settings,\n115:           initialEffectsDisabled: result.initialEffectsDisabled,\n116:         );\n117:       },\n118:     );\n119:   }\n120: }\n121: \n122: /// Full-screen boot state.\n123: class _WallLoading extends StatelessWidget {\n124:   const _WallLoading();\n125: \n126:   @override\n127:   Widget build(BuildContext context) {\n128:     return const ColoredBox(\n129:       color: CctvTheme.gutter,\n130:       child: Center(\n131:         child: Column(\n132:           mainAxisSize: MainAxisSize.min,\n133:           children: <Widget>[\n134:             Text('TUNING FEED…', style: CctvTheme.labelStyle),\n135:             SizedBox(height: 16),\n136:             SizedBox(\n137:               width: 32,\n138:               height: 32,\n139:               child: CircularProgressIndicator(strokeWidth: 3),\n140:             ),\n141:           ],\n142:         ),\n143:       ),\n144:     );\n145:   }\n146: }\n147: \n148: /// No wall: app-level status + a D-pad reachable retry.\n149: class _WallUnavailable extends StatelessWidget {\n150:   const _WallUnavailable({required this.reason, required this.onRetry});\n151: \n152:   final String reason;\n153:   final VoidCallback onRetry;\n154: \n155:   @override\n156:   Widget build(BuildContext context) {\n157:     return ColoredBox(\n158:       color: CctvTheme.gutter,\n159:       child: SafeArea(\n160:         minimum: const EdgeInsets.all(32),\n161:         child: Center(\n162:           child: ConstrainedBox(\n163:             constraints: const BoxConstraints(maxWidth: 900),\n164:             child: Column(\n165:               mainAxisSize: MainAxisSize.min,\n166:               children: <Widget>[\n167:                 const Text(\n168:                   'NO WALL AVAILABLE',\n169:                   style: CctvTheme.signalLostStyle,\n170:                 ),\n171:                 const SizedBox(height: 12),\n172:                 Text(\n173:                   reason,\n174:                   key: const ValueKey<String>('wall-unavailable-reason'),\n175:                   textAlign: TextAlign.center,\n176:                   style: const TextStyle(color: Colors.white70, fontSize: 20),\n177:                 ),\n178:                 const SizedBox(height: 24),\n179:                 FocusTraversalGroup(\n180:                   child: OutlinedButton(\n181:                     key: const ValueKey<String>('wall-retry'),\n182:                     autofocus: true,\n183:                     onPressed: onRetry,\n184:                     style: OutlinedButton.styleFrom(\n185:                       foregroundColor: Colors.white,\n186:                       side: const BorderSide(\n187:                         color: CctvTheme.frameEdge,\n188:                         width: 2,\n189:                       ),\n190:                       padding: const EdgeInsets.symmetric(\n191:                         horizontal: 28,\n192:                         vertical: 16,\n193:                       ),\n194:                     ),\n195:                     child: const Text('RETRY', style: CctvTheme.badgeStyle),\n196:                   ),\n197:                 ),\n198:               ],\n199:             ),\n200:           ),\n201:         ),\n202:       ),\n203:     );\n204:   }\n205: }\n206: \n207: /// Landscape-only TV orientation. Called once from `main`.\n208: Future<void> lockLandscape() =>\n209:     SystemChrome.setPreferredOrientations(const <DeviceOrientation>[\n210:       DeviceOrientation.landscapeLeft,\n211:       DeviceOrientation.landscapeRight,\n212:     ]);","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/app.dart, lines 1-212\n1: /// Halloween TV app shell: boots the kernel, then hosts the wall.\n2: library;\n3: \n4: import 'package:core_foundation/core_foundation.dart';\n5: import 'package:core_ui/core_ui.dart';\n6: import 'package:flutter/material.dart';\n7: import 'package:flutter/services.dart';\n8: \n9: import 'package:tv_app/src/playback/asset_tile_video_controller.dart';\n10: import 'package:tv_app/src/playback/tile_video_controller.dart';\n11: import 'package:tv_app/src/wall/wall_boot.dart';\n12: import 'package:tv_app/src/wall/wall_screen.dart';\n13: \n14: /// Root widget: dark TV theme, no debug banner, wall as home.\n15: class HalloweenTvApp extends StatelessWidget {\n16:   /// Creates the app.\n17:   const HalloweenTvApp({\n18:     super.key,\n19:     required this.boot,\n20:     this.tileControllerFactory = createTileVideoController,\n21:     this.clock = const SystemClock(),\n22:   });\n23: \n24:   /// Boot sequence producing the wall (or the reason there is none).\n25:   final WallBoot boot;\n26: \n27:   /// Decoder factory for the four tiles.\n28:   final TileVideoControllerFactory tileControllerFactory;\n29: \n30:   /// Clock for HUD timestamps.\n31:   final Clock clock;\n32: \n33:   @override\n34:   Widget build(BuildContext context) {\n35:     return MaterialApp(\n36:       title: 'Halloween TV',\n37:       debugShowCheckedModeBanner: false,\n38:       theme: CctvTheme.dark(),\n39:       home: WallGate(\n40:         boot: boot,\n41:         tileControllerFactory: tileControllerFactory,\n42:         clock: clock,\n43:       ),\n44:     );\n45:   }\n46: }\n47: \n48: /// Boots the wall and renders loading / unavailable / wall states.\n49: class WallGate extends StatefulWidget {\n50:   /// Creates the gate.\n51:   const WallGate({\n52:     super.key,\n53:     required this.boot,\n54:     required this.tileControllerFactory,\n55:     required this.clock,\n56:   });\n57: \n58:   /// Boot sequence.\n59:   final WallBoot boot;\n60: \n61:   /// Decoder factory passed through to the wall.\n62:   final TileVideoControllerFactory tileControllerFactory;\n63: \n64:   /// Clock passed through to the wall.\n65:   final Clock clock;\n66: \n67:   @override\n68:   State<WallGate> createState() => _WallGateState();\n69: }\n70: \n71: class _WallGateState extends State<WallGate> {\n72:   late Future<WallBootResult> _bootFuture;\n73: \n74:   @override\n75:   void initState() {\n76:     super.initState();\n77:     _bootFuture = widget.boot.boot();\n78:   }\n79: \n80:   void _retryBoot() {\n81:     setState(() {\n82:       _bootFuture = widget.boot.boot();\n83:     });\n84:   }\n85: \n86:   @override\n87:   Widget build(BuildContext context) {\n88:     return FutureBuilder<WallBootResult>(\n89:       future: _bootFuture,\n90:       builder: (BuildContext context, AsyncSnapshot<WallBootResult> snapshot) {\n91:         if (snapshot.connectionState != ConnectionState.done) {\n92:           return const _WallLoading();\n93:         }\n94:         final WallBootResult? result = snapshot.data;\n95:         if (result == null || !result.isReady) {\n96:           final String reason =\n97:               result?.unavailableReason ??\n98:               snapshot.error?.toString() ??\n99:               'unknown boot failure';\n100:           return _WallUnavailable(reason: reason, onRetry: _retryBoot);\n101:         }\n102:         return WallScreen(\n103:           plugin: result.plugin!,\n104:           manifest: result.manifest!,\n105:           partyId: widget.boot.partyId,\n106:           tvDeviceId: widget.boot.tvDeviceId,\n107:           guestCodeClient: widget.boot.guestCodeClient,\n108:           clock: widget.clock,\n109:           tileControllerFactory: widget.tileControllerFactory,\n110:           onRetryCached: widget.boot.readCached,\n111:           onRetryCachedPlayback: widget.boot.readCommittedPlayback,\n112:           mediaByClipId: result.mediaByClipId,\n113:           liveSession: result.liveSession,\n114:           settings: result.settings,\n115:           initialEffectsDisabled: result.initialEffectsDisabled,\n116:         );\n117:       },\n118:     );\n119:   }\n120: }\n121: \n122: /// Full-screen boot state.\n123: class _WallLoading extends StatelessWidget {\n124:   const _WallLoading();\n125: \n126:   @override\n127:   Widget build(BuildContext context) {\n128:     return const ColoredBox(\n129:       color: CctvTheme.gutter,\n130:       child: Center(\n131:         child: Column(\n132:           mainAxisSize: MainAxisSize.min,\n133:           children: <Widget>[\n134:             Text('TUNING FEED…', style: CctvTheme.labelStyle),\n135:             SizedBox(height: 16),\n136:             SizedBox(\n137:               width: 32,\n138:               height: 32,\n139:               child: CircularProgressIndicator(strokeWidth: 3),\n140:             ),\n141:           ],\n142:         ),\n143:       ),\n144:     );\n145:   }\n146: }\n147: \n148: /// No wall: app-level status + a D-pad reachable retry.\n149: class _WallUnavailable extends StatelessWidget {\n150:   const _WallUnavailable({required this.reason, required this.onRetry});\n151: \n152:   final String reason;\n153:   final VoidCallback onRetry;\n154: \n155:   @override\n156:   Widget build(BuildContext context) {\n157:     return ColoredBox(\n158:       color: CctvTheme.gutter,\n159:       child: SafeArea(\n160:         minimum: const EdgeInsets.all(32),\n161:         child: Center(\n162:           child: ConstrainedBox(\n163:             constraints: const BoxConstraints(maxWidth: 900),\n164:             child: Column(\n165:               mainAxisSize: MainAxisSize.min,\n166:               children: <Widget>[\n167:                 const Text(\n168:                   'NO WALL AVAILABLE',\n169:     