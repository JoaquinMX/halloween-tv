ry/1/CAM-01.mp4\",\n168:           \"sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n169:           \"sizeBytes\": 12345\n170:         },\n171:         {\n172:           \"cameraId\": \"CAM-02\",\n173:           \"durationMs\": 2000,\n174:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n175:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-02.mp4\",\n176:           \"sha256\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n177:           \"sizeBytes\": 12346\n178:         },\n179:         {\n180:           \"cameraId\": \"CAM-03\",\n181:           \"durationMs\": 2000,\n182:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n183:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-03.mp4\",\n184:           \"sha256\": \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\n185:           \"sizeBytes\": 12347\n186:         },\n187:         {\n188:           \"cameraId\": \"CAM-04\",\n189:           \"durationMs\": 2000,\n190:           \"expiresAt\": \"2026-11-29T15:00:00.000Z\",\n191:           \"objectPath\": \"parties/pilot/channels/main/delivery/1/CAM-04.mp4\",\n192:           \"sha256\": \"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\n193:           \"sizeBytes\": 12348\n194:         }\n195:       ],\n196:       \"createdAt\": \"2026-10-29T14:00:00.000Z\",\n197:       \"expiresAt\": \"2026-11-29T15:00:00.000Z\"\n198:     }\n199:   },\n200:   \"requestGeneration\": {\n201:     \"request\": {\n202:       \"partyId\": \"pilot\",\n203:       \"deviceId\": \"tv-pilot\",\n204:       \"channelId\": \"main\",\n205:       \"jobId\": \"job-1\",\n206:       \"idempotencyKey\": \"job-1\",\n207:       \"presetId\": \"cheap_demo\"\n208:     },\n209:     \"response\": {\n210:       \"jobId\": \"job-1\",\n211:       \"state\": \"queued\",\n212:       \"created\": true\n213:     }\n214:   },\n215:   \"services\": [\n216:     \"requestGeneration\",\n217:     \"runGeneration\",\n218:     \"normalizeAndStage\",\n219:     \"publishManifest\",\n220:     \"getCurrentManifest\",\n221:     \"getDeliveryUrls\",\n222:     \"acknowledgeDelivery\",\n223:     \"sweepExpiredMedia\",\n224:     \"requestGuestUpload\",\n225:     \"completeGuestUpload\",\n226:     \"getGuestMediaStatus\",\n227:     \"withdrawGuestMedia\"\n228:   ],\n229:   \"guestConsent\": {\n230:     \"textVersion\": \"v1\",\n231:     \"purpose\": \"guest_cameo\",\n232:     \"uploadTtlMs\": 900000,\n233:     \"inputTtlMs\": 86400000,\n234:     \"maxImageBytes\": 10485760,\n235:     \"contentTypes\": [\"image/jpeg\", \"image/png\"],\n236:     \"objectPrefix\": \"parties/{partyId}/guests/{deviceId}/ingest/{submissionId}/photo.jpg\",\n237:     \"providerCamera\": \"CAM-01\",\n238:     \"fixtureCameras\": [\"CAM-02\", \"CAM-03\", \"CAM-04\"]\n239:   }\n240: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b0448729a859cb69dadbd49e4"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/test/fixtures/backend_contract_v1.json\"}"},"time":{"start":1793460995631,"end":1793460995652}}}}
{"type":"tool_use","timestamp":1793460995654,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b062e001IM63uUQa5DGSF7","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929aff59001K0ds8YhC3TgI5W","type":"tool","id":"call_01a1929b040c708998fdb17a36d0fa7e","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/docs/backend-contract-v1.md"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/docs/backend-contract-v1.md, lines 1-285\n1: # Backend contract v1 (Halloween TV)\n2: \n3: Source of truth for callable payloads is `backend/functions/src/contracts.ts`;\n4: exported handler composition lives in `backend/functions/src/index.ts` and\n5: `backend/functions/src/runtime.ts`. This document summarizes the wire contract\n6: for the existing TV. Machine-readable request and response examples:\n7: `test/fixtures/backend_contract_v1.json`.\n8: \n9: ## Identity (binding rule)\n10: \n11: Requests are anonymous by default. No Firebase Auth uid, no email, no login\n12: gates on TV or generation interfaces. Every callable takes `partyId` +\n13: `deviceId` (+ `channelId`) and the server accepts them only when they match a\n14: **registered** party/device pair (`parties/{partyId}` with `status: active`,\n15: `parties/{partyId}/devices/{deviceId}` with `status: active` and matching\n16: `partyId`, plus an active channel equal to the party's `activeChannelId`).\n17: Unregistered ids → `FORBIDDEN`. Every job doc, job status and cost-log entry\n18: records `partyId`, `deviceId`/`channelId`, `manifestVersion`, `timestamp` and\n19: an idempotency key.\n20: \n21: ## Services (8)\n22: \n23: | Service | Trigger | Caller |\n24: |---|---|---|\n25: | `requestGeneration` | callable | party/device-scoped |\n26: | `runGeneration` | task queue `runGeneration` | worker only (`maxAttempts: 1`, `maxConcurrentDispatches: 1`) |\n27: | `normalizeAndStage` | internal (worker composition) | never an HTTP endpoint |\n28: | `publishManifest` | internal (worker composition) | never an HTTP endpoint |\n29: | `getCurrentManifest` | callable | party/device-scoped TV |\n30: | `getDeliveryUrls` | callable | party/device-scoped TV |\n31: | `acknowledgeDelivery` | callable | party/device-scoped TV |\n32: | `sweepExpiredMedia` | schedule `every 15 minutes` | runtime |\n33: | `requestGuestUpload` | callable | party/device-scoped guest |\n34: | `completeGuestUpload` | callable | party/device-scoped guest |\n35: | `getGuestMediaStatus` | callable | party/device-scoped guest |\n36: | `withdrawGuestMedia` | callable | party/device-scoped guest |\n37: \n38: Guest ingest objects live under\n39: `parties/{partyId}/guests/{deviceId}/ingest/{submissionId}/photo.jpg` with\n40: server-generated `submissionId` values only; caller-supplied paths and any\n41: cross-party/cross-device/channel substitution are rejected with `FORBIDDEN`.\n42: Firestore guest consent/media docs are callable-only (explicit deny in\n43: `firestore.rules`); Storage guest objects are callable-only (explicit deny in\n44: `storage.rules`, signed URLs bypass rules with backend validation).\n45: \n46: Firestore layout: `parties/{partyId}` (`ownerUid`, `status`, `activeChannelId`),\n47: `channels/{channelId}`, `manifests/current_{channelId}` (`version`,\n48: `cameraClips[4]`, `schemaVersion`, stable publication `createdAt`),\n49: `jobs/{jobId}` (state machine\n50: `queued → running → ready → delivering → purged`, plus `failed`/`expired` with\n51: sanitized `errorCode`, `modelId`, `costEstimate`), `devices/{deviceId}`,\n52: `deliveryAcks/{ackId}`.\n53: \n54: Storage layout: `parties/{partyId}/channels/{channelId}/delivery/{version}/{camera}.mp4`\n55: (served only via short-lived signed URLs minted after callable checks; rules\n56: deny all direct client reads/writes). `ingest/` and `generated/{jobId}/`\n57: prefixes are worker-internal. Lifecycle TTL (`storage.lifecycle.json`,\n58: `daysSinceCustomTime: 1` on `parties/`) is defense-in-depth behind\n59: `sweepExpiredMedia`.\n60: \n61: ## Payloads\n62: \n63: - `requestGeneration { partyId, deviceId, channelId, jobId, idempotencyKey, presetId }`\n64:   — `presetId` must be `\"cheap_demo\"`; any other model/preset field is rejected\n65:   with `INVALID_ARGUMENT`. The callable returns `{ jobId, state, created }`.\n66:   Same `(jobId, idempotencyKey, deviceId, channelId)` returns the existing job\n67:   (`created: false`) without enqueueing another task; reused `jobId` with\n68:   different binding → `FORBIDDEN`.\n69: - `getCurrentManifest { partyId, deviceId, channelId }` → the validated current\n70:   manifest as plain JSON, including four camera-keyed clips and a stable ISO\n71:   `createdAt` publication timestamp. It does not grant direct Firestore access;\n72:   client reads of `manifests/` remain denied by rules.\n73: - `getDeliveryUrls { partyId, deviceId, channelId }` →\n74:   `{ manifestVersion, manifestHash, clips[] }` with v4 signed read URLs capped\n75:   at the clip's own `expiresAt`. Both manifest and URL calls return only the\n76:   current version for the requested active channel. Older delivery versions\n77:   are never signed. Expired manifest/clip → `CLIP_EXPIRED`.\n78: - `acknowledgeDelivery { partyId, deviceId, channelId, manifestVersion, clipHashes }`\n79:   — `clipHashes` is a map keyed by camera ID (`CAM-01` through `CAM-04`) and\n80:   must carry exactly one canonical SHA-256 hash per camera. A first ACK must\n81:   match the unexpired current manifest, else `MANIFEST_MISMATCH` or\n82:   `CLIP_EXPIRED`. The accepted ACK stores the job ID and its four validated\n83:   version-scoped object paths and hashes. Repeats revalidate registration and\n84:   hashes, return the same `ackId`, and retry only those stored paths even after\n85:   expiry or a newer manifest publication. A conflicting hash is rejected;\n86:   objects belonging to a newer version are never purged by an older ACK.\n87: \n88: ## QR join (PIN-gated self-registration)\n89: \n90: Anonymous by default: no Firebase Auth, no names, no emails. The TV renders a\n91: session QR; the companion scans it (or pastes the same JSON) and self-registers\n92: through the `joinParty` callable, which writes the guest device doc with the\n93: Admin SDK. Direct client device writes stay denied by `firestore.rules`.\n94: \n95: - Session QR JSON (TV display, companion parse): an object with EXACTLY these\n96:   keys: `{ \"partyId\": string, \"channelId\": string }` plus OPTIONAL\n97:   `\"joinPin\"`: exactly six ASCII digits as a string (leading zeros significant,\n98:   e.g. `\"004201\"`). NEVER a deviceId, URL, or secret. Extra keys in\n99:   scanned/pasted input are ignored. The `joinPin` is intentionally carried in\n100:   the QR: it is a displayed shared admission value, not a secret, and the TV\n101:   screen is the disclosure boundary (anyone who can see the TV can read it).\n102: - Authorized set: a device admitted through `joinParty` becomes a full\n103:   party-scoped caller — it may read the current manifest, mint delivery URLs,\n104:   request generation, and ACK/purge deliveries. That breadth is the\n105:   owner-accepted consequence of anonymous admission for a co-located party\n106:   (whoever is in the room and reads the TV screen can join). The residual\n107:   risk of an unbounded admitted set is tracked as an open owner question:\n108:   per-party rate limiting/lockout and per-party guest caps/bounded\n109:   listing/operator removal are explicitly deferred pending owner protocol\n110:   decisions, not implemented controls.\n111: - `joinParty { partyId, deviceId, channelId, joinPin? }` →\n112:   `{ partyId, deviceId, channelId, role: \"guest\", status: \"active\", created }`.\n113:   `deviceId` is the phone-generated installation ID (below). `created` is true\n114:   on first registration and false on rejoin; rejoin never rewrites the stored\n115:   doc. The PIN is never echoed in the response.\n116: - `joinParty` failures use `BackendError` codes (same callable `details`\n117:   mapping as above): `FORBIDDEN` (unknown/inactive party, channel\n118:   mismatch/inactive, wrong/missing PIN when configured, deviceId colliding\n119:   with a tv-role or mismatched doc), `UNAUTHENTICATED` (missing\n120:   party/device), `INVALID_ARGUMENT` (malformed ids or PIN shape).\n121: - `listPartyDevices` (TV-only caller, unchanged gate `device.role === \"tv\"`;\n122:   guests get `FORBIDDEN`) response gains OPTIONAL `\"joinPin\"` (string when a\n123:   PIN is configured, absent otherwise). Device entries are\n124:   `{ deviceId, label?, role, status }`; `label` may be absent or empty for\n125:   self-registered guests — readers must fall back to a neutral device-based\n126:   display, never duplicate the id as label+value, never prompt for names.\n127:   Device `label` is reserved for later: omit it on create, tolerate\n128:   absent/empty on read, never require it.\n129: - PIN provisioning: `backend/functions/tools/seed_join.ts` merges `joinPin`\n130:   onto the existing party doc after validating the ACTIVE party, channel\n131:   (`== activeChannelId`), and TV registration. Explicit `--join-pin=NNNNNN`\n132:   (six digits, leading zeros preserved); preview by default, `--apply` for\n133:   writes; repeated identical provisioning is idempotent, omitting `--join-pin`\n134:   leaves an existing PIN untouched. Creates NO guest devices, collects NO\n135:   labels, uploads NO media, calls NO providers. Target guards mirror\n136:   `seed_guests.ts` (`--target=emulator|cloud`, explicit `--project` for cloud,\n137:   operator ADC, no service-account keys). Emulator trigger discovery for the\n138:   `demo-halloween-tv` project is driven by the `.env.demo-halloween-tv` file\n139:   (selects the demo project for local emulator runs; carries no secrets).\n140: - Phone installation-ID lifetime (companion): `\"p-\"` + 32 lowercase hex chars\n141:   from 128 bits of `Random.secure` entropy, persisted under one app-wide\n142:   `SharedPreferences` key and reused across launches, retries, leave, and\n143:   party changes. Corrupt stored values are replaced and re-persisted;\n144:   persistence/entropy failure surfaces retry and never proceeds unpersisted.\n145:   Reinstall/cleared data mints a new installation id and therefore a new\n146:   guest row on next join; the old row remains until operator removal\n147:   (removal tooling is an open owner question, explicitly deferred below).\n148: - Camera deferral (companion): no camera/scanner implementation ships; the\n149:   scan seam returns unavailable, and no camera permission is\n150:   declared/requested. Paste remains available without camera access. Future\n151:   work needs a permission plus validation pass before any scanning ships.\n152: - Migration away from typed guest codes: new parties use QR + PIN\n153:   self-registration. The typed-code path (`tools/guest_codes.ts`,\n154:   `tools/seed_guests.ts`, verbal dictation via `listPartyDevices`) is\n155:   unchanged and stays working — pre-seeded legacy guests (labelled device\n156:   docs) still read the current manifest via `getCurrentManifest` — but the\n157:   updated companion no longer prompts for typed codes.\n158: \n159: ## Guest upload, consent, and withdrawal\n160: \n161: Anonymous registered-device bearer model: no Firebase Auth, no login, no\n162: display name. The same party/device/channel registration gate authorizes every\n163: guest callable.\n164: \n165: - `requestGuestUpload { partyId, deviceId, channelId, consent: { accepted: true, textVersion: \"v1\", purpose: \"guest_cameo\" }, contentType: \"image/jpeg\"|\"image/png\" }`\n166:   records affirmative consent server-side (consent-text version, purpose,\n167:   timestamps, device binding, `pending_upload` status, 15-minute expiry) BEFORE\n168:   issuing a narrowly scoped short-lived signed PUT capability bound to the\n169:   server-generated object path and the content type. The capability is returned\n170:   and never persisted in Firestore or logs.\n171: - `completeGuestUpload { partyId, deviceId, channelId, submissionId }` verifies\n172:   the actual image bytes (JPEG/PNG magic, size within 10 MB), SHA-256, object\n173:   ownership, consent, and expiry before marking the submission `eligible` with\n174:   an immutable source hash/generation and consent revision. Repeats are\n175:   idempotent. Non-image bytes are rejected and never become eligible.\n176: - `getGuestMediaStatus { partyId, deviceId, channelId, submissionId }` returns\n177:   status and consent revision for the owning device only. Signed URLs are never\n178:   included.\n179: - `withdrawGuestMedia { partyId, deviceId, channelId, submissionId }` revokes\n180:   eligibility first (blocking new submissions and publication), deletes the\n181:   source plus attributable remaining cloud derivatives, verifies absence with\n182:   retried deletes, and retains a minimal tombstone. A PUT after withdrawal\n183:   never restores eligibility and is deleted by the `onGuestIngestFinalized`\n184:   cleanup handler. Pending uploads are protected from the orphan sweep;\n185:   abandoned/expired inputs are removed within the capped 24h input TTL.\n186: - `onGuestIngestFinalized` (storage trigger) deletes ingest objects with no\n187:   consent record, a mismatched device binding, or a withdrawn/expired status,\n188:   and leaves pending/eligible objects untouched.\n189: \n190: ## Consent-bound generation\n191: \n192: - `requestGeneration` accepts an optional `guestMediaId` bound to an eligible\n193:   guest submission (same party/device/channel, live consent, unexpired). The\n194:   binding (submission ID, immutable source hash, consent revision) is stored on\n195:   the job and rechecked at request time, at worker submission time, and\n196:   transactionally at publication. Withdrawal fails the bound job closed,\n197:   discards already-running results, and cleans staged bytes.\n198: - Guest execution plan: exactly ONE provider-generated camera slot (`CAM-01`,\n199:   carrying the validated `referenceImage` binding) plus three locally prepared\n200:   fixture slots (`CAM-02`–`CAM-04`). The four-camera manifest contract is kept\n201:   with truthful provenance: fixture slots record `fixture: true` with a null\n202:   provider task ID and null charge; they are never given fabricated provider\n203:   task IDs or charges. The single provider usage row keeps the synthetic zero\n204:   of the offline fake, explicitly not a measured charge.\n205: - Cheap-demo limits are unchanged (`wan3.0-video`, 480p, 2s, silent, 1\n206:   output); text-only behavior is preserved. The Alibaba adapter maps a present\n207:   `referenceImage` to a `reference_image { storage_ref, sha256 }` input via the\n208:   pure offline-tested `buildAlibabaSubmitBody` serializer.\n209: - Provider selection is explicit: a packaged `fixtureDirectory` never silently\n210:   forces fake mode over another configured provider. Fake selection consumes\n211:   the packaged directory; Alibaba selection resolves lazily so discovery and\n212:   local tests never require provider credentials.\n213: \n214: ## Budget guards\n215: \n216: - Max 1 generation in flight per party (`BUDGET_EXCEEDED` otherwise).\n217: - Zero automatic retries on billable calls: the task queue uses\n218:   `maxAttempts: 1` and one concurrent dispatch; each batch needs an explicit owner action\n219:   (`requestGeneration`).\n220: - Generation is disabled unless `GENERATION_ENABLED=true` is explicitly set.\n221:   The runtime uses the same generation-store/provider composition in exported\n222:   handlers and emulator tests. Queue failure marks a still-queued job failed\n223:   and releases its party budget. The fake provider is offline; Alibaba provider\n224:   construction is lazy and is not needed for module discovery or local tests.\n225: - Cost log fields: `model_id, preset_id, seconds_out, seconds_in,\n226:   credits_charged, provider_task_id, created_at, success` plus\n227:   `partyId/deviceId/channelId/manifestVersion/timestamp/idempotencyKey`.\n228: - Preset lock: `cheap_demo` only — `wan3.0-video, singapore, 480P, 2s, 16:9,\n229:   no audio, 1 output, no auto-upscale`. Contracts reject anything else; p4\n230:   enforces provider-side.\n231: \n232: ## Credentials\n233: \n234: Never in the Flutter app, manifest, public Firestore docs, or `.env.example`\n235: (placeholders only). Provider keys live server-side (Cloud Secret Manager /\n236: Functions config). No billable generation call is executed in p1; emulator\n237: seeding uses `backend/functions/tools/seed_pilot.ts` with fixture bytes.\n238: \n239: ## Error codes\n240: \n241: `UNAUTHENTICATED` (missing party/device) · `FORBIDDEN` (unregistered/inactive\n242: party-device-channel or idempotency mismatch) · `MANIFEST_MISMATCH` ·\n243: `CLIP_EXPIRED` · `PROVIDER_UNAVAILABLE` · `BUDGET_EXCEEDED` ·\n244: `INVALID_ARGUMENT` · `NOT_FOUND` · `INTERNAL`.\n245: \n246: Callable failures use Firebase `HttpsError` codes with `details: { errorCode }`.\n247: The detail preserves the backend code above; Firebase codes are respectively\n248: `unauthenticated`, `permission-denied`, `failed-precondition`,\n249: `failed-precondition`, `unavailable`, `resource-exhausted`, `invalid-argument`,\n250: `not-found`, and `internal`.\n251: \n252: ## Local verification and operator switch\n253: \n254: From `backend/functions`, `npm run build` checks the TypeScript deployment\n255: composition. `npm run test:emulator` runs Firestore and Storage emulator tests\n256: serially. These tests use the deterministic fake provider and repository MP4\n257: fixtures; they make no provider network calls. The emulator signing\n258: substitutes (deterministic capability strings) are not equivalent to cloud v4\n259: signed URLs / IAM signing; they only prove per-submission scoping without\n260: persistence. Keep generation disabled during\n261: module discovery and normal local development. A deliberate runtime opt-in is\n262: `GENERATION_ENABLED=true`; selecting the fake provider with\n263: `VIDEO_GENERATION_PROVIDER=fake` remains offline. Deployment and provider\n264: credential setup are outside this contract change.\n265: \n266: ## Tests\n267: \n268: `contracts.test.ts` (payload validation + in-flight/idempotency/error paths),\n269: `backend_contract_fixture.test.ts` (shared JSON fixture through parsing, hashing,\n270: callable service paths, delivery, and ACK), `runtime.test.ts` (disabled default,\n271: queue failure, and fake four-camera generation through handler composition),\n272: `security_rules.test.ts` (party/device-scoped registration reads, denied client\n273: registration writes, denied device listing and party/PIN reads, denied manifest\n274: reads), `seed_join.test.ts` (PIN provisioning preview/apply/idempotency/omit and\n275: refusal paths against the emulator), `qr_join_e2e.test.ts` (PIN-gated join,\n276: rejoin, TV listing, and legacy manifest read through the real exported Functions\n277: emulator endpoints with no auth), `delivery.test.ts` (URL scoping, manifest callable, ACK hash\n278: checks, bounded retry purge), and `retention.test.ts` (TTL transitions, orphan\n279: sweeper). Guest flows are covered by `guest_upload.test.ts` (consent refusal,\n280: completion, scoping, withdrawal, deletion retry, TTL/orphan protection,\n281: generation refusal), `guest_upload_e2e.test.ts` (real-bytes endpoint lifecycle),\n282: `guest_media_generation.test.ts` (one provider camera plus three fixture slots,\n283: truthful usage, withdrawal races), and `alibaba.test.ts` (offline guest-image\n284: serialization fixture, zero network). Emulator-backed cases skip when `FIRESTORE_EMULATOR_HOST` is unset;\n285: run `npm run test:emulator` (project `demo-halloween-tv`) for the full suite.","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/docs/backend-contract-v1.md, lines 1-285\n1: # Backend contract v1 (Halloween TV)\n2: \n3: Source of truth for callable payloads is `backend/functions/src/contracts.ts`;\n4: exported handler composition lives in `backend/functions/src/index.ts` and\n5: `backend/functions/src/runtime.ts`. This document summarizes the wire contract\n6: for the existing TV. Machine-readable request and response examples:\n7: `test/fixtures/backend_contract_v1.json`.\n8: \n9: ## Identity (binding rule)\n10: \n11: Requests are anonymous by default. No Firebase Auth uid, no email, no login\n12: gates on TV or generation interfaces. Every callable takes `partyId` +\n13: `deviceId` (+ `channelId`) and the server accepts them only when they match a\n14: **registered** party/device pair (`parties/{partyId}` with `status: active`,\n15: `parties/{partyId}/devices/{deviceId}` with `status: active` and matching\n16: `partyId`, plus an active channel equal to the party's `activeChannelId`).\n17: Unregistered ids → `FORBIDDEN`. Every job doc, job status and cost-log entry\n18: records `partyId`, `deviceId`/`channelId`, `manifestVersion`, `timestamp` and\n19: an idempotency key.\n20: \n21: ## Services (8)\n22: \n23: | Service | Trigger | Caller |\n24: |---|---|---|\n25: | `requestGeneration` | callable | party/device-scoped |\n26: | `runGeneration` | task queue `runGeneration` | worker only (`maxAttempts: 1`, `maxConcurrentDispatches: 1`) |\n27: | `normalizeAndStage` | internal (worker composition) | never an HTTP endpoint |\n28: | `publishManifest` | internal (worker composition) | never an HTTP endpoint |\n29: | `getCurrentManifest` | callable | party/device-scoped TV |\n30: | `getDeliveryUrls` | callable | party/device-scoped TV |\n31: | `acknowledgeDelivery` | callable | party/device-scoped TV |\n32: | `sweepExpiredMedia` | schedule `every 15 minutes` | runtime |\n33: | `requestGuestUpload` | callable | party/device-scoped guest |\n34: | `completeGuestUpload` | callable | party/device-scoped guest |\n35: | `getGuestMediaStatus` | callable | party/device-scoped guest |\n36: | `withdrawGuestMedia` | callable | party/device-scoped guest |\n37: \n38: Guest ingest objects live under\n39: `parties/{partyId}/guests/{deviceId}/ingest/{submissionId}/photo.jpg` with\n40: server-generated `submissionId` values only; caller-supplied paths and any\n41: cross-party/cross-device/channel substitution are rejected with `FORBIDDEN`.\n42: Firestore guest consent/media docs are callable-only (explicit deny in\n43: `firestore.rules`); Storage guest objects are callable-only (explicit deny in\n44: `storage.rules`, signed URLs bypass rules with backend validation).\n45: \n46: Firestore layout: `parties/{partyId}` (`ownerUid`, `status`, `activeChannelId`),\n47: `channels/{channelId}`, `manifests/current_{channelId}` (`version`,\n48: `cameraClips[4]`, `schemaVersion`, stable publication `createdAt`),\n49: `jobs/{jobId}` (state machine\n50: `queued → running → ready → delivering → purged`, plus `failed`/`expired` with\n51: sanitized `errorCode`, `modelId`, `costEstimate`), `devices/{deviceId}`,\n52: `deliveryAcks/{ackId}`.\n53: \n54: Storage layout: `parties/{partyId}/channels/{channelId}/delivery/{version}/{camera}.mp4`\n55: (served only via short-lived signed URLs minted after callable checks; rules\n56: deny all direct client reads/writes). `ingest/` and `generated/{jobId}/`\n57: prefixes are worker-internal. Lifecycle TTL (`storage.lifecycle.json`,\n58: `daysSinceCustomTime: 1` on `parties/`) is defense-in-depth behind\n59: `sweepExpiredMedia`.\n60: \n61: ## Payloads\n62: \n63: - `requestGeneration { partyId, deviceId, channelId, jobId, idempotencyKey, presetId }`\n64:   — `presetId` must be `\"cheap_demo\"`; any other model/preset field is rejected\n65:   with `INVALID_ARGUMENT`. The callable returns `{ jobId, state, created }`.\n66:   Same `(jobId, idempotencyKey, deviceId, channelId)` returns the existing job\n67:   (`created: false`) without enqueueing another task; reused `jobId` with\n68:   different binding → `FORBIDDEN`.\n69: - `getCurrentManifest { partyId, deviceId, channelId }` → the validated current\n70:   manifest as plain JSON, including four camera-keyed clips and a stable ISO\n71:   `createdAt` publication timestamp. It does not grant direct Firestore access;\n72:   client reads of `manifests/` remain denied by rules.\n73: - `getDeliveryUrls { partyId, deviceId, channelId }` →\n74:   `{ manifestVersion, manifestHash, clips[] }` with v4 signed read URLs capped\n75:   at the clip's own `expiresAt`. Both manifest and URL calls return only the\n76:   current version for the requested active channel. Older delivery versions\n77:   are never signed. Expired manifest/clip → `CLIP_EXPIRED`.\n78: - `acknowledgeDelivery { partyId, deviceId, channelId, manifestVersion, clipHashes }`\n79:   — `clipHashes` is a map keyed by camera ID (`CAM-01` through `CAM-04`) and\n80:   must carry exactly one canonical SHA-256 hash per camera. A first ACK must\n81:   match the unexpired current manifest, else `MANIFEST_MISMATCH` or\n82:   `CLIP_EXPIRED`. The accepted ACK stores the job ID and its four validated\n83:   version-scoped object paths and hashes. Repeats revalidate registration and\n84:   hashes, return the same `ackId`, and retry only those stored paths even after\n85:   expiry or a newer manifest publication. A conflicting hash is rejected;\n86:   objects belonging to a newer version are never purged by an older ACK.\n87: \n88: ## QR join (PIN-gated self-registration)\n89: \n90: Anonymous by default: no Firebase Auth, no names, no emails. The TV renders a\n91: session QR; the companion scans it (or pastes the same JSON) and self-registers\n92: through the `joinParty` callable, which writes the guest device doc with the\n93: Admin SDK. Direct client device writes stay denied by `firestore.rules`.\n94: \n95: - Session QR JSON (TV display, companion parse): an object with EXACTLY these\n96:   keys: `{ \"partyId\": string, \"channelId\": string }` plus OPTIONAL\n97:   `\"joinPin\"`: exactly six ASCII digits as a string (leading zeros significant,\n98:   e.g. `\"004201\"`). NEVER a deviceId, URL, or secret. Extra keys in\n99:   scanned/pasted input are ignored. The `joinPin` is intentionally carried in\n100:   the QR: it is a displayed shared admission value, not a secret, and the TV\n101:   screen is the disclosure boundary (anyone who can see the TV can read it).\n102: - Authorized set: a device admitted through `joinParty` becomes a full\n103:   party-scoped caller — it may read the current manifest, mint delivery URLs,\n104:   request generation, and ACK/purge deliveries. That breadth is the\n105:   owner-accepted consequence of anonymous admission for a co-located party\n106:   (whoever is in the room and reads the TV screen can join). The residual\n107:   risk of an unbounded admitted set is tracked as an open owner question:\n108:   per-party rate limiting/lockout and per-party guest caps/bounded\n109:   listing/operator removal are explicitly deferred pending owner protocol\n110:   decisions, not implemented controls.\n111: - `joinParty { partyId, deviceId, channelId, joinPin? }` →\n112:   `{ partyId, deviceId, channelId, role: \"guest\", status: \"active\", created }`.\n113:   `deviceId` is the phone-generated installation ID (below). `created` is true\n114:   on first registration and false on rejoin; rejoin never rewrites the stored\n115:   doc. The PIN is never echoed in the response.\n116: - `joinParty` failures use `BackendError` codes (same callable `details`\n117:   mapping as above): `FORBIDDEN` (unknown/inactive party, channel\n118:   mismatch/inactive, wrong/missing PIN when configured, deviceId colliding\n119:   with a tv-role or mismatched doc), `UNAUTHENTICATED` (missing\n120:   party/device), `INVALID_ARGUMENT` (malformed ids or PIN shape).\n121: - `listPartyDevices` (TV-only caller, unchanged gate `device.role === \"tv\"`;\n122:   guests get `FORBIDDEN`) response gains OPTIONAL `\"joinPin\"` (string when a\n123:   PIN is configured, absent otherwise). Device entries are\n124:   `{ deviceId, label?, role, status }`; `label` may be absent or empty for\n125:   self-registered guests — readers must fall back to a neutral device-based\n126:   display, never duplicate the id as label+value, never prompt for names.\n127:   Device `label` is reserved for later: omit it on create, tolerate\n128:   absent/empty on read, never require it.\n129: - PIN provisioning: `backend/functions/tools/seed_join.ts` merges `joinPin`\n130:   onto the existing party doc after validating the ACTIVE party, channel\n131:   (`== activeChannelId`), and TV registration. Explicit `--join-pin=NNNNNN`\n132:   (six digits, leading zeros preserved); preview by default, `--apply` for\n133:   writes; repeated identical provisioning is idempotent, omitting `--join-pin`\n134:   leaves an existing PIN untouched. Creates NO guest devices, collects NO\n135:   labels, uploads NO media, calls NO providers. Target guards mirror\n136:   `seed_guests.ts` (`--target=emulator|cloud`, explicit `--project` for cloud,\n137:   operator ADC, no service-account keys). Emulator trigger discovery for the\n138:   `demo-halloween-tv` project is driven by the `.env.demo-halloween-tv` file\n139:   (selects the demo project for local emulator runs; carries no secrets).\n140: - Phone installation-ID lifetime (companion): `\"p-\"` + 32 lowercase hex chars\n141:   from 128 bits of `Random.secure` entropy, persisted under one app-wide\n142:   `SharedPreferences` key and reused across launches, retries, leave, and\n143:   party changes. Corrupt stored values are replaced and re-persisted;\n144:   persistence/entropy failure surfaces retry and never proceeds unpersisted.\n145:   Reinstall/cleared data mints a new installation id and therefore a new\n146:   guest row on next join; the old row remains until operator removal\n147:   (removal tooling is an open owner question, explicitly deferred below).\n148: - Camera deferral (companion): no camera/scanner implementation ships; the\n149:   scan seam returns unavailable, and no camera permission is\n150:   declared/requested. Paste remains available without camera access. Future\n151:   work needs a permission plus validation pass before any scanning ships.\n152: - Migration away from typed guest codes: new parties use QR + PIN\n153:   self-registration. The typed-code path (`tools/guest_codes.ts`,\n154:   `tools/seed_guests.ts`, verbal dictation via `listPartyDevices`) is\n155:   unchanged and stays working — pre-seeded legacy guests (labelled device\n156:   docs) still read the current manifest via `getCurrentManifest` — but the\n157:   updated companion no longer prompts for typed codes.\n158: \n159: ## Guest upload, consent, and withdrawal\n160: \n161: Anonymous registered-device bearer model: no Firebase Auth, no login, no\n162: display name. The same party/device/channel registration gate authorizes every\n163: guest callable.\n164: \n165: - `requestGuestUpload { partyId, deviceId, channelId, consent: { accepted: true, textVersion: \"v1\", purpose: \"guest_cameo\" }, contentType: \"image/jpeg\"|\"image/png\" }`\n166:   records affirmative consent server-side (consent-text version, purpose,\n167:   timestamps, device binding, `pending_upload` status, 15-minute expiry) BEFORE\n168:   issuing a narrowly scoped short-lived signed PUT capability bound to the\n169:   server-generated object path and the content type. The capability is returned\n170:   and never persisted in Firestore or logs.\n171: - `completeGuestUpload { partyId, deviceId, channelId, submissionId }` verifies\n172:   the actual image bytes (JPEG/PNG magic, size within 10 MB), SHA-256, object\n173:   ownership, consent, and expiry before marking the submission `eligible` with\n174:   an immutable source hash/generation and consent revision. Repeats are\n175:   idempotent. Non-image bytes are rejected and never become eligible.\n176: - `getGuestMediaStatus { partyId, deviceId, channelId, submissionId }` returns\n177:   status and consent revision for the owning device only. Signed URLs are never\n178:   included.\n179: - `withdrawGuestMedia { partyId, deviceId, channelId, submissionId }` revokes\n180:   eligibility first (blocking new submissions and publication), deletes the\n181:   source plus attributable remaining cloud derivatives, verifies absence with\n182:   retried deletes, and retains a minimal tombstone. A PUT after withdrawal\n183:   never restores eligibility and is deleted by the `onGuestIngestFinalized`\n184:   cleanup handler. Pending uploads are protected from the orphan sweep;\n185:   abandoned/expired inputs are removed within the capped 24h input TTL.\n186: - `onGuestIngestFinalized` (storage trigger) deletes ingest objects with no\n187:   consent record, a mismatched device binding, or a withdrawn/expired status,\n188:   and leaves pending/eligible objects untouched.\n189: \n190: ## Consent-bound generation\n191: \n192: - `requestGeneration` accepts an optional `guestMediaId` bound to an eligible\n193:   guest submission (same party/device/channel, live consent, unexpired). The\n194:   binding (submission ID, immutable source hash, consent revision) is stored on\n195:   the job and rechecked at request time, at worker submission time, and\n196:   transactionally at publication. Withdrawal fails the bound job closed,\n197:   discards already-running results, and cleans staged bytes.\n198: - Guest execution plan: exactly ONE provider-generated camera slot (`CAM-01`,\n199:   carrying the validated `referenceImage` binding) plus three locally prepared\n200:   fixture slots (`CAM-02`–`CAM-04`). The four-camera manifest contract is kept\n201:   with truthful provenance: fixture slots record `fixture: true` with a null\n202:   provider task ID and null charge; they are never given fabricated provider\n203:   task IDs or charges. The single provider usage row keeps the synthetic zero\n204:   of the offline fake, explicitly not a measured charge.\n205: - Cheap-demo limits are unchanged (`wan3.0-video`, 480p, 2s, silent, 1\n206:   output); text-only behavior is preserved. The Alibaba adapter maps a present\n207:   `referenceImage` to a `reference_image { storage_ref, sha256 }` input via the\n208:   pure offline-tested `buildAlibabaSubmitBody` serializer.\n209: - Provider selection is explicit: a packaged `fixtureDirectory` never silently\n210:   forces fake mode over another configured provider. Fake selection consumes\n211:   the packaged directory; Alibaba selection resolves lazily so discovery and\n212:   local tests never require provider credentials.\n213: \n214: ## Budget guards\n215: \n216: - Max 1 generation in flight per party (`BUDGET_EXCEEDED` otherwise).\n217: - Zero automatic retries on billable calls: the task queue uses\n218:   `maxAttempts: 1` and one concurrent dispatch; each batch needs an explicit owner action\n219:   (`requestGeneration`).\n220: - Generation is disabled unless `GENERATION_ENABLED=true` is explicitly set.\n221:   The runtime uses the same generation-store/provider composition in exported\n222:   handlers and emulator tests. Queue failure marks a still-queued job failed\n223:   and releases its party budget. The fake provider is offline; Alibaba provider\n224:   construction is lazy and is not needed for module discovery or local tests.\n225: - Cost log fields: `model_id, preset_id, seconds_out, seconds_in,\n226:   credits_charged, provider_task_id, created_at, success` plus\n227:   `partyId/deviceId/channelId/manifestVersion/timestamp/idempotencyKey`.\n228: - Preset lock: `cheap_demo` only — `wan3.0-video, singapore, 480P, 2s, 16:9,\n229:   no audio, 1 output, no auto-upscale`. Contracts reject anything else; p4\n230:   enforces provider-side.\n231: \n232: ## Credentials\n233: \n234: Never in the Flutter app, manifest, public Firestore docs, or `.env.example`\n235: (placeholders only). Provider keys live server-side (Cloud Secret Manager /\n236: Functions config). No billable generation call is executed in p1; emulator\n237: seeding uses `backend/functions/tools/seed_pilot.ts` with fixture bytes.\n238: \n239: ## Error codes\n240: \n241: `UNAUTHENTICATED` (missing party/device) · `FORBIDDEN` (unregistered/inactive\n242: party-device-channel or idempotency mismatch) · `MANIFEST_MISMATCH` ·\n243: `CLIP_EXPIRED` · `PROVIDER_UNAVAILABLE` · `BUDGET_EXCEEDED` ·\n244: `INVALID_ARGUMENT` · `NOT_FOUND` · `INTERNAL`.\n245: \n246: Callable failures use Firebase `HttpsError` codes with `details: { errorCode }`.\n247: The detail preserves the backend code above; Firebase codes are respectively\n248: `unauthenticated`, `permission-denied`, `failed-precondition`,\n249: `failed-precondition`, `unavailable`, `resource-exhausted`, `invalid-argument`,\n250: `not-found`, and `internal`.\n251: \n252: ## Local verification and operator switch\n253: \n254: From `backend/functions`, `npm run build` checks the TypeScript deployment\n255: composition. `npm run test:emulator` runs Firestore and Storage emulator tests\n256: serially. These tests use the deterministic fake provider and repository MP4\n257: fixtures; they make no provider network calls. The emulator signing\n258: substitutes (deterministic capability strings) are not equivalent to cloud v4\n259: signed URLs / IAM signing; they only prove per-submission scoping without\n260: persistence. Keep generation disabled during\n261: module discovery and normal local development. A deliberate runtime opt-in is\n262: `GENERATION_ENABLED=true`; selecting the fake provider with\n263: `VIDEO_GENERATION_PROVIDER=fake` remains offline. Deployment and provider\n264: credential setup are outside this contract change.\n265: \n266: ## Tests\n267: \n268: `contracts.test.ts` (payload validation + in-flight/idempotency/error paths),\n269: `backend_contract_fixture.test.ts` (shared JSON fixture through parsing, hashing,\n270: callable service paths, delivery, and ACK), `runtime.test.ts` (disabled default,\n271: queue failure, and fake four-camera generation through handler composition),\n272: `security_rules.test.ts` (party/device-scoped registration reads, denied client\n273: registration writes, denied device listing and party/PIN reads, denied manifest\n274: reads), `seed_join.test.ts` (PIN provisioning preview/apply/idempotency/omit and\n275: refusal paths against the emulator), `qr_join_e2e.test.ts` (PIN-gated join,\n276: rejoin, TV listing, and legacy manifest read through the real exported Functions\n277: emulator endpoints with no auth), `delivery.test.ts` (URL scoping, manifest callable, ACK hash\n278: checks, bounded retry purge), and `retention.test.ts` (TTL transitions, orphan\n279: sweeper). Guest flows are covered by `guest_upload.test.ts` (consent refusal,\n280: completion, scoping, withdrawal, deletion retry, TTL/orphan protection,\n281: generation refusal), `guest_upload_e2e.test.ts` (real-bytes endpoint lifecycle),\n282: `guest_media_generation.test.ts` (one provider camera plus three fixture slots,\n283: truthful usage, withdrawal races), and `alibaba.test.ts` (offline guest-image\n284: serialization fixture, zero network). Emulator-backed cases skip when `FIRESTORE_EMULATOR_HOST` is unset;\n285: run `npm run test:emulator` (project `demo-halloween-tv`) for the full suite."}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b040c708998fdb17a36d0fa7e"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/docs/backend-contract-v1.md\"}"},"time":{"start":1793460995630,"end":1793460995654}}}}
{"type":"tool_use","timestamp":1793460995655,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b062d001kTw6OIo3zRbgix","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929aff59001K0ds8YhC3TgI5W","type":"tool","id":"call_01a1929b03e2760794ee3427b7b0961e","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/publish.ts"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/publish.ts, lines 1-183\n1: import { createHash } from \"node:crypto\";\n2: import { FieldValue } from \"firebase-admin/firestore\";\n3: import { BackendError, CanonicalClip, DeliveryManifest, validateCanonicalClips } from \"./contracts\";\n4: import { GUEST_CONSENT_PURPOSE, GUEST_CONSENT_TEXT_VERSION, GUEST_PROVIDER_CAMERA_ID, SCHEMA_VERSION, REQUIRED_CAMERA_IDS } from \"./config\";\n5: import { FirestoreGenerationStore } from \"./generation_store\";\n6: import { GuestMediaDoc } from \"./guest_media\";\n7: import { usageLedgerPath } from \"./usage\";\n8: \n9: function isClip(value: unknown): value is CanonicalClip {\n10:   return value !== null && typeof value === \"object\" &&\n11:     typeof (value as CanonicalClip).cameraId === \"string\" &&\n12:     typeof (value as CanonicalClip).objectPath === \"string\" &&\n13:     typeof (value as CanonicalClip).sha256 === \"string\" &&\n14:     Number.isSafeInteger((value as CanonicalClip).sizeBytes) &&\n15:     Number.isSafeInteger((value as CanonicalClip).durationMs) &&\n16:     typeof (value as CanonicalClip).expiresAt === \"string\";\n17: }\n18: \n19: export function guestMediaOf(job: FirebaseFirestore.DocumentData): {\n20:   submissionId: string;\n21:   sourceHash: string;\n22:   consentRevision: string;\n23: } | undefined {\n24:   const guest = job.guestMedia as Record<string, unknown> | undefined;\n25:   if (!guest || typeof guest.submissionId !== \"string\" || typeof guest.sourceHash !== \"string\" ||\n26:       typeof guest.consentRevision !== \"string\") return undefined;\n27:   return { submissionId: guest.submissionId, sourceHash: guest.sourceHash, consentRevision: guest.consentRevision };\n28: }\n29: \n30: function assertGuestBinding(\n31:   job: FirebaseFirestore.DocumentData,\n32:   guest: GuestMediaDoc,\n33:   nowMs: number,\n34: ): void {\n35:   const binding = guestMediaOf(job)!;\n36:   // Irreversible withdrawal: a tombstone can never publish again, even if a\n37:   // racing completion wrote eligible around the withdrawal.\n38:   if ((guest as GuestMediaDoc & { tombstone?: unknown }).tombstone === true) {\n39:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn.\");\n40:   }\n41:   if (guest.status !== \"eligible\") throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n42:   if (!guest.consent || guest.consent.accepted !== true ||\n43:       guest.consent.textVersion !== GUEST_CONSENT_TEXT_VERSION ||\n44:       guest.consent.purpose !== GUEST_CONSENT_PURPOSE) {\n45:     throw new BackendError(\"FORBIDDEN\", \"Guest consent is not recorded for publication.\");\n46:   }\n47:   if (guest.sourceHash !== binding.sourceHash || guest.consentRevision !== binding.consentRevision) {\n48:     throw new BackendError(\"FORBIDDEN\", \"Guest media changed while the job was running.\");\n49:   }\n50:   const expiry = guest.expiresAt instanceof Date ? guest.expiresAt.getTime() : Date.parse(String(\n51:     guest.expiresAt && typeof guest.expiresAt === \"object\" && \"toDate\" in guest.expiresAt\n52:       ? (guest.expiresAt as { toDate: () => Date }).toDate().toISOString()\n53:       : guest.expiresAt,\n54:   ));\n55:   if (!Number.isFinite(expiry) || expiry <= nowMs) throw new BackendError(\"FORBIDDEN\", \"Guest consent window has expired.\");\n56: }\n57: \n58: /** Publishes the current manifest in one Firestore transaction after all four objects exist. */\n59: export async function publishManifest(\n60:   store: FirestoreGenerationStore,\n61:   partyId: string,\n62:   jobId: string,\n63:   idempotencyKey: string,\n64: ): Promise<DeliveryManifest> {\n65:   const job = await store.getJob(partyId, jobId);\n66:   if (job.idempotencyKey !== idempotencyKey) throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n67:   if (job.publishedManifest) return job.publishedManifest as DeliveryManifest;\n68:   const guest = guestMediaOf(job);\n69:   if (guest) {\n70:     const snapshot = await store.db.doc(`parties/${partyId}/guestMedia/${guest.submissionId}`).get();\n71:     if (!snapshot.exists) throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n72:     assertGuestBinding(job, snapshot.data() as GuestMediaDoc, Date.now());\n73:   }\n74:   const staged = job.stagedOutputs && typeof job.stagedOutputs === \"object\"\n75:     ? job.stagedOutputs as Record<string, unknown>\n76:     : {};\n77:   const providerTasks = job.providerTasks && typeof job.providerTasks === \"object\"\n78:     ? job.providerTasks as Record<string, { taskId?: unknown }>\n79:     : {};\n80:   const clips: CanonicalClip[] = [];\n81:   for (const cameraId of REQUIRED_CAMERA_IDS) {\n82:     const clip = staged[cameraId];\n83:     if (!isClip(clip) || clip.cameraId !== cameraId) {\n84:       throw new BackendError(\"MANIFEST_MISMATCH\", \"All four normalized camera clips must be staged before publishing.\");\n85:     }\n86:     const expectedPath = store.plannedObjectPath(partyId, String(job.channelId), Number(job.manifestVersion), cameraId);\n87:     if (clip.objectPath !== expectedPath) throw new BackendError(\"MANIFEST_MISMATCH\", \"Staged camera path is outside the delivery prefix.\");\n88:     const [exists] = await store.bucket.file(clip.objectPath).exists();\n89:     if (!exists) throw new BackendError(\"MANIFEST_MISMATCH\", \"A staged camera clip is not present in delivery storage.\");\n90:     const [bytes] = await store.bucket.file(clip.objectPath).download();\n91:     const actualHash = createHash(\"sha256\").update(bytes).digest(\"hex\");\n92:     if (actualHash !== clip.sha256 || bytes.byteLength !== clip.sizeBytes) {\n93:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staged camera content does not match its recorded hash and size.\");\n94:     }\n95:     const taskId = providerTasks[cameraId]?.taskId;\n96:     const isFixtureSlot = guest !== undefined && cameraId !== GUEST_PROVIDER_CAMERA_ID;\n97:     const ledgerInput = {\n98:       partyId,\n99:       deviceId: String(job.deviceId),\n100:       channelId: String(job.channelId),\n101:       manifestVersion: Number(job.manifestVersion),\n102:       idempotencyKey,\n103:       jobId,\n104:       cameraId,\n105:     };\n106:     const ledger = await store.db.doc(usageLedgerPath(ledgerInput)).get();\n107:     if (isFixtureSlot) {\n108:       // Locally prepared fixture slot: truthful provenance, no provider task\n109:       // ID or charge is ever fabricated for these cameras.\n110:       if (!ledger.exists || ledger.data()?.provider_task_id !== null || ledger.data()?.fixture !== true ||\n111:           ledger.data()?.success !== true) {\n112:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Usage ledger is incomplete for a staged fixture clip.\");\n113:       }\n114:       clips.push(clip);\n115:       continue;\n116:     }\n117:     if (typeof taskId !== \"string\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Every staged camera clip needs a persisted provider task ID.\");\n118:     if (!ledger.exists || ledger.data()?.provider_task_id !== taskId || ledger.data()?.success !== true) {\n119:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Usage ledger is incomplete for a staged provider result.\");\n120:     }\n121:     clips.push(clip);\n122:   }\n123:   validateCanonicalClips(clips);\n124:   const sourceVersion = Number(job.sourceManifestVersion);\n125:   const plannedVersion = Number(job.manifestVersion);\n126:   if (!Number.isSafeInteger(sourceVersion) || sourceVersion < 0 || plannedVersion !== sourceVersion + 1) {\n127:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Job manifest version is invalid.\");\n128:   }\n129:   const expiresAt = clips.reduce((earliest, clip) => Date.parse(clip.expiresAt) < Date.parse(earliest) ? clip.expiresAt : earliest, clips[0].expiresAt);\n130:   const manifest: DeliveryManifest = {\n131:     partyId,\n132:     channelId: String(job.channelId),\n133:     version: plannedVersion,\n134:     schemaVersion: SCHEMA_VERSION,\n135:     jobId,\n136:     cameraClips: clips,\n137:     expiresAt,\n138:   };\n139:   const currentRef = store.currentManifestRef(partyId, String(job.channelId));\n140:   const ref = store.jobDocumentRef(partyId, jobId);\n141:   const budgetRef = store.db.doc(`parties/${partyId}/generationBudget/active`);\n142:   return store.db.runTransaction(async (transaction) => {\n143:     const guestRef = guest ? store.db.doc(`parties/${partyId}/guestMedia/${guest.submissionId}`) : undefined;\n144:     const [jobSnapshot, currentSnapshot, budgetSnapshot, guestSnapshot] = await Promise.all([\n145:       transaction.get(ref),\n146:       transaction.get(currentRef),\n147:       transaction.get(budgetRef),\n148:       ...(guestRef ? [transaction.get(guestRef)] : []),\n149:     ]);\n150:     const currentJob = jobSnapshot.data();\n151:     if (!currentJob || currentJob.idempotencyKey !== idempotencyKey) {\n152:       throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n153:     }\n154:     if (currentJob.publishedManifest) return currentJob.publishedManifest as DeliveryManifest;\n155:     if (currentJob.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running job can publish a manifest.\");\n156:     if (guest) {\n157:       // Transactional consent gate: a withdrawal racing the worker fails the\n158:       // publication instead of publishing a revoked cameo.\n159:       if (!guestSnapshot || !guestSnapshot.exists) {\n160:         throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n161:       }\n162:       assertGuestBinding(currentJob, guestSnapshot.data() as GuestMediaDoc, Date.now());\n163:     }\n164:     const currentVersion = currentSnapshot.exists ? Number(currentSnapshot.data()?.version ?? 0) : 0;\n165:     if (currentVersion !== sourceVersion || plannedVersion <= currentVersion) {\n166:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest changed while this job was running.\");\n167:     }\n168:     const published = { ...manifest, createdAt: FieldValue.serverTimestamp() };\n169:     transaction.set(currentRef, published);\n170:     transaction.update(ref, {\n171:       state: \"ready\",\n172:       status: \"ready\",\n173:       publishedManifest: manifest,\n174:       readyAt: FieldValue.serverTimestamp(),\n175:       workerLeaseUntilMs: 0,\n176:       timestamp: FieldValue.serverTimestamp(),\n177:     });\n178:     if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === jobId) {\n179:       transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n180:     }\n181:     return manifest;\n182:   });\n183: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/publish.ts, lines 1-183\n1: import { createHash } from \"node:crypto\";\n2: import { FieldValue } from \"firebase-admin/firestore\";\n3: import { BackendError, CanonicalClip, DeliveryManifest, validateCanonicalClips } from \"./contracts\";\n4: import { GUEST_CONSENT_PURPOSE, GUEST_CONSENT_TEXT_VERSION, GUEST_PROVIDER_CAMERA_ID, SCHEMA_VERSION, REQUIRED_CAMERA_IDS } from \"./config\";\n5: import { FirestoreGenerationStore } from \"./generation_store\";\n6: import { GuestMediaDoc } from \"./guest_media\";\n7: import { usageLedgerPath } from \"./usage\";\n8: \n9: function isClip(value: unknown): value is CanonicalClip {\n10:   return value !== null && typeof value === \"object\" &&\n11:     typeof (value as CanonicalClip).cameraId === \"string\" &&\n12:     typeof (value as CanonicalClip).objectPath === \"string\" &&\n13:     typeof (value as CanonicalClip).sha256 === \"string\" &&\n14:     Number.isSafeInteger((value as CanonicalClip).sizeBytes) &&\n15:     Number.isSafeInteger((value as CanonicalClip).durationMs) &&\n16:     typeof (value as CanonicalClip).expiresAt === \"string\";\n17: }\n18: \n19: export function guestMediaOf(job: FirebaseFirestore.DocumentData): {\n20:   submissionId: string;\n21:   sourceHash: string;\n22:   consentRevision: string;\n23: } | undefined {\n24:   const guest = job.guestMedia as Record<string, unknown> | undefined;\n25:   if (!guest || typeof guest.submissionId !== \"string\" || typeof guest.sourceHash !== \"string\" ||\n26:       typeof guest.consentRevision !== \"string\") return undefined;\n27:   return { submissionId: guest.submissionId, sourceHash: guest.sourceHash, consentRevision: guest.consentRevision };\n28: }\n29: \n30: function assertGuestBinding(\n31:   job: FirebaseFirestore.DocumentData,\n32:   guest: GuestMediaDoc,\n33:   nowMs: number,\n34: ): void {\n35:   const binding = guestMediaOf(job)!;\n36:   // Irreversible withdrawal: a tombstone can never publish again, even if a\n37:   // racing completion wrote eligible around the withdrawal.\n38:   if ((guest as GuestMediaDoc & { tombstone?: unknown }).tombstone === true) {\n39:     throw new BackendError(\"FORBIDDEN\", \"Guest consent was withdrawn.\");\n40:   }\n41:   if (guest.status !== \"eligible\") throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n42:   if (!guest.consent || guest.consent.accepted !== true ||\n43:       guest.consent.textVersion !== GUEST_CONSENT_TEXT_VERSION ||\n44:       guest.consent.purpose !== GUEST_CONSENT_PURPOSE) {\n45:     throw new BackendError(\"FORBIDDEN\", \"Guest consent is not recorded for publication.\");\n46:   }\n47:   if (guest.sourceHash !== binding.sourceHash || guest.consentRevision !== binding.consentRevision) {\n48:     throw new BackendError(\"FORBIDDEN\", \"Guest media changed while the job was running.\");\n49:   }\n50:   const expiry = guest.expiresAt instanceof Date ? guest.expiresAt.getTime() : Date.parse(String(\n51:     guest.expiresAt && typeof guest.expiresAt === \"object\" && \"toDate\" in guest.expiresAt\n52:       ? (guest.expiresAt as { toDate: () => Date }).toDate().toISOString()\n53:       : guest.expiresAt,\n54:   ));\n55:   if (!Number.isFinite(expiry) || expiry <= nowMs) throw new BackendError(\"FORBIDDEN\", \"Guest consent window has expired.\");\n56: }\n57: \n58: /** Publishes the current manifest in one Firestore transaction after all four objects exist. */\n59: export async function publishManifest(\n60:   store: FirestoreGenerationStore,\n61:   partyId: string,\n62:   jobId: string,\n63:   idempotencyKey: string,\n64: ): Promise<DeliveryManifest> {\n65:   const job = await store.getJob(partyId, jobId);\n66:   if (job.idempotencyKey !== idempotencyKey) throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n67:   if (job.publishedManifest) return job.publishedManifest as DeliveryManifest;\n68:   const guest = guestMediaOf(job);\n69:   if (guest) {\n70:     const snapshot = await store.db.doc(`parties/${partyId}/guestMedia/${guest.submissionId}`).get();\n71:     if (!snapshot.exists) throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n72:     assertGuestBinding(job, snapshot.data() as GuestMediaDoc, Date.now());\n73:   }\n74:   const staged = job.stagedOutputs && typeof job.stagedOutputs === \"object\"\n75:     ? job.stagedOutputs as Record<string, unknown>\n76:     : {};\n77:   const providerTasks = job.providerTasks && typeof job.providerTasks === \"object\"\n78:     ? job.providerTasks as Record<string, { taskId?: unknown }>\n79:     : {};\n80:   const clips: CanonicalClip[] = [];\n81:   for (const cameraId of REQUIRED_CAMERA_IDS) {\n82:     const clip = staged[cameraId];\n83:     if (!isClip(clip) || clip.cameraId !== cameraId) {\n84:       throw new BackendError(\"MANIFEST_MISMATCH\", \"All four normalized camera clips must be staged before publishing.\");\n85:     }\n86:     const expectedPath = store.plannedObjectPath(partyId, String(job.channelId), Number(job.manifestVersion), cameraId);\n87:     if (clip.objectPath !== expectedPath) throw new BackendError(\"MANIFEST_MISMATCH\", \"Staged camera path is outside the delivery prefix.\");\n88:     const [exists] = await store.bucket.file(clip.objectPath).exists();\n89:     if (!exists) throw new BackendError(\"MANIFEST_MISMATCH\", \"A staged camera clip is not present in delivery storage.\");\n90:     const [bytes] = await store.bucket.file(clip.objectPath).download();\n91:     const actualHash = createHash(\"sha256\").update(bytes).digest(\"hex\");\n92:     if (actualHash !== clip.sha256 || bytes.byteLength !== clip.sizeBytes) {\n93:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staged camera content does not match its recorded hash and size.\");\n94:     }\n95:     const taskId = providerTasks[cameraId]?.taskId;\n96:     const isFixtureSlot = guest !== undefined && cameraId !== GUEST_PROVIDER_CAMERA_ID;\n97:     const ledgerInput = {\n98:       partyId,\n99:       deviceId: String(job.deviceId),\n100:       channelId: String(job.channelId),\n101:       manifestVersion: Number(job.manifestVersion),\n102:       idempotencyKey,\n103:       jobId,\n104:       cameraId,\n105:     };\n106:     const ledger = await store.db.doc(usageLedgerPath(ledgerInput)).get();\n107:     if (isFixtureSlot) {\n108:       // Locally prepared fixture slot: truthful provenance, no provider task\n109:       // ID or charge is ever fabricated for these cameras.\n110:       if (!ledger.exists || ledger.data()?.provider_task_id !== null || ledger.data()?.fixture !== true ||\n111:           ledger.data()?.success !== true) {\n112:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Usage ledger is incomplete for a staged fixture clip.\");\n113:       }\n114:       clips.push(clip);\n115:       continue;\n116:     }\n117:     if (typeof taskId !== \"string\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Every staged camera clip needs a persisted provider task ID.\");\n118:     if (!ledger.exists || ledger.data()?.provider_task_id !== taskId || ledger.data()?.success !== true) {\n119:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Usage ledger is incomplete for a staged provider result.\");\n120:     }\n121:     clips.push(clip);\n122:   }\n123:   validateCanonicalClips(clips);\n124:   const sourceVersion = Number(job.sourceManifestVersion);\n125:   const plannedVersion = Number(job.manifestVersion);\n126:   if (!Number.isSafeInteger(sourceVersion) || sourceVersion < 0 || plannedVersion !== sourceVersion + 1) {\n127:     throw new BackendError(\"MANIFEST_MISMATCH\", \"Job manifest version is invalid.\");\n128:   }\n129:   const expiresAt = clips.reduce((earliest, clip) => Date.parse(clip.expiresAt) < Date.parse(earliest) ? clip.expiresAt : earliest, clips[0].expiresAt);\n130:   const manifest: DeliveryManifest = {\n131:     partyId,\n132:     channelId: String(job.channelId),\n133:     version: plannedVersion,\n134:     schemaVersion: SCHEMA_VERSION,\n135:     jobId,\n136:     cameraClips: clips,\n137:     expiresAt,\n138:   };\n139:   const currentRef = store.currentManifestRef(partyId, String(job.channelId));\n140:   const ref = store.jobDocumentRef(partyId, jobId);\n141:   const budgetRef = store.db.doc(`parties/${partyId}/generationBudget/active`);\n142:   return store.db.runTransaction(async (transaction) => {\n143:     const guestRef = guest ? store.db.doc(`parties/${partyId}/guestMedia/${guest.submissionId}`) : undefined;\n144:     const [jobSnapshot, currentSnapshot, budgetSnapshot, guestSnapshot] = await Promise.all([\n145:       transaction.get(ref),\n146:       transaction.get(currentRef),\n147:       transaction.get(budgetRef),\n148:       ...(guestRef ? [transaction.get(guestRef)] : []),\n149:     ]);\n150:     const currentJob = jobSnapshot.data();\n151:     if (!currentJob || currentJob.idempotencyKey !== idempotencyKey) {\n152:       throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n153:     }\n154:     if (currentJob.publishedManifest) return currentJob.publishedManifest as DeliveryManifest;\n155:     if (currentJob.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running job can publish a manifest.\");\n156:     if (guest) {\n157:       // Transactional consent gate: a withdrawal racing the worker fails the\n158:       // publication instead of publishing a revoked cameo.\n159:       if (!guestSnapshot || !guestSnapshot.exists) {\n160:         throw new BackendError(\"FORBIDDEN\", \"Guest consent is no longer eligible for publication.\");\n161:       }\n162:       assertGuestBinding(currentJob, guestSnapshot.data() as GuestMediaDoc, Date.now());\n163:     }\n164:     const currentVersion = currentSnapshot.exists ? Number(currentSnapshot.data()?.version ?? 0) : 0;\n165:     if (currentVersion !== sourceVersion || plannedVersion <= currentVersion) {\n166:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest changed while this job was running.\");\n167:     }\n168:     const published = { ...manifest, createdAt: FieldValue.serverTimestamp() };\n169:     transaction.set(currentRef, published);\n170:     transaction.update(ref, {\n171:       state: \"ready\",\n172:       status: \"ready\",\n173:       publishedManifest: manifest,\n174:       readyAt: FieldValue.serverTimestamp(),\n175:       workerLeaseUntilMs: 0,\n176:       timestamp: FieldValue.serverTimestamp(),\n177:     });\n178:     if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === jobId) {\n179:       transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n180:     }\n181:     return manifest;\n182:   });\n183: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b03e2760794ee3427b7b0961e"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/publish.ts\"}"},"time":{"start":1793460995629,"end":1793460995655}}}}
{"type":"tool_use","timestamp":1793460995656,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b0630001fmnIdf80p0e7T4","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929aff59001K0ds8YhC3TgI5W","type":"tool","id":"call_01a1929b0484776ea1202e0a01a67422","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/packages/infra_signed_urls/lib/src/firebase_delivery_client.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/infra_signed_urls/lib/src/firebase_delivery_client.dart, lines 1-278\n1: /// Firebase callable adapter for short-lived media delivery and ACKs.\n2: library;\n3: \n4: import 'package:cloud_functions/cloud_functions.dart';\n5: import 'package:core_cache/core_cache.dart';\n6: import 'package:core_playlist/core_playlist.dart';\n7: import 'package:infra_firestore/infra_firestore.dart';\n8: \n9: import 'package:infra_signed_urls/src/url_signer.dart';\n10: \n11: final RegExp _sha256 = RegExp(r'^[0-9a-fA-F]{64}$');\n12: \n13: /// Injectable callable boundary for deterministic tests and callable emulator\n14: /// wiring. Production uses the Firebase Functions SDK adapter by default.\n15: abstract interface class FirebaseCallableInvoker {\n16:   Future<Object?> call(String name, Map<String, Object?> payload);\n17: }\n18: \n19: final class _SdkFirebaseCallableInvoker implements FirebaseCallableInvoker {\n20:   _SdkFirebaseCallableInvoker(this._functions);\n21: \n22:   final FirebaseFunctions _functions;\n23: \n24:   @override\n25:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n26:     final HttpsCallableResult<Object?> result = await _functions\n27:         .httpsCallable(name)\n28:         .call<Object?>(payload);\n29:     return result.data;\n30:   }\n31: }\n32: \n33: /// One object-specific signed delivery URL and its server-enforced expiry.\n34: final class FirebaseDeliveryClipUrl {\n35:   FirebaseDeliveryClipUrl({\n36:     required this.cameraId,\n37:     required this.sha256,\n38:     required this.url,\n39:     required this.expiresAt,\n40:   }) {\n41:     if (!_sha256.hasMatch(sha256)) {\n42:       throw const FormatException('delivery clip sha256 must be 64 hex chars');\n43:     }\n44:     if (url.scheme != 'https' || url.host.isEmpty || url.userInfo.isNotEmpty) {\n45:       throw const FormatException('delivery URL must be an HTTPS URL');\n46:     }\n47:     if (slotForCameraId(cameraId) == null) {\n48:       throw FormatException('unknown delivery cameraId: $cameraId');\n49:     }\n50:   }\n51: \n52:   final String cameraId;\n53:   final String sha256;\n54:   final Uri url;\n55:   final DateTime expiresAt;\n56: }\n57: \n58: /// Validated result from the `getDeliveryUrls` callable.\n59: ///\n60: /// `manifestVersion` and `manifestHash` are validated as response fields, but\n61: /// URL reuse is intentionally keyed only by cameraId plus SHA-256. The TV does\n62: /// not request a particular manifest from this callable, so those fields are\n63: /// not compared to a requested manifest.\n64: final class FirebaseDeliveryUrls {\n65:   FirebaseDeliveryUrls({\n66:     required this.manifestVersion,\n67:     required this.manifestHash,\n68:     required List<FirebaseDeliveryClipUrl> clips,\n69:   }) : clips = List<FirebaseDeliveryClipUrl>.unmodifiable(clips) {\n70:     if (manifestVersion <= 0 || !_sha256.hasMatch(manifestHash)) {\n71:       throw const FormatException(\n72:         'delivery response has invalid manifest data',\n73:       );\n74:     }\n75:     final Set<String> cameras = this.clips.map((clip) => clip.cameraId).toSet();\n76:     if (cameras.length != this.clips.length ||\n77:         cameras.length != cctvSlots.length ||\n78:         !cameras.containsAll(cctvSlots.map((slot) => slot.id))) {\n79:       throw const FormatException(\n80:         'delivery response must contain one URL per canonical camera',\n81:       );\n82:     }\n83:   }\n84: \n85:   final int manifestVersion;\n86:   final String manifestHash;\n87:   final List<FirebaseDeliveryClipUrl> clips;\n88: }\n89: \n90: /// Party/device-scoped callable client. Firebase callable auth tokens are\n91: /// attached by the SDK when available; an anonymous TV needs no login and the\n92: /// server validates every supplied party/device registration.\n93: final class FirebaseDeliveryClient implements DeliveryAcknowledger {\n94:   FirebaseDeliveryClient({\n95:     required FirebaseTvIdentity identity,\n96:     FirebaseFunctions? functions,\n97:     FirebaseCallableInvoker? callableInvoker,\n98:     DateTime Function()? now,\n99:   }) : _identity = identity,\n100:        _functions = functions,\n101:        _callableInvoker = callableInvoker,\n102:        _now = now ?? DateTime.now {\n103:     if (functions != null && callableInvoker != null) {\n104:       throw ArgumentError(\n105:         'provide either functions or callableInvoker, not both',\n106:       );\n107:     }\n108:   }\n109: \n110:   final FirebaseTvIdentity _identity;\n111:   final FirebaseFunctions? _functions;\n112:   final FirebaseCallableInvoker? _callableInvoker;\n113:   final DateTime Function() _now;\n114: \n115:   Future<Object?> _call(String name, Map<String, Object?> payload) {\n116:     final FirebaseCallableInvoker invoker =\n117:         _callableInvoker ??\n118:         _SdkFirebaseCallableInvoker(_functions ?? FirebaseFunctions.instance);\n119:     return invoker.call(name, payload);\n120:   }\n121: \n122:   /// Fetches the server's short-lived signed URL for each current object.\n123:   /// A subsequent call can refresh URLs without changing manifest version.\n124:   Future<FirebaseDeliveryUrls> getDeliveryUrls({\n125:     required String channelId,\n126:   }) async {\n127:     final Object? raw = await _call(\n128:       'getDeliveryUrls',\n129:       _identity.callablePayload(channelId: channelId),\n130:     );\n131:     if (raw is! Map) {\n132:       throw const FormatException('getDeliveryUrls response must be an object');\n133:     }\n134:     final Object? rawVersion = raw['manifestVersion'];\n135:     final Object? rawHash = raw['manifestHash'];\n136:     final Object? rawClips = raw['clips'];\n137:     if (rawVersion is! num ||\n138:         rawVersion.toInt() != rawVersion ||\n139:         rawHash is! String ||\n140:         rawClips is! List) {\n141:       throw const FormatException('getDeliveryUrls response is incomplete');\n142:     }\n143:     final List<FirebaseDeliveryClipUrl> clips = <FirebaseDeliveryClipUrl>[];\n144:     for (final Object? value in rawClips) {\n145:       if (value is! Map ||\n146:           value['cameraId'] is! String ||\n147:           value['sha256'] is! String ||\n148:           value['url'] is! String ||\n149:           value['expiresAt'] is! String) {\n150:         throw const FormatException('getDeliveryUrls clip entry is invalid');\n151:       }\n152:       final DateTime expiresAt;\n153:       try {\n154:         expiresAt = DateTime.parse(value['expiresAt']! as String).toUtc();\n155:       } on FormatException {\n156:         throw const FormatException('delivery URL expiresAt is invalid');\n157:       }\n158:       if (!expiresAt.isAfter(_now().toUtc())) {\n159:         throw const FormatException('delivery URL is already expired');\n160:       }\n161:       clips.add(\n162:         FirebaseDeliveryClipUrl(\n163:           cameraId: value['cameraId']! as String,\n164:           sha256: value['sha256']! as String,\n165:           url: Uri.parse(value['url']! as String),\n166:           expiresAt: expiresAt,\n167:         ),\n168:       );\n169:     }\n170:     return FirebaseDeliveryUrls(\n171:       manifestVersion: rawVersion.toInt(),\n172:       manifestHash: rawHash,\n173:       clips: clips,\n174:     );\n175:   }\n176: \n177:   /// Gets a fresh URL for this exact camera content. Hash matching makes a\n178:   /// concurrent manifest update safe: another clip cannot be substituted.\n179:   /// This does not compare the returned manifestVersion or manifestHash with\n180:   /// the prepared manifest; the server response has no requested-version\n181:   /// binding. The caller still ACKs only its prepared version.\n182:   Future<Uri> refreshUrlFor({\n183:     required String channelId,\n184:     required ClipDescriptor clip,\n185:   }) async {\n186:     final FirebaseDeliveryUrls response = await getDeliveryUrls(\n187:       channelId: channelId,\n188:     );\n189:     for (final FirebaseDeliveryClipUrl item in response.clips) {\n190:       if (item.cameraId == clip.cameraId &&\n191:           item.sha256.toLowerCase() == clip.sha256.toLowerCase()) {\n192:         return item.url;\n193:       }\n194:     }\n195:     throw StateError(\n196:       'current manifest no longer contains ${clip.cameraId} with the '\n197:       'requested sha256',\n198:     );\n199:   }\n200: \n201:   @override\n202:   Future<void> acknowledge({\n203:     required String partyId,\n204:     required String channelId,\n205:     required int manifestVersion,\n206:     required Map<String, String> verifiedClipHashes,\n207:   }) async {\n208:     if (partyId != _identity.partyId) {\n209:       throw ArgumentError.value(partyId, 'partyId', 'does not match identity');\n210:     }\n211:     final Set<String> canonicalCameras = cctvSlots\n212:         .map((CctvSlot slot) => slot.id)\n213:         .toSet();\n214:     if (manifestVersion <= 0 ||\n215:         verifiedClipHashes.length != cctvSlots.length ||\n216:         !verifiedClipHashes.keys.toSet().containsAll(canonicalCameras)) {\n217:       throw ArgumentError(\n218:         'ACK requires a positive version and one hash for each canonical camera',\n219:       );\n220:     }\n221:     final Map<String, String> hashes = <String, String>{};\n222:     for (final String cameraId in canonicalCameras) {\n223:       final String hash = verifiedClipHashes[cameraId]!.toLowerCase();\n224:       if (!_sha256.hasMatch(hash)) {\n225:         throw ArgumentError.value(hash, 'verifiedClipHashes[$cameraId]');\n226:       }\n227:       hashes[cameraId] = hash;\n228:     }\n229:     final Object? raw = await _call('acknowledgeDelivery', <String, Object?>{\n230:       ..._identity.callablePayload(channelId: channelId),\n231:       'manifestVersion': manifestVersion,\n232:       'clipHashes': hashes,\n233:     });\n234:     if (raw is! Map) {\n235:       throw const FormatException(\n236:         'acknowledgeDelivery response must be an object',\n237:       );\n238:     }\n239:     final Object? ackId = raw['ackId'];\n240:     final Object? responseVersion = raw['manifestVersion'];\n241:     final Object? purged = raw['purged'];\n242:     if (ackId is! String || ackId.trim().isEmpty) {\n243:       throw const FormatException('acknowledgeDelivery ackId is invalid');\n244:     }\n245:     if (responseVersion is! num ||\n246:         responseVersion.toInt() != responseVersion ||\n247:         responseVersion.toInt() != manifestVersion) {\n248:       throw const FormatException(\n249:         'acknowledgeDelivery manifestVersion does not match request',\n250:       );\n251:     }\n252:     if (purged is! bool || !purged) {\n253:       throw const FormatException('acknowledgeDelivery purged is invalid');\n254:     }\n255:   }\n256: }\n257: \n258: /// Existing UrlSigner port adapter backed by per-object callable URLs.\n259: final class FirebaseUrlSigner implements UrlSigner {\n260:   FirebaseUrlSigner({\n261:     required FirebaseDeliveryClient deliveryClient,\n262:     required this.channelId,\n263:   }) : _deliveryClient = deliveryClient;\n264: \n265:   final FirebaseDeliveryClient _deliveryClient;\n266:   final String channelId;\n267: \n268:   @override\n269:   Future<Uri> signFor(\n270:     ClipDescriptor clip, {\n271:     Duration expiry = const Duration(hours: 1),\n272:   }) async {\n273:     if (expiry.isNegative) {\n274:       throw ArgumentError.value(expiry, 'expiry', 'must not be negative');\n275:     }\n276:     return _deliveryClient.refreshUrlFor(channelId: channelId, clip: clip);\n277:   }\n278: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/infra_signed_urls/lib/src/firebase_delivery_client.dart, lines 1-278\n1: /// Firebase callable adapter for short-lived media delivery and ACKs.\n2: library;\n3: \n4: import 'package:cloud_functions/cloud_functions.dart';\n5: import 'package:core_cache/core_cache.dart';\n6: import 'package:core_playlist/core_playlist.dart';\n7: import 'package:infra_firestore/infra_firestore.dart';\n8: \n9: import 'package:infra_signed_urls/src/url_signer.dart';\n10: \n11: final RegExp _sha256 = RegExp(r'^[0-9a-fA-F]{64}$');\n12: \n13: /// Injectable callable boundary for deterministic tests and callable emulator\n14: /// wiring. Production uses the Firebase Functions SDK adapter by default.\n15: abstract interface class FirebaseCallableInvoker {\n16:   Future<Object?> call(String name, Map<String, Object?> payload);\n17: }\n18: \n19: final class _SdkFirebaseCallableInvoker implements FirebaseCallableInvoker {\n20:   _SdkFirebaseCallableInvoker(this._functions);\n21: \n22:   final FirebaseFunctions _functions;\n23: \n24:   @override\n25:   Future<Object?> call(String name, Map<String, Object?> payload) async {\n26:     final HttpsCallableResult<Object?> result = await _functions\n27:         .httpsCallable(name)\n28:         .call<Object?>(payload);\n29:     return result.data;\n30:   }\n31: }\n32: \n33: /// One object-specific signed delivery URL and its server-enforced expiry.\n34: final class FirebaseDeliveryClipUrl {\n35:   FirebaseDeliveryClipUrl({\n36:     required this.cameraId,\n37:     required this.sha256,\n38:     required this.url,\n39:     required this.expiresAt,\n40:   }) {\n41:     if (!_sha256.hasMatch(sha256)) {\n42:       throw const FormatException('delivery clip sha256 must be 64 hex chars');\n43:     }\n44:     if (url.scheme != 'https' || url.host.isEmpty || url.userInfo.isNotEmpty) {\n45:       throw const FormatException('delivery URL must be an HTTPS URL');\n46:     }\n47:     if (slotForCameraId(cameraId) == null) {\n48:       throw FormatException('unknown delivery cameraId: $cameraId');\n49:     }\n50:   }\n51: \n52:   final String cameraId;\n53:   final String sha256;\n54:   final Uri url;\n55:   final DateTime expiresAt;\n56: }\n57: \n58: /// Validated result from the `getDeliveryUrls` callable.\n59: ///\n60: /// `manifestVersion` and `manifestHash` are validated as response fields, but\n61: /// URL reuse is intentionally keyed only by cameraId plus SHA-256. The TV does\n62: /// not request a particular manifest from this callable, so those fields are\n63: /// not compared to a requested manifest.\n64: final class FirebaseDeliveryUrls {\n65:   FirebaseDeliveryUrls({\n66:     required this.manifestVersion,\n67:     required this.manifestHash,\n68:     required List<FirebaseDeliveryClipUrl> clips,\n69:   }) : clips = List<FirebaseDeliveryClipUrl>.unmodifiable(clips) {\n70:     if (manifestVersion <= 0 || !_sha256.hasMatch(manifestHash)) {\n71:       throw const FormatException(\n72:         'delivery response has invalid manifest data',\n73:       );\n74:     }\n75:     final Set<String> cameras = this.clips.map((clip) => clip.cameraId).toSet();\n76:     if (cameras.length != this.clips.length ||\n77:         cameras.length != cctvSlots.length ||\n78:         !cameras.containsAll(cctvSlots.map((slot) => slot.id))) {\n79:       throw const FormatException(\n80:         'delivery response must contain one URL per canonical camera',\n81:       );\n82:     }\n83:   }\n84: \n85:   final int manifestVersion;\n86:   final String manifestHash;\n87:   final List<FirebaseDeliveryClipUrl> clips;\n88: }\n89: \n90: /// Party/device-scoped callable client. Firebase callable auth tokens are\n91: /// attached by the SDK when available; an anonymous TV needs no login and the\n92: /// server validates every supplied party/device registration.\n93: final class FirebaseDeliveryClient implements DeliveryAcknowledger {\n94:   FirebaseDeliveryClient({\n95:     required FirebaseTvIdentity identity,\n96:     FirebaseFunctions? functions,\n97:     FirebaseCallableInvoker? callableInvoker,\n98:     DateTime Function()? now,\n99:   }) : _identity = identity,\n100:        _functions = functions,\n101:        _callableInvoker = callableInvoker,\n102:        _now = now ?? DateTime.now {\n103:     if (functions != null && callableInvoker != null) {\n104:       throw ArgumentError(\n105:         'provide either functions or callableInvoker, not both',\n106:       );\n107:     }\n108:   }\n109: \n110:   final FirebaseTvIdentity _identity;\n111:   final FirebaseFunctions? _functions;\n112:   final FirebaseCallableInvoker? _callableInvoker;\n113:   final DateTime Function() _now;\n114: \n115:   Future<Object?> _call(String name, Map<String, Object?> payload) {\n116:     final FirebaseCallableInvoker invoker =\n117:         _callableInvoker ??\n118:         _SdkFirebaseCallableInvoker(_functions ?? FirebaseFunctions.instance);\n119:     return invoker.call(name, payload);\n120:   }\n121: \n122:   /// Fetches the server's short-lived signed URL for each current object.\n123:   /// A subsequent call can refresh URLs without changing manifest version.\n124:   Future<FirebaseDeliveryUrls> getDeliveryUrls({\n125:     required String channelId,\n126:   }) async {\n127:     final Object? raw = await _call(\n128:       'getDeliveryUrls',\n129:       _identity.callablePayload(channelId: channelId),\n130:     );\n131:     if (raw is! Map) {\n132:       throw const FormatException('getDeliveryUrls response must be an object');\n133:     }\n134:     final Object? rawVersion = raw['manifestVersion'];\n135:     final Object? rawHash = raw['manifestHash'];\n136:     final Object? rawClips = raw['clips'];\n137:     if (rawVersion is! num ||\n138:         rawVersion.toInt() != rawVersion ||\n139:         rawHash is! String ||\n140:         rawClips is! List) {\n141:       throw const FormatException('getDeliveryUrls response is incomplete');\n142:     }\n143:     final List<FirebaseDeliveryClipUrl> clips = <FirebaseDeliveryClipUrl>[];\n144:     for (final Object? value in rawClips) {\n145:       if (value is! Map ||\n146:           value['cameraId'] is! String ||\n147:           value['sha256'] is! String ||\n148:           value['url'] is! String ||\n149:           value['expiresAt'] is! String) {\n150:         throw const FormatException('getDeliveryUrls clip entry is invalid');\n151:       }\n152:       final DateTime expiresAt;\n153:       try {\n154:         expiresAt = DateTime.parse(value['expiresAt']! as String).toUtc();\n155:       } on FormatException {\n156:         throw const FormatException('delivery URL expiresAt is invalid');\n157:       }\n158:       if (!expiresAt.isAfter(_now().toUtc())) {\n159:         throw const FormatException('delivery URL is already expired');\n160:       }\n161:       clips.add(\n162:         FirebaseDeliveryClipUrl(\n163:           cameraId: value['cameraId']! as String,\n164:           sha256: value['sha256']! as String,\n165:           url: Uri.parse(value['url']! as String),\n166:           expiresAt: expiresAt,\n167:         ),\n168:       );\n169:     }\n170:     return FirebaseDeliveryUrls(\n171:       manifestVersion: rawVersion.toInt(),\n172:       manifestHash: rawHash,\n173:       clips: clips,\n174:     );\n175:   }\n176: \n177:   /// Gets a fresh URL for this exact camera content. Hash matching makes a\n178:   /// concurrent manifest update safe: another clip cannot be substituted.\n179:   /// This does not compare the returned manifestVersion or manifestHash with\n180:   /// the prepared manifest; the server response has no requested-version\n181:   /// binding. The caller still ACKs only its prepared version.\n182:   Future<Uri> refreshUrlFor({\n183:     required String channelId,\n184:     required ClipDescriptor clip,\n185:   }) async {\n186:     final FirebaseDeliveryUrls response = await getDeliveryUrls(\n187:       channelId: channelId,\n188:     );\n189:     for (final FirebaseDeliveryClipUrl item in response.clips) {\n190:       if (item.cameraId == clip.cameraId &&\n191:           item.sha256.toLowerCase() == clip.sha256.toLowerCase()) {\n192:         return item.url;\n193:       }\n194:     }\n195:     throw StateError(\n196:       'current manifest no longer contains ${clip.cameraId} with the '\n197:       'requested sha256',\n198:     );\n199:   }\n200: \n201:   @override\n202:   Future<void> acknowledge({\n203:     required String partyId,\n204:     required String channelId,\n205:     required int manifestVersion,\n206:     required Map<String, String> verifiedClipHashes,\n207:   }) async {\n208:     if (partyId != _identity.partyId) {\n209:       throw ArgumentError.value(partyId, 'partyId', 'does not match identity');\n210:     }\n211:     final Set<String> canonicalCameras = cctvSlots\n212:         .map((CctvSlot slot) => slot.id)\n213:         .toSet();\n214:     if (manifestVersion <= 0 ||\n215:         verifiedClipHashes.length != cctvSlots.length ||\n216:         !verifiedClipHashes.keys.toSet().containsAll(canonicalCameras)) {\n217:       throw ArgumentError(\n218:         'ACK requires a positive version and one hash for each canonical camera',\n219:       );\n220:     }\n221:     final Map<String, String> hashes = <String, String>{};\n222:     for (final String cameraId in canonicalCameras) {\n223:       final String hash = verifiedClipHashes[cameraId]!.toLowerCase();\n224:       if (!_sha256.hasMatch(hash)) {\n225:         throw ArgumentError.value(hash, 'verifiedClipHashes[$cameraId]');\n226:       }\n227:       hashes[cameraId] = hash;\n228:     }\n229:     final Object? raw = await _call('acknowledgeDelivery', <String, Object?>{\n230:       ..._identity.callablePayload(channelId: channelId),\n231:       'manifestVersion': manifestVersion,\n232:       'clipHashes': hashes,\n233:     });\n234:     if (raw is! Map) {\n235:       throw const FormatException(\n236:         'acknowledgeDelivery response must be an object',\n237:       );\n238:     }\n239:     final Object? ackId = raw['ackId'];\n240:     final Object? responseVersion = raw['manifestVersion'];\n241:     final Object? purged = raw['purged'];\n242:     if (ackId is! String || ackId.trim().isEmpty) {\n243:       throw const FormatException('acknowledgeDelivery ackId is invalid');\n244:     }\n245:     if (responseVersion is! num ||\n246:         responseVersion.toInt() != responseVersion ||\n247:         responseVersion.toInt() != manifestVersion) {\n248:       throw const FormatException(\n249:         'acknowledgeDelivery manifestVersion does not match request',\n250:       );\n251:     }\n252:     if (purged is! bool || !purged) {\n253:       throw const FormatException('acknowledgeDelivery purged is invalid');\n254:     }\n255:   }\n256: }\n257: \n258: /// Existing UrlSigner port adapter backed by per-object callable URLs.\n259: final class FirebaseUrlSigner implements UrlSigner {\n260:   FirebaseUrlSigner({\n261:     required FirebaseDeliveryClient deliveryClient,\n262:     required this.channelId,\n263:   }) : _deliveryClient = deliveryClient;\n264: \n265:   final FirebaseDeliveryClient _deliveryClient;\n266:   final String channelId;\n267: \n268:   @override\n269:   Future<Uri> signFor(\n270:     ClipDescriptor clip, {\n271:     Duration expiry = const Duration(hours: 1),\n272:   }) async {\n273:     if (expiry.isNegative) {\n274:       throw ArgumentError.value(expiry, 'expiry', 'must not be negative');\n275:     }\n276:     return _deliveryClient.refreshUrlFor(channelId: channelId, clip: clip);\n277:   }\n278: }"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929b0484776ea1202e0a01a67422"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/packages/infra_signed_urls/lib/src/firebase_delivery_client.dart\"}"},"time":{"start":1793460995632,"end":1793460995656}}}}
{"type":"tool_use","timestamp":1793460995657,"sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","part":{"partID":"prt_1929b06310016qhx2YRtMPDduv","sessionID":"ses_e6d6514fcffe8tXblUpqWJRce4","messageID":"msg_1929aff59001K0ds8YhC3TgI5W","type":"tool","id":"call_01a1929b04b6761998c37df7685ecc38","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-1/packages/core_playlist/test/core_playlist_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-1/packages/core_playlist/test/core_playlist_test.dart, lines 1-455\n1: import 'package:core_foundation/core_foundation.dart';\n2: import 'package:core_playlist/core_playlist.dart';\n3: import 'package:flutter_test/flutter_test.dart';\n4: \n5: String sha(String seed) {\n6:   final units = seed.codeUnits;\n7:   final buf = StringBuffer();\n8:   var h = 0x811c9dc5;\n9:   while (buf.length < 64) {\n10:     for (final u in units) {\n11:       h = ((h ^ u) * 16777619) & 0xffffffff;\n12:       buf.write(h.toRadixString(16).padLeft(8, '0'));\n13:       if (buf.length >= 64) {\n14:         break;\n15:       }\n16:     }\n17:   }\n18:   return buf.toString().substring(0, 64);\n19: }\n20: \n21: ClipDescriptor clipAt(int i) => ClipDescriptor(\n22:   id: 'clip-0$i',\n23:   cameraId: 'CAM-0$i',\n24:   storageObjectId: 'obj-0$i',\n25:   sha256: sha('clip-0$i'),\n26:   sizeBytes: 1000 + i,\n27:   duration: const Duration(seconds: 10),\n28:   mimeType: 'video/mp4',\n29: );\n30: \n31: PlaybackManifest manifest({\n32:   String partyId = 'party-1',\n33:   String channelId = 'cctv',\n34:   int version = 3,\n35:   List<ClipDescriptor>? clips,\n36:   OverlaySettings overlay = const OverlaySettings(),\n37: }) => PlaybackManifest(\n38:   partyId: partyId,\n39:   channelId: channelId,\n40:   version: version,\n41:   overlay: overlay,\n42:   publishedAt: DateTime.utc(2026, 10, 31, 20),\n43:   clips: clips ?? <ClipDescriptor>[for (var i = 1; i <= 4; i++) clipAt(i)],\n44: );\n45: \n46: PlaybackManifest validManifest() => manifest();\n47: \n48: void main() {\n49:   group('validation', () {\n50:     test('valid manifest passes', () {\n51:       final r = validateCctvManifest(validManifest());\n52:       expect(r, isA<Ok<PlaybackManifest>>());\n53:       expect((r as Ok<PlaybackManifest>).value.clips, hasLength(4));\n54:     });\n55: \n56:     test('blank party/channel rejected', () {\n57:       expect(\n58:         (validateCctvManifest(manifest(partyId: '  ')) as Err<PlaybackManifest>)\n59:             .message,\n60:         contains('partyId'),\n61:       );\n62:       expect(\n63:         (validateCctvManifest(manifest(channelId: '')) as Err<PlaybackManifest>)\n64:             .message,\n65:         contains('channelId'),\n66:       );\n67:     });\n68: \n69:     test('version <= 0 rejected', () {\n70:       for (final bad in <int>[0, -1]) {\n71:         final r = validateCctvManifest(manifest(version: bad));\n72:         expect(r, isA<Err<PlaybackManifest>>());\n73:         expect((r as Err<PlaybackManifest>).message, contains('version'));\n74:       }\n75:     });\n76: \n77:     test('manifest version must advance beyond committed version', () {\n78:       final current = manifest(version: 4);\n79:       expect(validateManifestVersion(current, null).isOk, isTrue);\n80:       expect(validateManifestVersion(manifest(version: 5), 4).isOk, isTrue);\n81:       final stale = validateManifestVersion(manifest(version: 4), 4);\n82:       expect(stale, isA<Err<PlaybackManifest>>());\n83:       expect((stale as Err<PlaybackManifest>).message, contains('newer'));\n84:       expect(validateManifestVersion(manifest(version: 3), 4).isErr, isTrue);\n85:     });\n86: \n87:     test('camera assignments cover every slot even when order differs', () {\n88:       final reversed = manifest(\n89:         clips: <ClipDescriptor>[clipAt(4), clipAt(3), clipAt(2), clipAt(1)],\n90:       );\n91:       expect(validateCctvManifest(reversed).isOk, isTrue);\n92:       expect(\n93:         reversed.clips.map((clip) => slotForCameraId(clip.cameraId)!.index),\n94:         <int>[3, 2, 1, 0],\n95:       );\n96:     });\n97: \n98:     test('clip count other than 4 rejected', () {\n99:       for (final count in <int>[0, 3, 5]) {\n100:         final clips = <ClipDescriptor>[\n101:           for (var i = 1; i <= count; i++) clipAt(i),\n102:         ];\n103:         final r = validateCctvManifest(manifest(clips: clips));\n104:         expect(r.isErr, isTrue);\n105:         expect((r as Err<PlaybackManifest>).message, contains('4 clips'));\n106:       }\n107:     });\n108: \n109:     test('duplicate camera rejected', () {\n110:       final clips = <ClipDescriptor>[for (var i = 1; i <= 4; i++) clipAt(i)];\n111:       clips[3] = ClipDescriptor(\n112:         id: 'clip-99',\n113:         cameraId: 'CAM-01',\n114:         storageObjectId: 'obj-99',\n115:         sha256: sha('clip-99'),\n116:         sizeBytes: 10,\n117:         duration: const Duration(seconds: 5),\n118:         mimeType: 'video/mp4',\n119:       );\n120:       final r = validateCctvManifest(manifest(clips: clips));\n121:       expect(r.isErr, isTrue);\n122:       expect(\n123:         (r as Err<PlaybackManifest>).message,\n124:         contains('duplicate cameraId'),\n125:       );\n126:     });\n127: \n128:     test('unknown camera id rejected', () {\n129:       final clips = <ClipDescriptor>[for (var i = 1; i <= 4; i++) clipAt(i)];\n130:       clips[0] = ClipDescriptor(\n131:         id: 'clip-01',\n132:         cameraId: 'CAM-05',\n133:         storageObjectId: 'obj-01',\n134:         sha256: sha('clip-01'),\n135:         sizeBytes: 10,\n136:         duration: const Duration(seconds: 5),\n137:         mimeType: 'video/mp4',\n138:       );\n139:       final r = validateCctvManifest(manifest(clips: clips));\n140:       expect(r.isErr, isTrue);\n141:       expect((r as Err<PlaybackManifest>).message, contains('CAM-05'));\n142:     });\n143: \n144:     test('duplicate clip id rejected', () {\n145:       final clips = <ClipDescriptor>[for (var i = 1; i <= 4; i++) clipAt(i)];\n146:       clips[3] = ClipDescriptor(\n147:         id: 'clip-01',\n148:         cameraId: 'CAM-04',\n149:         storageObjectId: 'obj-04',\n150:         sha256: sha('clip-04'),\n151:         sizeBytes: 10,\n152:         duration: const Duration(seconds: 5),\n153:         mimeType: 'video/mp4',\n154:       );\n155:       final r = validateCctvManifest(manifest(clips: clips));\n156:       expect(r.isErr, isTrue);\n157:       expect(\n158:         (r as Err<PlaybackManifest>).message,\n159:         contains('duplicate clip id'),\n160:       );\n161:     });\n162: \n163:     test('malformed sha256 rejected', () {\n164:       for (final badSha in <String>['', 'not-a-hash', 'a' * 63, 'z' * 64]) {\n165:         final clips = <ClipDescriptor>[for (var i = 1; i <= 4; i++) clipAt(i)];\n166:         clips[2] = ClipDescriptor(\n167:           id: 'clip-03',\n168:           cameraId: 'CAM-03',\n169:           storageObjectId: 'obj-03',\n170:           sha256: badSha,\n171:           sizeBytes: 10,\n172:           duration: const Duration(seconds: 5),\n173:           mimeType: 'video/mp4',\n174:         );\n175:         final r = validateCctvManifest(manifest(clips: clips));\n176:         expect(r.isErr, isTrue, reason: 'sha=\"$badSha\" should be rejected');\n177:         expect((r as Err<PlaybackManifest>).message, contains('sha256'));\n178:       }\n179:     });\n180: \n181:     test('insane size and duration rejected', () {\n182:       final zeroSize = ClipDescriptor(\n183:         id: 'clip-01',\n184:         cameraId: 'CAM-01',\n185:         storageObjectId: 'obj-01',\n186:         sha256: sha('clip-01'),\n187:         sizeBytes: 0,\n188:         duration: const Duration(seconds: 5),\n189:         mimeType: 'video/mp4',\n190:       );\n191:       final clips = <ClipDescriptor>[zeroSize, clipAt(2), clipAt(3), clipAt(4)];\n192:       final r = validateCctvManifest(manifest(clips: clips));\n193:       expect((r as Err<PlaybackManifest>).message, contains('sizeBytes'));\n194: \n195:       final zeroDuration = ClipDescriptor(\n196:         id: 'clip-01',\n197:         cameraId: 'CAM-01',\n198:         storageObjectId: 'obj-01',\n199:         sha256: sha('clip-01'),\n200:         sizeBytes: 10,\n201:         duration: Duration.zero,\n202:         mimeType: 'video/mp4',\n203:       );\n204:       final clips2 = <ClipDescriptor>[\n205:         zeroDuration,\n206:         clipAt(2),\n207:         clipAt(3),\n208:         clipAt(4),\n209:       ];\n210:       final r2 = validateCctvManifest(manifest(clips: clips2));\n211:       expect((r2 as Err<PlaybackManifest>).message, contains('duration'));\n212:     });\n213:   });\n214: \n215:   group('json', () {\n216:     test('round-trip preserves sha256 and every field', () {\n217:       final m = validManifest();\n218:       final parsed = parseManifest(m.toJson());\n219:       expect(\n220:         parsed.clips.map((c) => c.sha256).toList(),\n221:         m.clips.map((c) => c.sha256).toList(),\n222:       );\n223:       expect(parsed, equals(m));\n224:       expect(parsed.hashCode, m.hashCode);\n225:       expect(validateCctvManifest(parsed).isOk, isTrue);\n226:     });\n227: \n228:     test('round-trip preserves overlay values', () {\n229:       const overlay = OverlaySettings(\n230:         scanlineOpacity: 0.1,\n231:         noiseLevel: 0.9,\n232:         vignette: 0.2,\n233:       );\n234:       final parsed = parseManifest(manifest(overlay: overlay).toJson());\n235:       expect(parsed.overlay, equals(overlay));\n236:     });\n237: \n238:     test('publishedAt is serialised as UTC ISO-8601', () {\n239:       final m = manifest();\n240:       expect(m.toJson()['publishedAt'], '2026-10-31T20:00:00.000Z');\n241:       expect(parseManifest(m.toJson()).publishedAt.isUtc, isTrue);\n242:     });\n243: \n244:     test('out-of-range overlay numerics are clamped on parse', () {\n245:       final json = validManifest().toJ