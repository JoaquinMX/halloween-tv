{"type":"tool_use","timestamp":1793463865539,"sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","part":{"partID":"prt_192c67b63001t2mmLwV9Lf6Qh6","sessionID":"ses_e6d3ce8c9ffeeTm3cqgJ0o1POd","messageID":"msg_192c674d0001Xs4xsZHpzANmam","type":"tool","id":"call_01a192c677f2739494725d8d1eb89e14","tool":"write","state":{"status":"completed","input":{"content":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { readFile } from \"node:fs/promises\";\nimport { resolve } from \"node:path\";\nimport { Timestamp } from \"firebase-admin/firestore\";\nimport { BackendError } from \"../src/contracts\";\nimport { createHostJoinService, hashHostInviteToken } from \"../src/host_join\";\nimport { createJoinPartyService } from \"../src/join_party\";\nimport { assertRegisteredHostDevice } from \"../src/auth\";\nimport {\n  HAS_FIRESTORE_EMULATOR,\n  clearParty,\n  createEmulatorContext,\n  disposeEmulatorContext,\n  randomPartyId,\n  seedParty,\n} from \"./support/emulators\";\n\nasync function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\n  await seedParty(db, partyId, deviceId, channelId);\n  await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \"tv\" });\n}\n\ntest(\"join_roles fixture pins the guest/host role boundary (shape only; behaviour is covered by emulator tests)\", async () => {\n  const content = await readFile(resolve(__dirname, \"../../../test/fixtures/join_roles_v1.json\"), \"utf8\");\n  const roles = JSON.parse(content) as {\n    callables: string[];\n    guestJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\n    hostJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\n    createHostInvite: { response: Record<string, unknown> };\n  };\n  assert.deepEqual(roles.callables, [\"createHostInvite\", \"joinHost\", \"revokeHostDevice\", \"listHostVideos\", \"generateHostVideo\", \"getHostVideoPreview\", \"deleteHostVideo\"]);\n  // The fixture PIN is an obviously-fake placeholder, never a live credential.\n  assert.equal(roles.guestJoin.request.joinPin, \"000000\");\n  assert.match(String(roles.guestJoin.request.joinPin), /^[0-9]{6}$/);\n  // The host route carries a server-minted capability plus a 6-digit pairing\n  // code (never a bare guest PIN shape for the token itself).\n  assert.ok(String(roles.hostJoin.request.inviteToken).length > 0);\n  assert.ok(!/^[0-9]{6}$/.test(String(roles.hostJoin.request.inviteToken)));\n  assert.ok(\"pairingCode\" in roles.hostJoin.request);\n  assert.ok(\"pairingCode\" in roles.createHostInvite.response);\n  // Behavioural role-boundary coverage lives in the emulator tests below, not\n  // in this JSON: guest joins yield role guest, host redemptions yield role\n  // host, and the two routes are disjoint server-side.\n});\n\ntest(\"guest and host routes produce disjoint server-assigned roles (behavioural)\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const hosts = createHostJoinService({ db });\n    const joinParty = createJoinPartyService({ db });\n    const guest = await joinParty.joinParty({ partyId, deviceId: \"p-guest-1\", channelId: \"main\" });\n    assert.equal(guest.role, \"guest\");\n    const invite = await hosts.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    const joined = await hosts.joinHost({\n      partyId, deviceId: \"p-host-1\", channelId: \"main\",\n      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\n    });\n    assert.equal(joined.role, \"host\");\n    assert.notEqual(guest.role, joined.role);\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-1`).get()).data()?.role, \"guest\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \"host\");\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"only a registered TV may mint a host invite; invites bind party/channel/expiry\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db, bucket } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    await seedParty(db, partyId, \"p-guest-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    assert.equal(invite.partyId, partyId);\n    assert.equal(invite.channelId, \"main\");\n    assert.ok(invite.inviteToken.startsWith(\"hi-\"));\n    assert.match(invite.pairingCode, /^[0-9]{6}$/);\n    assert.ok(Date.parse(invite.expiresAt) > Date.now());\n    // Only hashes are stored, bound to party/channel/expiry; neither secret\n    // appears in the stored doc.\n    const tokenHash = hashHostInviteToken(invite.inviteToken);\n    const stored = (await db.doc(`parties/${partyId}/hostInvites/${tokenHash.slice(0, 32)}`).get()).data()!;\n    assert.equal(stored.tokenHash, tokenHash);\n    assert.equal(stored.partyId, partyId);\n    assert.equal(stored.channelId, \"main\");\n    assert.equal(stored.status, \"pending\");\n    assert.ok(typeof stored.pairingCodeHash === \"string\" && typeof stored.pairingSalt === \"string\");\n    assert.ok(!(\"inviteToken\" in stored) && !JSON.stringify(stored).includes(invite.inviteToken));\n    assert.ok(!JSON.stringify(stored).includes(invite.pairingCode), \"pairing code is never stored in cleartext\");\n    // Guests, unknown devices, and wrong channels cannot mint invites.\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \"p-guest-1\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \"nope\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"other\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n  } finally {\n    await clearParty(db, bucket, partyId);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"host redemption is transactional: idempotent retry, replay/expiry/PIN/role forgery denied\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    const redeem = { partyId, channelId: \"main\", inviteToken: invite.inviteToken, pairingCode: invite.pairingCode };\n\n    const joined = await services.joinHost({ ...redeem, deviceId: \"p-host-1\" });\n    assert.deepEqual(joined, { partyId, deviceId: \"p-host-1\", channelId: \"main\", role: \"host\", status: \"active\", created: true });\n    const device = (await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()!;\n    assert.equal(device.role, \"host\");\n    assert.equal(device.status, \"active\");\n    assert.equal(typeof device.redeemedFromInviteId, \"string\");\n    assert.ok(device.redeemedAt, \"redemption records redeemedAt on the device doc\");\n\n    // Same-device redemption retries are idempotent.\n    const retried = await services.joinHost({ ...redeem, deviceId: \"p-host-1\" });\n    assert.equal(retried.created, false);\n    assert.equal(retried.role, \"host\");\n\n    // Other-device replay of the same token cannot grant host access.\n    await assert.rejects(services.joinHost({ ...redeem, deviceId: \"p-host-2\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).exists, false);\n\n    // Guest PIN reuse cannot grant host access (shape-rejected, never redeemed).\n    await assert.rejects(services.joinHost({ partyId, deviceId: \"p-host-3\", channelId: \"main\", inviteToken: \"004201\", pairingCode: invite.pairingCode }),\n      (e: unknown) => e instanceof BackendError);\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-3`).get()).exists, false);\n\n    // Client-only role changes cannot grant host access: a forged role field\n    // is ignored and a guest-PIN registration stays a guest.\n    const joinParty = createJoinPartyService({ db });\n    const guest = await joinParty.joinParty({ partyId, deviceId: \"p-guest-9\", channelId: \"main\", role: \"host\" } as unknown as Record<string, unknown>);\n    assert.equal(guest.role, \"guest\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-9`).get()).data()?.role, \"guest\");\n    await assert.rejects(services.joinHost({ ...redeem, deviceId: \"p-guest-9\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n\n    // Expired invites are refused.\n    const invite2 = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    const tokenHash2 = hashHostInviteToken(invite2.inviteToken);\n    await db.doc(`parties/${partyId}/hostInvites/${tokenHash2.slice(0, 32)}`).update({ expiresAt: Timestamp.fromDate(new Date(Date.now() - 1000)) });\n    await assert.rejects(services.joinHost({\n      partyId, deviceId: \"p-host-4\", channelId: \"main\",\n      inviteToken: invite2.inviteToken, pairingCode: invite2.pairingCode,\n    }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n\n    // Cross-party token reuse is refused.\n    const otherParty = randomPartyId();\n    await seedTv(db, otherParty, \"tv-9\", \"main\");\n    await assert.rejects(services.joinHost({ ...redeem, partyId: otherParty, deviceId: \"p-host-5\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await db.recursiveDelete(db.doc(`parties/${otherParty}`)).catch(() => undefined);\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"pairing code is required and wrong codes deny exactly like an unknown invite\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    assert.match(invite.pairingCode, /^[0-9]{6}$/);\n\n    const probe = async (body: Record<string, unknown>): Promise<BackendError> =>\n      services.joinHost(body).then(\n        () => { throw new Error(\"expected rejection\"); },\n        (error: unknown) => error as BackendError,\n      );\n    // Missing, malformed, and wrong codes all deny with the SAME generic\n    // error as an unknown invite: no oracle for code-vs-token probing.\n    const unknown = await probe({ partyId, deviceId: \"p-x\", channelId: \"main\", inviteToken: \"hi-deadbeef\", pairingCode: \"000000\" });\n    assert.ok(unknown instanceof BackendError && unknown.errorCode === \"FORBIDDEN\");\n    for (const pairingCode of [undefined, \"\", \"12345\", \"1234567\", \"abcdef\", \"12 456\", 4201, null]) {\n      const denied = await probe({ partyId, deviceId: \"p-x\", channelId: \"main\", inviteToken: invite.inviteToken, pairingCode });\n      assert.ok(denied instanceof BackendError && denied.errorCode === \"FORBIDDEN\", `code ${String(pairingCode)} must deny`);\n      assert.equal(denied.message, unknown.message, \"denial message must be identical (no oracle)\");\n    }\n    const wrongCode = String((Number(invite.pairingCode) + 1) % 1_000_000).padStart(6, \"0\");\n    const wrong = await probe({ partyId, deviceId: \"p-x\", channelId: \"main\", inviteToken: invite.inviteToken, pairingCode: wrongCode });\n    assert.ok(wrong instanceof BackendError && wrong.errorCode === \"FORBIDDEN\");\n    assert.equal(wrong.message, unknown.message, \"wrong code must deny identically to an unknown invite\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-x`).get()).exists, false);\n    // The correct half still redeems afterwards (wrong guesses do not burn it).\n    const joined = await services.joinHost({\n      partyId, deviceId: \"p-host-ok\", channelId: \"main\",\n      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\n    });\n    assert.equal(joined.role, \"host\");\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"minting a new invite supersedes older pending invites for the same channel\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const first = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    const second = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    assert.notEqual(first.inviteToken, second.inviteToken);\n    const firstStored = (await db.doc(`parties/${partyId}/hostInvites/${hashHostInviteToken(first.inviteToken).slice(0, 32)}`).get()).data()!;\n    assert.equal(firstStored.status, \"superseded\", \"older pending invite must be invalidated by the new mint\");\n    // The superseded invite can no longer redeem, even with its own code.\n    await assert.rejects(services.joinHost({\n      partyId, deviceId: \"p-host-old\", channelId: \"main\",\n      inviteToken: first.inviteToken, pairingCode: first.pairingCode,\n    }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    // The newest invite redeems normally.\n    const joined = await services.joinHost({\n      partyId, deviceId: \"p-host-new\", channelId: \"main\",\n      inviteToken: second.inviteToken, pairingCode: second.pairingCode,\n    });\n    assert.equal(joined.created, true);\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"at most 3 active host devices per party; revocation frees capacity with an audit record\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const services = createHostJoinService({ db });\n    const redeem = async (deviceId: string) => {\n      const invite = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n      return services.joinHost({\n        partyId, deviceId, channelId: \"main\",\n        inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\n      });\n    };\n    for (const deviceId of [\"p-host-1\", \"p-host-2\", \"p-host-3\"]) {\n      const joined = await redeem(deviceId);\n      assert.equal(joined.created, true);\n    }\n    // Fourth redemption is denied until a host is revoked.\n    const fourth = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    await assert.rejects(services.joinHost({\n      partyId, deviceId: \"p-host-4\", channelId: \"main\",\n      inviteToken: fourth.inviteToken, pairingCode: fourth.pairingCode,\n    }), (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-4`).get()).exists, false);\n\n    // TV-only revocation: guests and strangers cannot revoke.\n    await assert.rejects(services.revokeHostDevice({ partyId, deviceId: \"p-host-1\", channelId: \"main\", targetDeviceId: \"p-host-2\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    await assert.rejects(services.revokeHostDevice({ partyId, deviceId: \"nope\", channelId: \"main\", targetDeviceId: \"p-host-2\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n\n    // The TV revokes one host: device demoted, audit record written.\n    const revoked = await services.revokeHostDevice({ partyId, deviceId: \"tv-1\", channelId: \"main\", targetDeviceId: \"p-host-2\" });\n    assert.deepEqual(revoked, { partyId, targetDeviceId: \"p-host-2\", status: \"revoked\" });\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).data()?.status, \"revoked\");\n    const audits = await db.collection(`parties/${partyId}/hostAudit`).where(\"targetDeviceId\", \"==\", \"p-host-2\").get();\n    assert.equal(audits.size, 1, \"revocation must write exactly one audit record\");\n    assert.equal(audits.docs[0].data()?.action, \"revoke\");\n    assert.equal(audits.docs[0].data()?.byDeviceId, \"tv-1\");\n\n    // The revoked host is denied on its next admin operation.\n    await assert.rejects(assertRegisteredHostDevice(db, { partyId, deviceId: \"p-host-2\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n\n    // Capacity freed: the fourth phone redeems with a fresh invite.\n    const fifth = await services.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    const rejoined = await services.joinHost({\n      partyId, deviceId: \"p-host-4\", channelId: \"main\",\n      inviteToken: fifth.inviteToken, pairingCode: fifth.pairingCode,\n    });\n    assert.equal(rejoined.created, true);\n    assert.equal(rejoined.role, \"host\");\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n\ntest(\"legacy joinParty remains guest-only and never upgrades host devices\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\n  const { app, db } = await createEmulatorContext();\n  const partyId = randomPartyId();\n  try {\n    await seedTv(db, partyId, \"tv-1\", \"main\");\n    const hosts = createHostJoinService({ db });\n    const joinParty = createJoinPartyService({ db });\n    const invite = await hosts.createHostInvite({ partyId, deviceId: \"tv-1\", channelId: \"main\" });\n    await hosts.joinHost({\n      partyId, deviceId: \"p-host-1\", channelId: \"main\",\n      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\n    });\n    // A host device rejoining through the legacy path is rejected, not downgraded.\n    await assert.rejects(joinParty.joinParty({ partyId, deviceId: \"p-host-1\", channelId: \"main\" }),\n      (e: unknown) => e instanceof BackendError && e.errorCode === \"FORBIDDEN\");\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \"host\");\n    // Fresh legacy joins are still guests.\n    const guest = await joinParty.joinParty({ partyId, deviceId: \"p-new-guest\", channelId: \"main\" });\n    assert.equal(guest.role, \"guest\");\n  } finally {\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\n    await disposeEmulatorContext(app);\n  }\n});\n","path":"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/host_join.test.ts"},"output":"Wrote file successfully: backend/functions/test/host_join.test.ts","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: backend/functions/test/host_join.test.ts"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c677f2739494725d8d1eb89e14"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import assert from \\\"node:assert/strict\\\";\\nimport test from \\\"node:test\\\";\\nimport { readFile } from \\\"node:fs/promises\\\";\\nimport { resolve } from \\\"node:path\\\";\\nimport { Timestamp } from \\\"firebase-admin/firestore\\\";\\nimport { BackendError } from \\\"../src/contracts\\\";\\nimport { createHostJoinService, hashHostInviteToken } from \\\"../src/host_join\\\";\\nimport { createJoinPartyService } from \\\"../src/join_party\\\";\\nimport { assertRegisteredHostDevice } from \\\"../src/auth\\\";\\nimport {\\n  HAS_FIRESTORE_EMULATOR,\\n  clearParty,\\n  createEmulatorContext,\\n  disposeEmulatorContext,\\n  randomPartyId,\\n  seedParty,\\n} from \\\"./support/emulators\\\";\\n\\nasync function seedTv(db: FirebaseFirestore.Firestore, partyId: string, deviceId: string, channelId: string): Promise<void> {\\n  await seedParty(db, partyId, deviceId, channelId);\\n  await db.doc(`parties/${partyId}/devices/${deviceId}`).update({ role: \\\"tv\\\" });\\n}\\n\\ntest(\\\"join_roles fixture pins the guest/host role boundary (shape only; behaviour is covered by emulator tests)\\\", async () => {\\n  const content = await readFile(resolve(__dirname, \\\"../../../test/fixtures/join_roles_v1.json\\\"), \\\"utf8\\\");\\n  const roles = JSON.parse(content) as {\\n    callables: string[];\\n    guestJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\\n    hostJoin: { request: Record<string, unknown>; response: Record<string, unknown> };\\n    createHostInvite: { response: Record<string, unknown> };\\n  };\\n  assert.deepEqual(roles.callables, [\\\"createHostInvite\\\", \\\"joinHost\\\", \\\"revokeHostDevice\\\", \\\"listHostVideos\\\", \\\"generateHostVideo\\\", \\\"getHostVideoPreview\\\", \\\"deleteHostVideo\\\"]);\\n  // The fixture PIN is an obviously-fake placeholder, never a live credential.\\n  assert.equal(roles.guestJoin.request.joinPin, \\\"000000\\\");\\n  assert.match(String(roles.guestJoin.request.joinPin), /^[0-9]{6}$/);\\n  // The host route carries a server-minted capability plus a 6-digit pairing\\n  // code (never a bare guest PIN shape for the token itself).\\n  assert.ok(String(roles.hostJoin.request.inviteToken).length > 0);\\n  assert.ok(!/^[0-9]{6}$/.test(String(roles.hostJoin.request.inviteToken)));\\n  assert.ok(\\\"pairingCode\\\" in roles.hostJoin.request);\\n  assert.ok(\\\"pairingCode\\\" in roles.createHostInvite.response);\\n  // Behavioural role-boundary coverage lives in the emulator tests below, not\\n  // in this JSON: guest joins yield role guest, host redemptions yield role\\n  // host, and the two routes are disjoint server-side.\\n});\\n\\ntest(\\\"guest and host routes produce disjoint server-assigned roles (behavioural)\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const hosts = createHostJoinService({ db });\\n    const joinParty = createJoinPartyService({ db });\\n    const guest = await joinParty.joinParty({ partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\" });\\n    assert.equal(guest.role, \\\"guest\\\");\\n    const invite = await hosts.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    const joined = await hosts.joinHost({\\n      partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\",\\n      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\\n    });\\n    assert.equal(joined.role, \\\"host\\\");\\n    assert.notEqual(guest.role, joined.role);\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-1`).get()).data()?.role, \\\"guest\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \\\"host\\\");\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"only a registered TV may mint a host invite; invites bind party/channel/expiry\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db, bucket } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    await seedParty(db, partyId, \\\"p-guest-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const invite = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    assert.equal(invite.partyId, partyId);\\n    assert.equal(invite.channelId, \\\"main\\\");\\n    assert.ok(invite.inviteToken.startsWith(\\\"hi-\\\"));\\n    assert.match(invite.pairingCode, /^[0-9]{6}$/);\\n    assert.ok(Date.parse(invite.expiresAt) > Date.now());\\n    // Only hashes are stored, bound to party/channel/expiry; neither secret\\n    // appears in the stored doc.\\n    const tokenHash = hashHostInviteToken(invite.inviteToken);\\n    const stored = (await db.doc(`parties/${partyId}/hostInvites/${tokenHash.slice(0, 32)}`).get()).data()!;\\n    assert.equal(stored.tokenHash, tokenHash);\\n    assert.equal(stored.partyId, partyId);\\n    assert.equal(stored.channelId, \\\"main\\\");\\n    assert.equal(stored.status, \\\"pending\\\");\\n    assert.ok(typeof stored.pairingCodeHash === \\\"string\\\" && typeof stored.pairingSalt === \\\"string\\\");\\n    assert.ok(!(\\\"inviteToken\\\" in stored) && !JSON.stringify(stored).includes(invite.inviteToken));\\n    assert.ok(!JSON.stringify(stored).includes(invite.pairingCode), \\\"pairing code is never stored in cleartext\\\");\\n    // Guests, unknown devices, and wrong channels cannot mint invites.\\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \\\"p-guest-1\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \\\"nope\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await assert.rejects(services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"other\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n  } finally {\\n    await clearParty(db, bucket, partyId);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"host redemption is transactional: idempotent retry, replay/expiry/PIN/role forgery denied\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const invite = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    const redeem = { partyId, channelId: \\\"main\\\", inviteToken: invite.inviteToken, pairingCode: invite.pairingCode };\\n\\n    const joined = await services.joinHost({ ...redeem, deviceId: \\\"p-host-1\\\" });\\n    assert.deepEqual(joined, { partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\", role: \\\"host\\\", status: \\\"active\\\", created: true });\\n    const device = (await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()!;\\n    assert.equal(device.role, \\\"host\\\");\\n    assert.equal(device.status, \\\"active\\\");\\n    assert.equal(typeof device.redeemedFromInviteId, \\\"string\\\");\\n    assert.ok(device.redeemedAt, \\\"redemption records redeemedAt on the device doc\\\");\\n\\n    // Same-device redemption retries are idempotent.\\n    const retried = await services.joinHost({ ...redeem, deviceId: \\\"p-host-1\\\" });\\n    assert.equal(retried.created, false);\\n    assert.equal(retried.role, \\\"host\\\");\\n\\n    // Other-device replay of the same token cannot grant host access.\\n    await assert.rejects(services.joinHost({ ...redeem, deviceId: \\\"p-host-2\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).exists, false);\\n\\n    // Guest PIN reuse cannot grant host access (shape-rejected, never redeemed).\\n    await assert.rejects(services.joinHost({ partyId, deviceId: \\\"p-host-3\\\", channelId: \\\"main\\\", inviteToken: \\\"004201\\\", pairingCode: invite.pairingCode }),\\n      (e: unknown) => e instanceof BackendError);\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-3`).get()).exists, false);\\n\\n    // Client-only role changes cannot grant host access: a forged role field\\n    // is ignored and a guest-PIN registration stays a guest.\\n    const joinParty = createJoinPartyService({ db });\\n    const guest = await joinParty.joinParty({ partyId, deviceId: \\\"p-guest-9\\\", channelId: \\\"main\\\", role: \\\"host\\\" } as unknown as Record<string, unknown>);\\n    assert.equal(guest.role, \\\"guest\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-guest-9`).get()).data()?.role, \\\"guest\\\");\\n    await assert.rejects(services.joinHost({ ...redeem, deviceId: \\\"p-guest-9\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n\\n    // Expired invites are refused.\\n    const invite2 = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    const tokenHash2 = hashHostInviteToken(invite2.inviteToken);\\n    await db.doc(`parties/${partyId}/hostInvites/${tokenHash2.slice(0, 32)}`).update({ expiresAt: Timestamp.fromDate(new Date(Date.now() - 1000)) });\\n    await assert.rejects(services.joinHost({\\n      partyId, deviceId: \\\"p-host-4\\\", channelId: \\\"main\\\",\\n      inviteToken: invite2.inviteToken, pairingCode: invite2.pairingCode,\\n    }), (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n\\n    // Cross-party token reuse is refused.\\n    const otherParty = randomPartyId();\\n    await seedTv(db, otherParty, \\\"tv-9\\\", \\\"main\\\");\\n    await assert.rejects(services.joinHost({ ...redeem, partyId: otherParty, deviceId: \\\"p-host-5\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await db.recursiveDelete(db.doc(`parties/${otherParty}`)).catch(() => undefined);\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"pairing code is required and wrong codes deny exactly like an unknown invite\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const invite = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    assert.match(invite.pairingCode, /^[0-9]{6}$/);\\n\\n    const probe = async (body: Record<string, unknown>): Promise<BackendError> =>\\n      services.joinHost(body).then(\\n        () => { throw new Error(\\\"expected rejection\\\"); },\\n        (error: unknown) => error as BackendError,\\n      );\\n    // Missing, malformed, and wrong codes all deny with the SAME generic\\n    // error as an unknown invite: no oracle for code-vs-token probing.\\n    const unknown = await probe({ partyId, deviceId: \\\"p-x\\\", channelId: \\\"main\\\", inviteToken: \\\"hi-deadbeef\\\", pairingCode: \\\"000000\\\" });\\n    assert.ok(unknown instanceof BackendError && unknown.errorCode === \\\"FORBIDDEN\\\");\\n    for (const pairingCode of [undefined, \\\"\\\", \\\"12345\\\", \\\"1234567\\\", \\\"abcdef\\\", \\\"12 456\\\", 4201, null]) {\\n      const denied = await probe({ partyId, deviceId: \\\"p-x\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken, pairingCode });\\n      assert.ok(denied instanceof BackendError && denied.errorCode === \\\"FORBIDDEN\\\", `code ${String(pairingCode)} must deny`);\\n      assert.equal(denied.message, unknown.message, \\\"denial message must be identical (no oracle)\\\");\\n    }\\n    const wrongCode = String((Number(invite.pairingCode) + 1) % 1_000_000).padStart(6, \\\"0\\\");\\n    const wrong = await probe({ partyId, deviceId: \\\"p-x\\\", channelId: \\\"main\\\", inviteToken: invite.inviteToken, pairingCode: wrongCode });\\n    assert.ok(wrong instanceof BackendError && wrong.errorCode === \\\"FORBIDDEN\\\");\\n    assert.equal(wrong.message, unknown.message, \\\"wrong code must deny identically to an unknown invite\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-x`).get()).exists, false);\\n    // The correct half still redeems afterwards (wrong guesses do not burn it).\\n    const joined = await services.joinHost({\\n      partyId, deviceId: \\\"p-host-ok\\\", channelId: \\\"main\\\",\\n      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\\n    });\\n    assert.equal(joined.role, \\\"host\\\");\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"minting a new invite supersedes older pending invites for the same channel\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const first = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    const second = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    assert.notEqual(first.inviteToken, second.inviteToken);\\n    const firstStored = (await db.doc(`parties/${partyId}/hostInvites/${hashHostInviteToken(first.inviteToken).slice(0, 32)}`).get()).data()!;\\n    assert.equal(firstStored.status, \\\"superseded\\\", \\\"older pending invite must be invalidated by the new mint\\\");\\n    // The superseded invite can no longer redeem, even with its own code.\\n    await assert.rejects(services.joinHost({\\n      partyId, deviceId: \\\"p-host-old\\\", channelId: \\\"main\\\",\\n      inviteToken: first.inviteToken, pairingCode: first.pairingCode,\\n    }), (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    // The newest invite redeems normally.\\n    const joined = await services.joinHost({\\n      partyId, deviceId: \\\"p-host-new\\\", channelId: \\\"main\\\",\\n      inviteToken: second.inviteToken, pairingCode: second.pairingCode,\\n    });\\n    assert.equal(joined.created, true);\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"at most 3 active host devices per party; revocation frees capacity with an audit record\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const services = createHostJoinService({ db });\\n    const redeem = async (deviceId: string) => {\\n      const invite = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n      return services.joinHost({\\n        partyId, deviceId, channelId: \\\"main\\\",\\n        inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\\n      });\\n    };\\n    for (const deviceId of [\\\"p-host-1\\\", \\\"p-host-2\\\", \\\"p-host-3\\\"]) {\\n      const joined = await redeem(deviceId);\\n      assert.equal(joined.created, true);\\n    }\\n    // Fourth redemption is denied until a host is revoked.\\n    const fourth = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    await assert.rejects(services.joinHost({\\n      partyId, deviceId: \\\"p-host-4\\\", channelId: \\\"main\\\",\\n      inviteToken: fourth.inviteToken, pairingCode: fourth.pairingCode,\\n    }), (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-4`).get()).exists, false);\\n\\n    // TV-only revocation: guests and strangers cannot revoke.\\n    await assert.rejects(services.revokeHostDevice({ partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\", targetDeviceId: \\\"p-host-2\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    await assert.rejects(services.revokeHostDevice({ partyId, deviceId: \\\"nope\\\", channelId: \\\"main\\\", targetDeviceId: \\\"p-host-2\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n\\n    // The TV revokes one host: device demoted, audit record written.\\n    const revoked = await services.revokeHostDevice({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\", targetDeviceId: \\\"p-host-2\\\" });\\n    assert.deepEqual(revoked, { partyId, targetDeviceId: \\\"p-host-2\\\", status: \\\"revoked\\\" });\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-2`).get()).data()?.status, \\\"revoked\\\");\\n    const audits = await db.collection(`parties/${partyId}/hostAudit`).where(\\\"targetDeviceId\\\", \\\"==\\\", \\\"p-host-2\\\").get();\\n    assert.equal(audits.size, 1, \\\"revocation must write exactly one audit record\\\");\\n    assert.equal(audits.docs[0].data()?.action, \\\"revoke\\\");\\n    assert.equal(audits.docs[0].data()?.byDeviceId, \\\"tv-1\\\");\\n\\n    // The revoked host is denied on its next admin operation.\\n    await assert.rejects(assertRegisteredHostDevice(db, { partyId, deviceId: \\\"p-host-2\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n\\n    // Capacity freed: the fourth phone redeems with a fresh invite.\\n    const fifth = await services.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    const rejoined = await services.joinHost({\\n      partyId, deviceId: \\\"p-host-4\\\", channelId: \\\"main\\\",\\n      inviteToken: fifth.inviteToken, pairingCode: fifth.pairingCode,\\n    });\\n    assert.equal(rejoined.created, true);\\n    assert.equal(rejoined.role, \\\"host\\\");\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\\ntest(\\\"legacy joinParty remains guest-only and never upgrades host devices\\\", { skip: !HAS_FIRESTORE_EMULATOR }, async () => {\\n  const { app, db } = await createEmulatorContext();\\n  const partyId = randomPartyId();\\n  try {\\n    await seedTv(db, partyId, \\\"tv-1\\\", \\\"main\\\");\\n    const hosts = createHostJoinService({ db });\\n    const joinParty = createJoinPartyService({ db });\\n    const invite = await hosts.createHostInvite({ partyId, deviceId: \\\"tv-1\\\", channelId: \\\"main\\\" });\\n    await hosts.joinHost({\\n      partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\",\\n      inviteToken: invite.inviteToken, pairingCode: invite.pairingCode,\\n    });\\n    // A host device rejoining through the legacy path is rejected, not downgraded.\\n    await assert.rejects(joinParty.joinParty({ partyId, deviceId: \\\"p-host-1\\\", channelId: \\\"main\\\" }),\\n      (e: unknown) => e instanceof BackendError && e.errorCode === \\\"FORBIDDEN\\\");\\n    assert.equal((await db.doc(`parties/${partyId}/devices/p-host-1`).get()).data()?.role, \\\"host\\\");\\n    // Fresh legacy joins are still guests.\\n    const guest = await joinParty.joinParty({ partyId, deviceId: \\\"p-new-guest\\\", channelId: \\\"main\\\" });\\n    assert.equal(guest.role, \\\"guest\\\");\\n  } finally {\\n    await db.recursiveDelete(db.doc(`parties/${partyId}`)).catch(() => undefined);\\n    await disposeEmulatorContext(app);\\n  }\\n});\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/test/host_join.test.ts\"}"},"time":{"start":1793463843683,"end":1793463865539}}}}
