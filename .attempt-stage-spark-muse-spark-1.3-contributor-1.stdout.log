6:   if (joinPin != null) {\n97:     payload['joinPin'] = joinPin;\n98:   }\n99:   return jsonEncode(payload);\n100: }\n101: \n102: /// Failure reading the host guest-code listing.\n103: final class GuestCodeException implements Exception {\n104:   /// Creates a guest-code read failure.\n105:   const GuestCodeException(this.message);\n106: \n107:   /// Human-readable reason shown on the TV panel.\n108:   final String message;\n109: \n110:   @override\n111:   String toString() => 'GuestCodeException: $message';\n112: }\n113: \n114: /// Callable invoker seam: calls the named callable with the payload and\n115: /// returns the decoded response data. Production passes Cloud Functions;\n116: /// tests pass a fake.\n117: typedef CallableInvoker =\n118:     Future<Map<String, Object?>> Function(\n119:       String name,\n120:       Map<String, Object?> payload,\n121:     );\n122: \n123: /// Validated host-only session listing from `listPartyDevices`.\n124: ///\n125: /// Carries the authoritative session scope (`partyId`/`channelId`/\n126: /// `tvDeviceId`), the optional `joinPin` (string when configured, absent\n127: /// otherwise), and the guest device entries. PIN state always comes from\n128: /// this response, never from build-time config.\n129: final class GuestCodeListing {\n130:   /// Creates a validated listing.\n131:   const GuestCodeListing({\n132:     required this.partyId,\n133:     required this.channelId,\n134:     required this.tvDeviceId,\n135:     required this.devices,\n136:     this.joinPin,\n137:   });\n138: \n139:   /// Party the TV belongs to (must match the requesting client).\n140:   final String partyId;\n141: \n142:   /// Active channel (must match the requesting client).\n143:   final String channelId;\n144: \n145:   /// TV's own device id (must match the requesting client).\n146:   final String tvDeviceId;\n147: \n148:   /// Session PIN when configured; null means no PIN is required.\n149:   final String? joinPin;\n150: \n151:   /// Guest device