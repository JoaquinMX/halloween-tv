 if (widget.onBack != null)\n258:                             _PanelButton(\n259:                               actionKey: kHostCodeBackKey,\n260:                               label: 'BACK',\n261:                               focusNode: widget.primaryFocusNode,\n262:                               onPressed: widget.onBack!,\n263:                             ),\n264:                           if (widget.onBack != null) const SizedBox(height: 10),\n265:                           _PanelButton(\n266:                             actionKey: kHostCodeRefreshKey,\n267:                             label: 'REFRESH',\n268:                             focusNode: widget.onBack == null\n269:                                 ? widget.primaryFocusNode\n270:                                 : null,\n271:                             onPressed: () => unawaited(_refresh()),\n272:                           ),\n273:                           const SizedBox(height: 10),\n274:                           _PanelButton(\n275:                             actionKey: kHostCodeCloseKey,\n276:                             label: 'CLOSE',\n277:                             onPressed: widget.onClose,\n278:                           ),\n279:                         ],\n280:                       ),\n281:                     ),\n282:                   ],\n283:                 ),\n284:               ),\n285:             ),\n286:           ),\n287:         ),\n288:       ),\n289:     );\n290:   }\n291: \n292:   Widget _sessionLine() {\n293:     final HostInvite? invite = _invite;\n294:     if (invite == null) {\n295:       return Text(\n296:         'party ${widget.client.partyId} · ${widget.client.channelId}',\n297:         key: kHostCodeSessionKey,\n298:         style: const TextStyle(color: Colors.white70, fontSize: 18),\n299:       );\n300:     }\n301:     return Text(\n302:       'party ${invite.partyId} · ${invite.channelId} · '\n303:       'expires ${invite.expiresAt.toUtc().toIso8601String()}',\n304:       key: kHostCodeSessionKey,\n305:       style: const TextStyle(color: Colors.white70, fontSize: 18),\n306:     );\n307:   }\n308: \n309:   /// Exactly one QR while a live, unexpired invite exists; no fabricated\n310:   /// QR before the first successful mint, and the stale capability is\n311:   /// hidden the moment it lapses.\n312:   Widget _qrBox() {\n313:     final HostInvite? invite = _invite;\n314:     if (invite == null || _expired) {\n315:       return Container(\n316:         width: 204,\n317:         height: 204,\n318:         alignment: Alignment.center,\n319:         decoration: BoxDecoration(\n320:           border: Border.all(color: CctvTheme.frameEdge),\n321:         ),\n322:         child: Text(\n323:           _expired ? 'Invite expired — refresh.' : 'Waiting for invite…',\n324:           textAlign: TextAlign.center,\n325:           style: const TextStyle(color: Colors.white70, fontSize: 16),\n326:         ),\n327:       );\n328:     }\n329:     final String payload = buildHostJoinPayload(\n330:       partyId: invite.partyId,\n331:       channelId: invite.channelId,\n332:       inviteToken: invite.inviteToken,\n333:     );\n334:     return Container(\n335:       padding: const EdgeInsets.all(12),\n336:       color: Colors.white,\n337:       child: QrImageView(\n338:         key: kHostCodeQrKey,\n339:         data: payload,\n340:         semanticsLabel: payload,\n341:         size: 180,\n342:         backgroundColor: Colors.white,\n343:       ),\n344:     );\n345:   }\n346: \n347:   Widget _stateLine() {\n348:     if (!_firstFetchDone && _invite == null && _error == null) {\n349:       return const Text(\n350:         'Minting host invite…',\n351:         key: kHostCodeLoadingKey,\n352:         style: TextStyle(color: Colors.white70, fontSize: 22),\n353:       );\n354:     }\n355:     // First mint failed with nothing valid to show: error, no QR.\n356:     if (_invite == null && _error != null) {\n357:       return Text(\n358:         'Host invite unavailable: $_error',\n359:         key: kHostCodeErrorKey,\n360:         style: const TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n361:       );\n362:     }\n363:     if (_expired) {\n364:       return Column(\n365:         crossAxisAlignment: CrossAxisAlignment.start,\n366:         mainAxisSize: MainAxisSize.min,\n367:         children: <Widget>[\n368:           const Text(\n369:             'Invite expired — refresh for a new code.',\n370:             key: kHostCodeExpiryKey,\n371:             style: TextStyle(color: Color(0xFFFFC107), fontSize: 22),\n372:           ),\n373:           if (_error != null)\n374:             Padding(\n375:               padding: const EdgeInsets.only(top: 8),\n376:               child: Text(\n377:                 'Refresh failed: $_error — showing last invite.',\n378:                 key: kHostCodeErrorKey,\n379:                 style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n380:               ),\n381:             ),\n382:         ],\n383:       );\n384:     }\n385:     if (_error != null) {\n386:       return Text(\n387:         'Refresh failed: $_error — showing last invite.',\n388:         key: kHostCodeErrorKey,\n389:         style: const TextStyle(color: Color(0xFFFFC107), fontSize: 18),\n390:       );\n391:     }\n392:     return const SizedBox.shrink();\n393:   }\n394: }\n395: \n396: /// Large, TV-focusable panel action.\n397: class _PanelButton extends StatelessWidget {\n398:   const _PanelButton({\n399:     required this.actionKey,\n400:     required this.label,\n401:     required this.onPressed,\n402:     this.focusNode,\n403:   });\n404: \n405:   final Key actionKey;\n406:   final String label;\n407:   final VoidCallback onPressed;\n408:   final FocusNode? focusNode;\n409: \n410:   @override\n411:   Widget build(BuildContext context) {\n412:     return OutlinedButton(\n413:       key: actionKey,\n414:       focusNode: focusNode,\n415:       onPressed: onPressed,\n416:       style: OutlinedButt