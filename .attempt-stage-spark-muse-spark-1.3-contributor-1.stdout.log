   const jobs = await db.collection(`parties/${identity.partyId}/jobs`).where(\"guestMedia.submissionId\", \"==\", submissionId).get();\n402:     const boundJobIds: string[] = [];\n403:     for (const jobDoc of jobs.docs) {\n404:       boundJobIds.push(jobDoc.id);\n405:       const job = jobDoc.data() as Record<string, unknown>;\n406:       const staged = (job.stagedOutputs && typeof job.stagedOutputs === \"object\" ? job.stagedOutputs : {}) as Record<string, unknown>;\n407:       for (const clip of Object.values(staged)) {\n408:         if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n409:           const path = (clip as Record<string, unknown>).objectPath as string;\n410:           if (path.startsWith(\"parties/\")) attributable.add(path);\n411:         }\n412:       }\n413:       for (const key of [\"deliveryPaths\", \"generatedPaths\"] as const) {\n414:         const list = job[key];\n415:         if (Array.isArray(list)) for (const item of list) if (typeof item === \"string\" && item.startsWith(\"parties/\")) attributable.add(item);\n416:       }\n417:     }\n418:     // Published manifest clips attributable to a bound job are deliverable\n419:     // until revoked: collect them here and delete the manifest doc below.\n420:     let revokedManifestPaths: string[] = [];\n421:     try {\n422:       const currentRef = db.doc(`parties/${identity.partyId}/manifests/current_${identity.channelId}`);\n423:       const current = await currentRef.get();\n424:       if (current.exists) {\n425:         const manifest = current.data() as Record<string, unknown>;\n426:         if (typeof manifest.jobId === \"string\" && boundJobIds.includes(manifest.jobId)) {\n427:           const clips = manifest.cameraClips;\n428:           if (Array.isArray(clips)) {\n429:             for (const clip of clips) {\n430:               if (clip && typeof clip === \"object\" && typeof (clip as Record<string, unknown>).objectPath === \"string\") {\n431:                 const path = (clip as Record<string, unknown>).objectPath as string;\n432:                 if (path.startsWith(\"parties/\")) {\n433:                   attributable.add(path);\n434:                   revokedManifestPaths.push(path);\n435:                 }\n436:               }\n437:             }\n438:           }\n439:         }\n440:       }\n441:     } catch {\n442:       revokedManifestPaths = [...attributable].filter((p) => p.includes(\"/delivery/\"));\n443:     }\n444:     const deletedObjects: string[] = [];\n445:     const pendingDeletions: string[] = [];\n446:     for (const path of attributable) {\n447:       try {\n448:         await deleteWithRetry(deleteObject, bucket.file(path));\n449:         deletedObjects.push(path);\n450:       } catch {\n451:         // Persisted below for the sweeper; verifiedAbsent stays false until\n452:         // every attributable object is confirmed absent.\n453:         pendingDeletions.push(path);\n454:       }\n455:     }\n456:     // Fail bound jobs closed with budget-pointer release (same semantics as\n457:     // the worker-side failForWithdrawnConsent path).\n458:     const budgetRef = db.doc(`parties/${identity.partyId}/generationBudget/active`);\n459:     for (const jobDoc of jobs.docs) {\n460:       const job = jobDoc.data() as Record<string, unknown>;\n461:       if ([\"failed\", \"purged\", \"expired\"].includes(String(job.state))) {\n462:         await db.runTransaction(async (transaction) => {\n463:           const budget = await transaction.get(budgetRef);\n464:           if (budget.exists && budget.data()?.activeJobId === jobDoc.id) {\n465:             transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n466:           }\n467:         }).catch(() => undefined);\n468:         continue;\n469:       }\n470:       await db.runTransaction(async (transaction) => {\n471:         const [current, budget] = await Promise.all([transaction.get(jobDoc.ref), transaction.get(budgetRef)]);\n472:         if (!current.exists) return;\n473:         transaction.update(jobDoc.ref, {\n474:           state: \"failed\",\n475:           status: \"failed\",\n476:           errorCode: \"FORBIDDEN\",\n477:           reconciliationReason: \"GUEST_CONSENT_WITHDRAWN\",\n478:           failedAt: FieldValue.serverTimestamp(),\n479:           timestamp: FieldValue.serverTimestamp(),\n480:           workerLeaseUntilMs: 0,\n481:         });\n482:         if (budget.exists && budget.data()?.activeJobId === jobDoc.id) {\n483:           transaction.update(budgetRef, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n484:         }\n485:       }).catch(() => undefined);\n486:     }\n487:     // Revoke the deliverable manifest after its bytes are deleted.\n488:     try {\n489:       const currentRef = db.doc(`parties/${identity.partyId}/manifests/current_${identity.channelId}`);\n490:       const current = await currentRef.get();\n491:       if (current.exists) {\n492:         const manifest = current.data() as Record<string, unknown>;\n493:         if (typeof manifest.jobId === \"string\" && boundJobIds.includes(manifest.jobId)) {\n494:           await currentRef.delete().catch(() => undefined);\n495:         }\n496:       }\n497:     } catch {\n498:       // Revocation best-effort: delivery paths additionally refuse withdrawn\n499:       // bindings, and retention retries revoked-manifest objects.\n500:     }\n501:     // verifiedAbsent ONLY after every attributable object (source + staged +\n502:     // delivered + generated) is confirmed absent.\n503:     let verifiedAbsent = pendingDeletions.length === 0;\n504:     if (verifiedAbsent) {\n505:       for (const path of attributable) {\n506:         try {\n507:           const [stillExists] = await bucket.file(path).exists();\n508:           if (stillExists) {\n509:             verifiedAbsent = false;\n510:             pendingDeletions.push(path);\n511:           }\n512:         } catch {\n513:           verifiedAbsent = false;\n514:           pendingDeletions.push(path);\n515:         }\n516:       }\n517:     }\n518:     // Order the source first for stable assertions, without duplicating it.\n519:     const orderedDeleted = [\n520:       ...(deletedObjects.includes(objectPath) ? [objectPath] : []),\n521:       ...deletedObjects.filter((p) => p !== objectPath),\n522:     ];\n523:     await ref.update({\n524:       pendingDeletions,\n525:       revokedManifestPaths,\n526:       updatedAt: FieldValue.serverTimestamp(),\n527:     }).catch(() => undefined);\n528:     return { submissionId, status: \"withdrawn\", deletedObjects: orderedDeleted, verifiedAbsent };\n529:   }\n530: \n531:   /**\n532:    * Object-finalization cleanup: a PUT after withdrawal must not restore\n533:    * eligibility and is deleted. Pending uploads are left alone; explicit\n534:    * completion validates bytes before any eligibility change.\n535:    */\n536:   async function handleIngestFinalized(objectPath: string): Promise<{ handled: boolean; deleted: boolean }> {\n537:     const parsed = parseGuestObjectPath(objectPath);\n538:     if (!parsed) return { handled: false, deleted: false };\n539:     const snapshot = await guestMediaRef(db, parsed.partyId, parsed.submissionId).get();\n540:     if (!snapshot.exists) {\n541:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n542:       return { handled: true, deleted: true };\n543:     }\n544:     const doc = snapshot.data() as GuestMediaDoc;\n545:     if (doc.deviceId !== parsed.deviceId || doc.partyId !== parsed.partyId) {\n546:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n547:       return { handled: true, deleted: true };\n548:     }\n549:     if (doc.status === \"withdrawn\" || doc.status === \"expired\") {\n550:       await deleteWithRetry(deleteObject, bucket.file(objectPath));\n551:       const [stillExists] = await bucket.file(objectPath).exists();\n552:       if (stillExists) throw new BackendError(\"INTERNAL\", \"Withdrawn guest object could not be removed.\");\n553:       return { handled: true, deleted: true };\n554:     }\n555:     return { handled: true, deleted: false };\n556:   }\n557: \n558:   return { requestGuestUpload, completeGuestUpload, getGuestMediaStatus, withdrawGuestMedia, handleIngestFinalized };\n559: }\n560: \n561: export type GuestUploadServices = ReturnType<typeof createGuestUploadService>;"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a1929afe317117a64fd95f8c287ea4"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/part-1/backend/functions/src/guest_upload.ts\"}"},"time":{"start":1793460993821,"end":1793460993850}}}}
