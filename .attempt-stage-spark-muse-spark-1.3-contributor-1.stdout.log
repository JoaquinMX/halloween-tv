{"type":"tool_use","timestamp":1793461691143,"sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","part":{"partID":"prt_192a59eb0001sh0etNyRbgCG8T","sessionID":"ses_e6d5a7eaaffeH1wroUP5Ck5Yd2","messageID":"msg_192a594c2001AZEQpUWfLaOmMw","type":"tool","id":"call_01a192a59c4b76499364bbb5876d677c","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_code_panel.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/part-2/apps/tv_app/lib/src/wall/guest_code_panel.dart, lines 1-442\n1: /// Host-visible party code panel (D-pad settings overlay page).\n2: ///\n3: /// Shows the TV's own party/device code as large text, exactly one QR\n4: /// encoding the authoritative anonymous session payload (opaque identifiers\n5: /// only — never URLs, device ids, or secrets), and the joined guest device\n6: /// list. The session (scope + optional PIN) always comes from the host-only\n7: /// `listPartyDevices` response via [GuestCodeClient]; nothing is fabricated\n8: /// from build-time config.\n9: ///\n10: /// Refresh: one fetch immediately on open plus a bounded periodic refresh\n11: /// while visible. Overlapping requests are skipped, timers are cancelled on\n12: /// disposal, and late responses after disposal are ignored. The last valid\n13: /// session QR is retained across later refresh failures.\n14: library;\n15: \n16: import 'dart:async';\n17: \n18: import 'package:core_ui/core_ui.dart';\n19: import 'package:flutter/material.dart';\n20: import 'package:flutter/services.dart';\n21: import 'package:qr_flutter/qr_flutter.dart';\n22: \n23: import 'package:tv_app/src/wall/guest_codes.dart';\n24: \n25: /// Key of the guest code panel.\n26: const Key kGuestCodePanelKey = ValueKey<String>('guest-code-panel');\n27: \n28: /// Key of the guest-code close button.\n29: const Key kGuestCodeCloseKey = ValueKey<String>('guest-code-close');\n30: \n31: /// Key of the guest-code back button (returns to the recovery actions).\n32: const Key kGuestCodeBackKey = ValueKey<String>('guest-code-back');\n33: \n34: /// Key of the single session QR (present only after authoritative data).\n35: const Key kGuestCodeQrKey = ValueKey<String>('guest-code-qr');\n36: \n37: /// Key of the session scope/PIN line.\n38: const Key kGuestCodeSessionKey = ValueKey<String>('guest-code-session');\n39: \n40: /// Key of the guest list body.\n41: const Key kGuestCodeListKey = ValueKey<String>('guest-code-list');\n42: \n43: /// Key of the loading indicator text.\n44: const Key kGuestCodeLoadingKey = ValueKey<String>('guest-code-loading');\n45: \n46: /// Key of the error text.\n47: const Key kGuestCodeErrorKey = ValueKey<String>('guest-code-error');\n48: \n49: /// Key of the empty-list text.\n50: const Key kGuestCodeEmptyKey = ValueKey<String>('guest-code-empty');\n51: \n52: /// Default bounded refresh interval while the panel is visible.\n53: const Duration kGuestCodeRefreshInterval = Duration(seconds: 10);\n54: \n55: /// Bounds a single listing fetch: without this, a hung callable would hold\n56: /// `_fetching` true forever and wedge the panel (no retries, stale rows).\n57: const Duration kGuestCodeFetchTimeout = Duration(seconds: 10);\n58: \n59: /// Host panel: TV code (large text + session QR) and the guest list.\n60: ///\n61: /// Owns its listing refresh: fetches immediately on open and re-fetches on\n62: /// [refreshInterval] while mounted. Pass a fake [GuestCodeClient.invoker] in\n63: /// widget tests; production passes the real Cloud Functions client.\n64: class GuestCodePanel extends StatefulWidget {\n65:   /// Creates the host code panel.\n66:   const GuestCodePanel({\n67:     super.key,\n68:     required this.client,\n69:     required this.tvDeviceId,\n70:     required this.onClose,\n71:     this.onBack,\n72:     this.primaryFocusNode,\n73:     this.refreshInterval = kGuestCodeRefreshInterval,\n74:   });\n75: \n76:   /// Host-only listing reader (authorization carries the TV's device id).\n77:   