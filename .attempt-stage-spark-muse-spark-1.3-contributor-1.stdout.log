{"type":"tool_use","timestamp":1793463656773,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c39bd9001UTOR4KWhl3DDJ0","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c392e80013tGAvwuHSYI5uY","type":"tool","id":"call_01a192c39bb4709d92483b0621e09dab","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart, lines 1-101\n1: // On-device camera join regression (physical Pixel, manual run).\n2: //\n3: // Run (from apps/companion_app, release + live defines, permission\n4: // pre-granted so no OS dialog blocks the run):\n5: //\n6: //   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n7: //   flutter test integration_test/camera_join_scan_device_test.dart \\\n8: //     --dart-define=COMPANION_FIREBASE_API_KEY=... \\\n9: //     --dart-define=COMPANION_FIREBASE_APP_ID=... \\\n10: //     --dart-define=COMPANION_FIREBASE_PROJECT_ID=halloween-tv \\\n11: //     --dart-define=COMPANION_FUNCTIONS_REGION=us-central1\n12: //\n13: // What it proves on hardware: the shipped join screen pushes the real\n14: // QrScanScreen and the native camera preview initializes (no black stall\n15: // after the permission grant), cancellation returns to a usable join form,\n16: // and the type-or-paste path still joins. Aiming the camera at a real\n17: // party QR and reaching the lineup is covered by the manual written\n18: // procedure in docs/COMPANION-CAMERA-PROOF.md (human aims the camera;\n19: // automation cannot point the lens).\n20: //\n21: // Live paste-join runs only when DEVICE_PARTY_ID/DEVICE_CHANNEL_ID are\n22: // supplied; otherwise it reports the skip. It registers one guest device\n23: // against the seeded rehearsal party (same cost class as the typed manual\n24: // join in rehearsal NOTES — no generation, no spend).\n25: library;\n26: \n27: import 'package:companion_app/src/companion_app.dart';\n28: import 'package:companion_app/src/join/qr_scan_screen.dart';\n29: import 'package:companion_app/src/ui/host_entry_screen.dart';\n30: import 'package:companion_app/src/ui/join_screen.dart';\n31: import 'package:flutter_test/flutter_test.dart';\n32: import 'package:integration_test/integration_test.dart';\n33: import 'package:shared_preferences/shared_preferences.dart';\n34: \n35: const String _devicePartyId = String.fromEnvironment('DEVICE_PARTY_ID');\n36: const String _deviceChannelId = String.fromEnvironment('DEVICE_CHANNEL_ID');\n37: \n38: Future<void> _settle(WidgetTester tester) async {\n39:   for (int i = 0; i < 12; i++) {\n40:     await tester.pump(const Duration(milliseconds: 250));\n41:   }\n42: }\n43: \n44: void main() {\n45:   IntegrationTestWidgetsFlutterBinding.ensureInitialized();\n46: \n47:   testWidgets('device: granted camera opens the live scanner', (tester) async {\n48:     SharedPreferences.setMockInitialValues(<String, Object>{});\n49:     await tester.pumpWidget(const CompanionApp());\n50:     await _settle(tester);\n51:     // Host-first boot: take the explicit guest route before scanning.\n52:     expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n53:     await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\n54:     await _settle(tester);\n55:     expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n56: \n57:     await tester.ensureVisible(find.byKey(JoinScreen.scanKey));\n58:     await tester.pump(const Duration(milliseconds: 250));\n59:     await tester.tap(find.byKey(JoinScreen.scanKey));\n60:     await _settle(tester);\n61: \n62:     // The real scan screen is up (camera preview initializes on device;\n63:     // a post-grant stall would leave the join screen showing instead).\n64:     expect(find.byType(QrScanScreen), findsOneWidget);\n65:     expect(find.byKey(QrScanScreen.scannerKey), findsOneWidget);\n66: \n67:     await tester.tap(find.byKey(QrScanScreen.closeKey));\n68:     await _settle(tester);\n69:     expect(find.byType(QrScanScreen), findsNothing);\n70:     expect(find.byKey(JoinScreen.scanKey), findsOneWidget);\n71:   });\n72: \n73:   testWidgets('device: pasted join data joins the seeded party', (\n74:     tester,\n75:   ) async {\n76:     if (_devicePartyId.isEmpty || _deviceChannelId.isEmpty) {\n77:       // ignore: avoid_print\n78:       print(\n79:         'SKIP live join: pass --dart-define=DEVICE_PARTY_ID=... '\n80:         'DEVICE_CHANNEL_ID=... (see docs/COMPANION-CAMERA-PROOF.md).',\n81:       );\n82:       return;\n83:     }\n84:     SharedPreferences.setMockInitialValues(<String, Object>{});\n85:     await tester.pumpWidget(const CompanionApp());\n86:     await _settle(tester);\n87:     await tester.tap(find.byKey(HostEntryScreen.joinAsGuestKey));\n88:     await _settle(tester);\n89: \n90:     await tester.enterText(\n91:       find.byKey(JoinScreen.payloadFieldKey),\n92:       '{\"partyId\":\"$_devicePartyId\",\"channelId\":\"$_deviceChannelId\"}',\n93:     );\n94:     await tester.ensureVisible(find.byKey(JoinScreen.submitKey));\n95:     await tester.pump(const Duration(milliseconds: 250));\n96:     await tester.tap(find.byKey(JoinScreen.submitKey));\n97:     await _settle(tester);\n98: \n99:     expect(find.textContaining('Manifest version'), findsOneWidget);\n100:   });\n101: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/companion_app/integration_test/camera_join_scan_device_test.dart, lines 1-101\n1: // On-device camera join regression (physical Pixel, manual run).\n2: //\n3: // Run (from apps/companion_app, release + live defines, permission\n4: // pre-granted so no OS dialog blocks the run):\n5: //\n6: //   adb -s <serial> shell pm grant <package> android.permission.CAMERA\n7: //   flutter test integration_test/came