Id: task.partyId, deviceId: task.deviceId, channelId: task.channelId };\n277:     await assertRegisteredPartyDevice(db, identity);\n278:     const ref = jobRef(db, task.partyId, task.jobId);\n279:     const claimed = await db.runTransaction(async (transaction) => {\n280:       const snapshot = await transaction.get(ref);\n281:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n282:       const job = snapshot.data()!;\n283:       if (job.idempotencyKey !== task.idempotencyKey || job.deviceId !== task.deviceId || job.channelId !== task.channelId) {\n284:         throw new BackendError(\"FORBIDDEN\", \"Task identity does not match the job.\");\n285:       }\n286:       if (job.state !== \"queued\") return { run: false, state: String(job.state), job };\n287:       transaction.update(ref, { state: \"running\", startedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });\n288:       return { run: true, state: \"running\", job };\n289:     });\n290:     if (!claimed.run) return { jobId: task.jobId, state: claimed.state };\n291:     try {\n292:       await generationRunner(claimed.job);\n293:     } catch (error) {\n294:       const errorCode = error instanceof BackendError ? error.errorCode : \"PROVIDER_UNAVAILABLE\";\n295:       await db.runTransaction(async (transaction) => {\n296:         transaction.update(ref, { state: \"failed\", errorCode, failedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });\n297:         transaction.update(costLogRef(db, task.partyId, task.jobId), { success: false, errorCode });\n298:       });\n299:       throw new BackendError(errorCode, \"Generation did not complete.\");\n300:     }\n301:     return { jobId: task.jobId, state: \"running\" };\n302:   }\n303: \n304:   async function normalizeAndStage(jobId: string, inputs: GeneratedClipInput[]): Promise<DeliveryManifest> {\n305:     const validJobId = jobId;\n306:     const matching = await db.collectionGroup(\"jobs\").where(\"jobId\", \"==\", validJobId).limit(1).get();\n307:     if (matching.empty) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n308:     const jobDocument = matching.docs[0];\n309:     const job = jobDocument.data();\n310:     if (job.state !== \"running\") throw new BackendError(\"MANIFEST_MISMATCH\", \"Only a running job can stage generated media.\");\n311:     const { partyId, channelId } = job as { partyId: string; channelId: string };\n312:     if (!Array.isArray(inputs) || inputs.length !== REQUIRED_CAMERA_IDS.length) {\n313:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staging requires the four canonical camera clips.\");\n314:     }\n315:     const byCamera = new Map(inputs.map((clip) => [clip.cameraId, clip]));\n316:     if (byCamera.size !== inputs.length || REQUIRED_CAMERA_IDS.some((id) => !byCamera.has(id))) {\n317:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Staging camera set is invalid.\");\n318:     }\n319:     const version = Number(job.manifestVersion ?? 0) + 1;\n320:     const expiresAt = new Date(now().getTime() + MEDIA_RETENTION_MS).toISOString();\n321:     const canonical: CanonicalClip[] = [];\n322:     for (const cameraId of REQUIRED_CAMERA_IDS) {\n323:       const input = byCamera.get(cameraId)!;\n324:       const generatedPrefix = `parties/${partyId}/generated/${validJobId}/`;\n325:       if (!input.sourcePath.startsWith(generatedPrefix) || input.sourcePath.includes(\"..\") || input.sourcePath.includes(\"\\\\\")) {\n326:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Generated media source path is outside its job scope.\");\n327:       }\n328:       if (input.durationMs !== 2000 || !/^[a-f0-9]{64}$/.test(input.sha256)) {\n329:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Generated clip metadata is invalid.\");\n330:       }\n331:       const source = bucket.file(input.sourcePath);\n332:       const [contents] = await source.download();\n333:       const actualHash = createHash(\"sha256\").update(contents).digest(\"hex\");\n334:       if (actualHash !== input.sha256 || contents.byteLength !== input.sizeBytes) {\n335:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Generated clip content does not match its metadata.\");\n336:       }\n337:       const objectPath = deliveryObjectPath(partyId, channelId, version, cameraId);\n338:       const destination = bucket.file(objectPath);\n339:       await source.copy(destination);\n340:       await destination.setMetadata({\n341:         contentType: \"video/mp4\",\n342:         customTime: expiresAt,\n343:         metadata: { expiresAt, jobId: validJobId, partyId, channelId, cameraId, purpose: \"delivery\" },\n344:       });\n345:       canonical.push({ cameraId, objectPath, sha256: actualHash, sizeBytes: contents.byteLength, durationMs: 2000, expiresAt });\n346:     }\n347:     const staged: DeliveryManifest = {\n348:       partyId,\n349:       channelId,\n350:       version,\n351:       schemaVersion: SCHEMA_VERSION,\n352:       jobId: validJobId,\n353:       cameraClips: canonical,\n354:       expiresAt,\n355:     };\n356:     validateCanonicalClips(staged.cameraClips);\n357:     await jobDocument.ref.update({ stagedManifest: staged, deliveryPaths: canonical.map((clip) => clip.objectPath), stagedAt: FieldValue.serverTimestamp() });\n358:     return staged;\n359:   }\n360: \n361:   async function publishManifest(jobId: string, idempotencyKey: string): Promise<DeliveryManifest> {\n362:     const matching = await db.collectionGroup(\"jobs\").where(\"jobId\", \"==\", jobId).limit(1).get();\n363:     if (matching.empty) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n364:     const ref = matching.docs[0].ref;\n365:     return db.runTransaction(async (transaction) => {\n366:       const jobSnapshot = await transaction.get(ref);\n367:       const job = jobSnapshot.data();\n368:       if (!job || job.idempotencyKey !== idempotencyKey) throw new BackendError(\"FORBIDDEN\", \"Publish idempotency key does not match the job.\");\n369:       if (job.publishedManifest) return job.publishedManifest as DeliveryManifest;\n370:       const staged = manifestFrom(job.stagedManifest);\n371:       const currentRef = manifestRef(db, job.partyId, job.channelId);\n372:       const currentSnapshot = await transaction.get(currentRef);\n373:       const currentVersion = currentSnapshot.exists ? Number(currentSnapshot.data()?.version ?? 0) : 0;\n374:       if (currentVersion !== Number(job.manifestVersion ?? 0)) {\n375:         throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest changed while this job was running.\");\n376:       }\n377:       const published: DeliveryManifest = { ...staged, createdAt: FieldValue.serverTimestamp() };\n378:       transaction.set(currentRef, published);\n379:       transaction.update(ref, {\n380:         state: \"ready\",\n381:         manifestVersion: staged.version,\n382:         publishedManifest: staged,\n383:         readyAt: FieldValue.serverTimestamp(),\n384:         timestamp: FieldValue.serverTimestamp(),\n385:       });\n386:       transaction.update(costLogRef(db, job.partyId, jobId), { manifestVersion: staged.version });\n387:       return published;\n388:     });\n389:   }\n390: \n391:   async function getDeliveryUrls(value: unknown) {\n392:     const identity = requireIdentity(value);\n393:     if (!identity.channelId) throw new BackendError(\"INVALID_ARGUMENT\", \"channelId is required.\");\n394:     const registered = await assertRegisteredPartyDevice(db, identity);\n395:     const snapshot = await manifestRef(db, registered.partyId, registered.channelId).get();\n396:     const manifest = manifestFrom(snapshot.data());\n397:     await assertManifestConsentLive(db, registered.partyId, manifest.jobId);\n398:     const nowMs = now().getTime();\n399:     const manifestExpiry = Date.parse(manifest.expiresAt);\n400:     if (!Number.isFinite(manifestExpiry) || manifestExpiry <= nowMs) throw new BackendError(\"CLIP_EXPIRED\", \"Current manifest has expired.\");\n401:     const manifestHash = canonicalManifestHash(manifest);\n402:     const clips = await Promise.all(manifest.cameraClips.map(async (clip) => {\n403:       validateDeliveryPath(clip, manifest.partyId, manifest.channelId, manifest.version);\n404:       const clipExpiry = Date.parse(clip.expiresAt);\n405:       if (!Number.isFinite(clipExpiry) || clipExpiry <= nowMs) throw new BackendError(\"CLIP_EXPIRED\", \"A canonical camera clip has expired.\");\n406:       const expiresAt = new Date(Math.min(nowMs + DELIVERY_URL_TTL_SECONDS * 1000, clipExpiry));\n407:       return {\n408:         cameraId: clip.cameraId,\n409:         sha256: clip.sha256,\n410:         url: await signReadUrl(bucket.file(clip.objectPath), expiresAt),\n411:         expiresAt: expiresAt.toISOString(),\n412:       };\n413:     }));\n414:     return { manifestVersion: manifest.version, manifestHash, clips };\n415:   }\n416: \n417:   async function getCurrentManifest(value: unknown): Promise<SerializedDeliveryManifest> {\n418:     const input: CurrentManifestInput = parseCurrentManifestInput(value);\n419:     const registered = await assertRegisteredPartyDevice(db, input);\n420:     if (registered.channel.status !== \"active\") throw new BackendError(\"FORBIDDEN\", \"Channel is not active for this party.\");\n421:     const snapshot = await manifestRef(db, registered.partyId, registered.channelId).get();\n422:     if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Current manifest does not exist.\");\n423:     const manifest = manifestFrom(snapshot.data());\n424:     await assertManifestConsentLive(db, registered.partyId, manifest.jobId);\n425:     if (manifest.partyId !== registered.partyId || manifest.channelId !== registered.channelId) {\n426:       throw new BackendError(\"MANIFEST_MISMATCH\", \"Current manifest is outside the registered party and channel.\");\n427:     }\n428:     const currentTimeMs = now().getTime();\n429:     if (Date.parse(manifest.expiresAt) <= currentTimeMs ||\n430:         manifest.cameraClips.some((clip) => Date.parse(clip.expiresAt) <= currentTimeMs)) {\n431:       throw new BackendError(\"CLIP_EXPIRED\", \"Current manifest has expired.\");\n432:     }\n433:     return serializeManifest(manifest);\n434:   }\n435: \n436:   async function acknowledgeDelivery(value: unknown) {\n437:     const ack = parseAck(value);\n438:     await assertRegisteredPartyDevice(db, ack);\n439:     const mRef = manifestRef(db, ack.partyId, ack.channelId);\n440:     const idem = ackIdempotencyKey(ack.deviceId, ack.channelId, ack.manifestVersion);\n441:     const ackId = idem;\n442:     const ackRef = db.doc(`parties/${ack.partyId}/deliveryAcks/${ackId}`);\n443:     const accepted = await db.runTransaction(async (transaction) => {\n444:       const existing = await transaction.get(ackRef);\n445:       if (existing.exists) return validateAcceptedAck(existing.data(), ack, ackId, idem);\n446: \n447:       const current = await transaction.get(mRef);\n448:       const manifest = manifestFrom(current.data());\n449:       canonicalClipsMatch(manifest, ack);\n450:       const currentTime = now().getTime();\n451:       if (Date.parse(manifest.expiresAt) <= currentTime || manifest.cameraClips.some((clip) => Date.parse(clip.expiresAt) <= currentTime)) {\n452:         throw new BackendError(\"CLIP_EXPIRED\", \"Cannot acknowledge an expired manifest.\");\n453:       }\n454:       const relatedJobRef = jobRef(db, ack.partyId, manifest.jobId);\n455:       const relatedJob = await transaction.get(relatedJobRef);\n456:       const acceptedAck = {\n457:         ackId,\n458:         partyId: ack.partyId,\n459:         deviceId: ack.deviceId,\n460:         channelId: ack.channelId,\n461:         manifestVersion: ack.manifestVersion,\n462:         manifestHash: canonicalManifestHash(manifest),\n463:         clipHashes: ack.clipHashes,\n464:         jobId: manifest.jobId,\n465:         clips: manifest.cameraClips.map(({ cameraId, objectPath, sha256 }) => ({ cameraId, objectPath, sha256 })),\n466:         timestamp: FieldValue.serverTimestamp(),\n467:         idempotencyKey: idem,\n468:       };\n469:       transaction.create(ackRef, acceptedAck);\n470:       if (relatedJob.exists && [\"ready\", \"delivering\"].includes(String(relatedJob.data()?.state))) {\n471:         transaction.update(relatedJobRef, { state: \"delivering\", deliveryAckId: ackId, timestamp: FieldValue.serverTimestamp() });\n472:       }\n473:       return validateAcceptedAck(acceptedAck, ack, ackId, idem);\n474:     });\n475:     const relatedJobRef = jobRef(db, ack.partyId, accepted.jobId);\n476:     // ACK is idempotent. Repeating it safely retries object deletion after partial failures.\n477:     await Promise.all(accepted.clips.map((clip) => deleteDeliveryObject(bucket.file(clip.objectPath))));\n478:     await db.runTransaction(async (transaction) => {\n479:       const relatedJob = await transaction.get(relatedJobRef);\n480:       if (relatedJob.exists && relatedJob.data()?.deliveryAckId === ackId) {\n481:         transaction.update(relatedJobRef, { state: \"purged\", purgedAt: FieldValue.serverTimestamp(), timestamp: FieldValue.serverTimestamp() });\n482:       }\n483:     });\n484:     return { ackId, manifestVersion: ack.manifestVersion, purged: true };\n485:   }\n486: \n487:   return { requestGeneration, runGeneration, normalizeAndStage, publishManifest, getCurrentManifest, getDeliveryUrls, acknowledgeDelivery };\n488: }\n489: \n490: interface AcceptedAckClip {\n491:   cameraId: (typeof REQUIRED_CAMERA_IDS)[number];\n492:   objectPath: string;\n493:   sha256: string;\n494: }\n495: \n496: interface ValidatedAcceptedAck {\n497:   jobId: string;\n498:   clips: AcceptedAckClip[];\n499: }\n500: \n501: function validateAcceptedAck(\n502:   value: FirebaseFirestore.DocumentData | Record<string, unknown> | undefined,\n503:   ack: AckInput,\n504:   ackId: st