task.partyId);\n298:     await this.db.runTransaction(async (transaction) => {\n299:       const [snapshot, budgetSnapshot] = await Promise.all([transaction.get(ref), transaction.get(budget)]);\n300:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n301:       const job = snapshot.data()!;\n302:       if (job.idempotencyKey !== task.idempotencyKey || job.deviceId !== task.deviceId || job.channelId !== task.channelId) {\n303:         throw new BackendError(\"FORBIDDEN\", \"Task identity does not match the job.\");\n304:       }\n305:       const timestamp = FieldValue.serverTimestamp();\n306:       if (job.state === \"queued\") {\n307:         transaction.update(ref, {\n308:           state: \"failed\",\n309:           status: \"failed\",\n310:           errorCode: \"PROVIDER_UNAVAILABLE\",\n311:           enqueueFailedAt: timestamp,\n312:           failedAt: timestamp,\n313:           timestamp,\n314:         });\n315:         if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === task.jobId) {\n316:           transaction.update(budget, { activeJobId: null, state: \"idle\", updatedAt: timestamp });\n317:         }\n318:       } else {\n319:         // A queue response can be lost after acceptance. Preserve a worker that\n320:         // already claimed the job, while keeping the ambiguous enqueue visible.\n321:         transaction.update(ref, { enqueueErrorCode: \"PROVIDER_UNAVAILABLE\", enqueueFailedAt: timestamp, timestamp });\n322:       }\n323:     });\n324:   }\n325: \n326:   async claimWorker(task: GenerationTask, leaseMs = 20 * 60 * 1000): Promise<{ claimed: boolean; job: FirebaseFirestore.DocumentData }> {\n327:     const ref = jobRef(this.db, task.partyId, task.jobId);\n328:     return this.db.runTransaction(async (transaction) => {\n329:       const snapshot = await transaction.get(ref);\n330:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n331:       const job = snapshot.data()!;\n332:       if (job.idempotencyKey !== task.idempotencyKey || job.deviceId !== task.deviceId || job.channelId !== task.channelId) {\n333:         throw new BackendError(\"FORBIDDEN\", \"Worker identity does not match the job.\");\n334:       }\n335:       if ([\"ready\", \"delivering\", \"failed\", \"expired\", \"purged\"].includes(String(job.state))) return { claimed: false, job }; // delivering is terminal for the worker: the ACK path owns the job from here.\n336:       const leaseUntil = Number(job.workerLeaseUntilMs ?? 0);\n337:       if (job.state === \"running\" && leaseUntil > this.now().getTime()) return { claimed: false, job };\n338:       const next = this.now().getTime() + leaseMs;\n339:       transaction.update(ref, {\n340:         state: \"running\",\n341:         status: \"running\",\n342:         workerLeaseUntilMs: next,\n343:         startedAt: job.startedAt ?? FieldValue.serverTimestamp(),\n344:         timestamp: FieldValue.serverTimestamp(),\n345:       });\n346:       return { claimed: true, job: { ...job, state: \"running\", workerLeaseUntilMs: next } };\n347:     });\n348:   }\n349: \n350:   async heartbeat(partyId: string, jobId: string, leaseMs = 20 * 60 * 1000): Promise<void> {\n351:     await jobRef(this.db, partyId, jobId).update({ workerLeaseUntilMs: this.now().getTime() + leaseMs, timestamp: FieldValue.serverTimestamp() });\n352:   }\n353: \n354:   async beginSubmission(partyId: string, jobId: string, cameraId: CameraId): Promise<boolean> {\n355:     const ref = jobRef(this.db, partyId, jobId);\n356:     return this.db.runTransaction(async (transaction) => {\n357:       const snapshot = await transaction.get(ref);\n358:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n359:       const job = snapshot.data()!;\n360:       const task = (job.providerTasks ?? {})[cameraId] as Record<string, unknown> | undefined;\n361:       if (typeof task?.taskId === \"string\") return false;\n362:       const attempts = { ...(job.cameraAttempts ?? {}) } as Record<string, Record<string, unknown>>;\n363:       const attempt = attempts[cameraId] ?? {};\n364:       if (attempt.consumedAttempt === true) {\n365:         if (attempt.submissionState === \"submitting\") {\n366:           throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider submission outcome is unknown; automatic resubmission is disabled.\");\n367:         }\n368:         throw new BackendError(\"PROVIDER_UNAVAILABLE\", \"Provider submission attempt has already been consumed.\");\n369:       }\n370:       attempts[cameraId] = {\n371:         ...attempt,\n372:         consumedAttempt: true,\n373:         submissionState: \"submitting\",\n374:         submissionStartedAt: FieldValue.serverTimestamp(),\n375:       };\n376:       transaction.update(ref, { cameraAttempts: attempts, timestamp: FieldValue.serverTimestamp() });\n377:       return true;\n378:     });\n379:   }\n380: \n381:   async recordSubmission(\n382:     partyId: string,\n383:     jobId: string,\n384:     cameraId: CameraId,\n385:     taskId: string,\n386:   ): Promise<void> {\n387:     const ref = jobRef(this.db, partyId, jobId);\n388:     await this.db.runTransaction(async (transaction) => {\n389:       const snapshot = await transaction.get(ref);\n390:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n391:       const job = snapshot.data()!;\n392:       const old = (job.providerTasks ?? {})[cameraId] as Record<string, unknown> | undefined;\n393:       if (typeof old?.taskId === \"string\" && old.taskId !== taskId) {\n394:         throw new BackendError(\"FORBIDDEN\", \"A different provider task is already persisted for this camera.\");\n395:       }\n396:       const providerTasks = { ...(job.providerTasks ?? {}), [cameraId]: { taskId, submittedAt: FieldValue.serverTimestamp() } };\n397:       const cameraAttempts = { ...(job.cameraAttempts ?? {}) } as Record<string, Record<string, unknown>>;\n398:       cameraAttempts[cameraId] = { ...(cameraAttempts[cameraId] ?? {}), submissionState: \"submitted\" };\n399:       transaction.update(ref, { providerTasks, cameraAttempts, timestamp: FieldValue.serverTimestamp() });\n400:     });\n401:   }\n402: \n403:   async recordSubmissionFailure(\n404:     input: RequestGenerationInput,\n405:     cameraId: CameraId,\n406:     errorCode: string,\n407:     certainty: \"non_billable\" | \"unknown\",\n408:   ): Promise<void> {\n409:     const ref = jobRef(this.db, input.partyId, input.jobId);\n410:     const budget = budgetRef(this.db, input.partyId);\n411:     await this.db.runTransaction(async (transaction) => {\n412:       const [snapshot, budgetSnapshot] = await Promise.all([transaction.get(ref), transaction.get(budget)]);\n413:       if (!snapshot.exists) return;\n414:       const job = snapshot.data()!;\n415:       const cameraAttempts = { ...(job.cameraAttempts ?? {}) } as Record<string, Record<string, unknown>>;\n416:       cameraAttempts[cameraId] = {\n417:         ...(cameraAttempts[cameraId] ?? {}),\n418:         submissionState: certainty === \"non_billable\" ? \"rejected_non_billable\" : \"submitting\",\n419:         submissionErrorCode: errorCode,\n420:       };\n421:       transaction.update(ref, {\n422:         cameraAttempts,\n423:         state: certainty === \"unknown\" ? \"running\" : \"failed\",\n424:         status: certainty === \"unknown\" ? \"reconciliation_required\" : \"failed\",\n425:         errorCode: \"PROVIDER_UNAVAILABLE\",\n426:         ...(certainty === \"unknown\" ? { reconciliationReason: \"SUBMISSION_OUTCOME_UNKNOWN\" } : {}),\n427:         ...(certainty === \"non_billable\" ? { failedAt: FieldValue.serverTimestamp() } : {}),\n428:         timestamp: FieldValue.serverTimestamp(),\n429:         workerLeaseUntilMs: 0,\n430:       });\n431:       if (certainty === \"non_billable\" && budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === input.jobId) {\n432:         transaction.update(budget, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n433:       }\n434:     });\n435:   }\n436: \n437:   async recordCameraResult(\n438:     partyId: string,\n439:     jobId: string,\n440:     cameraId: CameraId,\n441:     result: ProviderResult,\n442:     taskStatus: ProviderTaskStatus,\n443:     staged: Record<string, unknown>,\n444:   ): Promise<void> {\n445:     const ref = jobRef(this.db, partyId, jobId);\n446:     await this.db.runTransaction(async (transaction) => {\n447:       const snapshot = await transaction.get(ref);\n448:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n449:       const job = snapshot.data()!;\n450:       const stagedOutputs = { ...(job.stagedOutputs ?? {}), [cameraId]: staged };\n451:       const cameraResults = { ...(job.cameraResults ?? {}), [cameraId]: {\n452:         secondsOut: result.secondsOut,\n453:         secondsIn: result.secondsIn,\n454:         creditsCharged: result.creditsCharged,\n455:         providerState: taskStatus.state,\n456:       } };\n457:       const cameraAttempts = { ...(job.cameraAttempts ?? {}) } as Record<string, Record<string, unknown>>;\n458:       cameraAttempts[cameraId] = { ...(cameraAttempts[cameraId] ?? {}), submissionState: \"complete\", providerState: taskStatus.state };\n459:       transaction.update(ref, {\n460:         stagedOutputs,\n461:         cameraResults,\n462:         cameraAttempts,\n463:         timestamp: FieldValue.serverTimestamp(),\n464:       });\n465:     });\n466:   }\n467: \n468:   /** Fixture slot outcome: no provider task, truthful fixture provenance. */\n469:   async recordFixtureResult(\n470:     partyId: string,\n471:     jobId: string,\n472:     cameraId: CameraId,\n473:     staged: Record<string, unknown>,\n474:     secondsOut = 2,\n475:   ): Promise<void> {\n476:     const ref = jobRef(this.db, partyId, jobId);\n477:     await this.db.runTransaction(async (transaction) => {\n478:       const snapshot = await transaction.get(ref);\n479:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n480:       const job = snapshot.data()!;\n481:       transaction.update(ref, {\n482:         stagedOutputs: { ...(job.stagedOutputs ?? {}), [cameraId]: staged },\n483:         cameraResults: {\n484:           ...(job.cameraResults ?? {}),\n485:           [cameraId]: { secondsOut, secondsIn: 0, creditsCharged: null, providerState: \"FIXTURE\" },\n486:         },\n487:         timestamp: FieldValue.serverTimestamp(),\n488:       });\n489:     });\n490:   }\n491: \n492:   /** Consent withdrawal fails the bound job closed and releases the party budget. */\n493:   async failForWithdrawnConsent(partyId: string, jobId: string): Promise<void> {\n494:     const ref = jobRef(this.db, partyId, jobId);\n495:     const budget = budgetRef(this.db, partyId);\n496:     await this.db.runTransaction(async (transaction) => {\n497:       const [snapshot, budgetSnapshot] = await Promise.all([transaction.get(ref), transaction.get(budget)]);\n498:       if (!snapshot.exists) return;\n499:       transaction.update(ref, {\n500:         state: \"failed\",\n501:         status: \"failed\",\n502:         errorCode: \"FORBIDDEN\",\n503:         reconciliationReason: \"GUEST_CONSENT_WITHDRAWN\",\n504:         failedAt: FieldValue.serverTimestamp(),\n505:         timestamp: FieldValue.serverTimestamp(),\n506:         workerLeaseUntilMs: 0,\n507:       });\n508:       if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === jobId) {\n509:         transaction.update(budget, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n510:       }\n511:     });\n512:   }\n513: \n514:   async recordProviderFailure(input: RequestGenerationInput, cameraId: CameraId, errorCode: string): Promise<void> {\n515:     const ref = jobRef(this.db, input.partyId, input.jobId);\n516:     const budget = budgetRef(this.db, input.partyId);\n517:     await this.db.runTransaction(async (transaction) => {\n518:       const [jobSnapshot, budgetSnapshot] = await Promise.all([transaction.get(ref), transaction.get(budget)]);\n519:       if (!jobSnapshot.exists) return;\n520:       transaction.update(ref, {\n521:         state: \"failed\",\n522:         status: \"failed\",\n523:         errorCode: \"PROVIDER_UNAVAILABLE\",\n524:         providerErrorCode: errorCode.replace(/[^A-Za-z0-9_-]/g, \"_\").slice(0, 80),\n525:         failedAt: FieldValue.serverTimestamp(),\n526:         timestamp: FieldValue.serverTimestamp(),\n527:         workerLeaseUntilMs: 0,\n528:         [`cameraAttempts.${cameraId}.providerState`]: \"FAILED\",\n529:       });\n530:       if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === input.jobId) {\n531:         transaction.update(budget, { activeJobId: null, state: \"idle\", updatedAt: FieldValue.serverTimestamp() });\n532:       }\n533:     });\n534:   }\n535: \n536:   async recordStagedOutput(partyId: string, jobId: string, cameraId: CameraId, staged: Record<string, unknown>): Promise<void> {\n537:     const ref = jobRef(this.db, partyId, jobId);\n538:     await this.db.runTransaction(async (transaction) => {\n539:       const snapshot = await transaction.get(ref);\n540:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n541:       const job = snapshot.data()!;\n542:       transaction.update(ref, {\n543:         stagedOutputs: { ...(job.stagedOutputs ?? {}), [cameraId]: staged },\n544:         timestamp: FieldValue.serverTimestamp(),\n545:       });\n546:     });\n547:   }\n548: \n549:   async releaseWorker(partyId: string, jobId: string): Promise<void> {\n550:     await jobRef(this.db, partyId, jobId).update({ workerLeaseUntilMs: 0, timestamp: FieldValue.serverTimestamp() });\n551:   }\n552: \n553:   currentManifestRef(partyId: strin