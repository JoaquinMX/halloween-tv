unctions/test/backend_contract_fixture.test.ts,\n72:     // which runs the real canonicalManifestHash over the same fixture.\n73:     final String canonical = jsonEncode(<String, Object?>{\n74:       'partyId': ack['partyId'],\n75:       'channelId': ack['channelId'],\n76:       'version': ack['manifestVersion'],\n77:       'cameraClips': cameraClips,\n78:     });\n79: \n80:     expect(\n81:       sha256Hex(utf8.encode(canonical)),\n82:       'c3114a6601be504d1be045749e00512bc249aa70ca365b804e26695d94265692',\n83:     );\n84:   });\n85: \n86:   test(\n87:     'Dart parses exact getDeliveryUrls and acknowledgeDelivery contracts',\n88:     () async {\n89:       final Map<String, Object?> fixture = _fixture();\n90:       final Map<String, Object?> hashByCamera = Map<String, Object?>.from(\n91:         ((fixture['acknowledgeDelivery']! as Map)['request']! as Map)['clipHashes']! as Map,\n92:       );\n93:       final Map<String, String> hashes = <String, String>{\n94:         for (final MapEntry<String, Object?> entry in hashByCamera.entries)\n95:           entry.key: entry.value! as String,\n96:       };\n97:       final Map<String, Object?> deliveryFixture =\n98:           Map<String, Object?>.from((fixture['deliveryUrls']! as Map)['response']! as Map)\n99:             ..['manifestHash'] =\n100:                 'c3114a6601be504d1be045749e00512bc249aa70ca365b804e26695d94265692'\n101:             ..['clips'] = _deliveryResponse(hashes: hashes)['clips'];\n102:       final Map<String, Object?> fixtureAck = Map<String, Object?>.from(\n103:         (fixture['acknowledgeDelivery']! as Map)['request']! as Map,\n104:       )..['clipHashes'] = hashes;\n105:       final _FixtureCallable invoker = _FixtureCallable(<String, Object?>{\n106:         'getDeliveryUrls': deliveryFixture,\n107:         'acknowledgeDelivery': <String, Object?>{\n108:           'ackId': 'backend-ack-1',\n109:           'manifestVersion': 1,\n110:           'purged': true,\n111:         },\n112:       });\n