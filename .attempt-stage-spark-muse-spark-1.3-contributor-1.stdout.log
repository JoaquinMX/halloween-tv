y presence renders each layout without\n+  /// placeholder tiles for absent cameras.\n+  List<CctvSlot> _presentSlots(PlaybackManifest manifest) {\n+    final Set<String> present = <String>{\n+      for (final ClipDescriptor clip in manifest.clips) clip.cameraId,\n+    };\n+    return <CctvSlot>[\n+      for (final CctvSlot slot in cctvSlots)\n+        if (present.contains(slot.id)) slot,\n+    ];\n+  }\n+\n   Widget _cameraTile({\n     required PlaybackManifest manifest,\n     required CctvSlot slot,\n-  }) {    ClipDescriptor? match;\n+  }) {\n+    ClipDescriptor? match;\n     for (final ClipDescriptor clip in manifest.clips) {\n       if (clip.cameraId == slot.id) {\n         match = clip;\n         break;\n","status":"modified","additions":17,"deletions":1}],"truncated":false},"content":[{"type":"text","text":"Edited apps/companion_app/lib/src/ui/now_playing_screen.dart (1 replacement)"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192ab92c772bbb673c2c4541aa8c3"}},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"  /// Cameras present in [manifest], in canonical wall order.\\n  ///\\n  /// Validated 1/2/4-camera manifests carry the first-N canonical slots, so\\n  /// filtering [cctvSlots] by presence renders each layout without\\n  /// placeholder tiles for absent cameras.\\n  List<CctvSlot> _presentSlots(PlaybackManifest manifest) {\\n    final Set<String> present = <String>{\\n      for (final ClipDescriptor clip in manifest.clips) clip.cameraId,\\n    };\\n    return <CctvSlot>[\\n      for (final CctvSlot slot in cctvSlots)\\n        if (present.contains(slot.id)) slot,\\n    ];\\n  }\\n\\n  Widget _cameraTile({\\n    required PlaybackManifest manifest,\\n    required CctvSlot slot,\\n  }) {\\n    ClipDescriptor? match;\",\"oldString\":\"  Widget _cameraTile({\\n    required PlaybackManifest manifest,\\n    required CctvSlot slot,\\n  }) {    ClipDescriptor? match;\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/compa