, Object?>.of(payload));\n36:     final Object? error = failure;\n37:     if (error != null) throw error;\n38:     final Object? override = nextResponse;\n39:     if (override != null) {\n40:       nextResponse = null;\n41:       return override;\n42:     }\n43:     switch (name) {\n44:       case kListHostVideos:\n45:         return <String, Object?>{\n46:           'videos': <Object?>[for (final s in seeds) seedJson(s)],\n47:         };\n48:       case kGenerateHostVideo:\n49:         generates++;\n50:         return <String, Object?>{\n51:           'seedId': payload['seedId'],\n52:           'jobId': 'hv-${payload['seedId']}',\n53:           'state': 'queued',\n54:           'created': generates == 1,\n55:         };\n56:       case kGetHostVideoPreview:\n57:         final String seedId = payload['seedId'] as String;\n58:         return <String, Object?>{\n59:           'seedId': seedId,\n60:           'expiresAt': '2030-01-01T00:00:00.000Z',\n61:           'clips': <Object?>[\n62:             for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\n63:               <String, Object?>{\n64:                 'cameraId': camera,\n65:                 'sha256': List.filled(64, 'a').join(),\n66:                 'url': 'https://preview.example/$seedId/$camera.mp4',\n67:                 'expiresAt': '2030-01-01T00:00:00.000Z',\n68:               },\n69:           ],\n70:         };\n71:       case kDeleteHostVideo:\n72:         final List<String> ids = <String>[\n73:           for (final Object? id in payload['seedIds'] as List) id.toString(),\n74:         ];\n75:         seeds.removeWhere((s) => ids.contains(s.seedId));\n76:         return <String, Object?>{\n77:           'deletedSeedIds': ids,\n78:           'deletedObjects': <String>[\n79:             for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\n80:           ],\n81:           'revokedManifest': true,\n82:         };\n83:     }\n84:     throw StateError('unexpected callable $name');\n85:   }\n86: }\n87: \n88: HostSeedVideo seed(String id, String status) => HostSeedVideo(\n89:   seedId: id,\n90:   partyId: 'party-1',\n91:   channelId: 'cctv',\n92:   status: status,\n93:   jobId: 'hv-$id',\n94:   createdAt: '2026-10-29T14:00:00.000Z',\n95:   expiresAt: '2030-01-01T00:00:00.000Z',\n96:   previewAvailable: status == 'ready',\n97:   cameraIds: const <String>['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'],\n98: );\n99: \n100: void main() {\n101:   test('list returns scoped seed entries across lifecycle states', () async {\n102:     final invoker = FakeHostMediaInvoker()\n103:       ..seeds.addAll(<HostSeedVideo>[\n104:         seed('a', 'queued'),\n105:         seed('b', 'running'),\n106:         seed('c', 'ready'),\n107:         seed('d', 'failed'),\n108:         seed('e', 'deleted'),\n109:       ]);\n110:     final videos = await HostMediaClient(invoker: invoker).listVideos(\n111:       partyId: 'party-1',\n112:       deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n113:       channelId: 'cctv',\n114:     );\n115:     expect(invoker.names, <String>[kListHostVideos]);\n116:     expect(invoker.payloads.single, containsPair('channelId', 'cctv'));\n117:     expect(videos.map((v) => '${v.seedId}:${v.status}'), <String>[\n118:       'a:queued',\n119:       'b:running',\n120:       'c:ready',\n121:       'd:failed',\n122:       'e:deleted',\n123:     ]);\n124:     expect(videos[2].previewAvailable, isTrue);\n125:   });\n126: \n127:   test(\n128:     'generate enqueues the fixed preset and rejects other presets',\n129:     () async {\n130:       final invoker = FakeHostMediaInvoker();\n131:       final client = HostMediaClient(invoker: invoker);\n132:       final result = await client.generateVideo(\n133:         partyId: 'party-1',\n134:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n135:         channelId: 'cctv',\n136:         seedId: 'catalog-1',\n137:         idempotencyKey: 'idem-1',\n138:       );\n139:       expect(result['seedId'], 'catalog-1');\n140:       expect(result['jobId'], 'hv-catalog-1');\n141:       expect(invoker.payloads.single['presetId'], kCheapDemoPresetId);\n142:       await expectLater(\n143:         client.generateVideo(\n144:           partyId: 'party-1',\n145:           deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n146:           channelId: 'cctv',\n147:           seedId: 'catalog-2',\n148:           idempotencyKey: 'idem-2',\n149:           presetId: 'ultra_cinema',\n150:         ),\n151:         throwsArgumentError,\n152:       );\n153:       expect(invoker.generates, 1);\n154:     },\n155:   );\n156: \n157:   test('preview returns fresh signed clips with https URLs', () async {\n158:     final invoker = FakeHostMediaInvoker();\n159:     final preview = await HostMediaClient(invoker: invoker).getPreview(\n160:       partyId: 'party-1',\n161:       deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n162:       channelId: 'cctv',\n163:       seedId: 'catalog-1',\n164:     );\n165:     expect(preview.seedId, 'catalog-1');\n166:     expect(preview.clips, hasLength(4));\n167:     expect(preview.clips.map((c) => c.cameraId), <String>[\n168:       'CAM-01',\n169:       'CAM-02',\n170:       'CAM-03',\n171:       'CAM-04',\n172:     ]);\n173:     for (final clip in preview.clips) {\n174:       expect(clip.url.scheme, 'https');\n175:     }\n176:   });\n177: \n178:   test('delete reconciles per selected seed id', () async {\n179:     final invoker = FakeHostMediaInvoker()\n180:       ..seeds.addAll(<HostSeedVideo>[seed('a', 'ready'), seed('b', 'ready')]);\n181:     final client = HostMediaClient(invoker: invoker);\n182:     final result = await client.deleteVideos(\n183:       partyId: 'party-1',\n184:       deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n185:       channelId: 'cctv',\n186:       seedIds: const <String>['a'],\n187:     );\n188:     expect(result['deletedSeedIds'], <String>['a']);\n189:     expect(result['revokedManifest'], isTrue);\n190:     expect(\n191:       (await client.listVideos(\n192:         partyId: 'party-1',\n193:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n194:         channelId: 'cctv',\n195:       )).map((v) => v.seedId),\n196:       <String>['b'],\n197:     );\n198:   });\n199: \n200:   test('rejects cross-party entries and malformed shapes', () async {\n201:     final invoker = FakeHostMediaInvoker();\n202:     final client = HostMediaClient(invoker: invoker);\n203:     invoker.seeds.add(\n204:       const HostSeedVideo(\n205:         seedId: 'x',\n206:         partyId: 'other-party',\n207:         channelId: 'cctv',\n208:         status: 'ready',\n209:         jobId: 'hv-x',\n210:         createdAt: '2026-10-29T14:00:00.000Z',\n211:         expiresAt: '2030-01-01T00:00:00.000Z',\n212:         previewAvailable: true,\n213:         cameraIds: <String>['CAM-01'],\n214:       ),\n215:     );\n216:     await expectLater(\n217:       client.listVideos(\n218:         partyId: 'party-1',\n219:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n220:         channelId: 'cctv',\n221:       ),\n222:       throwsFormatException,\n223:     );\n224:     invoker.seeds.clear();\n225:     invoker.nextResponse = <String, Object?>{'unexpected': 'shape'};\n226:     await expectLater(\n227:       client.listVideos(\n228:         partyId: 'party-1',\n229:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n230:         channelId: 'cctv',\n231:       ),\n232:       throwsFormatException,\n233:     );\n234:   });\n235: \n236:   test('bounds a callable that never completes', () async {\n237:     final client = HostMediaClient(\n238:       invoker: _PendingInvoker(),\n239:       timeout: const Duration(milliseconds: 5),\n240:     );\n241:     await expectLater(\n242:       client.listVideos(\n243:         partyId: 'party-1',\n244:         deviceId: 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n245:         channelId: 'cctv',\n246:       ),\n247:       throwsA(isA<ManifestTransportException>()),\n248:     );\n249:   });\n250: }\n2