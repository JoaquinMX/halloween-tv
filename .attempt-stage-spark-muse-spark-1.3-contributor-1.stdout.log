onse via [HostInviteClient]; nothing is fabricated\n8: /// from build-time config.\n9: ///\n10: /// States: loading (no fabricated QR), ready (QR + REFRESH re-mint),\n11: /// expired (stale capability hidden, refresh offered), denial/error (reason\n12: /// shown, last valid session retained when one exists), and unavailable\n13: /// (no [HostInviteClient] — the wall never opens this destination, like the\n14: /// offline guest-codes path).\n15: ///\n16: /// Refresh is manual (REFRESH re-mints) plus a 1s expiry ticker that hides\n17: /// the QR the moment the invite lapses. Overlapping mints are skipped,\n18: /// timers are cancelled on disposal, and late responses after disposal are\n19: /// ignored.\n20: library;\n21: \n22: import 'dart:async';\n23: \n24: import 'package:core_foundation/core_foundation.dart';\n25: import 'package:core_ui/core_ui.dart';\n26: import 'package:flutter/material.dart';\n27: import 'package:flutter/services.dart';\n28: import 'package:qr_flutter/qr_flutter.dart';\n29: \n30: import 'package:tv_app/src/wall/host_codes.dart';\n31: \n32: /// Key of the host code panel.\n33: const Key kHostCodePanelKey = ValueKey<String>('host-code-panel');\n34: \n35: /// Key of the host-code close button.\n36: const Key kHostCodeCloseKey = ValueKey<String>('host-code-close');\n37: \n38: /// Key of the host-code back button (returns to the recovery actions).\n39: const Key kHostCodeBackKey = ValueKey<String>('host-code-back');\n40: \n41: /// Key of the single invite QR (present only with a live, unexpired invite).\n42: const Key kHostCodeQrKey = ValueKey<String>('host-code-qr');\n43: \n44: /// Key of the session scope/expiry line.\n45: const Key kHostCodeSessionKey = ValueKey<String>('host-code-session');\n46: \n47: /// Key of the manual refresh button.\n48: const Key kHostCodeRefreshKey = ValueKey<String>('host-code-refresh');\n49: \n50: /// Key of the loading indicator text.\n51: const Key kHostCodeLoadingKey = ValueKey<String>('host-code-loading');\n52: \n53: /// Key of the error text.\n54: const Key kHostCodeErrorKey = ValueKey<String>('host-code-error');\n55: \n56: /// Key of the expired-invite text.\n57: const Key kHostCodeExpiryKey = ValueKey<String>('host-code-expiry');\n58: \n59: /// Bounds a single invite mint: without this, a hung callable would hold\n60: /// `_fetching` true forever and wedge the panel (no retries, stale QR).\n61: const Duration kHostInviteFetchTimeout = Duration(seconds: 10);\n62: \n63: /// Host panel: scoped invite QR + expiry + manual refresh.\n64: ///\n65: /// Owns its mint: fetches immediately on open and re-evaluates expiry on a\n66: /// 1s ticker while mounted. Pass a fake [HostInviteClient.invoker] in widget\n67: /// tests; production passes the real Cloud Functions client.\n68: class HostCodePanel extends StatefulWidget {\n69:   /// Creates the host code panel.\n70:   const HostCodePanel({\n71:     super.key,\n72:     required this.client,\n73:     required this.onClose,\n74:     this.onBack,\n75:     this.primaryFocusNode,\n76:     this.clock = const SystemClock(),\n77:   });\n78: \n79:   /// Host-only invite minter (authorization carries the TV's device id).\n80:   final HostInviteClient client;\n81: \n82:   /// Closes the whole overlay.\n83:   final VoidCallback onClose;\n84: \n85:   /// Returns to the recovery actions; null hides the back button.\n86:   final VoidCallback? onBack;\n87: \n88:   /// Focus node for the first action, so the D-pad lands inside the panel.\n89:   final FocusNode? primaryFocusNode;\n90: \n91:   /// Clock for expiry evaluation (injectable for deterministic tests).\n92:   final Clock clock;\n93: \n94:   @override\n95:   State<HostCodePanel> createState() => _HostCodePanelState();\n96: }\n97: \n98: class _HostCodePanelState extends State<HostCodePanel> {\n99:   HostInvite? _invite;\n100:   String? _error;\n101:   bool _firstFetchDone = false;\n102:   bool _fetching = false;\n103:   int _generation = 0;\n104:   Timer? _expiryTimer;\n105: \n106:   @override\n107:   void initState() {\n108:     super.initState();\n109:     unawaited(_refresh());\n110:     // Re-evaluates expiry only; never re-mints on its own (invites are\n111:     // server-minted capabilities, not pollable state).\n112:     _expiryTimer = Timer.periodic(const Duration(seconds: 1), (_) {\n113:       if (!mounted) {\n114:         return;\n115:       }\n116:       final HostInvite? invite = _invite;\n117:       if (invite != null && invite.isExpired(widget.clock.now())) {\n118:         setState(() {});\n119:       }\n120:     });\n121:   }\n122: \n123:   @override\n124:   void dispose() {\n125:     _generation++;\n126:     _expiryTimer?.cancel();\n127:     _expiryTimer = null;\n128:     super.dispose();\n129:   }\n130: \n131:   bool get _expired {\n132:     final HostInvite? invite = _invite;\n133:     return invite != null && invite.isExpired(widget.clock.now());\n134:   }\n135: \n136:   Future<void> _refresh() async {\n137:     if (_fetching || !mounted) {\n138:       return;\n139:     }\n140:     _fetching = true;\n141:     final int generation = _generation;\n142:     try {\n143:       final HostInvite invite = await widget.client.createInvite().timeout(\n144:         kHostInviteFetchTimeout,\n145:       );\n146:       if (!mounted || generation != _generation) {\n147:         return;\n148:       }\n149:       setState(() {\n150:         _invite = invite;\n151:         _error = null;\n152:         _firstFetchDone = true;\n153:       });\n154:     } on TimeoutException {\n155:       // A hung mint releases the in-flight guard so the next REFRESH\n156:       // retries; the last valid invite (if any) is retained behind an\n157:       // inline error.\n158:       if (!mounted || generation != _generation) {\n159:         return;\n160:       }\n161:       setState(() {\n162:         _error = 'host invite refresh timed out';\n163:         _firstFetchDone = true;\n164:       });\n165:     } on Object catch (error) {\n166:       if (!mounted || generation != _generation) {\n167:         return;\n168:       }\n169:       setState(() {\n170:         _error = error is HostInviteException\n171:             ? error.message\n172:             : 'unexpected host invite failure';\n173:         _firstFetchDone = true;\n174:       });\n175:     } finally {\n176:       _fetching = false;\n177:     }\n178:   }\n179: \n180:   KeyEventResult _onKey(FocusNode node, KeyEvent event) {\n181:     if (event is KeyDownEvent) {\n182:       if (event.logicalKey == LogicalKeyboardKey.contextMenu) {\n183:         widget.onClose();\n184:         return KeyEventResult.handled;\n185:       }\n186:       if (event.logicalKey == LogicalKeyboardKey.goBack ||\n187:           event.logicalKey == LogicalKeyboardKey.escape) {\n188:         (widget.onBack ?? widget.onClose)();\n189:         return KeyEventResult.handled;\n190:       }\n191:     }\n192:     return KeyEventResult.ignored;\n193:   }\n194: \n195:   @override\n196:   Widget build(BuildContext context) {\n197:     return Focus(\n198:       canRequestFocus: false,\n199:       skipTraversal: true,\n200:       onKeyEvent: _onKey,\n201:       child: ColoredBox(\n202:         color: const Color(0xE6000000),\n203:         child: Center(\n204:           child: ConstrainedBox(\n205:             constraints: const BoxConstraints(maxWidth: 720),\n206:             child: Container(\n207:               key: kHostCodePanelKey,\n208:               padding: const EdgeInsets.all(28),\n209:               decoration: BoxDecoration(\n210:                 color: const Color(0xFF101410),\n211:                 border: Border.all(color: CctvTheme.frameEdge, width: 2),\n212:               ),\n213:               child: SingleChildScrollView(\n214:                 child: Column(\n215:                   mainAxisSize: MainAxisSize.min,\n216:                   crossAxisAlignment: CrossAxisAlignment.start,\n217:                   children: <Widget>[\n218:                     const Text('HOST QR', style: CctvTheme.labelStyle