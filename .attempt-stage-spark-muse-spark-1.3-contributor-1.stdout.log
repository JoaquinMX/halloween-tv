st int kDefaultCctvClipCount = 4;\n74: \n75: /// True when [count] is a supported manifest clip count (1, 2, or 4).\n76: bool isSupportedCctvClipCount(int count) =>\n77:     kSupportedCctvClipCounts.contains(count);\n78: \n79: /// Camera ids expected for a [count]-clip manifest: the first [count]\n80: /// canonical slot ids in wall order (e.g. 2 → {CAM-01, CAM-02}).\n81: ///\n82: /// Throws [ArgumentError] for unsupported counts.\n83: List<String> expectedCctvCameraIds(int count) {\n84:   if (!isSupportedCctvClipCount(count)) {\n85:     throw ArgumentError.value(\n86:       count,\n87:       'count',\n88:       'must be one of $kSupportedCctvClipCounts',\n89:     );\n90:   }\n91:   return <String>[\n92:     for (var i = 0; i < count; i++) cctvSlots[i].id,\n93:   ];\n94: }\n95: \n96: /// Valid CCTV camera ids, derived from [cctvSlots].\n97: ///\n98: /// Kept for callers that only need the id set; prefer [cctvSlots] (or\n99: /// [slotForCameraId]) when order, index, or default labels matter.\n100: final Set<String> kCctvCameraIds = Set<String>.unmodifiable(\n101:   <String>{for (final CctvSlot slot in cctvSlots) slot.id},\n102: );\n103: \n104: /// Slot for [cameraId], or `null` when it is not a known camera.\n105: CctvSlot? slotForCameraId(String cameraId) {\n106:   for (final CctvSlot slot in cctvSlots) {\n107:     if (slot.id == cameraId) {\n108:       return slot;\n109:     }\n110:   }\n111:   return null;\n112: }\n113: \n114: /// Maximum manifest clip id length.\n115: ///\n116: /// The tile HUD ellipsizes long labels (p5 owns the HUD), but ids longer\n117: /// than this are rejected by [validateCctvManifest] so oversized\n118: /// control-plane payloads never reach the wall.\n119: const int kMaxClipIdLength = 64;\n120: \n121: /// Resolves the wall-slot label for [clip].\n122: ///\n123: /// The manifest clip `label` field wins when present and non-blank (owner\n124: /// Q3: labels are config-driven and replaceable); otherwise the\n125: /// [CctvSlot.defaultLabel] for the clip's camera applies. Unknown cameras\n126: /// fall back to the raw camera id — validation rejects those separately.\n127: String resolveCctvLabel(ClipDescriptor clip) {\n128:   final String? custom = clip.label;\n129:   if (custom != null && custom.trim().isNotEmpty) {\n130:     return custom;\n131:   }\n132:   final CctvSlot? slot = slotForCameraId(clip.cameraId);\n133:   if (slot != null) {\n134:     return slot.defaultLabel;\n135:   }\n136:   return clip.cameraId;\n137: }\n138: \n139: final RegExp _sha256Pattern = RegExp(r'^[0-9a-fA-F]{64}$');\n140: \n141: /// True when [value] is a 64 character hex sha256 digest.\n142: ///\n143: /// Digests are compared and stored as lowercase hex elsewhere; this helper\n144: /// only checks well-formedness so callers can normalise case themselves.\n145: bool isValidSha256Hex(String value) => _sha256Pattern.hasMatch(value);\n146: \n147: /// Clamps [value] into the inclusive [min]..[max] range.\n148: double _clamp(double value, double min, double max) {\n149:   if (value.isNaN) {\n150:     return min;\n151:   }\n152:   if (value < min) {\n153:     return min;\n154:   }\n155:   if (value > max) {\n156:     return max;\n157:   }\n158:   return value;\n159: }\n[Output truncated. Continue reading with offset: 160]","title":"read","metadata":{"metadata":{"truncated":true},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/part-3/packages/core_playlist/lib/core_playlist.dart, lines 50-159\n50: /// Single source of truth for camera identity: id, slot index, and default\n51: /// room label travel together so `channel_cctv`, the tv_app asset catalog,\n52: /// and manifest validation can never drift apart. Add a camera here — never\n53: /// by scattering new `CAM-0x` literals across layers.\n54: const List<CctvSlot> cctvSlots = <CctvSlot>[\n55:   CctvSlot(id: 'CAM-01', index: 0, room: 'hallway'),\n56:   CctvSlot(id: 'CAM-02', index: 1, room: 'kitchen'),\n57:   CctvSlot(id: 'CAM-03', index: 2, room: 'st