() => getServices().getCurrentManifest(request.data)));\n100: \n101: /** Host TV callable; lists registered party devices (guest codes) for verbal dictation. Guests get FORBIDDEN. */\n102: export const listPartyDevices = onCall({ maxInstances: 2 }, (request) =>\n103:   callable(() => getServices().listPartyDevices(request.data)));\n104: \n105: /** Anonymous phone callable; self-registers a guest device for the active channel (PIN-gated when configured). */\n106: export const joinParty = onCall({ maxInstances: 10 }, (request) =>\n107:   callable(() => getServices().joinParty(request.data)));\n108: \n109: /** Guest photo upload with affirmative server-side consent (no login). */\n110: export const requestGuestUpload = onCall({ maxInstances: 10 }, (request) =>\n111:   callable(() => getServices().requestGuestUpload(request.data)));\n112: \n113: /** Guest upload finalization: verifies actual image bytes before eligibility. */\n114: export const completeGuestUpload = onCall({ maxInstances: 10 }, (request) =>\n115:   callable(() => getServices().completeGuestUpload(request.data)));\n116: \n117: /** Guest media status for the owning registered device. */\n118: export const getGuestMediaStatus = onCall({ maxInstances: 10 }, (request) =>\n119:   callable(() => getServices().getGuestMediaStatus(request.data)));\n120: \n121: /** Idempotent consent withdrawal: revokes eligibility and purges cloud copies. */\n122: export const withdrawGuestMedia = onCall({ maxInstances: 10 }, (request) =>\n123:   callable(() => getServices().withdrawGuestMedia(request.data)));\n124: \n125: /** Object-finalization cleanup: a PUT after withdrawal never restores eligibility. */\n126: function ingestBucket(): string {\n127:   const bucket = process.env.STORAGE_BUCKET ?? process.env.FIREBASE_STORAGE_BUCKET;\n128:   if (bucket) return bucket;\n129:   // Require-time safe fallback for discovery/local runs without bucket env.\n130:   // Cloud predeploy gates refuse deploys without an explicit bucket, and the\n131:   // emulator run sets STORAGE_BUCKET explicitly, so this never targets cloud.\n132:   return \"demo-halloween-tv.appspot.com\";\n133: }\n134: export const onGuestIngestFinalized = onObjectFinalized({ bucket: ingestBucket(), region: STORAGE_TRIGGER_REGION }, async (event) => {\n135:   await getServices().handleGuestIngestFinalized(event.data.name);\n136: });\n137: \n138: /** Host TV callable; only a registered TV may mint a short-lived host invite. */\n139: export const createHostInvite = onCall({ maxInstances: 2 }, (request) =>\n140:   callable(() => getServices().createHostInvite(request.data)));\n141: \n142: /** Phone callable; redeems a host invite for a server-assigned host role. */\n143: export const joinHost = onCall({ maxInstances: 10 }, (request) =>\n144:   callable(() => getServices().joinHost(request.data)));\n145: \n146: /** Host-only callable; lists the server-backed seed catalog. */\n147: export const listHostVideos = onCall({ maxInstances: 10 }, (request) =>\n148:   callable(() => getServices().listHostVideos(request.data)));\n149: \n150: /** Host-only callable; queues fixed-preset generation for a seed entry. */\n151: export const generateHostVideo = onCall({ maxInstances: 2 }, (request) =>\n152:   callable(() => getServices().generateHostVideo(request.data)));\n153: \n154: /** Host-only callable; signs TTL-limited preview URLs on demand (never persisted). */\n155: export const getHostVideoPreview = onCall({ maxInstances: 10 }, (request) =>\n156:   callable(() => getServices().getHostVideoPreview(request.data)));\n157: \n158: /** Host-only callable; deletes seeds + objects and revokes affected manifests. */\n159: export const deleteHostVideo = onCall({ maxInstances: 2 }, (request) =>\n160:   callable(() => getServices().deleteHostVideo(request.data)));\n161: \n162: /** Anonymous TV callable; ACK and purge are idempotent by device/channel/version. */\n163: export const acknowledgeDelivery = onCall({ maxInstances: 10 }, (request) =>\n164:   callable(() => getServices().acknowledgeDelivery(request.data)));\n165: \n166: /** Scheduled TTL transition and orphan object sweeper. */\n167: export const sweepExpiredMedia = onSchedule(\"every 15 minutes\", async () => {\n168:   await createRetentionService(getAdminFirestore(), getAdminBucket())();\n169: });\n170: "}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c336e074e2bb991e816fee1816"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/index.ts\"}"},"time":{"start":1793463629944,"end":1793463630479}}}}
