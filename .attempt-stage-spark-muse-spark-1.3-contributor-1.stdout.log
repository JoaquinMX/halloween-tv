estListServiceOptions): {\n38:   listPartyDevices(value: unknown): Promise<GuestCodeListing>;\n39: } {\n40:   const { db } = options;\n41:   return {\n42:     async listPartyDevices(value: unknown): Promise<GuestCodeListing> {\n43:       const input: CurrentManifestInput = parseCurrentManifestInput(value);\n44:       const registered = await assertRegisteredPartyDevice(db, input);\n45:       if (registered.device.role !== \"tv\") {\n46:         throw new BackendError(\"FORBIDDEN\", \"Only the registered TV device may list party codes.\");\n47:       }\n48:       const snapshot = await db.collection(`parties/${registered.partyId}/devices`).get();\n49:       const devices: GuestCodeEntry[] = snapshot.docs\n50:         .map((doc) => {\n51:           const data = doc.data() ?? {};\n52:           const deviceId = String(data.deviceId ?? doc.id);\n53:           const rawLabel = data.label;\n54:           const entry: GuestCodeEntry = {\n55:             deviceId,\n56:             role: typeof data.role === \"string\" ? String(data.role) : \"unknown\",\n57:             status: typeof data.status === \"string\" ? String(data.status) : \"unknown\",\n58:           };\n59:           if (typeof rawLabel === \"string\") {\n60:             // Whitespace-only labels normalize to absent (the TV falls back\n61:             // to a neutral device-based display for those rows).\n62:             const trimmed = rawLabel.trim();\n63:             if (trimmed.length > 0) {\n64:               entry.label = trimmed;\n65:             }\n66:           }\n67:           return entry;\n68:         })\n69:         .filter((entry) => entry.deviceId !== registered.deviceId)\n70:         .sort((a, b) => (a.label ?? a.deviceId).localeCompare(b.label ?? b.deviceId) || a.deviceId.localeCompare(b.deviceId));\n71:       const listing: GuestCodeListing = {\n72:         partyId: registered.partyId,\n73:         channelId: registered.channelId,\n74:         tvDeviceId: registered.deviceId,\n75:         devices,\n76:       };\n77:       // Fail closed on a malformed stored PIN: a PIN-free session must never\n78:       // be presented as valid when the stored value is present but invalid\n79:       // (number/boolean/malformed string written via console). The TV panel\n80:       // surfaces this as an error state with no fabricated QR.\n81:       const storedPin: unknown = registered.party.joinPin;\n82:       const pinUnset = storedPin === undefined || storedPin === \"\";\n83:       if (!pinUnset) {\n84:         if (typeof storedPin !== \"string\" || !JOIN_PIN_RE.test(storedPin)) {\n85:           throw new BackendError(\n86:             \"INTERNAL\",\n87:             \"Party join PIN is misconfigured; re-provision it with seed_join.\",\n88:           );\n89:         }\n90:         listing.joinPin = storedPin;\n91:       }\n92:       return listing;\n93:     },\n94:   };\n95: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-1/backend/functions/src/guest_list.ts, lines 1-95\n1: import { Firestore } from \"firebase-admin/firestore\";\n2: import { assertRegisteredPartyDevice } from \"./auth\";\n3: import { BackendError, CurrentManifestInput, JOIN_PIN_RE, parseCurrentManifestInput } from \"./contracts\";\n4: \n5: /** One registered device visible to the TV host panel. */\n6: export interface GuestCodeEntry {\n7:   deviceId: string;\n8:   /** Absent for self-registered guests: readers fall back to a neutral\n9:    *  device-based display and never duplicate the id as label+value. */\n10:   label?: string;\n11:   role: string;\n12:   status: string;\n13: }\n14: \n15: /** Host-visible code listing for verbal guest-code dictation. */\n16: export interface GuestCodeListing {\n17:   partyId: string;\n18:   channelId: string;\n19:   tvDeviceId: string;\n20:   devices: GuestCodeEntry[];\n21:   /** Present only when the party has a join PIN configured. */\n22:   joinPin?: string;\n23: }\n24: