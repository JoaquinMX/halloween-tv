{"type":"step_start","timestamp":1793462247492,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"id":"prt_192ae20440015PID2zMKpx8Faw","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192ae19a4001jRzEyCeRGjbJlG","type":"step-start","snapshot":"96f63536e203d4600e71eb7b56e04938216f8a30"}}
{"type":"tool_use","timestamp":1793462294645,"sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","part":{"partID":"prt_192ae20df001oZUSXlad8y3zx1","sessionID":"ses_e6d5a7eaaffe4FxJQatHmabOOJ","messageID":"msg_192ae19a4001jRzEyCeRGjbJlG","type":"tool","id":"call_01a192ae208876dfaa3b7b8b9df33d5d","tool":"write","state":{"status":"completed","input":{"content":"// Host-first navigation, role-aware joining, and video administration.\n//\n// Exercises the REAL parser (guest_join_data role validation), the REAL\n// HostEntryScreen/JoinScreen routing, the REAL HostSession state machine,\n// and REAL response validation (HostJoinClient/HostMediaClient). ONLY the\n// platform/network boundaries are substituted: fake callable invokers\n// (never the clients, never the session) and fake scanners. No Firebase\n// initialization, no network traffic.\n\nimport 'dart:async';\n\nimport 'package:channel_api/channel_api.dart';\nimport 'package:cloud_functions/cloud_functions.dart';\nimport 'package:companion_app/src/companion_app.dart';\nimport 'package:companion_app/src/config/backend_config.dart';\nimport 'package:companion_app/src/data/host_join_client.dart';\nimport 'package:companion_app/src/data/host_media_client.dart';\nimport 'package:companion_app/src/data/party_join_client.dart';\nimport 'package:companion_app/src/join/device_identity_store.dart';\nimport 'package:companion_app/src/join/guest_join_data.dart';\nimport 'package:companion_app/src/join/join_payload_scanner.dart';\nimport 'package:companion_app/src/session/host_session.dart';\nimport 'package:companion_app/src/ui/host_entry_screen.dart';\nimport 'package:companion_app/src/ui/host_panel_screen.dart';\nimport 'package:companion_app/src/ui/host_video_preview_screen.dart';\nimport 'package:companion_app/src/ui/join_screen.dart';\nimport 'package:core_foundation/core_foundation.dart';\nimport 'package:core_playlist/core_playlist.dart';\nimport 'package:flutter/material.dart';\nimport 'package:flutter_test/flutter_test.dart';\nimport 'package:infra_firestore/infra_firestore.dart'\n    show FirebaseManifestCallableInvoker;\nimport 'package:shared_preferences/shared_preferences.dart';\n\nconst String kGuestDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\nconst String kHostDeviceId = 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';\nconst String kHostToken =\n    'hi-0123456789abcdef0123456789abcdef0123456789abcdef01';\n\nString hostPayload({\n  String party = 'party-1',\n  String channel = 'cctv',\n  String token = kHostToken,\n}) =>\n    '{\"partyId\":\"$party\",\"channelId\":\"$channel\",\"role\":\"host\",'\n    '\"inviteToken\":\"$token\"}';\n\nGuestJoinData hostData({\n  String party = 'party-1',\n  String channel = 'cctv',\n  String device = kHostDeviceId,\n  String token = kHostToken,\n}) {\n  final Result<GuestJoinData> result = parseGuestJoinFields(\n    partyId: party,\n    localDeviceId: device,\n    channelId: channel,\n    role: JoinRole.host,\n    inviteToken: token,\n  );\n  return (result as Ok<GuestJoinData>).value;\n}\n\n/// Fake joinHost boundary: echoes the requested scope into a valid host\n/// registration, or throws [failure] to script denial paths.\nfinal class FakeHostJoinInvoker implements HostJoinCallableInvoker {\n  int calls = 0;\n  Map<String, Object?>? lastPayload;\n  Object? failure;\n  bool createdFirst = true;\n  bool _created = false;\n\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\n    calls++;\n    lastPayload = Map<String, Object?>.of(payload);\n    final Object? error = failure;\n    if (error != null) throw error;\n    if (name != kJoinHostCallable) throw StateError('unexpected $name');\n    final bool created = createdFirst && !_created;\n    _created = true;\n    return <String, Object?>{\n      'partyId': payload['partyId'],\n      'deviceId': payload['deviceId'],\n      'channelId': payload['channelId'],\n      'role': 'host',\n      'status': 'active',\n      'created': created,\n    };\n  }\n}\n\n/// Fake host-media boundary: backend-faithful seed catalog behavior.\nfinal class FakeHostMediaInvoker implements HostMediaCallableInvoker {\n  final List<String> names = <String>[];\n  final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];\n  final List<Map<String, Object?>> seeds = <Map<String, Object?>>[];\n  Object? failure;\n  int previews = 0;\n\n  static Map<String, Object?> seedJson(String id, String status) =>\n      <String, Object?>{\n        'seedId': id,\n        'partyId': 'party-1',\n        'channelId': 'cctv',\n        'status': status,\n        'jobId': 'hv-$id',\n        'createdAt': '2026-10-29T14:00:00.000Z',\n        'expiresAt': '2030-01-01T00:00:00.000Z',\n        'previewAvailable': status == 'ready',\n        'cameraIds': const <String>[\n          'CAM-01',\n          'CAM-02',\n          'CAM-03',\n          'CAM-04',\n        ],\n      };\n\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\n    names.add(name);\n    payloads.add(Map<String, Object?>.of(payload));\n    final Object? error = failure;\n    if (error != null) throw error;\n    switch (name) {\n      case kListHostVideos:\n        return <String, Object?>{\n          'videos': <Object?>[\n            for (final s in seeds) Map<String, Object?>.of(s),\n          ],\n        };\n      case kGenerateHostVideo:\n        final String seedId = payload['seedId'] as String;\n        final bool exists = seeds.any((s) => s['seedId'] == seedId);\n        if (!exists) {\n          seeds.add(seedJson(seedId, 'queued'));\n          return <String, Object?>{\n            'seedId': seedId,\n            'jobId': 'hv-$seedId',\n            'state': 'queued',\n            'created': true,\n          };\n        }\n        return <String, Object?>{\n          'seedId': seedId,\n          'jobId': 'hv-$seedId',\n          'state': 'queued',\n          'created': false,\n        };\n      case kGetHostVideoPreview:\n        previews++;\n        final String seedId = payload['seedId'] as String;\n        return <String, Object?>{\n          'seedId': seedId,\n          'expiresAt': '2030-01-01T00:00:00.000Z',\n          'clips': <Object?>[\n            for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\n              <String, Object?>{\n                'cameraId': camera,\n                'sha256': List.filled(64, 'a').join(),\n                'url': 'https://preview.example/$seedId/$camera.mp4',\n                'expiresAt': '2030-01-01T00:00:00.000Z',\n              },\n          ],\n        };\n      case kDeleteHostVideo:\n        final List<String> ids = <String>[\n          for (final Object? id in payload['seedIds'] as List) id.toString(),\n        ];\n        seeds.removeWhere((s) => ids.contains(s['seedId']));\n        return <String, Object?>{\n          'deletedSeedIds': ids,\n          'deletedObjects': <String>[\n            for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\n          ],\n          'revokedManifest': true,\n        };\n    }\n    throw StateError('unexpected callable $name');\n  }\n}\n\nfinal class FakeJoinInvoker implements PartyJoinCallableInvoker {\n  int calls = 0;\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\n    calls++;\n    return <String, Object?>{\n      'partyId': payload['partyId'],\n      'deviceId': payload['deviceId'],\n      'channelId': payload['channelId'],\n      'role': 'guest',\n      'status': 'active',\n      'created': true,\n    };\n  }\n}\n\nfinal class FakeManifestInvoker implements FirebaseManifestCallableInvoker {\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) async =>\n      throw UnimplementedError();\n}\n\nfinal class FakeManifestSource implements ManifestSource<PlaybackManifest> {\n  @override\n  Stream<PlaybackManifest> watchCurrent({\n    required String partyId,\n    required String channelId,\n  }) => const Stream<PlaybackManifest>.empty();\n}\n\nfinal class FakeScanner implements JoinPayloadScanner {\n  FakeScanner(this.result);\n  final JoinPayloadScanResult result;\n  @override\n  Future<JoinPayloadScanResult> scan([BuildContext? context]) async => result;\n}\n\nFuture<void> flush(WidgetTester tester) async {\n  for (int i = 0; i < 6; i++) {\n    await tester.pump(const Duration(milliseconds: 50));\n  }\n}\n\nFuture<void> enterVisible(\n  WidgetTester tester,\n  Finder finder,\n  String text,\n) async {\n  await tester.ensureVisible(finder);\n  await tester.pump(const Duration(milliseconds: 50));\n  await tester.enterText(finder, text);\n}\n\nFuture<void> tapVisible(WidgetTester tester, Finder finder) async {\n  await tester.ensureVisible(finder);\n  await tester.pump(const Duration(milliseconds: 50));\n  await tester.tap(finder);\n}\n\nvoid main() {\n  TestWidgetsFlutterBinding.ensureInitialized();\n\n  group('host session (real session, fake invoker boundary)', () {\n    late FakeHostJoinInvoker joinInvoker;\n    late FakeHostMediaInvoker mediaInvoker;\n    final List<HostSession> sessions = <HostSession>[];\n\n    HostSession openSession() {\n      final HostSession session = HostSession(\n        joinClient: HostJoinClient(invoker: joinInvoker),\n        mediaClient: HostMediaClient(invoker: mediaInvoker),\n      );\n      sessions.add(session);\n      return session;\n    }\n\n    setUp(() {\n      joinInvoker = FakeHostJoinInvoker();\n      mediaInvoker = FakeHostMediaInvoker()\n        ..seeds.addAll(<Map<String, Object?>>[\n          FakeHostMediaInvoker.seedJson('catalog-1', 'ready'),\n          FakeHostMediaInvoker.seedJson('catalog-2', 'queued'),\n        ]);\n    });\n\n    tearDown(() async {\n      for (final HostSession session in sessions) {\n        await session.dispose();\n      }\n      sessions.clear();\n    });\n\n    test('join validates scope and loads the catalog', () async {\n      final HostSession session = openSession();\n      await session.join(hostData());\n      expect(session.state.status, HostSessionStatus.ready);\n      expect(session.state.binding?.deviceId.value, kHostDeviceId);\n      expect(\n        session.videos.map((v) => '${v.seedId}:${v.status}'),\n        <String>['catalog-1:ready', 'catalog-2:queued'],\n      );\n      expect(joinInvoker.lastPayload, <String, Object?>{\n        'partyId': 'party-1',\n        'deviceId': kHostDeviceId,\n        'channelId': 'cctv',\n        'inviteToken': kHostToken,\n      });\n      expect(joinInvoker.lastPayload, isNot(contains('role')));\n    });\n\n    test('guest payloads never reach joinHost', () async {\n      final HostSession session = openSession();\n      final Result<GuestJoinData> parsed = parseGuestJoinPayload(\n        '{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}',\n        localDeviceId: kGuestDeviceId,\n      );\n      final GuestJoinData guest = (parsed as Ok<GuestJoinData>).value;\n      await expectLater(\n        session.join(guest),\n        throwsA(isA<HostJoinException>()),\n      );\n      expect(joinInvoker.calls, 0);\n      expect(session.state.status, HostSessionStatus.idle);\n    });\n\n    test('host denial surfaces the denied state with a sanitized message',\n        () async {\n      joinInvoker.failure = FirebaseFunctionsException(\n        code: 'permission-denied',\n        message: 'raw backend detail must never surface',\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n      );\n      final HostSession session = openSession();\n      await expectLater(session.join(hostData()), throwsA(\n        predicate<HostJoinException>(\n          (e) =>\n              e.message == 'Access was denied.' &&\n              !e.message.contains('raw backend'),\n        ),\n      ));\n      expect(session.state.status, HostSessionStatus.denied);\n      expect(session.state.message, 'Access was denied.');\n    });\n\n    test('scope mismatch fails visibly as invalid data', () async {\n      joinInvoker.failure = <String, Object?>{\n        'partyId': 'other-party',\n        'deviceId': kHostDeviceId,\n        'channelId': 'cctv',\n        'role': 'host',\n        'status': 'active',\n        'created': true,\n      };\n      final HostSession session = openSession();\n      await expectLater(\n        session.join(hostData()),\n        throwsA(isA<HostJoinException>()),\n      );\n      expect(session.state.status, HostSessionStatus.invalidData);\n    });\n\n    test('generation retries reuse a stable idempotency key', () async {\n      final HostSession session = openSession();\n      await session.join(hostData());\n      mediaInvoker.payloads.clear();\n      await session.generate('catalog-9');\n      await session.generate('catalog-9');\n      final List<String> keys = <String>[\n        for (final p in mediaInvoker.payloads.where(\n          (p) => p['seedId'] == 'catalog-9',\n        ))\n          (mediaInvoker.names[mediaInvoker.payloads.indexOf(p)] ==\n                  kGenerateHostVideo)\n              ? p['idempotencyKey'].toString()\n              : '',\n      ].where((k) => k.isNotEmpty).toList();\n      expect(keys, hasLength(2));\n      expect(keys[0], isNotEmpty);\n      expect(keys[1], keys[0]);\n    });\n\n    test('delete reconciles only after authoritative success', () async {\n      final HostSession session = openSession();\n      await session.join(hostData());\n      expect(session.videos.map((v) => v.seedId), <String>[\n        'catalog-1',\n        'catalog-2',\n      ]);\n      await session.deleteVideos(const <String>['catalog-1']);\n      expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\n      mediaInvoker.failure = FirebaseFunctionsException(\n        code: 'permission-denied',\n        message: 'denied',\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n      );\n      await expectLater(\n        session.deleteVideos(const <String>['catalog-2']),\n        throwsA(isA<ManifestTransportException>()),\n      );\n      // Failure leaves the list untouched: still retryable.\n      expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\n    });\n\n    test('leaving drops late responses from a superseded refresh', () async {\n      final Completer<Map<String, Object?>> gate =\n          Completer<Map<String, Object?>>();\n      final HostSession session = HostSession(\n        joinClient: HostJoinClient(invoker: joinInvoker),\n        mediaClient: HostMediaClient(\n          invoker: _GatedListInvoker(mediaInvoker, gate.future),\n        ),\n      );\n      sessions.add(session);\n      await session.join(hostData());\n      expect(session.state.status, HostSessionStatus.ready);\n      final Future<void> pending = session.refresh();\n      await session.leave();\n      gate.complete(<String, Object?>{\n        'videos': <Object?>[],\n      });\n      await pending;\n      await Future<void>.delayed(Duration.zero);\n      expect(session.state.status, HostSessionStatus.idle);\n      expect(session.videos, isEmpty);\n    });\n\n    test('suspend stops polling and resume refreshes', () async {\n      final HostSession session = openSession();\n      await session.join(hostData());\n      final int lists = mediaInvoker.names\n          .where((n) => n == kListHostVideos)\n          .length;\n      await session.suspend();\n      expect(session.state.status, HostSessionStatus.stale);\n      expect(session.videos, hasLength(2));\n      await session.resume();\n      expect(\n        mediaInvoker.names.where((n) => n == kListHostVideos).length,\n        lists + 1,\n      );\n      expect(session.state.status, HostSessionStatus.ready);\n    });\n  });\n\n  group('host entry screen (real parser, fake scanner boundary)', () {\n    Future<void> pumpEntry(\n      WidgetTester tester, {\n      required void Function(GuestJoinData data) onHostJoin,\n      JoinPayloadScanner scanner = const UnavailableJoinPayloadScanner(),\n    }) async {\n      SharedPreferences.setMockInitialValues(<String, Object>{\n        DeviceIdentityStore.hostStorageKey: kHostDeviceId,\n        DeviceIdentityStore.storageKey: kGuestDeviceId,\n      });\n      await tester.pumpWidget(\n        MaterialApp(\n          home: HostEntryScreen(\n            onHostJoin: (data) async => onHostJoin(data),\n            onJoinAsGuest: () {},\n            scanner: scanner,\n          ),\n        ),\n      );\n      await tester.pumpAndSettle();\n    }\n\n    testWidgets('boot offers scan, paste, retry, and a guest route',\n        (tester) async {\n      GuestJoinData? received;\n      await pumpEntry(tester, onHostJoin: (data) => received = data);\n      expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n      expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\n      expect(find.byKey(HostEntryScreen.submitKey), findsOneWidget);\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n      expect(received, isNull);\n      expect(tester.takeException(), isNull);\n    });\n\n    testWidgets('scan and paste reach the same host payload (parity)',\n        (tester) async {\n      GuestJoinData? scanned;\n      await pumpEntry(\n        tester,\n        onHostJoin: (data) => scanned = data,\n        scanner: FakeScanner(JoinPayloadText(hostPayload())),\n      );\n      await tester.tap(find.byKey(HostEntryScreen.scanKey));\n      await tester.pumpAndSettle();\n\n      GuestJoinData? pasted;\n      await pumpEntry(tester, onHostJoin: (data) => pasted = data);\n      await tester.enterText(\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        hostPayload(),\n      );\n      await tester.tap(find.byKey(HostEntryScreen.submitKey));\n      await tester.pumpAndSettle();\n\n      expect(scanned, isNotNull);\n      expect(pasted, isNotNull);\n      expect(scanned, pasted);\n      expect(scanned?.role, JoinRole.host);\n      expect(scanned?.inviteToken, kHostToken);\n      // The host phone identity is separate from the guest identity.\n      expect(scanned?.deviceId.value, kHostDeviceId);\n      expect(scanned?.deviceId.value, isNot(kGuestDeviceId));\n      expect(tester.takeException(), isNull);\n    });\n\n    testWidgets('guest payloads fail visibly without network', (tester) async {\n      var joined = false;\n      await pumpEntry(\n        tester,\n        onHostJoin: (_) => joined = true,\n        scanner: FakeScanner(\n          const JoinPayloadText('{\"partyId\":\"p\",\"channelId\":\"c\"}'),\n        ),\n      );\n      await tester.tap(find.byKey(HostEntryScreen.scanKey));\n      await tester.pumpAndSettle();\n      expect(joined, isFalse);\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n      expect(find.textContaining('Join as guest'), findsWidgets);\n    });\n\n    testWidgets('unknown roles fail visibly', (tester) async {\n      var joined = false;\n      await pumpEntry(tester, onHostJoin: (_) => joined = true);\n      await tester.enterText(\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        '{\"partyId\":\"p\",\"channelId\":\"c\",\"role\":\"admin\"}',\n      );\n      await tester.tap(find.byKey(HostEntryScreen.submitKey));\n      await tester.pumpAndSettle();\n      expect(joined, isFalse);\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n      expect(find.textContaining('role'), findsOneWidget);\n    });\n\n    testWidgets('legacy guest payloads route to the guest form, not host',\n        (tester) async {\n      GuestJoinData? received;\n      SharedPreferences.setMockInitialValues(<String, Object>{\n        DeviceIdentityStore.storageKey: kGuestDeviceId,\n      });\n      await tester.pumpWidget(\n        MaterialApp(\n          home: JoinScreen(\n            onJoin: (data) async => received = data,\n          ),\n        ),\n      );\n      await tester.pumpAndSettle();\n      await tester.enterText(\n        find.byKey(JoinScreen.payloadFieldKey),\n        '{\"partyId\":\"legacy\",\"channelId\":\"cctv\"}',\n      );\n      await tester.tap(find.byKey(JoinScreen.submitKey));\n      await tester.pumpAndSettle();\n      expect(received?.role, JoinRole.guest);\n      expect(received?.partyId.value, 'legacy');\n    });\n  });\n\n  group('host panel screen (real session, fake invoker boundary)', () {\n    late FakeHostJoinInvoker joinInvoker;\n    late FakeHostMediaInvoker mediaInvoker;\n\n    Future<HostSession> joinedSession() async {\n      final HostSession session = HostSession(\n        joinClient: HostJoinClient(invoker: joinInvoker),\n        mediaClient: HostMediaClient(invoker: mediaInvoker),\n      );\n      addTearDown(session.dispose);\n      await session.join(hostData());\n      return session;\n    }\n\n    Future<void> pumpPanel(\n      WidgetTester tester,\n      HostSession session, {\n      void Function(String seedId)? onPreview,\n    }) async {\n      await tester.pumpWidget(\n        MaterialApp(\n          home: HostPanelScreen(\n            session: session,\n            onLeave: () async {},\n            onPreview: onPreview ?? (_) {},\n          ),\n        ),\n      );\n      await flush(tester);\n    }\n\n    setUp(() {\n      joinInvoker = FakeHostJoinInvoker();\n      mediaInvoker = FakeHostMediaInvoker();\n    });\n\n    testWidgets('lists empty, queued, ready, failed, and deleted states',\n        (tester) async {\n      mediaInvoker.seeds.addAll(<Map<String, Object?>>[\n        FakeHostMediaInvoker.seedJson('q', 'queued'),\n        FakeHostMediaInvoker.seedJson('r', 'ready'),\n        FakeHostMediaInvoker.seedJson('f', 'failed'),\n        FakeHostMediaInvoker.seedJson('d', 'deleted'),\n      ]);\n      await pumpPanel(tester, await joinedSession());\n      expect(find.textContaining('q · Queued'), findsOneWidget);\n      expect(find.textContaining('r · Ready'), findsOneWidget);\n      expect(find.textContaining('f · Failed'), findsOneWidget);\n      expect(find.textContaining('d · Deleted'), findsOneWidget);\n      // Deleted seeds offer no actions; live ones offer view + delete.\n      expect(find.byKey(HostPanelScreen.viewKey('d')), findsNothing);\n      expect(find.byKey(HostPanelScreen.deleteKey('d')), findsNothing);\n      expect(find.byKey(HostPanelScreen.viewKey('r')), findsOneWidget);\n      expect(find.byKey(HostPanelScreen.deleteKey('r')), findsOneWidget);\n      expect(tester.takeException(), isNull);\n    });\n\n    testWidgets('empty catalog explains itself and generates', (tester) async {\n      await pumpPanel(tester, await joinedSession());\n      expect(find.byKey(HostPanelScreen.emptyKey), findsOneWidget);\n      await enterVisible(\n        tester,\n        find.byKey(HostPanelScreen.generateSeedKey),\n        'catalog-new',\n      );\n      await tapVisible(tester, find.byKey(HostPanelScreen.generateKey));\n      await flush(tester);\n      expect(find.textContaining('catalog-new · Queued'), findsOneWidget);\n      expect(\n        mediaInvoker.payloads\n            .where((p) => p['seedId'] == 'catalog-new')\n            .map((p) => p['presetId']),\n        <String>[kCheapDemoPresetId],\n      );\n    });\n\n    testWidgets('delete success reconciles; failure stays retryable',\n        (tester) async {\n      mediaInvoker.seeds.addAll(<Map<String, Object?>>[\n        FakeHostMediaInvoker.seedJson('a', 'ready'),\n        FakeHostMediaInvoker.seedJson('b', 'ready'),\n      ]);\n      await pumpPanel(tester, await joinedSession());\n      await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('a')));\n      await flush(tester);\n      expect(find.textContaining('a · Ready'), findsNothing);\n      expect(find.textContaining('b · Ready'), findsOneWidget);\n      mediaInvoker.failure = FirebaseFunctionsException(\n        code: 'permission-denied',\n        message: 'denied',\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n      );\n      await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('b')));\n      await flush(tester);\n      expect(find.byKey(HostPanelScreen.messageKey), findsOneWidget);\n      expect(find.textContaining('b · Ready'), findsOneWidget);\n    });\n\n    testWidgets('view opens the preview callback per seed', (tester) async {\n      mediaInvoker.seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n      String? viewed;\n      await pumpPanel(\n        tester,\n        await joinedSession(),\n        onPreview: (seedId) => viewed = seedId,\n      );\n      await tapVisible(tester, find.byKey(HostPanelScreen.viewKey('v')));\n      await flush(tester);\n      expect(viewed, 'v');\n    });\n  });\n\n  group('host preview screen (real session, fake media boundary)', () {\n    testWidgets('obtains a fresh capability and disposes playback resources',\n        (tester) async {\n      final FakeHostJoinInvoker joinInvoker = FakeHostJoinInvoker();\n      final FakeHostMediaInvoker mediaInvoker = FakeHostMediaInvoker()\n        ..seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\n      final HostSession session = HostSession(\n        joinClient: HostJoinClient(invoker: joinInvoker),\n        mediaClient: HostMediaClient(invoker: mediaInvoker),\n      );\n      addTearDown(session.dispose);\n      await session.join(hostData());\n\n      await tester.pumpWidget(\n        MaterialApp(\n          home: HostVideoPreviewScreen(session: session, seedId: 'v'),\n        ),\n      );\n      await flush(tester);\n      // Fresh scoped capability per view: exactly one preview call.\n      expect(mediaInvoker.previews, 1);\n      for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04']) {\n        expect(\n          find.byKey(HostVideoPreviewScreen.playKey(camera)),\n          findsOneWidget,\n        );\n      }\n      // Playing without a platform plugin surfaces a visible error through\n      // the real controller path (create -> initialize -> dispose).\n      await tapVisible(\n        tester,\n        find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\n      );\n      await flush(tester);\n      expect(find.byKey(HostVideoPreviewScreen.errorKey), findsOneWidget);\n      // Leaving disposes playback resources without exceptions.\n      await tester.pumpWidget(const SizedBox());\n      await flush(tester);\n      expect(tester.takeException(), isNull);\n      expect(mediaInvoker.previews, 1);\n    });\n  });\n\n  group('companion app host flow (production-path routing)', () {\n    late FakeHostJoinInvoker joinInvoker;\n    late FakeHostMediaInvoker mediaInvoker;\n    late FakeJoinInvoker guestJoinInvoker;\n    late FakeManifestInvoker manifestInvoker;\n\n    Future<void> pumpHostApp(WidgetTester tester) async {\n      SharedPreferences.setMockInitialValues(<String, Object>{\n        DeviceIdentityStore.storageKey: kGuestDeviceId,\n        DeviceIdentityStore.hostStorageKey: kHostDeviceId,\n      });\n      await tester.pumpWidget(\n        CompanionApp(\n          config: BackendConfig.parse(<String, Object?>{\n            'apiKey': 'test-api-key',\n            'appId': '1:123:android:abc',\n            'projectId': 'test-project',\n          }),\n          firebaseBootstrap: (_) async {},\n          invokerOverride: manifestInvoker,\n          partyJoinInvokerOverride: guestJoinInvoker,\n          hostJoinInvokerOverride: joinInvoker,\n          hostMediaInvokerOverride: mediaInvoker,\n          clock: SystemClock(),\n        ),\n      );\n      await flush(tester);\n    }\n\n    setUp(() {\n      joinInvoker = FakeHostJoinInvoker();\n      mediaInvoker = FakeHostMediaInvoker()\n        ..seeds.add(FakeHostMediaInvoker.seedJson('catalog-1', 'ready'));\n      guestJoinInvoker = FakeJoinInvoker();\n      manifestInvoker = FakeManifestInvoker();\n    });\n\n    testWidgets('host invite redeems into the panel only after validation',\n        (tester) async {\n      await pumpHostApp(tester);\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n      await enterVisible(\n        tester,\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        hostPayload(),\n      );\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n      await flush(tester);\n      // Scope validated -> panel with the server-backed catalog.\n      expect(find.byType(HostPanelScreen), findsOneWidget);\n      expect(find.textContaining('catalog-1 · Ready'), findsOneWidget);\n      expect(guestJoinInvoker.calls, 0);\n      expect(tester.takeException(), isNull);\n    });\n\n    testWidgets('host denial fails visibly on the entry screen', (\n      tester,\n    ) async {\n      joinInvoker.failure = FirebaseFunctionsException(\n        code: 'permission-denied',\n        message: 'raw detail must never surface',\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\n      );\n      await pumpHostApp(tester);\n      await enterVisible(\n        tester,\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        hostPayload(),\n      );\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n      await flush(tester);\n      expect(find.byType(HostPanelScreen), findsNothing);\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n      expect(find.text('Access was denied.'), findsOneWidget);\n      expect(find.textContaining('raw detail'), findsNothing);\n    });\n\n    testWidgets('guest payload on host entry never touches joinHost', (\n      tester,\n    ) async {\n      await pumpHostApp(tester);\n      await enterVisible(\n        tester,\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        '{\"partyId\":\"party-1\",\"channelId\":\"cctv\"}',\n      );\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n      await flush(tester);\n      expect(joinInvoker.calls, 0);\n      expect(find.byType(HostPanelScreen), findsNothing);\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n    });\n\n    testWidgets('leave returns to the dedicated entry', (tester) async {\n      await pumpHostApp(tester);\n      await enterVisible(\n        tester,\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        hostPayload(),\n      );\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n      await flush(tester);\n      expect(find.byType(HostPanelScreen), findsOneWidget);\n      await tapVisible(tester, find.byKey(HostPanelScreen.leaveKey));\n      await flush(tester);\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n      expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n    });\n\n    testWidgets('offline boot stays usable without network calls', (\n      tester,\n    ) async {\n      SharedPreferences.setMockInitialValues(<String, Object>{});\n      await tester.pumpWidget(const CompanionApp());\n      await flush(tester);\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\n      expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\n      // Submitting a host payload offline fails visibly, with no invoker\n      // available and no network attempted.\n      await enterVisible(\n        tester,\n        find.byKey(HostEntryScreen.payloadFieldKey),\n        hostPayload(),\n      );\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\n      await flush(tester);\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\n      expect(find.byType(HostPanelScreen), findsNothing);\n    });\n  });\n}\n\n/// Forwards list calls to [gate] so tests can interleave leave/refresh and\n/// prove stale responses are dropped; every other callable delegates.\nfinal class _GatedListInvoker implements HostMediaCallableInvoker {\n  _GatedListInvoker(this._inner, this._gate);\n  final FakeHostMediaInvoker _inner;\n  final Future<Map<String, Object?>> _gate;\n\n  @override\n  Future<Object?> call(String name, Map<String, Object?> payload) {\n    if (name == kListHostVideos) return _gate;\n    return _inner.call(name, payload);\n  }\n}\n","path":"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/host_flow_test.dart"},"output":"Created file successfully: apps/companion_app/test/host_flow_test.dart","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: apps/companion_app/test/host_flow_test.dart"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192ae208876dfaa3b7b8b9df33d5d"}},"providerResult":{"executed":false},"rawInput":"{\"content\":\"// Host-first navigation, role-aware joining, and video administration.\\n//\\n// Exercises the REAL parser (guest_join_data role validation), the REAL\\n// HostEntryScreen/JoinScreen routing, the REAL HostSession state machine,\\n// and REAL response validation (HostJoinClient/HostMediaClient). ONLY the\\n// platform/network boundaries are substituted: fake callable invokers\\n// (never the clients, never the session) and fake scanners. No Firebase\\n// initialization, no network traffic.\\n\\nimport 'dart:async';\\n\\nimport 'package:channel_api/channel_api.dart';\\nimport 'package:cloud_functions/cloud_functions.dart';\\nimport 'package:companion_app/src/companion_app.dart';\\nimport 'package:companion_app/src/config/backend_config.dart';\\nimport 'package:companion_app/src/data/host_join_client.dart';\\nimport 'package:companion_app/src/data/host_media_client.dart';\\nimport 'package:companion_app/src/data/party_join_client.dart';\\nimport 'package:companion_app/src/join/device_identity_store.dart';\\nimport 'package:companion_app/src/join/guest_join_data.dart';\\nimport 'package:companion_app/src/join/join_payload_scanner.dart';\\nimport 'package:companion_app/src/session/host_session.dart';\\nimport 'package:companion_app/src/ui/host_entry_screen.dart';\\nimport 'package:companion_app/src/ui/host_panel_screen.dart';\\nimport 'package:companion_app/src/ui/host_video_preview_screen.dart';\\nimport 'package:companion_app/src/ui/join_screen.dart';\\nimport 'package:core_foundation/core_foundation.dart';\\nimport 'package:core_playlist/core_playlist.dart';\\nimport 'package:flutter/material.dart';\\nimport 'package:flutter_test/flutter_test.dart';\\nimport 'package:infra_firestore/infra_firestore.dart'\\n    show FirebaseManifestCallableInvoker;\\nimport 'package:shared_preferences/shared_preferences.dart';\\n\\nconst String kGuestDeviceId = 'p-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';\\nconst String kHostDeviceId = 'p-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';\\nconst String kHostToken =\\n    'hi-0123456789abcdef0123456789abcdef0123456789abcdef01';\\n\\nString hostPayload({\\n  String party = 'party-1',\\n  String channel = 'cctv',\\n  String token = kHostToken,\\n}) =>\\n    '{\\\"partyId\\\":\\\"$party\\\",\\\"channelId\\\":\\\"$channel\\\",\\\"role\\\":\\\"host\\\",'\\n    '\\\"inviteToken\\\":\\\"$token\\\"}';\\n\\nGuestJoinData hostData({\\n  String party = 'party-1',\\n  String channel = 'cctv',\\n  String device = kHostDeviceId,\\n  String token = kHostToken,\\n}) {\\n  final Result<GuestJoinData> result = parseGuestJoinFields(\\n    partyId: party,\\n    localDeviceId: device,\\n    channelId: channel,\\n    role: JoinRole.host,\\n    inviteToken: token,\\n  );\\n  return (result as Ok<GuestJoinData>).value;\\n}\\n\\n/// Fake joinHost boundary: echoes the requested scope into a valid host\\n/// registration, or throws [failure] to script denial paths.\\nfinal class FakeHostJoinInvoker implements HostJoinCallableInvoker {\\n  int calls = 0;\\n  Map<String, Object?>? lastPayload;\\n  Object? failure;\\n  bool createdFirst = true;\\n  bool _created = false;\\n\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\\n    calls++;\\n    lastPayload = Map<String, Object?>.of(payload);\\n    final Object? error = failure;\\n    if (error != null) throw error;\\n    if (name != kJoinHostCallable) throw StateError('unexpected $name');\\n    final bool created = createdFirst && !_created;\\n    _created = true;\\n    return <String, Object?>{\\n      'partyId': payload['partyId'],\\n      'deviceId': payload['deviceId'],\\n      'channelId': payload['channelId'],\\n      'role': 'host',\\n      'status': 'active',\\n      'created': created,\\n    };\\n  }\\n}\\n\\n/// Fake host-media boundary: backend-faithful seed catalog behavior.\\nfinal class FakeHostMediaInvoker implements HostMediaCallableInvoker {\\n  final List<String> names = <String>[];\\n  final List<Map<String, Object?>> payloads = <Map<String, Object?>>[];\\n  final List<Map<String, Object?>> seeds = <Map<String, Object?>>[];\\n  Object? failure;\\n  int previews = 0;\\n\\n  static Map<String, Object?> seedJson(String id, String status) =>\\n      <String, Object?>{\\n        'seedId': id,\\n        'partyId': 'party-1',\\n        'channelId': 'cctv',\\n        'status': status,\\n        'jobId': 'hv-$id',\\n        'createdAt': '2026-10-29T14:00:00.000Z',\\n        'expiresAt': '2030-01-01T00:00:00.000Z',\\n        'previewAvailable': status == 'ready',\\n        'cameraIds': const <String>[\\n          'CAM-01',\\n          'CAM-02',\\n          'CAM-03',\\n          'CAM-04',\\n        ],\\n      };\\n\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\\n    names.add(name);\\n    payloads.add(Map<String, Object?>.of(payload));\\n    final Object? error = failure;\\n    if (error != null) throw error;\\n    switch (name) {\\n      case kListHostVideos:\\n        return <String, Object?>{\\n          'videos': <Object?>[\\n            for (final s in seeds) Map<String, Object?>.of(s),\\n          ],\\n        };\\n      case kGenerateHostVideo:\\n        final String seedId = payload['seedId'] as String;\\n        final bool exists = seeds.any((s) => s['seedId'] == seedId);\\n        if (!exists) {\\n          seeds.add(seedJson(seedId, 'queued'));\\n          return <String, Object?>{\\n            'seedId': seedId,\\n            'jobId': 'hv-$seedId',\\n            'state': 'queued',\\n            'created': true,\\n          };\\n        }\\n        return <String, Object?>{\\n          'seedId': seedId,\\n          'jobId': 'hv-$seedId',\\n          'state': 'queued',\\n          'created': false,\\n        };\\n      case kGetHostVideoPreview:\\n        previews++;\\n        final String seedId = payload['seedId'] as String;\\n        return <String, Object?>{\\n          'seedId': seedId,\\n          'expiresAt': '2030-01-01T00:00:00.000Z',\\n          'clips': <Object?>[\\n            for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04'])\\n              <String, Object?>{\\n                'cameraId': camera,\\n                'sha256': List.filled(64, 'a').join(),\\n                'url': 'https://preview.example/$seedId/$camera.mp4',\\n                'expiresAt': '2030-01-01T00:00:00.000Z',\\n              },\\n          ],\\n        };\\n      case kDeleteHostVideo:\\n        final List<String> ids = <String>[\\n          for (final Object? id in payload['seedIds'] as List) id.toString(),\\n        ];\\n        seeds.removeWhere((s) => ids.contains(s['seedId']));\\n        return <String, Object?>{\\n          'deletedSeedIds': ids,\\n          'deletedObjects': <String>[\\n            for (final id in ids) 'parties/party-1/hostPreviews/$id/CAM-01.mp4',\\n          ],\\n          'revokedManifest': true,\\n        };\\n    }\\n    throw StateError('unexpected callable $name');\\n  }\\n}\\n\\nfinal class FakeJoinInvoker implements PartyJoinCallableInvoker {\\n  int calls = 0;\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async {\\n    calls++;\\n    return <String, Object?>{\\n      'partyId': payload['partyId'],\\n      'deviceId': payload['deviceId'],\\n      'channelId': payload['channelId'],\\n      'role': 'guest',\\n      'status': 'active',\\n      'created': true,\\n    };\\n  }\\n}\\n\\nfinal class FakeManifestInvoker implements FirebaseManifestCallableInvoker {\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) async =>\\n      throw UnimplementedError();\\n}\\n\\nfinal class FakeManifestSource implements ManifestSource<PlaybackManifest> {\\n  @override\\n  Stream<PlaybackManifest> watchCurrent({\\n    required String partyId,\\n    required String channelId,\\n  }) => const Stream<PlaybackManifest>.empty();\\n}\\n\\nfinal class FakeScanner implements JoinPayloadScanner {\\n  FakeScanner(this.result);\\n  final JoinPayloadScanResult result;\\n  @override\\n  Future<JoinPayloadScanResult> scan([BuildContext? context]) async => result;\\n}\\n\\nFuture<void> flush(WidgetTester tester) async {\\n  for (int i = 0; i < 6; i++) {\\n    await tester.pump(const Duration(milliseconds: 50));\\n  }\\n}\\n\\nFuture<void> enterVisible(\\n  WidgetTester tester,\\n  Finder finder,\\n  String text,\\n) async {\\n  await tester.ensureVisible(finder);\\n  await tester.pump(const Duration(milliseconds: 50));\\n  await tester.enterText(finder, text);\\n}\\n\\nFuture<void> tapVisible(WidgetTester tester, Finder finder) async {\\n  await tester.ensureVisible(finder);\\n  await tester.pump(const Duration(milliseconds: 50));\\n  await tester.tap(finder);\\n}\\n\\nvoid main() {\\n  TestWidgetsFlutterBinding.ensureInitialized();\\n\\n  group('host session (real session, fake invoker boundary)', () {\\n    late FakeHostJoinInvoker joinInvoker;\\n    late FakeHostMediaInvoker mediaInvoker;\\n    final List<HostSession> sessions = <HostSession>[];\\n\\n    HostSession openSession() {\\n      final HostSession session = HostSession(\\n        joinClient: HostJoinClient(invoker: joinInvoker),\\n        mediaClient: HostMediaClient(invoker: mediaInvoker),\\n      );\\n      sessions.add(session);\\n      return session;\\n    }\\n\\n    setUp(() {\\n      joinInvoker = FakeHostJoinInvoker();\\n      mediaInvoker = FakeHostMediaInvoker()\\n        ..seeds.addAll(<Map<String, Object?>>[\\n          FakeHostMediaInvoker.seedJson('catalog-1', 'ready'),\\n          FakeHostMediaInvoker.seedJson('catalog-2', 'queued'),\\n        ]);\\n    });\\n\\n    tearDown(() async {\\n      for (final HostSession session in sessions) {\\n        await session.dispose();\\n      }\\n      sessions.clear();\\n    });\\n\\n    test('join validates scope and loads the catalog', () async {\\n      final HostSession session = openSession();\\n      await session.join(hostData());\\n      expect(session.state.status, HostSessionStatus.ready);\\n      expect(session.state.binding?.deviceId.value, kHostDeviceId);\\n      expect(\\n        session.videos.map((v) => '${v.seedId}:${v.status}'),\\n        <String>['catalog-1:ready', 'catalog-2:queued'],\\n      );\\n      expect(joinInvoker.lastPayload, <String, Object?>{\\n        'partyId': 'party-1',\\n        'deviceId': kHostDeviceId,\\n        'channelId': 'cctv',\\n        'inviteToken': kHostToken,\\n      });\\n      expect(joinInvoker.lastPayload, isNot(contains('role')));\\n    });\\n\\n    test('guest payloads never reach joinHost', () async {\\n      final HostSession session = openSession();\\n      final Result<GuestJoinData> parsed = parseGuestJoinPayload(\\n        '{\\\"partyId\\\":\\\"party-1\\\",\\\"channelId\\\":\\\"cctv\\\"}',\\n        localDeviceId: kGuestDeviceId,\\n      );\\n      final GuestJoinData guest = (parsed as Ok<GuestJoinData>).value;\\n      await expectLater(\\n        session.join(guest),\\n        throwsA(isA<HostJoinException>()),\\n      );\\n      expect(joinInvoker.calls, 0);\\n      expect(session.state.status, HostSessionStatus.idle);\\n    });\\n\\n    test('host denial surfaces the denied state with a sanitized message',\\n        () async {\\n      joinInvoker.failure = FirebaseFunctionsException(\\n        code: 'permission-denied',\\n        message: 'raw backend detail must never surface',\\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\\n      );\\n      final HostSession session = openSession();\\n      await expectLater(session.join(hostData()), throwsA(\\n        predicate<HostJoinException>(\\n          (e) =>\\n              e.message == 'Access was denied.' &&\\n              !e.message.contains('raw backend'),\\n        ),\\n      ));\\n      expect(session.state.status, HostSessionStatus.denied);\\n      expect(session.state.message, 'Access was denied.');\\n    });\\n\\n    test('scope mismatch fails visibly as invalid data', () async {\\n      joinInvoker.failure = <String, Object?>{\\n        'partyId': 'other-party',\\n        'deviceId': kHostDeviceId,\\n        'channelId': 'cctv',\\n        'role': 'host',\\n        'status': 'active',\\n        'created': true,\\n      };\\n      final HostSession session = openSession();\\n      await expectLater(\\n        session.join(hostData()),\\n        throwsA(isA<HostJoinException>()),\\n      );\\n      expect(session.state.status, HostSessionStatus.invalidData);\\n    });\\n\\n    test('generation retries reuse a stable idempotency key', () async {\\n      final HostSession session = openSession();\\n      await session.join(hostData());\\n      mediaInvoker.payloads.clear();\\n      await session.generate('catalog-9');\\n      await session.generate('catalog-9');\\n      final List<String> keys = <String>[\\n        for (final p in mediaInvoker.payloads.where(\\n          (p) => p['seedId'] == 'catalog-9',\\n        ))\\n          (mediaInvoker.names[mediaInvoker.payloads.indexOf(p)] ==\\n                  kGenerateHostVideo)\\n              ? p['idempotencyKey'].toString()\\n              : '',\\n      ].where((k) => k.isNotEmpty).toList();\\n      expect(keys, hasLength(2));\\n      expect(keys[0], isNotEmpty);\\n      expect(keys[1], keys[0]);\\n    });\\n\\n    test('delete reconciles only after authoritative success', () async {\\n      final HostSession session = openSession();\\n      await session.join(hostData());\\n      expect(session.videos.map((v) => v.seedId), <String>[\\n        'catalog-1',\\n        'catalog-2',\\n      ]);\\n      await session.deleteVideos(const <String>['catalog-1']);\\n      expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\\n      mediaInvoker.failure = FirebaseFunctionsException(\\n        code: 'permission-denied',\\n        message: 'denied',\\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\\n      );\\n      await expectLater(\\n        session.deleteVideos(const <String>['catalog-2']),\\n        throwsA(isA<ManifestTransportException>()),\\n      );\\n      // Failure leaves the list untouched: still retryable.\\n      expect(session.videos.map((v) => v.seedId), <String>['catalog-2']);\\n    });\\n\\n    test('leaving drops late responses from a superseded refresh', () async {\\n      final Completer<Map<String, Object?>> gate =\\n          Completer<Map<String, Object?>>();\\n      final HostSession session = HostSession(\\n        joinClient: HostJoinClient(invoker: joinInvoker),\\n        mediaClient: HostMediaClient(\\n          invoker: _GatedListInvoker(mediaInvoker, gate.future),\\n        ),\\n      );\\n      sessions.add(session);\\n      await session.join(hostData());\\n      expect(session.state.status, HostSessionStatus.ready);\\n      final Future<void> pending = session.refresh();\\n      await session.leave();\\n      gate.complete(<String, Object?>{\\n        'videos': <Object?>[],\\n      });\\n      await pending;\\n      await Future<void>.delayed(Duration.zero);\\n      expect(session.state.status, HostSessionStatus.idle);\\n      expect(session.videos, isEmpty);\\n    });\\n\\n    test('suspend stops polling and resume refreshes', () async {\\n      final HostSession session = openSession();\\n      await session.join(hostData());\\n      final int lists = mediaInvoker.names\\n          .where((n) => n == kListHostVideos)\\n          .length;\\n      await session.suspend();\\n      expect(session.state.status, HostSessionStatus.stale);\\n      expect(session.videos, hasLength(2));\\n      await session.resume();\\n      expect(\\n        mediaInvoker.names.where((n) => n == kListHostVideos).length,\\n        lists + 1,\\n      );\\n      expect(session.state.status, HostSessionStatus.ready);\\n    });\\n  });\\n\\n  group('host entry screen (real parser, fake scanner boundary)', () {\\n    Future<void> pumpEntry(\\n      WidgetTester tester, {\\n      required void Function(GuestJoinData data) onHostJoin,\\n      JoinPayloadScanner scanner = const UnavailableJoinPayloadScanner(),\\n    }) async {\\n      SharedPreferences.setMockInitialValues(<String, Object>{\\n        DeviceIdentityStore.hostStorageKey: kHostDeviceId,\\n        DeviceIdentityStore.storageKey: kGuestDeviceId,\\n      });\\n      await tester.pumpWidget(\\n        MaterialApp(\\n          home: HostEntryScreen(\\n            onHostJoin: (data) async => onHostJoin(data),\\n            onJoinAsGuest: () {},\\n            scanner: scanner,\\n          ),\\n        ),\\n      );\\n      await tester.pumpAndSettle();\\n    }\\n\\n    testWidgets('boot offers scan, paste, retry, and a guest route',\\n        (tester) async {\\n      GuestJoinData? received;\\n      await pumpEntry(tester, onHostJoin: (data) => received = data);\\n      expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\\n      expect(find.byKey(HostEntryScreen.payloadFieldKey), findsOneWidget);\\n      expect(find.byKey(HostEntryScreen.submitKey), findsOneWidget);\\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\\n      expect(received, isNull);\\n      expect(tester.takeException(), isNull);\\n    });\\n\\n    testWidgets('scan and paste reach the same host payload (parity)',\\n        (tester) async {\\n      GuestJoinData? scanned;\\n      await pumpEntry(\\n        tester,\\n        onHostJoin: (data) => scanned = data,\\n        scanner: FakeScanner(JoinPayloadText(hostPayload())),\\n      );\\n      await tester.tap(find.byKey(HostEntryScreen.scanKey));\\n      await tester.pumpAndSettle();\\n\\n      GuestJoinData? pasted;\\n      await pumpEntry(tester, onHostJoin: (data) => pasted = data);\\n      await tester.enterText(\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        hostPayload(),\\n      );\\n      await tester.tap(find.byKey(HostEntryScreen.submitKey));\\n      await tester.pumpAndSettle();\\n\\n      expect(scanned, isNotNull);\\n      expect(pasted, isNotNull);\\n      expect(scanned, pasted);\\n      expect(scanned?.role, JoinRole.host);\\n      expect(scanned?.inviteToken, kHostToken);\\n      // The host phone identity is separate from the guest identity.\\n      expect(scanned?.deviceId.value, kHostDeviceId);\\n      expect(scanned?.deviceId.value, isNot(kGuestDeviceId));\\n      expect(tester.takeException(), isNull);\\n    });\\n\\n    testWidgets('guest payloads fail visibly without network', (tester) async {\\n      var joined = false;\\n      await pumpEntry(\\n        tester,\\n        onHostJoin: (_) => joined = true,\\n        scanner: FakeScanner(\\n          const JoinPayloadText('{\\\"partyId\\\":\\\"p\\\",\\\"channelId\\\":\\\"c\\\"}'),\\n        ),\\n      );\\n      await tester.tap(find.byKey(HostEntryScreen.scanKey));\\n      await tester.pumpAndSettle();\\n      expect(joined, isFalse);\\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\\n      expect(find.textContaining('Join as guest'), findsWidgets);\\n    });\\n\\n    testWidgets('unknown roles fail visibly', (tester) async {\\n      var joined = false;\\n      await pumpEntry(tester, onHostJoin: (_) => joined = true);\\n      await tester.enterText(\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        '{\\\"partyId\\\":\\\"p\\\",\\\"channelId\\\":\\\"c\\\",\\\"role\\\":\\\"admin\\\"}',\\n      );\\n      await tester.tap(find.byKey(HostEntryScreen.submitKey));\\n      await tester.pumpAndSettle();\\n      expect(joined, isFalse);\\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\\n      expect(find.textContaining('role'), findsOneWidget);\\n    });\\n\\n    testWidgets('legacy guest payloads route to the guest form, not host',\\n        (tester) async {\\n      GuestJoinData? received;\\n      SharedPreferences.setMockInitialValues(<String, Object>{\\n        DeviceIdentityStore.storageKey: kGuestDeviceId,\\n      });\\n      await tester.pumpWidget(\\n        MaterialApp(\\n          home: JoinScreen(\\n            onJoin: (data) async => received = data,\\n          ),\\n        ),\\n      );\\n      await tester.pumpAndSettle();\\n      await tester.enterText(\\n        find.byKey(JoinScreen.payloadFieldKey),\\n        '{\\\"partyId\\\":\\\"legacy\\\",\\\"channelId\\\":\\\"cctv\\\"}',\\n      );\\n      await tester.tap(find.byKey(JoinScreen.submitKey));\\n      await tester.pumpAndSettle();\\n      expect(received?.role, JoinRole.guest);\\n      expect(received?.partyId.value, 'legacy');\\n    });\\n  });\\n\\n  group('host panel screen (real session, fake invoker boundary)', () {\\n    late FakeHostJoinInvoker joinInvoker;\\n    late FakeHostMediaInvoker mediaInvoker;\\n\\n    Future<HostSession> joinedSession() async {\\n      final HostSession session = HostSession(\\n        joinClient: HostJoinClient(invoker: joinInvoker),\\n        mediaClient: HostMediaClient(invoker: mediaInvoker),\\n      );\\n      addTearDown(session.dispose);\\n      await session.join(hostData());\\n      return session;\\n    }\\n\\n    Future<void> pumpPanel(\\n      WidgetTester tester,\\n      HostSession session, {\\n      void Function(String seedId)? onPreview,\\n    }) async {\\n      await tester.pumpWidget(\\n        MaterialApp(\\n          home: HostPanelScreen(\\n            session: session,\\n            onLeave: () async {},\\n            onPreview: onPreview ?? (_) {},\\n          ),\\n        ),\\n      );\\n      await flush(tester);\\n    }\\n\\n    setUp(() {\\n      joinInvoker = FakeHostJoinInvoker();\\n      mediaInvoker = FakeHostMediaInvoker();\\n    });\\n\\n    testWidgets('lists empty, queued, ready, failed, and deleted states',\\n        (tester) async {\\n      mediaInvoker.seeds.addAll(<Map<String, Object?>>[\\n        FakeHostMediaInvoker.seedJson('q', 'queued'),\\n        FakeHostMediaInvoker.seedJson('r', 'ready'),\\n        FakeHostMediaInvoker.seedJson('f', 'failed'),\\n        FakeHostMediaInvoker.seedJson('d', 'deleted'),\\n      ]);\\n      await pumpPanel(tester, await joinedSession());\\n      expect(find.textContaining('q · Queued'), findsOneWidget);\\n      expect(find.textContaining('r · Ready'), findsOneWidget);\\n      expect(find.textContaining('f · Failed'), findsOneWidget);\\n      expect(find.textContaining('d · Deleted'), findsOneWidget);\\n      // Deleted seeds offer no actions; live ones offer view + delete.\\n      expect(find.byKey(HostPanelScreen.viewKey('d')), findsNothing);\\n      expect(find.byKey(HostPanelScreen.deleteKey('d')), findsNothing);\\n      expect(find.byKey(HostPanelScreen.viewKey('r')), findsOneWidget);\\n      expect(find.byKey(HostPanelScreen.deleteKey('r')), findsOneWidget);\\n      expect(tester.takeException(), isNull);\\n    });\\n\\n    testWidgets('empty catalog explains itself and generates', (tester) async {\\n      await pumpPanel(tester, await joinedSession());\\n      expect(find.byKey(HostPanelScreen.emptyKey), findsOneWidget);\\n      await enterVisible(\\n        tester,\\n        find.byKey(HostPanelScreen.generateSeedKey),\\n        'catalog-new',\\n      );\\n      await tapVisible(tester, find.byKey(HostPanelScreen.generateKey));\\n      await flush(tester);\\n      expect(find.textContaining('catalog-new · Queued'), findsOneWidget);\\n      expect(\\n        mediaInvoker.payloads\\n            .where((p) => p['seedId'] == 'catalog-new')\\n            .map((p) => p['presetId']),\\n        <String>[kCheapDemoPresetId],\\n      );\\n    });\\n\\n    testWidgets('delete success reconciles; failure stays retryable',\\n        (tester) async {\\n      mediaInvoker.seeds.addAll(<Map<String, Object?>>[\\n        FakeHostMediaInvoker.seedJson('a', 'ready'),\\n        FakeHostMediaInvoker.seedJson('b', 'ready'),\\n      ]);\\n      await pumpPanel(tester, await joinedSession());\\n      await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('a')));\\n      await flush(tester);\\n      expect(find.textContaining('a · Ready'), findsNothing);\\n      expect(find.textContaining('b · Ready'), findsOneWidget);\\n      mediaInvoker.failure = FirebaseFunctionsException(\\n        code: 'permission-denied',\\n        message: 'denied',\\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\\n      );\\n      await tapVisible(tester, find.byKey(HostPanelScreen.deleteKey('b')));\\n      await flush(tester);\\n      expect(find.byKey(HostPanelScreen.messageKey), findsOneWidget);\\n      expect(find.textContaining('b · Ready'), findsOneWidget);\\n    });\\n\\n    testWidgets('view opens the preview callback per seed', (tester) async {\\n      mediaInvoker.seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\\n      String? viewed;\\n      await pumpPanel(\\n        tester,\\n        await joinedSession(),\\n        onPreview: (seedId) => viewed = seedId,\\n      );\\n      await tapVisible(tester, find.byKey(HostPanelScreen.viewKey('v')));\\n      await flush(tester);\\n      expect(viewed, 'v');\\n    });\\n  });\\n\\n  group('host preview screen (real session, fake media boundary)', () {\\n    testWidgets('obtains a fresh capability and disposes playback resources',\\n        (tester) async {\\n      final FakeHostJoinInvoker joinInvoker = FakeHostJoinInvoker();\\n      final FakeHostMediaInvoker mediaInvoker = FakeHostMediaInvoker()\\n        ..seeds.add(FakeHostMediaInvoker.seedJson('v', 'ready'));\\n      final HostSession session = HostSession(\\n        joinClient: HostJoinClient(invoker: joinInvoker),\\n        mediaClient: HostMediaClient(invoker: mediaInvoker),\\n      );\\n      addTearDown(session.dispose);\\n      await session.join(hostData());\\n\\n      await tester.pumpWidget(\\n        MaterialApp(\\n          home: HostVideoPreviewScreen(session: session, seedId: 'v'),\\n        ),\\n      );\\n      await flush(tester);\\n      // Fresh scoped capability per view: exactly one preview call.\\n      expect(mediaInvoker.previews, 1);\\n      for (final camera in ['CAM-01', 'CAM-02', 'CAM-03', 'CAM-04']) {\\n        expect(\\n          find.byKey(HostVideoPreviewScreen.playKey(camera)),\\n          findsOneWidget,\\n        );\\n      }\\n      // Playing without a platform plugin surfaces a visible error through\\n      // the real controller path (create -> initialize -> dispose).\\n      await tapVisible(\\n        tester,\\n        find.byKey(HostVideoPreviewScreen.playKey('CAM-01')),\\n      );\\n      await flush(tester);\\n      expect(find.byKey(HostVideoPreviewScreen.errorKey), findsOneWidget);\\n      // Leaving disposes playback resources without exceptions.\\n      await tester.pumpWidget(const SizedBox());\\n      await flush(tester);\\n      expect(tester.takeException(), isNull);\\n      expect(mediaInvoker.previews, 1);\\n    });\\n  });\\n\\n  group('companion app host flow (production-path routing)', () {\\n    late FakeHostJoinInvoker joinInvoker;\\n    late FakeHostMediaInvoker mediaInvoker;\\n    late FakeJoinInvoker guestJoinInvoker;\\n    late FakeManifestInvoker manifestInvoker;\\n\\n    Future<void> pumpHostApp(WidgetTester tester) async {\\n      SharedPreferences.setMockInitialValues(<String, Object>{\\n        DeviceIdentityStore.storageKey: kGuestDeviceId,\\n        DeviceIdentityStore.hostStorageKey: kHostDeviceId,\\n      });\\n      await tester.pumpWidget(\\n        CompanionApp(\\n          config: BackendConfig.parse(<String, Object?>{\\n            'apiKey': 'test-api-key',\\n            'appId': '1:123:android:abc',\\n            'projectId': 'test-project',\\n          }),\\n          firebaseBootstrap: (_) async {},\\n          invokerOverride: manifestInvoker,\\n          partyJoinInvokerOverride: guestJoinInvoker,\\n          hostJoinInvokerOverride: joinInvoker,\\n          hostMediaInvokerOverride: mediaInvoker,\\n          clock: SystemClock(),\\n        ),\\n      );\\n      await flush(tester);\\n    }\\n\\n    setUp(() {\\n      joinInvoker = FakeHostJoinInvoker();\\n      mediaInvoker = FakeHostMediaInvoker()\\n        ..seeds.add(FakeHostMediaInvoker.seedJson('catalog-1', 'ready'));\\n      guestJoinInvoker = FakeJoinInvoker();\\n      manifestInvoker = FakeManifestInvoker();\\n    });\\n\\n    testWidgets('host invite redeems into the panel only after validation',\\n        (tester) async {\\n      await pumpHostApp(tester);\\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\\n      await enterVisible(\\n        tester,\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        hostPayload(),\\n      );\\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\\n      await flush(tester);\\n      // Scope validated -> panel with the server-backed catalog.\\n      expect(find.byType(HostPanelScreen), findsOneWidget);\\n      expect(find.textContaining('catalog-1 · Ready'), findsOneWidget);\\n      expect(guestJoinInvoker.calls, 0);\\n      expect(tester.takeException(), isNull);\\n    });\\n\\n    testWidgets('host denial fails visibly on the entry screen', (\\n      tester,\\n    ) async {\\n      joinInvoker.failure = FirebaseFunctionsException(\\n        code: 'permission-denied',\\n        message: 'raw detail must never surface',\\n        details: const <String, Object?>{'errorCode': 'FORBIDDEN'},\\n      );\\n      await pumpHostApp(tester);\\n      await enterVisible(\\n        tester,\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        hostPayload(),\\n      );\\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\\n      await flush(tester);\\n      expect(find.byType(HostPanelScreen), findsNothing);\\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\\n      expect(find.text('Access was denied.'), findsOneWidget);\\n      expect(find.textContaining('raw detail'), findsNothing);\\n    });\\n\\n    testWidgets('guest payload on host entry never touches joinHost', (\\n      tester,\\n    ) async {\\n      await pumpHostApp(tester);\\n      await enterVisible(\\n        tester,\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        '{\\\"partyId\\\":\\\"party-1\\\",\\\"channelId\\\":\\\"cctv\\\"}',\\n      );\\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\\n      await flush(tester);\\n      expect(joinInvoker.calls, 0);\\n      expect(find.byType(HostPanelScreen), findsNothing);\\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\\n    });\\n\\n    testWidgets('leave returns to the dedicated entry', (tester) async {\\n      await pumpHostApp(tester);\\n      await enterVisible(\\n        tester,\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        hostPayload(),\\n      );\\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\\n      await flush(tester);\\n      expect(find.byType(HostPanelScreen), findsOneWidget);\\n      await tapVisible(tester, find.byKey(HostPanelScreen.leaveKey));\\n      await flush(tester);\\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\\n      expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\\n    });\\n\\n    testWidgets('offline boot stays usable without network calls', (\\n      tester,\\n    ) async {\\n      SharedPreferences.setMockInitialValues(<String, Object>{});\\n      await tester.pumpWidget(const CompanionApp());\\n      await flush(tester);\\n      expect(find.byKey(HostEntryScreen.joinAsGuestKey), findsOneWidget);\\n      expect(find.byKey(HostEntryScreen.scanKey), findsOneWidget);\\n      // Submitting a host payload offline fails visibly, with no invoker\\n      // available and no network attempted.\\n      await enterVisible(\\n        tester,\\n        find.byKey(HostEntryScreen.payloadFieldKey),\\n        hostPayload(),\\n      );\\n      await tapVisible(tester, find.byKey(HostEntryScreen.submitKey));\\n      await flush(tester);\\n      expect(find.byKey(HostEntryScreen.errorKey), findsOneWidget);\\n      expect(find.byType(HostPanelScreen), findsNothing);\\n    });\\n  });\\n}\\n\\n/// Forwards list calls to [gate] so tests can interleave leave/refresh and\\n/// prove stale responses are dropped; every other callable delegates.\\nfinal class _GatedListInvoker implements HostMediaCallableInvoker {\\n  _GatedListInvoker(this._inner, this._gate);\\n  final FakeHostMediaInvoker _inner;\\n  final Future<Map<String, Object?>> _gate;\\n\\n  @override\\n  Future<Object?> call(String name, Map<String, Object?> payload) {\\n    if (name == kListHostVideos) return _gate;\\n    return _inner.call(name, payload);\\n  }\\n}\\n\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/test/host_flow_test.dart\"}"},"time":{"start":1793462247647,"end":1793462294645}}}}
