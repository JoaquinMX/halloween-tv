ified","additions":2,"deletions":2}],"truncated":false},"content":[{"type":"text","text":"Edited apps/companion_app/lib/src/data/host_media_client.dart (1 replacement)"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192ae13ef73ce975ca1a25035ae8a"}},"providerResult":{"executed":false},"rawInput":"{\"newString\":\"  Future<Object?> _call(String name, Map<String, Object?> payload) async {\\n    try {\\n      return await _invoker.call(name, payload).timeout(timeout);\\n    } on TimeoutException catch (error) {\\n      throw ManifestTransportException('$name timed out', error);\\n    }\\n  }\",\"oldString\":\"  Future<Object?> _call(String name, Map<String, Object?> payload) {\\n    try {\\n      return _invoker.call(name, payload).timeout(timeout);\\n    } on TimeoutException catch (error) {\\n      throw ManifestTransportException('$name timed out', error);\\n    }\\n  }\",\"path\":\"/private/tmp/orchestrator/cycle-12/part-3/apps/companion_app/lib/src/data/host_media_client.dart\"}"},"time":{"start":1793462244427,"end":1793462245688}}}}
