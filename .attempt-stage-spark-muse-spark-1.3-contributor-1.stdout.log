{"type":"tool_use","timestamp":1793463653063,"sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","part":{"partID":"prt_192c38c7f001xNMNYUDCBeZEhI","sessionID":"ses_e6d3ce8c9ffeJ1xzKXDoULu3JY","messageID":"msg_192c385c4001HZIcbA1pBO0sxa","type":"tool","id":"call_01a192c38c56726b8e1cddfcdf154262","tool":"read","state":{"status":"completed","input":{"path":"/private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/guest_code_panel_test.dart"},"output":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/guest_code_panel_test.dart, lines 1-832\n1: /// P2: TV session QR + refreshed anonymous guest listing.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:convert';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_ui/core_ui.dart';\n9: import 'package:flutter/material.dart';\n10: import 'package:flutter/services.dart';\n11: import 'package:flutter_test/flutter_test.dart';\n12: import 'package:qr_flutter/qr_flutter.dart';\n13: import 'package:testing_toolkit/testing_toolkit.dart';\n14: import 'package:tv_app/src/wall/guest_code_panel.dart';\n15: import 'package:tv_app/src/wall/guest_codes.dart';\n16: import 'package:tv_app/src/wall/wall_screen.dart';\n17: \n18: import 'support/fakes.dart';\n19: import 'wall_test.dart' show pumpWall, teardownWall, wallHarness, wallManifest;\n20: \n21: Map<String, Object?> listingResponse({\n22:   String partyId = 'party-1',\n23:   String channelId = hauntedSurveillanceChannelId,\n24:   String tvDeviceId = 'tv-abc',\n25:   Object? joinPin = const _Absent(),\n26:   List<Object?> devices = const <Object?>[],\n27: }) {\n28:   final Map<String, Object?> map = <String, Object?>{\n29:     'partyId': partyId,\n30:     'channelId': channelId,\n31:     'tvDeviceId': tvDeviceId,\n32:     'devices': devices,\n33:   };\n34:   if (joinPin is! _Absent) {\n35:     map['joinPin'] = joinPin;\n36:   }\n37:   return map;\n38: }\n39: \n40: class _Absent {\n41:   const _Absent();\n42: }\n43: \n44: GuestCodeClient listingClient(\n45:   Map<String, Object?> response, {\n46:   List<Map<String, Object?>>? seenPayloads,\n47:   String partyId = 'party-1',\n48:   String tvDeviceId = 'tv-abc',\n49:   String channelId = hauntedSurveillanceChannelId,\n50:   Future<Map<String, Object?>> Function()? next,\n51:   int callsBeforeNext = 0,\n52: }) {\n53:   int calls = 0;\n54:   return GuestCodeClient(\n55:     invoker: (String name, Map<String, Object?> payload) async {\n56:       expect(name, 'listPartyDevices');\n57:       seenPayloads?.add(Map<String, Object?>.of(payload));\n58:       calls++;\n59:       if (next != null && calls > callsBeforeNext) {\n60:         return next();\n61:       }\n62:       return response;\n63:     },\n64:     partyId: partyId,\n65:     deviceId: tvDeviceId,\n66:     channelId: channelId,\n67:   );\n68: }\n69: \n70: Future<void> pumpPanel(\n71:   WidgetTester tester,\n72:   GuestCodeClient client, {\n73:   String tvDeviceId = 'tv-abc',\n74:   Duration refreshInterval = const Duration(minutes: 5),\n75:   VoidCallback? onBack,\n76:   VoidCallback? onClose,\n77:   FocusNode? primaryFocusNode,\n78: }) async {\n79:   await tester.pumpWidget(\n80:     MaterialApp(\n81:       theme: CctvTheme.dark(),\n82:       home: Scaffold(\n83:         body: GuestCodePanel(\n84:           client: client,\n85:           tvDeviceId: tvDeviceId,\n86:           refreshInterval: refreshInterval,\n87:           onBack: onBack,\n88:           onClose: onClose ?? () {},\n89:           primaryFocusNode: primaryFocusNode,\n90:         ),\n91:       ),\n92:     ),\n93:   );\n94: }\n95: \n96: Future<void> disposePanel(WidgetTester tester) async {\n97:   await tester.pumpWidget(const SizedBox.shrink());\n98:   await tester.pump();\n99: }\n100: \n101: String qrDataOf(WidgetTester tester) {\n102:   final QrImageView qr = tester.widget<QrImageView>(\n103:     find.byKey(kGuestCodeQrKey),\n104:   );\n105:   return qr.semanticsLabel;\n106: }\n107: \n108: void main() {\n109:   group('buildJoinPayload', () {\n110:     test('omits absent PIN and contains exactly session keys', () {\n111:       final String payload = buildJoinPayload(\n112:         partyId: 'party-1',\n113:         channelId: 'haunted_surveillance',\n114:       );\n115:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n116:         jsonDecode(payload) as Map,\n117:       );\n118:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId', 'role'});\n119:       expect(decoded['partyId'], 'party-1');\n120:       expect(decoded['role'], 'guest');\n121:       expect(payload.contains('http'), isFalse);\n122:       expect(payload.contains('deviceId'), isFalse);\n123:     });\n124: \n125:     test('includes six-digit PIN with leading zeros significant', () {\n126:       final String payload = buildJoinPayload(\n127:         partyId: 'party-1',\n128:         channelId: 'c',\n129:         joinPin: '004201',\n130:       );\n131:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n132:         jsonDecode(payload) as Map,\n133:       );\n134:       expect(decoded, <String, Object?>{\n135:         'partyId': 'party-1',\n136:         'channelId': 'c',\n137:         'joinPin': '004201',\n138:         'role': 'guest',\n139:       });\n140:       expect(decoded.keys.toSet(), <String>{\n141:         'partyId',\n142:         'channelId',\n143:         'joinPin',\n144:         'role',\n145:       });\n146:     });\n147: \n148:     test('rejects malformed PIN shapes', () {\n149:       expect(\n150:         () => buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: '12345'),\n151:         throwsArgumentError,\n152:       );\n153:       expect(\n154:         () => buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: 'abcdef'),\n155:         throwsArgumentError,\n156:       );\n157:       expect(\n158:         () =>\n159:             buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: '1234567'),\n160:         throwsArgumentError,\n161:       );\n162:     });\n163: \n164:     test(\n165:       'legacy payloads without role remain parseable as guest sessions',\n166:       () async {\n167:         // Guests admitted before the explicit role existed carry no `role`\n168:         // key; consumers treat a missing role as guest (vectors in\n169:         // test/fixtures/join_roles_v1.json pin the role side separately).\n170:         const String legacy =\n171:             '{\"partyId\":\"party-1\",'\n172:             '\"channelId\":\"haunted_surveillance\",\"joinPin\":\"004201\"}';\n173:         final Map<String, Object?> decoded = Map<String, Object?>.from(\n174:           jsonDecode(legacy) as Map,\n175:         );\n176:         expect(decoded['partyId'], 'party-1');\n177:         expect(decoded['channelId'], 'haunted_surveillance');\n178:         expect(decoded['joinPin'], '004201');\n179:         expect(decoded['role'] ?? 'guest', 'guest');\n180:       },\n181:     );\n182: \n183:     test('no caller uses the removed deviceId argument', () {\n184:       // Compile-time proof: the old signature no longer exists. A dynamic\n185:       // call with deviceId must fail.\n186:       expect(\n187:         () => (buildJoinPayload as dynamic)(\n188:           partyId: 'p',\n189:           deviceId: 'tv',\n190:           channelId: 'c',\n191:         ),\n192:         throwsA(isA<NoSuchMethodError>()),\n193:       );\n194:     });\n195:   });\n196: \n197:   group('GuestCodeClient.fetchListing', () {\n198:     test('parses scope + PIN + entries; request carries TV deviceId', () async {\n199:       final List<Map<String, Object?>> seen = <Map<String, Object?>>[];\n200:       final GuestCodeClient client = listingClient(\n201:         listingResponse(\n202:           joinPin: '004201',\n203:           devices: <Object?>[\n204:             <String, Object?>{\n205:               'deviceId': 'g-1',\n206:               'label': 'Guest 1',\n207:               'role': 'guest',\n208:               'status': 'active',\n209:             },\n210:             <String, Object?>{'deviceId': 'g-2'},\n211:           ],\n212:         ),\n213:         seenPayloads: seen,\n214:       );\n215:       final GuestCodeListing listing = await client.fetchListing();\n216:       expect(seen.single['deviceId'], 'tv-abc');\n217:       expect(seen.single['partyId'], 'party-1');\n218:       expect(listing.partyId, 'party-1');\n219:       expect(listing.channelId, hauntedSurveillanceChannelId);\n220:       expect(listing.tvDeviceId, 'tv-abc');\n221:       expect(listing.joinPin, '004201');\n222:       expect(listing.devices, hasLength(2));\n223:       expect(listing.devices[0].label, 'Guest 1');\n224:       expect(listing.devices[1].label, isNull);\n225:       expect(listing.devices[1].displayLabel, 'Guest device');\n226:       // Back-compat path still works.\n227:       expect(await client.fetchGuestCodes(), listing.devices);\n228:     });\n229: \n230:     test('absent PIN means no PIN required', () async {\n231:       final GuestCodeClient client = listingClient(listingResponse());\n232:       final GuestCodeListing listing = await client.fetchListing();\n233:       expect(listing.joinPin, isNull);\n234:     });\n235: \n236:     test('tolerates empty-string labels', () async {\n237:       final GuestCodeClient client = listingClient(\n238:         listingResponse(\n239:           devices: <Object?>[\n240:             <String, Object?>{'deviceId': 'g-1', 'label': ''},\n241:             <String, Object?>{'deviceId': 'g-2', 'label': '   '},\n242:           ],\n243:         ),\n244:       );\n245:       final GuestCodeListing listing = await client.fetchListing();\n246:       expect(listing.devices[0].label, isNull);\n247:       expect(listing.devices[1].label, isNull);\n248:     });\n249: \n250:     test('rejects malformed scope/PIN/entries', () async {\n251:       Future<void> expectBad(Map<String, Object?> response) async {\n252:         await expectLater(\n253:           listingClient(response).fetchListing(),\n254:           throwsA(isA<GuestCodeException>()),\n255:         );\n256:       }\n257: \n258:       await expectBad(<String, Object?>{'devices': <Object?>[]});\n259:       await expectBad(listingResponse(devices: const <Object?>[], partyId: ''));\n260:       await expectBad(listingResponse(partyId: 'other-party'));\n261:       await expectBad(listingResponse(channelId: 'other-channel'));\n262:       await expectBad(listingResponse(tvDeviceId: 'tv-other'));\n263:       await expectBad(listingResponse(joinPin: '12345'));\n264:       await expectBad(listingResponse(joinPin: 'abcdef'));\n265:       await expectBad(listingResponse(joinPin: 123456));\n266:       await expectBad(listingResponse(devices: <Object?>['nope']));\n267:       await expectBad(\n268:         listingResponse(\n269:           devices: <Object?>[\n270:             <String, Object?>{'deviceId': '', 'label': 'x'},\n271:           ],\n272:         ),\n273:       );\n274:       await expectBad(\n275:         listingResponse(\n276:           devices: <Object?>[\n277:             <String, Object?>{'label': 'x'},\n278:           ],\n279:         ),\n280:       );\n281:       await expectBad(\n282:         listingResponse(\n283:           devices: <Object?>[\n284:             <String, Object?>{'deviceId': 'g-1', 'label': 42},\n285:           ],\n286:         ),\n287:       );\n288:       await expectBad(<String, Object?>{'nope': true});\n289:     });\n290:   });\n291: \n292:   group('GuestCodePanel widget', () {\n293:     testWidgets('shows TV code large with exactly one QR from session', (\n294:       WidgetTester tester,\n295:     ) async {\n296:       final GuestCodeClient client = listingClient(\n297:         listingResponse(\n298:           joinPin: '004201',\n299:           devices: <Object?>[\n300:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n301:           ],\n302:         ),\n303:       );\n304:       await pumpPanel(tester, client, onBack: () {});\n305:       await tester.pump();\n306:       await tester.pump();\n307:       expect(find.text('GUEST CODES'), findsOneWidget);\n308:       expect(find.text('tv-abc'), findsOneWidget);\n309:       expect(find.byType(QrImageView), findsOneWidget);\n310:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n311:         jsonDecode(qrDataOf(tester)) as Map,\n312:       );\n313:       expect(decoded, <String, Object?>{\n314:         'partyId': 'party-1',\n315:         'channelId': hauntedSurveillanceChannelId,\n316:         'joinPin': '004201',\n317:         'role': 'guest',\n318:       });\n319:       expect(find.textContaining('004201'), findsWidgets);\n320:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n321:       expect(find.byKey(kGuestCodeCloseKey), findsOneWidget);\n322:       expect(find.byKey(kGuestCodeBackKey), findsOneWidget);\n323:       await disposePanel(tester);\n324:     });\n325: \n326:     testWidgets('PIN-free session yields exact three-key QR + no-PIN text', (\n327:       WidgetTester tester,\n328:     ) async {\n329:       final GuestCodeClient client = listingClient(listingResponse());\n330:       await pumpPanel(tester, client);\n331:       await tester.pump();\n332:       await tester.pump();\n333:       expect(find.byType(QrImageView), findsOneWidget);\n334:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n335:         jsonDecode(qrDataOf(tester)) as Map,\n336:       );\n337:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId', 'role'});\n338:       expect(decoded['role'], 'guest');\n339:       expect(find.textContaining('no PIN required'), findsOneWidget);\n340:       await disposePanel(tester);\n341:     });\n342: \n343:     testWidgets('label-absent rows use neutral fallback, id shown once', (\n344:       WidgetTester tester,\n345:     ) async {\n346:       final GuestCodeClient client = listingClient(\n347:         listingResponse(\n348:           devices: <Object?>[\n349:             <String, Object?>{'deviceId': 'g-9'},\n350:             <String, Object?>{'deviceId': 'g-10', 'label': ''},\n351:           ],\n352:         ),\n353:       );\n354:       await pumpPanel(tester, client);\n355:       await tester.pump();\n356:       await tester.pump();\n357:       expect(find.text('Guest device: g-9'), findsOneWidget);\n358:       expect(find.text('Guest device: g-10'), findsOneWidget);\n359:       // Never renders the id as both label and value.\n360:       expect(find.text('g-9: g-9'), findsNothing);\n361:       expect(find.text('g-10: g-10'), findsNothing);\n362:       expect(find.textContaining('type them in'), findsNothing);\n363:       expect(find.textContaining('dictat'), findsNothing);\n364:       await disposePanel(tester);\n365:     });\n366: \n367:     testWidgets('loading shows no fabricated QR; error shows no QR', (\n368:       WidgetTester tester,\n369:     ) async {\n370:       final Completer<Map<String, Object?>> gate =\n371:           Completer<Map<String, Object?>>();\n372:       final GuestCodeClient slow = GuestCodeClient(\n373:         invoker: (_, __) => gate.future,\n374:         partyId: 'party-1',\n375:         deviceId: 'tv-abc',\n376:         channelId: hauntedSurveillanceChannelId,\n377:       );\n378:       await pumpPanel(tester, slow);\n379:       await tester.pump();\n380:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n381:       expect(find.byType(QrImageView), findsNothing);\n382:       expect(find.text('tv-abc'), findsOneWidget);\n383:       gate.completeError(const GuestCodeException('denied'));\n384:       await tester.pump();\n385:       await tester.pump();\n386:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n387:       expect(find.textContaining('denied'), findsOneWidget);\n388:       expect(find.byType(QrImageView), findsNothing);\n389:       await disposePanel(tester);\n390:     });\n391: \n392:     testWidgets('empty list states no seed instructions', (\n393:       WidgetTester tester,\n394:     ) async {\n395:       final GuestCodeClient client = listingClient(listingResponse());\n396:       await pumpPanel(tester, client);\n397:       await tester.pump();\n398:       await tester.pump();\n399:       expect(find.byKey(kGuestCodeEmptyKey), findsOneWidget);\n400:       expect(find.textContaining('seed_guests'), findsNothing);\n401:       expect(find.byType(QrImageView), findsOneWidget);\n402:       await disposePanel(tester);\n403:     });\n404: \n405:     testWidgets('type-or-paste instructions with camera-deferred status', (\n406:       WidgetTester tester,\n407:     ) async {\n408:       final GuestCodeClient client = listingClient(listingResponse());\n409:       await pumpPanel(tester, client);\n410:       await tester.pump();\n411:       await tester.pump();\n412:       expect(find.textContaining('type or paste'), findsOneWidget);\n413:       expect(find.textContaining('Camera QR scanning'), findsOneWidget);\n414:       expect(find.textContaining('reads codes aloud'), findsNothing);\n415:       expect(find.textContaining('later slice'), findsNothing);\n416:       await disposePanel(tester);\n417:     });\n418: \n419:     testWidgets(\n420:       'refresh after new joins updates rows + retains QR on failure',\n421:       (WidgetTester tester) async {\n422:         int calls = 0;\n423:         final GuestCodeClient client = GuestCodeClient(\n424:           invoker: (String name, Map<String, Object?> payload) async {\n425:             calls++;\n426:             if (calls == 1) {\n427:               return listingResponse(\n428:                 devices: <Object?>[\n429:                   <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n430:                 ],\n431:               );\n432:             }\n433:             if (calls == 2) {\n434:               return listingResponse(\n435:                 devices: <Object?>[\n436:                   <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n437:                   <String, Object?>{'deviceId': 'g-2'},\n438:                 ],\n439:               );\n440:             }\n441:             throw const GuestCodeException('flaky');\n442:           },\n443:           partyId: 'party-1',\n444:           deviceId: 'tv-abc',\n445:           channelId: hauntedSurveillanceChannelId,\n446:         );\n447:         await pumpPanel(\n448:           tester,\n449:           client,\n450:           refreshInterval: const Duration(milliseconds: 50),\n451:         );\n452:         await tester.pump();\n453:         await tester.pump();\n454:         expect(find.text('Guest 1: g-1'), findsOneWidget);\n455:         final String firstQr = qrDataOf(tester);\n456: \n457:         await tester.pump(const Duration(milliseconds: 60));\n458:         await tester.pump();\n459:         await tester.pump();\n460:         expect(find.text('Guest device: g-2'), findsOneWidget);\n461: \n462:         await tester.pump(const Duration(milliseconds: 60));\n463:         await tester.pump();\n464:         await tester.pump();\n465:         // Last valid session retained through the refresh failure.\n466:         expect(find.byType(QrImageView), findsOneWidget);\n467:         expect(qrDataOf(tester), firstQr);\n468:         expect(find.text('Guest device: g-2'), findsOneWidget);\n469:         expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n470:         expect(calls, greaterThanOrEqualTo(3));\n471:         await disposePanel(tester);\n472:       },\n473:     );\n474: \n475:     testWidgets('overlapping refreshes never run concurrently', (\n476:       WidgetTester tester,\n477:     ) async {\n478:       int calls = 0;\n479:       final Completer<Map<String, Object?>> gate =\n480:           Completer<Map<String, Object?>>();\n481:       final GuestCodeClient client = GuestCodeClient(\n482:         invoker: (_, __) {\n483:           calls++;\n484:           if (calls == 1) {\n485:             return gate.future;\n486:           }\n487:           return Future.value(listingResponse());\n488:         },\n489:         partyId: 'party-1',\n490:         deviceId: 'tv-abc',\n491:         channelId: hauntedSurveillanceChannelId,\n492:       );\n493:       await pumpPanel(\n494:         tester,\n495:         client,\n496:         refreshInterval: const Duration(milliseconds: 20),\n497:       );\n498:       await tester.pump();\n499:       expect(calls, 1);\n500:       // Periodic ticks while the first fetch is still in flight are skipped.\n501:       await tester.pump(const Duration(milliseconds: 60));\n502:       await tester.pump();\n503:       expect(calls, 1);\n504:       gate.complete(listingResponse());\n505:       await tester.pump();\n506:       await tester.pump();\n507:       expect(find.byType(QrImageView), findsOneWidget);\n508:       // The next tick after the in-flight fetch settled runs normally.\n509:       await tester.pump(const Duration(milliseconds: 40));\n510:       await tester.pump();\n511:       await tester.pump();\n512:       expect(calls, greaterThanOrEqualTo(2));\n513:       await disposePanel(tester);\n514:     });\n515: \n516:     testWidgets('hung fetch times out and the panel retries to recovery', (\n517:       WidgetTester tester,\n518:     ) async {\n519:       int calls = 0;\n520:       final GuestCodeClient client = GuestCodeClient(\n521:         invoker: (_, __) {\n522:           calls++;\n523:           if (calls <= 2) {\n524:             // Never completes: without the fetch timeout these would hold\n525:             // `_fetching` true forever and wedge the panel.\n526:             return Completer<Map<String, Object?>>().future;\n527:           }\n528:           return Future.value(\n529:             listingResponse(\n530:               joinPin: '004201',\n531:               devices: <Object?>[\n532:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n533:               ],\n534:             ),\n535:           );\n536:         },\n537:         partyId: 'party-1',\n538:         deviceId: 'tv-abc',\n539:         channelId: hauntedSurveillanceChannelId,\n540:       );\n541:       await pumpPanel(\n542:         tester,\n543:         client,\n544:         refreshInterval: const Duration(seconds: 5),\n545:       );\n546:       await tester.pump();\n547:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n548:       expect(calls, 1);\n549: \n550:       // The periodic tick while the first fetch hangs is skipped.\n551:       await tester.pump(const Duration(seconds: 5));\n552:       await tester.pump();\n553:       expect(calls, 1);\n554: \n555:       // The hung fetch times out: error state, no fabricated QR. The next\n556:       // tick retries (the in-flight guard was released by the timeout), and\n557:       // that retry hangs too — the error state persists across the tick.\n558:       await tester.pump(const Duration(seconds: 6));\n559:       await tester.pump();\n560:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n561:       expect(find.textContaining('timed out'), findsOneWidget);\n562:       expect(find.byType(QrImageView), findsNothing);\n563:       expect(calls, 2);\n564: \n565:       await tester.pump(const Duration(seconds: 4));\n566:       await tester.pump();\n567:       expect(calls, 2);\n568:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n569:       expect(find.byType(QrImageView), findsNothing);\n570: \n571:       // The second hung fetch times out as well; the following tick retries\n572:       // and the panel recovers with the authoritative session.\n573:       await tester.pump(const Duration(seconds: 6));\n574:       await tester.pump();\n575:       await tester.pump();\n576:       await tester.pump(const Duration(seconds: 5));\n577:       await tester.pump();\n578:       await tester.pump();\n579:       expect(calls, greaterThanOrEqualTo(3));\n580:       expect(find.byType(QrImageView), findsOneWidget);\n581:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n582:       await disposePanel(tester);\n583:     });\n584: \n585:     testWidgets('dispose cancels timer and ignores late responses', (\n586:       WidgetTester tester,\n587:     ) async {\n588:       int calls = 0;\n589:       final Completer<Map<String, Object?>> late =\n590:           Completer<Map<String, Object?>>();\n591:       final GuestCodeClient client = GuestCodeClient(\n592:         invoker: (_, __) {\n593:           calls++;\n594:           if (calls == 1) {\n595:             return late.future;\n596:           }\n597:           return Future.value(listingResponse());\n598:         },\n599:         partyId: 'party-1',\n600:         deviceId: 'tv-abc',\n601:         channelId: hauntedSurveillanceChannelId,\n602:       );\n603:       await pumpPanel(\n604:         tester,\n605:         client,\n606:         refreshInterval: const Duration(milliseconds: 20),\n607:       );\n608:       await tester.pump();\n609:       final int callsAtOpen = calls;\n610:       expect(callsAtOpen, 1);\n611:       await tester.pumpWidget(const SizedBox.shrink());\n612:       await tester.pump();\n613:       late.complete(listingResponse());\n614:       await tester.pump(const Duration(milliseconds: 100));\n615:       await tester.pump();\n616:       expect(calls, callsAtOpen);\n617:       expect(tester.takeException(), isNull);\n618:       // Already disposed; nothing further to tear down.\n619:     });\n620: \n621:     testWidgets('D-pad back/close keys invoke callbacks', (\n622:       WidgetTester tester,\n623:     ) async {\n624:       bool backed = false;\n625:       bool closed = false;\n626:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n627:       addTearDown(primary.dispose);\n628:       final GuestCodeClient client = listingClient(listingResponse());\n629:       await pumpPanel(\n630:         tester,\n631:         client,\n632:         onBack: () => backed = true,\n633:         onClose: () => closed = true,\n634:         primaryFocusNode: primary,\n635:       );\n636:       await tester.pump();\n637:       await tester.pump();\n638:       primary.requestFocus();\n639:       await tester.pump();\n640:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n641:       await tester.pump();\n642:       expect(backed, isTrue);\n643:       expect(closed, isFalse);\n644:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n645:       await tester.pump();\n646:       expect(closed, isTrue);\n647:       primary.unfocus();\n648:       await disposePanel(tester);\n649:     });\n650: \n651:     testWidgets('escape falls back to onClose when no onBack', (\n652:       WidgetTester tester,\n653:     ) async {\n654:       bool closed = false;\n655:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n656:       addTearDown(primary.dispose);\n657:       final GuestCodeClient client = listingClient(listingResponse());\n658:       await pumpPanel(\n659:         tester,\n660:         client,\n661:         onClose: () => closed = true,\n662:         primaryFocusNode: primary,\n663:       );\n664:       await tester.pump();\n665:       await tester.pump();\n666:       expect(find.byKey(kGuestCodeBackKey), findsNothing);\n667:       primary.requestFocus();\n668:       await tester.pump();\n669:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n670:       await tester.pump();\n671:       expect(closed, isTrue);\n672:       primary.unfocus();\n673:       await disposePanel(tester);\n674:     });\n675: \n676:     testWidgets('1920x1080 layout smoke: no overflow, one QR', (\n677:       WidgetTester tester,\n678:     ) async {\n679:       addTearDown(tester.view.resetPhysicalSize);\n680:       addTearDown(tester.view.resetDevicePixelRatio);\n681:       tester.view.physicalSize = const Size(1920, 1080);\n682:       tester.view.devicePixelRatio = 1.0;\n683:       final GuestCodeClient client = listingClient(\n684:         listingResponse(\n685:           joinPin: '123456',\n686:           devices: <Object?>[\n687:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n688:           ],\n689:         ),\n690:       );\n691:       await pumpPanel(tester, client, onBack: () {});\n692:       await tester.pump();\n693:       await tester.pump();\n694:       expect(find.byType(QrImageView), findsOneWidget);\n695:       expect(find.text('tv-abc'), findsOneWidget);\n696:       expect(tester.takeException(), isNull);\n697:       await disposePanel(tester);\n698:     });\n699:   });\n700: \n701:   group('WallScreen guest-code flow', () {\n702:     GuestCodeClient fakeClient({bool fail = false, String? pin}) =>\n703:         GuestCodeClient(\n704:           invoker: (_, __) async {\n705:             if (fail) {\n706:               throw const GuestCodeException('denied');\n707:             }\n708:             return listingResponse(\n709:               joinPin: pin ?? const _Absent(),\n710:               devices: <Object?>[\n711:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n712:               ],\n713:             );\n714:           },\n715:           partyId: 'party-1',\n716:           deviceId: 'tv-abc',\n717:           channelId: hauntedSurveillanceChannelId,\n718:         );\n719: \n720:     testWidgets('no client means no GUEST CODES button', (\n721:       WidgetTester tester,\n722:     ) async {\n723:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n724:       await tester.pumpWidget(\n725:         wallHarness(\n726:           manifest: wallManifest(),\n727:           clock: clock,\n728:           factory: fakeControllerFactory(),\n729:         ),\n730:       );\n731:       await pumpWall(tester);\n732: \n733:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n734:       await tester.pump();\n735:       await tester.pump();\n736:       expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n737:       expect(find.text('GUEST CODES'), findsNothing);\n738: \n739:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n740:       await tester.pump();\n741:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n742: \n743:       await teardownWall(tester);\n744:     });\n745: \n746:     testWidgets('GUEST CODES opens session QR panel, BACK returns', (\n747:       WidgetTester tester,\n748:     ) async {\n749:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n750:       await tester.pumpWidget(\n751:         wallHarness(\n752:           manifest: wallManifest(),\n753:           clock: clock,\n754:           factory: fakeControllerFactory(),\n755:           guestCodeClient: fakeClient(pin: '004201'),\n756:           partyId: 'party-1',\n757:           tvDeviceId: 'tv-abc',\n758:         ),\n759:       );\n760:       await pumpWall(tester);\n761: \n762:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n763:       await tester.pump();\n764:       await tester.pump();\n765:       await tester.tap(\n766:         find.byKey(const ValueKey<String>('recovery-guest-codes')),\n767:       );\n768:       await tester.pump();\n769:       await tester.pump();\n770: \n771:       expect(find.byKey(kGuestCodePanelKey), findsOneWidget);\n772:       expect(find.text('tv-abc'), findsOneWidget);\n773:       expect(find.byType(QrImageView), findsOneWidget);\n774:       final QrImageView qr = tester.widget<QrImageView>(\n775:         find.byKey(kGuestCodeQrKey),\n776:       );\n777:       expect(\n778:         Map<String, Object?>.from(jsonDecode(qr.semanticsLabel) as Map),\n779:         <String, Object?>{\n780:           'partyId': 'party-1',\n781:           'channelId': hauntedSurveillanceChannelId,\n782:           'joinPin': '004201',\n783:           'role': 'guest',\n784:         },\n785:       );\n786:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n787: \n788:       await tester.tap(find.byKey(kGuestCodeBackKey));\n789:       await tester.pump();\n790:       expect(find.byKey(kGuestCodePanelKey), findsNothing);\n791:       expect(find.text('RETRY CACHED WALL'), findsOneWidget);\n792: \n793:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n794:       await tester.pump();\n795:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n796: \n797:       await teardownWall(tester);\n798:     });\n799: \n800:     testWidgets('guest list failure shows error with no QR, TV code stays', (\n801:       WidgetTester tester,\n802:     ) async {\n803:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n804:       await tester.pumpWidget(\n805:         wallHarness(\n806:           manifest: wallManifest(),\n807:           clock: clock,\n808:           factory: fakeControllerFactory(),\n809:           guestCodeClient: fakeClient(fail: true),\n810:           partyId: 'party-1',\n811:           tvDeviceId: 'tv-abc',\n812:         ),\n813:       );\n814:       await pumpWall(tester);\n815: \n816:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n817:       await tester.pump();\n818:       await tester.pump();\n819:       await tester.tap(\n820:         find.byKey(const ValueKey<String>('recovery-guest-codes')),\n821:       );\n822:       await tester.pump();\n823:       await tester.pump();\n824: \n825:       expect(find.text('tv-abc'), findsOneWidget);\n826:       expect(find.textContaining('denied'), findsOneWidget);\n827:       expect(find.byType(QrImageView), findsNothing);\n828: \n829:       await teardownWall(tester);\n830:     });\n831:   });\n832: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /private/tmp/orchestrator/cycle-12/fix-2/apps/tv_app/test/guest_code_panel_test.dart, lines 1-832\n1: /// P2: TV session QR + refreshed anonymous guest listing.\n2: library;\n3: \n4: import 'dart:async';\n5: import 'dart:convert';\n6: \n7: import 'package:channel_cctv/channel_cctv.dart';\n8: import 'package:core_ui/core_ui.dart';\n9: import 'package:flutter/material.dart';\n10: import 'package:flutter/services.dart';\n11: import 'package:flutter_test/flutter_test.dart';\n12: import 'package:qr_flutter/qr_flutter.dart';\n13: import 'package:testing_toolkit/testing_toolkit.dart';\n14: import 'package:tv_app/src/wall/guest_code_panel.dart';\n15: import 'package:tv_app/src/wall/guest_codes.dart';\n16: import 'package:tv_app/src/wall/wall_screen.dart';\n17: \n18: import 'support/fakes.dart';\n19: import 'wall_test.dart' show pumpWall, teardownWall, wallHarness, wallManifest;\n20: \n21: Map<String, Object?> listingResponse({\n22:   String partyId = 'party-1',\n23:   String channelId = hauntedSurveillanceChannelId,\n24:   String tvDeviceId = 'tv-abc',\n25:   Object? joinPin = const _Absent(),\n26:   List<Object?> devices = const <Object?>[],\n27: }) {\n28:   final Map<String, Object?> map = <String, Object?>{\n29:     'partyId': partyId,\n30:     'channelId': channelId,\n31:     'tvDeviceId': tvDeviceId,\n32:     'devices': devices,\n33:   };\n34:   if (joinPin is! _Absent) {\n35:     map['joinPin'] = joinPin;\n36:   }\n37:   return map;\n38: }\n39: \n40: class _Absent {\n41:   const _Absent();\n42: }\n43: \n44: GuestCodeClient listingClient(\n45:   Map<String, Object?> response, {\n46:   List<Map<String, Object?>>? seenPayloads,\n47:   String partyId = 'party-1',\n48:   String tvDeviceId = 'tv-abc',\n49:   String channelId = hauntedSurveillanceChannelId,\n50:   Future<Map<String, Object?>> Function()? next,\n51:   int callsBeforeNext = 0,\n52: }) {\n53:   int calls = 0;\n54:   return GuestCodeClient(\n55:     invoker: (String name, Map<String, Object?> payload) async {\n56:       expect(name, 'listPartyDevices');\n57:       seenPayloads?.add(Map<String, Object?>.of(payload));\n58:       calls++;\n59:       if (next != null && calls > callsBeforeNext) {\n60:         return next();\n61:       }\n62:       return response;\n63:     },\n64:     partyId: partyId,\n65:     deviceId: tvDeviceId,\n66:     channelId: channelId,\n67:   );\n68: }\n69: \n70: Future<void> pumpPanel(\n71:   WidgetTester tester,\n72:   GuestCodeClient client, {\n73:   String tvDeviceId = 'tv-abc',\n74:   Duration refreshInterval = const Duration(minutes: 5),\n75:   VoidCallback? onBack,\n76:   VoidCallback? onClose,\n77:   FocusNode? primaryFocusNode,\n78: }) async {\n79:   await tester.pumpWidget(\n80:     MaterialApp(\n81:       theme: CctvTheme.dark(),\n82:       home: Scaffold(\n83:         body: GuestCodePanel(\n84:           client: client,\n85:           tvDeviceId: tvDeviceId,\n86:           refreshInterval: refreshInterval,\n87:           onBack: onBack,\n88:           onClose: onClose ?? () {},\n89:           primaryFocusNode: primaryFocusNode,\n90:         ),\n91:       ),\n92:     ),\n93:   );\n94: }\n95: \n96: Future<void> disposePanel(WidgetTester tester) async {\n97:   await tester.pumpWidget(const SizedBox.shrink());\n98:   await tester.pump();\n99: }\n100: \n101: String qrDataOf(WidgetTester tester) {\n102:   final QrImageView qr = tester.widget<QrImageView>(\n103:     find.byKey(kGuestCodeQrKey),\n104:   );\n105:   return qr.semanticsLabel;\n106: }\n107: \n108: void main() {\n109:   group('buildJoinPayload', () {\n110:     test('omits absent PIN and contains exactly session keys', () {\n111:       final String payload = buildJoinPayload(\n112:         partyId: 'party-1',\n113:         channelId: 'haunted_surveillance',\n114:       );\n115:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n116:         jsonDecode(payload) as Map,\n117:       );\n118:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId', 'role'});\n119:       expect(decoded['partyId'], 'party-1');\n120:       expect(decoded['role'], 'guest');\n121:       expect(payload.contains('http'), isFalse);\n122:       expect(payload.contains('deviceId'), isFalse);\n123:     });\n124: \n125:     test('includes six-digit PIN with leading zeros significant', () {\n126:       final String payload = buildJoinPayload(\n127:         partyId: 'party-1',\n128:         channelId: 'c',\n129:         joinPin: '004201',\n130:       );\n131:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n132:         jsonDecode(payload) as Map,\n133:       );\n134:       expect(decoded, <String, Object?>{\n135:         'partyId': 'party-1',\n136:         'channelId': 'c',\n137:         'joinPin': '004201',\n138:         'role': 'guest',\n139:       });\n140:       expect(decoded.keys.toSet(), <String>{\n141:         'partyId',\n142:         'channelId',\n143:         'joinPin',\n144:         'role',\n145:       });\n146:     });\n147: \n148:     test('rejects malformed PIN shapes', () {\n149:       expect(\n150:         () => buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: '12345'),\n151:         throwsArgumentError,\n152:       );\n153:       expect(\n154:         () => buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: 'abcdef'),\n155:         throwsArgumentError,\n156:       );\n157:       expect(\n158:         () =>\n159:             buildJoinPayload(partyId: 'p', channelId: 'c', joinPin: '1234567'),\n160:         throwsArgumentError,\n161:       );\n162:     });\n163: \n164:     test(\n165:       'legacy payloads without role remain parseable as guest sessions',\n166:       () async {\n167:         // Guests admitted before the explicit role existed carry no `role`\n168:         // key; consumers treat a missing role as guest (vectors in\n169:         // test/fixtures/join_roles_v1.json pin the role side separately).\n170:         const String legacy =\n171:             '{\"partyId\":\"party-1\",'\n172:             '\"channelId\":\"haunted_surveillance\",\"joinPin\":\"004201\"}';\n173:         final Map<String, Object?> decoded = Map<String, Object?>.from(\n174:           jsonDecode(legacy) as Map,\n175:         );\n176:         expect(decoded['partyId'], 'party-1');\n177:         expect(decoded['channelId'], 'haunted_surveillance');\n178:         expect(decoded['joinPin'], '004201');\n179:         expect(decoded['role'] ?? 'guest', 'guest');\n180:       },\n181:     );\n182: \n183:     test('no caller uses the removed deviceId argument', () {\n184:       // Compile-time proof: the old signature no longer exists. A dynamic\n185:       // call with deviceId must fail.\n186:       expect(\n187:         () => (buildJoinPayload as dynamic)(\n188:           partyId: 'p',\n189:           deviceId: 'tv',\n190:           channelId: 'c',\n191:         ),\n192:         throwsA(isA<NoSuchMethodError>()),\n193:       );\n194:     });\n195:   });\n196: \n197:   group('GuestCodeClient.fetchListing', () {\n198:     test('parses scope + PIN + entries; request carries TV deviceId', () async {\n199:       final List<Map<String, Object?>> seen = <Map<String, Object?>>[];\n200:       final GuestCodeClient client = listingClient(\n201:         listingResponse(\n202:           joinPin: '004201',\n203:           devices: <Object?>[\n204:             <String, Object?>{\n205:               'deviceId': 'g-1',\n206:               'label': 'Guest 1',\n207:               'role': 'guest',\n208:               'status': 'active',\n209:             },\n210:             <String, Object?>{'deviceId': 'g-2'},\n211:           ],\n212:         ),\n213:         seenPayloads: seen,\n214:       );\n215:       final GuestCodeListing listing = await client.fetchListing();\n216:       expect(seen.single['deviceId'], 'tv-abc');\n217:       expect(seen.single['partyId'], 'party-1');\n218:       expect(listing.partyId, 'party-1');\n219:       expect(listing.channelId, hauntedSurveillanceChannelId);\n220:       expect(listing.tvDeviceId, 'tv-abc');\n221:       expect(listing.joinPin, '004201');\n222:       expect(listing.devices, hasLength(2));\n223:       expect(listing.devices[0].label, 'Guest 1');\n224:       expect(listing.devices[1].label, isNull);\n225:       expect(listing.devices[1].displayLabel, 'Guest device');\n226:       // Back-compat path still works.\n227:       expect(await client.fetchGuestCodes(), listing.devices);\n228:     });\n229: \n230:     test('absent PIN means no PIN required', () async {\n231:       final GuestCodeClient client = listingClient(listingResponse());\n232:       final GuestCodeListing listing = await client.fetchListing();\n233:       expect(listing.joinPin, isNull);\n234:     });\n235: \n236:     test('tolerates empty-string labels', () async {\n237:       final GuestCodeClient client = listingClient(\n238:         listingResponse(\n239:           devices: <Object?>[\n240:             <String, Object?>{'deviceId': 'g-1', 'label': ''},\n241:             <String, Object?>{'deviceId': 'g-2', 'label': '   '},\n242:           ],\n243:         ),\n244:       );\n245:       final GuestCodeListing listing = await client.fetchListing();\n246:       expect(listing.devices[0].label, isNull);\n247:       expect(listing.devices[1].label, isNull);\n248:     });\n249: \n250:     test('rejects malformed scope/PIN/entries', () async {\n251:       Future<void> expectBad(Map<String, Object?> response) async {\n252:         await expectLater(\n253:           listingClient(response).fetchListing(),\n254:           throwsA(isA<GuestCodeException>()),\n255:         );\n256:       }\n257: \n258:       await expectBad(<String, Object?>{'devices': <Object?>[]});\n259:       await expectBad(listingResponse(devices: const <Object?>[], partyId: ''));\n260:       await expectBad(listingResponse(partyId: 'other-party'));\n261:       await expectBad(listingResponse(channelId: 'other-channel'));\n262:       await expectBad(listingResponse(tvDeviceId: 'tv-other'));\n263:       await expectBad(listingResponse(joinPin: '12345'));\n264:       await expectBad(listingResponse(joinPin: 'abcdef'));\n265:       await expectBad(listingResponse(joinPin: 123456));\n266:       await expectBad(listingResponse(devices: <Object?>['nope']));\n267:       await expectBad(\n268:         listingResponse(\n269:           devices: <Object?>[\n270:             <String, Object?>{'deviceId': '', 'label': 'x'},\n271:           ],\n272:         ),\n273:       );\n274:       await expectBad(\n275:         listingResponse(\n276:           devices: <Object?>[\n277:             <String, Object?>{'label': 'x'},\n278:           ],\n279:         ),\n280:       );\n281:       await expectBad(\n282:         listingResponse(\n283:           devices: <Object?>[\n284:             <String, Object?>{'deviceId': 'g-1', 'label': 42},\n285:           ],\n286:         ),\n287:       );\n288:       await expectBad(<String, Object?>{'nope': true});\n289:     });\n290:   });\n291: \n292:   group('GuestCodePanel widget', () {\n293:     testWidgets('shows TV code large with exactly one QR from session', (\n294:       WidgetTester tester,\n295:     ) async {\n296:       final GuestCodeClient client = listingClient(\n297:         listingResponse(\n298:           joinPin: '004201',\n299:           devices: <Object?>[\n300:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n301:           ],\n302:         ),\n303:       );\n304:       await pumpPanel(tester, client, onBack: () {});\n305:       await tester.pump();\n306:       await tester.pump();\n307:       expect(find.text('GUEST CODES'), findsOneWidget);\n308:       expect(find.text('tv-abc'), findsOneWidget);\n309:       expect(find.byType(QrImageView), findsOneWidget);\n310:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n311:         jsonDecode(qrDataOf(tester)) as Map,\n312:       );\n313:       expect(decoded, <String, Object?>{\n314:         'partyId': 'party-1',\n315:         'channelId': hauntedSurveillanceChannelId,\n316:         'joinPin': '004201',\n317:         'role': 'guest',\n318:       });\n319:       expect(find.textContaining('004201'), findsWidgets);\n320:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n321:       expect(find.byKey(kGuestCodeCloseKey), findsOneWidget);\n322:       expect(find.byKey(kGuestCodeBackKey), findsOneWidget);\n323:       await disposePanel(tester);\n324:     });\n325: \n326:     testWidgets('PIN-free session yields exact three-key QR + no-PIN text', (\n327:       WidgetTester tester,\n328:     ) async {\n329:       final GuestCodeClient client = listingClient(listingResponse());\n330:       await pumpPanel(tester, client);\n331:       await tester.pump();\n332:       await tester.pump();\n333:       expect(find.byType(QrImageView), findsOneWidget);\n334:       final Map<String, Object?> decoded = Map<String, Object?>.from(\n335:         jsonDecode(qrDataOf(tester)) as Map,\n336:       );\n337:       expect(decoded.keys.toSet(), <String>{'partyId', 'channelId', 'role'});\n338:       expect(decoded['role'], 'guest');\n339:       expect(find.textContaining('no PIN required'), findsOneWidget);\n340:       await disposePanel(tester);\n341:     });\n342: \n343:     testWidgets('label-absent rows use neutral fallback, id shown once', (\n344:       WidgetTester tester,\n345:     ) async {\n346:       final GuestCodeClient client = listingClient(\n347:         listingResponse(\n348:           devices: <Object?>[\n349:             <String, Object?>{'deviceId': 'g-9'},\n350:             <String, Object?>{'deviceId': 'g-10', 'label': ''},\n351:           ],\n352:         ),\n353:       );\n354:       await pumpPanel(tester, client);\n355:       await tester.pump();\n356:       await tester.pump();\n357:       expect(find.text('Guest device: g-9'), findsOneWidget);\n358:       expect(find.text('Guest device: g-10'), findsOneWidget);\n359:       // Never renders the id as both label and value.\n360:       expect(find.text('g-9: g-9'), findsNothing);\n361:       expect(find.text('g-10: g-10'), findsNothing);\n362:       expect(find.textContaining('type them in'), findsNothing);\n363:       expect(find.textContaining('dictat'), findsNothing);\n364:       await disposePanel(tester);\n365:     });\n366: \n367:     testWidgets('loading shows no fabricated QR; error shows no QR', (\n368:       WidgetTester tester,\n369:     ) async {\n370:       final Completer<Map<String, Object?>> gate =\n371:           Completer<Map<String, Object?>>();\n372:       final GuestCodeClient slow = GuestCodeClient(\n373:         invoker: (_, __) => gate.future,\n374:         partyId: 'party-1',\n375:         deviceId: 'tv-abc',\n376:         channelId: hauntedSurveillanceChannelId,\n377:       );\n378:       await pumpPanel(tester, slow);\n379:       await tester.pump();\n380:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n381:       expect(find.byType(QrImageView), findsNothing);\n382:       expect(find.text('tv-abc'), findsOneWidget);\n383:       gate.completeError(const GuestCodeException('denied'));\n384:       await tester.pump();\n385:       await tester.pump();\n386:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n387:       expect(find.textContaining('denied'), findsOneWidget);\n388:       expect(find.byType(QrImageView), findsNothing);\n389:       await disposePanel(tester);\n390:     });\n391: \n392:     testWidgets('empty list states no seed instructions', (\n393:       WidgetTester tester,\n394:     ) async {\n395:       final GuestCodeClient client = listingClient(listingResponse());\n396:       await pumpPanel(tester, client);\n397:       await tester.pump();\n398:       await tester.pump();\n399:       expect(find.byKey(kGuestCodeEmptyKey), findsOneWidget);\n400:       expect(find.textContaining('seed_guests'), findsNothing);\n401:       expect(find.byType(QrImageView), findsOneWidget);\n402:       await disposePanel(tester);\n403:     });\n404: \n405:     testWidgets('type-or-paste instructions with camera-deferred status', (\n406:       WidgetTester tester,\n407:     ) async {\n408:       final GuestCodeClient client = listingClient(listingResponse());\n409:       await pumpPanel(tester, client);\n410:       await tester.pump();\n411:       await tester.pump();\n412:       expect(find.textContaining('type or paste'), findsOneWidget);\n413:       expect(find.textContaining('Camera QR scanning'), findsOneWidget);\n414:       expect(find.textContaining('reads codes aloud'), findsNothing);\n415:       expect(find.textContaining('later slice'), findsNothing);\n416:       await disposePanel(tester);\n417:     });\n418: \n419:     testWidgets(\n420:       'refresh after new joins updates rows + retains QR on failure',\n421:       (WidgetTester tester) async {\n422:         int calls = 0;\n423:         final GuestCodeClient client = GuestCodeClient(\n424:           invoker: (String name, Map<String, Object?> payload) async {\n425:             calls++;\n426:             if (calls == 1) {\n427:               return listingResponse(\n428:                 devices: <Object?>[\n429:                   <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n430:                 ],\n431:               );\n432:             }\n433:             if (calls == 2) {\n434:               return listingResponse(\n435:                 devices: <Object?>[\n436:                   <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n437:                   <String, Object?>{'deviceId': 'g-2'},\n438:                 ],\n439:               );\n440:             }\n441:             throw const GuestCodeException('flaky');\n442:           },\n443:           partyId: 'party-1',\n444:           deviceId: 'tv-abc',\n445:           channelId: hauntedSurveillanceChannelId,\n446:         );\n447:         await pumpPanel(\n448:           tester,\n449:           client,\n450:           refreshInterval: const Duration(milliseconds: 50),\n451:         );\n452:         await tester.pump();\n453:         await tester.pump();\n454:         expect(find.text('Guest 1: g-1'), findsOneWidget);\n455:         final String firstQr = qrDataOf(tester);\n456: \n457:         await tester.pump(const Duration(milliseconds: 60));\n458:         await tester.pump();\n459:         await tester.pump();\n460:         expect(find.text('Guest device: g-2'), findsOneWidget);\n461: \n462:         await tester.pump(const Duration(milliseconds: 60));\n463:         await tester.pump();\n464:         await tester.pump();\n465:         // Last valid session retained through the refresh failure.\n466:         expect(find.byType(QrImageView), findsOneWidget);\n467:         expect(qrDataOf(tester), firstQr);\n468:         expect(find.text('Guest device: g-2'), findsOneWidget);\n469:         expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n470:         expect(calls, greaterThanOrEqualTo(3));\n471:         await disposePanel(tester);\n472:       },\n473:     );\n474: \n475:     testWidgets('overlapping refreshes never run concurrently', (\n476:       WidgetTester tester,\n477:     ) async {\n478:       int calls = 0;\n479:       final Completer<Map<String, Object?>> gate =\n480:           Completer<Map<String, Object?>>();\n481:       final GuestCodeClient client = GuestCodeClient(\n482:         invoker: (_, __) {\n483:           calls++;\n484:           if (calls == 1) {\n485:             return gate.future;\n486:           }\n487:           return Future.value(listingResponse());\n488:         },\n489:         partyId: 'party-1',\n490:         deviceId: 'tv-abc',\n491:         channelId: hauntedSurveillanceChannelId,\n492:       );\n493:       await pumpPanel(\n494:         tester,\n495:         client,\n496:         refreshInterval: const Duration(milliseconds: 20),\n497:       );\n498:       await tester.pump();\n499:       expect(calls, 1);\n500:       // Periodic ticks while the first fetch is still in flight are skipped.\n501:       await tester.pump(const Duration(milliseconds: 60));\n502:       await tester.pump();\n503:       expect(calls, 1);\n504:       gate.complete(listingResponse());\n505:       await tester.pump();\n506:       await tester.pump();\n507:       expect(find.byType(QrImageView), findsOneWidget);\n508:       // The next tick after the in-flight fetch settled runs normally.\n509:       await tester.pump(const Duration(milliseconds: 40));\n510:       await tester.pump();\n511:       await tester.pump();\n512:       expect(calls, greaterThanOrEqualTo(2));\n513:       await disposePanel(tester);\n514:     });\n515: \n516:     testWidgets('hung fetch times out and the panel retries to recovery', (\n517:       WidgetTester tester,\n518:     ) async {\n519:       int calls = 0;\n520:       final GuestCodeClient client = GuestCodeClient(\n521:         invoker: (_, __) {\n522:           calls++;\n523:           if (calls <= 2) {\n524:             // Never completes: without the fetch timeout these would hold\n525:             // `_fetching` true forever and wedge the panel.\n526:             return Completer<Map<String, Object?>>().future;\n527:           }\n528:           return Future.value(\n529:             listingResponse(\n530:               joinPin: '004201',\n531:               devices: <Object?>[\n532:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n533:               ],\n534:             ),\n535:           );\n536:         },\n537:         partyId: 'party-1',\n538:         deviceId: 'tv-abc',\n539:         channelId: hauntedSurveillanceChannelId,\n540:       );\n541:       await pumpPanel(\n542:         tester,\n543:         client,\n544:         refreshInterval: const Duration(seconds: 5),\n545:       );\n546:       await tester.pump();\n547:       expect(find.byKey(kGuestCodeLoadingKey), findsOneWidget);\n548:       expect(calls, 1);\n549: \n550:       // The periodic tick while the first fetch hangs is skipped.\n551:       await tester.pump(const Duration(seconds: 5));\n552:       await tester.pump();\n553:       expect(calls, 1);\n554: \n555:       // The hung fetch times out: error state, no fabricated QR. The next\n556:       // tick retries (the in-flight guard was released by the timeout), and\n557:       // that retry hangs too — the error state persists across the tick.\n558:       await tester.pump(const Duration(seconds: 6));\n559:       await tester.pump();\n560:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n561:       expect(find.textContaining('timed out'), findsOneWidget);\n562:       expect(find.byType(QrImageView), findsNothing);\n563:       expect(calls, 2);\n564: \n565:       await tester.pump(const Duration(seconds: 4));\n566:       await tester.pump();\n567:       expect(calls, 2);\n568:       expect(find.byKey(kGuestCodeErrorKey), findsOneWidget);\n569:       expect(find.byType(QrImageView), findsNothing);\n570: \n571:       // The second hung fetch times out as well; the following tick retries\n572:       // and the panel recovers with the authoritative session.\n573:       await tester.pump(const Duration(seconds: 6));\n574:       await tester.pump();\n575:       await tester.pump();\n576:       await tester.pump(const Duration(seconds: 5));\n577:       await tester.pump();\n578:       await tester.pump();\n579:       expect(calls, greaterThanOrEqualTo(3));\n580:       expect(find.byType(QrImageView), findsOneWidget);\n581:       expect(find.text('Guest 1: g-1'), findsOneWidget);\n582:       await disposePanel(tester);\n583:     });\n584: \n585:     testWidgets('dispose cancels timer and ignores late responses', (\n586:       WidgetTester tester,\n587:     ) async {\n588:       int calls = 0;\n589:       final Completer<Map<String, Object?>> late =\n590:           Completer<Map<String, Object?>>();\n591:       final GuestCodeClient client = GuestCodeClient(\n592:         invoker: (_, __) {\n593:           calls++;\n594:           if (calls == 1) {\n595:             return late.future;\n596:           }\n597:           return Future.value(listingResponse());\n598:         },\n599:         partyId: 'party-1',\n600:         deviceId: 'tv-abc',\n601:         channelId: hauntedSurveillanceChannelId,\n602:       );\n603:       await pumpPanel(\n604:         tester,\n605:         client,\n606:         refreshInterval: const Duration(milliseconds: 20),\n607:       );\n608:       await tester.pump();\n609:       final int callsAtOpen = calls;\n610:       expect(callsAtOpen, 1);\n611:       await tester.pumpWidget(const SizedBox.shrink());\n612:       await tester.pump();\n613:       late.complete(listingResponse());\n614:       await tester.pump(const Duration(milliseconds: 100));\n615:       await tester.pump();\n616:       expect(calls, callsAtOpen);\n617:       expect(tester.takeException(), isNull);\n618:       // Already disposed; nothing further to tear down.\n619:     });\n620: \n621:     testWidgets('D-pad back/close keys invoke callbacks', (\n622:       WidgetTester tester,\n623:     ) async {\n624:       bool backed = false;\n625:       bool closed = false;\n626:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n627:       addTearDown(primary.dispose);\n628:       final GuestCodeClient client = listingClient(listingResponse());\n629:       await pumpPanel(\n630:         tester,\n631:         client,\n632:         onBack: () => backed = true,\n633:         onClose: () => closed = true,\n634:         primaryFocusNode: primary,\n635:       );\n636:       await tester.pump();\n637:       await tester.pump();\n638:       primary.requestFocus();\n639:       await tester.pump();\n640:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n641:       await tester.pump();\n642:       expect(backed, isTrue);\n643:       expect(closed, isFalse);\n644:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n645:       await tester.pump();\n646:       expect(closed, isTrue);\n647:       primary.unfocus();\n648:       await disposePanel(tester);\n649:     });\n650: \n651:     testWidgets('escape falls back to onClose when no onBack', (\n652:       WidgetTester tester,\n653:     ) async {\n654:       bool closed = false;\n655:       final FocusNode primary = FocusNode(debugLabel: 'panel-primary');\n656:       addTearDown(primary.dispose);\n657:       final GuestCodeClient client = listingClient(listingResponse());\n658:       await pumpPanel(\n659:         tester,\n660:         client,\n661:         onClose: () => closed = true,\n662:         primaryFocusNode: primary,\n663:       );\n664:       await tester.pump();\n665:       await tester.pump();\n666:       expect(find.byKey(kGuestCodeBackKey), findsNothing);\n667:       primary.requestFocus();\n668:       await tester.pump();\n669:       await tester.sendKeyEvent(LogicalKeyboardKey.escape);\n670:       await tester.pump();\n671:       expect(closed, isTrue);\n672:       primary.unfocus();\n673:       await disposePanel(tester);\n674:     });\n675: \n676:     testWidgets('1920x1080 layout smoke: no overflow, one QR', (\n677:       WidgetTester tester,\n678:     ) async {\n679:       addTearDown(tester.view.resetPhysicalSize);\n680:       addTearDown(tester.view.resetDevicePixelRatio);\n681:       tester.view.physicalSize = const Size(1920, 1080);\n682:       tester.view.devicePixelRatio = 1.0;\n683:       final GuestCodeClient client = listingClient(\n684:         listingResponse(\n685:           joinPin: '123456',\n686:           devices: <Object?>[\n687:             <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n688:           ],\n689:         ),\n690:       );\n691:       await pumpPanel(tester, client, onBack: () {});\n692:       await tester.pump();\n693:       await tester.pump();\n694:       expect(find.byType(QrImageView), findsOneWidget);\n695:       expect(find.text('tv-abc'), findsOneWidget);\n696:       expect(tester.takeException(), isNull);\n697:       await disposePanel(tester);\n698:     });\n699:   });\n700: \n701:   group('WallScreen guest-code flow', () {\n702:     GuestCodeClient fakeClient({bool fail = false, String? pin}) =>\n703:         GuestCodeClient(\n704:           invoker: (_, __) async {\n705:             if (fail) {\n706:               throw const GuestCodeException('denied');\n707:             }\n708:             return listingResponse(\n709:               joinPin: pin ?? const _Absent(),\n710:               devices: <Object?>[\n711:                 <String, Object?>{'deviceId': 'g-1', 'label': 'Guest 1'},\n712:               ],\n713:             );\n714:           },\n715:           partyId: 'party-1',\n716:           deviceId: 'tv-abc',\n717:           channelId: hauntedSurveillanceChannelId,\n718:         );\n719: \n720:     testWidgets('no client means no GUEST CODES button', (\n721:       WidgetTester tester,\n722:     ) async {\n723:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n724:       await tester.pumpWidget(\n725:         wallHarness(\n726:           manifest: wallManifest(),\n727:           clock: clock,\n728:           factory: fakeControllerFactory(),\n729:         ),\n730:       );\n731:       await pumpWall(tester);\n732: \n733:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n734:       await tester.pump();\n735:       await tester.pump();\n736:       expect(find.byKey(kRecoveryOverlayKey), findsOneWidget);\n737:       expect(find.text('GUEST CODES'), findsNothing);\n738: \n739:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n740:       await tester.pump();\n741:       expect(find.byKey(kRecoveryOverlayKey), findsNothing);\n742: \n743:       await teardownWall(tester);\n744:     });\n745: \n746:     testWidgets('GUEST CODES opens session QR panel, BACK returns', (\n747:       WidgetTester tester,\n748:     ) async {\n749:       final FakeClock clock = FakeClock(DateTime.utc(2026, 10, 31, 20));\n750:       await tester.pumpWidget(\n751:         wallHarness(\n752:           manifest: wallManifest(),\n753:           clock: clock,\n754:           factory: fakeControllerFactory(),\n755:           guestCodeClient: fakeClient(pin: '004201'),\n756:           partyId: 'party-1',\n757:           tvDeviceId: 'tv-abc',\n758:         ),\n759:       );\n760:       await pumpWall(tester);\n761: \n762:       await tester.s