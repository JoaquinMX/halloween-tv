task.partyId);\n298:     await this.db.runTransaction(async (transaction) => {\n299:       const [snapshot, budgetSnapshot] = await Promise.all([transaction.get(ref), transaction.get(budget)]);\n300:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.\");\n301:       const job = snapshot.data()!;\n302:       if (job.idempotencyKey !== task.idempotencyKey || job.deviceId !== task.deviceId || job.channelId !== task.channelId) {\n303:         throw new BackendError(\"FORBIDDEN\", \"Task identity does not match the job.\");\n304:       }\n305:       const timestamp = FieldValue.serverTimestamp();\n306:       if (job.state === \"queued\") {\n307:         transaction.update(ref, {\n308:           state: \"failed\",\n309:           status: \"failed\",\n310:           errorCode: \"PROVIDER_UNAVAILABLE\",\n311:           enqueueFailedAt: timestamp,\n312:           failedAt: timestamp,\n313:           timestamp,\n314:         });\n315:         if (budgetSnapshot.exists && budgetSnapshot.data()?.activeJobId === task.jobId) {\n316:           transaction.update(budget, { activeJobId: null, state: \"idle\", updatedAt: timestamp });\n317:         }\n318:       } else {\n319:         // A queue response can be lost after acceptance. Preserve a worker that\n320:         // already claimed the job, while keeping the ambiguous enqueue visible.\n321:         transaction.update(ref, { enqueueErrorCode: \"PROVIDER_UNAVAILABLE\", enqueueFailedAt: timestamp, timestamp });\n322:       }\n323:     });\n324:   }\n325: \n326:   async claimWorker(task: GenerationTask, leaseMs = 20 * 60 * 1000): Promise<{ claimed: boolean; job: FirebaseFirestore.DocumentData }> {\n327:     const ref = jobRef(this.db, task.partyId, task.jobId);\n328:     return this.db.runTransaction(async (transaction) => {\n329:       const snapshot = await transaction.get(ref);\n330:       if (!snapshot.exists) throw new BackendError(\"NOT_FOUND\", \"Generation job does not exist.