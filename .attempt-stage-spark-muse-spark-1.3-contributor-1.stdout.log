     );\n160:       }\n161:       await teardownWall(tester);\n162:     },\n163:   );\n164: \n165:   testWidgets(\n166:     'effects preference persists by party and restores on the next wall',\n167:     (WidgetTester tester) async {\n168:       SharedPreferences.setMockInitialValues(<String, Object>{});\n169:       final SharedPreferencesSettings settings = SharedPreferencesSettings();\n170:       await tester.pumpWidget(\n171:         wallHarness(\n172:           manifest: wallManifest(),\n173:           clock: clock,\n174:           factory: fakeControllerFactory(),\n175:           settings: settings,\n176:         ),\n177:       );\n178:       await pumpWall(tester);\n179:       await tester.sendKeyEvent(LogicalKeyboardKey.contextMenu);\n180:       await tester.pump();\n181:       await tester.tap(\n182:         find.byKey(const ValueKey<String>('recovery-toggle-effects')),\n183:       );\n184:       await tester.pump();\n185:       expect(\n186:         await settings.getBool(\n187:           partyId: PartyId('local-party'),\n188:           key: CctvWallSettingsKeys.effectsDisabled,\n189:         ),\n190:         isTrue,\n191:       );\n192:       expect(\n193:         await settings.getBool(\n194:           partyId: PartyId('other-party'),\n195:           key: CctvWallSettingsKeys.effectsDisabled,\n196:         ),\n197:         isNull,\n198:       );\n199:       await teardownWall(tester);\n200: \n201:       await tester.pumpWidget(\n202:         wallHarness(\n203:           manifest: wallManifest(),\n204:           clock: clock,\n205:           factory: fakeControllerFactory(),\n206:           settings: settings,\n207:           initialEffectsDisabled:\n208:               await settings.getBool(\n209:                 partyId: PartyId('local-party'),\n210:                 key: CctvWallSettingsKeys.effectsDisabled,\n211:               ) ??\n212:               false,\n213:         ),\n214:       );\n215:       await pumpWall(tester);\n216:       expect(\n217:         find.byWidgetPredicate(\n218:           (Widget widget) => widget is CctvTile && widget.disableEffects,\n219:         ),\n220:         findsNWidgets(4),\n221:       );\n222:       await teardownWall(tester);\n223:     },\n224:   );\n225: \n226:   testWidgets('renders four camera tiles with a ticking HUD per tile', (\n227:     WidgetTester tester,\n228:   ) async {\n229:     final Map<String, FakeTileVideoController> sink =\n230:         <String, FakeTileVideoController>{};\n231: \n232:     await tester.pumpWidget(\n233:       wallHarness(\n234:         manifest: wallManifest(),\n235:         clock: clock,\n236:         factory: fakeControllerFactory(sink: sink),\n237:       ),\n238:     );\n239:     await pumpWall(tester);\n240: \n241:     expect(find.text('20:00:00'), findsNWidgets(4));\n242:     expect(find.text('REC'), findsNWidgets(4));\n243:     // Labels resolve through core_playlist: manifest clip labels when\n244:     // present, else the canonical slot defaults (owner Q3).\n245:     expect(find.text(cctvSlots[0].defaultLabel), findsOneWidget);\n246:     expect(find.text(cctvSlots[3].defaultLabel), findsOneWidget);\n247:     // The wall sizes itself from the viewport (no scrollable overflow).\n248:     expect(find.byType(Scrollable), findsNothing);\n249: \n250:     for (final String cameraId in <String>[\n251:       'CAM-01',\n252:       'CAM-02',\n253:       'CAM-03',\n254:       'CAM-04',\n255:     ]) {\n256:       expect(\n257:         find.byKey(ValueKey<String>('video-surface-$cameraId')),\n258:         findsOneWidget,\n259:       );\n260:       final FakeTileVideoController controller = sink[cameraId]!;\n261:       expect(controller.calls.first, 'initialize');\n262:       expect(controller.looping, isTrue, reason: 'clips must loop');\n263:       expect(controller.volume, 0, reason: 'the wall is muted');\n264:       expect(controller.playing, isTrue, reason: 'autoplay after init');\n265:     }\n266: \n267:     // The HUD timestamp is a live wall clock, not a frozen string.\n268:     clock.advance(const Duration(hours: 1, minutes: 2, seconds: 3));\n269:     await tester.pump(const Duration(seconds: 1));\n270:     expect(find.text('21:02:03'), findsNWidgets(4));\n271: \n272:     await teardownWall(tester);\n273:     expect(sink['CAM-01']!.disposed, isTrue);\n274:   });\n275: \n276:   testWidgets('D-pad arrows move focus between the four tiles', (\n277:     WidgetTester tester,\n278:   ) async {\n279:     await tester.pumpWidget(\n280:       wallHarness(\n281:         manifest: wallManifest(),\n282:         clock: clock,\n283:         factory: fakeControllerFactory(),\n284:       ),\n285:     );\n286:     await pumpWall(tester);\n287: \n288:     expect(\n289:       find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n290:       findsOneWidget,\n291:     );\n292: \n293:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);\n294:     await tester.pump();\n295:     expect(\n296:       find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n297:       findsOneWidget,\n298:     );\n299:     expect(\n300:       find.byKey(const ValueKey<String>('tile-focus-ring-0')),\n301:       findsNothing,\n302:     );\n303: \n304:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowDown);\n305:     await tester.pump();\n306:     expect(\n307:       find.byKey(const ValueKey<String>('tile-focus-ring-3')),\n308:       findsOneWidget,\n309:     );\n310: \n311:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowUp);\n312:     await tester.pump();\n313:     expect(\n314:       find.byKey(const ValueKey<String>('tile-focus-ring-1')),\n315:       findsOneWidget,\n316:     );\n317: \n318:     // Left edge: focus stays put instead of wrapping.\n319:     await tester.sendKeyEvent(LogicalKeyboardKey.arrowLeft);\n[Output truncated. Continue reading with offset: 320]"}],"providerCall":{"executed":false,"state":{"itemId":"fc_01a192c3f71274928e6d16af0fa4edf3"}},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/pri