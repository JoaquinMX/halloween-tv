{
  "name": "halloween-tv-backend",
  "private": true,
  "description": "Firebase backend contracts for Halloween TV (outside the Dart workspace)",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:emulator": "npm run build && FIREBASE_STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase --config ../firebase.json emulators:exec --project demo-halloween-tv --only firestore,storage,functions \"npm test\"",
    "runtime:prepare": "tsx tools/prepare_runtime.ts",
    "preflight": "tsx tools/deploy_preflight.ts",
    "preflight:cloud": "tsx tools/deploy_preflight.ts --target=cloud",
    "predeploy": "npm run build && npm run runtime:prepare && npm run preflight:cloud",
    "seed:pilot": "tsx tools/seed_pilot.ts --target=emulator",
    "seed:pilot:preview": "tsx tools/seed_pilot.ts --target=emulator",
    "seed:pilot:apply": "tsx tools/seed_pilot.ts --target=emulator --apply",
    "seed:pilot:cloud": "tsx tools/seed_pilot.ts --target=cloud",
    "dry-run": "tsx tools/run_dry_run.ts --target=emulator",
    "fake:e2e": "FIREBASE_STORAGE_BUCKET=demo-halloween-tv.appspot.com firebase --config ../firebase.json emulators:exec --project demo-halloween-tv --only firestore,storage \"npm run dry-run\"",
    "verify:delivery": "tsx tools/verify_delivery.ts",
    "usage:reconcile": "tsx tools/reconcile_usage.ts",
    "seed:guests": "tsx tools/seed_guests.ts --target=emulator",
    "seed:guests:preview": "tsx tools/seed_guests.ts --target=emulator",
    "seed:guests:apply": "tsx tools/seed_guests.ts --target=emulator --apply",
    "seed:guests:cloud": "tsx tools/seed_guests.ts --target=cloud"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.2",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.2",
    "firebase-tools": "^14.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffprobe-installer/linux-x64": "5.2.0"
  }
}
