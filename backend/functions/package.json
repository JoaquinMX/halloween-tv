{
  "name": "halloween-tv-backend",
  "private": true,
  "description": "Firebase backend contracts for Halloween TV (outside the Dart workspace)",
  "main": "lib/src/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "test:emulator": "firebase emulators:exec --project demo-halloween-tv --only firestore,storage \"npm test\"",
    "seed:pilot": "tsx tools/seed_pilot.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.2",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.2",
    "firebase-tools": "^14.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
