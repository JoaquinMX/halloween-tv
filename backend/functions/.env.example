# Local emulator defaults only. Never place provider or service-account credentials here.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_BUCKET=demo-halloween-tv.appspot.com
DELIVERY_URL_TTL_SECONDS=900
VIDEO_GENERATION_PROVIDER=fake
# Generation stays off unless an owner approves a live batch. Never true here.
# GENERATION_ENABLED=false
FFMPEG_PATH=./runtime/bin/ffmpeg
FFPROBE_PATH=./runtime/bin/ffprobe
GENERATION_WORKER_TIMEOUT_SECONDS=900
PROVIDER_POLL_TIMEOUT_SECONDS=720
NORMALIZATION_HEADROOM_SECONDS=120
# Optional provider polling overrides (defaults: 15000 / 720000 ms).
# PROVIDER_POLL_INTERVAL_MS=15000
# PROVIDER_TIMEOUT_MS=720000
